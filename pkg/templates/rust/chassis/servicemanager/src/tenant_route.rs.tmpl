fn read_varint(buf: &[u8], pos: &mut usize) -> Option<u64> {
    let mut value = 0u64;
    for i in 0..10 {
        let b = *buf.get(*pos)?;
        *pos += 1;
        if i == 9 && b > 1 {
            return None;
        }
        value |= u64::from(b & 0x7f) << (7 * i);
        if b & 0x80 == 0 {
            return Some(value);
        }
    }
    None
}

fn skip(buf: &[u8], pos: &mut usize, n: usize) -> Option<()> {
    let end = pos.checked_add(n)?;
    if end > buf.len() {
        return None;
    }
    *pos = end;
    Some(())
}

/// The tenant segment of a namespace that is exactly `/tenants/<t>`, whatever
/// `<t>` is, else `None`: an instance whose own namespace is one is
/// tenant-owned. `<t>` is the tenant's name (kernel#23), not the tid it is
/// routed by; that is its subject's (see [`HostIdentity`]).
pub fn host_tenant_of_namespace(namespace: &str) -> Option<String> {
    let prefix = format!("/{}/", ::spiffe::TENANTS_SEGMENT);
    let tenant = namespace.strip_prefix(prefix.as_str())?;
    (!tenant.is_empty() && !tenant.contains('/')).then(|| tenant.to_string())
}

/// The tid of a namespace that is exactly `/tenants/<tid>`, else `None`.
pub fn tenant_of_namespace(namespace: &str) -> Option<String> {
    host_tenant_of_namespace(namespace).filter(|t| valid_tenant_id(t))
}

/// The tid of the tenant a caller is in: its token's `tid` claim (see
/// `Caller::tid`), stamped by kernel at mint, and only when that claim is a
/// tid. Never its namespace claim, which names the tenant (`/tenants/<name>`,
/// kernel#23) and is not read for a tid at all (#284). No claim, or a
/// malformed one, is no tenant: the caller of a tenant-scoped call is refused,
/// with no fallback.
pub fn caller_tenant(tid_claim: Option<&str>) -> Option<String> {
    tid_claim.filter(|t| valid_tenant_id(t)).map(str::to_string)
}

/// The tid of the tenant whose instance `spiffe_id` names: its namespace,
/// parsed by the generated spiffe lib, is exactly `/tenants/<tid>`. Any other
/// identity, or one that does not parse, is no tenant's instance.
pub fn tenant_of_spiffe_id(spiffe_id: &str) -> Option<String> {
    let parsed = ::spiffe::parse_spiffe_id(spiffe_id).ok()?;
    tenant_of_namespace(&parsed.namespace)
}

