package diskstore

// UC2 — append-only redo log (WAL) with periodic compaction.
//
// One redo log per (namespace, store), laid out by path.go as
// <base>/<ns-dirs>/<store>.log. Because each log is homogeneous (one ns, one
// store), records carry only the row key, an optional deleted tombstone,
// optional caller-set metadata, and the payload (the type as JSON). The
// namespace and store are implied by the file path.
//
// Records are NDJSON (one JSON envelope per line — safe to newline-frame since
// JSON escapes embedded newlines). Compaction ("roll") rewrites the log as the
// current deduped state plus writes that arrived during the snapshot, then
// atomically swaps it in (the final rename is the commit point).

import (
	"bytes"
	"encoding/json"
	"errors"
	"fmt"
	"io/fs"
	"os"
	"path/filepath"
	"sort"
	"strconv"
	"strings"
	"sync"
)

// Record is one redo-log record (the JSON envelope), NDJSON-framed.
type Record struct {
	// Key is the collection_index value identifying the row within the store.
	Key string `json:"key"`
	// Deleted is true if this records a deletion of Key (payload omitted).
	Deleted bool `json:"deleted,omitempty"`
	// Metadata is optional, caller-set metadata. Never required or
	// auto-populated.
	Metadata *string `json:"metadata,omitempty"`
	// Payload is the type serialized as JSON (absent for deletions). Embedded as
	// a nested JSON value: the generated ToJSON output stored verbatim; FromJSON
	// consumes it on restore.
	Payload json.RawMessage `json:"payload,omitempty"`
}

// Inserter is the consumer hook for restore. Receives each deduped record; the
// implementation decides whether the row is actually applied or is a duplicate
// — idempotency is owned by the consumer (the underlying store).
type Inserter interface {
	Insert(rec *Record) error
}

// InserterFunc adapts a function to the Inserter interface.
type InserterFunc func(rec *Record) error

// Insert calls the underlying function.
func (f InserterFunc) Insert(rec *Record) error { return f(rec) }

// RedoLog is an append-only redo log for one (namespace, store), with
// compaction.
type RedoLog struct {
	active       string
	archiveCount uint32
	archiveCodec Codec

	// rollMu serializes Roll, Rotate and Checkpoint: a checkpoint's redo position
	// must be read in the same critical section as its snapshot, so no roll can
	// land between the two. It is held across the snapshot, which takes the
	// store's lock; no path takes rollMu while holding that store lock.
	rollMu  sync.Mutex
	shipper *ArchiveShipper

	mu     sync.Mutex
	writer *os.File
	// Guarded by mu. appended counts every Append; rolledThrough is the
	// appended count the last committed Roll covered. A Roll with nothing new
	// since then has nothing to compact.
	appended      int64
	rolledThrough int64
	// shippedThrough is the appended count the archive holds: a rotation or a roll
	// shipped everything up to here. A rotation with nothing new ships nothing.
	shippedThrough int64
}

// OpenRedoLog opens (creating if absent) the redo log for (ns, store) under
// base. Concurrency: single-writer, single-process, local filesystem only.
// Concurrent writers, multiple owning processes, or network/shared filesystems
// are unsupported and can corrupt the archive chain.
func OpenRedoLog(base, ns, store string, archiveCount uint32, archiveCodec Codec) (*RedoLog, error) {
	active := StorePath(base, ns, store, ".log")
	if dir := filepath.Dir(active); dir != "" {
		if err := os.MkdirAll(dir, 0o755); err != nil {
			return nil, wrapIOError(err)
		}
	}
	w, err := os.OpenFile(active, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o600)
	if err != nil {
		return nil, wrapIOError(err)
	}
	return &RedoLog{
		active:         active,
		archiveCount:   archiveCount,
		archiveCodec:   archiveCodec,
		writer:         w,
		rolledThrough:  -1,
		shippedThrough: -1,
	}, nil
}

// ActivePath returns the active log file path.
func (l *RedoLog) ActivePath() string {
	return l.active
}

// Close closes the underlying writer.
func (l *RedoLog) Close() error {
	l.mu.Lock()
	defer l.mu.Unlock()
	if l.writer == nil {
		return nil
	}
	err := l.writer.Close()
	l.writer = nil
	if err != nil {
		return wrapIOError(err)
	}
	return nil
}

// Append appends one record, NDJSON-framed and fsync'd (durability is the
// point).
func (l *RedoLog) Append(rec *Record) error {
	line, err := json.Marshal(rec)
	if err != nil {
		return ErrCodec(err.Error())
	}
	line = append(line, '\n')
	l.mu.Lock()
	defer l.mu.Unlock()
	l.appended++
	if _, err := l.writer.Write(line); err != nil {
		return wrapIOError(err)
	}
	if err := l.writer.Sync(); err != nil {
		return wrapIOError(err)
	}
	return nil
}

// Roll compacts the log: redirect appends to a temp log, build a fresh baseline
// from the caller-supplied current state (snapshot), fold in the temp log under
// a brief write-block, then atomically swap the new file in and archive the old
// one (compressed at rest). The final rename is the commit point.
func (l *RedoLog) Roll(snapshot []*Record) error {
	return l.rollFrom(func() []*Record { return snapshot })
}

// rollFrom is the roll scheduler's entry point. It reads the snapshot after the
// redirect, so an append that lands while the snapshot is taken goes to the temp
// log and is folded in. Read before the redirect, it would go to the old active
// log and miss the new baseline.
func (l *RedoLog) rollFrom(snapshot func() []*Record) error {
	l.rollMu.Lock()
	defer l.rollMu.Unlock()
	if l.shipper != nil {
		if err := l.shipper.resolve(); err != nil {
			return err
		}
	}
	tempPath := sibling(l.active, ".temp")
	building := sibling(l.active, ".building")

	// 1. Redirect appends to the temp log (no write-block during snapshot).
	l.mu.Lock()
	if l.appended == l.rolledThrough {
		l.mu.Unlock()
		return nil
	}
	seen := l.appended
	tempWriter, err := os.OpenFile(tempPath, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o600)
	if err != nil {
		l.mu.Unlock()
		return wrapIOError(err)
	}
	if l.writer != nil {
		_ = l.writer.Close()
	}
	l.writer = tempWriter
	l.mu.Unlock()

	// 2. Build the new baseline from the snapshot (build-then-rename: the
	//    presence of building means it is complete + durable).
	var buf bytes.Buffer
	for _, rec := range snapshot() {
		b, err := json.Marshal(rec)
		if err != nil {
			return ErrCodec(err.Error())
		}
		buf.Write(b)
		buf.WriteByte('\n')
	}
	staged, err := writeTemp(building, buf.Bytes(), 0)
	if err != nil {
		return err
	}
	if err := promote(staged, building); err != nil {
		return err
	}

	// 3. Block appends; fold the temp log into the new baseline; swap.
	l.mu.Lock()
	defer l.mu.Unlock()
	if l.writer != nil {
		if err := l.writer.Sync(); err != nil {
			return wrapIOError(err)
		}
	}
	tempBytes, err := os.ReadFile(tempPath)
	if err != nil {
		if errors.Is(err, fs.ErrNotExist) {
			tempBytes = nil
		} else {
			return wrapIOError(err)
		}
	}
	if len(tempBytes) > 0 {
		f, err := os.OpenFile(building, os.O_WRONLY|os.O_APPEND, 0o600)
		if err != nil {
			return wrapIOError(err)
		}
		if _, err := f.Write(tempBytes); err != nil {
			f.Close()
			return wrapIOError(err)
		}
		if err := f.Sync(); err != nil {
			f.Close()
			return wrapIOError(err)
		}
		if err := f.Close(); err != nil {
			return wrapIOError(err)
		}
	}
	var folded int64
	if l.shipper == nil {
		// Archive the old active (compressed at rest), then promote.
		if err := rotateArchives(l.active, l.archiveCount); err != nil {
			return err
		}
		if l.archiveCount > 0 && l.archiveCodec != CodecNone {
			if err := compressInPlace(sibling(l.active, ".bak.1"), l.archiveCodec); err != nil {
				return err
			}
		}
	} else {
		if err := l.shipActiveSegment(); err != nil {
			return err
		}
		// The new baseline folds every segment allocated so far: they stop being
		// replayed locally, and are deleted once shipped. The marker lands before
		// the promote, so a crash between the two never replays a folded segment
		// over the baseline.
		folded = l.shipper.position()
		if err := l.writeFolded(folded); err != nil {
			return err
		}
		l.shipper.setFolded(folded)
		l.shippedThrough = seen
	}
	if l.writer != nil {
		_ = l.writer.Close()
	}
	if err := promote(building, l.active); err != nil {
		return err
	}
	// Resume appends on the (new) active log.
	w, err := os.OpenFile(l.active, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o600)
	if err != nil {
		return wrapIOError(err)
	}
	l.writer = w
	_ = os.Remove(tempPath)
	l.rolledThrough = seen
	if folded > 0 {
		l.deleteFoldedSegments(folded)
	}
	return nil
}

// Rotate closes the active log, ships it as the next segment, and opens a fresh
// active log. No snapshot is taken and no baseline is folded, so the cost is the
// writes since the last rotation. Run on an interval it sets the recovery point
// after losing the volume, while Roll stays the (rarer) compaction.
//
// The segment stays on the local volume after it ships, and Restore replays it,
// until a later Roll folds it into a baseline. The first rotation after a roll
// carries that roll's baseline. A rotation with nothing appended since the last
// one ships nothing. It requires an attached ArchiveShipper.
func (l *RedoLog) Rotate() error {
	l.rollMu.Lock()
	defer l.rollMu.Unlock()
	if l.shipper == nil {
		return ErrGeneral("rotate requires an archive; AttachShipper first")
	}
	if err := l.shipper.resolve(); err != nil {
		return err
	}
	l.mu.Lock()
	defer l.mu.Unlock()
	if l.appended == l.shippedThrough {
		return nil
	}
	if info, err := os.Stat(l.active); err != nil || info.Size() == 0 {
		l.shippedThrough = l.appended
		return nil
	}
	if l.writer != nil {
		_ = l.writer.Close()
		l.writer = nil
	}
	shipErr := l.shipActiveSegment()
	// Appends resume whether or not the move happened.
	w, err := os.OpenFile(l.active, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o600)
	if err != nil {
		return wrapIOError(err)
	}
	l.writer = w
	if shipErr != nil {
		return shipErr
	}
	l.shippedThrough = l.appended
	return nil
}

// AttachShipper ships this log to shipper's archive. Pending segments and
// checkpoints a previous process left behind are re-queued first. Attach before
// the first roll so every roll is shipped.
func (l *RedoLog) AttachShipper(shipper *ArchiveShipper) error {
	dir := filepath.Dir(l.active)
	name := filepath.Base(l.active)
	entries, err := os.ReadDir(dir)
	if err != nil {
		return wrapIOError(err)
	}
	var pending []string
	for _, e := range entries {
		f := e.Name()
		if strings.HasPrefix(f, name+segmentTag) || strings.HasPrefix(f, name+checkpointTag) {
			pending = append(pending, filepath.Join(dir, f))
		}
	}
	sort.Strings(pending)
	folded, err := l.readFolded()
	if err != nil {
		return err
	}
	shipper.setFolded(folded)
	l.deleteFoldedSegments(folded)
	for _, file := range pending {
		shipper.recoverFile(file)
	}
	l.rollMu.Lock()
	l.shipper = shipper
	l.rollMu.Unlock()
	return nil
}

// Checkpoint ships a checkpoint: the full store state as of now, recorded under
// the redo position it covers (the newest segment shipped). A restore loads the
// newest checkpoint and replays the segments shipped after it. It requires an
// attached ArchiveShipper. If snapshot fails nothing is shipped.
func (l *RedoLog) Checkpoint(snapshot func() ([]*Record, error)) error {
	l.rollMu.Lock()
	shipper := l.shipper
	if shipper == nil {
		l.rollMu.Unlock()
		return ErrGeneral("checkpoint requires an archive; AttachShipper first")
	}
	if err := shipper.resolve(); err != nil {
		l.rollMu.Unlock()
		return err
	}
	position := shipper.position()
	recs, err := snapshot()
	l.rollMu.Unlock()
	if err != nil {
		return err
	}
	var buf bytes.Buffer
	for _, rec := range recs {
		b, err := json.Marshal(rec)
		if err != nil {
			return ErrCodec(err.Error())
		}
		buf.Write(b)
		buf.WriteByte('\n')
	}
	file := checkpointPending(l.active, position)
	if err := atomicWrite(file, buf.Bytes(), 0); err != nil {
		return err
	}
	shipper.enqueueCheckpoint(file, position)
	return nil
}

// ShipPending is the number of objects this log has yet to ship; 0 with no archive.
func (l *RedoLog) ShipPending() int {
	if l.shipper == nil {
		return 0
	}
	return l.shipper.Pending()
}

// shipActiveSegment moves the active log out of the active position and queues it
// as the next segment. The caller holds rollMu and mu. The segment holds every
// append since the previous roll or rotation; it stays on disk until the archive
// holds it.
func (l *RedoLog) shipActiveSegment() error {
	info, err := os.Stat(l.active)
	if err != nil || info.Size() == 0 {
		return nil
	}
	seq := l.shipper.allocateSeq()
	segment := segmentPending(l.active, seq)
	if err := os.Rename(l.active, segment); err != nil {
		return wrapIOError(err)
	}
	l.shipper.enqueueSegment(segment, seq)
	return nil
}

func (l *RedoLog) foldedMarker() string { return sibling(l.active, ".folded") }

// readFolded is the highest segment sequence a roll has folded into the baseline;
// 0 if none.
func (l *RedoLog) readFolded() (int64, error) {
	data, err := os.ReadFile(l.foldedMarker())
	if errors.Is(err, fs.ErrNotExist) {
		return 0, nil
	}
	if err != nil {
		return 0, wrapIOError(err)
	}
	seq, err := strconv.ParseInt(strings.TrimSpace(string(data)), 10, 64)
	if err != nil {
		return 0, ErrInvalidData("folded marker " + l.foldedMarker() + ": " + err.Error())
	}
	return seq, nil
}

func (l *RedoLog) writeFolded(seq int64) error {
	return atomicWrite(l.foldedMarker(), []byte(strconv.FormatInt(seq, 10)), 0)
}

// localSegments lists the sequences of the local segment files, pending or
// shipped, that no baseline covers yet, oldest first.
func (l *RedoLog) localSegments() ([]int64, error) {
	folded, err := l.readFolded()
	if err != nil {
		return nil, err
	}
	entries, err := os.ReadDir(filepath.Dir(l.active))
	if err != nil {
		return nil, wrapIOError(err)
	}
	name := filepath.Base(l.active)
	seen := map[int64]bool{}
	var seqs []int64
	for _, e := range entries {
		f := e.Name()
		for _, tag := range []string{segmentTag, rotatedTag} {
			if !strings.HasPrefix(f, name+tag) {
				continue
			}
			if seq, ok := seqAfter(f, tag); ok && seq > folded && !seen[seq] {
				seen[seq] = true
				seqs = append(seqs, seq)
			}
		}
	}
	sort.Slice(seqs, func(i, j int) bool { return seqs[i] < seqs[j] })
	return seqs, nil
}

// readSegment reads one local segment. It is pending until it ships and rotated
// after; the shipper renames it between the two, so try both names.
func (l *RedoLog) readSegment(seq int64) ([]*Record, error) {
	for _, p := range []string{segmentPending(l.active, seq), rotatedPath(l.active, seq)} {
		if !fileExists(p) {
			continue
		}
		recs, err := DedupFile(p)
		if err != nil {
			return nil, err
		}
		return recs, nil
	}
	return nil, ErrIO(fmt.Sprintf("local segment %d vanished during restore", seq))
}

// deleteFoldedSegments deletes the shipped segments a baseline now covers. One
// still queued is deleted by the shipper when it uploads.
func (l *RedoLog) deleteFoldedSegments(folded int64) {
	entries, err := os.ReadDir(filepath.Dir(l.active))
	if err != nil {
		return
	}
	name := filepath.Base(l.active)
	for _, e := range entries {
		f := e.Name()
		if !strings.HasPrefix(f, name+rotatedTag) {
			continue
		}
		if seq, ok := seqAfter(f, rotatedTag); ok && seq <= folded {
			_ = os.Remove(filepath.Join(filepath.Dir(l.active), f))
		}
	}
}

// Restore reads + dedups the active log and replays each record through
// inserter. It returns the number of records applied. It recovers a leftover
// temp log (crash mid-roll) by folding it after the active log (latest wins).
func (l *RedoLog) Restore(inserter Inserter) (int, error) {
	building := sibling(l.active, ".building")
	if fileExists(building) {
		l.mu.Lock()
		if l.writer != nil {
			_ = l.writer.Close()
			l.writer = nil
		}
		if err := promote(building, l.active); err != nil {
			l.mu.Unlock()
			return 0, err
		}
		w, err := os.OpenFile(l.active, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o600)
		if err != nil {
			l.mu.Unlock()
			return 0, wrapIOError(err)
		}
		l.writer = w
		l.mu.Unlock()
	}

	// Oldest first, the last write per key winning: the rotated segments no
	// baseline covers yet (the first carries the last roll's baseline), then the
	// active log, then a leftover temp log.
	byKey := make(map[string]*Record)
	var order []string
	fold := func(recs []*Record) {
		for _, r := range recs {
			if _, seen := byKey[r.Key]; !seen {
				order = append(order, r.Key)
			}
			byKey[r.Key] = r
		}
	}
	seqs, err := l.localSegments()
	if err != nil {
		return 0, err
	}
	for _, seq := range seqs {
		recs, err := l.readSegment(seq)
		if err != nil {
			return 0, err
		}
		fold(recs)
	}
	recs, err := DedupFile(l.active)
	if err != nil {
		return 0, err
	}
	fold(recs)
	tempPath := sibling(l.active, ".temp")
	if fileExists(tempPath) {
		extra, err := DedupFile(tempPath)
		if err != nil {
			return 0, err
		}
		fold(extra)
	}
	n := 0
	for _, key := range order {
		r := byKey[key]
		if err := inserter.Insert(r); err != nil {
			return n, err
		}
		n++
	}
	return n, nil
}

// DedupFile reads a (possibly compressed) NDJSON log file and dedups to
// latest-per-key. It returns an empty slice if the file is absent.
func DedupFile(path string) ([]*Record, error) {
	bytesData, err := os.ReadFile(path)
	if err != nil {
		if errors.Is(err, fs.ErrNotExist) {
			return nil, nil
		}
		return nil, wrapIOError(err)
	}
	raw, err := DecompressAuto(bytesData)
	if err != nil {
		return nil, err
	}
	return DedupBytes(raw)
}

// DedupBytes dedups NDJSON bytes to latest-per-key. Later lines win.
func DedupBytes(data []byte) ([]*Record, error) {
	byKey := make(map[string]*Record)
	var order []string
	lines := bytes.Split(data, []byte{'\n'})
	for i, line := range lines {
		if len(line) == 0 {
			continue
		}
		var rec Record
		if err := json.Unmarshal(line, &rec); err != nil {
			return nil, ErrCodec(fmt.Sprintf("redo log line %d: %s", i+1, err))
		}
		if rec.Key == "" {
			return nil, ErrInvalidData(fmt.Sprintf("redo log line %d: missing key", i+1))
		}
		if _, seen := byKey[rec.Key]; !seen {
			order = append(order, rec.Key)
		}
		r := rec
		byKey[rec.Key] = &r
	}
	out := make([]*Record, 0, len(byKey))
	for _, k := range order {
		out = append(out, byKey[k])
	}
	return out, nil
}

func compressInPlace(path string, codec Codec) error {
	raw, err := os.ReadFile(path)
	if err != nil {
		if errors.Is(err, fs.ErrNotExist) {
			return nil
		}
		return wrapIOError(err)
	}
	packed, err := Compress(raw, codec)
	if err != nil {
		return err
	}
	tmp, err := writeTemp(path, packed, 0)
	if err != nil {
		return err
	}
	return promote(tmp, path)
}
