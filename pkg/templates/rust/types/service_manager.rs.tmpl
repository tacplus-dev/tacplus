    seen: Vec<String>,
}

fn report_tls_degraded(seam: &std::sync::Mutex<TlsDegradeSeam>, reason: &str) {
    let mut guard = seam.lock().unwrap();
    guard.seen.push(reason.to_string());
    for f in &guard.fns {
        f(reason);
    }
}

fn on_tls_degraded(seam: &std::sync::Mutex<TlsDegradeSeam>, f: impl Fn(&str) + Send + Sync + 'static) {
    let mut guard = seam.lock().unwrap();
    for r in &guard.seen {
        f(r);
    }
    guard.fns.push(Box::new(f));
}

