    #[tokio::test]
    async fn nothing_required_is_ready() {
        assert_eq!(RequiredChannels::new(Vec::new(), Vec::new()).first_down().await, None);
    }

    #[tokio::test]
    async fn pool_with_no_endpoints_is_down() {
        let empty = Arc::new(ServiceConnection::new_dynamic("eventbus", verifier()));
        let required = RequiredChannels::new(vec![empty], Vec::new());
        assert_eq!(required.first_down().await, Some(("eventbus".to_string(), "no endpoints")));
    }

    #[tokio::test]
    async fn pool_follows_endpoint_health() {
        let sc = pool("identity", InstanceStatus::Starting).await;
        let required = RequiredChannels::new(vec![sc.clone()], Vec::new());
        assert_eq!(
            required.first_down().await,
            Some(("identity".to_string(), "fleet health")),
            "STARTING peer that was never HEALTHY is not up"
        );

        sc.set_endpoint_health_for_test(InstanceStatus::Healthy).await;
        assert_eq!(required.first_down().await, None, "HEALTHY peer is up");

        sc.set_endpoint_health_for_test(InstanceStatus::Degraded).await;
        assert_eq!(required.first_down().await, None, "DEGRADED peer still serves");

        // Debounced: one UNHEALTHY report right after a good one does not take
        // the channel down (endpoint::tests cover the 30s window itself).
        sc.set_endpoint_health_for_test(InstanceStatus::Unhealthy).await;
        assert_eq!(required.first_down().await, None, "a fresh UNHEALTHY report is not yet down");
    }

    #[tokio::test]
    async fn peer_missing_from_one_snapshot_stays_up() {
        // The fleet health snapshot can omit a peer for one poll. Dropping it
        // at once empties the pool, and readiness counts an empty pool down.
        let sc = pool("identity", InstanceStatus::Healthy).await;
        let required = RequiredChannels::new(vec![sc.clone()], Vec::new());
        sc.reconcile_from_health(&[]).await;
        assert_eq!(required.first_down().await, None, "one missed snapshot is not down");
    }

    #[tokio::test]
    async fn stream_follows_its_flag() {
        let up = Arc::new(AtomicBool::new(false));
        let required = RequiredChannels::new(
            vec![pool("identity", InstanceStatus::Healthy).await],
            vec![("events subscription".to_string(), up.clone())],
        );
        let down = Some(("events subscription".to_string(), "stream"));
        assert_eq!(required.first_down().await, down);

        up.store(true, Ordering::Relaxed);
        assert_eq!(required.first_down().await, None);

        up.store(false, Ordering::Relaxed);
        assert_eq!(required.first_down().await, down);
    }
