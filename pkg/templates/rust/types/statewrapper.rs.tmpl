    /// Watch loop for imported {{.TypeName}} state — reconnects on stream errors.
    async fn watch_{{.FieldName}}_loop(&self) {
        let mut attempt = 0u32;
        loop {
            if self.is_closed() {
                return;
            }
            let made_progress = match self.start_{{.FieldName}}_watch().await {
                Ok(made_progress) => {
                    if self.is_closed() {
                        return;
                    }
                    let next_attempt = if made_progress { 0 } else { attempt.saturating_add(1) };
                    self.record_watch_retrying("Watch{{.FieldPascal}}", made_progress, next_attempt, "stream ended", None);
                    tracing::warn!("{{$.StateRootName}}.{{.FieldName}} state-import watch stream ended, reconnecting");
                    made_progress
                }
                Err(e) => {
                    if self.is_closed() {
                        return;
                    }
                    let reason = e.to_string();
                    // Imported state is watched over the same credential as owned
                    // state, so this arm must classify rejections too. It was the
                    // only watch arm without it, which meant a service whose only
                    // kernel traffic is imported state kept presenting a dead
                    // token — the exact pre-fix behaviour — unless some other loop
                    // in the process happened to notice.
                    service_im::note_if_credential_rejection(&reason).await;
                    self.record_watch_retrying("Watch{{.FieldPascal}}", false, attempt.saturating_add(1), reason.clone(), Some(reason));
                    tracing::error!(error = %e, "{{$.StateRootName}}.{{.FieldName}} state-import watch failed, retrying");
                    false
                }
            };
            if made_progress {
                attempt = 0;
            } else {
                attempt = attempt.saturating_add(1);
            }
            if !self.sleep_before_watch_retry(attempt).await {
                return;
            }
        }
    }

    async fn start_{{.FieldName}}_watch(&self) -> Result<bool, Box<dyn std::error::Error + Send + Sync>> {
        let close = self.close_notify.notified();
        tokio::pin!(close);
        if self.is_closed() {
            return Ok(false);
        }
        let req = tokio::select! {
            _ = &mut close => return Ok(false),
            req = self.authorized_request(Default::default()) => req?,
        };
        if self.is_closed() {
            return Ok(false);
        }
        // Clone the stub and RELEASE the mutex before opening the stream.
        //
        // Holding the guard across the stream is a deadlock: the guard stays in
        // scope for the entire life of the watch loop below, so the first
        // boundary to win the lock keeps it forever and every other watch loop
        // on this client blocks in lock() -- silently, with no error and no log.
        // Observed live: sentinel started only Cluster.grpc_stats; cluster_info,
        // cluster_health, node_metrics and four more never began, so their caches
        // stayed empty and the dashboard failed validation with
        // "field clusterInfo is required".
        //
        // A tonic client is Clone and shares the underlying multiplexed channel,
        // so cloning per watch is cheap and lets every boundary stream at once.
        let mut stub = {
            let guard = tokio::select! {
                _ = &mut close => return Ok(false),
                stub = self.stub.lock() => stub,
            };
            guard.clone()
        };
        if self.is_closed() {
            return Ok(false);
        }
        let response = tokio::select! {
            _ = &mut close => return Ok(false),
            response = stub.watch_{{.FieldName}}(req) => response?,
        };
        let mut stream = response.into_inner();
        let mut received = false;
        self.record_watch_healthy("Watch{{.FieldPascal}}", false);
        // An accepted stream proves the credential is good again; clears the
        // degraded health floor set after repeated rejections.
        service_im::note_credential_accepted();
        tracing::info!("{{$.StateRootName}}.{{.FieldName}} state-import watch stream started");

        loop {
            if self.is_closed() {
                return Ok(received);
            }
            let Some(msg) = (tokio::select! {
                _ = self.close_notify.notified() => return Ok(received),
                msg = stream.next() => msg,
            }) else {
                return Ok(received);
            };
            match msg {
                Ok(value) => {
                    received = true;
                    self.record_watch_healthy("Watch{{.FieldPascal}}", true);
                    let mut state = self.state.write().unwrap();
                    state.{{.FieldName}}_cache = Some(value);
                }
                Err(e) => {
                    tracing::warn!(error = %e, "{{$.StateRootName}}.{{.FieldName}} state-import watch stream error");
                    return Err(e.into());
                }
            }
        }
    }
