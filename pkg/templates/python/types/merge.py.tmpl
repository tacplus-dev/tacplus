{{- /* Python merge template */ -}}
# ---- Merge ----
{{- range .Messages}}

def {{.FuncName}}(dst: {{.QualifiedType}}, src: {{.QualifiedType}}) -> None:
    """Fills zero-valued fields in dst from src. dst takes precedence."""
{{- range .Fields}}
{{- if eq .Kind "string"}}
    if {{pyGet "dst" .FieldName}} == "":
        {{pySet "dst" .FieldName (pyGet "src" .FieldName)}}
{{- else if eq .Kind "int"}}
    if {{pyGet "dst" .FieldName}} == 0:
        {{pySet "dst" .FieldName (pyGet "src" .FieldName)}}
{{- else if eq .Kind "float"}}
    if {{pyGet "dst" .FieldName}} == 0.0:
        {{pySet "dst" .FieldName (pyGet "src" .FieldName)}}
{{- else if eq .Kind "bool"}}
    if not {{pyGet "dst" .FieldName}}:
        {{pySet "dst" .FieldName (pyGet "src" .FieldName)}}
{{- else if eq .Kind "enum"}}
    if {{pyGet "dst" .FieldName}} == 0:
        {{pySet "dst" .FieldName (pyGet "src" .FieldName)}}
{{- else if eq .Kind "bytes"}}
    if len({{pyGet "dst" .FieldName}}) == 0:
        {{pySet "dst" .FieldName (pyGet "src" .FieldName)}}
{{- else if eq .Kind "message"}}
{{- if .SamePkg}}
    if not dst.HasField("{{.ProtoFieldName}}") and src.HasField("{{.ProtoFieldName}}"):
        {{pyGet "dst" .FieldName}}.CopyFrom({{pyGet "src" .FieldName}})
    elif dst.HasField("{{.ProtoFieldName}}") and src.HasField("{{.ProtoFieldName}}"):
        {{.MergeFn}}({{pyGet "dst" .FieldName}}, {{pyGet "src" .FieldName}})
{{- else}}
    if not dst.HasField("{{.ProtoFieldName}}") and src.HasField("{{.ProtoFieldName}}"):
        {{pyGet "dst" .FieldName}}.CopyFrom({{pyGet "src" .FieldName}})
{{- end}}
{{- else if eq .Kind "repeated"}}
    if len({{pyGet "dst" .FieldName}}) == 0:
        {{pyGet "dst" .FieldName}}.extend({{pyGet "src" .FieldName}})
{{- else if eq .Kind "map"}}
{{- if .MapValueSamePkg}}
    if len({{pyGet "dst" .FieldName}}) == 0:
        {{pyGet "dst" .FieldName}}.update({{pyGet "src" .FieldName}})
    else:
        for k, src_val in {{pyGet "src" .FieldName}}.items():
            if k in {{pyGet "dst" .FieldName}}:
                {{.MapValueMergeFn}}({{pyGet "dst" .FieldName}}[k], src_val)
            else:
                {{pyGet "dst" .FieldName}}[k].CopyFrom(src_val)
{{- else}}
    if len({{pyGet "dst" .FieldName}}) == 0:
        {{pyGet "dst" .FieldName}}.update({{pyGet "src" .FieldName}})
{{- end}}
{{- end}}
{{- end}}
{{- range .OneofGroups}}
    if dst.WhichOneof("{{.OneofName}}") is None and src.WhichOneof("{{.OneofName}}") is not None:
        field_name = src.WhichOneof("{{.OneofName}}")
        src_field = getattr(src, field_name)
        if hasattr(src_field, 'CopyFrom'):
            getattr(dst, field_name).CopyFrom(src_field)
        else:
            setattr(dst, field_name, src_field)
{{- end}}
{{- if and (eq (len .Fields) 0) (eq (len .OneofGroups) 0)}}
    pass
{{- end}}
{{- end}}
