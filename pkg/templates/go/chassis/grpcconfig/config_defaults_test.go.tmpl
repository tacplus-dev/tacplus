// Behavioral self-test for ConfigDefaults: constructs a Config with all fields
// at proto3 zero, runs the REAL generated ConfigDefaults function, and asserts
// annotated defaults take effect. This specifically covers the state-authority
// (kernel) path: loadConfig + ConfigDefaults with no typed-config fetch.

package grpcconfig

import (
	"testing"

	diskstore_pb "{{.ModuleBasePath}}/types/sys/diskstore"
	grpcconfig_pb "{{.ModuleBasePath}}/types/sys/grpcconfig"
)

func TestConfigDefaults_EmptyConfig_HealthProbePort(t *testing.T) {
	// Empty Config (submessage absent) — the state-authority path.
	cfg := &grpcconfig_pb.Config{}
	if cfg.GetHealthProbePort() != 0 {
		t.Fatalf("precondition: empty config health_probe_port = %d, want 0", cfg.GetHealthProbePort())
	}
	grpcconfig_pb.ConfigDefaults(cfg)
	if got := cfg.GetHealthProbePort(); got != 8444 {
		t.Errorf("empty config → health_probe_port = %d, want 8444", got)
	}
}

func TestConfigDefaults_ExplicitValue_Preserved(t *testing.T) {
	cfg := &grpcconfig_pb.Config{HealthProbePort: 9999}
	grpcconfig_pb.ConfigDefaults(cfg)
	if got := cfg.GetHealthProbePort(); got != 9999 {
		t.Errorf("explicit 9999 → health_probe_port = %d, want 9999", got)
	}
}

func TestConfigDefaults_Idempotent(t *testing.T) {
	cfg := &grpcconfig_pb.Config{}
	grpcconfig_pb.ConfigDefaults(cfg)
	first := cfg.GetHealthProbePort()
	grpcconfig_pb.ConfigDefaults(cfg)
	second := cfg.GetHealthProbePort()
	if first != second {
		t.Errorf("configDefaults not idempotent: first=%d, second=%d", first, second)
	}
}

func TestConfigDefaults_Constant(t *testing.T) {
	if grpcconfig_pb.DefaultHealthProbePort != 8444 {
		t.Errorf("DefaultHealthProbePort = %d, want 8444", grpcconfig_pb.DefaultHealthProbePort)
	}
}

// The disk_persistence message lives in package diskstore, and its archive omits both
// intervals. The cross-package defaults must still reach the nested messages (issue #97).
func TestConfigDefaults_NestedArchiveFromOtherPackage(t *testing.T) {
	cfg := &grpcconfig_pb.Config{DiskPersistence: &diskstore_pb.DiskPersistenceConfig{
		Dir:     "/tmp/config-defaults-test",
		Archive: &diskstore_pb.ArchiveConfig{GcsBucket: "bucket"},
	}}
	grpcconfig_pb.ConfigDefaults(cfg)
	if got := cfg.GetDiskPersistence().GetRollIntervalSeconds(); got != 86400 {
		t.Errorf("nested roll_interval_seconds = %d, want 86400", got)
	}
	if got := cfg.GetDiskPersistence().GetArchive().GetCheckpointIntervalSeconds(); got != 86400 {
		t.Errorf("nested checkpoint_interval_seconds = %d, want 86400", got)
	}
}
