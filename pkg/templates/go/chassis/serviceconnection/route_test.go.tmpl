		{"truncated varint", append(frame(3, "aaaaaaaa"), 0x08, 0x80)},
		{"truncated length", append(frame(3, "aaaaaaaa"), 0x1a, 0x10, 'a')},
		{"unterminated group", append(frame(3, "aaaaaaaa"), protowire.AppendTag(nil, 7, protowire.StartGroupType)...)},
		{"bad wire type", append(frame(3, "aaaaaaaa"), 0x0f)},
