/** LoggerSink delegates typed accounting events to console as structured log entries. */
export class LoggerSink implements Sink {
  emit(event: Event): void {
    const sourceId = (event as any).sourceId ?? '';
    const requestId = (event as any).requestId ?? '';
    const evPayload = (event as any).event;

    if (!evPayload) {
      console.info('[accounting]', { sourceId, requestId });
      return;
    }

    const base = { sourceId, requestId };

    switch (evPayload.case) {
      case 'rpcCompleted':
        console.info('[accounting] rpc_completed', { ...base, durationMs: evPayload.value.durationMs });
        break;
      case 'rpcError':
        console.error('[accounting] rpc_error', {
          ...base,
          code: evPayload.value.code,
          error: evPayload.value.message,
          durationMs: evPayload.value.durationMs,
        });
        break;
      case 'tokenRejected':
        console.warn('[accounting] token_rejected', { ...base, reason: evPayload.value.reason });
        break;
      case 'endpointHealthChanged':
        console.warn('[accounting] endpoint_health_changed', {
          ...base,
          endpoint: evPayload.value.endpoint,
          healthy: evPayload.value.healthy,
        });
        break;
      case 'stateUpdated':
        console.info('[accounting] state_updated', {
          ...base,
          entityType: evPayload.value.entityType,
          entityId: evPayload.value.entityId,
        });
        break;
      case 'diagnostic':
        console.error('[accounting] diagnostic', {
          ...base,
          message: evPayload.value.message,
          context: evPayload.value.context,
        });
        break;
      default:
        console.info('[accounting] unknown event', base);
    }
  }
