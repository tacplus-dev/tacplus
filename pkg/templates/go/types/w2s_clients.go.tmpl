// TokenProvider returns a bearer token string for W2S authentication.
type TokenProvider func(context.Context) (string, error)

// TokenProviderFor returns an audience-scoped TokenProvider for a target service ID.
type TokenProviderFor func(targetServiceID string) TokenProvider

{{- range .Targets}}

