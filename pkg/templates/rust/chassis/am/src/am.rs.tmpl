}

/// Builds ErrorContext from a tonic::Status, capturing stack if appropriate.
#[track_caller]
pub fn error_context_from_status(status: &tonic::Status) -> ErrorContext {
    let code = status.code();
    capture_error_context(should_capture_stack(code))
}

