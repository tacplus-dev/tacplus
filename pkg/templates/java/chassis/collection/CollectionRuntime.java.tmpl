            skipWs(s, i);
            String key = parseJsonString(s, i);
            if (key == null) return null;
            skipWs(s, i);
            if (!consume(s, i, ':')) return null;
            skipWs(s, i);
            if (key.equals("v")) {
                int start = i[0];
                if (i[0] < s.length() && s.charAt(i[0]) == '-') i[0]++;
                while (i[0] < s.length() && Character.isDigit(s.charAt(i[0]))) i[0]++;
