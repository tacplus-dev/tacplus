/// Turn a `form_body` route's application/x-www-form-urlencoded request body
/// into the JSON object the JSON request path takes: each pair becomes one
/// string, keyed by proto field name, and a field left out is left unset. Any
/// other route or content type returns the body unchanged, so a JSON request
/// to a form route is served exactly as before. A key sent more than once is
/// refused instead of letting one copy win.
pub async fn form_body_to_json(
    route: &RouteInfo,
    content_type: Option<&axum::http::HeaderValue>,
    body: Vec<u8>,
) -> Result<Vec<u8>, (StatusCode, String)> {
    use axum::extract::FromRequest;

    let is_form = content_type
        .and_then(|v| v.to_str().ok())
        .and_then(|v| v.split(';').next())
        .is_some_and(|m| m.trim().eq_ignore_ascii_case("application/x-www-form-urlencoded"));
    if !route.form_body || !is_form {
        return Ok(body);
    }
    let request = axum::http::Request::post(route.http_path)
        .header(axum::http::header::CONTENT_TYPE, "application/x-www-form-urlencoded")
        .body(axum::body::Body::from(body))
        .map_err(|e| (StatusCode::INTERNAL_SERVER_ERROR, error_body(format!("failed to read form body: {}", e))))?;
    let axum::Form(pairs) = axum::Form::<Vec<(String, String)>>::from_request(request, &())
        .await
        .map_err(|e| (StatusCode::BAD_REQUEST, error_body(format!("invalid form body: {}", e))))?;
    let mut fields = serde_json::Map::with_capacity(pairs.len());
    for (key, value) in pairs {
        if fields.contains_key(&key) {
            return Err((StatusCode::BAD_REQUEST, error_body(format!("invalid form body: field {} sent more than once", key))));
        }
        fields.insert(key, serde_json::Value::String(value));
    }
    serde_json::to_vec(&fields)
        .map_err(|e| (StatusCode::INTERNAL_SERVER_ERROR, error_body(format!("failed to encode form body: {}", e))))
}

/// Answer a `redirect_field` route with 303 See Other to the URL its JSON
/// response carries in that field, with Cache-Control: no-store, in place of
/// the JSON body. None for any other route, so the caller answers JSON as
/// before. A response without a usable URL in the field is a backend fault.
pub fn redirect_response(route: &RouteInfo, response_json: &str) -> Option<Response> {
    let field = route.redirect_field?;
    let location = serde_json::from_str::<serde_json::Value>(response_json)
        .ok()
        .and_then(|v| v.get(field).and_then(|l| l.as_str()).map(str::to_owned))
        .filter(|l| !l.is_empty())
        .and_then(|l| axum::http::HeaderValue::from_str(&l).ok());
    let Some(location) = location else {
        return Some((
            StatusCode::BAD_GATEWAY,
            error_body(format!("response carries no redirect URL in {}", field)),
        ).into_response());
    };
    Some((
        StatusCode::SEE_OTHER,
        [
            (axum::http::header::LOCATION, location),
            (axum::http::header::CACHE_CONTROL, axum::http::HeaderValue::from_static("no-store")),
        ],
    ).into_response())
}

/// Dispatch a unary REST→gRPC call via a RestDispatcher.
///
/// The dispatcher resolves the channel and auth header for the target service.
/// Gateway: forwards incoming token + resolves backend via service health.
/// Daemon: mints a service-scoped token + uses S2S channel.
pub async fn dispatch(
    dispatcher: &dyn RestDispatcher,
    grpc_path: &str,
    body: &[u8],
    request_id: &str,
) -> DispatchResult {
    match grpc_path {
<<- range .UnaryArms >>
        "<< rustStr .GrpcPath >>" => {
<<- if .RouteField >>
            // Tenant-routed: the request names its target tenant. Decode and
            // validate it, then read the route field and refuse an empty or
            // malformed one (400) before anything is dialled.
            let req = << .FromJsonPath >>(body).map_err(|e| (StatusCode::BAD_REQUEST, error_body(format!("invalid request body: {}", e))))?;
<<- if .ValidateInput >>
            req.validate().map_err(|e| (StatusCode::BAD_REQUEST, error_body(format!("request validation failed: {}", e))))?;
<<- end >>
            let tenant = route_tenant("<< rustStr .RouteField >>", &req.<< .RouteFieldIdent >>).map_err(grpc_err)?;
            let channel = dispatcher.channel("<< rustStr .ServiceID >>", &tenant).await.map_err(grpc_err)?;
            let auth = dispatcher.auth_header("<< rustStr .ServiceID >>").await;
            let auth_ref = auth.as_deref();
            << if .IsEmptyOutput >>let _ =<< else >>let resp =<< end >> << .ClientPath >>::new(channel)
                .<< .MethodSnake >>(with_metadata(req, auth_ref, request_id))
                .await
                .map_err(grpc_err)?;
<<- else >>
            let channel = dispatcher.channel("<< rustStr .ServiceID >>", "").await.map_err(grpc_err)?;
            let auth = dispatcher.auth_header("<< rustStr .ServiceID >>").await;
            let auth_ref = auth.as_deref();
<<- if .IsEmptyInput >>
            << if .IsEmptyOutput >>let _ =<< else >>let resp =<< end >> << .ClientPath >>::new(channel)
                .<< .MethodSnake >>(with_metadata((), auth_ref, request_id))
                .await
                .map_err(grpc_err)?;
<<- else >>
            let req = << .FromJsonPath >>(body).map_err(|e| (StatusCode::BAD_REQUEST, error_body(format!("invalid request body: {}", e))))?;
<<- if .ValidateInput >>
            req.validate().map_err(|e| (StatusCode::BAD_REQUEST, error_body(format!("request validation failed: {}", e))))?;
<<- end >>
            << if .IsEmptyOutput >>let _ =<< else >>let resp =<< end >> << .ClientPath >>::new(channel)
                .<< .MethodSnake >>(with_metadata(req, auth_ref, request_id))
                .await
                .map_err(grpc_err)?;
<<- end >>
<<- end >>
<<- if .IsEmptyOutput >>
            Ok("{}".to_string())
<<- else >>
            let resp = resp.into_inner();
<<- if .ValidateOutput >>
            resp.validate().map_err(|e| (StatusCode::INTERNAL_SERVER_ERROR, error_body(format!("response validation failed: {}", e))))?;
<<- end >>
            let bytes = << .ToJsonPath >>(&resp)
                .map_err(|e| (StatusCode::INTERNAL_SERVER_ERROR, error_body(format!("failed to serialize response: {}", e))))?;
            String::from_utf8(bytes)
                .map_err(|e| (StatusCode::INTERNAL_SERVER_ERROR, error_body(format!("failed to encode response: {}", e))))
<<- end >>
        }
<<- end >>
        _ => Err((
            StatusCode::NOT_IMPLEMENTED,
            error_body(format!("unknown gRPC path: {}", grpc_path)),
        )),
    }
}

/// Dispatch a server-streaming RPC via a RestDispatcher, returning an SSE response.
#[allow(unused_variables)]
pub async fn dispatch_stream(
    dispatcher: &dyn RestDispatcher,
    grpc_path: &str,
    body: &[u8],
    request_id: &str,
) -> Response {
    match grpc_path {
<<- range .StreamArms >>
        "<< rustStr .GrpcPath >>" => {
<<- if .RouteField >>
            // Tenant-routed: decode and validate the request, then read the
            // route field and refuse an empty or malformed one (400) before
            // anything is dialled.
            let req = match << .FromJsonPath >>(body) {
                Ok(r) => r,
                Err(e) => return (StatusCode::BAD_REQUEST, error_body(format!("invalid request body: {}", e))).into_response(),
            };
<<- if .ValidateInput >>
            if let Err(e) = req.validate() {
                return (StatusCode::BAD_REQUEST, error_body(format!("request validation failed: {}", e))).into_response();
            }
<<- end >>
            let tenant = match route_tenant("<< rustStr .RouteField >>", &req.<< .RouteFieldIdent >>) {
                Ok(tenant) => tenant,
                Err(status) => return grpc_err(status).into_response(),
            };
            let channel = match dispatcher.channel("<< rustStr .ServiceID >>", &tenant).await {
                Ok(ch) => ch,
                Err(status) => {
                    let (code, msg) = grpc_err(status);
                    return (code, msg).into_response();
                }
            };
            let auth = dispatcher.auth_header("<< rustStr .ServiceID >>").await;
            let auth_ref = auth.as_deref();
            let stream = match << .ClientPath >>::new(channel)
                .<< .MethodSnake >>(with_metadata(req, auth_ref, request_id))
<<- else >>
            let channel = match dispatcher.channel("<< rustStr .ServiceID >>", "").await {
                Ok(ch) => ch,
                Err(status) => {
                    let (code, msg) = grpc_err(status);
                    return (code, msg).into_response();
                }
            };
            let auth = dispatcher.auth_header("<< rustStr .ServiceID >>").await;
            let auth_ref = auth.as_deref();
<<- if .IsEmptyInput >>
            let stream = match << .ClientPath >>::new(channel)
                .<< .MethodSnake >>(with_metadata((), auth_ref, request_id))
<<- else >>
            let req = match << .FromJsonPath >>(body) {
                Ok(r) => r,
                Err(e) => return (StatusCode::BAD_REQUEST, error_body(format!("invalid request body: {}", e))).into_response(),
            };
<<- if .ValidateInput >>
            if let Err(e) = req.validate() {
                return (StatusCode::BAD_REQUEST, error_body(format!("request validation failed: {}", e))).into_response();
            }
<<- end >>
            let stream = match << .ClientPath >>::new(channel)
                .<< .MethodSnake >>(with_metadata(req, auth_ref, request_id))
<<- end >>
<<- end >>
                .await
            {
                Ok(resp) => {
                    tracing::info!(grpc_path = %grpc_path, request_id = %request_id, "streaming RPC established");
                    resp.into_inner()
                }
                Err(status) => {
                    tracing::warn!(
                        grpc_path = %grpc_path,
                        request_id = %request_id,
                        code = ?status.code(),
                        message = %status.message(),
                        "streaming RPC failed"
                    );
                    let (code, msg) = grpc_err(status);
                    return (code, msg).into_response();
                }
            };
            let sse_stream = stream.map(|result| match result {
                Ok(msg) => {
<<- if .ValidateOutput >>
                    if let Err(e) = msg.validate() {
                        return Ok::<_, std::convert::Infallible>(sse_error(format!("response validation failed: {}", e)));
                    }
<<- end >>
                    let bytes = match << .ToJsonPath >>(&msg) {
                        Ok(bytes) => bytes,
                        Err(e) => return Ok::<_, std::convert::Infallible>(sse_error(format!("failed to serialize response: {}", e))),
                    };
                    let json = match String::from_utf8(bytes) {
                        Ok(json) => json,
                        Err(e) => return Ok::<_, std::convert::Infallible>(sse_error(format!("failed to encode response: {}", e))),
                    };
                    Ok::<_, std::convert::Infallible>(Event::default().data(json))
                }
                Err(status) => {
                    Ok(sse_error(status.message()))
                }
            });
            Sse::new(sse_stream).into_response()
        }
<<- end >>
        _ => (
            StatusCode::NOT_IMPLEMENTED,
            error_body(format!("unknown streaming gRPC path: {}", grpc_path)),
        ).into_response(),
    }
}

#[allow(dead_code)]
/// Serialize a value to a JSON response.
fn json_response<T: serde::Serialize>(value: &T) -> axum::response::Response {
    use axum::response::IntoResponse;
    match serde_json::to_string(value) {
        Ok(json) => (
            StatusCode::OK,
            [(axum::http::header::CONTENT_TYPE, "application/json".to_string())],
            json,
        ).into_response(),
        Err(e) => (
            StatusCode::INTERNAL_SERVER_ERROR,
            error_body(format!("failed to serialize response: {}", e)),
        ).into_response(),
    }
}
