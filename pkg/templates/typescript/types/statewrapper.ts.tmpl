// An outbound state call that cannot be authenticated must reach the caller as
// a structured UNAUTHENTICATED, not a language-generic Error — matching the
// generated gRPC client (grpcclient.ts.tmpl) and go/java/rust.
function unauthenticatedError(message: string): Error & { code?: number } {
    const err = new Error(message) as Error & { code?: number };
    err.code = grpc.status.UNAUTHENTICATED;
    return err;
}

