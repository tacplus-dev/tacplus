/// Authorizer trait for authorization checks on gRPC methods.
///
/// Both calls return the VERIFIED caller's identity claims on success. That
/// return value is what an accounting record attributes the call to: the claims
/// the authorizer actually checked, never something the caller wrote into a
/// header. An auth_disabled method verifies nothing and therefore accounts with
/// an empty map rather than a caller assertion.
#[tonic::async_trait]
pub trait Authorizer: Send + Sync + 'static {
    async fn authorize(&self, full_method: &str, authorization: Option<&str>) -> Result<std::collections::HashMap<String, String>, tonic::Status>;
    /// Enforces the level-or-below rule: the caller's namespace (from `authorization`)
    /// must equal or be a path-segment ancestor of `target_namespace`. Used by methods
    /// annotated with `target_namespace_field` for tenant-scoped operations.
    async fn check_at_or_below(&self, authorization: Option<&str>, target_namespace: &str) -> Result<std::collections::HashMap<String, String>, tonic::Status>;
}

