/// Converts a generated RPC enum's proto value name (e.g.
/// "TASKS_RPCS_UPDATE_TASK") into the RPC's own declared name (e.g.
/// "UpdateTask"): every such enum's variant is "<SERVICE>_RPCS_<RPC>" in
/// SCREAMING_SNAKE_CASE, so drop the "_RPCS_" prefix and re-case the
/// remainder to UpperCamelCase. Without this, AccountingRecord.method never
/// contains the RPC name any other system (grants, tracing, a caller
/// correlating a record back to the call it accounted for) uses to name the
/// same RPC — only the enum's own token does.
fn rpc_short_name(enum_value_name: &str) -> String {
    let suffix = enum_value_name
    .split_once("_RPCS_")
    .map(|(_, rest)| rest)
    .unwrap_or(enum_value_name);
    suffix
    .split('_')
    .map(|word| {
        let mut chars = word.chars();
        match chars.next() {
            Some(first) => first.to_uppercase().collect::<String>() + &chars.as_str().to_lowercase(),
            None => String::new(),
        }
    })
    .collect()
}
{{- end}}

