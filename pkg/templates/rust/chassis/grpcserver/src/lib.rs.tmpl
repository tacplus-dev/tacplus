/// Query parameters for health check endpoint
#[derive(Debug, Deserialize)]
pub struct HealthQuery {
    #[serde(default)]
    pub details: bool,
}

/// Health check response
#[derive(Debug, Serialize)]
pub struct HealthCheckResponse {
    pub status: String,
    pub timestamp: i64,
    #[serde(skip_serializing_if = "Option::is_none")]
    pub server_status: Option<ServerStatus>,
}

/// Detailed server status information
#[derive(Debug, Serialize, Clone)]
pub struct ServerStatus {
    pub tls_enabled: bool,
    pub grpc_enabled: bool,
    pub rest_enabled: bool,
    pub start_time: i64,
    pub uptime_seconds: i64,
    pub protocols_on_same_port: bool,
    pub grpc_port: u16,
    pub rest_port: u16,
}

/// Health checker that maintains server state
#[derive(Clone)]
pub struct HealthChecker {
    start_time: SystemTime,
    config: Arc<GrpcServerConfig>,
}

impl HealthChecker {
    pub fn new(config: Arc<GrpcServerConfig>) -> Self {
        Self {
            start_time: SystemTime::now(),
            config,
        }
    }

    pub fn get_server_status(&self) -> ServerStatus {
        let tls_enabled = self.config.tls.as_ref().map(|t| t.enabled).unwrap_or(false);
        let grpc_port = if self.config.grpc.enabled {
            self.config.get_grpc_port().unwrap_or(0)
        } else {
            0
        };
        let rest_port = if self.config.rest.enabled {
            self.config.get_rest_port().unwrap_or(0)
        } else {
            0
        };

        let start_timestamp = self.start_time
            .duration_since(UNIX_EPOCH)
            .unwrap_or_default()
            .as_secs() as i64;

        let uptime = SystemTime::now()
            .duration_since(self.start_time)
            .unwrap_or_default()
            .as_secs() as i64;

        ServerStatus {
            tls_enabled,
            grpc_enabled: self.config.grpc.enabled,
            rest_enabled: self.config.rest.enabled,
            start_time: start_timestamp,
            uptime_seconds: uptime,
            protocols_on_same_port: tls_enabled,
            grpc_port,
            rest_port,
        }
    }

    pub async fn handle_health_check(
        axum::extract::Query(query): axum::extract::Query<HealthQuery>,
        Extension(checker): Extension<Arc<HealthChecker>>,
    ) -> impl IntoResponse {
        let timestamp = SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .unwrap_or_default()
            .as_secs() as i64;

        let server_status = if query.details {
            Some(checker.get_server_status())
        } else {
            None
        };

        let response = HealthCheckResponse {
            status: "ok".to_string(),
            timestamp,
            server_status,
        };

        Json(response)
    }
}

// ============================================================================
// Lifecycle
// ============================================================================

/// Wait for a shutdown signal (SIGTERM or SIGINT)
pub async fn shutdown_signal() {
    let ctrl_c = async {
        tokio::signal::ctrl_c()
            .await
            .expect("failed to install Ctrl+C handler");
    };

    #[cfg(unix)]
    let terminate = async {
        tokio::signal::unix::signal(tokio::signal::unix::SignalKind::terminate())
            .expect("failed to install SIGTERM handler")
            .recv()
            .await;
    };

    #[cfg(not(unix))]
    let terminate = std::future::pending::<()>();

    tokio::select! {
        _ = ctrl_c => {
            info!("received SIGINT (Ctrl+C), initiating graceful shutdown");
        },
        _ = terminate => {
            info!("received SIGTERM, initiating graceful shutdown");
        },
    }
}

/// Coordinator for managing graceful shutdown across multiple components
pub struct ShutdownCoordinator {
    shutdown_tx: tokio::sync::broadcast::Sender<()>,
}

impl ShutdownCoordinator {
    pub fn new() -> Self {
        let (shutdown_tx, _) = tokio::sync::broadcast::channel(1);
        Self { shutdown_tx }
    }

    pub fn subscribe(&self) -> tokio::sync::broadcast::Receiver<()> {
        self.shutdown_tx.subscribe()
    }

    pub fn shutdown(&self) {
        if let Err(e) = self.shutdown_tx.send(()) {
            warn!("failed to broadcast shutdown signal: {}", e);
        }
    }

    pub async fn wait_for_signal(self) {
        shutdown_signal().await;
        self.shutdown();
    }
}

impl Default for ShutdownCoordinator {
    fn default() -> Self {
        Self::new()
    }
}

// ============================================================================
// Service Trait
// ============================================================================

/// ServiceImplementation trait that generated service code must implement.
#[async_trait::async_trait]
pub trait ServiceImplementation: Send + Sync + 'static {
    /// Register gRPC services with the tonic server.
    fn register_services(
        self: Arc<Self>,
        server: Server,
    ) -> TonicRouter;

    /// Generate REST endpoints on the Axum router.
    async fn generate_rest_endpoints(
        self: Arc<Self>,
        router: AxumRouter,
    ) -> AxumRouter;
}

/// GrpcServer manages gRPC and REST endpoints
pub struct GrpcServer<S: ServiceImplementation> {
    config: GrpcServerConfig,
    service_impl: Arc<S>,
}

impl<S: ServiceImplementation> GrpcServer<S> {
    /// Create a new GrpcServer instance
    pub fn new(
        config: GrpcServerConfig,
        service_impl: S,
    ) -> Result<Self> {
        Ok(Self {
            config,
            service_impl: Arc::new(service_impl),
        })
    }

    /// INTERNAL — not part of the public API. Start the server and listen for
    /// connections until shutdown.
    ///
    /// NOT THE SERVING ENTRY POINT — do not call this directly. Generated tacplus
    /// services are served by the generated ServiceManager, which runs its own
    /// tonic server through a rustls `ResolvesServerCert` fed by the auto-TLS
    /// renewal stream, so their serving certs rotate live without a restart.
    ///
    /// This method binds the TLS certificate ONCE at startup via tonic's
    /// `ServerTlsConfig` (see `listen_tls`), so a renewed cert does NOT take
    /// effect until the process restarts. It is retained only as a low-level
    /// building block; a live-rotating seam is intentionally not added here
    /// because the reloading resolver lives one crate up (this lib cannot import
    /// it) and duplicating it would add rustls deps for an entry point nothing
    /// calls — de-dup only, not a live bug (NEW-34).
    #[doc(hidden)]
    pub async fn listen(self) -> Result<()> {
        tracing_subscriber::fmt()
            .with_env_filter(
                tracing_subscriber::EnvFilter::try_from_default_env()
                    .unwrap_or_else(|_| tracing_subscriber::EnvFilter::new("info")),
            )
            .init();

        info!("starting GrpcServer");
        info!("configuration: {:?}", self.config);

        self.config.validate()?;

        info!("TLS mode: all protocols on same port with ALPN");
        self.listen_tls().await
    }

    async fn listen_tls(self) -> Result<()> {
        let tls_config = self.config.tls.as_ref()
            .ok_or("TLS configuration is required for TLS mode")?;
        let cert_pair = tls_config.tls_cert.as_ref()
            .ok_or("TLS certificate pair is required when TLS is enabled")?;

        let grpc_port = self.config.get_grpc_port()?;
        let addr: SocketAddr = format!("0.0.0.0:{}", grpc_port).parse()
            .map_err(|e| format!("invalid address: {}", e))?;

        info!("starting TLS server on port {} (gRPC + REST multiplexed via ALPN)", grpc_port);

        // tonic uses rustls for TLS; rustls' supported protocol set is TLS 1.2
        // and TLS 1.3, so older TLS versions are not accepted.
        let tonic_tls = tonic::transport::ServerTlsConfig::new()
            .identity(tonic::transport::Identity::from_pem(
                cert_pair.cert_pem.as_bytes(),
                cert_pair.key_pem.as_bytes(),
            ));

        let (shutdown_tx, _) = tokio::sync::broadcast::channel::<()>(1);
        let mut shutdown_rx = shutdown_tx.subscribe();

        let service_impl = self.service_impl.clone();
        let server = Server::builder()
            .tls_config(tonic_tls)
            .map_err(|e| format!("failed to configure TLS: {}", e))?;
        let server_with_services = service_impl.register_services(server);

        // Handle shutdown signals
        let shutdown_timeout = self.config.shutdown_timeout_secs;
        let signal_handle = tokio::spawn(async move {
            tokio::signal::ctrl_c().await.ok();
            info!("received shutdown signal, initiating graceful shutdown (timeout: {}s)", shutdown_timeout);
            let _ = shutdown_tx.send(());
        });

        info!("TLS server listening on {}", addr);

        tokio::select! {
            result = server_with_services.serve(addr) => {
                if let Err(e) = result {
                    error!("TLS server error: {}", e);
                }
            }
            _ = shutdown_rx.recv() => {
                info!("TLS server shutting down gracefully");
            }
        }

        signal_handle.abort();
        info!("TLS server stopped");
        Ok(())
    }

}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_default_config() {
        let config = GrpcServerConfig::default();
        assert_eq!(config.listen_address, ":8443");
        assert!(config.grpc.enabled);
        assert!(config.rest.enabled);
        assert_eq!(config.max_request_size, 10 * 1024 * 1024);
        assert_eq!(config.request_timeout_seconds, 30);
    }

    #[test]
    fn test_parse_listen_addr() {
        let config = GrpcServerConfig {
            listen_address: ":8080".to_string(),
            ..Default::default()
        };
        let addr = config.parse_listen_addr().unwrap();
        assert_eq!(addr.port(), 8080);
    }

    #[test]
    fn test_get_grpc_port_default_tls() {
        let config = GrpcServerConfig::default();
        assert_eq!(config.get_grpc_port().unwrap(), 8443);
    }

    #[test]
    fn test_get_rest_port_default_tls() {
        let config = GrpcServerConfig::default();
        assert_eq!(config.get_rest_port().unwrap(), 8443);
    }

    #[test]
    fn test_validate_requires_tls_cert_pair() {
        let config = GrpcServerConfig::default();
        assert!(config.validate().is_err());
    }

    #[test]
    fn test_validate_rejects_disabled_tls() {
        let config = GrpcServerConfig {
            tls: Some(TLSConfig {
                enabled: false,
                tls_cert: Some(X509CertPair {
                    cert_pem: "cert".to_string(),
                    key_pem: "key".to_string(),
                }),
                alpn_protocols: Vec::new(),
            }),
            ..Default::default()
        };
        assert!(config.validate().is_err());
    }

    #[test]
    fn test_validate_tls_same_port() {
        let config = GrpcServerConfig {
            tls: Some(TLSConfig {
                enabled: true,
                tls_cert: Some(X509CertPair {
                    cert_pem: "cert".to_string(),
                    key_pem: "key".to_string(),
                }),
                alpn_protocols: Vec::new(),
            }),
            grpc: ProtocolConfig { enabled: true, port: 8443 },
            rest: ProtocolConfig { enabled: true, port: 8443 },
            ..Default::default()
        };
        assert!(config.validate().is_ok());
    }

    #[test]
    fn test_validate_tls_rejects_split_ports() {
        let config = GrpcServerConfig {
            tls: Some(TLSConfig {
                enabled: true,
                tls_cert: Some(X509CertPair {
                    cert_pem: "cert".to_string(),
                    key_pem: "key".to_string(),
                }),
                alpn_protocols: Vec::new(),
            }),
            grpc: ProtocolConfig { enabled: true, port: 8443 },
            rest: ProtocolConfig { enabled: true, port: 8080 },
            ..Default::default()
        };
        assert!(config.validate().is_err());
    }

    #[test]
    fn test_from_json() {
        let json = r#"{"listen_address": ":3000", "grpc": {"enabled": false}}"#;
        let config = GrpcServerConfig::from_json_str(json).unwrap();
        assert_eq!(config.listen_address, ":3000");
        assert!(!config.grpc.enabled);
    }

    #[test]
    fn test_shutdown_coordinator() {
        let coordinator = ShutdownCoordinator::new();
        let _rx1 = coordinator.subscribe();
        let _rx2 = coordinator.subscribe();
        // Should not panic
    }

    #[test]
    fn test_health_checker_creation() {
        let config = Arc::new(GrpcServerConfig::default());
        let checker = HealthChecker::new(config);
        let status = checker.get_server_status();
        assert!(status.uptime_seconds >= 0);
    }

    #[test]
    fn test_cors_layer_creation() {
        let config = GrpcServerConfig {
            enable_cors: true,
            cors_origins: vec!["http://localhost:3000".to_string()],
            ..Default::default()
        };
        let _layer = create_cors_layer(&config);
    }
}
