    /**
     * Resolves a service endpoint by querying ServiceHealthState for healthy instances.
     * Retries with exponential backoff until a healthy instance is found.
     * Use this to obtain a channel for building custom subscribers or ad-hoc S2S calls.
     */
    public io.grpc.ManagedChannel resolveService(String serviceName) {
        long backoff = ReconnectBackoff.INITIAL_MS;
        while (true) {
            try {
                var stub = ServiceHealthStateServiceGrpc.newBlockingStub(stateStoreConn.conn())
                        .withCallCredentials(identity.callCredentials());
                {{.HealthStateOuterClass}}.InstancesEntriesResponse resp = stub.getAllInstances(
                        {{.HealthStateOuterClass}}.InstancesGetAllRequest.getDefaultInstance());
                for (var entry : resp.getEntriesMap().values()) {
                    if (entry.getServiceId().equals(serviceName)
                            && entry.getStatus() == InstanceStatus.INSTANCE_STATUS_HEALTHY) {
                        var ep = entry.getGrpcEndpoint();
                        if (ep != null && !ep.getHost().isEmpty() && ep.getPort() > 0) {
                            String target = ep.getHost() + ":" + ep.getPort();
                            LOG.info("Resolved " + serviceName + " endpoint via health entries: " + target);
                            return channelFactory.create(serviceName, target);
                        }
                    }
                }
                LOG.warning("No healthy instance found for " + serviceName + ", retrying in " + backoff + "ms");
            } catch (Exception e) {
                LOG.warning("Failed to query ServiceHealthState for " + serviceName + ": " + e.getMessage()
                        + ", retrying in " + backoff + "ms");
            }
            try { Thread.sleep(ReconnectBackoff.jitterMs(backoff)); } catch (InterruptedException ie) {
                Thread.currentThread().interrupt();
                throw new RuntimeException("interrupted while resolving " + serviceName);
            }
            backoff = ReconnectBackoff.next(backoff);
        }
    }

    /**
     * Owns the gRPC health endpoint (k8s readiness) once bootstrap is done.
     *
     * <p>SERVING requires both: the last effective health status was not
     * UNHEALTHY ({@code healthOk}, fed by the HealthReporter status sink), and
     * every required s2s channel is up — each event-bus subscription channel
     * ({@code streams}){{if .S2STargetsRequired}} and each explicitly declared s2s target{{end}}.
     * Reporting Ready while those channels were still being dialed put pods in
     * rotation that could not do their job for minutes after a peer restart.
     *
     * <p>Only readiness is gated. The status published to ServiceHealthState is
     * not: peers resolve each other through it, so gating it on dependencies
     * would deadlock any two services that depend on each other.
     */
    private void driveReadiness(GrpcServer readyCtl, AtomicBoolean healthOk, java.util.List<RequiredChannels.RequiredStream> streams) {
        final long readinessCheckIntervalMs = 1000;
        RequiredChannels required = new RequiredChannels(java.util.List.of(
{{- if .S2STargetsRequired}}
{{- range $i, $t := .TargetServices}}{{if $i}},{{end}}
                {{if eq $t.ServiceID $.StateStoreServiceID}}stateStoreConn{{else}}{{$t.FieldName}}{{end}}
{{- end}}
{{- end}}
        ), streams);
        Boolean serving = null;
        while (!Thread.currentThread().isInterrupted()) {
            java.util.Optional<String> down = required.firstDown();
            boolean ready = healthOk.get() && down.isEmpty();
            if (serving == null || serving != ready) {
                serving = ready;
                if (ready) {
                    LOG.info("readiness: SERVING");
                } else if (down.isPresent()) {
                    LOG.warning("readiness: NOT_SERVING, required s2s channel is down: " + down.get());
                } else {
                    LOG.warning("readiness: NOT_SERVING, health status is UNHEALTHY");
                }
                readyCtl.setReady(ready);
            }
            try { Thread.sleep(readinessCheckIntervalMs); } catch (InterruptedException ie) {
                Thread.currentThread().interrupt();
                return;
            }
        }
    }

    private static void awaitPublisherReady(
            io.grpc.stub.ClientCallStreamObserver<?> requestStream,
            CountDownLatch streamReady) throws Exception {
        if (requestStream == null) {
            throw new IllegalStateException("publisher request stream was not initialized");
        }
        while (!requestStream.isReady()) {
            if (streamReady.await(1, TimeUnit.SECONDS)) {
                continue;
            }
            if (Thread.currentThread().isInterrupted()) {
                throw new InterruptedException("interrupted while waiting for publisher stream readiness");
            }
        }
    }

