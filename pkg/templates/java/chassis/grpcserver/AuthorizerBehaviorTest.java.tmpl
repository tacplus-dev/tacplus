// Behavioral self-test for the REAL generated Authorizer (PC-W-1, Java leg —
// mirrors go/chassis/grpcserver/authorizer_behavior_test.go.tmpl): mints real
// Ed25519 JWTs, seeds the matching JWK through the public JwkSource seam, and
// drives authorizeWithToken / authenticateAtOrBelowWithToken over the actual
// verify path — signature, audience, expiry, unknown-kid, tamper, S2S
// auth_services, C2S entitlements presence, and the namespace level-or-below
// rule. No fake auth funcs. Run as a plain main-method self-test by the
// cross-test gates (like ServiceConnectionTest).
public class AuthorizerBehaviorTest {
    private static int failures = 0;

    private static final String TEST_METHOD = "/demo.DemoService/DoThing";

    private static ImmutableKey newTestKey() throws Exception {
        KeyOuterClass.Key proto = KeyHelpers.newEd25519Key();
        return ImmutableKey.from(proto);
    }

    // jwkForKey builds the verifying JWK proto (OKP/Ed25519) for a signing key,
    // keyed by the key's id (the kid sign() stamps into the token header). The
    // raw 32-byte public key is the tail of the X.509 SPKI encoding.
    private static JwkOuterClass.Jwk jwkForKey(ImmutableKey key) {
        byte[] spki = key.getPublicKey().getEncoded();
        byte[] raw = new byte[32];
        System.arraycopy(spki, spki.length - 32, raw, 0, 32);
        return JwkOuterClass.Jwk.newBuilder()
            .setKid(key.getProto().getId())
            .setKty(KeyOuterClass.KeyType.KEY_TYPE_OKP)
            .setCrv("Ed25519")
            .setX(Base64.getUrlEncoder().withoutPadding().encodeToString(raw))
            .build();
    }

    // authorizerWithKeys builds an Authorizer (no live JWK-view conn) seeded
    // with the given verifying keys via the public JwkSource seam.
    private static Authorizer authorizerWithKeys(JwkOuterClass.Jwk... jwks) {
        Map<String, JwkOuterClass.Jwk> entries = new java.util.HashMap<>();
        for (JwkOuterClass.Jwk jwk : jwks) {
            entries.put(jwk.getKid(), jwk);
        }
        return new Authorizer(sink -> sink.update(entries));
    }

    private interface Customize {
        void apply(TokenWrapper tok) throws Exception;
    }

    // signedToken mints a token with the shared valid claims (issuer, audience,
    // future expiry), applies the customization, and signs it with key.
    private static String signedToken(ImmutableKey key, Customize customize) throws Exception {
        TokenWrapper tok = TokenWrapper.create()
            .setIssuer("test-issuer")
            .setAudience(Authorizer.SERVICE_NAME)
            .setExpiration(System.currentTimeMillis() / 1000 + 3600)
            .setNamespace("/tenants/acme");
        customize.apply(tok);
        tok.sign(key);
        return tok.getBase64();
    }

    private static String bearer(String token) {
        return "Bearer " + token;
    }

    private static void mustPass(String name, ThrowingRunnable r) {
        try {
            r.run();
        } catch (Exception e) {
            System.err.println("FAIL: " + name + " must be authorized, got: " + e);
            failures++;
        }
    }

    private static void checkPattern(String name, String pattern, String input, boolean want) {
        if (Pattern.compile(pattern).matcher(input).matches() != want) {
            System.err.println("FAIL: " + name + ": " + input + " want " + want);
            failures++;
        }
    }

    private static void mustReject(String name, ThrowingRunnable r) {
        try {
            r.run();
            System.err.println("FAIL: " + name + " must be denied (fail-open)");
            failures++;
        } catch (ProtoException expected) {
            // Denied via the typed error path — expected.
        } catch (Exception e) {
            System.err.println("FAIL: " + name + " threw an untyped error: " + e);
            failures++;
        }
    }

    private interface ThrowingRunnable {
        void run() throws Exception;
    }

    public static void main(String[] args) throws Exception {
        // A valid, correctly-signed service token whose caller matches the
        // method's auth_services pattern is authorized.
        ImmutableKey key = newTestKey();
        Authorizer a = authorizerWithKeys(jwkForKey(key));
        a.setMethodAuth(TEST_METHOD, List.of("caller-svc"));
        String valid = signedToken(key, tok -> tok.setSubType("service").setSubject("caller-svc"));
        mustPass("valid service token", () -> a.authorizeWithToken(bearer(valid), TEST_METHOD, null));

        // A service caller that does not match auth_services is denied.
        Authorizer mismatched = authorizerWithKeys(jwkForKey(key));
        mismatched.setMethodAuth(TEST_METHOD, List.of("allowed-svc"));
        String otherSvc = signedToken(key, tok -> tok.setSubType("service").setSubject("other-svc"));
        mustReject("service not in auth_services", () -> mismatched.authorizeWithToken(bearer(otherSvc), TEST_METHOD, null));

        // ---- auth_services: workloads (ephemeral pigeons) are not service callers ----
        // The SPIFFE id MintWorkload gives a pigeon minted under beagle; its
        // service path is beagle/workloads/pigeon-<run_id>.
        String pigeonSub = "spiffe://example.com/system/aws/az1/cluster1/services/beagle/workloads/pigeon-01arz3ndektsv4rrffq69g5fav";
        String pigeon = signedToken(key, tok -> tok.setSubType("workload").setSubject(pigeonSub));
        Authorizer star = authorizerWithKeys(jwkForKey(key));
        star.setMethodAuth(TEST_METHOD, List.of("*"));
        mustReject("\"*\" must not admit a workload subject", () -> star.authorizeWithToken(bearer(pigeon), TEST_METHOD, null));
        String beagleSvc = signedToken(key, tok -> tok.setSubType("service").setSubject("beagle"));
        mustPass("\"*\" still admits a service subject", () -> star.authorizeWithToken(bearer(beagleSvc), TEST_METHOD, null));

        Authorizer named = authorizerWithKeys(jwkForKey(key));
        named.setMethodAuth(TEST_METHOD, List.of("beagle/workloads/pigeon-[a-z0-9]+"));
        mustPass("named workload pattern admits the pigeon", () -> named.authorizeWithToken(bearer(pigeon), TEST_METHOD, null));

        Authorizer pigeonPath = authorizerWithKeys(jwkForKey(key));
        pigeonPath.setMethodAuth(TEST_METHOD, List.of(Authorizer.PIGEON_SERVICE_PATH));
        mustPass("PIGEON_SERVICE_PATH admits a pigeon", () -> pigeonPath.authorizeWithToken(bearer(pigeon), TEST_METHOD, null));

        // PIGEON_SERVICE_PATH matches pigeons only; pigeonServicePathFor scopes
        // to one parent and quotes it.
        checkPattern("PIGEON_SERVICE_PATH matches a pigeon", Authorizer.PIGEON_SERVICE_PATH,
            "beagle/workloads/pigeon-01arz3ndektsv4rrffq69g5fav", true);
        checkPattern("PIGEON_SERVICE_PATH matches another parent's pigeon", Authorizer.PIGEON_SERVICE_PATH,
            "llmproxy/workloads/pigeon-0000", true);
        checkPattern("PIGEON_SERVICE_PATH rejects the parent service", Authorizer.PIGEON_SERVICE_PATH, "beagle", false);
        checkPattern("PIGEON_SERVICE_PATH rejects a non-pigeon workload", Authorizer.PIGEON_SERVICE_PATH,
            "beagle/workloads/agent-42", false);
        checkPattern("PIGEON_SERVICE_PATH rejects an uppercase run id", Authorizer.PIGEON_SERVICE_PATH,
            "beagle/workloads/pigeon-01ARZ3", false);
        checkPattern("pigeonServicePathFor matches its parent's pigeon", Authorizer.pigeonServicePathFor("beagle"),
            "beagle/workloads/pigeon-01arz3ndektsv4rrffq69g5fav", true);
        checkPattern("pigeonServicePathFor rejects another parent", Authorizer.pigeonServicePathFor("beagle"),
            "llmproxy/workloads/pigeon-01arz3ndektsv4rrffq69g5fav", false);
        checkPattern("pigeonServicePathFor quotes a dot", Authorizer.pigeonServicePathFor("a.b"),
            "axb/workloads/pigeon-01arz3", false);

        // -----------------------------------------------------------------
        // auth_actors: the delegation gate
        // -----------------------------------------------------------------

        // A token with NO act claim is not a delegated call: the auth_actors
        // gate must not touch it, even on a method that declares actors.
        Authorizer noAct = authorizerWithKeys(jwkForKey(key));
        noAct.setMethodAuth(TEST_METHOD, List.of("caller-svc"));
        noAct.setMethodActors(TEST_METHOD, List.of("some-agent"));
        mustPass("token with no act claim", () -> noAct.authorizeWithToken(bearer(valid), TEST_METHOD, null));

        // A token whose act claim matches one of the method's auth_actors
        // patterns is authorized (auth_services still applies underneath).
        Authorizer actorOk = authorizerWithKeys(jwkForKey(key));
        actorOk.setMethodAuth(TEST_METHOD, List.of("caller-svc"));
        actorOk.setMethodActors(TEST_METHOD, List.of("mcp/workloads/agent-42"));
        String delegated = signedToken(key, tok -> tok.setSubType("service").setSubject("caller-svc").setAct("mcp/workloads/agent-42"));
        mustPass("act matching a declared auth_actors pattern", () -> actorOk.authorizeWithToken(bearer(delegated), TEST_METHOD, null));

        // Fail closed: a method that declares NO auth_actors admits no
        // delegated call at all, however well the caller authenticates.
        Authorizer noActors = authorizerWithKeys(jwkForKey(key));
        noActors.setMethodAuth(TEST_METHOD, List.of("caller-svc"));
        mustReject("act with no auth_actors declared", () -> noActors.authorizeWithToken(bearer(delegated), TEST_METHOD, null));

        // An act claim that matches none of the declared patterns is denied.
        Authorizer actorMismatch = authorizerWithKeys(jwkForKey(key));
        actorMismatch.setMethodAuth(TEST_METHOD, List.of("caller-svc"));
        actorMismatch.setMethodActors(TEST_METHOD, List.of("allowed-agent"));
        String otherActor = signedToken(key, tok -> tok.setSubType("service").setSubject("caller-svc").setAct("other-agent"));
        mustReject("act not in auth_actors", () -> actorMismatch.authorizeWithToken(bearer(otherActor), TEST_METHOD, null));

        // "*" is the match-any shorthand for auth_actors, as for auth_services.
        Authorizer anyActor = authorizerWithKeys(jwkForKey(key));
        anyActor.setMethodAuth(TEST_METHOD, List.of("caller-svc"));
        anyActor.setMethodActors(TEST_METHOD, List.of("*"));
        String wildcardActor = signedToken(key, tok -> tok.setSubType("service").setSubject("caller-svc").setAct("any/old/agent"));
        mustPass("auth_actors \"*\" admits any actor", () -> anyActor.authorizeWithToken(bearer(wildcardActor), TEST_METHOD, null));

        // An expired token is rejected even with a valid signature.
        String expired;
        {
            TokenWrapper tok = TokenWrapper.create()
                .setIssuer("test-issuer")
                .setAudience(Authorizer.SERVICE_NAME)
                .setExpiration(System.currentTimeMillis() / 1000 - 3600)
                .setNamespace("/tenants/acme")
                .setSubType("service")
                .setSubject("caller-svc");
            tok.sign(key);
            expired = tok.getBase64();
        }
        mustReject("expired token", () -> a.authorizeWithToken(bearer(expired), TEST_METHOD, null));

        // A token whose audience does not match this service is rejected.
        String wrongAud;
        {
            TokenWrapper tok = TokenWrapper.create()
                .setIssuer("test-issuer")
                .setAudience(Authorizer.SERVICE_NAME + "-not-me")
                .setExpiration(System.currentTimeMillis() / 1000 + 3600)
                .setNamespace("/tenants/acme")
                .setSubType("service")
                .setSubject("caller-svc");
            tok.sign(key);
            wrongAud = tok.getBase64();
        }
        mustReject("wrong audience", () -> a.authorizeWithToken(bearer(wrongAud), TEST_METHOD, null));

        // A token signed by a key whose kid is not in the cache is rejected.
        Authorizer unknownKid = authorizerWithKeys(jwkForKey(newTestKey()));
        unknownKid.setMethodAuth(TEST_METHOD, List.of("caller-svc"));
        mustReject("unknown kid", () -> unknownKid.authorizeWithToken(bearer(valid), TEST_METHOD, null));

        // A JWK under the REAL kid but with the WRONG public key must not verify
        // — the CA-only/blind-trust hole.
        ImmutableKey wrongKey = newTestKey();
        JwkOuterClass.Jwk forged = jwkForKey(wrongKey).toBuilder()
            .setKid(key.getProto().getId())
            .build();
        Authorizer tampered = authorizerWithKeys(forged);
        tampered.setMethodAuth(TEST_METHOD, List.of("caller-svc"));
        mustReject("tampered signature", () -> tampered.authorizeWithToken(bearer(valid), TEST_METHOD, null));

        // A user (C2S) token with no service_entitlements claim is denied —
        // entitlements are fail-closed.
        String user = signedToken(key, tok -> tok.setSubType("user").setSubject("someone@example.com"));
        mustReject("user token missing entitlements", () -> a.authorizeWithToken(bearer(user), TEST_METHOD, null));

        // AuthenticateAtOrBelow enforces the universal namespace rule: the
        // caller's namespace must be at or above the target.
        String above = signedToken(key, tok -> tok.setSubType("service").setSubject("caller-svc").setNamespace("/a"));
        mustPass("caller at-or-above target", () -> a.authenticateAtOrBelowWithToken(bearer(above), "/a/b"));
        String below = signedToken(key, tok -> tok.setSubType("service").setSubject("caller-svc").setNamespace("/a/b"));
        mustReject("caller below target", () -> a.authenticateAtOrBelowWithToken(bearer(below), "/a"));

        // ---- tenant-owned instance: another tenant's caller is refused at the door ----
        // A token's aud is the service name, which every tenant's instance accepts,
        // so an untargeted RPC would admit a /tenants/acme token on beta's
        // instance. With the host namespace set, only beta, /system and the root
        // pass; a shared instance (or none set) admits every tenant as before.
        Authorizer betaInstance = authorizerWithKeys(jwkForKey(key));
        betaInstance.setMethodAuth(TEST_METHOD, List.of("caller-svc"));
        betaInstance.setHostNamespace("/tenants/beta");
        for (String ns : List.of("/tenants/beta", "/system", "/system/us-east", "/")) {
            String tok = signedToken(key, t -> t.setSubType("service").setSubject("caller-svc").setNamespace(ns));
            mustPass("caller in " + ns + " on beta's instance", () -> betaInstance.authorizeWithToken(bearer(tok), TEST_METHOD, null));
        }
        for (String ns : List.of("/tenants/acme", "/tenants/beta2", "/tenants/beta/sub", "/users/u1")) {
            String tok = signedToken(key, t -> t.setSubType("service").setSubject("caller-svc").setNamespace(ns));
            mustReject("caller in " + ns + " on beta's instance", () -> betaInstance.authorizeWithToken(bearer(tok), TEST_METHOD, null));
            mustReject("authenticate of " + ns + " on beta's instance", () -> betaInstance.authenticateWithToken(bearer(tok)));
        }
        for (String host : List.of("", "/system", "/system/us-east", "/tenants", "/tenants/a/b")) {
            Authorizer shared = authorizerWithKeys(jwkForKey(key));
            shared.setMethodAuth(TEST_METHOD, List.of("caller-svc"));
            shared.setHostNamespace(host);
            mustPass("host \"" + host + "\" admits /tenants/acme", () -> shared.authorizeWithToken(bearer(valid), TEST_METHOD, null));
        }

        // ---- enforcingInterceptor: wrong audience rejected ----
        // Simulates what additionalServices (e.g. TypedEventBusBindings) see:
        // the enforcingInterceptor calls authenticateWithToken which must reject
        // a token whose audience does not match this service.
        {
            String wrongAudToken;
            {
                TokenWrapper tok = TokenWrapper.create()
                    .setIssuer("test-issuer")
                    .setAudience("kernel")
                    .setExpiration(System.currentTimeMillis() / 1000 + 3600)
                    .setNamespace("/tenants/acme")
                    .setSubType("service")
                    .setSubject("caller-svc");
                tok.sign(key);
                wrongAudToken = tok.getBase64();
            }
            mustReject("enforcingInterceptor: wrong audience",
                () -> a.authenticateWithToken("Bearer " + wrongAudToken));
        }

        // ---- enforcingInterceptor: missing token rejected ----
        mustReject("enforcingInterceptor: missing token",
            () -> a.authenticateWithToken(null));

        // ---- enforcingInterceptor: correct audience accepted ----
        mustPass("enforcingInterceptor: correct audience",
            () -> a.authenticateWithToken(bearer(valid)));

        // ---- two co-hosted services, same rpc name, separate policies ----
        // Keyed by the bare rpc name ("Get"), the second registration silently
        // overwrote the first, so whichever service registered last decided
        // authorization for BOTH — a caller entitled to AlphaService/Get also
        // passed for BetaService/Get. Policy is keyed by the service-qualified
        // identifier the wrapper passes to authorize() instead.
        {
            final String alphaMethod = "AlphaService/Get";
            final String betaMethod = "BetaService/Get";
            Authorizer cohosted = authorizerWithKeys(jwkForKey(key));
            // Exactly what two generated registerMethodAuth methods do against
            // the one Authorizer the ServiceManager builds.
            cohosted.setMethodAuth(alphaMethod, List.of("alpha-caller"));
            cohosted.setMethodAuth(betaMethod, List.of("beta-caller"));

            String alphaTok = signedToken(key, tok -> tok.setSubType("service").setSubject("alpha-caller"));
            String betaTok = signedToken(key, tok -> tok.setSubType("service").setSubject("beta-caller"));

            mustPass("co-hosted: alpha-caller on AlphaService/Get",
                () -> cohosted.authorizeWithToken(bearer(alphaTok), alphaMethod, null));
            mustPass("co-hosted: beta-caller on BetaService/Get",
                () -> cohosted.authorizeWithToken(bearer(betaTok), betaMethod, null));
            mustReject("co-hosted: alpha-caller must not cross to BetaService/Get",
                () -> cohosted.authorizeWithToken(bearer(alphaTok), betaMethod, null));
            mustReject("co-hosted: beta-caller must not cross to AlphaService/Get",
                () -> cohosted.authorizeWithToken(bearer(betaTok), alphaMethod, null));

            // The same collision reaches target_namespace_field: only alpha's
            // Get names a target field, so beta's must stay unguarded rather
            // than inheriting alpha's field name.
            cohosted.setMethodTargetNamespaceField(alphaMethod, "tenant_namespace");
            mustPass("co-hosted: BetaService/Get does not inherit alpha's target_namespace_field",
                () -> cohosted.authorizeWithToken(bearer(betaTok), betaMethod, null));
        }

        // ---- the bare rpc name is NOT a policy key ----
        // This is the half that makes the check above non-vacuous. The bare
        // name used to be a lookup fallback, so a single registration under
        // "Get" answered for EVERY co-hosted service's Get. Registering a bare
        // name now matches nothing, and both services fail closed rather than
        // one inheriting the other's auth_services.
        {
            Authorizer bareKeyed = authorizerWithKeys(jwkForKey(key));
            bareKeyed.setMethodAuth("Get", List.of("alpha-caller"));
            String alphaTok = signedToken(key, tok -> tok.setSubType("service").setSubject("alpha-caller"));
            mustReject("bare rpc name is not a key: AlphaService/Get",
                () -> bareKeyed.authorizeWithToken(bearer(alphaTok), "AlphaService/Get", null));
            mustReject("bare rpc name is not a key: BetaService/Get",
                () -> bareKeyed.authorizeWithToken(bearer(alphaTok), "BetaService/Get", null));
        }

        checkRemoteJwkSourceBackoff(jwkForKey(key));

        if (failures > 0) {
            System.err.println(failures + " Authorizer behavior check(s) FAILED");
            System.exit(1);
        }
        System.out.println("AuthorizerBehaviorTest: all checks passed");
    }

    // The remote JWK watch against a key authority that is rolling (every Watch
    // fails UNAVAILABLE) re-subscribes on the Backoff schedule (0.5s, 1s, 2s, ...),
    // not in a hot loop; it keeps retrying until the authority serves again, and
    // stop() ends it.
    private static void checkRemoteJwkSourceBackoff(JwkOuterClass.Jwk jwk) throws Exception {
        AtomicInteger watches = new AtomicInteger();
        AtomicBoolean serving = new AtomicBoolean(false);
        AtomicReference<StreamObserver<Jwkview.JwkViewResponse>> served = new AtomicReference<>();
        Server server = NettyServerBuilder.forPort(0)
            .addService(new JwkVerifyingKeysViewServiceGrpc.JwkVerifyingKeysViewServiceImplBase() {
                @Override
                public void watch(Trace.TraceRequest request, StreamObserver<Jwkview.JwkViewResponse> out) {
                    watches.incrementAndGet();
                    if (serving.get()) {
                        served.set(out);
                        out.onNext(Jwkview.JwkViewResponse.newBuilder().putEntries(jwk.getKid(), jwk).build());
                    } else {
                        out.onError(Status.UNAVAILABLE.withDescription("authority rolling").asRuntimeException());
                    }
                }
            })
            .build()
            .start();
        ManagedChannel channel = ManagedChannelBuilder.forAddress("127.0.0.1", server.getPort()).usePlaintext().build();
        CountDownLatch delivered = new CountDownLatch(1);
        Authorizer.JwkSource source = Authorizer.remoteSource(channel);
        // Every failed attempt logs the expected "reconnecting" WARN; keep it out of
        // the gate's clean-log check.
        Logger sourceLogger = (Logger) LoggerFactory.getLogger(RemoteJwkSource.class);
        Level sourceLevel = sourceLogger.getLevel();
        sourceLogger.setLevel(Level.ERROR);
        try {
            source.start(entries -> {
                if (entries.containsKey(jwk.getKid())) {
                    delivered.countDown();
                }
            });

            // Attempts at ~0s, 0.5s, 1.5s; the next is not due until ~3.5s.
            Thread.sleep(2_500);
            int failing = watches.get();
            if (failing < 2 || failing > 4) {
                System.err.println("FAIL: JWK watch made " + failing
                    + " attempts in 2.5s against a rolling authority, want 2..4 (backoff 0.5s doubling)");
                failures++;
            }

            serving.set(true);
            if (!delivered.await(10, TimeUnit.SECONDS)) {
                System.err.println("FAIL: JWK watch did not reconnect once the authority served again");
                failures++;
                return;
            }

            // After stop(), the stream dropping again must not re-subscribe.
            source.stop();
            int atStop = watches.get();
            served.get().onError(Status.UNAVAILABLE.withDescription("authority rolling").asRuntimeException());
            Thread.sleep(1_000);
            if (watches.get() != atStop) {
                System.err.println("FAIL: JWK watch re-subscribed after stop()");
                failures++;
            }
        } finally {
            source.stop();
            channel.shutdownNow();
            server.shutdownNow();
            sourceLogger.setLevel(sourceLevel);
        }
    }
}
