/// Typed W2S client for {{$service.ServiceName}}.
public struct {{$service.ClientTypeName}}: Sendable {
    public let client: W2SClient

    public init(client: W2SClient) {
        self.client = client
    }
{{range .Methods}}
{{- if .IsStreaming}}

    /// Streams {{$service.PackageName}}.{{.MethodName}} via W2S server-sent events.
    ///
    /// The stream has no deadline; cancel the enclosing `Task` to end it.
    public func {{.SwiftMethodName}}(_ request: {{.InputType}}) async throws -> AsyncThrowingStream<{{.OutputType}}, Error> {
        try await self.client.invokeStream(
            method: "{{.HTTPMethod}}",
            path: "{{.HTTPPath}}",
            authRequired: {{.AuthRequired}},
            request: request
        )
    }
{{- else if .IsUnsupportedStream}}

    /// {{$service.PackageName}}.{{.MethodName}} is client-streaming or bidirectional. The
    /// gateway carries those over WebSocket, which the Swift W2S client does not
    /// speak. Use the Go, Java, or Rust W2S client for them.
    @available(*, unavailable, message: "{{.MethodName}} is client-streaming or bidi (WebSocket); not supported by the Swift W2S client")
    public func {{.SwiftMethodName}}(_ request: {{.InputType}}) async throws -> {{.OutputType}} {
        fatalError("Swift W2S client does not support client-streaming/bidi method {{.MethodName}}; use the Go/Java/Rust W2S client")
    }
{{- else}}

    /// Calls {{$service.PackageName}}.{{.MethodName}} via W2S HTTP/JSON.
    public func {{.SwiftMethodName}}(_ request: {{.InputType}}) async throws -> {{.OutputType}} {
        try await self.client.invoke(
            method: "{{.HTTPMethod}}",
            path: "{{.HTTPPath}}",
            authRequired: {{.AuthRequired}},
            request: request
        )
    }
{{- end}}
{{end}}
}
