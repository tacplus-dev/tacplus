// CaptureErrorContext builds an ErrorContext from the current call site.
// Captures caller (file:line) and function name cheaply via runtime.Caller.
// Captures full stack trace only when shouldCaptureStack is true.
func CaptureErrorContext(skip int, shouldCaptureStack bool) *accounting_pb.ErrorContext {
	ec := &accounting_pb.ErrorContext{}

	pc, file, line, ok := runtime.Caller(skip + 1)
	if ok {
		ec.Caller = fmt.Sprintf("%s:%d", file, line)
		if fn := runtime.FuncForPC(pc); fn != nil {
			ec.Function = fn.Name()
		}
	}

	if shouldCaptureStack {
		buf := make([]byte, 4096)
		n := runtime.Stack(buf, false)
		ec.StackTrace = string(buf[:n])
	}

	return ec
}

// ShouldCaptureStack returns true for gRPC codes that indicate our bugs
// (Internal, Unknown, DataLoss). Returns false for user errors
// (InvalidArgument, Unauthenticated, PermissionDenied, etc.).
func ShouldCaptureStack(code codes.Code) bool {
	switch code {
	case codes.Internal, codes.Unknown, codes.DataLoss:
		return true
	default:
		return false
	}
}

// GrpcCodeFromError extracts the gRPC status code from an error.
// Returns codes.Unknown if the error doesn't carry a gRPC status.
func GrpcCodeFromError(err error) codes.Code {
	if err == nil {
		return codes.OK
	}
	if st, ok := status.FromError(err); ok {
		return st.Code()
	}
	return codes.Unknown
}

// ErrorContextFromError extracts ErrorContext from an error.
// If the error is an *ErrorWithCaller (our enhanced error type), it uses the
// caller info captured at error creation. Otherwise, captures from the current
// call site.
func ErrorContextFromError(err error, shouldCaptureStack bool) *accounting_pb.ErrorContext {
	// Try to extract caller info from our enhanced error type.
	// ErrorWithCaller is defined in the errors package — we use the interface
	// pattern to avoid an import cycle.
	type callerProvider interface {
		CallerFile() string
		CallerLine() int
		CallerFunction() string
	}
	if cp, ok := err.(callerProvider); ok {
		ec := &accounting_pb.ErrorContext{
			Caller:   fmt.Sprintf("%s:%d", cp.CallerFile(), cp.CallerLine()),
			Function: cp.CallerFunction(),
		}
		if shouldCaptureStack {
			// Stack trace from creation site is not available via the error;
			// capture current stack as a fallback.
			buf := make([]byte, 4096)
			n := runtime.Stack(buf, false)
			ec.StackTrace = string(buf[:n])
		}
		return ec
