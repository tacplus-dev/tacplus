/// LoggerSink delegates typed accounting events to tracing as structured log entries.
pub struct LoggerSink;

#[tonic::async_trait]
impl Sink for LoggerSink {
    async fn emit(&self, event: &Event) {
        let source_id = &event.source_id;
        let request_id = &event.request_id;
        let timestamp_ms = event.timestamp_ms;

        match &event.event {
            Some(event::Event::RpcCompleted(p)) => {
                let method = p.method.as_ref().map(method_label).unwrap_or_default();
                let outcome = RpcOutcome::try_from(p.outcome).unwrap_or(RpcOutcome::Undefined);
                let reason = RpcReason::try_from(p.reason).unwrap_or(RpcReason::Undefined);
                let metrics = p.metrics.clone().unwrap_or_default();
                macro_rules! rpc_completed {
                    ($log:ident) => {
                        tracing::$log!(
                            source_id = %source_id,
                            timestamp_ms = timestamp_ms,
                            request_id = %request_id,
                            event = "rpc_completed",
                            method = %method,
                            outcome = outcome.as_str_name(),
                            code = p.code,
                            reason = reason.as_str_name(),
                            duration_ms = p.duration_ms,
                            records_returned = metrics.records_returned,
                            bytes = metrics.bytes,
                            "accounting"
                        )
                    };
                }
                match level_for(outcome) {
                    EventLevel::Error => rpc_completed!(error),
                    EventLevel::Warn => rpc_completed!(warn),
                    _ => rpc_completed!(info),
                }
            }
            Some(event::Event::EndpointHealthChanged(p)) => {
                tracing::warn!(
                    source_id = %source_id,
                    timestamp_ms = timestamp_ms,
                    event = "endpoint_health_changed",
                    endpoint = %p.endpoint,
                    healthy = p.healthy,
                    latency_ms = p.latency_ms,
                    "accounting"
                );
            }
            Some(event::Event::StateUpdated(p)) => {
                tracing::info!(
                    source_id = %source_id,
                    timestamp_ms = timestamp_ms,
                    request_id = %request_id,
                    event = "state_updated",
                    entity_type = %p.entity_type,
                    entity_id = %p.entity_id,
                    "accounting"
                );
            }
            _ => {
                tracing::info!(
                    source_id = %source_id,
                    timestamp_ms = timestamp_ms,
                    request_id = %request_id,
                    "accounting (unknown event type)"
                );
            }
        }
    }
}

