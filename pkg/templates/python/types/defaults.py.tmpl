{{- /* Python defaults template */ -}}
# ---- Defaults ----
{{- range .Defaults}}

def {{.FuncName}}_defaults(msg: {{.QualifiedType}}) -> None:
    """Applies default values to zero-valued fields of {{.TypeName}}."""
    if msg is None:
        return
{{- range .Fields}}
{{- if eq .AnnKey "default_string"}}
    if {{pyGet "msg" .PyFieldName}} == "":
        {{pySet "msg" .PyFieldName .ConstantName}}
{{- else if eq .AnnKey "default_int"}}
    if {{pyGet "msg" .PyFieldName}} == 0:
        {{pySet "msg" .PyFieldName .ConstantName}}
{{- else if eq .AnnKey "default_float"}}
    if {{pyGet "msg" .PyFieldName}} == 0.0:
        {{pySet "msg" .PyFieldName .ConstantName}}
{{- else if eq .AnnKey "default_bool"}}
    if not {{pyGet "msg" .PyFieldName}}:
        {{pySet "msg" .PyFieldName .ConstantName}}
{{- else if eq .AnnKey "default_host"}}
    if not msg.HasField("{{.ProtoFieldName}}"):
        {{pyGet "msg" .PyFieldName}}.host = "{{.HostHost}}"
        {{pyGet "msg" .PyFieldName}}.port = {{.HostPort}}
{{- end}}
{{- end}}
{{- range .SubMsgCalls}}
{{- if .InitIfNil}}
    if not msg.HasField("{{.HasFieldName}}"):
        {{pyGet "msg" .PyFieldName}}.SetInParent()
{{- if .HasDefaults}}
    {{.FuncName}}_defaults({{pyGet "msg" .PyFieldName}})
{{- end}}
{{- else}}
    if msg.HasField("{{.HasFieldName}}"):
        {{.FuncName}}_defaults({{pyGet "msg" .PyFieldName}})
{{- end}}
{{- end}}
{{- if and (eq (len .Fields) 0) (eq (len .SubMsgCalls) 0)}}
    pass
{{- end}}
{{- end}}
