// The c2d transport both ends share: the endpoint a service_c2d socket_path
// names on each OS (docs/API.md, C2D transport). macOS and Linux use the Unix
// socket at socket_path itself; Windows uses the named pipe C2DPipeName
// derives from it.

package serviceconnection

import (
	"context"
	"net"
	"strings"
)

// C2DPipePrefix is the Windows named pipe namespace and the tacplus c2d prefix
// every c2d pipe name starts with.
const C2DPipePrefix = `\\.\pipe\tacplus-c2d-`

// C2DPipeName returns the Windows named pipe a c2d daemon serves on, and its
// clients dial, for socketPath: C2DPipePrefix + socketPath with every
// character outside [A-Za-z0-9._-] mapped to '-'. Every generated client and
// daemon derives it the same way.
func C2DPipeName(socketPath string) string {
	var b strings.Builder
	b.WriteString(C2DPipePrefix)
	for _, r := range socketPath {
		if (r >= 'A' && r <= 'Z') || (r >= 'a' && r <= 'z') || (r >= '0' && r <= '9') || r == '.' || r == '_' || r == '-' {
			b.WriteRune(r)
		} else {
			b.WriteByte('-')
		}
	}
	return b.String()
}

// C2DEndpoint returns the endpoint DialC2D dials for socketPath on this OS:
// socketPath on macOS and Linux, C2DPipeName(socketPath) on Windows.
func C2DEndpoint(socketPath string) string {
	return c2dEndpoint(socketPath)
}

// DialC2D connects to the c2d daemon serving socketPath: its Unix socket on
// macOS and Linux, its named pipe on Windows.
func DialC2D(ctx context.Context, socketPath string) (net.Conn, error) {
	return dialC2D(ctx, socketPath)
}
