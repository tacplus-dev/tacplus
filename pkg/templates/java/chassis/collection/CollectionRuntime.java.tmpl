    // is identical across every language backend -- base64url(no pad) of
    // {"v":1,"k":[...strings...]}, raw compact UTF-8 -- so a token minted by one
    // client decodes on any other. Kept in lockstep with the Go/TS/Python/Rust
    // runtimes.

    private static final int PAGE_TOKEN_VERSION = 1;

