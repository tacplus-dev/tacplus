// unescapeLineSeparators rewrites the 6-byte JSON escape sequences for
// U+2028 (LINE SEPARATOR) and U+2029 (PARAGRAPH SEPARATOR) to the raw UTF-8
// characters. It walks escape sequences so a literal backslash in a key
// (JSON-encoded as two backslashes) is never misread as the start of a
// U+202x escape: a backslash-escaped backslash followed by the text u2028
// means literal text and must be left untouched.
var (
	escapedLineSep = []byte("\\u2028")
	escapedParaSep = []byte("\\u2029")
	rawLineSep     = []byte(string(rune(0x2028)))
	rawParaSep     = []byte(string(rune(0x2029)))
)

func unescapeLineSeparators(raw []byte) []byte {
	if !bytes.Contains(raw, escapedLineSep) && !bytes.Contains(raw, escapedParaSep) {
		return raw
	}
	out := make([]byte, 0, len(raw))
	for i := 0; i < len(raw); {
		if raw[i] == '\\' && i+1 < len(raw) {
			if raw[i+1] == '\\' {
				// Escaped backslash -- copy both so the next byte is not
				// mistaken for an escape introducer.
				out = append(out, raw[i], raw[i+1])
				i += 2
				continue
			}
			if i+6 <= len(raw) {
				if bytes.Equal(raw[i:i+6], escapedLineSep) {
					out = append(out, rawLineSep...)
					i += 6
					continue
				}
				if bytes.Equal(raw[i:i+6], escapedParaSep) {
					out = append(out, rawParaSep...)
					i += 6
					continue
				}
			}
		}
		out = append(out, raw[i])
		i++
	}
	return out
}

// DecodePageToken parses a page_token back into a cursor. The empty string
// decodes to a nil cursor (first page). Any other malformed or wrong-version
// input returns ErrBadPageToken.
func DecodePageToken(token string) (*Cursor, error) {
	if token == "" {
		return nil, nil
	}
	raw, err := base64.RawURLEncoding.DecodeString(token)
	if err != nil {
		return nil, ErrBadPageToken
	}
	var env pageTokenEnvelope
	if err := json.Unmarshal(raw, &env); err != nil {
		return nil, ErrBadPageToken
	}
	if env.V != pageTokenVersion {
		return nil, ErrBadPageToken
	}
	return &Cursor{Keys: env.K}, nil
}

// EffectivePageSize resolves the requested page_size against the method's
// generated default and the trust-tier maximum: a non-positive request takes the
// default; the result is clamped to [1, max]. This is the runtime row bound that
// SNAPSHOT lacks — every page is capped at the caller's trust ceiling regardless
// of what page_size it asks for.
func EffectivePageSize(requested, defaultSize, max int) int {
	n := requested
	if n <= 0 {
		n = defaultSize
	}
	if n <= 0 {
		n = 1
	}
	if max > 0 && n > max {
		n = max
	}
	return n
}
