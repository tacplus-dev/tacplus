                    Accounting.TokenExchanged te = event.getTokenExchanged();
                    logger.info("accounting event=token_exchanged source_id={} request_id={} audience={} grant_type={} token_type={}",
                            sourceId, requestId, te.getAudience(), te.getGrantType(), te.getTokenType());
                    break;
                case ENDPOINT_HEALTH_CHANGED:
                    Accounting.EndpointHealthChanged ehc = event.getEndpointHealthChanged();
                    logger.warn("accounting event=endpoint_health_changed source_id={} endpoint={} healthy={} latency_ms={}",
                            sourceId, ehc.getEndpoint(), ehc.getHealthy(), ehc.getLatencyMs());
                    break;
                case STATE_UPDATED:
                    Accounting.StateUpdated su = event.getStateUpdated();
                    logger.info("accounting event=state_updated source_id={} request_id={} entity_type={} entity_id={} action={}",
                            sourceId, requestId, su.getEntityType(), su.getEntityId(), su.getAction());
                    break;
                default:
                    logger.info("accounting source_id={} request_id={} (unknown event type)", sourceId, requestId);
                    break;
            }
