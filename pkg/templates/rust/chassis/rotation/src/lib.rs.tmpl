        assert_eq!(plain_path("/pkg.Svc/Watch"), None);
        assert_eq!(rotating_path("/nomethod"), None);
    }

    #[test]
    fn the_message_rule() {
        // None of last, fin, session_id: exactly one message, even an empty one.
        assert!(is_message(&Envelope::default()));
        assert!(!is_message(&Envelope { last: true, ..Default::default() }));
        assert!(!is_message(&Envelope { fin: true, ..Default::default() }));
        assert!(!is_message(&Envelope { session_id: "s".into(), ..Default::default() }));
        assert!(malformed(&Envelope { last: true, payload: vec![1], ..Default::default() }));
        assert!(malformed(&Envelope { cursor: vec![1], ..Default::default() }));
        assert!(!malformed(&Envelope { payload: vec![1], ..Default::default() }));
    }

    #[test]
    fn refusals_carry_no_description() {
        assert_eq!(wire_status(Status::permission_denied("why")).message(), "");
        assert_eq!(wire_status(Status::unauthenticated("why")).message(), "");
        assert_eq!(wire_status(Status::internal("why")).message(), "why");
    }

    #[test]
    fn session_ids_are_random() {
        let a = new_session_id();
        assert_eq!(a.len(), 22);
        assert_ne!(a, new_session_id());
    }
