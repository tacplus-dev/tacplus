                self.fault("malformed chunk", Code::Cancelled);
                break;
            }
            if !chunk.payload.is_empty() {
                let written = tokio::select! {
                    _ = self.cancel.cancelled() => break,
                    w = local.write_all(&chunk.payload) => w,
                };
                if let Err(e) = written {
                    self.fault(&format!("local connection: {}", e), Code::Cancelled);
                    break;
                }
            }
            if chunk.fin && !fin_received {
                self.fin_received.store(true, Ordering::SeqCst);
                let _ = local.shutdown().await;
                self.finished().await;
            }
            if chunk.last {
                let next = self.pending.lock().unwrap().next.take();
                let Some(next) = next else {
                    self.fault("last with no stream to cut over to", Code::Cancelled);
                    break;
                };
                let old = std::mem::replace(&mut leg, next.rx);
                tokio::spawn(drain(old));
