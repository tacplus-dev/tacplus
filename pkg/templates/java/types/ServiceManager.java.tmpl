{{- range .GrpcServices}}
        {{.ServerClassName}} {{.WrapperVarName}} = new {{.ServerClassName}}({{if .IsGeneratedRecordC2S}}new {{.GeneratedImplClass}}(this){{else}}handler.{{.GetterName}}(){{end}}{{if not (or .AuthDisabled .IsC2D)}}, authorizer{{end}});
