// Code generated by tacplus. DO NOT EDIT.

package advisor

// The LLM rule, as a gate (tacplus#909; tacplus-dev/roadmap
// decisions/skipper-and-admiral-2026-11-01.md, 2026-11-19): an LLM may propose;
// it never holds a token or a write path. The advisor of {{.ServiceLabel}} is its
// own packages, at {{.AdvisorPath}}, and this test fails when they could reach
// anything of the service but this model port: the generated clients, state
// clients and ServiceManager, the chassis (the token, the key), the types
// packages' raw transport stubs, the service's own code (the core), or any
// other package of its module.
//
// It reads what `go list` resolves, not the source text: a package is refused
// for what it is, however it is imported. The advisor's packages (their tests
// too) may import, of the service's module and the generated tree, only this
// package and their own; and nothing they depend on there may be anything this
// package does not itself depend on.

import (
	"bytes"
	"encoding/json"
	"os"
	"os/exec"
	"path/filepath"
	"runtime"
	"sort"
	"strings"
	"testing"
)

// advisorDir is the advisor's directory, from this package's.
const advisorDir = "{{.AdvisorRel}}"

type listedPackage struct {
	ImportPath   string
	Dir          string
	DepOnly      bool
	Module       *struct{ Path string }
	Imports      []string
	TestImports  []string
	XTestImports []string
	Error        *struct{ Err string }
}

func goTool() string {
	if p, err := exec.LookPath("go"); err == nil {
		return p
	}
	return filepath.Join(runtime.GOROOT(), "bin", "go")
}

func goList(t *testing.T, dir string, args ...string) []listedPackage {
	t.Helper()
	cmd := exec.Command(goTool(), append([]string{"list", "-e", "-json"}, args...)...)
	cmd.Dir = dir
	var stderr bytes.Buffer
	cmd.Stderr = &stderr
	out, err := cmd.Output()
	if err != nil {
		t.Fatalf("tacplus LLM rule: go list %s in %s: %v\n%s", strings.Join(args, " "), dir, err, stderr.String())
	}
	var pkgs []listedPackage
	dec := json.NewDecoder(bytes.NewReader(out))
	for dec.More() {
		var p listedPackage
		if err := dec.Decode(&p); err != nil {
			t.Fatalf("tacplus LLM rule: go list output: %v", err)
		}
		pkgs = append(pkgs, p)
	}
	return pkgs
}

// within reports whether path is dir or below it.
func within(dir, path string) bool {
	rel, err := filepath.Rel(dir, path)
	return err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator))
}

// basePath drops the [p.test] suffix go list gives a package compiled for a test.
func basePath(importPath string) string {
	return strings.SplitN(importPath, " ", 2)[0]
}

func TestLLMRule(t *testing.T) {
	advisor, err := filepath.Abs(advisorDir)
	if err != nil {
		t.Fatal(err)
	}
	if st, err := os.Stat(advisor); err != nil || !st.IsDir() {
		t.Fatalf("tacplus LLM rule: the advisor tacplus.yaml declares, %s, is not a directory: %v", advisor, err)
	}
	here, err := filepath.Abs(".")
	if err != nil {
		t.Fatal(err)
	}
	generated := filepath.Dir(here)

	allowed := map[string]bool{}
	port := ""
	for _, p := range goList(t, ".", "-deps", ".") {
		allowed[p.ImportPath] = true
		if !p.DepOnly {
			port = p.ImportPath
		}
	}

	pkgs := goList(t, advisor, "-deps", "-test", "./...")
	byPath := map[string]listedPackage{}
	module := ""
	var own []listedPackage
	for _, p := range pkgs {
		byPath[p.ImportPath] = p
		if !p.DepOnly && within(advisor, p.Dir) {
			own = append(own, p)
			if p.Module != nil {
				module = p.Module.Path
			}
		}
	}
	if len(own) == 0 {
		t.Fatalf("tacplus LLM rule: no Go package at the advisor %s", advisor)
	}
	// Of the service: the advisor's module (the core, the rest of the
	// repository) and the generated tree, wherever it sits.
	ofService := func(p listedPackage) bool {
		if within(advisor, p.Dir) {
			return false
		}
		return within(generated, p.Dir) || (p.Module != nil && p.Module.Path == module)
	}

	found := map[string]bool{}
	for _, p := range pkgs {
		if p.Error != nil && within(advisor, p.Dir) {
			found["the advisor package "+basePath(p.ImportPath)+" does not load: "+p.Error.Err] = true
		}
	}
	for _, p := range own {
		for _, imp := range append(append(append([]string{}, p.Imports...), p.TestImports...), p.XTestImports...) {
			q, ok := byPath[imp]
			if !ok || basePath(imp) == port || !ofService(q) {
				continue
			}
			found[basePath(p.ImportPath)+" imports "+basePath(imp)+", and the model port is the only package of the service the advisor may import"] = true
		}
	}
	for _, q := range pkgs {
		if !ofService(q) || allowed[basePath(q.ImportPath)] || strings.HasSuffix(basePath(q.ImportPath), ".test") {
			continue
		}
		found["the advisor depends on "+basePath(q.ImportPath)+", which the model port does not"] = true
	}
	if len(found) == 0 {
		return
	}
	var violations []string
	for v := range found {
		violations = append(violations, v)
	}
	sort.Strings(violations)
	t.Fatalf("tacplus LLM rule: the advisor %s may depend on no part of the service but its model port %s:\n  - %s\nAn LLM may propose; it never holds a token or a write path (tacplus#909). Give the advisor what it needs through the model port and the interfaces the core implements and passes in.",
		advisor, port, strings.Join(violations, "\n  - "))
}
