/// Upper bound on the delay between reconnect retries.
pub const RECONNECT_MAX_BACKOFF: Duration = Duration::from_secs(30);

/// Returns the delay to use after `current`: doubled, capped at
/// `RECONNECT_MAX_BACKOFF`.
pub fn next_reconnect_backoff(current: Duration) -> Duration {
