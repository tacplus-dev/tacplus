{{if .HasServiceHealthState}}
// Publish INSTANCE_STATUS_HEALTHY only after the server goroutine is started,
// so the advertised gRPC endpoint is accepting connections when peers see it.
healthStub := sm.bc.{{.HealthStateGroupAccessor}}().ServiceHealth().StateStub()
metrics := buildMetricsProvider(sm.cfg.GetListenAddress())
// Health identity is this instance's identity as the fleet minted it: the
// subject of its own service token (spiffe://<td>/<namespace…>/services/<svc>),
// the only identity that names the tenant of a tenant-owned instance. An id
// assembled from config can only ever say /system/…, and nothing the fleet did
// not mint belongs in the health plane. A missing or malformed subject fails
// here rather than publishing an empty identity (NEW-21).
ownToken, tokErr := sm.GetToken()
if tokErr != nil {
return fmt.Errorf("own service token: %w", tokErr)
}
ownIdentity, parseErr := wrapperToken.ParseToken(ownToken)
if parseErr != nil {
return fmt.Errorf("own service token: %w", parseErr)
}
spiffeId := ownIdentity.GetSubject()
if _, idErr := wrapperSpiffe.ParseSpiffeID(spiffeId); idErr != nil {
return fmt.Errorf("own service token subject %q is not a service identity: %w", spiffeId, idErr)
}
hr := healthreporter.New(&healthPublisherAdapter{stub: healthStub}, metrics, zap.L(), spiffeId)
hr.SetStatus(healthreporter.StatusHealthy)
// PC-L-1: TLS renewal give-up / parse failures degrade this instance in the
// fleet health plane instead of being Error-log-only.
sm.onTLSDegraded(func(reason string) {
zap.L().Warn("marking instance DEGRADED: TLS renewal failure", zap.String("reason", reason))
hr.SetStatus(healthreporter.StatusDegraded)
})
if hc, ok := h.(healthreporter.HealthChecker); ok {
	hr.SetHealthChecker(hc)
}
{{- if .HasTypedHealth}}
if tc, ok := h.(TypedHealthCollector); ok {
	hr.SetTypedHealthCollector(&typedHealthAdapter{collector: tc})
}
{{- end}}
healthCtx, healthCancel := context.WithCancel(sm.tasks.Context())
defer healthCancel()
healthReady := make(chan error, 1)
sm.tasks.Go(func(_ context.Context) {
hr.StartWithReady(healthCtx, healthReady)
})
select {
case err := <-healthReady:
if err != nil {
return fmt.Errorf("first health publish: %w", err)
}
// Bootstrap complete (serving + first health publish): advertise SERVING on
// the gRPC health endpoint so k8s readiness probes pass — once the required
// s2s channels are up too (see driveReadiness).
// Credential health is a chassis FLOOR, not a service concern: a service must
// not be able to report itself healthy while its credentials are being rejected
// and re-minting is not helping. Readiness previously stayed Ready through a
// total auth outage because the probe only asked whether the process listened.
hr.SetDegradedProbe(service_im.CredentialsDegraded)

// Ongoing health evaluation feeds readiness: a handler reporting UNHEALTHY
// flips the endpoint to NOT_SERVING so k8s removes the pod from load-balancer
// rotation. Recovery flips it back to SERVING.
healthOK := new(atomic.Bool)
healthOK.Store(true)
hr.SetStatusSink(func(status healthreporter.InstanceStatus) {
	healthOK.Store(status != healthreporter.StatusUnhealthy)
})
if healthCtl != nil {
sm.tasks.Go(func(taskCtx context.Context) {
sm.driveReadiness(taskCtx, healthCtl, healthOK, {{if .HasSubscriptions}}readinessStreams{{else}}nil{{end}})
})
}
case err := <-errCh:
return err
case <-sm.ctx.Done():
return sm.ctx.Err()
}
{{else}}
// No ServiceHealthState reporter: the service is ready once it is listening
// with its bootstrap (config, TLS cert{{if .HasSmb}}, SMB member cert{{end}})
// complete. Advertise SERVING on the gRPC health endpoint.
if healthCtl != nil {
healthCtl.SetReady(true)
}
{{end}}

{{if .HasSubscriptions}}
// Start event-bus subscriptions in owned background goroutines. Resolution
// happens INSIDE the reconnect loop so a rescheduled instance is re-resolved
// via ServiceHealthState instead of retrying a dead connection forever, and
// startup never blocks on event-bus availability (the server is already
// listening and HEALTHY at this point).
subCtx, subCancel := context.WithCancel(sm.tasks.Context())
defer subCancel()
var subWg sync.WaitGroup
{{range .Subscriptions}}
{
subWg.Add(1)
sm.tasks.Go(func(_ context.Context) {
defer subWg.Done()
backoff := serviceconnection.ReconnectInitialBackoff
for subCtx.Err() == nil {
// Re-resolve a healthy {{.TargetService}} instance on every attempt.
subConn, err := sm.resolveServiceCtx(subCtx, "{{.TargetService}}")
if err != nil {
if subCtx.Err() != nil {
return
}
zap.L().Warn("failed to resolve {{.TargetService}} service for subscription, retrying",
zap.Error(err), zap.Duration("retry_in", backoff))
} else {
backoff = serviceconnection.ReconnectInitialBackoff
up_{{.HandlerFuncFieldName}}.Store(true)
sub := {{.SubPkgAlias}}.New(subConn, "{{$.ServiceLabel}}")
{{- if .RoutingOnly}}
// Routing-only subscriber: the generated Handler takes
// {{.TypePkgAlias}}.{{.EnvelopeTypeName}}, so neither the trace-publish leg
// (no trace id on an envelope) nor the projection pipeline (no body to
// project) has anything to read. Both are omitted rather than stubbed.
if err := sub.Subscribe(subCtx, func(ctx context.Context, event *{{.TypePkgAlias}}.{{.EnvelopeTypeName}}, meta *eb_pb.RecordMeta) error {
if sm.{{.HandlerFuncFieldName}} != nil {
return sm.{{.HandlerFuncFieldName}}(ctx, event, meta)
}
return nil
}, {{.SubPkgAlias}}.WithEarliest()); err != nil && subCtx.Err() == nil {
zap.L().Error("subscription {{.SourcePackage}}.{{.SourceField}} ended, re-resolving {{.TargetService}}", zap.Error(err))
}
{{- else}}
if err := sub.Subscribe(subCtx, func(ctx context.Context, event *{{.TypePkgAlias}}.{{.TypeName}}, meta *eb_pb.RecordMeta) error {
if event.GetTraceId() != "" && !event.GetNoop() {
tracePublish(ctx, &trace_pb.TraceEvent{
TraceId: event.GetTraceId(),
Kind:    trace_pb.TraceEventKind_TRACE_EVENT_KIND_INTERNAL_REQUEST,
Round: &trace_pb.TraceRound{
Service:     "{{$.ServiceLabel}}",
InstanceId:  sm.sc.InstanceID(),
TimestampMs: time.Now().UnixMilli(),
},
})
}
if sm.{{.HandlerFuncFieldName}} != nil {
if err := sm.{{.HandlerFuncFieldName}}(ctx, event, meta); err != nil {
return err
}
}
{{- if .HasProjections}}
return {{.TypePkgAlias}}.Handle{{.TypeName}}(ctx, event{{range .Inserts}}, sm.{{.FieldName}}{{end}})
{{- else}}
// No message projects from {{.TypeName}}, so no Handle{{.TypeName}} dispatcher
// is generated for it. The subscriber's only work is the handler func above.
return nil
{{- end}}
}, {{.SubPkgAlias}}.WithEarliest()); err != nil && subCtx.Err() == nil {
zap.L().Error("subscription {{.SourcePackage}}.{{.SourceField}} ended, re-resolving {{.TargetService}}", zap.Error(err))
}
{{- end}}
up_{{.HandlerFuncFieldName}}.Store(false)
// Close the per-attempt channel before re-resolving a fresh one.
if closer, ok := subConn.(interface{ Close() error }); ok {
closer.Close()
}
if subCtx.Err() != nil {
return
}
}
select {
case <-time.After(serviceconnection.JitterReconnectBackoff(backoff)):
case <-subCtx.Done():
return
}
backoff = serviceconnection.NextReconnectBackoff(backoff)
}
})
}
{{end}}
{{end}}

select {
case err := <-errCh:
return err
case <-sm.ctx.Done():
}
zap.L().Info("Shutdown signal received, starting graceful shutdown")
sm.stop()

shutdownTimeout := sm.shutdownTimeout()
shutdownCtx, shutdownCancel := context.WithTimeout(context.Background(), shutdownTimeout)
defer shutdownCancel()

{{if .HasSubscriptions}}
subCancel()
subDone := make(chan struct{})
go func() {
subWg.Wait()
close(subDone)
}()
select {
case <-subDone:
case <-shutdownCtx.Done():
zap.L().Warn("Subscription shutdown timeout expired; continuing graceful shutdown")
}
{{end}}
done := make(chan struct{})
go func() {
h.Shutdown(shutdownCtx)
close(done)
}()

sigCh := make(chan os.Signal, 1)
signal.Notify(sigCh, syscall.SIGTERM, syscall.SIGINT)
select {
case <-done:
zap.L().Info("Graceful shutdown complete")
case <-shutdownCtx.Done():
zap.L().Warn("Shutdown timeout expired, exiting immediately")
case <-sigCh:
zap.L().Info("Second signal received, exiting immediately")
}
return nil
}

func (sm *ServiceManager) shutdownTimeout() time.Duration {
shutdownTimeout := time.Duration(sm.cfg.ShutdownTimeoutSeconds) * time.Second
if shutdownTimeout <= 0 {
shutdownTimeout = 30 * time.Second
}
return shutdownTimeout
}
