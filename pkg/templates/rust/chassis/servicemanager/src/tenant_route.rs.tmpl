/// The namespace tenant `tid`'s entries live in on this instance, for the
/// record plane's route pin: the route field names the tenant by tid, an entry
/// by namespace, which names it by name. [`check_routed_tenant`] has admitted
/// `tid` before the record plane asks, so on a tenant-owned instance it is the
/// instance's own tid, and its entries live in the instance's own namespace
/// claim. A shared instance knows no tenant's name, so it holds `tid`'s
/// entries to `/tenants/<tid>`. An instance that serves another tenant, or
/// none it can name, has none: PERMISSION_DENIED.
pub fn route_namespace(tid: &str, host: &HostIdentity) -> Result<String, tonic::Status> {
    if host.is_shared() {
        return Ok(format!("/{}/{}", ::spiffe::TENANTS_SEGMENT, tid));
    }
    if host.tid.is_empty() || tid != host.tid || host.namespace.is_empty() {
        return Err(tonic::Status::permission_denied(format!(
            "this instance does not serve tenant {}",
            shown(tid)
        )));
    }
    Ok(host.namespace.clone())
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn tenant_id_is_exactly_eight_lowercase_alphanumerics() {
        for ok in ["aaaaaaaa", "00000001", "a1b2c3d4", "zzzzzzzz"] {
            assert!(valid_tenant_id(ok), "{ok:?} is a tid");
        }
        for bad in ["", "aaaaaaa", "aaaaaaaaa", "AAAAAAAA", "aaaa-aaa", " aaaaaaa", "aaaaaaa ", "aaaaaaa\n", "äaaaaaa", "aaaa/aaa"] {
            assert!(!valid_tenant_id(bad), "{bad:?} is not a tid");
        }
    }

    #[test]
    fn route_tenant_refuses_empty_and_malformed_naming_the_field() {
        assert_eq!(route_tenant("tenant", "aaaaaaaa").unwrap(), "aaaaaaaa");
        for bad in ["", "ACME0001", "short", "aaaaaaaaa"] {
            let err = route_tenant("tenant", bad).unwrap_err();
            assert_eq!(err.code(), tonic::Code::InvalidArgument, "{bad:?}");
            assert!(err.message().contains("\"tenant\""), "message must name the field: {}", err.message());
        }
    }

    fn field_len(number: u32, bytes: &[u8]) -> Vec<u8> {
        let mut out = Vec::new();
        put_varint(&mut out, u64::from(number << 3 | 2));
        put_varint(&mut out, bytes.len() as u64);
        out.extend_from_slice(bytes);
        out
    }

    fn put_varint(out: &mut Vec<u8>, mut v: u64) {
        loop {
            let b = (v & 0x7f) as u8;
            v >>= 7;
            if v == 0 {
                out.push(b);
                return;
            }
            out.push(b | 0x80);
        }
    }

    #[test]
    fn wire_reads_the_route_field_and_last_one_wins() {
        let mut frame = Vec::new();
        frame.extend(field_len(1, b"other"));
        // varint, fixed64, fixed32 and a group around a same-numbered LEN field
        // that is NOT top-level must all be walked over.
        put_varint(&mut frame, 2 << 3);
        put_varint(&mut frame, 300);
        put_varint(&mut frame, 3 << 3 | 1);
        frame.extend_from_slice(&[0; 8]);
        put_varint(&mut frame, 4 << 3 | 5);
        frame.extend_from_slice(&[0; 4]);
        frame.extend(field_len(7, b"aaaaaaaa"));
        put_varint(&mut frame, 9 << 3 | 3);
        frame.extend(field_len(7, b"cccccccc"));
        put_varint(&mut frame, 9 << 3 | 4);
        assert_eq!(route_tenant_from_wire(&frame, 7, "tenant").unwrap(), "aaaaaaaa");
        frame.extend(field_len(7, b"bbbbbbbb"));
        assert_eq!(route_tenant_from_wire(&frame, 7, "tenant").unwrap(), "bbbbbbbb");
    }

    #[test]
    fn wire_platform_route_has_no_tenant() {
        assert_eq!(route_tenant_from_wire(b"\xff", 0, "").unwrap(), "");
    }

    #[test]
    fn wire_refuses_missing_empty_malformed_and_non_utf8() {
        let cases: Vec<(&str, Vec<u8>)> = vec![
            ("missing", field_len(1, b"aaaaaaaa")),
            ("empty frame", Vec::new()),
            ("empty value", field_len(7, b"")),
            ("not a tid", field_len(7, b"AAAAAAAA")),
            ("not utf-8", field_len(7, b"\xff\xfeaaaaaa")),
            ("truncated length", vec![7 << 3 | 2, 9, b'a']),
            ("truncated varint", vec![1 << 3, 0x80]),
            ("overlong varint", {
                let mut v = vec![1 << 3];
                v.extend_from_slice(&[0xff; 10]);
                v.push(0x01);
                v
            }),
            ("truncated fixed64", vec![1 << 3 | 1, 0, 0]),
            ("truncated fixed32", vec![1 << 3 | 5, 0]),
            ("field number 0", vec![0 << 3 | 2, 0]),
            ("wire type 6", vec![1 << 3 | 6]),
            ("unmatched end group", vec![1 << 3 | 4]),
            ("unterminated group", {
                let mut v = vec![1 << 3 | 3];
                v.extend(field_len(7, b"aaaaaaaa"));
                v
            }),
        ];
        for (name, frame) in cases {
            let err = route_tenant_from_wire(&frame, 7, "tenant").expect_err(name);
            assert_eq!(err.code(), tonic::Code::InvalidArgument, "{name}");
        }
    }

    #[test]
    fn namespace_and_spiffe_tenant() {
        assert_eq!(tenant_of_namespace("/tenants/aaaaaaaa").as_deref(), Some("aaaaaaaa"));
        for ns in ["/system", "/tenants", "/tenants/", "/tenants/aaaaaaaa/workspaces/w", "/tenants/acme", "/users/aaaaaaaa"] {
            assert_eq!(tenant_of_namespace(ns), None, "{ns:?}");
        }
        assert_eq!(
            tenant_of_spiffe_id("spiffe://example.com/tenants/bbbbbbbb/services/crew").as_deref(),
            Some("bbbbbbbb")
        );
        for id in [
            "spiffe://example.com/system/services/crew",
            "spiffe://example.com/tenants/acme/services/crew",
            "not a spiffe id",
            "",
        ] {
            assert_eq!(tenant_of_spiffe_id(id), None, "{id:?}");
        }
    }

    // A caller's tenant is its tid claim, only when that is a tid; a namespace
    // (even a tid-shaped one) passed where the claim belongs is no tenant.
