        let sig = Signature::from_slice(&sig_bytes)
            .map_err(|e| SamlError::VerificationError(e.to_string()))?;
        verifying_key.verify(&signed_info_c14n, &sig)
            .map_err(|e| SamlError::VerificationError(e.to_string()))?;

        if !self.status_code.is_empty() && self.status_code != STATUS_SUCCESS {
            return Err(SamlError::VerificationError(
                format!("response status {} is not Success", self.status_code),
            ));
        }

        if !self.is_time_valid() {
            return Err(SamlError::VerificationError(
                "assertion time window is not valid".to_string(),
