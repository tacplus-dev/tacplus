/// Accepts either a bare namespace path or a full SPIFFE URI and returns the
/// normalized namespace path.
pub fn parse_namespace_or_spiffe(value: &str) -> Result<String> {
    let v = value.trim();
    if v.starts_with(&format!("{}://", SCHEME)) {
        let p = parse_spiffe_id(v)?;
        return normalize_namespace(&p.namespace);
    }
    normalize_namespace(v)
}

/// Returns the LOCATION-AGNOSTIC service identity: the bare service label plus
/// any `/workloads/<child>` suffix, with `/system/<location...>/` stripped.
pub fn service_path_from_spiffe(spiffe_id: &str) -> Result<String> {
    let p = parse_spiffe_id(spiffe_id)?;
    if p.subject_kind != SubjectKind::Service && p.subject_kind != SubjectKind::Workload {
        return err(format!("spiffe: not a service/workload identity: {:?}", spiffe_id));
    }
    Ok(p.subject_path)
}

/// Returns the normalized namespace of a SPIFFE ID.
pub fn namespace_from_spiffe(spiffe_id: &str) -> Result<String> {
    let p = parse_spiffe_id(spiffe_id)?;
    normalize_namespace(&p.namespace)
}

/// The (kind, id) of a resource SPIFFE ID.
#[derive(Debug, Clone, Default, PartialEq, Eq)]
pub struct ResourceParts {
    pub namespace: String,
    pub kind: String,
    pub id: String,
}

/// Extracts the resource parts from a resource SPIFFE ID.
pub fn resource_parts_from_spiffe(spiffe_id: &str) -> Result<ResourceParts> {
    let p = parse_spiffe_id(spiffe_id)?;
    if p.subject_kind != SubjectKind::Resource {
        return err(format!("spiffe: not a resource identity: {:?}", spiffe_id));
    }
    Ok(ResourceParts {
        namespace: p.namespace,
        kind: p.resource_kind,
        id: p.resource_id,
    })
}

// ---- Comparison. ----

/// Reports whether `target` is the same as `caller` or a strict path-segment
/// descendant in the NAMESPACE (authorization) tree.
pub fn is_at_or_below(caller_namespace: &str, target_namespace: &str) -> bool {
    let caller = trim_namespace(caller_namespace);
    let target = trim_namespace(target_namespace);
    if caller.is_empty() || target.is_empty() {
        return false;
    }
    if caller == target {
        return true;
    }
    if caller == "/" {
        return target.starts_with('/');
    }
    target.starts_with(&format!("{}/", caller))
}

/// Reports whether the `target` SPIFFE ID is the same as or a path-segment
/// descendant of the `caller` SPIFFE ID. This is the IDENTITY-path relation and
/// is distinct from `is_at_or_below`; the two must not be cross-applied.
pub fn is_spiffe_at_or_below(caller_spiffe_id: &str, target_spiffe_id: &str) -> bool {
    let c = match parse_spiffe_id(caller_spiffe_id) {
        Ok(c) => c,
        Err(_) => return false,
    };
    let t = match parse_spiffe_id(target_spiffe_id) {
        Ok(t) => t,
        Err(_) => return false,
    };
    if c.trust_domain != t.trust_domain {
        return false;
    }
    if c.path_segments.len() > t.path_segments.len() {
        return false;
    }
    for i in 0..c.path_segments.len() {
        if c.path_segments[i] != t.path_segments[i] {
            return false;
        }
    }
    true
}

/// Reports whether two SPIFFE IDs share a trust domain.
pub fn same_trust_domain(a: &str, b: &str) -> bool {
    let pa = match parse_spiffe_id(a) {
        Ok(p) => p,
        Err(_) => return false,
    };
    let pb = match parse_spiffe_id(b) {
        Ok(p) => p,
        Err(_) => return false,
    };
    pa.trust_domain == pb.trust_domain
}

// ---- internal helpers ----

fn reject_dangerous(s: &str) -> Result<()> {
    let lower = s.to_lowercase();
    for enc in ["%2f", "%5c"] {
        if lower.contains(enc) {
            return err(format!("spiffe: encoded separator {:?} not allowed: {:?}", enc, s));
        }
    }
    for r in s.chars() {
        if (r as u32) < 0x20 || r == '\u{7f}' {
            return err(format!("spiffe: control character not allowed: {:?}", s));
        }
    }
    Ok(())
}

fn split_path(p: &str) -> Vec<&str> {
    let p = p.trim().trim_matches('/');
    if p.is_empty() {
        return Vec::new();
    }
    p.split('/').collect()
}

fn trim_namespace(ns: &str) -> String {
    let ns = ns.trim();
    if ns.is_empty() {
        return String::new();
    }
    let ns = if !ns.starts_with('/') {
        format!("/{}", ns)
    } else {
        ns.to_string()
    };
    let trimmed = ns.trim_end_matches('/');
    if trimmed.is_empty() {
        return "/".to_string();
    }
    trimmed.to_string()
}

// tag_indexes records the first index of each interesting tag (or -1 if absent),
// matching the Go reference's "first occurrence wins" semantics.
struct TagIndexes {
    workloads: i64,
    services: i64,
    users: i64,
    clients: i64,
    credentials: i64,
    data: i64,
}

fn tag_indexes(segs: &[&str]) -> TagIndexes {
    let mut out = TagIndexes {
        workloads: -1,
        services: -1,
        users: -1,
        clients: -1,
        credentials: -1,
        data: -1,
    };
    for (i, s) in segs.iter().enumerate() {
        let i = i as i64;
        match *s {
            WORKLOADS_SEGMENT if out.workloads == -1 => out.workloads = i,
            SERVICES_SEGMENT if out.services == -1 => out.services = i,
            USERS_SEGMENT if out.users == -1 => out.users = i,
            CLIENTS_SEGMENT if out.clients == -1 => out.clients = i,
            CREDENTIALS_SEGMENT if out.credentials == -1 => out.credentials = i,
            DATA_SEGMENT if out.data == -1 => out.data = i,
            _ => {}
        }
    }
    out
}

fn idx_of(idx: &TagIndexes, tag: &str) -> i64 {
    match tag {
        WORKLOADS_SEGMENT => idx.workloads,
        SERVICES_SEGMENT => idx.services,
        USERS_SEGMENT => idx.users,
        CLIENTS_SEGMENT => idx.clients,
        CREDENTIALS_SEGMENT => idx.credentials,
        DATA_SEGMENT => idx.data,
        _ => -1,
    }
}

fn index_of(segs: &[&str], tag: &str) -> i64 {
    for (i, s) in segs.iter().enumerate() {
        if *s == tag {
            return i as i64;
        }
    }
    -1
}

#[cfg(test)]
mod tests {
    use super::*;
    use serde_json::Value;
    use std::{env, fs};

    fn load_shared_vectors() -> Value {
        let mut candidates = Vec::new();
        if let Ok(path) = env::var("SPIFFE_VECTOR_FIXTURE") {
            if !path.is_empty() {
                candidates.push(std::path::PathBuf::from(path));
            }
        }
        if let Ok(cwd) = env::current_dir() {
            for dir in cwd.ancestors() {
                candidates.push(dir.join("cross-test/fixtures/spiffe_vectors.json"));
            }
        }
        for path in candidates {
            if let Ok(data) = fs::read_to_string(&path) {
                return serde_json::from_str(&data)
                    .unwrap_or_else(|e| panic!("parse shared SPIFFE vector fixture {:?}: {}", path, e));
            }
        }
        panic!("shared SPIFFE vector fixture not found; set SPIFFE_VECTOR_FIXTURE");
    }

    fn field<'a>(v: &'a Value, name: &str) -> &'a str {
        v.get(name)
            .and_then(Value::as_str)
            .unwrap_or_else(|| panic!("missing string field {}", name))
    }

    fn call_shared_construct(fn_name: &str, args: &[Value]) -> Result<String> {
        let arg = |idx: usize| -> &str {
            args.get(idx)
                .and_then(Value::as_str)
                .unwrap_or_else(|| panic!("missing arg {} for {}", idx, fn_name))
        };
        match fn_name {
            "normalize_trust_domain" => normalize_trust_domain(arg(0)),
            "resource_spiffe_id" => resource_spiffe_id(arg(0), arg(1), arg(2), arg(3)),
            "credential_spiffe_id" => credential_spiffe_id(arg(0), arg(1), arg(2), arg(3)),
            "user_spiffe_id" => user_spiffe_id(arg(0), arg(1), arg(2)),
            "user_root_spiffe_id" => user_root_spiffe_id(arg(0), arg(1)),
            "namespace_spiffe_id" => namespace_spiffe_id(arg(0), arg(1)),
            "tenant_spiffe_id" => tenant_spiffe_id(arg(0), arg(1)),
            other => Err(SpiffeError(format!("unsupported shared construct: {}", other))),
        }
    }

    #[test]
    fn shared_fixture_vectors() {
        let root = load_shared_vectors();
        assert_eq!(field(&root, "scheme_version"), SCHEME_VERSION);

        let construction = root.get("construction").expect("construction vectors");
        let service = &construction["service"];
        assert_eq!(
            service_spiffe_id(field(service, "trust_domain"), field(service, "location"), field(service, "service")).unwrap(),
            field(service, "expect")
        );
        let workload = &construction["workload"];
        assert_eq!(
            workload_spiffe_id(field(workload, "parent"), field(workload, "child")).unwrap(),
            field(workload, "expect")
        );
        let tenant = &construction["tenant"];
        assert_eq!(
            tenant_spiffe_id(field(tenant, "trust_domain"), field(tenant, "tenant")).unwrap(),
            field(tenant, "expect")
        );
        let workspace = &construction["workspace"];
        let workspace_path: Vec<&str> = workspace["workspace"]
            .as_array()
            .expect("workspace path")
            .iter()
            .map(|v| v.as_str().expect("workspace segment"))
            .collect();
        assert_eq!(
            workspace_spiffe_id(field(workspace, "trust_domain"), field(workspace, "tenant"), &workspace_path).unwrap(),
            field(workspace, "expect")
        );
        let namespace = &construction["namespace"];
        assert_eq!(
            namespace_spiffe_id(field(namespace, "trust_domain"), field(namespace, "namespace")).unwrap(),
            field(namespace, "expect")
        );
        let user = &construction["user"];
        assert_eq!(
            user_spiffe_id(field(user, "trust_domain"), field(user, "namespace"), field(user, "stable_user")).unwrap(),
            field(user, "expect")
        );
        let resource = &construction["resource"];
        assert_eq!(
            resource_spiffe_id(field(resource, "trust_domain"), field(resource, "namespace"), field(resource, "kind"), field(resource, "id")).unwrap(),
            field(resource, "expect")
        );

        for entry in root["parse"].as_array().expect("parse vectors") {
            let p = parse_spiffe_id(field(entry, "input")).unwrap();
            assert_eq!(p.subject_kind.as_str(), field(entry, "subject_kind"));
            if let Some(expect) = entry.get("trust_domain").and_then(Value::as_str) {
                assert_eq!(p.trust_domain, expect);
            }
            if let Some(expect) = entry.get("location_path").and_then(Value::as_str) {
                assert_eq!(p.location_path, expect);
            }
            if let Some(expect) = entry.get("namespace").and_then(Value::as_str) {
                assert_eq!(p.namespace, expect);
            }
            if let Some(expect) = entry.get("subject_path").and_then(Value::as_str) {
                assert_eq!(p.subject_path, expect);
            }
            if let Some(expect) = entry.get("resource_kind").and_then(Value::as_str) {
                assert_eq!(p.resource_kind, expect);
            }
            if let Some(expect) = entry.get("resource_id").and_then(Value::as_str) {
                assert_eq!(p.resource_id, expect);
            }
        }

        for entry in root["round_trip"].as_array().expect("round_trip vectors") {
            let input = entry.as_str().expect("round_trip value");
            let p = parse_spiffe_id(input).unwrap();
            assert_eq!(p.reconstruct(), input);
        }

        for entry in root["comparison"]["is_at_or_below"].as_array().expect("is_at_or_below vectors") {
            assert_eq!(
                is_at_or_below(field(entry, "caller"), field(entry, "target")),
                entry["expect"].as_bool().expect("expected bool")
            );
        }
        for entry in root["comparison"]["same_trust_domain"].as_array().expect("same_trust_domain vectors") {
            assert_eq!(
                same_trust_domain(field(entry, "a"), field(entry, "b")),
                entry["expect"].as_bool().expect("expected bool")
            );
        }
        for entry in root["comparison"]["service_path_location_agnostic"].as_array().expect("service path vectors") {
            assert_eq!(
                service_path_from_spiffe(field(entry, "input")).unwrap(),
                field(entry, "expect")
            );
        }

        for entry in root["normalization"]["trust_domain"].as_array().expect("trust_domain vectors") {
            assert_eq!(normalize_trust_domain(field(entry, "input")).unwrap(), field(entry, "expect"));
        }
        for entry in root["normalization"]["namespace"].as_array().expect("namespace vectors") {
            assert_eq!(normalize_namespace(field(entry, "input")).unwrap(), field(entry, "expect"));
        }
        for entry in root["invalid_parse"].as_array().expect("invalid_parse vectors") {
            let input = entry.as_str().expect("invalid_parse value");
            assert!(parse_spiffe_id(input).is_err(), "parse_spiffe_id({:?}) should fail", input);
        }
        for entry in root["invalid_construct"].as_array().expect("invalid_construct vectors") {
            let args = entry["args"].as_array().expect("args");
            let fn_name = field(entry, "fn");
            assert!(call_shared_construct(fn_name, args).is_err(), "{}{:?} should fail", fn_name, args);
        }
        for entry in root["valid_construct"].as_array().expect("valid_construct vectors") {
            let args = entry["args"].as_array().expect("args");
            assert_eq!(
                call_shared_construct(field(entry, "fn"), args).unwrap(),
                field(entry, "expect")
            );
        }
        assert_eq!(
            opaque_segment("user", "issuer/user").len(),
            root["opaque_segment"]["length"].as_u64().expect("opaque length") as usize
        );
        // SEC-4: exact cross-language digests (incl. the NFD-normalization and
        // kind-domain-separation vectors), not just the length.
        for entry in root["opaque_segment"]["vectors"].as_array().expect("opaque vectors") {
            assert_eq!(
                opaque_segment(field(entry, "kind"), field(entry, "value")),
                field(entry, "expect"),
                "opaque_segment vector {:?}",
                entry
            );
        }
    }

    #[test]
    fn opaque_segment_properties() {
        let s = opaque_segment("user", "issuer/user");
        assert!(
            normalize_segment(&s).is_ok(),
            "opaque segment must satisfy the segment grammar"
        );
        assert_ne!(
            opaque_segment("user", "x"),
            opaque_segment("client", "x"),
            "kind must domain-separate identical values"
        );
        assert_eq!(
            opaque_segment("user", "issuer/user"),
            opaque_segment("user", "issuer/user"),
            "opaque segment must be deterministic"
        );
    }
}
