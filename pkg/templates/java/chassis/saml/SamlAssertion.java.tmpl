               "<ds:CanonicalizationMethod Algorithm=\"http://www.w3.org/2001/10/xml-exc-c14n#\"/>" +
               "<ds:SignatureMethod Algorithm=\"http://www.w3.org/2001/04/xmldsig-more#ecdsa-sha256\"/>" +
               "<ds:Reference URI=\"#" + xmlEscapeAttr(assertionId) + "\">" +
               "<ds:Transforms>" +
               "<ds:Transform Algorithm=\"http://www.w3.org/2000/09/xmldsig#enveloped-signature\"/>" +
               "<ds:Transform Algorithm=\"http://www.w3.org/2001/10/xml-exc-c14n#\"/>" +
               "</ds:Transforms>" +
               "<ds:DigestMethod Algorithm=\"http://www.w3.org/2001/04/xmlenc#sha256\"/>" +
               "<ds:DigestValue>" + digestB64 + "</ds:DigestValue>" +
               "</ds:Reference>" +
               "</ds:SignedInfo>";
    }

    static String buildSignatureElement(String assertionId, String digestB64, String sigB64, String certDerB64) {
        return "<ds:Signature xmlns:ds=\"http://www.w3.org/2000/09/xmldsig#\">" +
               buildSignedInfoXml(assertionId, digestB64) +
               "<ds:SignatureValue>" + sigB64 + "</ds:SignatureValue>" +
               "<ds:KeyInfo>" +
               "<ds:X509Data><ds:X509Certificate>" + certDerB64 + "</ds:X509Certificate></ds:X509Data>" +
               "</ds:KeyInfo>" +
               "</ds:Signature>";
    }

    static String insertSignatureAfterIssuer(String assertionXml, String sigElem) throws SamlException {
        int pos = assertionXml.indexOf("</saml:Issuer>");
        if (pos < 0) throw new SamlException("</saml:Issuer> not found in assertion XML");
        int end = pos + "</saml:Issuer>".length();
        return assertionXml.substring(0, end) + sigElem + assertionXml.substring(end);
    }

    /** Extract components needed for verification. Returns [unsignedAssertion, digestB64, signedInfoXml, sigB64]. */
    private static String[] extractForVerification(String responseXml) throws SamlException {
        String assertion = extractSingleAssertion(responseXml);

        int sigStart = assertion.indexOf("<ds:Signature ");
        if (sigStart < 0) throw new SamlException("no <ds:Signature> in assertion");
        int sigEnd = assertion.indexOf("</ds:Signature>", sigStart);
        if (sigEnd < 0) throw new SamlException("no </ds:Signature>");
        sigEnd += "</ds:Signature>".length();
        String sigXml = assertion.substring(sigStart, sigEnd);
        String unsigned = assertion.substring(0, sigStart) + assertion.substring(sigEnd);

        String digestB64 = extractText(sigXml, "ds:DigestValue");
        if (digestB64 == null) throw new SamlException("no DigestValue");
        String sigValB64 = extractText(sigXml, "ds:SignatureValue");
        if (sigValB64 == null) throw new SamlException("no SignatureValue");

        String assertionId = extractAttr(assertion, "ID");
        if (assertionId == null) throw new SamlException("no ID on Assertion");
        String signedInfoXml = buildSignedInfoXml(assertionId, digestB64);

        return new String[]{ unsigned, digestB64, signedInfoXml, sigValB64.trim() };
    }

    private static String extractSingleAssertion(String xml) throws SamlException {
        int aStart = xml.indexOf("<saml:Assertion ");
        if (aStart < 0) throw new SamlException("no <saml:Assertion> in response");
        int aEnd = xml.indexOf("</saml:Assertion>", aStart);
        if (aEnd < 0) throw new SamlException("no </saml:Assertion>");
        aEnd += "</saml:Assertion>".length();
        if (xml.indexOf("<saml:Assertion ", aEnd) >= 0) {
            throw new SamlException("SAML response contains multiple Assertion elements");
        }
        return xml.substring(aStart, aEnd);
    }

