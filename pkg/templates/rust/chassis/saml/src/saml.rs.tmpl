        // Verify signature
        let signed_info_c14n = c14n_element(&signed_info_xml)?;
        if sig_bytes.len() != 64 {
            return Err(SamlError::VerificationError(
                format!("unexpected signature length: {}", sig_bytes.len())
            ));
