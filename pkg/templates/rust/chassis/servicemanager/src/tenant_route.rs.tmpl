//! Tenant routing: `(spec.rpc).route_field`.
//!
//! Every rpc of a tenant-owned service names the request field that carries
//! the TARGET TENANT ID, a tid: exactly 8 characters of `[0-9a-z]`. That value
//! decides which tenant's instance receives the call, and nothing else. It is
//! never defaulted from the caller's token and never falls back to another
//! tenant's instance: an empty or malformed one is refused, INVALID_ARGUMENT,
//! before anything is dialled.
//!
//! One implementation serves every router: the generated S2S clients, the REST
//! dispatcher and the gateway's gRPC proxy (which holds only the raw request
//! frame, see [`route_tenant_from_wire`]), and the tenant-owned instance's own
//! backstop ([`check_routed_tenant`]).

/// Length of a tid.
pub const TENANT_ID_LEN: usize = 8;

/// Reports whether `value` is a tid: exactly 8 characters of `[0-9a-z]`.
/// No trimming and no case folding: anything else is not a tid.
pub fn valid_tenant_id(value: &str) -> bool {
    value.len() == TENANT_ID_LEN
        && value.bytes().all(|b| b.is_ascii_digit() || b.is_ascii_lowercase())
}

/// The route field's value as a tid, or INVALID_ARGUMENT naming `field`.
pub fn route_tenant(field: &str, value: &str) -> Result<String, tonic::Status> {
    if value.is_empty() {
        return Err(tonic::Status::invalid_argument(format!(
            "route field {:?} is empty: a tenant-routed call must name its target tenant",
            field
        )));
    }
    if !valid_tenant_id(value) {
        return Err(tonic::Status::invalid_argument(format!(
            "route field {:?} = {:?} is not a tenant id (exactly {} characters of [0-9a-z])",
            field,
            shown(value),
            TENANT_ID_LEN
        )));
    }
    Ok(value.to_string())
}

/// A bounded rendering of a refused value, so a hostile request cannot fill a
/// log line or an error message.
fn shown(value: &str) -> String {
    const MAX: usize = 32;
    if value.chars().count() <= MAX {
        return value.to_string();
    }
    let mut out: String = value.chars().take(MAX).collect();
    out.push('…');
    out
}

/// The route tenant of a raw protobuf request frame, for a router that holds
/// only the encoded message (the gateway's generic gRPC proxy).
///
/// Walks the whole wire encoding (varint, i64, len, i32 and groups), refusing
/// malformed input, and takes the LAST top-level occurrence of `field_number`
/// with wire type LEN (proto3: last one wins). The value must be UTF-8 and a
/// tid (see [`route_tenant`]). A field that never occurs is empty, and refused.
/// `field_number` 0 is a platform route: no tenant, `Ok("")`.
pub fn route_tenant_from_wire(frame: &[u8], field_number: u32, field: &str) -> Result<String, tonic::Status> {
    if field_number == 0 {
        return Ok(String::new());
    }
    let malformed = |why: &str| {
        tonic::Status::invalid_argument(format!(
            "request frame is not a valid protobuf message ({}); route field {:?} cannot be read",
            why, field
        ))
    };
    let mut value: &[u8] = &[];
    let mut groups: Vec<u32> = Vec::new();
    let mut pos = 0usize;
    while pos < frame.len() {
        let tag = read_varint(frame, &mut pos).ok_or_else(|| malformed("truncated or overlong tag"))?;
        if tag > u64::from(u32::MAX) {
            return Err(malformed("tag out of range"));
        }
        let number = (tag >> 3) as u32;
        let wire_type = (tag & 7) as u8;
        if number == 0 {
            return Err(malformed("field number 0"));
        }
        match wire_type {
            0 => {
                read_varint(frame, &mut pos).ok_or_else(|| malformed("truncated or overlong varint"))?;
            }
            1 => skip(frame, &mut pos, 8).ok_or_else(|| malformed("truncated fixed64"))?,
            2 => {
                let len = read_varint(frame, &mut pos).ok_or_else(|| malformed("truncated or overlong length"))?;
                let len = usize::try_from(len).map_err(|_| malformed("length out of range"))?;
                let start = pos;
                skip(frame, &mut pos, len).ok_or_else(|| malformed("truncated length-delimited field"))?;
                if groups.is_empty() && number == field_number {
                    value = &frame[start..pos];
                }
            }
            3 => groups.push(number),
            4 => {
                if groups.pop() != Some(number) {
                    return Err(malformed("unmatched end-group"));
                }
            }
            5 => skip(frame, &mut pos, 4).ok_or_else(|| malformed("truncated fixed32"))?,
            _ => return Err(malformed("invalid wire type")),
        }
    }
    if !groups.is_empty() {
        return Err(malformed("unterminated group"));
    }
    let value = std::str::from_utf8(value).map_err(|_| {
        tonic::Status::invalid_argument(format!("route field {:?} is not valid UTF-8", field))
    })?;
    route_tenant(field, value)
}

fn read_varint(buf: &[u8], pos: &mut usize) -> Option<u64> {
    let mut value = 0u64;
    for i in 0..10 {
        let b = *buf.get(*pos)?;
        *pos += 1;
        if i == 9 && b > 1 {
            return None;
        }
        value |= u64::from(b & 0x7f) << (7 * i);
        if b & 0x80 == 0 {
            return Some(value);
        }
    }
    None
}

fn skip(buf: &[u8], pos: &mut usize, n: usize) -> Option<()> {
    let end = pos.checked_add(n)?;
    if end > buf.len() {
        return None;
    }
    *pos = end;
    Some(())
}

/// The tenant segment of a namespace that is exactly `/tenants/<t>`, whatever
/// `<t>` is, else `None`. This is the tenant a tenant-owned instance serves:
/// one whose `<t>` is not a tid serves no routed call at all.
pub fn host_tenant_of_namespace(namespace: &str) -> Option<String> {
    let prefix = format!("/{}/", ::spiffe::TENANTS_SEGMENT);
    let tenant = namespace.strip_prefix(prefix.as_str())?;
    (!tenant.is_empty() && !tenant.contains('/')).then(|| tenant.to_string())
}

/// The tid of a namespace that is exactly `/tenants/<tid>`, else `None`.
pub fn tenant_of_namespace(namespace: &str) -> Option<String> {
    host_tenant_of_namespace(namespace).filter(|t| valid_tenant_id(t))
}

/// The tid of the tenant a caller's namespace claim sits in: `/tenants/<tid>`
/// or anything below it (`/tenants/<tid>/...`), else `None`. A caller at
/// `/system`, or under a tenant whose name is not a tid, is in no tenant.
pub fn tenant_of_caller_namespace(namespace: &str) -> Option<String> {
    let prefix = format!("/{}/", ::spiffe::TENANTS_SEGMENT);
    let rest = namespace.strip_prefix(prefix.as_str())?;
    let tenant = rest.split('/').next().unwrap_or("");
    valid_tenant_id(tenant).then(|| tenant.to_string())
}

/// The tid of the tenant whose instance `spiffe_id` names: its namespace,
/// parsed by the generated spiffe lib, is exactly `/tenants/<tid>`. Any other
/// identity, or one that does not parse, is no tenant's instance.
pub fn tenant_of_spiffe_id(spiffe_id: &str) -> Option<String> {
    let parsed = ::spiffe::parse_spiffe_id(spiffe_id).ok()?;
    tenant_of_namespace(&parsed.namespace)
}

/// The tenant-owned instance's backstop for a routed rpc, run after request
/// validation and before the handler: the route field must be a tid
/// (INVALID_ARGUMENT), and when the instance serves one tenant (`host_tenant`,
/// its own `/tenants/<t>`; empty otherwise) it must be that one
/// (PERMISSION_DENIED). A request routed elsewhere never reaches the handler.
pub fn check_routed_tenant(field: &str, value: &str, host_tenant: &str) -> Result<(), tonic::Status> {
    let tenant = route_tenant(field, value)?;
    if !host_tenant.is_empty() && tenant != host_tenant {
        return Err(tonic::Status::permission_denied(format!(
            "routed to tenant {}, this instance serves tenant {}",
            tenant, host_tenant
        )));
    }
    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn tenant_id_is_exactly_eight_lowercase_alphanumerics() {
        for ok in ["aaaaaaaa", "00000001", "a1b2c3d4", "zzzzzzzz"] {
            assert!(valid_tenant_id(ok), "{ok:?} is a tid");
        }
        for bad in ["", "aaaaaaa", "aaaaaaaaa", "AAAAAAAA", "aaaa-aaa", " aaaaaaa", "aaaaaaa ", "aaaaaaa\n", "äaaaaaa", "aaaa/aaa"] {
            assert!(!valid_tenant_id(bad), "{bad:?} is not a tid");
        }
    }

    #[test]
    fn route_tenant_refuses_empty_and_malformed_naming_the_field() {
        assert_eq!(route_tenant("tenant", "aaaaaaaa").unwrap(), "aaaaaaaa");
        for bad in ["", "ACME0001", "short", "aaaaaaaaa"] {
            let err = route_tenant("tenant", bad).unwrap_err();
            assert_eq!(err.code(), tonic::Code::InvalidArgument, "{bad:?}");
            assert!(err.message().contains("\"tenant\""), "message must name the field: {}", err.message());
        }
    }

    fn field_len(number: u32, bytes: &[u8]) -> Vec<u8> {
        let mut out = Vec::new();
        put_varint(&mut out, u64::from(number << 3 | 2));
        put_varint(&mut out, bytes.len() as u64);
        out.extend_from_slice(bytes);
        out
    }

    fn put_varint(out: &mut Vec<u8>, mut v: u64) {
        loop {
            let b = (v & 0x7f) as u8;
            v >>= 7;
            if v == 0 {
                out.push(b);
                return;
            }
            out.push(b | 0x80);
        }
    }

    #[test]
    fn wire_reads_the_route_field_and_last_one_wins() {
        let mut frame = Vec::new();
        frame.extend(field_len(1, b"other"));
        // varint, fixed64, fixed32 and a group around a same-numbered LEN field
        // that is NOT top-level must all be walked over.
        put_varint(&mut frame, 2 << 3);
        put_varint(&mut frame, 300);
        put_varint(&mut frame, 3 << 3 | 1);
        frame.extend_from_slice(&[0; 8]);
        put_varint(&mut frame, 4 << 3 | 5);
        frame.extend_from_slice(&[0; 4]);
        frame.extend(field_len(7, b"aaaaaaaa"));
        put_varint(&mut frame, 9 << 3 | 3);
        frame.extend(field_len(7, b"cccccccc"));
        put_varint(&mut frame, 9 << 3 | 4);
        assert_eq!(route_tenant_from_wire(&frame, 7, "tenant").unwrap(), "aaaaaaaa");
        frame.extend(field_len(7, b"bbbbbbbb"));
        assert_eq!(route_tenant_from_wire(&frame, 7, "tenant").unwrap(), "bbbbbbbb");
    }

