            ResourceParts that = (ResourceParts) o;
            return Objects.equals(namespace, that.namespace)
                    && Objects.equals(kind, that.kind)
                    && Objects.equals(id, that.id);
        }

        @Override
        public int hashCode() {
            return Objects.hash(namespace, kind, id);
        }

        @Override
        public String toString() {
            return "ResourceParts{namespace=" + namespace + ", kind=" + kind + ", id=" + id + "}";
        }
    }

    /** Extracts the resource parts from a resource SPIFFE ID. */
    public static ResourceParts resourcePartsFromSpiffe(String spiffeId) {
        ParsedSpiffeId p = parseSpiffeId(spiffeId);
        if (p.subjectKind != SubjectKind.RESOURCE) {
            throw new IllegalArgumentException("spiffe: not a resource identity: \"" + spiffeId + "\"");
        }
        return new ResourceParts(p.namespace, p.resourceKind, p.resourceId);
    }

    // ---- Comparison. ----

    /**
     * Reports whether {@code target} is the same as {@code caller} or a strict
     * path-segment descendant in the NAMESPACE (authorization) tree.
     */
    public static boolean isAtOrBelow(String callerNamespace, String targetNamespace) {
        String caller = trimNamespace(callerNamespace);
        String target = trimNamespace(targetNamespace);
        if (caller.isEmpty() || target.isEmpty()) {
            return false;
        }
        if (caller.equals(target)) {
            return true;
        }
        if (caller.equals("/")) {
            return target.startsWith("/");
        }
        return target.startsWith(caller + "/");
    }

    /**
     * Reports whether the target SPIFFE ID is the same as or a path-segment
     * descendant of the caller SPIFFE ID. This is the IDENTITY-path relation and is
     * distinct from {@link #isAtOrBelow}; the two must not be cross-applied.
     */
    public static boolean isSpiffeAtOrBelow(String callerSpiffeId, String targetSpiffeId) {
        ParsedSpiffeId c;
        ParsedSpiffeId t;
        try {
            c = parseSpiffeId(callerSpiffeId);
            t = parseSpiffeId(targetSpiffeId);
        } catch (IllegalArgumentException e) {
            return false;
        }
        if (!c.trustDomain.equals(t.trustDomain)) {
            return false;
        }
        if (c.pathSegments.size() > t.pathSegments.size()) {
            return false;
        }
        for (int i = 0; i < c.pathSegments.size(); i++) {
            if (!c.pathSegments.get(i).equals(t.pathSegments.get(i))) {
                return false;
            }
        }
        return true;
    }

    /** Reports whether two SPIFFE IDs share a trust domain. */
    public static boolean sameTrustDomain(String a, String b) {
        ParsedSpiffeId pa;
        ParsedSpiffeId pb;
        try {
            pa = parseSpiffeId(a);
            pb = parseSpiffeId(b);
        } catch (IllegalArgumentException e) {
            return false;
        }
        return pa.trustDomain.equals(pb.trustDomain);
    }

    // ---- internal helpers ----

    private static void rejectDangerous(String s) {
        String lower = s.toLowerCase();
        for (String enc : new String[] {"%2f", "%5c"}) {
            if (lower.contains(enc)) {
                throw new IllegalArgumentException(
                        "spiffe: encoded separator \"" + enc + "\" not allowed: \"" + s + "\"");
            }
        }
        for (int i = 0; i < s.length(); i++) {
            char r = s.charAt(i);
            if (r < 0x20 || r == 0x7f) {
                throw new IllegalArgumentException("spiffe: control character not allowed: \"" + s + "\"");
            }
        }
    }

    private static List<String> splitPath(String p) {
        String t = p == null ? "" : p.trim();
        t = trimSlashes(t);
        if (t.isEmpty()) {
            return new ArrayList<>();
        }
        return new ArrayList<>(Arrays.asList(t.split("/", -1)));
    }

    private static String trimNamespace(String ns) {
        String n = ns == null ? "" : ns.trim();
        if (n.isEmpty()) {
            return "";
        }
        if (!n.startsWith("/")) {
            n = "/" + n;
        }
        String trimmed = trimTrailingSlashes(n);
        if (trimmed.isEmpty()) {
            return "/";
        }
        return trimmed;
    }

    private static Map<String, Integer> tagIndexes(List<String> segs) {
        Map<String, Integer> out = new HashMap<>();
        out.put(WORKLOADS_SEGMENT, -1);
        out.put(SERVICES_SEGMENT, -1);
        out.put(USERS_SEGMENT, -1);
        out.put(CLIENTS_SEGMENT, -1);
        out.put(CREDENTIALS_SEGMENT, -1);
        out.put(DATA_SEGMENT, -1);
        for (int i = 0; i < segs.size(); i++) {
            String s = segs.get(i);
            if (out.containsKey(s) && out.get(s) == -1) {
                out.put(s, i);
            }
        }
        return out;
    }

    private static boolean containsAny(String s, String chars) {
        for (int i = 0; i < chars.length(); i++) {
            if (s.indexOf(chars.charAt(i)) >= 0) {
                return true;
            }
        }
        return false;
    }

    private static String trimTrailingSlashes(String s) {
        int end = s.length();
        while (end > 0 && s.charAt(end - 1) == '/') {
            end--;
        }
        return s.substring(0, end);
    }

    private static String trimSlashes(String s) {
        int start = 0;
        int end = s.length();
        while (start < end && s.charAt(start) == '/') {
            start++;
        }
        while (end > start && s.charAt(end - 1) == '/') {
            end--;
        }
        return s.substring(start, end);
    }
}
