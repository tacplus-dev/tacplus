package diskstore

import (
	"bytes"
	"testing"
)

func TestCompressRoundtripNone(t *testing.T) {
	data := []byte("hello world")
	c, err := Compress(data, CodecNone)
	if err != nil {
		t.Fatalf("compress: %v", err)
	}
	got, err := DecompressAuto(c)
	if err != nil {
		t.Fatalf("decompress: %v", err)
	}
	if !bytes.Equal(got, data) {
		t.Fatalf("got %q want %q", got, data)
	}
}

func TestCompressRoundtripGz(t *testing.T) {
	data := []byte("hello world, hello world, hello world")
	c, err := Compress(data, CodecGz)
	if err != nil {
		t.Fatalf("compress: %v", err)
	}
	if !bytes.HasPrefix(c, gzMagic) {
		t.Fatalf("gz output missing magic bytes")
	}
	got, err := DecompressAuto(c)
	if err != nil {
		t.Fatalf("decompress: %v", err)
	}
	if !bytes.Equal(got, data) {
		t.Fatalf("got %q want %q", got, data)
	}
}

