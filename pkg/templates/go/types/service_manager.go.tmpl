tlsReadyCh := make(chan error, 1)
// storeTlsCert publishes accepted renewals into the ServiceManager: the gRPC
// servers below resolve their serving certificate per handshake from
// sm.sc.TLSCertMaterial, so this is what makes rotation live
// (PC-L-10). The renewal key arrives as PKCS#8 DER (generateKeyAndProto).
storeTlsCert := func(chain *x509_pb.X509CertChain, keyDER []byte) {
key, err := x509std.ParsePKCS8PrivateKey(keyDER)
if err != nil {
zap.L().Error("failed to parse renewed TLS private key; servers keep the previous cert", zap.Error(err))
