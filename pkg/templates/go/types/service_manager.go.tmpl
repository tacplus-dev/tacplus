// Wire trace publisher for gRPC wrappers and EventBus subscription handlers.
// Topic: {{.TracePublisherTopicRef}}.
// Events are sent to a bounded channel; a background goroutine resolves
// the declared EventBus broker asynchronously and drains them into a bidi
// stream. Resolution is non-blocking so services can start serving before the
// trace pipeline's broker is ready.
traceCh := make(chan *trace_pb.TraceEvent, 256)
sm.tasks.Go(func(taskCtx context.Context) {
// Trace events go to the declared EventBus broker using a broker-audience token.
tracePublishLoop(taskCtx,
func(ctx context.Context) (grpc.ClientConnInterface, error) {
return sm.resolveServiceCtx(ctx, "{{.TracePublisherTarget}}")
},
func() (string, error) { return sm.identity.GetTokenFor("{{.TracePublisherTarget}}") },
traceCh)
})
tracePublish := func(ctx context.Context, event *trace_pb.TraceEvent) {
select {
case traceCh <- event:
default:
traceID := ""
if event != nil {
traceID = event.GetTraceId()
}
zap.L().Warn("trace publisher queue full, dropping trace event",
zap.String("trace_id", traceID))
