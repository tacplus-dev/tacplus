{{.WatchFields}}
        self._authorize_func = None
        self._authenticate_func = None
        self._emitter = None
        self._instance_id = ""
        self._trace_publisher = None

    def set_instance_id(self, instance_id: str):
        """Sets the instance ID used for trace rounds."""
        self._instance_id = instance_id

    def set_authorize_func(self, f):
        """Sets the authorization function."""
        self._authorize_func = f

    def set_authenticate_func(self, f):
        """Sets the authentication function (auth_any_user: token-only verification)."""
        self._authenticate_func = f

    def has_authorizer(self) -> bool:
        """Returns whether both generated auth callbacks are wired."""
        return self._authorize_func is not None and self._authenticate_func is not None

    def _metadata_from_context(self, context):
        metadata = {}
        if context is None or not hasattr(context, "invocation_metadata"):
            return metadata
        for item in context.invocation_metadata() or ():
            key = getattr(item, "key", None)
            value = getattr(item, "value", None)
            if key is not None:
                metadata[str(key).lower()] = str(value)
        return metadata

    def set_emitter(self, emitter):
        """Sets the accounting emitter for this service wrapper."""
        self._emitter = emitter

    def set_trace_publisher(self, publisher):
        """Sets the callback for publishing trace events to EventBus."""
        self._trace_publisher = publisher

{{- if .HasAccounting}}
    def _request_id_from_context(self, context) -> str:
        metadata = self._metadata_from_context(context)
        return metadata.get("x-request-id") or metadata.get("request-id") or ""

    def _wire_code(self, context):
        """The status code the call ended with, as context.abort set it;
        None when the context has not recorded one."""
        code_fn = getattr(context, "code", None)
        if not callable(code_fn):
            return None
        try:
            code = code_fn()
        except Exception:
            return None
        if code is None:
            return None
        value = getattr(code, "value", code)
        if isinstance(value, tuple) and value:
            value = value[0]
        try:
            return int(value)
        except Exception:
            return None

    def _emit_accounting(self, method, stage, started_at: float, exc, context, metrics, token):
        """Emits the call's one RpcCompleted (tacplus#273) and ends its call
        scope. stage is how far the call got; exc is what it ended with (None
        on success). A call whose verified caller is a service principal and
        that carries the accounting_internal marker stores accounting, and is
        not itself accounted."""
        internal = is_accounting_internal(ACCOUNTING_INTERNAL_HEADER in self._metadata_from_context(context))
        end_metrics(token)
        if self._emitter is None or internal:
            return
        duration_ms = max(0, int((time.time() - started_at) * 1000))
        request_id = self._request_id_from_context(context)
        code = self._wire_code(context) if exc is not None else 0
        self._emitter.rpc(method, stage, exc, duration_ms, metrics, {}, request_id, code=code)

{{- end}}

    def _trace_id_from_request(self, request) -> str:
        value = getattr(request, "trace_id", "")
        return value if isinstance(value, str) else ""

    def _noop_from_request(self, request) -> bool:
        return bool(getattr(request, "noop", False))

    def _publish_trace(self, trace_id: str, kind: int, error: str = "", method=None):
        if not trace_id or self._trace_publisher is None:
            return
        event_kwargs = dict(
            trace_id=trace_id,
            round=trace_pb.TraceRound(
                service="{{.ServiceLabel}}",
                instance_id=self._instance_id,
                timestamp_ms=int(time.time() * 1000),
            ),
            kind=kind,
            error=error,
        )
        if method is not None:
            event_kwargs["rpc"] = method
        event = trace_pb.TraceEvent(**event_kwargs)
        self._trace_publisher(event)

    def _authorize(self, context, full_method: str, req=None):
        """Check authorization. Fail-closed: a missing authorize func rejects.
        auth_disabled methods skip this call (by annotation), so reaching here
        with no func means a token-auth method was left unwired — never allow it."""
        if self._authorize_func is None:
            raise PermissionError(
                f"authorizer not configured for {full_method} — auth is mandatory and cannot be disabled")
        sub_type = self._authorize_func(self._metadata_from_context(context), full_method, req)
{{- if .HasAccounting}}
        set_verified_caller(sub_type)
{{- end}}

    def _authenticate(self, context, target_namespace=None, full_method=None):
        """Check authentication only (auth_any_user). Fail-closed: a missing func rejects.
        full_method is passed only for an RPC_FLAG_ANY_TENANT method, so the
        authorizer opens the tenant-owned door for that method alone."""
        if self._authenticate_func is None:
            raise PermissionError(
                "authenticator not configured — auth is mandatory and cannot be disabled")
        if full_method is None:
            sub_type = self._authenticate_func(self._metadata_from_context(context), target_namespace)
        else:
            sub_type = self._authenticate_func(self._metadata_from_context(context), target_namespace, full_method)
{{- if .HasAccounting}}
        set_verified_caller(sub_type)
{{- end}}

    def _abort_handler_error(self, context, exc):
        grpc_code = getattr(exc, "grpc_code", None)
        if grpc_code is not None:
            context.abort(grpc_code, str(exc))
        error = getattr(exc, "error", None)
        code = getattr(error, "code", None)
        if code is not None:
            context.abort(self._GRPC_STATUS_BY_CODE.get(code, grpc.StatusCode.INTERNAL), str(exc))
        if isinstance(exc, PermissionError):
            context.abort(grpc.StatusCode.UNAUTHENTICATED, str(exc))
        context.abort(grpc.StatusCode.INTERNAL, str(exc))

    def _abort_request_validation(self, context, exc):
        context.abort(grpc.StatusCode.INVALID_ARGUMENT, str(exc))

    def _abort_response_validation(self, context, exc):
        context.abort(grpc.StatusCode.INTERNAL, str(exc))

    def _validating_request_iterator(self, request_iterator, context, validate_request=None, authorize_request=None):
        for request in request_iterator:
            if authorize_request is not None:
                try:
                    authorize_request(request)
                except Exception as exc:
                    self._abort_handler_error(context, exc)
            try:
                if validate_request is not None:
                    validate_request(request)
            except Exception as exc:
                self._abort_request_validation(context, exc)
            yield request

