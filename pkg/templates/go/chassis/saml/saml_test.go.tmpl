package saml

import (
	"crypto/ecdsa"
	"crypto/elliptic"
	"crypto/rand"
	stdx509 "crypto/x509"
	"crypto/x509/pkix"
	"encoding/pem"
	"math/big"
	"strings"
	"testing"
	"time"

	wrapperKey "{{.ModuleBasePath}}/chassis/key"
	wrapperX509 "{{.ModuleBasePath}}/chassis/x509"
)

func testKeyAndCert(t *testing.T) (*wrapperKey.ImmutableKey, *wrapperX509.ImmutableCert) {
	t.Helper()
	privateKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	if err != nil {
		t.Fatalf("generate key: %v", err)
	}
	keyProto, err := wrapperKey.NewKey(privateKey)
	if err != nil {
		t.Fatalf("wrap key proto: %v", err)
	}
	keyProto.Id = "saml-test-key"
	key, err := wrapperKey.NewImmutableKey(keyProto)
	if err != nil {
		t.Fatalf("wrap immutable key: %v", err)
	}

	now := time.Now()
	certTemplate := &stdx509.Certificate{
		SerialNumber: big.NewInt(1),
		Subject: pkix.Name{
			CommonName: "saml-test-idp",
		},
		NotBefore:             now.Add(-time.Minute),
		NotAfter:              now.Add(time.Hour),
		KeyUsage:              stdx509.KeyUsageDigitalSignature,
		BasicConstraintsValid: true,
	}
	der, err := stdx509.CreateCertificate(rand.Reader, certTemplate, certTemplate, &privateKey.PublicKey, privateKey)
	if err != nil {
		t.Fatalf("create certificate: %v", err)
	}
	pemBytes := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})
	certProto, err := wrapperX509.NewX509Cert(pemBytes)
	if err != nil {
		t.Fatalf("wrap cert proto: %v", err)
	}
	cert, err := wrapperX509.NewImmutableX509Cert(certProto)
	if err != nil {
		t.Fatalf("wrap immutable cert: %v", err)
	}
	return key, cert
}

func signedAssertion(t *testing.T, status string) (*SamlAssertionWrapper, *wrapperX509.ImmutableCert) {
	t.Helper()
	key, cert := testKeyAndCert(t)
	now := time.Now()
	assertion := NewSamlAssertion().
		SetIssuer("https://idp.example/saml").
		SetSubject("alice@example.com", NameIdFormatEmail).
		SetRecipient("https://sp.example/saml/acs").
		SetInResponseTo("request-123").
		SetAudiences([]string{"https://sp.example/saml"}).
		SetValidityWindow(now.Add(-time.Minute), now.Add(time.Hour)).
		SetExpiration(now.Add(time.Hour)).
		SetAuthnContext(AuthnContextPassword).
		SetAttribute("email", "alice@example.com")
	if status != "" {
		assertion.SetStatusCode(status)
	}
	if err := assertion.Sign(key, cert); err != nil {
		t.Fatalf("sign assertion: %v", err)
	}
	return assertion, cert
}

func TestSignedGeneratedSamlResponseVerifies(t *testing.T) {
	assertion, cert := signedAssertion(t, StatusSuccess)
	parsed, err := ParseSamlResponse(assertion.GetXml())
	if err != nil {
		t.Fatalf("parse signed response: %v", err)
	}
	if err := parsed.Verify(
		cert,
		WithExpectedIssuer("https://idp.example/saml"),
		WithExpectedAudience("https://sp.example/saml"),
		WithExpectedRecipient("https://sp.example/saml/acs"),
		WithExpectedInResponseTo("request-123"),
	); err != nil {
		t.Fatalf("verify signed response: %v", err)
	}
	if got := parsed.GetAttribute("email"); got != "alice@example.com" {
		t.Fatalf("expected parsed email attribute, got %q", got)
	}
}

func TestSamlVerifyRejectsNonSuccessStatus(t *testing.T) {
	assertion, cert := signedAssertion(t, StatusRequester)
	parsed, err := ParseSamlResponse(assertion.GetXml())
	if err != nil {
		t.Fatalf("parse signed response: %v", err)
	}
	err = parsed.Verify(cert)
	if err == nil || !strings.Contains(err.Error(), "not Success") {
		t.Fatalf("expected non-Success status rejection, got %v", err)
	}
}

func TestSamlVerifyRejectsMultipleAssertions(t *testing.T) {
	assertion, cert := signedAssertion(t, StatusSuccess)
	xml := assertion.GetXml()
	start := strings.Index(xml, "<saml:Assertion")
	end := strings.Index(xml[start:], "</saml:Assertion>")
	if start < 0 || end < 0 {
		t.Fatalf("signed response missing assertion:\n%s", xml)
	}
	end += start + len("</saml:Assertion>")
	fragment := xml[start:end]
	tampered := strings.Replace(xml, "</samlp:Response>", fragment+"</samlp:Response>", 1)

	parsed, err := ParseSamlResponse(tampered)
	if err != nil {
		if strings.Contains(err.Error(), "multiple Assertion") {
			return
		}
		t.Fatalf("parse tampered response: %v", err)
	}
	err = parsed.Verify(cert)
	if err == nil || !strings.Contains(err.Error(), "multiple Assertion") {
		t.Fatalf("expected multiple-assertion rejection, got %v", err)
	}
}
