    /**
     * Builds the standard JDK X509TrustManager that validates a peer chain back
     * to the supplied trusted CAs. The SPIFFE identity pin (service or trust
     * domain) is layered on top by the wrapping trust managers below.
     */
    private static X509TrustManager defaultDelegateTrustManager(
            List<? extends com.google.protobuf.MessageOrBuilder> trustedCas) throws Exception {
        KeyStore trustStore = KeyStore.getInstance(KeyStore.getDefaultType());
        trustStore.load(null, null);
        CertificateFactory cf = CertificateFactory.getInstance("X.509");
        int count = 0;
        for (var ca : trustedCas) {
            if (ca instanceof X509.X509Cert x509) {
                String certBase64 = x509.getBase64();
                if (certBase64 != null && !certBase64.isEmpty()) {
                    byte[] pem = Base64.getDecoder().decode(certBase64);
                    trustStore.setCertificateEntry(
                            "ca-" + count,
                            cf.generateCertificate(new ByteArrayInputStream(pem)));
                    count++;
                }
            }
        }
        if (count == 0) {
            throw new IllegalArgumentException(
                    "trusted_cas is required for service mesh TLS; refusing to use system roots");
        }
        TrustManagerFactory tmf = TrustManagerFactory.getInstance(
                TrustManagerFactory.getDefaultAlgorithm());
        tmf.init(trustStore);
        for (TrustManager tm : tmf.getTrustManagers()) {
            if (tm instanceof X509TrustManager x509) {
                return x509;
            }
        }
        throw new IllegalStateException("no X509TrustManager available for service mesh TLS");
    }

