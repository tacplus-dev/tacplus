import Foundation
import GRPCCore
import GRPCNIOTransportHTTP2

public struct C2DClient: Sendable {
    public let socketPath: String
{{if .DefaultSocketPath}}
    /// Creates a C2D client dialing the daemon at `socketPath`.
    /// - Parameter socketPath: path to the daemon's unix-domain socket. When
    ///   omitted, defaults to the `socket_path` the services declare, the one
    ///   the generated daemons bind.
    /// - Precondition: `socketPath` must not be empty.
    public init(socketPath: String = C2DClient.defaultSocketPath()) {
{{- else}}
    /// Creates a C2D client dialing the daemon at `socketPath`. The services
    /// this client covers declare different socket paths, so there is no
    /// default socket: pass the one of the daemon serving them.
    /// - Parameter socketPath: path to the daemon's unix-domain socket.
    /// - Precondition: `socketPath` must not be empty.
    public init(socketPath: String) {
{{- end}}
        precondition(!socketPath.isEmpty, "C2DClient: socketPath must not be empty")
        self.socketPath = socketPath
    }
{{- if .DefaultSocketPath}}

    /// The default daemon socket: the `socket_path` the services declare,
    /// which the generated daemons bind.
    public static func defaultSocketPath() -> String {
        "{{.DefaultSocketPath}}"
    }
{{- end}}
{{range .Services}}

    public func {{.MethodName}}<Result: Sendable>(
        _ body: ({{.ClientType}}.Client<HTTP2ClientTransport.Posix>) async throws -> Result
    ) async throws -> Result {
        try await self.withClient { client in
            try await body({{.ClientType}}.Client(wrapping: client))
        }
    }
{{end}}

    /// Runs `body` against a client dialing the daemon, then shuts the client
    /// down gracefully once `body` returns, as grpc-swift's `withGRPCClient`
    /// does. That helper runs the client on a discarding task group, whose
    /// teardown intermittently frees task memory out of order on Swift
    /// toolchains before 6.3.1 (swiftlang/swift#75501): the process aborts
    /// with "freed pointer was not the last allocation". So the client runs
    /// on a plain task group here instead (tacplus#803).
    private func withClient<Result: Sendable>(
        _ body: (GRPCClient<HTTP2ClientTransport.Posix>) async throws -> Result
    ) async throws -> Result {
        let client = GRPCClient(
            transport: try .http2NIOPosix(
                target: .unixDomainSocket(path: self.socketPath, authority: "localhost"),
                transportSecurity: .plaintext
            )
        )
        return try await withThrowingTaskGroup(of: Void.self) { group in
            group.addTask { try await client.runConnections() }
            let result = try await body(client)
            client.beginGracefulShutdown()
            try await group.waitForAll()
            return result
        }
    }
}
