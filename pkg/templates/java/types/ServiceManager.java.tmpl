    private static KeyOuterClass.PublicKey buildPublicKeyProto(KeyPair kp) {
        byte[] pubDer = kp.getPublic().getEncoded();
        String pubPem = "-----BEGIN PUBLIC KEY-----\n"
                + java.util.Base64.getMimeEncoder(64, "\n".getBytes()).encodeToString(pubDer)
                + "\n-----END PUBLIC KEY-----\n";
        String pubBase64 = java.util.Base64.getUrlEncoder().withoutPadding()
                .encodeToString(pubPem.getBytes(java.nio.charset.StandardCharsets.UTF_8));
        return KeyOuterClass.PublicKey.newBuilder()
                .setId("auto-tls-" + System.currentTimeMillis())
                .setBase64(pubBase64)
                .setCreated(System.currentTimeMillis() / 1000)
                .build();
    }

    private static void verifyLeafMatchesPublicKey(X509.X509CertChain chain, byte[] expectedPublicKeyDer)
            throws Exception {
        if (chain == null || chain.getChainCount() == 0) {
            throw new IllegalArgumentException("certificate chain is empty");
        }
        if (expectedPublicKeyDer == null || expectedPublicKeyDer.length == 0) {
            throw new IllegalArgumentException("expected public key is empty");
        }
        byte[] leafBytes = decodeCertBytes(chain.getChain(0).getBase64());
        CertificateFactory cf = CertificateFactory.getInstance("X.509");
        X509Certificate leaf = (X509Certificate) cf.generateCertificate(new ByteArrayInputStream(leafBytes));
        if (!Arrays.equals(leaf.getPublicKey().getEncoded(), expectedPublicKeyDer)) {
            throw new IllegalArgumentException("leaf certificate public key does not match CSR public key");
        }
    }

    private static byte[] decodeCertBytes(String base64) {
        if (base64 == null || base64.isEmpty()) {
            throw new IllegalArgumentException("certificate base64 is empty");
        }
        byte[] raw;
        try {
            raw = java.util.Base64.getUrlDecoder().decode(base64);
        } catch (IllegalArgumentException urlErr) {
            raw = java.util.Base64.getDecoder().decode(base64);
        }
        String text = new String(raw, java.nio.charset.StandardCharsets.UTF_8);
        if (text.contains("-----BEGIN")) {
            StringBuilder body = new StringBuilder();
            for (String line : text.split("\\R")) {
                if (!line.startsWith("-----")) {
                    body.append(line.trim());
                }
            }
            return java.util.Base64.getDecoder().decode(body.toString());
        }
        return raw;
    }
