		{"last one wins", frame(3, "aaaaaaaa", 1, uint64(1), 3, "bbbbbbbb"), "bbbbbbbb"},
		{"group skipped", frame(7, group, 3, "aaaaaaaa"), "aaaaaaaa"},
	}
	for _, c := range cases {
