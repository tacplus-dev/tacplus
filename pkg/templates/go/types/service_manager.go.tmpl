const certStreamMaxInitRetries = 30

func generateKeyAndProto() ([]byte, []byte, *key_pb.PublicKey, error) {
{{- if eq .AutoTlsKeyType "ecdsa"}}
priv, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
if err != nil {
return nil, nil, nil, err
}
privateKeyDER, err := x509std.MarshalPKCS8PrivateKey(priv)
if err != nil {
return nil, nil, nil, err
}
pubDER, err := x509std.MarshalPKIXPublicKey(&priv.PublicKey)
if err != nil {
return nil, nil, nil, err
}
{{- else}}
pub, privKey, err := ed25519.GenerateKey(rand.Reader)
if err != nil {
return nil, nil, nil, err
}
privateKeyDER, err := x509std.MarshalPKCS8PrivateKey(privKey)
if err != nil {
return nil, nil, nil, err
}
pubDER, err := x509std.MarshalPKIXPublicKey(pub)
if err != nil {
return nil, nil, nil, err
}
{{- end}}
pubPEM := pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: pubDER})
return privateKeyDER, pubDER, &key_pb.PublicKey{
Id:      fmt.Sprintf("tacplus-key-%d", time.Now().UnixNano()),
Base64:  base64.RawURLEncoding.EncodeToString(pubPEM),
Created: time.Now().Unix(),
}, nil
}

func certLeafMatchesPublicKey(chain *x509_pb.X509CertChain, expectedDER []byte) error {
if chain == nil || len(chain.Chain) == 0 {
return fmt.Errorf("certificate chain is empty")
}
if len(expectedDER) == 0 {
return fmt.Errorf("expected public key is empty")
}
leafDER, err := certLeafDER(chain.Chain[0].Base64)
if err != nil {
return err
}
cert, err := x509std.ParseCertificate(leafDER)
if err != nil {
return fmt.Errorf("parse leaf certificate: %w", err)
}
certPublicKeyDER, err := x509std.MarshalPKIXPublicKey(cert.PublicKey)
if err != nil {
return fmt.Errorf("marshal leaf public key: %w", err)
}
if !bytes.Equal(certPublicKeyDER, expectedDER) {
return fmt.Errorf("leaf certificate public key does not match CSR public key")
}
return nil
}

func certLeafDER(encoded string) ([]byte, error) {
raw, err := decodeCertBase64(encoded)
if err != nil {
return nil, err
}
if block, _ := pem.Decode(raw); block != nil {
return block.Bytes, nil
}
return raw, nil
}

func decodeCertBase64(encoded string) ([]byte, error) {
if encoded == "" {
return nil, fmt.Errorf("certificate base64 is empty")
}
for _, enc := range []*base64.Encoding{
base64.RawURLEncoding,
base64.URLEncoding,
base64.RawStdEncoding,
base64.StdEncoding,
} {
if raw, err := enc.DecodeString(encoded); err == nil {
return raw, nil
}
}
return nil, fmt.Errorf("certificate base64 is invalid")
}
{{end}}
