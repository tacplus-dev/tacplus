        b.attributes = parseAttributes(axml);

        return new SamlAssertion(b, xml);
    }

    // ── Minimal XML helpers ───────────────────────────────────────────────────

    static String xmlEscape(String s) {
        return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;");
    }

    static String xmlEscapeAttr(String s) {
        return xmlEscape(s).replace("\"", "&quot;");
    }

    private static String extractAttr(String xml, String attr) {
        String dq = attr + "=\"";
        int pos = xml.indexOf(dq);
        if (pos >= 0) {
            int s = pos + dq.length();
            int e = xml.indexOf('"', s);
            return e >= 0 ? xml.substring(s, e) : null;
        }
        String sq = attr + "='";
        pos = xml.indexOf(sq);
        if (pos >= 0) {
            int s = pos + sq.length();
            int e = xml.indexOf('\'', s);
            return e >= 0 ? xml.substring(s, e) : null;
        }
        return null;
    }

    private static String extractText(String xml, String tag) {
        String open = "<" + tag;
        String close = "</" + tag + ">";
        int s = xml.indexOf(open);
        if (s < 0) return null;
        int gt = xml.indexOf('>', s);
        if (gt < 0) return null;
        int e = xml.indexOf(close, gt + 1);
        return e >= 0 ? xml.substring(gt + 1, e) : null;
    }

    private static List<String> extractAllText(String xml, String tag) {
        List<String> out = new ArrayList<>();
        String open = "<" + tag + ">";
        String close = "</" + tag + ">";
        int pos = 0;
        while (true) {
            int s = xml.indexOf(open, pos);
            if (s < 0) break;
            int e = xml.indexOf(close, s + open.length());
            if (e < 0) break;
            out.add(xml.substring(s + open.length(), e));
            pos = e + close.length();
        }
        return out;
    }

    private static Map<String, String> parseAttributes(String xml) {
        Map<String, String> map = new LinkedHashMap<>();
        String open = "<saml:Attribute ";
        int pos = 0;
        while (true) {
            int s = xml.indexOf(open, pos);
            if (s < 0) break;
            String name = extractAttr(xml.substring(s), "Name");
            String val  = extractText(xml.substring(s), "saml:AttributeValue");
            if (name != null) map.put(name, val != null ? val : "");
            pos = s + open.length();
        }
        return map;
    }

    private static String findAfter(String xml, String marker) {
        int pos = xml.indexOf(marker);
        return pos >= 0 ? xml.substring(pos) : null;
    }

    private static String nvl(String val, String def) {
        return (val != null && !val.isEmpty()) ? val : def;
    }

    // ── EC P-256 DER ↔ raw r||s conversion ────────────────────────────────────

    /**
     * Convert a Java ECDSA DER signature (ASN.1 SEQUENCE of two INTEGERs) to
     * fixed-width raw r||s (32+32 bytes) required by XML-DSig.
     */
    static byte[] derToRaw(byte[] der) throws SamlException {
        // DER: 30 len 02 rlen r... 02 slen s...
        if (der.length < 8 || der[0] != 0x30) throw new SamlException("invalid DER signature");
        int offset = 2;
        if ((der[1] & 0xff) == 0x81) offset = 3; // long form length
        if (der[offset] != 0x02) throw new SamlException("expected INTEGER tag for r");
        int rLen = der[offset + 1] & 0xff;
        byte[] r = Arrays.copyOfRange(der, offset + 2, offset + 2 + rLen);
        offset += 2 + rLen;
        if (der[offset] != 0x02) throw new SamlException("expected INTEGER tag for s");
        int sLen = der[offset + 1] & 0xff;
        byte[] s = Arrays.copyOfRange(der, offset + 2, offset + 2 + sLen);

        byte[] result = new byte[64];
        // r is big-endian; strip leading zero byte if present, then right-align in 32 bytes
        int rStart = (r[0] == 0) ? 1 : 0;
        int rUsed  = r.length - rStart;
        System.arraycopy(r, rStart, result, 32 - rUsed, rUsed);
        int sStart = (s[0] == 0) ? 1 : 0;
        int sUsed  = s.length - sStart;
        System.arraycopy(s, sStart, result, 64 - sUsed, sUsed);
        return result;
    }

    /**
     * Convert raw r||s (32+32) back to DER SEQUENCE for Java's ECDSA verifier.
     */
    static byte[] rawToDer(byte[] raw) throws SamlException {
        if (raw.length != 64) throw new SamlException("raw signature must be 64 bytes");
        byte[] r = Arrays.copyOfRange(raw, 0, 32);
        byte[] s = Arrays.copyOfRange(raw, 32, 64);
        // Prepend 0x00 if high bit set (avoid negative integer interpretation)
        if ((r[0] & 0x80) != 0) r = prepend(r, (byte) 0);
        if ((s[0] & 0x80) != 0) s = prepend(s, (byte) 0);
        int totalLen = 2 + r.length + 2 + s.length;
        byte[] der = new byte[2 + totalLen];
        der[0] = 0x30;
        der[1] = (byte) totalLen;
        der[2] = 0x02;
        der[3] = (byte) r.length;
        System.arraycopy(r, 0, der, 4, r.length);
        der[4 + r.length] = 0x02;
        der[5 + r.length] = (byte) s.length;
        System.arraycopy(s, 0, der, 6 + r.length, s.length);
        return der;
    }

    private static byte[] prepend(byte[] arr, byte b) {
        byte[] out = new byte[arr.length + 1];
        out[0] = b;
        System.arraycopy(arr, 0, out, 1, arr.length);
        return out;
    }

    static String formatSamlTime(Instant instant) {
        return DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss'Z'")
                .withZone(ZoneOffset.UTC)
                .format(instant);
    }
}
