	{{- end}}
	{{- end}}
	{{- end}}
		{{- end}}
		{{- if .HasSmb}}
		            smb_authority_conn: smb_authority_sc,
		{{- end}}
{{- if .HasDiskStores}}
            disk_store_logs,
{{- end}}
	{{- if .HasAutoTls}}
	            tls_cert_chain_der: tls_cert_chain_der_arc,
	            tls_private_key_der: tls_private_key_der_arc,
            tls_cert_chain_proto: tls_cert_chain_proto_arc,
            tls_cert_chain_pem: tls_cert_chain_pem_arc,
            tls_private_key_pem: tls_private_key_pem_arc,
            tls_handler_slot: tls_handler_slot_arc,
            tls_server_certified_key: tls_server_certified_key_arc,
{{- end}}
        })
    }

