[package]
name = "rotation"
version = "0.1.0"
edition = "2021"
description = "Make-before-break rotation of service-to-service streams (tacplus#322)"

# Every dependency is a workspace pin: this crate adds no version of its own.
[dependencies]
{{.CrateBasePath}}-types = { path = "../../types" }
token = { path = "../token" }
tokio = { workspace = true }
tokio-util = { workspace = true }
tokio-stream = { workspace = true }
tonic = { workspace = true }
prost = { workspace = true }
# Session ids come from the TLS stack's own CSPRNG (ring), a workspace pin.
rustls = { workspace = true }
base64 = { workspace = true }
tracing = { workspace = true }
