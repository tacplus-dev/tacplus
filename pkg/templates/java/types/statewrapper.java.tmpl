    private long watchRetryDelayMillis(int attempt) {
        int capped = Math.max(0, Math.min(attempt, 5));
        long delay = 1000L << capped;
        if (delay > MAX_WATCH_BACKOFF_MILLIS) {
            delay = MAX_WATCH_BACKOFF_MILLIS;
        }
        long jitter = delay / 5;
        if (jitter > 0) {
            delay = Math.min(MAX_WATCH_BACKOFF_MILLIS, delay + ThreadLocalRandom.current().nextLong(jitter + 1));
        }
        return delay;
    }
