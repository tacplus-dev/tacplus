@dataclass
class ParsedSpiffeId:
    """Structured form of a SPIFFE ID.

    Parsing is self-describing: no out-of-band prefix is supplied; the kind is
    recovered from typed tags.
    """

    scheme: str = ""
    trust_domain: str = ""
    path_segments: List[str] = field(default_factory=list)
    namespace: str = ""
    subject_kind: str = KIND_UNKNOWN
    # location-agnostic for service/workload; the leaf for user/client
    subject_path: str = ""
    # for system/service/workload identities
    location_path: str = ""
    resource_kind: str = ""
    resource_id: str = ""

    def reconstruct(self) -> str:
        """Rebuild the canonical SPIFFE ID string from the parsed parts."""
        if len(self.path_segments) == 0:
            return self.scheme + "://" + self.trust_domain
        return (
            self.scheme + "://" + self.trust_domain + "/" + "/".join(self.path_segments)
        )


def parse_spiffe_id(value: str) -> ParsedSpiffeId:
    """Parse and validate a full SPIFFE ID, failing closed on malformed input.

    Raises ValueError on invalid input.
    """
    p = ParsedSpiffeId()
    v = value.strip()
    prefix = SCHEME + "://"
    if not v.startswith(prefix):
        raise ValueError(f"spiffe: missing {prefix!r} scheme: {value!r}")
    rest = v[len(prefix):]
    _reject_dangerous(rest)
    if any(c in rest for c in "?#\\"):
        raise ValueError(f"spiffe: query, fragment, or backslash not allowed: {value!r}")
    td = rest
    path_str = ""
    i = rest.find("/")
    if i >= 0:
        td = rest[:i]
        path_str = rest[i + 1:]
    if td == "":
        raise ValueError(f"spiffe: empty trust domain: {value!r}")
    if any(c in td for c in "/\\?#"):
        raise ValueError(f"spiffe: malformed trust domain: {value!r}")
    p.scheme = SCHEME
    p.trust_domain = td

    if path_str == "":
        p.namespace = "/"
        return p
    segs = path_str.split("/")
    for s in segs:
        if s == "":
            raise ValueError(f"spiffe: empty path segment in {value!r}")
        if s == "." or s == "..":
            raise ValueError(f"spiffe: dot segment not allowed in {value!r}")
        if not _SEGMENT_RE.match(s):
            raise ValueError(f"spiffe: path segment {s!r} violates grammar in {value!r}")
    p.path_segments = segs

    _classify(p, segs)
    return p


def _classify(p: ParsedSpiffeId, segs: List[str]) -> None:
    idx = _tag_indexes(segs)
    if idx[WORKLOADS_SEGMENT] >= 0:
        p.subject_kind = KIND_WORKLOAD
        _classify_system(p, segs)
    elif segs[0] in (SYSTEM_SEGMENT, TENANTS_SEGMENT) and idx[SERVICES_SEGMENT] >= 0:
        p.subject_kind = KIND_SERVICE
        _classify_system(p, segs)
    elif segs[0] == PEOPLE_SEGMENT and idx[USERS_SEGMENT] >= 0:
        _classify_person(p, segs)
    elif idx[USERS_SEGMENT] >= 0:
        _classify_namespaced(p, segs, idx[USERS_SEGMENT], KIND_USER)
    elif idx[CLIENTS_SEGMENT] >= 0:
        _classify_namespaced(p, segs, idx[CLIENTS_SEGMENT], KIND_CLIENT)
    elif idx[CREDENTIALS_SEGMENT] >= 0:
        _classify_pair(p, segs, idx[CREDENTIALS_SEGMENT], KIND_UNKNOWN)
    elif idx[DATA_SEGMENT] >= 0:
        _classify_pair(p, segs, idx[DATA_SEGMENT], KIND_RESOURCE)
    else:
        # Namespace-only identity (tenant/workspace/system subtree).
        p.subject_kind = KIND_UNKNOWN
        p.namespace = "/" + "/".join(segs)


def _classify_system(p: ParsedSpiffeId, segs: List[str]) -> None:
    # Handles both service-root shapes: /system/<location...>/services/<svc>
    # (shared services, location-agnostic) and /tenants/<tenant>/services/<svc>
    # (tenant-owned services, one operator-managed instance per tenant).
    # Namespace is everything before "services"; for the tenant root that's
    # exactly "/tenants/<tenant>".
    si = _index_of(segs, SERVICES_SEGMENT)
    if segs[0] not in (SYSTEM_SEGMENT, TENANTS_SEGMENT) or si < 0 or si + 1 >= len(segs):
        raise ValueError(
            "spiffe: malformed system/service identity: /" + "/".join(segs)
        )
    p.location_path = "/".join(segs[1:si])
    p.namespace = "/" + "/".join(segs[:si])  # /system[/location...]
    p.subject_path = "/".join(segs[si + 1:])  # <service>[/workloads/<child>...]


def _classify_person(p: ParsedSpiffeId, segs: List[str]) -> None:
    # The person root: /people/<person>/users/<person>, the only identity shape
    # rooted at "people". Deliberately tighter than the generic namespaced-user
    # arm: the person id is repeated as the users leaf, and no location segments,
    # no "services" branch, and no further suffix are accepted.
    if len(segs) != 4 or segs[2] != USERS_SEGMENT or segs[1] != segs[3]:
        raise ValueError("spiffe: malformed person identity: /" + "/".join(segs))
    p.subject_kind = KIND_USER
    p.namespace = "/" + PEOPLE_SEGMENT + "/" + segs[1]
    p.subject_path = segs[3]


def _classify_namespaced(
    p: ParsedSpiffeId, segs: List[str], tag_idx: int, kind: str
) -> None:
    if tag_idx + 1 >= len(segs) or tag_idx == 0:
        raise ValueError(
            f"spiffe: malformed {kind} identity: /" + "/".join(segs)
        )
    p.subject_kind = kind
    p.namespace = "/" + "/".join(segs[:tag_idx])
    p.subject_path = "/".join(segs[tag_idx + 1:])


def _classify_pair(p: ParsedSpiffeId, segs: List[str], tag_idx: int, kind: str) -> None:
    if tag_idx == 0 or tag_idx + 2 >= len(segs):
        raise ValueError(
            "spiffe: malformed kind/id identity: /" + "/".join(segs)
        )
    p.subject_kind = kind
    p.namespace = "/" + "/".join(segs[:tag_idx])
    p.resource_kind = segs[tag_idx + 1]
    p.resource_id = "/".join(segs[tag_idx + 2:])


def parse_namespace_or_spiffe(value: str) -> str:
    """Accept either a bare namespace path or a full SPIFFE URI.

    Return the normalized namespace path. Raises ValueError on invalid input.
    """
    v = value.strip()
    if v.startswith(SCHEME + "://"):
        p = parse_spiffe_id(v)
        return normalize_namespace(p.namespace)
    return normalize_namespace(v)


def service_path_from_spiffe(spiffe_id: str) -> str:
    """Return the LOCATION-AGNOSTIC service identity: the bare service label
    plus any /workloads/<child> suffix, with /system/<location...>/ stripped.

    So the same service matches identically across clouds/accounts/AZs/clusters
    in auth_services. (Location-scoped authz is deferred; see plan D2.) Raises
    ValueError on invalid input or a non-service/workload identity.
    """
    p = parse_spiffe_id(spiffe_id)
    if p.subject_kind not in (KIND_SERVICE, KIND_WORKLOAD):
        raise ValueError(f"spiffe: not a service/workload identity: {spiffe_id!r}")
    return p.subject_path


def namespace_from_spiffe(spiffe_id: str) -> str:
    """Return the normalized namespace of a SPIFFE ID."""
    p = parse_spiffe_id(spiffe_id)
    return normalize_namespace(p.namespace)


@dataclass
class ResourceParts:
    """The (namespace, kind, id) of a resource SPIFFE ID."""

    namespace: str = ""
    kind: str = ""
    id: str = ""


def resource_parts_from_spiffe(spiffe_id: str) -> ResourceParts:
    """Extract the resource parts from a resource SPIFFE ID.

    Raises ValueError on invalid input or a non-resource identity.
    """
    p = parse_spiffe_id(spiffe_id)
    if p.subject_kind != KIND_RESOURCE:
        raise ValueError(f"spiffe: not a resource identity: {spiffe_id!r}")
    return ResourceParts(namespace=p.namespace, kind=p.resource_kind, id=p.resource_id)


# ---- Comparison. ----


def is_at_or_below(caller_namespace: str, target_namespace: str) -> bool:
    """Report whether target is the same as caller or a strict path-segment
    descendant in the NAMESPACE (authorization) tree."""
    caller = _trim_namespace(caller_namespace)
    target = _trim_namespace(target_namespace)
    if caller == "" or target == "":
        return False
    if caller == target:
        return True
    if caller == "/":
        return target.startswith("/")
    return target.startswith(caller + "/")


def is_spiffe_at_or_below(caller_spiffe_id: str, target_spiffe_id: str) -> bool:
    """Report whether the target SPIFFE ID is the same as or a path-segment
    descendant of the caller SPIFFE ID.

    This is the IDENTITY-path relation and is distinct from is_at_or_below; the
    two must not be cross-applied.
    """
    try:
        c = parse_spiffe_id(caller_spiffe_id)
    except ValueError:
        return False
    try:
        t = parse_spiffe_id(target_spiffe_id)
    except ValueError:
        return False
    if c.trust_domain != t.trust_domain:
        return False
    if len(c.path_segments) > len(t.path_segments):
        return False
    for i in range(len(c.path_segments)):
        if c.path_segments[i] != t.path_segments[i]:
            return False
    return True


def same_trust_domain(a: str, b: str) -> bool:
    """Report whether two SPIFFE IDs share a trust domain."""
    try:
        pa = parse_spiffe_id(a)
    except ValueError:
        return False
    try:
        pb = parse_spiffe_id(b)
    except ValueError:
        return False
    return pa.trust_domain == pb.trust_domain


# ---- internal helpers ----


def _reject_dangerous(s: str) -> None:
    lower = s.lower()
    for enc in ("%2f", "%5c"):
        if enc in lower:
            raise ValueError(f"spiffe: encoded separator {enc!r} not allowed: {s!r}")
    for ch in s:
        if ord(ch) < 0x20 or ord(ch) == 0x7F:
            raise ValueError(f"spiffe: control character not allowed: {s!r}")


def _split_path(p: str) -> List[str]:
    p = p.strip().strip("/")
    if p == "":
        return []
    return p.split("/")


def _trim_namespace(ns: str) -> str:
    ns = ns.strip()
    if ns == "":
        return ""
    if not ns.startswith("/"):
        ns = "/" + ns
    trimmed = ns.rstrip("/")
    if trimmed == "":
        return "/"
    return trimmed


def _tag_indexes(segs: List[str]) -> Dict[str, int]:
    out = {
        WORKLOADS_SEGMENT: -1,
        SERVICES_SEGMENT: -1,
        USERS_SEGMENT: -1,
        CLIENTS_SEGMENT: -1,
        CREDENTIALS_SEGMENT: -1,
        DATA_SEGMENT: -1,
    }
    for i, s in enumerate(segs):
        if s in out and out[s] == -1:
            out[s] = i
    return out


def _index_of(segs: List[str], tag: str) -> int:
    for i, s in enumerate(segs):
        if s == tag:
            return i
    return -1
