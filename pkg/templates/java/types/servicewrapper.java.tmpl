    private java.util.Map<String, String> checkAuth(String fullMethod, Object request) throws ProtoException {
        return {{.AuthorizerFQN}}.identityClaims(authorizer.authorize(fullMethod, request));
    }
{{- else}}
    /**
     * No authorization — this service is auth_disabled / c2d by proto annotation.
     * Nothing verified a caller, so accounting records carry no identity.
     */
    private java.util.Map<String, String> checkAuth(String fullMethod, Object request) throws ProtoException {
        return java.util.Collections.emptyMap();
    }
