# --- PAGE (keyset pagination) runtime ----------------------------------------
#
# PAGE is a unary RPC: the client drives a resumable window with an opaque
# page_token. The generated wrapper owns the token codec and the page_size
# bound; the handler is a keyset producer returning a Page. The token format is
# identical across every language backend -- base64url(no pad) of
# {"v":1,"k":[...strings...]} -- so a token minted by one client decodes on any
# other. Keep this in lockstep with the Go/TS/Rust/Java runtimes.

_PAGE_TOKEN_VERSION = 1


class BadPageToken(Exception):
    """INVALID_ARGUMENT raised when a page_token does not decode. The wrapper
    never silently resets to the first page on a bad token -- that would skip
    rows and read as success."""

    grpc_code = grpc.StatusCode.INVALID_ARGUMENT


@dataclass
class Cursor:
    """Keyset position of a page boundary: the order_by key components of the
    last row in a page, as strings (the handler parses them back to typed
    values). ``None`` means "from the beginning"."""

    keys: list[str]


@dataclass
class PageParams:
    """What the wrapper hands the handler for one PAGE call: the effective row
    limit (already defaulted and clamped to the trust ceiling) and the decoded
    ``after`` cursor (None on the first page)."""

    limit: int
    after: "Cursor | None"


@dataclass
class Page(Generic[Item]):
    """What a PAGE handler returns: the window of items, the cursor to resume
    after (None when this is the last page), and an optional total (-1 when the
    handler did not compute a count -- callers must treat it as unknown)."""

    items: list[Item]
    next_after: "Cursor | None"
    total: int = -1


def encode_page_token(cursor: "Cursor | None") -> str:
    """Serialize a cursor into the opaque next_page_token. A None cursor (last
    page) encodes to the empty string, the auto-pager's stop signal."""
    if cursor is None:
        return ""
    # ensure_ascii=False + compact separators so the encoding matches the
    # Go/TS/Rust backends (raw UTF-8, no HTML/unicode escaping) -- the token must
    # be byte-identical across languages for a polyglot fleet and the interop harness.
    raw = _json.dumps({"v": _PAGE_TOKEN_VERSION, "k": list(cursor.keys)}, separators=(",", ":"), ensure_ascii=False)
    return _base64.urlsafe_b64encode(raw.encode("utf-8")).rstrip(b"=").decode("ascii")


# The strict base64url alphabet (RFC 4648 section 5, no padding). Tokens are
# emitted unpadded; '=' (or any other character) must be rejected before decode
# so a tampered token fails identically across the Go/Rust/Python backends.
_PAGE_TOKEN_ALPHABET = frozenset(
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
)


def decode_page_token(token: str) -> "Cursor | None":
    """Parse a page_token back into a cursor. The empty string decodes to None
    (first page). Any malformed or wrong-version input raises BadPageToken."""
    if token == "":
        return None
    # Strict no-padding base64url, matching Go/Rust: reject '=' and any other
    # character outside the base64url alphabet instead of silently re-padding.
    # A canonical unpadded base64url string also never has length % 4 == 1
    # (binascii would reject it anyway; checked explicitly for parity with the
    # TS/Go decoders).
    if not all(c in _PAGE_TOKEN_ALPHABET for c in token) or len(token) % 4 == 1:
        raise BadPageToken()
    try:
        padding = "=" * (-len(token) % 4)
        raw = _base64.urlsafe_b64decode(token + padding)
        env = _json.loads(raw)
    except Exception as exc:  # noqa: BLE001 - any decode failure is a bad token
        raise BadPageToken() from exc
    if not isinstance(env, dict) or env.get("v") != _PAGE_TOKEN_VERSION or not isinstance(env.get("k"), list):
        raise BadPageToken()
    return Cursor(keys=[str(k) for k in env["k"]])


def effective_page_size(requested: int, default_size: int, maximum: int) -> int:
    """Resolve the requested page_size against the method's default and the
    trust-tier maximum: a non-positive request takes the default; the result is
    clamped to [1, maximum]."""
    n = requested
    if n <= 0:
        n = default_size
    if n <= 0:
        n = 1
    if maximum > 0 and n > maximum:
        n = maximum
    return n
