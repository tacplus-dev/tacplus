// Build produces the EntityDescriptor XML string.
// Returns an error if no entity ID is set.
func (b *SpMetadataBuilder) Build() (string, error) {
	if b.entityID == "" {
		return "", protoerrors.NewErrMissingInvalidData(nil, "sp metadata requires entity_id")
	}

	var buf strings.Builder
	buf.WriteString(`<?xml version="1.0" encoding="UTF-8"?>`)
	buf.WriteString(`<md:EntityDescriptor`)
	buf.WriteString(` xmlns:md="` + nsMDSAML + `"`)
	buf.WriteString(` entityID="` + xmlEscapeAttr(b.entityID) + `"`)
	buf.WriteString(`>`)

	authnSigned := "false"
	if b.authnRequestsSigned {
		authnSigned = "true"
	}
	buf.WriteString(`<md:SPSSODescriptor`)
	buf.WriteString(` AuthnRequestsSigned="` + authnSigned + `"`)
	buf.WriteString(` protocolSupportEnumeration="` + nsSAMLProtocol + `"`)
	buf.WriteString(`>`)

	if b.signingCert != nil {
		writeKeyDescriptor(&buf, "signing", b.signingCert)
	}
	for i, ep := range b.acsServices {
		isDefault := "false"
		if i == 0 {
			isDefault = "true"
		}
		buf.WriteString(`<md:AssertionConsumerService`)
		buf.WriteString(` Binding="` + xmlEscapeAttr(ep.binding) + `"`)
		buf.WriteString(fmt.Sprintf(` index="%d"`, ep.index))
		buf.WriteString(` isDefault="` + isDefault + `"`)
		buf.WriteString(` Location="` + xmlEscapeAttr(ep.location) + `"`)
		buf.WriteString(`/>`)
	}
	for _, ep := range b.sloServices {
		buf.WriteString(`<md:SingleLogoutService`)
		buf.WriteString(` Binding="` + xmlEscapeAttr(ep.binding) + `"`)
		buf.WriteString(` Location="` + xmlEscapeAttr(ep.location) + `"`)
		buf.WriteString(`/>`)
	}

	buf.WriteString(`</md:SPSSODescriptor>`)
	buf.WriteString(`</md:EntityDescriptor>`)
	return buf.String(), nil
}

