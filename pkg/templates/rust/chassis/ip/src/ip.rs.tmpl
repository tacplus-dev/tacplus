fn aggregate_v4(prefixes: &mut Vec<(u32, u32)>) -> Vec<(u32, u32)> {
    if prefixes.is_empty() { return vec![]; }
    prefixes.sort_by(|a, b| a.0.cmp(&b.0).then(a.1.cmp(&b.1)));

    // Remove contained
    let mut stack: Vec<(u32, u32)> = Vec::new();
    for &(addr, mask) in prefixes.iter() {
        if let Some(&(la, lm)) = stack.last() {
            let m = ipv4_mask(lm);
            if (la & m) == (addr & m) && lm <= mask { continue; }
        }
        stack.push((addr, mask));
    }

    let mut changed = true;
    while changed {
        changed = false;
        let mut merged: Vec<(u32, u32)> = Vec::new();
        let mut i = 0;
        while i < stack.len() {
            if i + 1 < stack.len() && stack[i].1 == stack[i+1].1 && stack[i].1 > 0 {
                let parent_mask = ipv4_mask(stack[i].1 - 1);
                if (stack[i].0 & parent_mask) == (stack[i+1].0 & parent_mask) {
                    merged.push((stack[i].0 & parent_mask, stack[i].1 - 1));
                    i += 2;
                    changed = true;
                    continue;
                }
            }
            merged.push(stack[i]);
            i += 1;
        }
        stack = merged;
    }
    stack
}

fn aggregate_v6(prefixes: &mut Vec<(u64, u64, u32)>) -> Vec<(u64, u64, u32)> {
    if prefixes.is_empty() { return vec![]; }
    prefixes.sort_by(|a, b| a.0.cmp(&b.0).then(a.1.cmp(&b.1)).then(a.2.cmp(&b.2)));

    // Remove contained
    let mut stack: Vec<(u64, u64, u32)> = Vec::new();
    for &(hi, lo, mask) in prefixes.iter() {
        if let Some(&(lh, ll, lm)) = stack.last() {
            let (mhi, mlo) = ipv6_mask(lm);
            if (lh & mhi) == (hi & mhi) && (ll & mlo) == (lo & mlo) && lm <= mask { continue; }
        }
        stack.push((hi, lo, mask));
    }

    let mut changed = true;
    while changed {
        changed = false;
        let mut merged: Vec<(u64, u64, u32)> = Vec::new();
        let mut i = 0;
        while i < stack.len() {
            if i + 1 < stack.len() && stack[i].2 == stack[i+1].2 && stack[i].2 > 0 {
                let bits = stack[i].2 - 1;
                let (mhi, mlo) = ipv6_mask(bits);
                if (stack[i].0 & mhi) == (stack[i+1].0 & mhi) && (stack[i].1 & mlo) == (stack[i+1].1 & mlo) {
                    merged.push((stack[i].0 & mhi, stack[i].1 & mlo, bits));
                    i += 2;
                    changed = true;
                    continue;
                }
