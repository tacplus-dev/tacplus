		target := fmt.Sprintf("%s:%d", ep.Host, ep.Port)
		incoming[target] = inst
	}

	// Build current target->endpointConn map
	current := make(map[string]*endpointConn, len(sc.endpoints))
	for _, ec := range sc.endpoints {
		current[ec.target] = ec
	}

	// Update existing, identify new and removed
	var kept []*endpointConn
	var toClose []*endpointConn

	now := time.Now()
	for _, ec := range sc.endpoints {
		if h, ok := incoming[ec.target]; ok {
			// Still present -- update health
			ec.updateHealth(h)
			kept = append(kept, ec)
		} else if ec.absent(now) {
			// Removed for the whole fleet window
			toClose = append(toClose, ec)
		} else {
			// Left out of this snapshot only; close once the fleet window passes
			kept = append(kept, ec)
		}
	}

	// Dial new endpoints
	var toAdd []*endpointConn
	for target, h := range incoming {
		if _, exists := current[target]; exists {
			continue
		}
		// Only dial routable instances
		if h.Status == StatusUnhealthy {
			continue
		}
		ec := newEndpointConn(target)
		ec.updateHealth(h)
