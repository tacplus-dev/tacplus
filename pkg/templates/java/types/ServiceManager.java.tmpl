    // that executes it (NEW-21).
    static boolean isPermanentIdentityInitError(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            // A missing spiffe_trust_domain is a permanent misconfiguration: mesh
            // channels are fail-closed and cannot pin identity without it, so fail
            // FAST here rather than retry it ~30 times / ~13 min. Classified by
            // TYPE, not by message-substring matching (NEW-21).
            if (cur instanceof ServiceConnection.MissingTrustDomainException) {
                return true;
            }
            // A build with no token exchanger can never mint a service token, so
            // the identity chassis refuses at construction. Same rule: classified
            // by TYPE, not by message-substring matching (NEW-21 leg b).
            if (cur instanceof IdentityManager.TokenMinterNotConfiguredException) {
                return true;
            }
            // A workload the token authority revoked (or whose bootstrap token it
            // refused) cannot renew: retrying the identity init can never succeed.
            if (cur instanceof IdentityManager.WorkloadRevokedException) {
                return true;
            }
{{- if .HasAutoTls}}
            // A handler that refuses a valid first certificate will refuse its
            // successor too — the rejection is local and deterministic. Without
            // this clause the whole ServiceManager init is retried MAX_INIT_RETRIES
            // times with backoff, masking a permanent misconfiguration as a
            // transient one. Same rule, same NEW-21 shape: classified by TYPE.
            if (cur instanceof FatalTlsHandlerException) {
                return true;
            }
{{- end}}
        }
        return false;
    }

