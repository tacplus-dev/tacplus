// writeKeyDescriptor emits a <md:KeyDescriptor> element with the certificate's DER bytes.
// use should be "signing" or "encryption".
func writeKeyDescriptor(buf *strings.Builder, use string, cert *wrapperX509.ImmutableCert) {
	certDER := base64.StdEncoding.EncodeToString(cert.X509Certificate().Raw)
	buf.WriteString(`<md:KeyDescriptor use="` + use + `">`)
	buf.WriteString(`<ds:KeyInfo xmlns:ds="` + nsXMLDSig + `">`)
	buf.WriteString(`<ds:X509Data>`)
	buf.WriteString(`<ds:X509Certificate>`)
	buf.WriteString(certDER)
	buf.WriteString(`</ds:X509Certificate>`)
	buf.WriteString(`</ds:X509Data>`)
	buf.WriteString(`</ds:KeyInfo>`)
	buf.WriteString(`</md:KeyDescriptor>`)
}

// parseCertFromKeyDescs extracts the first signing (or any) X.509 certificate
// from a slice of KeyDescriptor elements, as found in EntityDescriptor metadata.
func parseCertFromKeyDescs(descs []xmlKeyDesc) (*wrapperX509.ImmutableCert, error) {
	// Prefer use="signing"; fall back to use="" or use="encryption"
	var fallback string
	for _, kd := range descs {
		certDERB64 := strings.TrimSpace(kd.KeyInfo.X509Data.X509Certificate)
		if certDERB64 == "" {
			continue
		}
		if kd.Use == "signing" || kd.Use == "" {
			return certFromDERBase64(certDERB64)
		}
		if fallback == "" {
			fallback = certDERB64
		}
	}
	if fallback != "" {
		return certFromDERBase64(fallback)
	}
	return nil, fmt.Errorf("no x509 certificate found in key descriptors")
}

// certFromDERBase64 parses a base64-encoded DER certificate (as embedded in SAML metadata)
// and returns an ImmutableCert.
func certFromDERBase64(derB64 string) (*wrapperX509.ImmutableCert, error) {
	// SAML metadata embeds DER bytes as standard base64 (not PEM).
	// ImmutableCert expects a base64url-encoded PEM block.
	// We convert: DER → PEM → base64url(PEM).
	derBytes, err := base64.StdEncoding.DecodeString(derB64)
	if err != nil {
		return nil, fmt.Errorf("failed to base64-decode certificate: %w", err)
	}

	// Wrap DER bytes in a PEM block
	pemStr := "-----BEGIN CERTIFICATE-----\n"
	encoded := base64.StdEncoding.EncodeToString(derBytes)
	for i := 0; i < len(encoded); i += 64 {
		end := i + 64
		if end > len(encoded) {
			end = len(encoded)
		}
		pemStr += encoded[i:end] + "\n"
	}
	pemStr += "-----END CERTIFICATE-----\n"

	// ImmutableCert expects base64url of the PEM block (same encoding as NewX509Cert helper)
	pemBase64URL := base64.RawURLEncoding.EncodeToString([]byte(pemStr))

	return wrapperX509.NewImmutableX509Cert(&protoX509.X509Cert{
		Base64: pemBase64URL,
	})
}
