// ChannelProvider implements grpc.ClientConnInterface by delegating to a
// ServiceConnection's active endpoint. This allows generated clients to be
// constructed before the connection has any endpoints -- calls will fail with
// an error until healthy instances are discovered.
type ChannelProvider struct {
	conn      *ServiceConnection
	tenants   *TenantConnection
	static    grpc.ClientConnInterface
	serviceID string
}

// NewChannelProvider creates a ChannelProvider backed by a ServiceConnection.
func NewChannelProvider(conn *ServiceConnection) *ChannelProvider {
	return &ChannelProvider{conn: conn}
}

// NewTenantChannelProvider creates a ChannelProvider for a tenant-routed
// target: each call goes to the instance of the tenant its context carries
// (WithRouteTenant, set by the generated typed client from the request's
// route field). A call whose context carries no tenant is refused rather than
// sent to any instance.
func NewTenantChannelProvider(tenants *TenantConnection) *ChannelProvider {
	return &ChannelProvider{tenants: tenants}
}

// NewStaticChannelProvider creates a ChannelProvider backed by one fixed gRPC
// connection. Client-only managers use this for C2S and C2D surfaces where the
// caller already chose the connection endpoint.
func NewStaticChannelProvider(serviceID string, conn grpc.ClientConnInterface) *ChannelProvider {
	return &ChannelProvider{static: conn, serviceID: serviceID}
}

func (cp *ChannelProvider) serviceIDForError() string {
	if cp.conn != nil {
		return cp.conn.ServiceID()
	}
	if cp.tenants != nil {
		return cp.tenants.ServiceID()
	}
	if cp.serviceID != "" {
		return cp.serviceID
	}
	return "unknown"
}

func (cp *ChannelProvider) currentConn(ctx context.Context) (grpc.ClientConnInterface, error) {
	if cp.static != nil {
		return cp.static, nil
	}
	if cp.tenants != nil {
		tid, ok := RouteTenantFromContext(ctx)
		if !ok {
			return nil, protoerrors.NewErrGeneral(nil,
				"service %q is tenant-routed and the call names no target tenant; use the generated typed client, which routes by the request's route field", cp.serviceIDForError())
		}
		c := cp.tenants.Conn(tid)
		if c == nil {
			return nil, protoerrors.NewErrUnavailable(nil,
				"service %q: no healthy endpoint of tenant %q available", cp.serviceIDForError(), tid)
		}
		return c, nil
	}
	if cp.conn == nil {
		return nil, fmt.Errorf("service %q: no gRPC connection configured", cp.serviceIDForError())
	}
	c := cp.conn.Conn()
	if c == nil {
		return nil, fmt.Errorf("service %q: no healthy endpoints available", cp.serviceIDForError())
	}
	return c, nil
}

// Invoke implements grpc.ClientConnInterface.
func (cp *ChannelProvider) Invoke(ctx context.Context, method string, args, reply interface{}, opts ...grpc.CallOption) error {
	c, err := cp.currentConn(ctx)
	if err != nil {
		return err
	}
	return c.Invoke(ctx, method, args, reply, opts...)
}

// NewStream implements grpc.ClientConnInterface.
func (cp *ChannelProvider) NewStream(ctx context.Context, desc *grpc.StreamDesc, method string, opts ...grpc.CallOption) (grpc.ClientStream, error) {
	c, err := cp.currentConn(ctx)
	if err != nil {
		return nil, err
	}
	return c.NewStream(ctx, desc, method, opts...)
}
