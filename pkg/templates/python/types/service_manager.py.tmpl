    async def _smb_cert_stream_loop(self, handler: Handler, ready: asyncio.Event) -> None:
        """Manages the bidi SMB member-cert stream, retrying on disconnection."""
        attempt = 0
        while True:
            try:
                await self._run_smb_cert_stream(handler, ready)
                return
            except asyncio.CancelledError:
                raise
            except _FirstSmbCertDeliveryError:
                # Cross-language policy: a handler failure on the FIRST member-cert
                # delivery is fatal — startup must fail, not retry.
                raise
            except Exception as e:
                if not ready.is_set():
                    # First member cert never delivered — retry with backoff.
                    attempt += 1
                    if attempt >= self._MAX_INIT_RETRIES:
                        raise
                    delay = min(2 ** min(attempt, 5), 30)
                    logger.warning("SMB cert stream failed before first cert (attempt %d/%d), retrying in %ds: %s",
                                   attempt, self._MAX_INIT_RETRIES, delay, e)
                    await asyncio.sleep(delay)
                else:
                    logger.warning("SMB cert stream disconnected, retrying in 5s: %s", e)
                    await asyncio.sleep(5)

    async def _run_smb_cert_stream(self, handler: Handler, ready: asyncio.Event) -> None:
{{- if eq .AutoTlsKeyType "ecdsa"}}
        from cryptography.hazmat.primitives.asymmetric import ec
{{- else}}
        from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
{{- end}}
        from cryptography.hazmat.primitives.serialization import (
            Encoding, PublicFormat, PrivateFormat, NoEncryption,
        )

        from {{.PythonPackageBase}}.types.sys.smbcert import smbcert_pb2
        from {{.PythonPackageBase}}.types.sys.smbcert import smbcert_pb2_grpc
        from {{.PythonPackageBase}}.types.sys.key import key_pb2

        # Generate the member keypair locally; the private key never leaves this
        # process — only the public key is submitted in the CSR.
{{- if eq .AutoTlsKeyType "ecdsa"}}
        key = ec.generate_private_key(ec.SECP256R1())
{{- else}}
        key = Ed25519PrivateKey.generate()
{{- end}}
        private_key_der = key.private_bytes(Encoding.DER, PrivateFormat.PKCS8, NoEncryption())
        pub_proto = self._build_public_key_proto(key, key_pb2)

        conn = self.conn()
        if conn is None:
            raise RuntimeError("no connection for SMB member-cert stream")

        stub = smbcert_pb2_grpc.SmbCertServiceStub(conn)

        # Build outbound message queue.
        outbound: asyncio.Queue[smbcert_pb2.SmbCertClientMsg] = asyncio.Queue()

        # Send Init.
        hostname = socket.gethostname()
        await outbound.put(smbcert_pb2.SmbCertClientMsg(
            init=smbcert_pb2.SmbCertInit(
                smb_service="{{.ServiceLabel}}",
                instance_id=hostname,
            ),
        ))

        # Send initial Csr (public key only).
        await outbound.put(smbcert_pb2.SmbCertClientMsg(
            csr=smbcert_pb2.SmbCertCsr(public_key=pub_proto),
        ))

        async def request_iterator():
            while True:
                msg = await outbound.get()
                yield msg

        token = await self.get_token()
        metadata = [("authorization", f"Bearer {token}")]
        response_stream = stub.ManageSmbCert(request_iterator(), metadata=metadata)

        async for server_msg in response_stream:
            if server_msg.HasField("cert"):
                # member_chain is the signed member cert under the per-SMB CA;
                # ca is the per-SMB CA trust anchor; private_key_der is the
                # locally-generated member private key (never sent upstream).
                try:
                    await handler.new_smb_cert(
                        server_msg.cert.member_chain,
                        private_key_der,
                        server_msg.cert.ca,
                    )
                except Exception as e:
                    if not ready.is_set():
                        # First delivery: the instance cannot join its black-box
                        # peer mesh without a usable credential — fail startup
                        # (fatal, no retry).
                        raise _FirstSmbCertDeliveryError(
                            f"handler new_smb_cert failed on first member-cert delivery: {e}"
                        ) from e
                    # Renewal delivery: keep using the previous credential.
                    logger.error("Handler new_smb_cert failed on renewal: %s", e)
                else:
                    if not ready.is_set():
                        ready.set()
            elif server_msg.HasField("renew"):
                logger.info("SMB member cert renewal requested: %s", server_msg.renew.reason)
{{- if eq .AutoTlsKeyType "ecdsa"}}
                key = ec.generate_private_key(ec.SECP256R1())
{{- else}}
                key = Ed25519PrivateKey.generate()
{{- end}}
                private_key_der = key.private_bytes(
                    Encoding.DER, PrivateFormat.PKCS8, NoEncryption())
                pub_proto = self._build_public_key_proto(key, key_pb2)
                await outbound.put(smbcert_pb2.SmbCertClientMsg(
                    csr=smbcert_pb2.SmbCertCsr(public_key=pub_proto),
                ))
            elif server_msg.HasField("error"):
                raise RuntimeError(f"server error: {server_msg.error}")
{{- end}}

