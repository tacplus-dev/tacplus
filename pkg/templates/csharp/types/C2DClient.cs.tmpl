using System;
using Grpc.Net.Client;

namespace {{.PackageName}};

/// <summary>
/// Client-to-daemon (C2D) gRPC entry point: dials the local daemon over a
/// Windows named pipe, then exposes a typed client per C2D service.
///
/// This is the Windows named-pipe client implementation. It deliberately has
/// no unix-domain-socket transport: the unix-socket clients are a separate
/// implementation in the full-language targets, not a fallback here.
/// </summary>
public sealed class C2DClient : IDisposable
{
    /// <summary>The named pipe this client dials.</summary>
    public string PipeName { get; }

    private readonly GrpcChannel _channel;
{{if .DefaultPipeName}}
    /// <summary>
    /// Creates a C2D client dialing <paramref name="pipeName"/>, or the default
    /// daemon pipe when null.
    /// </summary>
    public C2DClient(string? pipeName = null)
    {
        PipeName = pipeName ?? DefaultNamedPipeName();
{{- else}}
    /// <summary>
    /// Creates a C2D client dialing <paramref name="pipeName"/>. The services
    /// this client covers declare different socket paths, so there is no
    /// default pipe: pass the one of the daemon serving them.
    /// </summary>
    public C2DClient(string pipeName)
    {
        PipeName = pipeName;
{{- end}}

        if (string.IsNullOrEmpty(PipeName))
            throw new ArgumentException("C2DClient: pipeName must not be null or empty", nameof(pipeName));

        _channel = GrpcChannel.ForAddress(
            "http://localhost",
            new GrpcChannelOptions { HttpHandler = NamedPipesConnectionFactory.Create(PipeName) });
    }
{{- if .DefaultPipeName}}

    /// <summary>
    /// The default daemon named pipe: the one the generated Go and Rust
    /// daemons serve on Windows for the services' socket_path,
    /// <c>\\.\pipe\tacplus-c2d-</c> + socket_path with every character
    /// outside <c>[A-Za-z0-9._-]</c> mapped to <c>-</c>.
    /// </summary>
    public static string DefaultNamedPipeName() => @"{{.DefaultPipeName}}";
{{- end}}
{{range .Services}}
    /// <summary>Typed gRPC client for the {{.ClientType}} service.</summary>
    public {{.ClientType}} {{.MethodName}}() => new {{.ClientType}}(_channel);
{{end}}
    /// <summary>Disposes the underlying gRPC channel.</summary>
    public void Dispose() => _channel.Dispose();
}
