// Reusable grpcserver components
//
// This package provides a gRPC server with TLS and graceful shutdown.
// Authorization is handled by the Authorizer (see authorizer.go), which is
// injected into the generated service wrapper by the service_manager.
//
// TLS certificates are provided by the servicemanager (auto-obtained via
// X509Mint at startup). Config holds network and request settings.
// REST and static file serving are handled by a separate gateway.

package grpcserver

import (
	"context"
	"crypto"
	"crypto/tls"
	"fmt"
	"net"
	"sync"

	pb "{{.ModuleBasePath}}/types/sys/grpcconfig"
	x509_pb "{{.ModuleBasePath}}/types/sys/x509"
	x509wrapper "{{.ModuleBasePath}}/chassis/x509"
	"{{.ModuleBasePath}}/chassis/logger"
	protoerrors "{{.ModuleBasePath}}/types/sys/errors"
	"go.uber.org/zap"
	"time"

	"google.golang.org/grpc"
	"google.golang.org/grpc/credentials"
	"google.golang.org/grpc/health"
	healthpb "google.golang.org/grpc/health/grpc_health_v1"
	"google.golang.org/grpc/keepalive"
)

// ServiceImplementation is the interface that generated server code must implement.
// It provides the method for registering gRPC services.
type ServiceImplementation interface {
	RegisterServices(grpcServer *grpc.Server) error
}

// GrpcServer manages the gRPC server lifecycle including TLS and graceful
// shutdown. Authorization is managed externally by the service_manager, which
// injects the authorizer into the generated wrapper before creating the server.
type GrpcServer struct {
	config       *pb.Config
	impl         ServiceImplementation
	conn         grpc.ClientConnInterface
	ctx          context.Context
	tlsCert      *x509_pb.X509CertChain
	tlsKey       crypto.PrivateKey
	healthServer *health.Server

	// Optional live cert providers (SetCertProvider): when set, Listen resolves
	// the serving certificate PER HANDSHAKE via tls.Config.GetCertificate, so
	// ManageCert renewals hot-reload without a restart (PC-L-10; parity with
	// java's X509ExtendedKeyManager and rust's reloading cert resolver).
	getChain func() *x509_pb.X509CertChain
	getKey   func() crypto.PrivateKey
}

// SetCertProvider installs live certificate providers. Call before Listen.
// The providers are read on every TLS handshake; the built tls.Certificate is
// cached by chain pointer identity, so steady-state handshakes stay cheap and
// a renewed chain (new pointer) triggers exactly one rebuild.
func (ps *GrpcServer) SetCertProvider(getChain func() *x509_pb.X509CertChain, getKey func() crypto.PrivateKey) {
	ps.getChain = getChain
	ps.getKey = getKey
}

// buildTLSCertificate assembles a tls.Certificate from an X509CertChain
// (Chain[0] leaf, Chain[1:] intermediates) and its private key.
func buildTLSCertificate(chain *x509_pb.X509CertChain, key crypto.PrivateKey) (*tls.Certificate, error) {
	if chain == nil || len(chain.Chain) == 0 {
		return nil, protoerrors.NewErrMissingInvalidData(nil, "X509CertChain must contain at least one certificate")
	}
	leafCert, err := x509wrapper.NewImmutableX509Cert(chain.Chain[0])
	if err != nil {
		return nil, protoerrors.NewErrGeneral(err, "failed to parse leaf certificate")
	}
	tlsCertObj := tls.Certificate{
		Certificate: [][]byte{leafCert.X509Certificate().Raw},
		PrivateKey:  key,
	}
	for _, chainCert := range chain.Chain[1:] {
		immChain, err := x509wrapper.NewImmutableX509Cert(chainCert)
		if err != nil {
			return nil, protoerrors.NewErrGeneral(err, "failed to parse chain certificate")
		}
		tlsCertObj.Certificate = append(tlsCertObj.Certificate, immChain.X509Certificate().Raw)
	}
	return &tlsCertObj, nil
}

// New creates a new GrpcServer from a Config.
// tlsCert and tlsKey are required — Listen() will fail if either is nil.
//
// Authorization is managed externally — the caller sets up the authorizer and
// injects it into the wrapper before calling New.
//
// After creating the server, call Listen() to start it.
func New(ctx context.Context, config *pb.Config, conn grpc.ClientConnInterface,
	tlsCert *x509_pb.X509CertChain, tlsKey crypto.PrivateKey,
	impl ServiceImplementation) (*GrpcServer, error) {
	if impl == nil {
		return nil, protoerrors.NewErrMissingInvalidData(nil, "ServiceImplementation is required")
	}
	if config == nil {
		return nil, protoerrors.NewErrMissingInvalidData(nil, "config cannot be nil")
	}

	// Install logger from config.
	if config.Logger != nil {
		if _, err := logger.InstallFromConfig(config.Logger); err != nil {
			zap.L().Error("Failed to install logger", zap.Error(err))
		}
	}

	// The gRPC health endpoint starts NOT_SERVING and is flipped to SERVING by
	// SetReady once the service_manager finishes bootstrap (TLS cert, SMB cert,
	// first health publish). This makes k8s readiness reflect actual readiness —
	// the same _ready gate the Python/TS service managers use — rather than
	// reporting SERVING the instant the port binds.
	healthServer := health.NewServer()
	healthServer.SetServingStatus("", healthpb.HealthCheckResponse_NOT_SERVING)

	return &GrpcServer{
		config:       config,
		impl:         impl,
		conn:         conn,
		ctx:          ctx,
		tlsCert:      tlsCert,
		tlsKey:       tlsKey,
		healthServer: healthServer,
	}, nil
}

// SetReady flips the gRPC health status (grpc.health.v1, service "") between
// SERVING and NOT_SERVING. The service_manager calls SetReady(true) after
// bootstrap completes so readiness probes only pass once the service can serve.
func (ps *GrpcServer) SetReady(ready bool) {
	if ps.healthServer == nil {
		return
	}
	status := healthpb.HealthCheckResponse_NOT_SERVING
	if ready {
		status = healthpb.HealthCheckResponse_SERVING
	}
	ps.healthServer.SetServingStatus("", status)
}

// Listen starts the gRPC server and blocks until the context is cancelled.
// TLS is required — the server refuses to start if no cert was provided.
//
// The caller is responsible for signal handling (e.g., signal.NotifyContext).
func (ps *GrpcServer) Listen(ctx context.Context) error {
	if ps.tlsCert == nil || ps.tlsKey == nil {
		return protoerrors.NewErrMissingInvalidData(nil, "TLS certificate and key are required — plaintext gRPC is not permitted")
	}

	listenAddr := ":8443"
	if ps.config.GetListenAddress() != nil {
		listenAddr = fmt.Sprintf("%s:%d", ps.config.GetListenAddress().Host, ps.config.GetListenAddress().Port)
	}

	var listener net.Listener
	var opts []grpc.ServerOption

	{
		// Fail-fast: the initial certificate must build before Listen proceeds.
		initialCert, err := buildTLSCertificate(ps.tlsCert, ps.tlsKey)
		if err != nil {
			return err
		}

		// Resolve the serving certificate per handshake so ManageCert renewals
		// hot-reload without restart (PC-L-10). The built certificate is cached by
		// chain pointer; a provider error keeps serving the last good cert rather
		// than failing handshakes (renewal problems are surfaced by the cert
		// stream's own logging).
		var certMu sync.Mutex
		cachedChain := ps.tlsCert
		cachedCert := initialCert
		tlsConfig := &tls.Config{
			GetCertificate: func(*tls.ClientHelloInfo) (*tls.Certificate, error) {
				certMu.Lock()
				defer certMu.Unlock()
				if ps.getChain == nil || ps.getKey == nil {
					return cachedCert, nil
				}
				chain := ps.getChain()
				if chain == nil || chain == cachedChain {
					return cachedCert, nil
				}
				rebuilt, err := buildTLSCertificate(chain, ps.getKey())
				if err != nil {
					zap.L().Error("failed to build renewed TLS serving certificate; keeping previous cert", zap.Error(err))
					return cachedCert, nil
				}
				cachedChain = chain
				cachedCert = rebuilt
				zap.L().Info("TLS serving certificate hot-reloaded")
				return cachedCert, nil
			},
			NextProtos: []string{"h2"},
			MinVersion: tls.VersionTLS12,
		}

		opts = append(opts, grpc.Creds(credentials.NewTLS(tlsConfig)))
	}

	{
		lis, err := net.Listen("tcp", listenAddr)
		if err != nil {
			return protoerrors.NewErrGeneral(err, "failed to listen on %s", listenAddr)
		}
		listener = lis
	}
	defer listener.Close()

	if ps.config.MaxRequestSize > 0 {
		opts = append(opts, grpc.MaxRecvMsgSize(int(ps.config.MaxRequestSize)))
	}

	// Resource limits from config (defaults set via ConfigDefaults)
	if ps.config.MaxSendMsgSize > 0 {
		opts = append(opts, grpc.MaxSendMsgSize(int(ps.config.MaxSendMsgSize)))
	}
	if ps.config.MaxConcurrentStreams > 0 {
		opts = append(opts, grpc.MaxConcurrentStreams(uint32(ps.config.MaxConcurrentStreams)))
	}

	// Keepalive enforcement: permit client pings at intervals ≥ keepaliveMinTime.
	// Always enforced — without an explicit policy grpc-go defaults to 5 minutes,
	// which rejects clients pinging every {{.KeepaliveTimeSecs}}s with GOAWAY too_many_pings.
	// PermitWithoutStream=true allows pings when there are no active streams,
	// which is exactly the idle-subscriber case (partition hides in silence otherwise).
	// Value from keepaliveconst; config override is accepted if stricter.
	keepaliveMinTime := time.Duration({{.KeepalivePermitMinTimeSecs}}) * time.Second
	if ps.config.KeepaliveMinTimeSeconds > 0 {
		keepaliveMinTime = time.Duration(ps.config.KeepaliveMinTimeSeconds) * time.Second
	}
	opts = append(opts, grpc.KeepaliveEnforcementPolicy(keepalive.EnforcementPolicy{
		MinTime:             keepaliveMinTime,
		PermitWithoutStream: true,
	}))

	grpcServer := grpc.NewServer(opts...)
	if err := ps.impl.RegisterServices(grpcServer); err != nil {
		return fmt.Errorf("failed to register services: %w", err)
	}

	// Register gRPC health check service (unauthenticated, standard grpc.health.v1).
	// Status stays NOT_SERVING (set in New) until the service_manager calls
	// SetReady(true) after bootstrap completes.
	healthpb.RegisterHealthServer(grpcServer, ps.healthServer)

	zap.L().Info("gRPC server starting",
		zap.String("address", listenAddr),
		zap.Bool("tls", true))

	// Graceful shutdown on context cancellation
	go func() {
		<-ctx.Done()
		// Report NOT_SERVING first so k8s stops routing to this instance before
		// in-flight RPCs are drained.
		ps.healthServer.Shutdown()
		shutdownTimeout := time.Duration(ps.config.ShutdownTimeoutSeconds) * time.Second
		if shutdownTimeout <= 0 {
			shutdownTimeout = 30 * time.Second
		}
		zap.L().Info("Shutting down gRPC server", zap.Duration("timeout", shutdownTimeout))
		gracefulStopWithTimeout(grpcServer, shutdownTimeout)
	}()

	return grpcServer.Serve(listener)
}

func gracefulStopWithTimeout(grpcServer *grpc.Server, timeout time.Duration) {
	done := make(chan struct{})
	go func() {
		grpcServer.GracefulStop()
		close(done)
	}()

	timer := time.NewTimer(timeout)
	defer timer.Stop()

	select {
	case <-done:
		zap.L().Info("gRPC server graceful shutdown complete")
	case <-timer.C:
		zap.L().Warn("gRPC graceful shutdown timed out, forcing stop")
		grpcServer.Stop()
	}
}

// NewHealthOnly creates a GrpcServer that serves only the grpc.health.v1
// endpoint. Used by services that have no business RPCs but still need a
// health-probeable listener. Like any GrpcServer it starts NOT_SERVING; the
// caller flips it via SetReady once bootstrap completes.
func NewHealthOnly(ctx context.Context, config *pb.Config,
	tlsCert *x509_pb.X509CertChain, tlsKey crypto.PrivateKey) (*GrpcServer, error) {
	return New(ctx, config, nil, tlsCert, tlsKey, &healthOnlyImpl{})
}

// ListenHealthOnly starts a TLS gRPC server that serves only the
// grpc.health.v1 endpoint. Used by services that have no business RPCs
// but still need a health-probeable listener.
func ListenHealthOnly(ctx context.Context, config *pb.Config,
	tlsCert *x509_pb.X509CertChain, tlsKey crypto.PrivateKey) error {
	srv, err := NewHealthOnly(ctx, config, tlsCert, tlsKey)
	if err != nil {
		return err
	}
	return srv.Listen(ctx)
}

type healthOnlyImpl struct{}

func (healthOnlyImpl) RegisterServices(_ *grpc.Server) error { return nil }
