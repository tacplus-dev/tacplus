    /// Builds a cache entry from a minted token's JWT and payload claims,
    /// with a proactive-refresh point at 50% of TTL.
    fn token_entry(jwt: &str, payload: &HashMap<String, String>) -> TokenEntry {
        let exp_secs: u64 = payload.get("exp")
            .and_then(|v| v.parse().ok())
            .unwrap_or(0);
        let now_secs = SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or_default().as_secs();
        let ttl_secs = if exp_secs > now_secs { exp_secs - now_secs } else { 3600 };

        let now = SystemTime::now();
        let ttl = Duration::from_secs(ttl_secs);
        let half_ttl_secs = ((ttl_secs as f64) * REFRESH_RATIO) as u64;
        let refresh_offset_secs = if ttl_secs <= MIN_REFRESH_BUFFER_SECS {
            0
        } else {
            half_ttl_secs.min(ttl_secs - MIN_REFRESH_BUFFER_SECS)
        };
        let refresh_offset = Duration::from_secs(refresh_offset_secs);

        TokenEntry {
            token: jwt.to_string(),
            expires_at: now + ttl,
            refresh_at: now + refresh_offset,
        }
    }
