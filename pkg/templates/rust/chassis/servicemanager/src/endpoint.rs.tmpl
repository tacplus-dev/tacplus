        let t0 = Instant::now();
        let mut r = up(t0);
        assert!(!r.absent(t0 + 5 * S), "one missed snapshot keeps the peer");
        assert!(!r.absent(t0 + 29 * S));
        assert!(r.absent(t0 + 30 * S), "absent for the whole window closes it");
