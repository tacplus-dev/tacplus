    fn caller_tenant_is_the_tid_claim_only() {
        assert_eq!(caller_tenant(Some("aaaaaaaa")).as_deref(), Some("aaaaaaaa"));
        assert_eq!(caller_tenant(None), None);
        for bad in ["", "ACME0001", "acme", "/tenants/aaaaaaaa", "aaaaaaaaa", "aaaaaaa"] {
            assert_eq!(caller_tenant(Some(bad)), None, "{bad:?}");
        }
