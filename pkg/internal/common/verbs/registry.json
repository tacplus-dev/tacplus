      "pattern": "ACTION",
      "access": "WRITE",
      "class": "action",
      "capability": "WRITE",
      "retry": "IDEMPOTENCY_REQUIRED",
      "definition": "Take exclusive hold of a named lock, returning a fencing token.",
      "boundary": "NOT Create; a hold is not durable resource state the caller owns, and it may legitimately not be granted \u2014 a refused Acquire returns granted=false, not an error. NOT Mint; the token is an index into server-held state, not a self-contained credential.",
      "audit": "Mutual-exclusion hold taken."
    },
    {
