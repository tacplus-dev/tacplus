target := fmt.Sprintf("%s:%d", ep.Host, ep.Port)
zap.L().Info("Resolved service endpoint via health entries",
zap.String("service", serviceName),
zap.String("endpoint", target))
return sm.sc.CreateChannel(target)
}
}
}
zap.L().Warn("No healthy instance found for service, retrying",
zap.String("service", serviceName),
zap.Duration("retry_in", backoff))
} else {
if sm.ctx.Err() != nil {
return nil, sm.ctx.Err()
}
zap.L().Warn("Failed to query ServiceHealthState, retrying",
zap.String("service", serviceName),
zap.Error(err),
zap.Duration("retry_in", backoff))
}
select {
case <-time.After(serviceconnection.JitterReconnectBackoff(backoff)):
case <-sm.ctx.Done():
return nil, sm.ctx.Err()
case <-ctx.Done():
return nil, fmt.Errorf("service %q not available: %w", serviceName, ctx.Err())
}
backoff = serviceconnection.NextReconnectBackoff(backoff)
}
}

// driveReadiness owns the gRPC health endpoint (k8s readiness) once bootstrap
// is done.
//
// SERVING requires both: the last effective health status was not UNHEALTHY
// (healthOK, fed by the HealthReporter status sink), and every required s2s
// channel is up — each event-bus subscription channel (streams){{if .S2STargetsRequired}} and each
// explicitly declared s2s target{{end}}. Reporting Ready while those channels were still
// being dialed put pods in rotation that could not do their job for minutes
// after a peer restart.
//
// Only readiness is gated. The status published to ServiceHealthState is not:
// peers resolve each other through it, so gating it on dependencies would
// deadlock any two services that depend on each other.
func (sm *ServiceManager) driveReadiness(ctx context.Context, healthCtl *grpcserver.GrpcServer, healthOK *atomic.Bool, streams []serviceconnection.RequiredStream) {
const readinessCheckInterval = time.Second
required := serviceconnection.NewRequiredChannels([]*serviceconnection.ServiceConnection{
{{- if .S2STargetsRequired}}
{{- range .S2STargetServices}}
sm.s2sConnections["{{.}}"],
{{- end}}
{{- end}}
}, streams)
ticker := time.NewTicker(readinessCheckInterval)
defer ticker.Stop()
var serving *bool
for {
down, isDown := required.FirstDown()
ready := healthOK.Load() && !isDown
if serving == nil || *serving != ready {
state := ready
serving = &state
switch {
case ready:
zap.L().Info("readiness: SERVING")
case isDown:
zap.L().Warn("readiness: NOT_SERVING, required s2s channel is down", zap.String("channel", down))
default:
zap.L().Warn("readiness: NOT_SERVING, health status is UNHEALTHY")
}
healthCtl.SetReady(ready)
}
select {
case <-ticker.C:
case <-ctx.Done():
return
}
}
}

