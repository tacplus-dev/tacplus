// A token whose seeded JWK belongs to a different key (signature will not verify)
// is rejected — the CA-only/blind-trust hole. The forged JWK reuses the real
// key's kid but carries a different public key.
func TestAuthorizerRejectsTamperedSignature(t *testing.T) {
	realKey := newTestKey(t)
	wrongKey := newTestKey(t)

	// Build a JWK under the REAL kid but with the WRONG public key.
	wrongPub := wrongKey.PublicKey().(ed25519.PublicKey)
	forged, err := wrapperJwk.NewImmutableJwk(&jwkpb.Jwk{
		Kid: realKey.Proto().Id,
		Kty: keypb.KeyType_KEY_TYPE_OKP,
		Crv: "Ed25519",
		X:   libBase64.RawURLEncoding.EncodeToString(wrongPub),
	})
	if err != nil {
		t.Fatalf("NewImmutableJwk: %v", err)
	}
	a := authorizerWithKeys(t, forged)
	a.SetMethodAuth(testMethodKey, []string{"caller-svc"})

	tok := signedToken(t, realKey, serviceToken("caller-svc"))
	if err := a.Authorize(bearerCtx(tok), testMethod, nil); err == nil {
		t.Fatal("token verified against a mismatched public key must be rejected")
	}
}

