        // Create token provider for authenticated outgoing gRPC calls.
        let tp: TokenProvider = {
            let im = identity.clone();
            Arc::new(move || {
                let im = im.clone();
                Box::pin(async move {
                    im.get_token().await.map_err(|e| -> Box<dyn std::error::Error + Send + Sync> {
                        e.to_string().into()
