fn open_disk_store_logs(cfg: &Config) -> Result<Option<Arc<DiskStoreLogs>>, Box<dyn std::error::Error>> {
    let Some(persistence) = cfg.disk_persistence.as_ref() else {
        return Ok(None);
    };
    if persistence.dir.is_empty() {
        return Err("grpcconfig.disk_persistence.dir is required when disk_persistence is set".into());
    }
    let base = PathBuf::from(&persistence.dir);
    let archive_count = if persistence.archive_count > 0 {
        persistence.archive_count
    } else {
        3
    };
    let codec = diskstore::Codec::from_proto_i32(persistence.compression);

    Ok(Some(Arc::new(DiskStoreLogs {
{{- range .DiskStores}}
        {{.LogField}}: Arc::new(diskstore_stores::open_{{.StoreName}}_log(
            &base,
            diskstore::ROOT_TENANT,
            archive_count,
            codec,
        )?),
{{- end}}
    })))
}
