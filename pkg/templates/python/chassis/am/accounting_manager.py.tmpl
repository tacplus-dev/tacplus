def capture_error_context(skip: int = 0, should_capture_stack: bool = False) -> Dict[str, str]:
    """Builds an ErrorContext from the current call site.

    Uses inspect.stack() to capture caller file:line and function name.
    Full stack trace only when should_capture_stack is True.
    """
    ec: Dict[str, str] = {"caller": "", "function": "", "stack_trace": ""}

    stack = inspect.stack()
    frame_idx = skip + 1
    if frame_idx < len(stack):
        frame = stack[frame_idx]
        ec["caller"] = f"{frame.filename}:{frame.lineno}"
        ec["function"] = frame.function

    if should_capture_stack:
        ec["stack_trace"] = "".join(traceback.format_stack())

    return ec


def should_capture_stack(code: grpc.StatusCode) -> bool:
    """Returns True for gRPC codes that indicate our bugs
    (INTERNAL, UNKNOWN, DATA_LOSS). Returns False for user errors.
