{{- end}}

        public {{.ClassName}}(HttpClient httpClient, String baseUrl, Supplier<String> tokenProvider) {
{{- range .Clients}}
            this.{{.FieldName}} = new {{.TypeRef}}(httpClient, baseUrl, tokenProvider);
{{- end}}
        }

{{- range .Clients}}
        public {{.TypeRef}} {{.MethodName}}() {
            return this.{{.FieldName}};
        }

{{- end}}
    }

{{- end}}
}
