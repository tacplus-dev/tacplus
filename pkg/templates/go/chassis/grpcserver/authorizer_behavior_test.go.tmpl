// delegatedServiceToken is a service caller that is ALSO acting on another
// principal's behalf: the same token the auth_services tests mint, plus an act
// claim naming the delegate.
func delegatedServiceToken(caller, act string) func(*tokenlib.TokenWrapper) {
	return func(tok *tokenlib.TokenWrapper) {
		tok.SetSubType("service").SetSubject(caller).SetAct(act)
	}
}

