// Parse{{.EnumName}}s converts a comma-separated string to a slice of {{.EnumName}} enum values
// Returns an error if any value is invalid
func Parse{{.EnumName}}s(s string) ([]{{.EnumName}}, error) {
if s == "" {
return nil, nil
}
parts := strings.Split(s, ",")
result := make([]{{.EnumName}}, 0, len(parts))
for _, part := range parts {
trimmed := strings.TrimSpace(part)
if trimmed == "" {
continue
}
val, err := Parse{{.EnumName}}(trimmed)
if err != nil {
return nil, err
}
result = append(result, val)
}
return result, nil
}

