/**
 * Behavioral security tests: verify that credentials never reach a log sink,
 * regardless of log level, logger source, or configuration.
 *
 * <p>Tests exercise real log paths (SLF4J → Logback → encoder → output) and
 * assert that emitted output contains neither the token nor the raw header
 * value. These are NOT config-checking tests — they capture actual output.
 */
public class LogbackConfiguratorSecurityTest {
    private static int failures = 0;

    private static void mustPass(String label, boolean ok) {
        if (!ok) {
            System.err.println("FAIL: " + label);
            failures++;
        } else {
            System.out.println("PASS: " + label);
        }
    }

    public static void main(String[] args) {
        String fakeToken = "eyJraWQiOiIzOTE2YTM1My1iODY3LTQ1ZTQtODk2ZS1mMDhkZjBhYjcxNDYi";

        // ── Test 1: CredentialRedactor.redact() unit tests ──

        mustPass("redact bearer token",
            !CredentialRedactor.redact("authorization: Bearer " + fakeToken).contains(fakeToken));
        mustPass("redact preserves key",
            CredentialRedactor.redact("authorization: Bearer " + fakeToken).contains("authorization"));
        mustPass("redact adds marker",
            CredentialRedactor.redact("authorization: Bearer " + fakeToken).contains("[REDACTED]"));
        mustPass("redact case insensitive (Authorization)",
            !CredentialRedactor.redact("Authorization: Bearer " + fakeToken).contains(fakeToken));
        mustPass("redact case insensitive (AUTHORIZATION)",
            !CredentialRedactor.redact("AUTHORIZATION: Bearer " + fakeToken).contains(fakeToken));
        mustPass("redact basic auth",
            !CredentialRedactor.redact("authorization: Basic " + fakeToken).contains(fakeToken));
        mustPass("redact cookie",
            !CredentialRedactor.redact("cookie: session=" + fakeToken).contains(fakeToken));
        mustPass("redact set-cookie",
            !CredentialRedactor.redact("Set-Cookie: session=" + fakeToken).contains(fakeToken));
        mustPass("redact x-auth-token",
            !CredentialRedactor.redact("x-auth-token: " + fakeToken).contains(fakeToken));
        mustPass("redact client-secret",
            !CredentialRedactor.redact("client-secret: " + fakeToken).contains(fakeToken));
        mustPass("redact access_token",
            !CredentialRedactor.redact("access_token: " + fakeToken).contains(fakeToken));
        mustPass("redact standalone Bearer",
            !CredentialRedactor.redact("Value: Bearer " + fakeToken).contains(fakeToken));
        // JSON structured-field shape. RedactingEncoder runs on already-encoded
        // output, so in JSON mode it sees `"x-auth-token":"abc"` and not
        // `x-auth-token: abc`. Every check above uses the header/text shape, which
        // is why a structured field carrying a bare credential (no "Bearer "
        // prefix) was emitted verbatim while this suite stayed green.
        mustPass("redact JSON field with bare token",
            !CredentialRedactor.redact("{\"msg\":\"bound\",\"x-auth-token\":\"" + fakeToken + "\"}").contains(fakeToken));
        mustPass("redact JSON field preserves key",
            CredentialRedactor.redact("{\"x-auth-token\":\"" + fakeToken + "\"}").contains("x-auth-token"));
        // A credential must not swallow the fields that follow it. The value
        // patterns originally ran to the next whitespace, and compact JSON has
        // none, so one credential consumed the rest of the line.
        mustPass("redact JSON does not eat following fields",
            CredentialRedactor.redact("{\"authorization\":\"Bearer " + fakeToken + "\",\"peer\":\"10.0.0.1\"}").contains("10.0.0.1"));
        mustPass("redact JSON does not truncate the line",
            CredentialRedactor.redact("{\"authorization\":\"Bearer " + fakeToken + "\",\"peer\":\"10.0.0.1\"}").endsWith("}"));

        mustPass("preserves non-sensitive",
            CredentialRedactor.redact("user logged in OK").equals("user logged in OK"));
        mustPass("null returns null",
            CredentialRedactor.redact(null) == null);

        // ── Test 2: Real log path through LogbackConfigurator ──
        // Redirect stderr to capture the actual encoder output.

        ByteArrayOutputStream captured = new ByteArrayOutputStream();
        PrintStream originalErr = System.err;
        System.setErr(new PrintStream(captured, true, StandardCharsets.UTF_8));

