mod tests {
    use super::*;

    #[test]
    fn struct_json_is_the_object_it_holds_with_sorted_keys() {
        let json = r#"{"b":[1.5,"x",true,null],"a":{"n":-2},"c":null}"#;
        let s: Struct = serde_json::from_str(json).unwrap();
        assert_eq!(s.fields["a"], Value::from(HashMap::from([("n".to_string(), Value::from(-2.0))])));
        assert_eq!(
            s.fields["b"],
            Value::from(vec![Value::from(1.5), Value::from("x"), Value::from(true), Value::null()])
        );
        assert_eq!(s.fields["c"], Value::null());
        assert_eq!(
            serde_json::to_string(&s).unwrap(),
            r#"{"a":{"n":-2.0},"b":[1.5,"x",true,null],"c":null}"#
        );
        assert!(serde_json::from_str::<Struct>("[1]").is_err());
        assert!(serde_json::from_str::<ListValue>("{}").is_err());
    }

    #[test]
    fn an_empty_value_is_null() {
        assert_eq!(serde_json::to_string(&Value::default()).unwrap(), "null");
        assert_eq!(serde_json::from_str::<Value>("null").unwrap(), Value::null());
    }

    #[test]
    fn values_convert_to_their_kind_only() {
        assert_eq!(String::try_from(Value::from("x")).unwrap(), "x");
        assert_eq!(f64::try_from(Value::from(2.0)).unwrap(), 2.0);
        assert!(bool::try_from(Value::from("true")).is_err());
        assert!(Vec::<Value>::try_from(Value::default()).is_err());
    }

    #[test]
    fn the_wire_is_google_protobuf() {
        use prost::Message;
        let s: Struct = serde_json::from_str(r#"{"k":["v",1]}"#).unwrap();
        let theirs = prost_types::Struct::decode(s.encode_to_vec().as_slice()).unwrap();
        assert_eq!(theirs.encode_to_vec(), s.encode_to_vec());
        assert_eq!(<Struct as prost::Name>::type_url(), "type.googleapis.com/google.protobuf.Struct");
