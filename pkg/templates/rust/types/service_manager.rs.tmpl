	{{- end}}

{{- if .HasSysState}}
        // Fetch runtime config from ServiceConfigState and apply runtime fields.
        {
            use crate::types::sys::grpcconfig::service_config_state_service_client::ServiceConfigStateServiceClient;
            let scs_conn = state_store_conn.conn().await
                .ok_or("no active connection for ServiceConfigState")?;
            let scs_token = identity.get_token().await
                .map_err(|e| format!("token for ServiceConfigState: {}", e))?;
            let mut scs_client = ServiceConfigStateServiceClient::new(scs_conn);
            let mut scs_req = tonic::Request::new(crate::types::sys::trace::TraceRequest::default());
            scs_req.metadata_mut().insert(
                "authorization",
                format!("Bearer {}", scs_token).parse()
                    .map_err(|_| -> Box<dyn std::error::Error> { "invalid token metadata".into() })?,
            );
            match scs_client.get_config(scs_req).await {
                Ok(response) => {
                    let runtime = response.into_inner();
                    if cfg.spiffe_trust_domain.is_empty() && !runtime.spiffe_trust_domain.is_empty() {
                        cfg.spiffe_trust_domain = runtime.spiffe_trust_domain;
                    }
                    if cfg.location_path.is_empty() && !runtime.location_path.is_empty() {
                        cfg.location_path = runtime.location_path;
                    }
                    if cfg.listen_address.is_none() && runtime.listen_address.is_some() {
                        cfg.listen_address = runtime.listen_address;
                    }
                    tracing::info!("Applied runtime config from ServiceConfigState");
                }
                Err(e) => {
                    tracing::warn!(error = %e, "Failed to fetch ServiceConfigState — using boot config only");
                }
            }
        }
	{{- end}}

{{- if .HasDiskStores}}
        let disk_store_logs = open_disk_store_logs(&cfg)?;
{{- end}}

        info!(
            service = "{{.ServiceLabel}}",
            tacplus_version = "{{.TacplusVersion}}",
            tacplus_sha = "{{.TacplusGitSha}}",
            proto_version = "{{.ProtoSourceVersion}}",
            proto_sha = "{{.ProtoSourceGitSha}}",
            "ServiceManager initialized",
        );

{{- if .HasAutoTls}}
        // Auto-TLS: start the cert stream BEFORE returning from new() so that
        // sm.tls_cert_chain_der() / sm.tls_private_key_der() are populated by the
        // time the service body runs. The handler slot is filled later in run().
        let tls_cert_chain_der_arc: Arc<tokio::sync::RwLock<Option<Vec<Vec<u8>>>>> = Arc::new(tokio::sync::RwLock::new(None));
        let tls_private_key_der_arc: Arc<tokio::sync::RwLock<Option<Vec<u8>>>> = Arc::new(tokio::sync::RwLock::new(None));
        let tls_cert_chain_proto_arc: Arc<tokio::sync::RwLock<Option<x509_pb::X509CertChain>>> = Arc::new(tokio::sync::RwLock::new(None));
        let tls_cert_chain_pem_arc: Arc<tokio::sync::RwLock<Option<String>>> = Arc::new(tokio::sync::RwLock::new(None));
        let tls_private_key_pem_arc: Arc<tokio::sync::RwLock<Option<String>>> = Arc::new(tokio::sync::RwLock::new(None));
        let tls_handler_slot_arc: Arc<tokio::sync::RwLock<Option<Arc<dyn Handler>>>> = Arc::new(tokio::sync::RwLock::new(None));
        let tls_server_certified_key_arc: Arc<std::sync::RwLock<Option<Arc<CertifiedKey>>>> = Arc::new(std::sync::RwLock::new(None));
        {
            let (tls_ready_tx, tls_ready_rx) = tokio::sync::oneshot::channel::<Result<(), String>>();
            let tls_conn = state_store_conn.clone();
            let tls_tp: TokenProvider = {
                let im = identity.clone();
                Arc::new(move || {
                    let im = im.clone();
                    Box::pin(async move {
                        im.get_token().await.map_err(|e| -> Box<dyn std::error::Error + Send + Sync> { e.to_string().into() })
                    })
                })
            };
            let service_label = "{{.ServiceLabel}}".to_string();
            let instance_id = identity.instance_id().to_string();
            let cert_der_store = tls_cert_chain_der_arc.clone();
            let key_der_store = tls_private_key_der_arc.clone();
            let cert_proto_store = tls_cert_chain_proto_arc.clone();
            let cert_pem_store = tls_cert_chain_pem_arc.clone();
            let key_pem_store = tls_private_key_pem_arc.clone();
            let handler_slot = tls_handler_slot_arc.clone();
            let server_certified_key_store = tls_server_certified_key_arc.clone();
            let tls_degrade_clone = tls_degrade.clone();
            let tls_handle = tokio::spawn(async move {
                tls_cert_stream_loop(
                    tls_conn, service_label, instance_id, handler_slot, tls_tp,
                    Some(tls_ready_tx), cert_der_store, key_der_store, cert_proto_store,
                    cert_pem_store, key_pem_store, server_certified_key_store, tls_degrade_clone,
                    MAX_INIT_RETRIES,
                ).await;
            });
            // The stream reports the OUTCOME of the first delivery, not just the
            // fact of it: a give-up before first delivery, or a handler that
            // rejects the first certificate, must name its cause here. Parity
            // with go (readyCh carries the error) and with smb_ready_rx below;
            // without it a misconfigured deployment only ever surfaces the
            // generic "did not deliver" text.
            match tls_ready_rx.await {
                Ok(Ok(())) => {}
                Ok(Err(e)) => return Err(format!("first TLS certificate delivery: {}", e).into()),
                Err(_) => return Err("auto-TLS cert stream failed to deliver initial certificate".into()),
            }
            tasks.lock().unwrap().push(tls_handle);
        }
{{- end}}

        Ok(Self {
            cfg,
            identity,
            state_store_conn,
            tls_config,
            tasks,
            tls_degrade,
            grpc_health,
{{- if .HasTlsGrpc}}
            authorizer,
{{- end}}
{{- if .HasStates}}
            state_clients,
{{- end}}
	{{- if .HasS2SClients}}
