def _extract_single_assertion(response_xml: str) -> str:
    a_start = response_xml.find("<saml:Assertion ")
    if a_start < 0:
        raise ValueError("no <saml:Assertion> in response")
    a_end_tag = "</saml:Assertion>"
    a_end = response_xml.find(a_end_tag, a_start)
    if a_end < 0:
        raise ValueError("no </saml:Assertion>")
    a_end += len(a_end_tag)
    if response_xml.find("<saml:Assertion ", a_end) >= 0:
        raise ValueError("SAML response contains multiple Assertion elements")
    return response_xml[a_start:a_end]


def _extract_for_verification(response_xml: str):
    assertion = _extract_single_assertion(response_xml)

    sig_start = assertion.find("<ds:Signature ")
    if sig_start < 0:
        raise ValueError("no <ds:Signature> in assertion")
    sig_end_tag = "</ds:Signature>"
    sig_end = assertion.find(sig_end_tag, sig_start)
    if sig_end < 0:
        raise ValueError("no </ds:Signature>")
    sig_xml = assertion[sig_start:sig_end + len(sig_end_tag)]
    unsigned = assertion[:sig_start] + assertion[sig_end + len(sig_end_tag):]

    digest_b64 = _text(sig_xml, "ds:DigestValue")
    if not digest_b64:
        raise ValueError("no DigestValue")
    raw_sig_b64 = _text(sig_xml, "ds:SignatureValue")
    if not raw_sig_b64:
        raise ValueError("no SignatureValue")

    assertion_id = _attr(assertion, "ID")
    if not assertion_id:
        raise ValueError("no ID on Assertion")
    signed_info_xml = _build_signed_info(assertion_id, digest_b64)

    return unsigned, digest_b64, signed_info_xml, raw_sig_b64


def _parse_saml_xml(xml: str) -> SamlAssertion:
    response_id   = _attr(xml, "ID") or ""
    in_resp_to    = _attr(xml, "InResponseTo") or ""
    issue_instant = _attr(xml, "IssueInstant") or ""

    sc_pos = xml.find("<samlp:StatusCode")
    status_code = (_attr(xml[sc_pos:], "Value") or "") if sc_pos >= 0 else ""

    axml = _extract_single_assertion(xml)

    id_ = _attr(axml, "ID") or ""
    issuer = _text(axml, "saml:Issuer") or ""
    subject_name_id = _text(axml, "saml:NameID") or ""

    nid_pos = axml.find("<saml:NameID")
    name_id_format = (_attr(axml[nid_pos:], "Format") or "") if nid_pos >= 0 else ""

    scd_pos = axml.find("<saml:SubjectConfirmationData")
    subject_recipient = ""
    subject_noa = ""
    if scd_pos >= 0:
        subject_recipient = _attr(axml[scd_pos:], "Recipient") or ""
        subject_noa = _attr(axml[scd_pos:], "NotOnOrAfter") or ""

    cond_pos = axml.find("<saml:Conditions")
    not_before = ""
    not_on_or_after = ""
    if cond_pos >= 0:
        not_before = _attr(axml[cond_pos:], "NotBefore") or ""
        not_on_or_after = _attr(axml[cond_pos:], "NotOnOrAfter") or ""

    audiences = _all_text(axml, "saml:Audience")

    as_pos = axml.find("<saml:AuthnStatement")
    authn_instant = ""
    session_index = ""
    if as_pos >= 0:
        authn_instant = _attr(axml[as_pos:], "AuthnInstant") or ""
        session_index = _attr(axml[as_pos:], "SessionIndex") or ""
    authn_context = _text(axml, "saml:AuthnContextClassRef") or ""

    attributes: Dict[str, str] = {}
    attr_pat = re.compile(r'<saml:Attribute\s+[^>]*Name="([^"]*)"[^>]*>'
                          r'.*?<saml:AttributeValue[^>]*>([^<]*)</saml:AttributeValue>', re.DOTALL)
    for m in attr_pat.finditer(axml):
        attributes[m.group(1)] = m.group(2)

    return SamlAssertion(
        response_id=response_id,
        in_response_to=in_resp_to,
        status_code=status_code,
        status_message="",
        id=id_,
        issue_instant=issue_instant,
        issuer=issuer,
        subject_name_id=subject_name_id,
        name_id_format=name_id_format,
        subject_recipient=subject_recipient,
        subject_not_on_or_after=subject_noa,
        not_before=not_before,
        not_on_or_after=not_on_or_after,
        audiences=audiences,
        authn_instant=authn_instant,
        authn_context=authn_context,
        session_index=session_index,
        attributes=attributes,
        xml=xml,
    )
