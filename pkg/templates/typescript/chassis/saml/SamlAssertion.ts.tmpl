function extractForVerification(responseXml: string): {
  unsigned: string; digestB64: string; signedInfoXml: string; rawSigB64: string;
} {
  const assertion = extractSingleAssertion(responseXml);

  const sigStart  = assertion.indexOf('<ds:Signature ');
  if (sigStart < 0) throw new Error('no <ds:Signature> in assertion');
  const sigEndTag = '</ds:Signature>';
  const sigEnd    = assertion.indexOf(sigEndTag, sigStart);
  if (sigEnd < 0) throw new Error('no </ds:Signature>');
  const sigXml  = assertion.substring(sigStart, sigEnd + sigEndTag.length);
  const unsigned = assertion.substring(0, sigStart) + assertion.substring(sigEnd + sigEndTag.length);

  const digestB64 = extractText(sigXml, 'ds:DigestValue');
  if (!digestB64) throw new Error('no DigestValue in signature');
  const rawSigB64 = extractText(sigXml, 'ds:SignatureValue');
  if (!rawSigB64) throw new Error('no SignatureValue in signature');

  const assertionId = extractAttr(assertion, 'ID');
  if (!assertionId) throw new Error('no ID on Assertion element');
  const signedInfoXml = buildSignedInfoXml(assertionId, digestB64);

  return { unsigned, digestB64, signedInfoXml, rawSigB64 };
}

function extractSingleAssertion(responseXml: string): string {
  const aStart = responseXml.indexOf('<saml:Assertion ');
  if (aStart < 0) throw new Error('no <saml:Assertion> in response');
  const aEndTag = '</saml:Assertion>';
  const aEnd    = responseXml.indexOf(aEndTag, aStart);
  if (aEnd < 0) throw new Error('no </saml:Assertion>');
  const assertionEnd = aEnd + aEndTag.length;
  if (responseXml.indexOf('<saml:Assertion ', assertionEnd) >= 0) {
    throw new Error('SAML response contains multiple Assertion elements');
  }
  return responseXml.substring(aStart, assertionEnd);
}

