[package]
name = "x509"
version = "0.1.0"
edition = "2021"
description = "X.509 certificate management"

[dependencies]
key = { path = "../key" }
# spiffe provides the canonical SPIFFE ID parser used by verify_service_name to
# match a service SAN by its parsed SubjectKind/SubjectPath (never ad-hoc string
# splitting). spiffe has no deps back into x509, so this is not a cycle.
spiffe = { path = "../spiffe" }
base64 = "0.22"
# "builder" pulls in the CertificateBuilder. The signer gives it its own
# profile (x509.rs ManualProfile), which adds none of x509-cert's opinionated
# extensions, so the exact cert shape (subject/issuer/KeyUsage/extensions)
# follows the request, for parity with the Go/Java signers. 0.3 is the digest
# 0.11 line: 0.2's builder locked block-buffer 0.10 (GHSA-qwgh-2vcv-g2f7, #215).
x509-cert = { version = "0.3", features = ["builder"] }
# der/spki/const-oid are re-exported by x509-cert but named directly here for
# the signer (SubjectPublicKeyInfoOwned, BitString, SerialNumber, custom OID).
der = "0.8"
spki = "0.8"
const-oid = "0.10"
ed25519-dalek = { version = "3", features = ["pkcs8"] }
signature = "3"
rand = "0.8"
pem = "3"
serde = { version = "1", features = ["derive"] }
rustls = { version = "0.23", default-features = false, features = ["ring", "std"] }

[dev-dependencies]
# Verifies the certificates the signer makes, for every key family (issue #186).
aws-lc-rs = "1"
