	switch subType := token.GetSubType(); subType {
	case "service", "workload":
		servicePath, err := token.ServicePath()
		if err != nil {
			return "", err
		}
		parts := strings.Split(servicePath, "/"+wrapperSpiffe.WorkloadsSegment+"/")
		id, err := wrapperSpiffe.ServiceSpiffeID(trustDomain, "", parts[0])
		if err != nil {
			return "", err
		}
		for _, child := range parts[1:] {
			if id, err = wrapperSpiffe.WorkloadSpiffeID(id, child); err != nil {
				return "", err
			}
		}
		return id, nil
	case "user":
		ns, err := token.NamespacePath()
		if err != nil {
			return "", err
		}
		return wrapperSpiffe.UserSpiffeID(trustDomain, ns, token.GetSubject())
	case "client":
		ns, err := token.NamespacePath()
		if err != nil {
			return "", err
		}
		return wrapperSpiffe.ClientSpiffeID(trustDomain, ns, token.GetSubject())
	default:
		return "", protoerrors.NewErrUnauthorized(nil, "cannot derive subject identity for sub_type %q", subType)
	}
}

