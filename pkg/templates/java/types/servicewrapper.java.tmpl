{{- if .HasAccounting}}

    /** Sets the accounting emitter for this service wrapper. */
    public void setEmitter(AccountingManager.Emitter emitter) {
        this.emitter = emitter;
    }

    private void emitRpcCompleted(AccountingMethod accountingMethod, long startTime,
            java.util.Map<String, String> callerIdentity, String requestId) {
        AccountingManager.Emitter em = this.emitter;
        if (em == null) {
            return;
        }
        long durationMs = System.currentTimeMillis() - startTime;
        em.rpcCompleted(accountingMethod, durationMs, callerIdentity, requestId);
    }

    private void emitRpcError(AccountingMethod accountingMethod, Throwable t, long startTime,
            java.util.Map<String, String> callerIdentity, String requestId) {
        AccountingManager.Emitter em = this.emitter;
        if (em == null) {
            return;
        }
        long durationMs = System.currentTimeMillis() - startTime;
        io.grpc.Status.Code code = AccountingManager.grpcCodeFromError(t);
        em.rpcError(accountingMethod, code.value(), t.getMessage(), durationMs,
                AccountingManager.errorContextFromError(t, AccountingManager.shouldCaptureStack(code)),
                callerIdentity, requestId);
    }

    private <T> StreamObserver<T> accountingResponseObserver(
            StreamObserver<T> delegate,
            AccountingMethod accountingMethod,
            long startTime,
            java.util.Map<String, String> callerIdentity,
            String requestId,
            java.util.concurrent.atomic.AtomicBoolean accounted) {
        java.util.concurrent.atomic.AtomicBoolean closed = new java.util.concurrent.atomic.AtomicBoolean(false);
        return new StreamObserver<T>() {
            @Override
            public void onNext(T value) {
                delegate.onNext(value);
            }

            @Override
            public void onError(Throwable t) {
                if (closed.compareAndSet(false, true)) {
                    if (accounted.compareAndSet(false, true)) {
                        emitRpcError(accountingMethod, t, startTime, callerIdentity, requestId);
                    }
                    delegate.onError(t);
                }
            }

            @Override
            public void onCompleted() {
                if (closed.compareAndSet(false, true)) {
                    if (accounted.compareAndSet(false, true)) {
                        emitRpcCompleted(accountingMethod, startTime, callerIdentity, requestId);
                    }
                    delegate.onCompleted();
                }
            }
        };
    }

    private <T> StreamObserver<T> accountingRequestObserver(
            StreamObserver<T> delegate,
            AccountingMethod accountingMethod,
            long startTime,
            java.util.Map<String, String> callerIdentity,
            String requestId,
            java.util.concurrent.atomic.AtomicBoolean accounted) {
        java.util.concurrent.atomic.AtomicBoolean closed = new java.util.concurrent.atomic.AtomicBoolean(false);
        return new StreamObserver<T>() {
            @Override
            public void onNext(T value) {
                if (closed.get()) {
                    return;
                }
                try {
                    delegate.onNext(value);
                } catch (Throwable t) {
                    if (accounted.compareAndSet(false, true)) {
                        emitRpcError(accountingMethod, t, startTime, callerIdentity, requestId);
                    }
                    throw t;
                }
            }

            @Override
            public void onError(Throwable t) {
                if (closed.compareAndSet(false, true)) {
                    if (accounted.compareAndSet(false, true)) {
                        emitRpcError(accountingMethod, t, startTime, callerIdentity, requestId);
                    }
                    delegate.onError(t);
                }
            }

            @Override
            public void onCompleted() {
                if (!closed.get()) {
                    delegate.onCompleted();
                }
            }
        };
    }
