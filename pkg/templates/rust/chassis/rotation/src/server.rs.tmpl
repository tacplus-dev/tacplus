            id,
            plain,
            subject,
            sessions: Arc::downgrade(sessions),
            first: Mutex::new(None),
            send: tokio::sync::Mutex::new(None),
            pending: Mutex::new(Pending::default()),
            legs: Mutex::new(Vec::new()),
            request_abort: Mutex::new(None),
            done: AtomicBool::new(false),
            cancel: CancellationToken::new(),
        })
    }

    fn first_request(&self) -> Option<Bytes> {
        self.first.lock().unwrap().clone()
    }

    fn is_done(&self) -> bool {
        self.done.load(Ordering::SeqCst)
    }

    fn track(&self, leg: &Arc<LegState>) {
        let mut legs = self.legs.lock().unwrap();
        legs.retain(|l| !l.ended.load(Ordering::SeqCst));
        legs.push(leg.clone());
    }

    /// Runs the handler on the session's first leg: one logical request to the
    /// plain service, with the opening leg's metadata (its token) and
    /// extensions (its connection), whose body the legs feed.
    fn start<S>(
        self: &Arc<Self>,
        tx: LegTx,
        rx: LegRx,
        metadata: tonic::metadata::MetadataMap,
        extensions: tonic::Extensions,
        plain: S,
    ) where
        S: PlainService,
        <S as Service<http::Request<tonic::body::Body>>>::Future: Send + 'static,
    {
        self.track(&tx.state);
        *self.send.try_lock().expect("a new session's send leg is free") = Some(tx);
        let (items_tx, items_rx) = mpsc::channel(LEG_BUFFER);
        let (abort_tx, abort_rx) = oneshot::channel();
        *self.request_abort.lock().unwrap() = Some(abort_tx);
        let body = tonic::codec::EncodeBody::new_client(RawCodec, Abortable::new(items_rx, abort_rx), None, None);
        let mut req = http::Request::new(tonic::body::Body::new(body));
        *req.method_mut() = http::Method::POST;
        *req.version_mut() = http::Version::HTTP_2;
        match http::Uri::try_from(self.plain.as_str()) {
            Ok(uri) => *req.uri_mut() = uri,
            Err(_) => {
                self.fault("the method is not a path", Code::Internal);
                return;
            }
        }
        let mut headers = metadata.into_headers();
        // The logical request is not compressed, whatever the leg was.
        headers.remove("grpc-encoding");
        headers.remove("grpc-accept-encoding");
        headers.insert(http::header::CONTENT_TYPE, tonic::metadata::GRPC_CONTENT_TYPE);
        headers.insert(http::header::TE, http::HeaderValue::from_static("trailers"));
        *req.headers_mut() = headers;
        *req.extensions_mut() = extensions;

        tokio::spawn(self.clone().read(rx, items_tx));
        let s = self.clone();
        tokio::spawn(async move {
            // A fault cancels the session: dropping this future drops the
            // handler's future and its response stream.
            let cancel = s.cancel.clone();
            tokio::select! {
                _ = cancel.cancelled() => {}
                _ = s.clone().run(plain, req) => {}
            }
        });
    }

    /// The handler's call: its messages to the send leg, its status to end the
    /// logical stream.
    async fn run<S>(self: Arc<Self>, mut plain: S, req: http::Request<tonic::body::Body>)
    where
        S: PlainService,
        <S as Service<http::Request<tonic::body::Body>>>::Future: Send + 'static,
    {
        if std::future::poll_fn(|cx| plain.poll_ready(cx)).await.is_err() {
            self.end(Err(Status::unavailable("the service is not ready"))).await;
            return;
        }
        let response = match plain.call(req).await {
            Ok(response) => response,
            Err(never) => match never {},
        };
        if let Some(status) = Status::from_header_map(response.headers()) {
            // A trailers-only response: the handler's status, no messages.
            let result = if status.code() == Code::Ok { Ok(()) } else { Err(status) };
            self.end(result).await;
            return;
        }
        let status_code = response.status();
        let mut messages =
            tonic::Streaming::new_response(RawCodec, response.into_body(), status_code, None, Some(usize::MAX));
        loop {
            match messages.message().await {
                Ok(Some(payload)) => {
                    if !self.send_envelope(Envelope { payload: payload.to_vec(), ..Default::default() }).await {
                        return;
                    }
                }
                Ok(None) => {
                    self.end(Ok(())).await;
                    return;
                }
                Err(status) => {
                    self.end(Err(status)).await;
                    return;
                }
            }
        }
    }

    /// Sends one of the handler's messages on the send leg; false when the
    /// session is over.
    async fn send_envelope(&self, e: Envelope) -> bool {
        let guard = tokio::select! {
            _ = self.cancel.cancelled() => return false,
            g = self.send.lock() => g,
        };
        let Some(leg) = guard.as_ref() else { return false };
        let sent = tokio::select! {
            _ = self.cancel.cancelled() => return false,
            r = leg.send(Ok(e)) => r,
        };
        if sent.is_err() {
            drop(guard);
            self.fault("the leg ended under the sender", Code::Cancelled);
            return false;
        }
        true
    }

    /// The read leg's envelopes to the handler's request stream, leg by leg.
    async fn read(self: Arc<Self>, mut leg: LegRx, items: mpsc::Sender<Result<Bytes, Status>>) {
        let mut items = Some(items);
        let mut fin_received = false;
        loop {
            let item = tokio::select! {
                _ = self.cancel.cancelled() => return,
                m = leg.stream.message() => m,
            };
            let e = match item {
                Ok(Some(e)) => e,
                Ok(None) => {
                    self.fault("a leg ended without last (OK)", Code::Cancelled);
                    return;
                }
                Err(status) => {
                    let code = match status.code() {
                        Code::Ok | Code::Unknown => Code::Cancelled,
                        code => code,
                    };
                    self.fault(&format!("a leg ended without last ({})", status.message()), code);
                    return;
                }
            };
            if malformed(&e) || (fin_received && is_message(&e)) {
                self.fault("malformed envelope", Code::InvalidArgument);
                return;
            }
            if is_message(&e) {
                let payload = Bytes::from(e.payload);
                {
                    let mut first = self.first.lock().unwrap();
                    if first.is_none() {
                        *first = Some(payload.clone());
                    }
                }
                if let Some(tx) = &items {
                    let sent = tokio::select! {
                        _ = self.cancel.cancelled() => return,
                        r = tx.send(Ok(payload)) => r,
                    };
                    if sent.is_err() {
                        // The handler no longer reads its requests.
                        items = None;
                    }
                }
            }
            if e.fin && !fin_received {
                // The client's half-close: the handler's request stream ends.
                fin_received = true;
                items = None;
            }
            if e.last {
                let next = self.pending.lock().unwrap().next.take();
                let Some(next) = next else {
                    self.fault("last with no leg to cut over to", Code::InvalidArgument);
                    return;
                };
                let old = std::mem::replace(&mut leg, next.rx);
                tokio::spawn(drain(old));
                if !self.cutover(next.tx).await {
                    return;
                }
                self.pending.lock().unwrap().rotating = false;
            }
        }
    }

    /// Moves the sends to `next`: last on the old leg, which then ends OK.
    async fn cutover(&self, next: LegTx) -> bool {
        let mut guard = tokio::select! {
            _ = self.cancel.cancelled() => return false,
            g = self.send.lock() => g,
        };
        self.track(&next.state);
        if let Some(mut old) = guard.replace(next) {
            let sent = tokio::select! {
                _ = self.cancel.cancelled() => return false,
                r = old.send(Ok(Envelope { last: true, ..Default::default() })) => r,
            };
            if sent.is_err() {
                drop(guard);
                self.fault("the old leg ended before its last", Code::Cancelled);
                return false;
            }
            old.finish();
        }
        true
    }

    /// The handler returned: its status ends the send leg; every other leg ends.
    async fn end(&self, result: Result<(), Status>) {
        if self.done.swap(true, Ordering::SeqCst) {
            return;
        }
        self.forget();
        let send = self.send.lock().await.take();
        let send_id = send.as_ref().map(|l| l.state.id);
        if let Some(mut leg) = send {
            match result {
                Ok(()) => leg.finish(),
                Err(status) => {
                    if matches!(status.code(), Code::Unauthenticated | Code::PermissionDenied) {
                        // The status goes out with no description; the reason stays here.
                        tracing::info!(method = %self.plain, reason = %status.message(), "rotation: stream refused");
                    }
                    let _ = leg.send(Err(wire_status(status))).await;
                    leg.finish();
                }
            }
        }
        for leg in self.legs.lock().unwrap().drain(..) {
            if Some(leg.id) != send_id {
                leg.abort(Code::Cancelled);
            }
        }
        if let Some(next) = self.pending.lock().unwrap().next.take() {
            next.rx.state.abort(Code::Cancelled);
        }
        self.cancel.cancel();
    }

