// ---- Parsing. ----

// ParsedSpiffeId is the structured form of a SPIFFE ID. Parsing is
// self-describing: no out-of-band prefix is supplied; the kind is recovered
// from typed tags.
export interface ParsedSpiffeId {
  scheme: string;
  trustDomain: string;
  pathSegments: string[];
  namespace: string;
  subjectKind: SubjectKind;
  // location-agnostic for service/workload; the leaf for user/client
  subjectPath: string;
  // for system/service/workload identities
  locationPath: string;
  resourceKind: string;
  resourceId: string;
}

function newParsed(): ParsedSpiffeId {
  return {
    scheme: '',
    trustDomain: '',
    pathSegments: [],
    namespace: '',
    subjectKind: SubjectKind.Unknown,
    subjectPath: '',
    locationPath: '',
    resourceKind: '',
    resourceId: '',
  };
}

// reconstruct rebuilds the canonical SPIFFE ID string from the parsed parts.
export function reconstruct(p: ParsedSpiffeId): string {
  if (p.pathSegments.length === 0) {
    return p.scheme + '://' + p.trustDomain;
  }
  return p.scheme + '://' + p.trustDomain + '/' + p.pathSegments.join('/');
}

// parseSpiffeId parses and validates a full SPIFFE ID, failing closed on
// malformed input.
export function parseSpiffeId(value: string): ParsedSpiffeId {
  const p = newParsed();
  const v = value.trim();
  const prefix = SCHEME + '://';
  if (!v.startsWith(prefix)) {
    throw new Error(`spiffe: missing "${prefix}" scheme: "${value}"`);
  }
  const rest = v.slice(prefix.length);
  rejectDangerous(rest);
  if (/[?#\\]/.test(rest)) {
    throw new Error(`spiffe: query, fragment, or backslash not allowed: "${value}"`);
  }
  let td = rest;
  let pathStr = '';
  const i = rest.indexOf('/');
  if (i >= 0) {
    td = rest.slice(0, i);
    pathStr = rest.slice(i + 1);
  }
  if (td === '') {
    throw new Error(`spiffe: empty trust domain: "${value}"`);
  }
  if (/[/\\?#]/.test(td)) {
    throw new Error(`spiffe: malformed trust domain: "${value}"`);
  }
  p.scheme = SCHEME;
  p.trustDomain = td;

  if (pathStr === '') {
    p.namespace = '/';
    return p;
  }
  const segs = pathStr.split('/');
  for (const s of segs) {
    if (s === '') {
      throw new Error(`spiffe: empty path segment in "${value}"`);
    }
    if (s === '.' || s === '..') {
      throw new Error(`spiffe: dot segment not allowed in "${value}"`);
    }
    if (!SEGMENT_RE.test(s)) {
      throw new Error(`spiffe: path segment "${s}" violates grammar in "${value}"`);
    }
  }
  p.pathSegments = segs;

  classify(p, segs);
  return p;
}

function classify(p: ParsedSpiffeId, segs: string[]): void {
  const idx = tagIndexes(segs);
  if (idx[WORKLOADS_SEGMENT] >= 0) {
    p.subjectKind = SubjectKind.Workload;
    classifySystem(p, segs);
    return;
  }
  if ((segs[0] === SYSTEM_SEGMENT || segs[0] === TENANTS_SEGMENT) && idx[SERVICES_SEGMENT] >= 0) {
    p.subjectKind = SubjectKind.Service;
    classifySystem(p, segs);
    return;
  }
  if (segs[0] === PEOPLE_SEGMENT && idx[USERS_SEGMENT] >= 0) {
    classifyPerson(p, segs);
    return;
  }
  if (idx[USERS_SEGMENT] >= 0) {
    classifyNamespaced(p, segs, idx[USERS_SEGMENT], SubjectKind.User);
    return;
  }
  if (idx[CLIENTS_SEGMENT] >= 0) {
    classifyNamespaced(p, segs, idx[CLIENTS_SEGMENT], SubjectKind.Client);
    return;
  }
  if (idx[CREDENTIALS_SEGMENT] >= 0) {
    classifyPair(p, segs, idx[CREDENTIALS_SEGMENT], SubjectKind.Unknown);
    return;
  }
  if (idx[DATA_SEGMENT] >= 0) {
    classifyPair(p, segs, idx[DATA_SEGMENT], SubjectKind.Resource);
    return;
  }
  // Namespace-only identity (tenant/workspace/system subtree).
  p.subjectKind = SubjectKind.Unknown;
  p.namespace = '/' + segs.join('/');
}

// Handles both service-root shapes: /system/<location...>/services/<svc> (shared
// services, location-agnostic) and /tenants/<tenant>/services/<svc> (tenant-owned
// services, one operator-managed instance per tenant). Namespace is everything
// before "services"; for the tenant root that's exactly "/tenants/<tenant>".
function classifySystem(p: ParsedSpiffeId, segs: string[]): void {
  const si = indexOf(segs, SERVICES_SEGMENT);
  if ((segs[0] !== SYSTEM_SEGMENT && segs[0] !== TENANTS_SEGMENT) || si < 0 || si + 1 >= segs.length) {
    throw new Error(`spiffe: malformed system/service identity: /${segs.join('/')}`);
  }
  p.locationPath = segs.slice(1, si).join('/');
  p.namespace = '/' + segs.slice(0, si).join('/'); // /system[/location...]
  p.subjectPath = segs.slice(si + 1).join('/'); // <service>[/workloads/<child>...]
}

// The person root: /people/<person>/users/<person>, the only identity shape rooted
// at "people". Deliberately tighter than the generic namespaced-user arm: the person
// id is repeated as the users leaf, and no location segments, no "services" branch,
// and no further suffix are accepted.
function classifyPerson(p: ParsedSpiffeId, segs: string[]): void {
  if (segs.length !== 4 || segs[2] !== USERS_SEGMENT || segs[1] !== segs[3]) {
    throw new Error(`spiffe: malformed person identity: /${segs.join('/')}`);
  }
  p.subjectKind = SubjectKind.User;
  p.namespace = '/' + PEOPLE_SEGMENT + '/' + segs[1];
  p.subjectPath = segs[3];
}

function classifyNamespaced(
  p: ParsedSpiffeId,
  segs: string[],
  tagIdx: number,
  kind: SubjectKind,
): void {
  if (tagIdx + 1 >= segs.length || tagIdx === 0) {
    throw new Error(`spiffe: malformed ${kind} identity: /${segs.join('/')}`);
  }
  p.subjectKind = kind;
  p.namespace = '/' + segs.slice(0, tagIdx).join('/');
  p.subjectPath = segs.slice(tagIdx + 1).join('/');
}

function classifyPair(
  p: ParsedSpiffeId,
  segs: string[],
  tagIdx: number,
  kind: SubjectKind,
): void {
  if (tagIdx === 0 || tagIdx + 2 >= segs.length) {
    throw new Error(`spiffe: malformed kind/id identity: /${segs.join('/')}`);
  }
  p.subjectKind = kind;
  p.namespace = '/' + segs.slice(0, tagIdx).join('/');
  p.resourceKind = segs[tagIdx + 1];
  p.resourceId = segs.slice(tagIdx + 2).join('/');
}

// parseNamespaceOrSpiffe accepts either a bare namespace path or a full SPIFFE
// URI and returns the normalized namespace path.
export function parseNamespaceOrSpiffe(value: string): string {
  const v = value.trim();
  if (v.startsWith(SCHEME + '://')) {
    const p = parseSpiffeId(v);
    return normalizeNamespace(p.namespace);
  }
  return normalizeNamespace(v);
}

// servicePathFromSpiffe returns the LOCATION-AGNOSTIC service identity: the bare
// service label plus any /workloads/<child> suffix, with /system/<location...>/
// stripped. So the same service matches identically across clouds/accounts/AZs/
// clusters in auth_services. (Location-scoped authz is deferred; see plan D2.)
export function servicePathFromSpiffe(spiffeId: string): string {
  const p = parseSpiffeId(spiffeId);
  if (
    p.subjectKind !== SubjectKind.Service &&
    p.subjectKind !== SubjectKind.Workload
  ) {
    throw new Error(`spiffe: not a service/workload identity: "${spiffeId}"`);
  }
  return p.subjectPath;
}

// namespaceFromSpiffe returns the normalized namespace of a SPIFFE ID.
export function namespaceFromSpiffe(spiffeId: string): string {
  const p = parseSpiffeId(spiffeId);
  return normalizeNamespace(p.namespace);
}

// ResourceParts is the (kind, id) of a resource SPIFFE ID.
export interface ResourceParts {
  namespace: string;
  kind: string;
  id: string;
}

// resourcePartsFromSpiffe extracts the resource parts from a resource SPIFFE ID.
export function resourcePartsFromSpiffe(spiffeId: string): ResourceParts {
  const p = parseSpiffeId(spiffeId);
  if (p.subjectKind !== SubjectKind.Resource) {
    throw new Error(`spiffe: not a resource identity: "${spiffeId}"`);
  }
  return { namespace: p.namespace, kind: p.resourceKind, id: p.resourceId };
}

// ---- Comparison. ----

// isAtOrBelow reports whether target is the same as caller or a strict
// path-segment descendant in the NAMESPACE (authorization) tree.
export function isAtOrBelow(callerNamespace: string, targetNamespace: string): boolean {
  const caller = trimNamespace(callerNamespace);
  const target = trimNamespace(targetNamespace);
  if (caller === '' || target === '') {
    return false;
  }
  if (caller === target) {
    return true;
  }
  if (caller === '/') {
    return target.startsWith('/');
  }
  return target.startsWith(caller + '/');
}

// isSpiffeAtOrBelow reports whether the target SPIFFE ID is the same as or a
// path-segment descendant of the caller SPIFFE ID. This is the IDENTITY-path
// relation and is distinct from isAtOrBelow; the two must not be cross-applied.
export function isSpiffeAtOrBelow(
  callerSpiffeId: string,
  targetSpiffeId: string,
): boolean {
  let c: ParsedSpiffeId;
  let t: ParsedSpiffeId;
  try {
    c = parseSpiffeId(callerSpiffeId);
  } catch {
    return false;
  }
  try {
    t = parseSpiffeId(targetSpiffeId);
  } catch {
    return false;
  }
  if (c.trustDomain !== t.trustDomain) {
    return false;
  }
  if (c.pathSegments.length > t.pathSegments.length) {
    return false;
  }
  for (let i = 0; i < c.pathSegments.length; i++) {
    if (c.pathSegments[i] !== t.pathSegments[i]) {
      return false;
    }
  }
  return true;
}

// sameTrustDomain reports whether two SPIFFE IDs share a trust domain.
export function sameTrustDomain(a: string, b: string): boolean {
  let pa: ParsedSpiffeId;
  let pb: ParsedSpiffeId;
  try {
    pa = parseSpiffeId(a);
  } catch {
    return false;
  }
  try {
    pb = parseSpiffeId(b);
  } catch {
    return false;
  }
  return pa.trustDomain === pb.trustDomain;
}

// ---- internal helpers ----

function rejectDangerous(s: string): void {
  const lower = s.toLowerCase();
  for (const enc of ['%2f', '%5c']) {
    if (lower.includes(enc)) {
      throw new Error(`spiffe: encoded separator "${enc}" not allowed: "${s}"`);
    }
  }
  for (const ch of s) {
    const code = ch.codePointAt(0)!;
    if (code < 0x20 || code === 0x7f) {
      throw new Error(`spiffe: control character not allowed: "${s}"`);
    }
  }
}

function splitPath(p: string): string[] {
  const trimmed = trimBoth(p.trim(), '/');
  if (trimmed === '') {
    return [];
  }
  return trimmed.split('/');
}

function trimNamespace(ns: string): string {
  let n = ns.trim();
  if (n === '') {
    return '';
  }
  if (!n.startsWith('/')) {
    n = '/' + n;
  }
  const trimmed = trimRight(n, '/');
  if (trimmed === '') {
    return '/';
  }
  return trimmed;
}

function tagIndexes(segs: string[]): Record<string, number> {
  const out: Record<string, number> = {
    [WORKLOADS_SEGMENT]: -1,
    [SERVICES_SEGMENT]: -1,
    [USERS_SEGMENT]: -1,
    [CLIENTS_SEGMENT]: -1,
    [CREDENTIALS_SEGMENT]: -1,
    [DATA_SEGMENT]: -1,
  };
  for (let i = 0; i < segs.length; i++) {
    const s = segs[i];
    if (Object.prototype.hasOwnProperty.call(out, s) && out[s] === -1) {
      out[s] = i;
    }
  }
  return out;
}

function indexOf(segs: string[], tag: string): number {
  for (let i = 0; i < segs.length; i++) {
    if (segs[i] === tag) {
      return i;
    }
  }
  return -1;
}

// trimRight removes all trailing occurrences of the cutset char from s.
function trimRight(s: string, cut: string): string {
  let end = s.length;
  while (end > 0 && cut.includes(s[end - 1])) {
    end--;
  }
  return s.slice(0, end);
}

// trimBoth removes leading and trailing occurrences of the cutset char from s.
function trimBoth(s: string, cut: string): string {
  let start = 0;
  let end = s.length;
  while (start < end && cut.includes(s[start])) {
    start++;
  }
  while (end > start && cut.includes(s[end - 1])) {
    end--;
  }
  return s.slice(start, end);
}
