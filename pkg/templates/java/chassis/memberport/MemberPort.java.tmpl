                closed = true;
                call.close(status, new Metadata());
                inbox.add(new End(status));
            }
        }
    }

    // ---- Byte sessions ----

    /**
     * One loopback connection's bytes over a sequence of streams. The pump
     * sends local bytes on the send leg; the reader takes the read leg's chunks
     * in order and moves to the next leg only past the read leg's {@code last}.
     */
    private abstract class Session {
        final Socket plain;
        final Object sendLock = new Object();
        final AtomicBoolean done = new AtomicBoolean();
        /** Guarded by sendLock. */
        Leg sendLeg;
        /** The leg after the read leg: set when a rotation attaches, before either side's last. */
        volatile Leg nextLeg;
        volatile Leg readLeg;
        volatile boolean finSent;
        volatile boolean finReceived;
        volatile String sessionId = "";
        private volatile Thread reader;

        Session(Socket plain) {
            this.plain = plain;
        }

        /** Starts moving bytes on {@code first}, both ways. */
        void start(Leg first) {
            synchronized (sendLock) {
                sendLeg = first;
            }
            readLeg = first;
            try {
                plain.setTcpNoDelay(true);
            } catch (SocketException e) {
                fault("socket options: " + describe(e), Status.CANCELLED);
                return;
            }
            sessions.add(this);
            if (closed.get()) {
                fault("member port closed", Status.UNAVAILABLE);
                return;
            }
            first.request();
            try {
                workers.execute(this::pump);
                workers.execute(this::read);
            } catch (RejectedExecutionException e) {
                fault("member port closed", Status.UNAVAILABLE);
            }
        }

        /** Local bytes to the send leg, waiting while it is not ready (backpressure). */
        private void pump() {
            byte[] buf = new byte[MAX_CHUNK_BYTES];
            try {
                InputStream local = plain.getInputStream();
                while (!done.get()) {
                    int n = local.read(buf);
                    if (n < 0) {
                        synchronized (sendLock) {
                            // Set first: the peer may answer the fin before send returns.
                            finSent = true;
                            sendLeg.send(MemberChunk.newBuilder().setFin(true).build());
                        }
                        finished();
                        return;
                    }
                    if (n > 0) {
                        MemberChunk chunk = MemberChunk.newBuilder().setPayload(ByteString.copyFrom(buf, 0, n)).build();
                        synchronized (sendLock) {
                            while (!done.get() && !sendLeg.isReady()) {
                                sendLock.wait(100);
                            }
                            sendLeg.send(chunk);
                        }
                    }
                }
            } catch (IOException e) {
                fault("local connection: " + describe(e), Status.CANCELLED);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                fault("interrupted", Status.CANCELLED);
            }
        }

        /** A leg became ready to send: wake the pump. */
        void ready() {
            synchronized (sendLock) {
                sendLock.notifyAll();
            }
        }

        /** The read leg's chunks to the local socket, leg by leg. */
        private void read() {
            reader = Thread.currentThread();
            try {
                OutputStream local = plain.getOutputStream();
                while (!done.get()) {
                    Leg leg = readLeg;
                    Object item = leg.inbox.take();
                    if (item instanceof End end) {
                        if (finSent && finReceived) {
                            ended(leg, end);
                        } else {
                            fault("stream ended without last (" + end.status.getCode() + ")", Status.CANCELLED);
                        }
                        return;
                    }
                    MemberChunk chunk = (MemberChunk) item;
                    if (chunk.getPayload().size() > MAX_CHUNK_BYTES
                            || (finReceived && !chunk.getPayload().isEmpty())
                            || !chunk.getSessionId().isEmpty()) {
                        fault("malformed chunk", Status.CANCELLED);
                        return;
                    }
                    if (!chunk.getPayload().isEmpty()) {
                        chunk.getPayload().writeTo(local);
                        local.flush();
                    }
                    if (chunk.getFin() && !finReceived) {
                        finReceived = true;
                        plain.shutdownOutput();
                        finished();
                    }
                    if (chunk.getLast()) {
                        Leg next = nextLeg;
                        if (next == null) {
                            fault("last with no stream to cut over to", Status.CANCELLED);
                            return;
                        }
                        readLeg = next;
                        nextLeg = null;
                        lastReceived(leg, next);
                        next.request();
                    } else {
                        leg.request();
                    }
                }
            } catch (IOException e) {
                fault("local connection: " + describe(e), Status.CANCELLED);
            } catch (InterruptedException e) {
                // fault() interrupts the reader; nothing more to do.
            }
        }

        /** Moves the sends to {@code next}: {@code last} on the old leg, which then ends. */
        void cutOver(Leg next) {
            synchronized (sendLock) {
                Leg old = sendLeg;
                old.send(MemberChunk.newBuilder().setLast(true).build());
                old.finish();
                cancel(old.expiry);
                sendLeg = next;
                sendLock.notifyAll();
            }
        }

        /** The read leg's last arrived; the reader moves to {@code next}. */
        abstract void lastReceived(Leg old, Leg next);

        /** Both directions sent their fin, or one did: the subclass ends the session when it may. */
        abstract void finished();

        /** The read leg ended after both directions' fin: a clean end. */
        void ended(Leg leg, End end) {
            if (!done.compareAndSet(false, true)) {
                return;
            }
            sessions.remove(this);
            forget();
            cancel(leg.expiry);
            leg.finish();
            Leg pending = nextLeg;
            if (pending != null) {
                cancel(pending.expiry);
                pending.abort(Status.CANCELLED);
            }
            closeQuietly(plain);
        }

        /** Drops the session: every stream ends, the local connection is reset. */
        void fault(String reason, Status status) {
            if (!done.compareAndSet(false, true)) {
                return;
            }
            sessions.remove(this);
            forget();
            LOG.info("member port: session " + sessionId + " dropped: " + reason);
            Leg s;
            synchronized (sendLock) {
                s = sendLeg;
                sendLock.notifyAll();
            }
            for (Leg leg : new Leg[] {s, readLeg, nextLeg}) {
                if (leg != null) {
                    cancel(leg.expiry);
                    leg.abort(status);
                }
            }
            reset(plain);
            Thread r = reader;
            if (r != null) {
                r.interrupt();
            }
        }

        /** Removes the session from what can still find it. */
        void forget() {}
    }

    /** The server side of a session: its first leg dialled {@code target}. */
    private final class InboundSession extends Session {
        final String subject;
        /** Guarded by this: a rotation attached and not yet cut over. */
        private boolean rotating;

        InboundSession(Socket plain, String subject) {
            super(plain);
            this.subject = subject;
        }

        /** Attaches a rotation's leg, when the session is live and has none pending. */
        synchronized boolean attach(ServerLeg leg) {
            if (done.get() || rotating || finSent && finReceived) {
                return false;
            }
            rotating = true;
            nextLeg = leg;
            // fault() sets done before it reads nextLeg: one of the two sees the other.
            if (done.get()) {
                detach(leg);
                return false;
            }
            return true;
        }

        /** A pending rotation's leg ended before its cutover: the session may take another. */
        synchronized void detach(Leg leg) {
            if (nextLeg == leg) {
                nextLeg = null;
                rotating = false;
            }
        }

        @Override
        void lastReceived(Leg old, Leg next) {
            // The client cut over: its last is the server's cue to cut over too.
            cutOver(next);
            synchronized (this) {
                rotating = false;
            }
        }

        @Override
        void finished() {
            // The server ends a session when the client half-closes after both fins.
        }

        @Override
        void forget() {
            inbound.remove(sessionId, this);
        }
    }

    /** The client side of a session: a local connection forwarded to {@code remote}. */
    private final class OutboundSession extends Session {
        final ManagedChannel channel;
        final InetSocketAddress remote;
        private final AtomicBoolean rotating = new AtomicBoolean();
        private volatile ScheduledFuture<?> rotation;

        OutboundSession(Socket plain, ManagedChannel channel, InetSocketAddress remote) {
            super(plain);
            this.channel = channel;
            this.remote = remote;
        }

        /** Opens the first stream; on any refusal, resets the local connection. */
        void open() {
            ClientLeg leg;
            try {
                leg = openLeg("");
            } catch (Exception e) {
                LOG.warning("member port: tunnel to " + remote + " refused: " + describe(e));
                reset(plain);
                return;
            }
            start(leg);
            if (!done.get()) {
                schedule(leg);
            }
        }

        /**
         * Opens a stream with the current token; an UNAUTHENTICATED refusal is
         * retried once with a fresh one, PERMISSION_DENIED never.
         */
        private ClientLeg openLeg(String joining) throws Exception {
            try {
                return openOnce(joining, tokenSource.token());
            } catch (RefusedStream e) {
                if (e.status.getCode() != Status.Code.UNAUTHENTICATED) {
                    throw e;
                }
                return openOnce(joining, tokenSource.token());
            }
        }

        /**
         * Opens one stream: its first chunk names the session it joins (empty
         * for a new one), and it is attached once the server's headers carry a
         * member token this side admits and its first chunk names the session.
         */
        private ClientLeg openOnce(String joining, String token) throws Exception {
            long expMillis = TokenWrapper.parse(token).getExpiration() * 1000L;
            ClientCall<MemberChunk, MemberChunk> call = channel.newCall(OPEN_METHOD,
                    CallOptions.DEFAULT.withDeadlineAfter(Math.max(1, expMillis - System.currentTimeMillis()), TimeUnit.MILLISECONDS));
            ClientLeg leg = new ClientLeg(call, expMillis);
            CompletableFuture<String> attached = new CompletableFuture<>();
            AtomicBoolean receiverAdmitted = new AtomicBoolean();
            Metadata headers = new Metadata();
            headers.put(AUTHORIZATION, "Bearer " + token);
            synchronized (leg) {
                call.start(new ClientCall.Listener<MemberChunk>() {
                    @Override
                    public void onHeaders(Metadata h) {
                        try {
                            verifyPeer(h.get(MEMBER_TOKEN));
                            receiverAdmitted.set(true);
                        } catch (RefusedException e) {
                            attached.completeExceptionally(new RefusedStream(Status.PERMISSION_DENIED,
                                    "the receiver's token: " + e.getMessage()));
                            leg.abort(Status.CANCELLED);
                        }
                    }

                    @Override
                    public void onMessage(MemberChunk chunk) {
                        if (attached.isDone()) {
                            leg.inbox.add(chunk);
                            return;
                        }
                        String id = chunk.getSessionId();
                        if (!receiverAdmitted.get() || id.isEmpty() || !(joining.isEmpty() || joining.equals(id))
                                || !chunk.getPayload().isEmpty() || chunk.getLast() || chunk.getFin()) {
                            attached.completeExceptionally(new RefusedStream(Status.PERMISSION_DENIED,
                                    "the receiver did not attach the stream"));
                            leg.abort(Status.CANCELLED);
                            return;
                        }
                        attached.complete(id);
                    }

                    @Override
                    public void onClose(Status status, Metadata trailers) {
                        synchronized (leg) {
                            leg.ended = true;
                            leg.closed = true;
                        }
                        if (!attached.isDone()) {
                            attached.completeExceptionally(new RefusedStream(status, "the stream was refused"));
                        }
                        leg.inbox.add(new End(status));
                    }

                    @Override
                    public void onReady() {
                        ready();
                    }
                }, headers);
                call.request(1);
                call.sendMessage(MemberChunk.newBuilder().setSessionId(joining).build());
            }
            try {
                sessionId = attached.get(ADMISSION_TIMEOUT_MS, TimeUnit.MILLISECONDS);
            } catch (ExecutionException e) {
                leg.abort(Status.CANCELLED);
                throw e.getCause() instanceof Exception ex ? ex : e;
            } catch (TimeoutException e) {
                leg.abort(Status.CANCELLED);
                throw new RefusedStream(Status.DEADLINE_EXCEEDED, "the receiver did not attach the stream in time");
            }
            return leg;
        }

        /** Schedules {@code leg}'s rotation at ROTATE_AT of its lifetime and its drop at its exp. */
        private void schedule(Leg leg) {
            long left = leg.expMillis - System.currentTimeMillis();
            leg.expiry = later(() -> {
                Leg current;
                synchronized (sendLock) {
                    current = sendLeg;
                }
                if (current == leg) {
                    fault("token expired without a rotation", Status.CANCELLED);
                }
            }, left);
            rotation = later(this::rotate, Math.max(ROTATE_MIN_MS, (long) (left * ROTATE_AT)));
        }

        /**
         * Make-before-break: a new token, a new stream joining this session,
         * then the cutover. A mint that fails or returns no newer token is
         * retried until the current token expires, when the session drops.
         */
        private void rotate() {
            if (done.get() || (finSent && finReceived) || !rotating.compareAndSet(false, true)) {
                return;
            }
            try {
                Leg current;
                synchronized (sendLock) {
                    current = sendLeg;
                }
                String token;
                try {
                    token = tokenSource.token();
                } catch (Exception e) {
                    LOG.warning("member port: token mint for a rotation failed, retrying: " + describe(e));
                    rotation = later(this::rotate, ROTATE_RETRY_MS);
                    return;
                }
                if (TokenWrapper.parse(token).getExpiration() * 1000L <= current.expMillis) {
                    // No newer token yet: the identity cache renews it ahead of expiry.
                    rotation = later(this::rotate, ROTATE_RETRY_MS);
                    return;
                }
                ClientLeg next;
                try {
                    try {
                        next = openOnce(sessionId, token);
                    } catch (RefusedStream e) {
                        if (e.status.getCode() != Status.Code.UNAUTHENTICATED) {
                            throw e;
                        }
                        next = openOnce(sessionId, tokenSource.token());
                    }
                } catch (RefusedStream e) {
                    Status.Code code = e.status.getCode();
                    if (code == Status.Code.UNAUTHENTICATED || code == Status.Code.PERMISSION_DENIED) {
                        fault("rotation refused (" + code + "): " + e.getMessage(), Status.CANCELLED);
                        return;
                    }
                    LOG.warning("member port: rotation failed, retrying: " + describe(e));
                    rotation = later(this::rotate, ROTATE_RETRY_MS);
                    return;
                }
                nextLeg = next;
                if (done.get()) {
                    next.abort(Status.CANCELLED);
                    return;
                }
                cutOver(next);
                schedule(next);
            } catch (Exception e) {
                LOG.warning("member port: rotation failed, retrying: " + describe(e));
                rotation = later(this::rotate, ROTATE_RETRY_MS);
            } finally {
                rotating.set(false);
            }
        }

        @Override
        void lastReceived(Leg old, Leg next) {
            // The server's last follows the client's: its sends are already on next.
        }

        @Override
        void finished() {
            if (finSent && finReceived) {
                // Both directions are done: the client ends the stream; the
                // server, seeing it, closes OK and the reader ends cleanly.
                synchronized (sendLock) {
                    sendLeg.finish();
                }
            }
        }

        @Override
        void forget() {
            cancel(rotation);
        }

        /** Runs {@code task} on a worker after the delay: the timer thread only hands off. */
        private ScheduledFuture<?> later(Runnable task, long delayMillis) {
            if (done.get()) {
                return null;
            }
            try {
                return timers.schedule(() -> {
                    try {
                        workers.execute(task);
                    } catch (RejectedExecutionException e) {
                        fault("member port closed", Status.UNAVAILABLE);
                    }
                }, delayMillis, TimeUnit.MILLISECONDS);
            } catch (RejectedExecutionException e) {
                fault("member port closed", Status.UNAVAILABLE);
                return null;
            }
        }
    }

    /** A stream the receiver refused or never attached. */
    private static final class RefusedStream extends Exception {
        private static final long serialVersionUID = 1L;
        final transient Status status;

        RefusedStream(Status status, String message) {
            super(message + " (" + status.getCode() + ")");
            this.status = status;
        }
    }

    /** The server end of the member tunnel: admits each stream, then opens or joins its session. */
    private final class TunnelHandler implements ServerCallHandler<MemberChunk, MemberChunk> {
        private final InetSocketAddress target;

        TunnelHandler(InetSocketAddress target) {
            this.target = target;
        }

        @Override
        public ServerCall.Listener<MemberChunk> startCall(ServerCall<MemberChunk, MemberChunk> call, Metadata headers) {
            String peer = String.valueOf(call.getAttributes().get(io.grpc.Grpc.TRANSPORT_ATTR_REMOTE_ADDR));
            Admitted admitted;
            try {
                admitted = verifyPeer(bearer(headers.get(AUTHORIZATION)));
            } catch (RefusedException e) {
                LOG.warning("member port: stream from " + peer + " refused: " + e.getMessage());
                call.close(e.status(), new Metadata());
                return new ServerCall.Listener<MemberChunk>() {};
            }
            if (pendingAdmissions.incrementAndGet() > MAX_PENDING_ADMISSIONS) {
                pendingAdmissions.decrementAndGet();
                LOG.warning("member port: too many streams awaiting admission; refusing " + peer);
                call.close(Status.RESOURCE_EXHAUSTED, new Metadata());
                return new ServerCall.Listener<MemberChunk>() {};
            }
            ServerLeg leg = new ServerLeg(call, admitted);
            AtomicBoolean admitting = new AtomicBoolean(true);
            AtomicBoolean firstSeen = new AtomicBoolean();
            Runnable admittedOrGone = () -> {
                if (admitting.compareAndSet(true, false)) {
                    pendingAdmissions.decrementAndGet();
                }
            };
            ScheduledFuture<?> deadline = timers.schedule(() -> {
                if (!firstSeen.get()) {
                    LOG.warning("member port: stream from " + peer + " sent no first chunk in " + ADMISSION_TIMEOUT_MS + "ms");
                    leg.abort(Status.DEADLINE_EXCEEDED);
                    admittedOrGone.run();
                }
            }, ADMISSION_TIMEOUT_MS, TimeUnit.MILLISECONDS);
            AtomicReference<InboundSession> owner = new AtomicReference<>();
            // The stream closes at its token's exp, whatever it is doing then.
            leg.expiry = timers.schedule(() -> {
                InboundSession s = owner.get();
                synchronized (leg) {
                    if (leg.closed) {
                        return;
                    }
                }
                LOG.info("member port: stream from " + peer + " reached its token's exp");
                if (s != null && s.nextLeg == leg) {
                    // A rotation that never cut over: the session goes on, on its current stream.
                    s.detach(leg);
                } else if (s != null) {
                    s.fault("a stream's token expired without a rotation", Status.UNAUTHENTICATED);
                }
                leg.abort(Status.UNAUTHENTICATED);
                admittedOrGone.run();
            }, Math.max(0, admitted.expMillis - System.currentTimeMillis()), TimeUnit.MILLISECONDS);
            leg.request();
            return new ServerCall.Listener<MemberChunk>() {
                @Override
                public void onMessage(MemberChunk chunk) {
                    if (firstSeen.compareAndSet(false, true)) {
                        deadline.cancel(false);
                        try {
                            workers.execute(() -> {
                                owner.set(first(leg, chunk, peer));
                                admittedOrGone.run();
                            });
                        } catch (RejectedExecutionException e) {
                            leg.abort(Status.UNAVAILABLE);
                            admittedOrGone.run();
                        }
                        return;
                    }
                    leg.inbox.add(chunk);
                }

                @Override
                public void onHalfClose() {
                    leg.inbox.add(new End(Status.OK));
                }

                @Override
                public void onCancel() {
                    deadline.cancel(false);
                    cancel(leg.expiry);
                    synchronized (leg) {
                        leg.ended = true;
                        leg.closed = true;
                    }
                    leg.inbox.add(new End(Status.CANCELLED));
                    InboundSession s = owner.get();
                    if (s != null) {
                        s.detach(leg);
                    }
                    admittedOrGone.run();
                }

                @Override
                public void onComplete() {
                    cancel(leg.expiry);
                }

                @Override
                public void onReady() {
                    InboundSession s = owner.get();
                    if (s != null) {
                        s.ready();
                    }
                }
            };
        }

        /**
         * A stream's first chunk: no session id opens a session (only now is
         * the target dialled), a session id joins that session as a rotation
         * when the token names the same subject.
         */
        private InboundSession first(ServerLeg leg, MemberChunk chunk, String peer) {
            if (!chunk.getPayload().isEmpty() || chunk.getLast() || chunk.getFin()) {
                LOG.warning("member port: stream from " + peer + " opened with a data chunk");
                leg.abort(Status.PERMISSION_DENIED);
                return null;
            }
            String own;
            try {
                own = tokenSource.token();
            } catch (Exception e) {
                LOG.warning("member port: no member token to answer " + peer + " with: " + describe(e));
                leg.abort(Status.UNAVAILABLE);
                return null;
            }
            String joining = chunk.getSessionId();
            if (!joining.isEmpty()) {
                InboundSession s = inbound.get(joining);
                if (s == null || !s.subject.equals(leg.subject) || !s.attach(leg)) {
                    LOG.warning("member port: rotation from " + peer + " refused: "
                            + (s == null ? "no such live session" : !s.subject.equals(leg.subject)
                                    ? "its token names another subject" : "the session cannot take a rotation now"));
                    leg.abort(Status.PERMISSION_DENIED);
                    return null;
                }
                leg.accept(own, MemberChunk.newBuilder().setSessionId(joining).build());
                synchronized (leg) {
                    if (leg.closed) {
                        s.detach(leg);
                    }
                }
                return s;
            }
            synchronized (leg) {
                if (leg.closed) {
                    // Expired or cancelled while waiting: never dial for it.
                    return null;
                }
            }
            Socket plain = new Socket();
            try {
                plain.connect(target, ADMISSION_TIMEOUT_MS);
            } catch (IOException e) {
                LOG.warning("member port: the member target " + target + " is unreachable: " + describe(e));
                closeQuietly(plain);
                leg.abort(Status.UNAVAILABLE);
                return null;
            }
            InboundSession s = new InboundSession(plain, leg.subject);
            s.sessionId = newSessionId();
            inbound.put(s.sessionId, s);
            leg.accept(own, MemberChunk.newBuilder().setSessionId(s.sessionId).build());
            s.start(leg);
            return s;
        }
    }

    // ---- Helpers ----

    private static String newSessionId() {
        byte[] id = new byte[16];
        RANDOM.nextBytes(id);
        return Base64.getUrlEncoder().withoutPadding().encodeToString(id);
    }

    private static String bearer(String header) {
        if (header == null) {
            return null;
        }
        return header.regionMatches(true, 0, "bearer ", 0, 7) ? header.substring(7) : header;
    }

    private static void cancel(ScheduledFuture<?> f) {
        if (f != null) {
            f.cancel(false);
        }
    }

    /** Resets a local connection: SO_LINGER 0 sends an RST, never a FIN or a hang. */
    private static void reset(Socket s) {
        try {
            s.setSoLinger(true, 0);
        } catch (SocketException ignored) {
            // Already closed: nothing to reset.
        }
        closeQuietly(s);
    }

    private static void requireLoopback(String what, InetSocketAddress address) {
        if (address == null || address.isUnresolved() || !address.getAddress().isLoopbackAddress()) {
            throw new IllegalArgumentException("member port: the " + what + " must be a loopback address, got " + address
                    + ": nothing may reach the member protocol except through the member port");
        }
    }

    private static void startThread(String name, Runnable body) {
        Thread t = new Thread(body, name);
        t.setDaemon(true);
        t.start();
    }

    private static ThreadFactory daemonThreads(String prefix) {
        AtomicInteger n = new AtomicInteger();
        return r -> {
            Thread t = new Thread(r, prefix + "-" + n.incrementAndGet());
            t.setDaemon(true);
            return t;
        };
    }

    private static X509TrustManager trustManagerFor(List<X509Certificate> cas) throws Exception {
        KeyStore store = KeyStore.getInstance(KeyStore.getDefaultType());
        store.load(null, null);
        int i = 0;
        for (X509Certificate ca : cas) {
            store.setCertificateEntry("ca-" + i++, ca);
        }
        TrustManagerFactory tmf = TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm());
        tmf.init(store);
        for (TrustManager tm : tmf.getTrustManagers()) {
            if (tm instanceof X509TrustManager x509) {
                return x509;
            }
        }
        throw new IllegalStateException("member port: no X509TrustManager available");
    }

    private static String describe(Throwable e) {
        String m = e.getMessage();
        return e.getClass().getSimpleName() + (m == null ? "" : ": " + m);
    }

    private static void closeQuietly(java.io.Closeable c) {
        if (c == null) {
            return;
        }
        try {
            c.close();
        } catch (IOException ignored) {
            // Closing is best effort: the connection is gone either way.
        }
    }

    /**
     * Chain to the fleet bundle, then {@link #verifyPeerCertificate}. Extended,
     * so the JDK does not add a hostname check: a member's certificate names its
     * SPIFFE ID, which this checks, not a host.
     */
    private final class MemberTrustManager extends X509ExtendedTrustManager {
        private final X509TrustManager delegate;

        MemberTrustManager(X509TrustManager delegate) {
            this.delegate = delegate;
        }

        @Override
        public void checkClientTrusted(X509Certificate[] chain, String authType) throws CertificateException {
            throw new CertificateException("member port: clients present tokens, not certificates");
        }

        @Override
        public void checkClientTrusted(X509Certificate[] chain, String authType, Socket socket) throws CertificateException {
            checkClientTrusted(chain, authType);
        }

        @Override
        public void checkClientTrusted(X509Certificate[] chain, String authType, SSLEngine engine) throws CertificateException {
            checkClientTrusted(chain, authType);
        }

        @Override
        public void checkServerTrusted(X509Certificate[] chain, String authType) throws CertificateException {
            delegate.checkServerTrusted(chain, authType);
            verifyPeerCertificate(chain);
        }

        @Override
        public void checkServerTrusted(X509Certificate[] chain, String authType, Socket socket) throws CertificateException {
            checkServerTrusted(chain, authType);
        }

        @Override
        public void checkServerTrusted(X509Certificate[] chain, String authType, SSLEngine engine) throws CertificateException {
            checkServerTrusted(chain, authType);
        }

        @Override
        public X509Certificate[] getAcceptedIssuers() {
            return delegate.getAcceptedIssuers();
        }
    }

    /**
     * Serves the current certificate: a renewal applies from the next handshake.
     * Each alias choice takes one snapshot and names it, so the key and the chain
     * the JDK then asks for (in either order) are always one pair.
     */
    private static final class ServingKeyManager extends X509ExtendedKeyManager {
        private static final String ALIAS_PREFIX = "member-";
        private static final int SNAPSHOTS = 64;
        private final ServingCert servingCert;
        private final AtomicLong next = new AtomicLong();
        private final Map<String, Material> snapshots = java.util.Collections.synchronizedMap(
                new java.util.LinkedHashMap<>(SNAPSHOTS, 0.75f, false) {
                    @Override
                    protected boolean removeEldestEntry(Map.Entry<String, Material> eldest) {
                        return size() > SNAPSHOTS;
                    }
                });

        ServingKeyManager(ServingCert servingCert) {
            this.servingCert = servingCert;
        }

        private String snapshot() {
            Material m = servingCert.material();
            if (m == null || m.chain == null || m.chain.length == 0 || m.key == null) {
                return null;
            }
            String alias = ALIAS_PREFIX + next.incrementAndGet();
            snapshots.put(alias, m);
            return alias;
        }

        @Override
        public X509Certificate[] getCertificateChain(String alias) {
            Material m = snapshots.get(alias);
            return m == null ? null : m.chain.clone();
        }

        @Override
        public PrivateKey getPrivateKey(String alias) {
            Material m = snapshots.get(alias);
            return m == null ? null : m.key;
        }

        @Override
        public String[] getServerAliases(String keyType, Principal[] issuers) {
            String alias = snapshot();
            return alias == null ? null : new String[] {alias};
        }

        @Override
        public String chooseServerAlias(String keyType, Principal[] issuers, Socket socket) {
            return snapshot();
        }

        @Override
        public String chooseEngineServerAlias(String keyType, Principal[] issuers, SSLEngine engine) {
            return snapshot();
        }

        @Override
        public String[] getClientAliases(String keyType, Principal[] issuers) {
            return null;
        }

        @Override
        public String chooseClientAlias(String[] keyType, Principal[] issuers, Socket socket) {
            return null;
        }

        @Override
        public String chooseEngineClientAlias(String[] keyType, Principal[] issuers, SSLEngine engine) {
            return null;
        }
    }
