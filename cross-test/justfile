# Active cross-test gates for tacplus-generated code.
#
# Generated outputs must be written to ignored target/ directories, not
# committed under cross-test language trees.

set dotenv-load := false

root := justfile_directory()

default: current-generation consumer-build

current-generation:
    bash {{root}}/current-generation/run.sh

current-generation-go:
    bash {{root}}/current-generation/run.sh --language go

current-generation-java:
    bash {{root}}/current-generation/run.sh --language java

current-generation-rust:
    bash {{root}}/current-generation/run.sh --language rust

determinism:
    bash {{root}}/determinism/run.sh

determinism-go:
    bash {{root}}/determinism/run.sh --language go

determinism-rust:
    bash {{root}}/determinism/run.sh --language rust

determinism-python:
    bash {{root}}/determinism/run.sh --language python

determinism-typescript:
    bash {{root}}/determinism/run.sh --language typescript

determinism-java:
    bash {{root}}/determinism/run.sh --language java

consumer-build:
    bash {{root}}/consumer-contract/run.sh

consumer-build-go:
    bash {{root}}/consumer-contract/run.sh --language go

consumer-build-java:
    bash {{root}}/consumer-contract/run.sh --language java

consumer-build-python:
    bash {{root}}/consumer-contract/run.sh --language python

consumer-build-rust:
    bash {{root}}/consumer-contract/run.sh --language rust

consumer-build-typescript:
    bash {{root}}/consumer-contract/run.sh --language typescript

consumer-build-swift:
    bash {{root}}/consumer-contract/run.sh --language swift

runtime-smoke:
    bash {{root}}/runtime-smoke/run.sh

runtime-smoke-python:
    bash {{root}}/runtime-smoke/run.sh --consumer python

runtime-smoke-typescript:
    bash {{root}}/runtime-smoke/run.sh --consumer typescript

# Cross-language SERVER coverage: real generated java/rust servers driven by
# the generated go client. Multi-runtime (go + maven + cargo) and slow, so it
# is a standalone target and is NOT part of `just test`.
# The default target also runs the CLIENT half below.
server-runtime:
    bash {{root}}/server-runtime/run.sh

server-runtime-java:
    bash {{root}}/server-runtime/run.sh --server java

server-runtime-rust:
    bash {{root}}/server-runtime/run.sh --server rust

# Cross-language CLIENT coverage: the generated java client driving the
# rust-hosted server and the generated rust client driving the java-hosted
# server. Same multi-runtime cost, same standalone rules.
server-runtime-clients: server-runtime-client-java server-runtime-client-rust

server-runtime-client-java:
    bash {{root}}/server-runtime/run.sh --client java

server-runtime-client-rust:
    bash {{root}}/server-runtime/run.sh --client rust

# Cross-language SERIALIZATION-EQUIVALENCE coverage: one message, encoded once
# by go into a checked-in golden byte corpus, decoded and value-asserted by all
# five generated languages. Needs go + maven + cargo + python + node
# concurrently, so it is a standalone target and is NOT part of `just test`.
wire-corpus:
    bash {{root}}/wire-corpus/run.sh

wire-corpus-go:
    bash {{root}}/wire-corpus/run.sh --language go

wire-corpus-java:
    bash {{root}}/wire-corpus/run.sh --language java

wire-corpus-python:
    bash {{root}}/wire-corpus/run.sh --language python

wire-corpus-rust:
    bash {{root}}/wire-corpus/run.sh --language rust

wire-corpus-typescript:
    bash {{root}}/wire-corpus/run.sh --language typescript

# Re-encode the checked-in golden bytes from the fixture's own expect blocks.
# Manual: run it only after deliberately editing an expect value, never to make
# a disagreeing decoder pass.
wire-corpus-emit:
    bash {{root}}/wire-corpus/run.sh --emit

consumer-smoke:
    bash {{root}}/consumer-smoke/run.sh

consumer-smoke-go:
    bash {{root}}/consumer-smoke/run.sh --language go

consumer-smoke-java:
    bash {{root}}/consumer-smoke/run.sh --language java

consumer-smoke-python:
    bash {{root}}/consumer-smoke/run.sh --language python

consumer-smoke-rust:
    bash {{root}}/consumer-smoke/run.sh --language rust

consumer-smoke-typescript:
    bash {{root}}/consumer-smoke/run.sh --language typescript
