/// Builds a metrics provider from the configured listen address.
/// Falls back to the container hostname when the address is a wildcard.
fn build_metrics_provider(listen_addr: &Option<Host>) -> StaticMetrics {
    let mut host = String::new();
    let mut port = 8443i32;
    if let Some(h) = listen_addr {
        host = h.host.clone();
        port = if h.port == 0 { 8443 } else { h.port };
    }
    if host.is_empty() || host == "0.0.0.0" || host == "::" {
        host = std::env::var("HOSTNAME").unwrap_or_default();
    }
    StaticMetrics {
        grpc_endpoint: Some(Host { host, port, ..Default::default() }),
    }
}

