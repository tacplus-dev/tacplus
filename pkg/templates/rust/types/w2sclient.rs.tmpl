fn json_error_to_status(value: &Value) -> Option<tonic::Status> {
    value
        .get("error")
        .and_then(|v| v.as_str())
        .map(|msg| tonic::Status::unknown(msg.to_string()))
}

fn http_status_to_tonic(status: reqwest::StatusCode, value: Value) -> tonic::Status {
    let message = value
        .get("error")
        .and_then(|v| v.as_str())
        .map(str::to_string)
        .unwrap_or_else(|| format!("W2S HTTP status {}", status));
    let code = match status.as_u16() {
        400 => tonic::Code::InvalidArgument,
        401 => tonic::Code::Unauthenticated,
        403 => tonic::Code::PermissionDenied,
        404 => tonic::Code::NotFound,
        409 => tonic::Code::AlreadyExists,
        429 => tonic::Code::ResourceExhausted,
        501 => tonic::Code::Unimplemented,
        503 => tonic::Code::Unavailable,
        504 => tonic::Code::DeadlineExceeded,
        _ => tonic::Code::Unknown,
    };
    tonic::Status::new(code, message)
}

