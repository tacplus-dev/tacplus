// AuthenticateAtOrBelow enforces the universal namespace rule: the caller's
// namespace must be at or above the target.
func TestAuthenticateAtOrBelowNamespaceRule(t *testing.T) {
	key := newTestKey(t)
	a := authorizerWithKeys(t, jwkForKey(t, key))

	// Caller in "/a" is at-or-above the target "/a/b" -> allowed.
	above := signedToken(t, key, func(tok *tokenlib.TokenWrapper) {
		tok.SetSubType("service").SetSubject("caller-svc").SetNamespace("/a")
	})
	if err := a.AuthenticateAtOrBelow(bearerCtx(above), "/a/b"); err != nil {
		t.Fatalf("caller at-or-above target must be allowed, got: %v", err)
	}

	// Caller in "/a/b" is BELOW the target "/a" -> denied.
	below := signedToken(t, key, func(tok *tokenlib.TokenWrapper) {
		tok.SetSubType("service").SetSubject("caller-svc").SetNamespace("/a/b")
	})
	if err := a.AuthenticateAtOrBelow(bearerCtx(below), "/a"); err == nil {
		t.Fatal("caller below the target namespace must be denied")
	}
}

