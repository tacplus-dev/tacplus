    /// Fetches the authoritative {{.TypeName}} from the state service (Get RPC).
    ///
    /// A singleton Get can race the state authority's own convergence and return
    /// a value that has not been fully seeded yet — the wire carries no "found"
    /// bit to tell that apart. Retries with the watch-restart backoff for as long
    /// as the fetched value fails its own generated validation, bounded by
    /// config_fetch_timeout_seconds, and returns the validation failure once that
    /// budget is spent rather than handing back a value it knows is invalid.
    ///
    /// The wire carries no proto defaults, so this applies the type's generated
    /// defaults to every fetched value BEFORE validating it. Without that, a
    /// field the seeded state omits on purpose — because it carries a
    /// (spec.default_*) — arrives zero-valued and fails its own (spec.assert_*)
    /// check, and the retry loop burns its whole budget on a value that should
    /// have passed.
    pub async fn fetch(&self) -> Result<{{.TypeName}}, tonic::Status> {
        let timeout = self.inner.config_fetch_timeout();
        let deadline = tokio::time::Instant::now() + timeout;
        let mut attempt = 0u32;
        loop {
            let req = self.inner.authorized_request(Default::default()).await?;
            let mut stub = {{$.StateServiceClientType}}::new(self.inner.channel.clone());
            let response = stub.get_{{.FieldName}}(req).await?;
            let mut value = response.into_inner();
            {{.DefaultsFn}}(&mut value);
            match value.validate() {
                Ok(()) => {
                    // Update the local cache with the fetched value.
                    {
                        let mut state = self.inner.state.write().unwrap();
                        state.{{.FieldName}}_cache = Some(value.clone());
                    }
                    return Ok(value);
                }
                Err(e) => {
                    if !self.inner.sleep_before_fetch_retry(attempt, deadline).await {
                        return Err(tonic::Status::failed_precondition(format!(
                            "get_{{.FieldName}}: state value still failed validation after {:?}: {}",
                            timeout, e
                        )));
                    }
                    attempt += 1;
                }
            }
        }
    }

