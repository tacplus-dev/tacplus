//! Global logger state management

use once_cell::sync::OnceCell;
use std::sync::atomic::{AtomicBool, Ordering};

/// Global flag tracking whether TRACE level logging is enabled
static IS_LOG_LEVEL_TRACE: AtomicBool = AtomicBool::new(false);

/// Global flag tracking whether a logger has been installed
static IS_INSTALLED: OnceCell<()> = OnceCell::new();

/// Returns true if TRACE level logging is globally enabled.
///
/// This function can be used to conditionally execute expensive logging operations
/// only when trace logging is active.
///
/// # Example
///
/// ```
/// use logger::is_log_level_trace;
///
/// if is_log_level_trace() {
///     // Perform expensive operation only when trace logging is enabled
///     let data = generate_detailed_debug_info();
///     tracing::debug!("Detailed trace info: {:?}", data);
/// }
/// # fn generate_detailed_debug_info() -> String { String::new() }
/// ```
pub fn is_log_level_trace() -> bool {
    IS_LOG_LEVEL_TRACE.load(Ordering::Relaxed)
}

/// Set the trace level flag (internal use only)
pub(crate) fn set_log_level_trace(enabled: bool) {
    IS_LOG_LEVEL_TRACE.store(enabled, Ordering::Relaxed);
}

/// Check if a logger has been installed
pub(crate) fn is_installed() -> bool {
    IS_INSTALLED.get().is_some()
}

/// Mark the logger as installed (internal use only)
pub(crate) fn mark_installed() {
    let _ = IS_INSTALLED.set(());
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_log_level_trace() {
        // Test setting and getting trace flag
        set_log_level_trace(false);
        assert!(!is_log_level_trace());

        set_log_level_trace(true);
        assert!(is_log_level_trace());

        set_log_level_trace(false);
        assert!(!is_log_level_trace());
    }

    #[test]
    fn test_is_log_level_trace_multiple_calls() {
        set_log_level_trace(false);

        // Multiple calls should return consistent value
        let got1 = is_log_level_trace();
        let got2 = is_log_level_trace();
        let got3 = is_log_level_trace();

        assert_eq!(got1, got2);
        assert_eq!(got2, got3);
        assert!(!got1);

        // Set to true
        set_log_level_trace(true);

        let got4 = is_log_level_trace();
        let got5 = is_log_level_trace();
        let got6 = is_log_level_trace();

        assert_eq!(got4, got5);
        assert_eq!(got5, got6);
        assert!(got4);
    }
}

// -----------------------------------------------------------------------------
// Reload handle
// -----------------------------------------------------------------------------

/// Handle for swapping the active layer after the typed config is known.
///
/// `tracing` allows exactly ONE global subscriber per process. Before this
/// existed, a service installed a plain subscriber at startup and the chassis's
/// config-driven install later called `try_init()`, which could only fail — and
/// its error was discarded, so the redacting layer was linked into the binary
/// and never received a line. A reload layer is what makes both possible:
/// redaction from the first line, and the typed config applied once it is read.
pub(crate) type BoxedLayer =
    Box<dyn tracing_subscriber::Layer<tracing_subscriber::Registry> + Send + Sync>;

static RELOAD_HANDLE: OnceCell<tracing_subscriber::reload::Handle<BoxedLayer, tracing_subscriber::Registry>> =
    OnceCell::new();

/// The subscriber shape the filter sits on top of.
type FilterSubscriber = tracing_subscriber::layer::Layered<
    tracing_subscriber::reload::Layer<BoxedLayer, tracing_subscriber::Registry>,
    tracing_subscriber::Registry,
>;

/// Subscriber-wide filter handle, held SEPARATELY from the format layer.
///
/// The filter must NOT live inside the format layer's reload cell. A per-layer
/// filter (`Layer::with_filter`) wrapped in `reload::Layer` loses the filter-id
/// plumbing the registry uses to apply it, and silently stops filtering
/// altogether. Observed in production: a service whose transport pins were
/// present and correct emitted 800 h2 DEBUG frames in two minutes, and those
/// frames are exactly what the pins exist to suppress because they carry
/// authorization headers. As a subscriber-level layer the filter applies to the
/// whole stack regardless of its position in it.
static FILTER_HANDLE: OnceCell<
    tracing_subscriber::reload::Handle<tracing_subscriber::EnvFilter, FilterSubscriber>,
> = OnceCell::new();

/// Store the filter reload handle created by the bootstrap install.
pub(crate) fn set_filter_handle(
    h: tracing_subscriber::reload::Handle<tracing_subscriber::EnvFilter, FilterSubscriber>,
) {
    let _ = FILTER_HANDLE.set(h);
}

/// Swap the subscriber-wide filter. Returns false when none is installed.
pub(crate) fn reload_filter(filter: tracing_subscriber::EnvFilter) -> bool {
    match FILTER_HANDLE.get() {
        Some(h) => h.reload(filter).is_ok(),
        None => false,
    }
}

/// Store the reload handle created by the bootstrap install.
pub(crate) fn set_reload_handle(
    h: tracing_subscriber::reload::Handle<BoxedLayer, tracing_subscriber::Registry>,
) {
    let _ = RELOAD_HANDLE.set(h);
}

/// Swap the active layer. Returns false when no reloadable subscriber is
/// installed, in which case the caller must fall back to a one-shot install.
pub(crate) fn reload_layer(layer: BoxedLayer) -> bool {
    match RELOAD_HANDLE.get() {
        Some(h) => h.reload(layer).is_ok(),
        None => false,
    }
}

/// True when a reloadable subscriber is installed and its layer can be swapped.
pub(crate) fn has_reload_handle() -> bool {
    RELOAD_HANDLE.get().is_some()
}
