[package]
name = "grpcconfig"
version = "0.1.0"
edition = "2021"
{{- if .License}}
license = "{{.License}}"
{{- end}}
publish = false
description = "Bootstrap config loader from CLI flags and environment variables"

[dependencies]
{{.CrateBasePath}}-types = { path = "../../types" }
logger = { path = "../logger" }
serde = { workspace = true, features = ["derive"] }
serde_json = { workspace = true }
