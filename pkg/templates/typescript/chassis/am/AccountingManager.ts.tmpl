/** Builds an ErrorContext from the current call site. */
export function captureErrorContext(skip: number, shouldStack: boolean): ErrorContext {
  const ec: ErrorContext = {
    caller: '',
    function: '',
    stackTrace: '',
  } as unknown as ErrorContext;

  const err = new Error();
  if (err.stack) {
    const lines = err.stack.split('\n');
    const frame = lines[skip + 2]; // skip Error + captureErrorContext
    if (frame) {
      const match = frame.match(/at\s+(\S+)\s+\((.+):(\d+):\d+\)/);
      if (match) {
        (ec as any).function = match[1];
        (ec as any).caller = `${match[2]}:${match[3]}`;
      }
    }
    if (shouldStack) {
      (ec as any).stackTrace = err.stack;
    }
  }

  return ec;
}

/**
 * Returns true for gRPC codes that indicate our bugs
 * (INTERNAL=13, UNKNOWN=2, DATA_LOSS=15).
 */
export function shouldCaptureStack(code: number): boolean {
  return code === 13 || code === 2 || code === 15;
}

/** Extracts a numeric gRPC status code from an error. */
export function grpcCodeFromError(err: unknown): number {
