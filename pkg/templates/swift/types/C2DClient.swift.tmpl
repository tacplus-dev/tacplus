import Foundation
import GRPCCore
import GRPCNIOTransportHTTP2

public struct C2DClient: Sendable {
    public let socketPath: String

    public init(socketPath: String = C2DClient.defaultSocketPath()) {
        self.socketPath = socketPath
    }

    public static func defaultSocketPath(homeDirectory: String = FileManager.default.homeDirectoryForCurrentUser.path) -> String {
        "\(homeDirectory)/.{{.DaemonDirectory}}/daemon.sock"
    }
{{range .Services}}

    public func {{.MethodName}}<Result: Sendable>(
        _ body: ({{.ClientType}}.Client<HTTP2ClientTransport.Posix>) async throws -> Result
    ) async throws -> Result {
        try await withGRPCClient(
            transport: .http2NIOPosix(
                target: .unixDomainSocket(path: self.socketPath, authority: "localhost"),
                transportSecurity: .plaintext
            )
        ) { client in
            try await body({{.ClientType}}.Client(wrapping: client))
        }
    }
{{end}}
}
