    send: tokio::sync::Mutex<Option<LegTx>>,
    pending: Mutex<Pending>,
    /// Every leg not yet known to be over, to abort them on a fault.
    legs: Mutex<Vec<Arc<LegState>>>,
    /// Ends the handler's request stream at once with a fault's status.
