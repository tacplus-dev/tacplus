// ServiceConnection manages connections to all instances of a single target
// service. It reconciles endpoints as instances appear, disappear, or change
// status. Two construction modes:
//   - NewDynamic: starts empty, endpoints arrive via ReconcileFromHealth
//   - NewStatic: eagerly connects to the given hosts
type ServiceConnection struct {
	serviceID string
	endpoints []*endpointConn
	active    *endpointConn
	dialOpts  []grpc.DialOption
	mu        sync.RWMutex
}

// NewDynamic creates a ServiceConnection that starts with no endpoints.
// Endpoints are added via ReconcileFromHealth as health data arrives.
func NewDynamic(serviceID string, dialOpts []grpc.DialOption) *ServiceConnection {
	return &ServiceConnection{
		serviceID: serviceID,
		dialOpts:  dialOpts,
	}
}

// NewStatic creates a ServiceConnection and eagerly connects to the given hosts.
func NewStatic(serviceID string, hosts []*host_pb.Host, dialOpts []grpc.DialOption) *ServiceConnection {
	sc := &ServiceConnection{
		serviceID: serviceID,
		dialOpts:  dialOpts,
	}
	for _, h := range hosts {
		target := fmt.Sprintf("%s:%d", h.Host, h.Port)
		ec := newEndpointConn(target)
		if err := ec.dial(dialOpts); err != nil {
			zap.L().Warn("ServiceConnection: failed to connect to static endpoint",
				zap.String("service", serviceID),
				zap.String("target", target),
				zap.Error(err))
			continue
		}
		sc.endpoints = append(sc.endpoints, ec)
		zap.L().Info("ServiceConnection: connected to static endpoint",
			zap.String("service", serviceID),
			zap.String("target", target))
	}
	sc.selectActive()
	return sc
}

