package main

import (
	"log"

	handler "{{.EntryPointImportPath}}"
	servicemanager "{{.ServiceManagerImportPath}}"
)

func main() {
	sm, err := servicemanager.New()
	if err != nil {
		log.Fatalf("servicemanager: %v", err)
	}

	h, err := handler.{{.EntryPointFunc}}(sm.StateClients())
	if err != nil {
		log.Fatalf("handler: %v", err)
	}

	if err := sm.Run(h); err != nil {
		log.Fatalf("{{.ServiceLabel}}: %v", err)
	}
}
