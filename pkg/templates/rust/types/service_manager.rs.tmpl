        let state_clients = StateClients::new(conn, Some(tp.clone())).await?;
{{- end}}
	{{- if .HasS2SClients}}
	        // Create token provider factory for audience-scoped S2S auth.
        let tp_for: TokenProviderFor = {
            let im = identity.clone();
            Arc::new(move |aud: &str| {
                let im = im.clone();
                let aud = aud.to_string();
                Some(Arc::new(move || {
                    let im = im.clone();
                    let aud = aud.clone();
                    Box::pin(async move {
                        im.get_token_for(&aud).await.map_err(|e| -> Box<dyn std::error::Error + Send + Sync> {
                            e.to_string().into()
                        })
                    }) as Pin<Box<dyn Future<Output = Result<String, Box<dyn std::error::Error + Send + Sync>>> + Send>>
                }) as TokenProvider)
            })
        };

        // Per-target ServiceConnections. Each gets a SPIFFE verifier narrowed
        // to that service: cert must chain to a trusted root AND carry a URI
        // SAN matching `spiffe://<trust_domain>/<service_id>`. DNS hostname
        // is ignored entirely.
{{- range .TargetServices}}
{{- if ne .ServiceID $.StateStoreServiceID}}
        let {{.AccessorName}}_sc = Arc::new(ServiceConnection::new_dynamic(
            "{{.ServiceID}}",
            spiffe_verifier_base.clone().expect_service("{{.ServiceID}}"),
        ));
{{- end}}
{{- end}}
        // State store uses static ServiceConnection (from config endpoints), others use dynamic.
        let _state_store_cp = servicemanager::ChannelProvider::new(state_store_conn.clone());
{{- range .TargetServices}}
{{- if ne .ServiceID $.StateStoreServiceID}}
        let {{.AccessorName}}_cp = servicemanager::ChannelProvider::new({{.AccessorName}}_sc.clone());
{{- end}}
{{- end}}
	        let s2s = GrpcClients::new(
{{- range .TargetServices}}
{{- if eq .ServiceID $.StateStoreServiceID}}
            _state_store_cp.clone(),
{{- else}}
            {{.AccessorName}}_cp,
{{- end}}
{{- end}}
            &tp_for,
	        );
	{{- end}}
	{{- if .HasSmb}}
	        let smb_authority_sc = Arc::new(ServiceConnection::new_dynamic(
	            "{{.SmbAuthorityServiceID}}",
	            spiffe_verifier_base.clone().expect_service("{{.SmbAuthorityServiceID}}"),
