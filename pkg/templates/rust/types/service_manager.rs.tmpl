/// Resolves the declared EventBus broker service in the background with exponential backoff.
/// This is a free function so it can be called from a spawned task without
/// needing &self on ServiceManager.
async fn resolve_eventbus(
    target_service: &str,
    state_store_conn: Option<Channel>,
    identity: Arc<IdentityManager>,
    tls_config: tonic::transport::ClientTlsConfig,
) -> Result<Channel, Box<dyn std::error::Error + Send + Sync>> {
    let conn = state_store_conn.ok_or("no state-store connection for EventBus broker resolution")?;
    let mut backoff = std::time::Duration::from_secs(2);
    let max_backoff = std::time::Duration::from_secs(30);
    loop {
        let token = identity.get_token().await
            .map_err(|e| -> Box<dyn std::error::Error + Send + Sync> { e.to_string().into() })?;
        let mut client = ServiceHealthStateServiceClient::new(conn.clone());
        let mut req = tonic::Request::new(
            crate::types::{{.HealthStateModPath}}::InstancesGetAllRequest { ..Default::default() }
        );
        req.metadata_mut().insert(
            "authorization",
            format!("Bearer {}", token).parse()
                .map_err(|_| -> Box<dyn std::error::Error + Send + Sync> { "invalid token metadata".into() })?,
        );
        match client.get_all_instances(req).await {
            Ok(response) => {
                let entries = response.into_inner().entries;
                for (_, health) in &entries {
                    if health.service_id == target_service
                        && health.status == InstanceStatus::Healthy as i32
                    {
                        if let Some(ep) = &health.grpc_endpoint {
                            if !ep.host.is_empty() && ep.port > 0 {
                                let target = format!("https://{}:{}", ep.host, ep.port);
                                let endpoint = Channel::from_shared(target)?
                                    .tls_config(tls_config)?
                                    // Keepalive: subscription channels must detect partitions
                                    // (a dead-but-open stream blocks silently without pings).
                                    // Values from keepaliveconst — BY CONSTRUCTION with server side.
                                    .http2_keep_alive_interval(std::time::Duration::from_secs({{.KeepaliveTimeSecs}}))
                                    .keep_alive_while_idle(true)
                                    .keep_alive_timeout(std::time::Duration::from_secs({{.KeepaliveTimeoutSecs}}));
                                return Ok(endpoint.connect().await?);
                            }
                        }
                    }
                }
                tracing::warn!(
                    service = target_service,
                    retry_in = ?backoff,
                    "No healthy EventBus broker instance found, retrying"
                );
            }
            Err(e) => {
                tracing::warn!(
                    service = target_service,
                    error = %e,
                    retry_in = ?backoff,
                    "Failed to query ServiceHealthState for EventBus broker, retrying"
                );
            }
        }
        tokio::time::sleep(backoff).await;
        backoff = std::cmp::min(backoff * 2, max_backoff);
    }
}

/// Retries EventBus resolution for background publishers. Token acquisition or
/// missing state-store connections can fail before `resolve_eventbus` enters its own
/// ServiceHealthState retry loop, so publisher tasks must not exit on the first
/// resolution error.
async fn resolve_eventbus_for_publisher(
    publisher: &'static str,
    target_service: &'static str,
    state_store_conn: Option<Channel>,
    identity: Arc<IdentityManager>,
    tls_config: tonic::transport::ClientTlsConfig,
) -> Channel {
    const MIN_BACKOFF: std::time::Duration = std::time::Duration::from_secs(3);
    const MAX_BACKOFF: std::time::Duration = std::time::Duration::from_secs(30);
    let mut backoff = MIN_BACKOFF;

    loop {
        match resolve_eventbus(target_service, state_store_conn.clone(), identity.clone(), tls_config.clone()).await {
            Ok(channel) => return channel,
            Err(e) => {
                tracing::warn!(
                    publisher,
                    service = target_service,
                    error = %e,
                    backoff_ms = backoff.as_millis(),
                    "publisher failed to resolve EventBus broker, retrying"
                );
                tokio::time::sleep(backoff).await;
                backoff = std::cmp::min(backoff * 2, MAX_BACKOFF);
            }
        }
    }
}

{{- range .Publishers}}

/// Drains {{.EventTypeName}} events from the channel to EventBus, reconnecting
/// with exponential backoff on stream errors. Generated from (spec.service_event)/(spec.topic).
async fn {{.LoopFn}}(
    publisher: &'static str,
    target_service: &'static str,
    state_store_conn: Option<Channel>,
    identity: Arc<IdentityManager>,
    tls_config: tonic::transport::ClientTlsConfig,
    token_provider: TokenProvider,
    mut rx: tokio::sync::mpsc::Receiver<{{.EventTypeName}}>,
) {
    const MIN_BACKOFF: std::time::Duration = std::time::Duration::from_secs(3);
    const MAX_BACKOFF: std::time::Duration = std::time::Duration::from_secs(30);
    let mut backoff = MIN_BACKOFF;
    let mut pending: Option<{{.EventTypeName}}> = None;

    loop {
        if pending.is_none() {
            pending = rx.recv().await;
            if pending.is_none() {
                // rx closed — service is shutting down.
                return;
            }
        }

        let channel = resolve_eventbus_for_publisher(
            publisher,
            target_service,
            state_store_conn.clone(),
            identity.clone(),
            tls_config.clone(),
        ).await;
        match {{.StreamFn}}(&channel, &token_provider, pending.as_ref().expect("pending event")).await {
            Ok(()) => {
                pending = None;
                backoff = MIN_BACKOFF;
            }
            Err(e) => {
                tracing::warn!(
                    error = %e,
                    backoff_ms = backoff.as_millis(),
                    "{{.Label}} stream failed, reconnecting"
                );
                tokio::time::sleep(backoff).await;
                backoff = std::cmp::min(backoff * 2, MAX_BACKOFF);
            }
        }
    }
}

/// Sends {{.EventTypeName}} events to EventBus one at a time, each as its own
/// streaming call. Returns only after the EventBus stream returns an ack.
async fn {{.StreamFn}}(
    channel: &Channel,
    token_provider: &TokenProvider,
    event: &{{.EventTypeName}},
) -> Result<(), Box<dyn std::error::Error + Send + Sync>> {
    let path = tonic::codegen::http::uri::PathAndQuery::from_static(
        "{{.PublishPath}}"
    );

    let token = (token_provider)().await?;

    let outbound = futures::stream::once(futures::future::ready(event.clone()));
    let mut grpc_req = tonic::Request::new(outbound);
    grpc_req.metadata_mut().insert(
        "authorization",
        format!("Bearer {}", token).parse()
            .map_err(|_| -> Box<dyn std::error::Error + Send + Sync> { "invalid token metadata".into() })?,
    );

    let mut grpc = tonic::client::Grpc::new(channel.clone());
    grpc.ready().await.map_err(|e| -> Box<dyn std::error::Error + Send + Sync> {
        format!("EventBus not ready for {{.Label}}: {}", e).into()
    })?;

    let codec = tonic_prost::ProstCodec::<{{.EventTypeName}}, PublishResponse>::default();
    let response = grpc.streaming(grpc_req, path.clone(), codec).await
        .map_err(|e| -> Box<dyn std::error::Error + Send + Sync> {
            format!("{{.Label}} failed: {}", e).into()
        })?;
    let mut inbound = response.into_inner();
    match inbound.message().await
        .map_err(|e| -> Box<dyn std::error::Error + Send + Sync> {
            format!("{{.Label}} ack receive failed: {}", e).into()
        })? {
        Some(_) => Ok(()),
        None => Err("{{.Label}} stream completed before ack".into()),
    }
}
{{- end}}
{{- end}}

