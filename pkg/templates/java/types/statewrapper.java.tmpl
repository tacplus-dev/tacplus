    /**
     * Waits the watch-restart backoff for {@code attempt}, clamped to what is left
     * of the fetch budget. Returns false when the budget is spent or the wait was
     * interrupted.
     */
    private boolean sleepBeforeFetchRetry(int attempt, long deadlineNanos) {
        long remainingMillis = (deadlineNanos - System.nanoTime()) / 1_000_000L;
        if (remainingMillis <= 0) {
            return false;
        }
        long delay = Math.min(watchRetryDelayMillis(attempt), remainingMillis);
        try {
            Thread.sleep(delay);
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
            return false;
        }
        return true;
    }
{{end}}
    private void scheduleWatchRestart(String watchName, int attempt, Runnable startFn) {
        if (closed.get()) {
            return;
        }
        long delay = watchRetryDelayMillis(attempt);
        try {
            watchExecutor.schedule(() -> {
                if (!closed.get()) {
                    startFn.run();
                }
            }, delay, TimeUnit.MILLISECONDS);
        } catch (RejectedExecutionException e) {
            if (!closed.get()) {
                LOG.warning(watchName + " retry rejected: " + e.getMessage());
            }
        }
    }

    private void registerWatchCall(ClientCallStreamObserver<?> call) {
        synchronized (activeWatchCalls) {
            if (closed.get()) {
                call.cancel("state client closed", null);
                return;
            }
            activeWatchCalls.add(call);
        }
    }

    private void removeWatchCall(ClientCallStreamObserver<?> call) {
        if (call == null) {
            return;
        }
        synchronized (activeWatchCalls) {
            activeWatchCalls.remove(call);
        }
    }

    private void cancelActiveWatchCalls() {
        List<ClientCallStreamObserver<?>> calls;
        synchronized (activeWatchCalls) {
            calls = new ArrayList<>(activeWatchCalls);
            activeWatchCalls.clear();
        }
        for (ClientCallStreamObserver<?> call : calls) {
            try {
                call.cancel("state client closed", null);
            } catch (Exception ignored) {
            }
        }
    }
