// Code generated by tacplus. DO NOT EDIT.
//
// The LLM rule, as a build gate (tacplus#909; tacplus-dev/roadmap
// decisions/skipper-and-admiral-2026-11-01.md, 2026-11-19): an LLM may propose;
// it never holds a token or a write path. The advisor of {{.ServiceLabel}} is its own
// crate, at {{.AdvisorPath}}, and this script fails every build of the service when
// that crate's manifest could reach anything of the service but this model
// port: the generated model crate (its state clients, its S2S clients, its
// ServiceManager), the types crate (its raw transport stubs), a chassis crate
// (the token, the key, the servicemanager), the service's own code (the core),
// or any other crate of the repository.
//
// The check reads the manifest as TOML, not its source text: a dependency is
// refused for what it is (its package name, its path, its git source), however
// it is spelled. It runs whenever the generated model is built, so the core
// cannot build beside an advisor that breaks it.
//
// A dependency of the advisor's is refused when:
//   - its package is one of the generated crates below (renamed or not);
//   - it is a path dependency other than this crate;
//   - it comes from git;
//   - the manifest, or the workspace it inherits from, patches or replaces it.
// A `{ workspace = true }` dependency is judged by the entry it inherits. A
// manifest tacplus cannot find or read fails the build too.

use std::fs;
use std::path::{Path, PathBuf};

/// The advisor's crate, from this crate's directory.
const ADVISOR_DIR: &str = "{{.AdvisorRel}}";

/// The crates of the generated tree the advisor may not depend on.
const FORBIDDEN: &[&str] = &[
{{- range .Forbidden}}
    "{{.}}",
{{- end}}
];

const DEPENDENCY_TABLES: &[&str] = &[
    "dependencies",
    "dev-dependencies",
    "dev_dependencies",
    "build-dependencies",
    "build_dependencies",
];

fn main() {
    let port_dir = PathBuf::from(std::env::var("CARGO_MANIFEST_DIR").expect("cargo sets CARGO_MANIFEST_DIR"));
    let advisor_dir = port_dir.join(ADVISOR_DIR);
    let advisor_dir = fs::canonicalize(&advisor_dir).unwrap_or(advisor_dir);
    let manifest = advisor_dir.join("Cargo.toml");
    println!("cargo:rerun-if-changed=build.rs");
    println!("cargo:rerun-if-changed={}", manifest.display());
    let violations = check(&port_dir, &advisor_dir);
    if violations.is_empty() {
        return;
    }
    eprintln!("tacplus LLM rule: the advisor {} may depend on no part of the service but its model port:", manifest.display());
    for v in &violations {
        eprintln!("  - {v}");
    }
    eprintln!("An LLM may propose; it never holds a token or a write path (tacplus#909). Give the advisor what it needs through the model port and the traits the core implements and passes in.");
    std::process::exit(1);
}

fn check(port_dir: &Path, advisor_dir: &Path) -> Vec<String> {
    let mut violations = Vec::new();
    let manifest_path = advisor_dir.join("Cargo.toml");
    let manifest = match read_toml(&manifest_path) {
        Ok(m) => m,
        Err(e) => return vec![e],
    };
    let port_dir = match fs::canonicalize(port_dir) {
        Ok(p) => p,
        Err(e) => return vec![format!("cannot resolve the model port's directory {}: {e}", port_dir.display())],
    };
    let workspace = find_workspace(advisor_dir, &manifest);
    if let Some((dir, _)) = &workspace {
        println!("cargo:rerun-if-changed={}", dir.join("Cargo.toml").display());
    }

    let mut names = Vec::new();
    for (table_name, table) in dependency_tables(&manifest) {
        for (key, entry) in table {
            let mut entry = entry.clone();
            let mut base = advisor_dir.to_path_buf();
            if entry.get("workspace").and_then(toml::Value::as_bool) == Some(true) {
                match workspace.as_ref().and_then(|(dir, ws)| workspace_dependency(ws, key).map(|e| (dir.clone(), e))) {
                    Some((dir, inherited)) => {
                        entry = inherited;
                        base = dir;
                    }
                    None => {
                        violations.push(format!("[{table_name}] {key}: inherits from a workspace that does not declare it"));
                        continue;
                    }
                }
            }
            let package = entry.get("package").and_then(toml::Value::as_str).unwrap_or(key).to_string();
            names.push(package.clone());
            if FORBIDDEN.contains(&package.as_str()) {
                violations.push(format!("[{table_name}] {key}: is the generated crate {package}"));
            }
            if entry.get("git").is_some() {
                violations.push(format!("[{table_name}] {key}: comes from git"));
            }
            if let Some(path) = entry.get("path").and_then(toml::Value::as_str) {
                let target = base.join(path);
                match fs::canonicalize(&target) {
                    Ok(t) if t == port_dir => {}
                    Ok(t) => violations.push(format!("[{table_name}] {key}: is the path dependency {}, and the model port is the only one the advisor may have", t.display())),
                    Err(e) => violations.push(format!("[{table_name}] {key}: path {} does not resolve: {e}", target.display())),
                }
            }
        }
    }

    let mut patching = vec![("the advisor's manifest".to_string(), manifest.clone())];
    if let Some((dir, ws)) = workspace.as_ref().filter(|(dir, _)| dir != advisor_dir) {
        patching.push((format!("the workspace {}", dir.join("Cargo.toml").display()), ws.clone()));
    }
    for (whose, m) in &patching {
        if m.get("replace").is_some() {
            violations.push(format!("{whose} has a [replace] section"));
        }
        if let Some(patch) = m.get("patch").and_then(toml::Value::as_table) {
            for source in patch.values().filter_map(toml::Value::as_table) {
                for (key, entry) in source {
                    let package = entry.get("package").and_then(toml::Value::as_str).unwrap_or(key);
                    if names.iter().any(|n| n == package) || FORBIDDEN.contains(&package) {
                        violations.push(format!("{whose} patches {package}, a dependency of the advisor"));
                    }
                }
            }
        }
    }
    violations
}

fn read_toml(path: &Path) -> Result<toml::Table, String> {
    let text = fs::read_to_string(path).map_err(|e| format!("cannot read {}: {e}", path.display()))?;
    text.parse::<toml::Table>().map_err(|e| format!("cannot parse {}: {e}", path.display()))
}

/// Every dependency table of the manifest, its target-specific ones included.
fn dependency_tables(manifest: &toml::Table) -> Vec<(String, &toml::Table)> {
    let mut out = Vec::new();
    for name in DEPENDENCY_TABLES {
        if let Some(t) = manifest.get(*name).and_then(toml::Value::as_table) {
            out.push((name.to_string(), t));
        }
    }
    if let Some(targets) = manifest.get("target").and_then(toml::Value::as_table) {
        for (cfg, target) in targets {
            for name in DEPENDENCY_TABLES {
                if let Some(t) = target.get(*name).and_then(toml::Value::as_table) {
                    out.push((format!("target.{cfg}.{name}"), t));
                }
            }
        }
    }
    out
}

/// The workspace the advisor belongs to: its own manifest's, the one its
/// package.workspace names, or the nearest ancestor's, as cargo finds it.
fn find_workspace(advisor_dir: &Path, manifest: &toml::Table) -> Option<(PathBuf, toml::Table)> {
    if manifest.get("workspace").is_some() {
        return Some((advisor_dir.to_path_buf(), manifest.clone()));
    }
    if let Some(dir) = manifest.get("package").and_then(|p| p.get("workspace")).and_then(toml::Value::as_str) {
        let dir = advisor_dir.join(dir);
        return read_toml(&dir.join("Cargo.toml")).ok().map(|ws| (dir, ws));
    }
    for dir in advisor_dir.ancestors().skip(1) {
        let path = dir.join("Cargo.toml");
        if !path.is_file() {
            continue;
        }
        if let Ok(ws) = read_toml(&path) {
            if ws.get("workspace").is_some() {
                return Some((dir.to_path_buf(), ws));
            }
        }
    }
    None
}

fn workspace_dependency(ws: &toml::Table, key: &str) -> Option<toml::Value> {
    let entry = ws.get("workspace")?.get("dependencies")?.get(key)?;
    Some(match entry {
        toml::Value::String(version) => {
            let mut t = toml::Table::new();
            t.insert("version".to_string(), toml::Value::String(version.clone()));
            toml::Value::Table(t)
        }
        other => other.clone(),
    })
}
