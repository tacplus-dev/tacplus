#[allow(unused_imports)]
use serde_json;

/// Result type for REST→gRPC dispatch: JSON string on success, HTTP error on failure.
pub type DispatchResult = Result<String, (StatusCode, String)>;

/// RestDispatcher resolves channels and auth for outgoing gRPC calls.
///
/// Gateway implements this with service resolution + forwarded C2S tokens.
/// Daemon implements this with S2S ChannelProvider + minted service tokens.
#[tonic::async_trait]
pub trait RestDispatcher: Send + Sync {
    /// Resolve a gRPC channel for the given service.
    ///
    /// `tenant` is the target tenant of a tenant-routed route: a tid already
    /// read off the request's route field and checked ([`route_tenant`]). The
    /// channel must reach THAT tenant's instance of the service and no other:
    /// never another tenant's, never a shared one, never the caller's own
    /// tenant in its place (UNAVAILABLE when the tenant has none). `tenant` is
    /// empty for a platform route, which is never addressed by tenant.
    async fn channel(&self, service_id: &str, tenant: &str) -> Result<Channel, tonic::Status>;

    /// Resolve an authorization header for outgoing requests to the given service.
    /// Gateway: forwards the incoming C2S token.
    /// Daemon: mints an S2S token scoped to the target service.
    async fn auth_header(&self, service_id: &str) -> Option<String>;
}

/// Build a tonic Request with forwarded auth and request ID metadata.
pub fn with_metadata<T>(req: T, auth_header: Option<&str>, request_id: &str) -> tonic::Request<T> {
    let mut request = tonic::Request::new(req);
    if let Some(auth) = auth_header {
        if let Ok(val) = auth.parse() {
            request.metadata_mut().insert("authorization", val);
        }
    }
    if let Ok(val) = request_id.parse() {
        request.metadata_mut().insert("x-request-id", val);
    }
    request
}

/// Deserialize a JSON request body into a protobuf message type.
#[allow(dead_code)]
fn json_req<T: serde::de::DeserializeOwned + Default>(body: &[u8]) -> Result<T, (StatusCode, String)> {
    if body.is_empty() {
        return Ok(T::default());
    }
    serde_json::from_slice(body).map_err(|e| {
        (StatusCode::BAD_REQUEST, error_body(format!("invalid request body: {}", e)))
    })
}

/// Build a JSON error body, escaping the message so it cannot break out of the
/// JSON string or inject additional fields.
fn error_body(message: impl std::fmt::Display) -> String {
    serde_json::json!({ "error": message.to_string() }).to_string()
}

/// Convert a gRPC status to an HTTP error tuple.
pub fn grpc_err(status: tonic::Status) -> (StatusCode, String) {
    let http_code = match status.code() {
        tonic::Code::NotFound => StatusCode::NOT_FOUND,
        tonic::Code::InvalidArgument => StatusCode::BAD_REQUEST,
        tonic::Code::Unauthenticated => StatusCode::UNAUTHORIZED,
        tonic::Code::PermissionDenied => StatusCode::FORBIDDEN,
        tonic::Code::Unimplemented => StatusCode::NOT_IMPLEMENTED,
        tonic::Code::Unavailable => StatusCode::SERVICE_UNAVAILABLE,
        tonic::Code::DeadlineExceeded => StatusCode::GATEWAY_TIMEOUT,
        tonic::Code::ResourceExhausted => StatusCode::TOO_MANY_REQUESTS,
        _ => StatusCode::INTERNAL_SERVER_ERROR,
    };
    (http_code, error_body(status.message()))
}

<<- if .HasStreaming >>
fn sse_error(message: impl std::fmt::Display) -> Event {
    Event::default().event("error").data(error_body(message))
}
<<- end >>

/// Auth policy for a REST route.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum AuthPolicy {
    /// No authentication needed (auth_disabled).
    NoAuth,
    /// Valid C2S token required, no entitlement check (auth_any_user).
    AnyUser,
    /// Valid C2S token + service_entitlements check (auth_entitled_users or default).
    Entitled,
}

/// A REST route entry, generated at compile time from proto annotations.
#[allow(dead_code)]
pub struct RouteInfo {
    pub http_path: &'static str,
    pub grpc_path: &'static str,
    pub service_id: &'static str,
    /// When set, entitlement checks use this vservice name instead of service_id.
    /// aud validation still uses service_id (the physical host).
    pub entitlement_service: Option<&'static str>,
    pub http_methods: &'static [&'static str],
    pub auth_policy: AuthPolicy,
    pub entitlement_scopes: &'static [&'static str],
    pub capability_scope: Option<&'static str>,
    pub server_streaming: bool,
    pub client_streaming: bool,
    pub target_namespace_field: Option<&'static str>,
    /// (spec.rest_browser).form_body: the route also accepts an
    /// application/x-www-form-urlencoded body. See `form_body_to_json`.
    pub form_body: bool,
    /// (spec.rest_browser).redirect_field, as the key it carries in the route's
    /// JSON response (its proto3 JSON name). When set, the route answers 303
    /// to that field's URL instead of JSON. See `redirect_response`.
    pub redirect_field: Option<&'static str>,
    /// (spec.rpc).route_field: the request field (proto name) whose value, a
    /// tid, names the tenant whose instance receives the call. None for a
    /// platform route, which is never addressed by tenant.
    pub route_field: Option<&'static str>,
    /// route_field's proto3 JSON name, the key it carries in a REST body.
    pub route_field_json: Option<&'static str>,
    /// route_field's wire number, for the gRPC proxy, which holds only the raw
    /// request frame (see [`route_tenant_from_wire`]). 0 for a platform route.
    pub route_field_number: u32,
}

/// Reports whether a value is a tid: exactly 8 characters of `[0-9a-z]`.
pub use servicemanager::tenant_route::valid_tenant_id;

/// The tid a tenant-routed request's route field names, or INVALID_ARGUMENT
/// naming `field` when it is empty or not a tid. Never defaulted from the
/// caller's token.
pub fn route_tenant(field: &str, value: &str) -> Result<String, tonic::Status> {
    servicemanager::tenant_route::route_tenant(field, value)
}

/// The target tenant of a gRPC request the gateway proxies as raw bytes:
/// `frame` is the request message (the gRPC frame's payload). Reads the LAST
/// top-level occurrence of the route's route field (proto3 last-one-wins),
/// refusing a malformed message and an empty or non-tid value
/// (INVALID_ARGUMENT), before anything is dialled. A platform route has no
/// tenant: `Ok("")`.
pub fn route_tenant_from_wire(frame: &[u8], route: &RouteInfo) -> Result<String, tonic::Status> {
    servicemanager::tenant_route::route_tenant_from_wire(frame, route.route_field_number, route.route_field.unwrap_or(""))
}

