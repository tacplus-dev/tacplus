        // must not report itself healthy while its credentials are being
        // rejected and re-minting is not helping. Readiness previously stayed
        // Ready through a total auth outage because the probe only asked whether
        // the process was listening.
        healthReporter.setDegradedProbe({{.ChassisBase}}.service_im.IdentityManager::credentialsDegraded);
        // PC-L-1: TLS renewal give-up / parse failures degrade this instance in the
        // fleet health plane instead of being Error-log-only.
        onTLSDegraded(reason -> {
            LOG.warning("marking instance DEGRADED: TLS renewal failure: " + reason);
            healthReporter.setStatus(InstanceStatus.INSTANCE_STATUS_DEGRADED);
        });
{{- if .HasTypedHealth}}
        healthReporter.setTypedHealthCollector(base -> handler.collectHealth().toBuilder()
                .setBase(base)
                .build()
                .toByteArray());
{{- end}}
        CountDownLatch firstHealthReady = new CountDownLatch(1);
        healthReporter.start(firstHealthReady, MAX_INIT_RETRIES);
        firstHealthReady.await();
        if (healthReporter.firstPublishFailure() != null) {
            throw new RuntimeException("first health publish failed", healthReporter.firstPublishFailure());
        }
	{{- if or .HasGrpcS2SClients .HasSmb}}

	        // Start ServiceConnection health poller — polls ServiceHealthState every 5s to
	        // discover and route to target service endpoints for S2S and SMB-authority communication.
        {
            var healthPollStub = ServiceHealthStateServiceGrpc.newBlockingStub(stateStoreConn.conn())
                    .withCallCredentials(identity.callCredentials());
            startManagedThread("serviceconnection-health-poller", true, () -> {
                long interval = 5000;
                while (!Thread.currentThread().isInterrupted()) {
                    try {
                        {{.HealthStateOuterClass}}.InstancesEntriesResponse resp = healthPollStub.getAllInstances(
                                {{.HealthStateOuterClass}}.InstancesGetAllRequest.getDefaultInstance());
	                        java.util.List<ServiceInstanceHealth> allInstances = new java.util.ArrayList<>(
	                                resp.getEntriesMap().values());
	                        // Fan out to each ServiceConnection (state store uses static endpoints, skip).
	{{- if .HasGrpcS2SClients}}
	{{- range .TargetServices}}
	{{- if ne .ServiceID $.StateStoreServiceID}}
	                        {
                            java.util.List<ServiceInstanceHealth> filtered = new java.util.ArrayList<>();
                            for (ServiceInstanceHealth inst : allInstances) {
                                if ("{{.ServiceID}}".equals(inst.getServiceId())) {
                                    filtered.add(inst);
                                }
                            }
                            {{.FieldName}}.reconcileFromHealth(filtered);
	                        }
	{{- end}}
	{{- end}}
	{{- end}}
	{{- if .HasSmb}}
	                        {
	                            java.util.List<ServiceInstanceHealth> filtered = new java.util.ArrayList<>();
	                            for (ServiceInstanceHealth inst : allInstances) {
	                                if ("{{.SmbAuthorityServiceID}}".equals(inst.getServiceId())) {
	                                    filtered.add(inst);
	                                }
	                            }
	                            smbAuthorityConn.reconcileFromHealth(filtered);
	                        }
	{{- end}}
	                    } catch (Exception e) {
                        LOG.warning("ServiceConnection health poll failed: " + e.getMessage());
                    }
                    try { Thread.sleep(interval); } catch (InterruptedException ie) {
                        Thread.currentThread().interrupt();
                        return;
                    }
                }
            });
        }
{{- end}}
{{- end}}

{{- if .HasTlsGrpc}}
        startManagedThread("grpc-server", false, () -> {
            try {
                srv.listen();
            } catch (Exception e) {
                if (!closing) {
                    LOG.severe("gRPC server error: " + e.getMessage());
                }
            }
        });
{{- else if .HasC2DGrpc}}
        // c2d-only service — no TLS server. The c2d socket server below is its
        // only listener.
{{- else}}
        startManagedThread("health-server", false, () -> {
            try {
                healthSrv.listen();
            } catch (Exception e) {
                if (!closing) {
                    LOG.severe("health server error: " + e.getMessage());
                }
            }
        });
{{- end}}
{{- if .HasC2DGrpc}}
        // Start the c2d unix socket server for local daemon IPC services. No
        // TLS, no token auth — the socket's owner-only permissions guard
        // access. A socket that cannot be bound or locked down fails run().
        c2dSrv.start();
{{- end}}

{{- if .HasAutoTls}}
        // Register the user handler with the auto-TLS stream (started in create()).
        // The stream populated the SM's cert accessors before run() began. Fire
        // newTlsCert synchronously with the already-stored cert so handlers that
        // depend on having one (e.g. EventBus initialising its embedded message
        // broker) see it now without waiting for the first renewal.
        tlsHandlerSlot.set(handler);
        CertAndKey initial = certAndKey.get();
        if (initial != null) {
            try {
                handler.newTlsCert(initial.chain, initial.privateKeyDer);
            } catch (Exception e) {
                // A handler failure on the FIRST cert delivery is fatal: the
                // service must not proceed as if it had applied its cert.
                // Failures on later renewal deliveries are log-and-continue.
                throw new RuntimeException("handler newTlsCert failed on initial delivery", e);
            }
        }
{{- end}}

{{- if .HasSmb}}
        // Start the SMB member-cert stream (SPIFFE plan D7). Blocks until the
        // first member credential is delivered to the handler — an SMB member
        // cannot join its black-box peer mesh without its per-SMB CA
        // + member cert. A handler failure on the FIRST delivery is fatal; later
        // renewal-delivery failures are log-and-continue (previous credential stays).
        smbHandlerSlot.set(handler);
        CountDownLatch smbReady = new CountDownLatch(1);
        AtomicReference<Exception> smbError = new AtomicReference<>();
	        startManagedThread(
	                "smb-cert",
	                true,
	                () -> smbCertStreamLoop(this, smbAuthorityConn, identity, smbReady, smbError));
        smbReady.await();
        if (smbError.get() != null) {
            throw new RuntimeException("first SMB member cert delivery failed", smbError.get());
        }
{{- end}}

{{- if .HasSubscriptions}}
        // One up-flag per subscription channel; readiness requires all of them.
{{- range .Subscriptions}}
        AtomicBoolean up_{{.HandlerMethodName}} = new AtomicBoolean(false);
{{- end}}
        java.util.List<RequiredChannels.RequiredStream> readinessStreams = java.util.List.of(
{{- range $i, $s := .Subscriptions}}{{if $i}},{{end}}
                new RequiredChannels.RequiredStream("{{$s.SourcePackage}}.{{$s.SourceField}} subscription ({{$s.TargetService}})", up_{{$s.HandlerMethodName}})
{{- end}});
{{- end}}
{{- if .HasServiceHealthState}}
        // Bootstrap complete (serving + first health publish{{if .HasAutoTls}} + TLS cert{{end}}{{if .HasSmb}} + SMB member cert{{end}}):
        // advertise SERVING on the gRPC health endpoint so k8s readiness probes pass
        // — once the required s2s channels are up too (see driveReadiness).
        //
        // Ongoing health evaluation feeds readiness: a handler reporting
        // UNHEALTHY flips the endpoint to NOT_SERVING so k8s removes the pod
        // from load-balancer rotation. Recovery flips it back to SERVING.
        AtomicBoolean healthOk = new AtomicBoolean(true);
        healthReporter.setStatusSink(effectiveStatus ->
                healthOk.set(effectiveStatus != InstanceStatus.INSTANCE_STATUS_UNHEALTHY));
{{- if or .HasTlsGrpc (not .HasC2DGrpc)}}
        GrpcServer readyCtl = {{if .HasTlsGrpc}}srv{{else}}healthSrv{{end}};
        startManagedThread("readiness", true,
                () -> driveReadiness(readyCtl, healthOk, {{if .HasSubscriptions}}readinessStreams{{else}}java.util.List.of(){{end}}));
{{- end}}
{{- else}}
        // Bootstrap complete (serving + first health publish{{if .HasAutoTls}} + TLS cert{{end}}{{if .HasSmb}} + SMB member cert{{end}}):
        // advertise SERVING on the gRPC health endpoint so k8s readiness probes pass.
{{- if .HasTlsGrpc}}
        srv.setReady(true);
{{- else if not .HasC2DGrpc}}
        healthSrv.setReady(true);
{{- end}}
{{- end}}

{{- if .HasSubscriptions}}
        // Start event-bus subscriptions — resolve target service via ServiceHealthState.
        List<Thread> subThreads = new ArrayList<>();
{{- range .Subscriptions}}
        {
{{- if .PerInstanceConsumerGroup}}
            // {{.TypeName}} is a (spec.record): this topic
            // feeds a NODE-LOCAL store, so this node's copy is only complete if it
            // receives every record. Under the shared service-label group the broker
            // hands each record to exactly ONE instance. A per-instance group makes
            // it fan the topic out to all of them instead.
            String serviceLabel = perInstanceConsumerGroup("{{$.ServiceLabel}}");
{{- else}}
            String serviceLabel = "{{$.ServiceLabel}}";
{{- end}}
            // The target is re-resolved from ServiceHealthState on every
            // (re)connect attempt (inside the subscriber's reconnect loop), so
            // the subscription recovers when the instance is rescheduled.
            {{.ClassName}} subscriber = new {{.ClassName}}(
                    () -> resolveService("{{.TargetService}}"),
                    () -> identity.callCredentialsForAudience("{{.TargetService}}"),
                    serviceLabel);
            subscriber.setUpFlag(up_{{.HandlerMethodName}});
            Thread t = startManagedThread("sub-{{.SourcePackage}}-{{.SourceField}}", true, () -> {
                long subBackoff = ReconnectBackoff.INITIAL_MS;
                while (!Thread.currentThread().isInterrupted()) {
                    try {
                        subscriber.subscribe((event, meta) -> {
{{- if and .StoreEpochFieldPascal (not .RoutingOnly)}}
                            // (spec.store_epoch) {{.StoreEpochField}}: a record has no write RPC —
                            // it reaches this store on this subscription — so this dispatch is the
                            // write path and the store's clock is stamped here, over whatever
                            // arrived. Unconditional, not stamp-or-refuse: there is no caller on a
                            // subscription to refuse, and an unstamped row cannot be ordered
                            // against the other nodes' redo logs at restore.
                            event = event.toBuilder().set{{.StoreEpochFieldPascal}}(System.currentTimeMillis()).build();
{{- end}}
                            handler.{{.HandlerMethodName}}(event,
                                    new Handler.SubscriptionMeta(meta.offset, meta.timestamp, meta.key, meta.topic, meta.partition));
{{- if and .DispatchMethod (not .RoutingOnly)}}
                            {{.DispatchMethod}}(event{{range .Inserts}}, {{.FieldName}}{{end}});
{{- end}}
                        });
                        return;
                    } catch (InterruptedException e) {
                        Thread.currentThread().interrupt();
                        return;
                    } catch (Exception e) {
                        if (Thread.currentThread().isInterrupted()) {
                            return;
                        }
                        LOG.severe("{{.SourcePackage}}.{{.SourceField}} subscription error, re-resolving target in " + subBackoff + "ms: " + e.getMessage());
                        try { Thread.sleep(ReconnectBackoff.jitterMs(subBackoff)); } catch (InterruptedException ie) {
                            Thread.currentThread().interrupt();
                            return;
                        }
                        subBackoff = ReconnectBackoff.next(subBackoff);
                    }
                }
            });
            subThreads.add(t);
            LOG.info("Started {{.SourcePackage}}.{{.SourceField}} subscription");
        }
{{- end}}
{{- end}}

        // Wait for shutdown signal.
        CountDownLatch shutdownLatch = new CountDownLatch(1);
        Thread runThread = Thread.currentThread();
        long shutdownTimeoutSeconds = config.getShutdownTimeoutSeconds() > 0
                ? config.getShutdownTimeoutSeconds() : 30;
        Runtime.getRuntime().addShutdownHook(new Thread(() -> {
            LOG.info("Shutdown signal received");
            shutdownLatch.countDown();
            // Block JVM halt until the graceful shutdown sequence below
            // (drain, handler.shutdown(), state/identity teardown) completes,
            // bounded by the configured shutdown timeout (plus slack for the
            // post-server teardown) so a stuck teardown cannot hang the JVM.
            try {
                runThread.join((shutdownTimeoutSeconds + 10) * 1000L);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
            }
        }, "sm-shutdown-hook"));
        shutdownLatch.await();

        LOG.info("Starting graceful shutdown");
        closing = true;

{{- if .HasSubscriptions}}
        // Cancel event-bus subscriptions.
        for (Thread t : subThreads) {
            t.interrupt();
        }
        for (Thread t : subThreads) {
            try { t.join(5000); } catch (InterruptedException ignored) {}
        }
	{{- end}}

{{- if .HasDiskStores}}
        for (ScheduledExecutorService scheduler : diskStoreSchedulers) {
            scheduler.shutdownNow();
        }
        diskStoreLogs.close();
{{- end}}

	{{- if .HasServiceHealthState}}
        healthReporter.close();
{{- end}}

{{- if .HasTlsGrpc}}
        srv.shutdown();
{{- else if not .HasC2DGrpc}}
        healthSrv.shutdown();
{{- end}}
{{- if .HasC2DGrpc}}
        c2dSrv.shutdown();
{{- end}}

        handler.shutdown();
        // Close the REAL authorizer. GrpcServer used to hold and close a
        // throwaway test-mode one instead, so this one's RemoteJwkSource stayed
        // active and its onError kept re-subscribing on the dying channel
        // through shutdown.
        if (authorizer != null) {
            authorizer.close();
        }
{{- if .HasStates}}
        stateClients.close();
{{- end}}
{{- if .HasGrpcS2SClients}}
{{- range .TargetServices}}
{{- if ne .ServiceID $.StateStoreServiceID}}
        {{.FieldName}}.close();
	{{- end}}
	{{- end}}
	{{- end}}
	{{- if .HasSmb}}
	        smbAuthorityConn.close();
	{{- end}}
        if (earlyHealthProbeServer != null) {
            earlyHealthProbeServer.shutdown();
            try {
                if (!earlyHealthProbeServer.awaitTermination(5, TimeUnit.SECONDS)) {
                    earlyHealthProbeServer.shutdownNow();
                }
            } catch (InterruptedException e) {
                earlyHealthProbeServer.shutdownNow();
                Thread.currentThread().interrupt();
            }
        }
	        stateStoreConn.close();
        identity.close();
        stopManagedThreads();
        LOG.info("Graceful shutdown complete");
    }
{{- if .HasAutoTls}}

    /**
     * Handler failure on the first TLS cert delivery — fatal at startup,
     * never retried (renewal failures are log-and-continue instead).
     */
    private static final class FatalTlsHandlerException extends Exception {
        FatalTlsHandlerException(String message, Throwable cause) {
            super(message, cause);
        }
    }

    /** Production entry point: spends the full MAX_INIT_RETRIES budget. */
    private static void tlsCertStreamLoop(
            ServiceManager sm,
            ServiceConnection stateStoreConn,
            IdentityManager identity,
            CountDownLatch readyLatch,
            AtomicReference<Exception> readyError) {
        tlsCertStreamLoop(sm, stateStoreConn, identity, readyLatch, readyError, MAX_INIT_RETRIES);
    }

    /**
     * maxInitRetries is the first-delivery retry budget; it falls back to
     * MAX_INIT_RETRIES when non-positive. It is an overload parameter rather
     * than a bare read of the constant so an exhaustion test can spend the
     * budget in seconds (PC-L-3) — javac inlines a {@code private static final
     * int} at every call site, so there is no other seam. Production calls the
     * 5-arg overload above, which passes MAX_INIT_RETRIES.
     */
    private static void tlsCertStreamLoop(
            ServiceManager sm,
            ServiceConnection stateStoreConn,
            IdentityManager identity,
            CountDownLatch readyLatch,
            AtomicReference<Exception> readyError,
            int maxInitRetries) {
        if (maxInitRetries <= 0) {
            maxInitRetries = MAX_INIT_RETRIES;
        }
        int attempt = 0;
        while (true) {
            final int seen = {{.ChassisBase}}.service_im.IdentityManager.credentialGeneration();
            try {
                runTlsCertStream(sm, stateStoreConn, identity, readyLatch);
                return;
            } catch (Exception e) {
                if (e instanceof FatalTlsHandlerException) {
                    // Handler rejected the first cert delivery — fail startup
                    // loudly instead of retrying.
                    readyError.set(e);
                    readyLatch.countDown();
                    return;
                }
                // A rejected credential must invalidate the token cache here too:
                // this stream renews the serving certificate, so a stuck
                // credential costs the service its TLS as well as its
                // authentication. Mirrors rust's tls_cert_stream_loop.
                {{.ChassisBase}}.service_im.IdentityManager.noteIfCredentialRejection(e, seen);
                attempt++;
                if (readyLatch.getCount() > 0) {
                    // First cert never delivered — retry with backoff instead of failing.
                    if (attempt >= maxInitRetries) {
                        sm.reportTLSDegraded("TLS renewal stream gave up before first delivery: " + e.getMessage());
                        readyError.set(e);
                        readyLatch.countDown();
                        return;
                    }
                    long delay = Math.min((long) Math.pow(2, Math.min(attempt, 5)), 30);
                    LOG.warning("TLS cert stream failed before first cert (attempt " + attempt + "/" + maxInitRetries + "), retrying in " + delay + "s: " + e.getMessage());
                    try { Thread.sleep(delay * 1000); } catch (InterruptedException ie) { return; }
                } else {
                    LOG.warning("TLS cert stream disconnected, retrying in 5s: " + e.getMessage());
                    try { Thread.sleep(5000); } catch (InterruptedException ie) { return; }
                }
            }
        }
    }

    private static void runTlsCertStream(
            ServiceManager sm,
            ServiceConnection stateStoreConn,
            IdentityManager identity,
            CountDownLatch readyLatch) throws Exception {
        // Generate keypair.
{{- if eq .AutoTlsKeyType "ecdsa"}}
        KeyPairGenerator kpg = KeyPairGenerator.getInstance("EC");
        kpg.initialize(new java.security.spec.ECGenParameterSpec("secp256r1"));
{{- else}}
        KeyPairGenerator kpg = KeyPairGenerator.getInstance("Ed25519");
{{- end}}
        KeyPair kp = kpg.generateKeyPair();
        // activePrivateKeyDer is the key paired with the most recently confirmed
        // cert. pendingPrivateKeyDer holds the key for an in-flight CSR (renewal)
        // and is promoted to active only when the matching cert arrives. This
        // prevents the active key from changing mid-flight and causing a
        // chain/key mismatch if a delivery races a renewal.
        AtomicReference<byte[]> activePrivateKeyDer = new AtomicReference<>(kp.getPrivate().getEncoded());
        AtomicReference<byte[]> activePublicKeyDer = new AtomicReference<>(kp.getPublic().getEncoded());
        AtomicReference<byte[]> pendingPrivateKeyDer = new AtomicReference<>();
        AtomicReference<byte[]> pendingPublicKeyDer = new AtomicReference<>();

        // Build public key proto.
        KeyOuterClass.PublicKey pubProto = buildPublicKeyProto(kp);

        // Create bidi stream.
        ManagedChannel channel = stateStoreConn.conn();
        if (channel == null) {
            throw new IllegalStateException("no active connection for ManageCert");
        }
        // ManageCert is served by the state store (kernel), not by a service
        // named "tlscert". Use a fixed kernel audience — callCredentials()
        // would resolve "tlscert" from the method name and mint a token for
        // the wrong service, causing UNAUTHENTICATED.
        TlsCertServiceGrpc.TlsCertServiceStub stub = TlsCertServiceGrpc.newStub(channel)
                .withCallCredentials(identity.callCredentialsForAudience("{{.StateStoreServiceID}}"));

        CountDownLatch done = new CountDownLatch(1);
        AtomicReference<Exception> streamError = new AtomicReference<>();
        AtomicReference<StreamObserver<Tlscert.TlsCertClientMsg>> outboundRef = new AtomicReference<>();
        AtomicReference<io.grpc.stub.ClientCallStreamObserver<Tlscert.TlsCertClientMsg>> callRef = new AtomicReference<>();
        // Ending the session must end the CALL, not just the loop. Without an
        // explicit cancel the ManageCert call stays open on the shared channel
        // after the loop has already failed, so the authority keeps sending and
        // onNext keeps applying certs for a session that no longer exists — and
        // a message already in flight is still handled after the decision to
        // fail. go returns out of the loop and rust propagates with `?`, which
        // drops their stream; java has to say so explicitly.
        java.util.function.Consumer<Exception> endSession = err -> {
            streamError.compareAndSet(null, err);
            done.countDown();
            io.grpc.stub.ClientCallStreamObserver<Tlscert.TlsCertClientMsg> call = callRef.get();
            if (call != null) {
                try {
                    call.cancel("ManageCert session ended", err);
                } catch (RuntimeException ignored) {}
            }
        };

        StreamObserver<Tlscert.TlsCertClientMsg> outbound = stub.manageCert(
                new io.grpc.stub.ClientResponseObserver<Tlscert.TlsCertClientMsg, Tlscert.TlsCertServerMsg>() {
                    @Override
                    public void beforeStart(io.grpc.stub.ClientCallStreamObserver<Tlscert.TlsCertClientMsg> requestStream) {
                        callRef.set(requestStream);
                    }

                    @Override
                    public void onNext(Tlscert.TlsCertServerMsg msg) {
                        // The session already ended; a message that was in flight
                        // when it did must not be applied.
                        if (done.getCount() == 0) {
                            return;
                        }
                        if (msg.hasCert()) {
                            try {
                                X509.X509CertChain chain = msg.getCert().getChain();
                                // Use the pending renewal key (if any) for this
                                // delivery, but do not promote it until the
                                // handler seam accepts the matching cert.
                                byte[] pending = pendingPrivateKeyDer.get();
                                byte[] keyDer = pending != null ? pending : activePrivateKeyDer.get();
                                byte[] pendingPublic = pendingPublicKeyDer.get();
                                byte[] publicKeyDer = pendingPublic != null ? pendingPublic : activePublicKeyDer.get();
                                try {
                                    verifyLeafMatchesPublicKey(chain, publicKeyDer);
                                } catch (Exception verifyErr) {
                                    if (readyLatch.getCount() > 0) {
                                        endSession.accept(new Exception("TLS cert public key mismatch", verifyErr));
                                        return;
                                    }
                                    LOG.warning("TLS cert public key mismatch on renewal delivery, keeping previous cert: " + verifyErr.getMessage());
                                    sm.reportTLSDegraded("renewed TLS certificate does not match the requested key, keeping the previous certificate: " + verifyErr.getMessage());
                                    pendingPrivateKeyDer.set(null);
                                    pendingPublicKeyDer.set(null);
                                    return;
                                }
                                PrivateKey parsedKey = null;
                                try {
{{- if eq .AutoTlsKeyType "ecdsa"}}
                                    parsedKey = java.security.KeyFactory.getInstance("EC")
                                            .generatePrivate(new java.security.spec.PKCS8EncodedKeySpec(keyDer));
{{- else}}
                                    parsedKey = java.security.KeyFactory.getInstance("Ed25519")
                                            .generatePrivate(new java.security.spec.PKCS8EncodedKeySpec(keyDer));
{{- end}}
                                } catch (Exception keyErr) {
                                    LOG.warning("Failed to parse delivered private key; servers keep the previous cert: " + keyErr.getMessage());
                                    sm.reportTLSDegraded("renewed TLS private key unparseable: " + keyErr.getMessage());
                                    return;
                                }
                                Handler activeHandler = sm.tlsHandlerSlot.get();
                                if (activeHandler != null) {
                                    try {
                                        activeHandler.newTlsCert(chain, keyDer);
                                    } catch (Exception cbErr) {
                                        if (readyLatch.getCount() > 0) {
                                            // Handler failure on the FIRST cert delivery is
                                            // fatal: fail startup instead of signalling
                                            // readiness as if the cert had been applied.
                                            endSession.accept(new FatalTlsHandlerException(
                                                    "handler newTlsCert failed on first cert delivery", cbErr));
                                            return;
                                        }
                                        // Renewal delivery: the previous certificate
                                        // stays in service and will expire, so this is
                                        // log AND degrade, not log alone.
                                        LOG.warning("Handler newTlsCert failed: " + cbErr.getMessage());
                                        sm.reportTLSDegraded("TLS handler rejected a renewed certificate, keeping the previous certificate: " + cbErr.getMessage());
                                        pendingPrivateKeyDer.set(null);
                                        pendingPublicKeyDer.set(null);
                                        return;
                                    }
                                }
                                if (pending != null) {
                                    activePrivateKeyDer.set(pending);
                                    activePublicKeyDer.set(publicKeyDer);
                                    pendingPrivateKeyDer.set(null);
                                    pendingPublicKeyDer.set(null);
                                }
                                // Atomic swap — readers see chain+key as a paired unit.
                                if (parsedKey != null) {
                                    sm.certAndKey.set(new CertAndKey(chain, parsedKey, keyDer));
                                }
                                // A DELIVERED certificate proves the credential was
                                // accepted. Without this the TLS loop could only ever
                                // increment the rejection counter, so a service with no
                                // state watches — the only other clear site — would stay
                                // degraded forever after a brief authority blip, even
                                // once it reconnected happily.
                                {{.ChassisBase}}.service_im.IdentityManager.noteCredentialAccepted();
                                if (readyLatch.getCount() > 0) {
                                    readyLatch.countDown();
                                }
                            } catch (Exception e) {
                                LOG.warning("TLS cert delivery handling failed: " + e.getMessage());
                                pendingPrivateKeyDer.set(null);
                                pendingPublicKeyDer.set(null);
                            }
                        } else if (msg.hasRenew()) {
                            LOG.info("TLS cert renewal requested: " + msg.getRenew().getReason());
                            KeyOuterClass.PublicKey newPub;
                            try {
                                KeyPair newKp = kpg.generateKeyPair();
                                // Stage the new key as pending — do NOT replace
                                // activePrivateKeyDer yet. The active key only
                                // changes once the matching cert is delivered, so
                                // until then sm.certAndKey remains a consistent
                                // (old chain, old key) pair.
                                pendingPrivateKeyDer.set(newKp.getPrivate().getEncoded());
                                pendingPublicKeyDer.set(newKp.getPublic().getEncoded());
                                newPub = buildPublicKeyProto(newKp);
                            } catch (Exception e) {
                                // The CSR never went out, so there is no in-flight
                                // request for this key to pair with. Drop it, and end
                                // the session: the authority's renewal request is
                                // unanswered, so leaving the stream up would let the
                                // cert run to expiry with no renewal in flight. Ending
                                // it makes the loop reconnect and re-CSR (go returns
                                // "generate renewal keypair", rust propagates with `?`).
                                pendingPrivateKeyDer.set(null);
                                pendingPublicKeyDer.set(null);
                                endSession.accept(new Exception("generate renewal keypair", e));
                                return;
                            }
                            try {
                                outboundRef.get().onNext(Tlscert.TlsCertClientMsg.newBuilder()
                                        .setCsr(Tlscert.TlsCertCsr.newBuilder()
                                                .setPublicKey(newPub))
                                        .build());
                            } catch (Exception e) {
                                // Same reasoning as above: the CSR did not reach the
                                // authority, so drop the staged key and end the session
                                // (go returns "send renewal Csr").
                                pendingPrivateKeyDer.set(null);
                                pendingPublicKeyDer.set(null);
                                endSession.accept(new Exception("send renewal Csr", e));
                            }
                        } else if (!msg.getError().isEmpty()) {
                            endSession.accept(new Exception("server error: " + msg.getError()));
                        }
                    }

                    @Override
                    public void onError(Throwable t) {
                        streamError.compareAndSet(null, new Exception(t));
                        done.countDown();
                    }

                    @Override
                    public void onCompleted() {
                        if (streamError.get() == null) {
                            if (readyLatch.getCount() > 0) {
                                streamError.set(new Exception("ManageCert stream completed before first cert delivery"));
                            } else {
                                streamError.set(new Exception("ManageCert stream completed after first cert delivery"));
                            }
                        }
                        done.countDown();
                    }
                });

        outboundRef.set(outbound);

        // Send Init.
        String hostname = java.net.InetAddress.getLocalHost().getHostName();
        outbound.onNext(Tlscert.TlsCertClientMsg.newBuilder()
                .setInit(Tlscert.TlsCertInit.newBuilder()
                        .setServiceName("{{.ServiceLabel}}")
                        .setInstanceId(hostname))
                .build());

        // Send initial Csr.
        outbound.onNext(Tlscert.TlsCertClientMsg.newBuilder()
                .setCsr(Tlscert.TlsCertCsr.newBuilder()
                        .setPublicKey(pubProto))
                .build());

        // Wait for stream to end.
        try {
            done.await();
        } finally {
            try { outbound.onCompleted(); } catch (Exception ignored) {}
        }
        if (streamError.get() != null) {
            throw streamError.get();
        }
    }
{{- end}}
