        } else if (idx.get(CREDENTIALS_SEGMENT) >= 0) {
            classifyPair(p, segs, idx.get(CREDENTIALS_SEGMENT), SubjectKind.UNKNOWN);
        } else if (idx.get(DATA_SEGMENT) >= 0) {
