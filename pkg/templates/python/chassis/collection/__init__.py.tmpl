class _Ring(Generic[Change]):
    def __init__(self, depth: int, idle_secs: int):
        self._depth = max(1, depth)
        self._idle_secs = max(0, idle_secs)
        self._buf: list[tuple[int, Change]] = []
        self._closed = False
        self._cond = threading.Condition()

    def publish(self, revision: int, change: Change) -> None:
        with self._cond:
            if self._closed:
                return
            if len(self._buf) == self._depth:
                self._buf.pop(0)
            self._buf.append((revision, change))
            self._cond.notify_all()

    def close(self) -> None:
        with self._cond:
            self._closed = True
            self._cond.notify_all()

    def resume(self, from_revision: int, release: Callable[[], None]) -> Iterator[Change]:
        next_revision = from_revision + 1
        last_activity = time.monotonic()
        try:
            while True:
                with self._cond:
                    while True:
                        oldest = self._buf[0][0] if self._buf else 0
                        if next_revision > 1 and oldest > 0 and next_revision < oldest:
                            raise WatchRelistError(
                                "watch resume revision is older than the replay ring; relist required"
                            )
                        batch = [(rev, change) for rev, change in self._buf if rev >= next_revision]
                        closed = self._closed
                        if batch or closed:
                            break
                        if self._idle_secs > 0:
                            remaining = self._idle_secs - (time.monotonic() - last_activity)
                            if remaining <= 0:
                                raise WatchIdleTimeoutError("watch stream idle timeout exceeded")
                            self._cond.wait(timeout=remaining)
                        else:
                            self._cond.wait()
                for rev, change in batch:
                    next_revision = rev + 1
                    yield change
                    last_activity = time.monotonic()
                if closed:
                    return
        finally:
            release()


