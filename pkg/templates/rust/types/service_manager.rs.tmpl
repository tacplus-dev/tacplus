    /// Marks the service as SERVING or NOT_SERVING on the gRPC health endpoint
    /// (the same handle that backs the plaintext 8444 probe and the main-server
    /// health service).
    ///
    /// This method is for services that manage their own serving lifecycle
    /// (e.g. custom external TLS) and never call `run()`. Services that call
    /// `run()` do not need this — bootstrap automatically flips to SERVING
    /// after health publish and TLS setup complete.
    ///
    /// **Contract**: Do not call this until your service has completed its own
    /// bootstrap (config loaded, TLS ready, handler initialized). Reporting
    /// SERVING before bootstrap is complete defeats the purpose of readiness
    /// probes and may cause k8s to route traffic to an unready instance.
    pub async fn set_serving(&self, serving: bool) {
        let status = if serving {
            tonic_health::ServingStatus::Serving
        } else {
            tonic_health::ServingStatus::NotServing
        };
        self.grpc_health.set_service_status("", status).await;
    }

    /// Spawns a background task tied to the ServiceManager lifecycle.
    /// The task is aborted when the SM shuts down, and the SM waits for all
    /// tasks to complete before shutdown returns. Use this for application-level
    /// background work (polling, cleanup, periodic sync) that must participate
    /// in graceful shutdown.
    pub fn spawn_task<F>(&self, task: F)
    where
        F: Future<Output = ()> + Send + 'static,
    {
        let handle = tokio::spawn(task);
        self.tasks.lock().unwrap().push(handle);
    }

