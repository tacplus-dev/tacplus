// obtainTLSCert generates a local ECDSA P-256 keypair, calls X509Mint to get a
// signed certificate chain, and stores the result for the gRPC server.
func (bc *ServiceManager) obtainTLSCert() error {
	// 1. Generate ECDSA P-256 keypair (universally supported by TLS libraries,
	// including Netty/BoringSSL clients that lack Ed25519 TLS support).
	priv, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	if err != nil {
		return fmt.Errorf("generating ECDSA P-256 keypair: %w", err)
	}
	pub := priv.Public()

	// 2. Build public key proto (PKIX-encoded, base64url)
	pubKeyDER, err := x509.MarshalPKIXPublicKey(pub)
	if err != nil {
		return fmt.Errorf("marshaling public key: %w", err)
	}
	pubKeyBase64 := base64.RawURLEncoding.EncodeToString(pubKeyDER)
	pubKeyProto := &key_pb.PublicKey{
		Id:     serviceAudience + "-tls",
		Base64: pubKeyBase64,
	}

	// 3. Build X509MintRequest
	now := time.Now()
	// Build the SPIFFE URI SAN through the canonical helper:
	// spiffe://<td>/system/<location...>/services/<service>. No empty-trust-domain
	// tolerance — NewServiceManager refuses an empty spiffe_trust_domain at
	// construction (ErrMissingTrustDomain), so bc cannot exist without one, and
	// ServiceSpiffeID rejects it too. Minting a cert with NO SPIFFE URI SAN
	// instead of failing would be the fail-open shape (NEW-21).
	spiffeId, err := wrapperSpiffe.ServiceSpiffeID(bc.config.GetSpiffeTrustDomain(), bc.config.GetLocationPath(), serviceAudience)
	if err != nil {
		return fmt.Errorf("building service SPIFFE identity for URI SAN: %w", err)
	}
	uriSans := []string{spiffeId}
	certReq := &x509_pb.X509CertRequest{
		Key:         pubKeyProto,
		Exp:         now.Add(24 * time.Hour).Unix(),
		Issuer:      serviceAudience,
		KeyUsage:    x509_pb.X509KeyUsage_X509_KEY_USAGE_DIGITAL_SIGNATURE,
		ExtKeyUsage: []x509_pb.X509ExtKeyUsage{
			x509_pb.X509ExtKeyUsage_X509_EXT_KEY_USAGE_SERVER_AUTH,
			x509_pb.X509ExtKeyUsage_X509_EXT_KEY_USAGE_CLIENT_AUTH,
		},
		DnsNames: func() []string {
			names := []string{serviceAudience, "*." + serviceAudience}
			if hostname, err := os.Hostname(); err == nil && hostname != "" {
				names = append(names, hostname)
			}
			return names
		}(),
		UriSans: uriSans,
	}

	mintReq := &common_pb.X509MintRequest{
		Aud:         serviceAudience,
		CertRequest: certReq,
	}

	// 4. Call X509Mint via the active connection
	conn := bc.ActiveConn()
	if conn == nil {
		return fmt.Errorf("no active connection for X509Mint")
	}
	mintClient := cluster_svc_pb.New{{.MintServiceName}}Client(conn)
	mintCtx, mintCancel := context.WithTimeout(bc.ctx, exchangeTimeout)
	defer mintCancel()

	certChain, err := mintClient.{{.X509MintMethod}}(mintCtx, mintReq)
	if err != nil {
		return fmt.Errorf("X509Mint RPC: %w", err)
	}

	// 5. Store the cert chain and private key (protected for concurrent renewal)
	bc.mu.Lock()
	bc.tlsCertChain = certChain
	bc.tlsPrivKey = priv
	bc.mu.Unlock()

	zap.L().Info("Auto-obtained TLS certificate via X509Mint",
		zap.String("service", serviceAudience),
		zap.Int("chain_length", len(certChain.GetChain())))

	return nil
}

func (bc *ServiceManager) tlsCertExpiry() (time.Time, error) {
	bc.mu.RLock()
	chain := bc.tlsCertChain
	bc.mu.RUnlock()
	if chain == nil || len(chain.GetChain()) == 0 {
		return time.Time{}, fmt.Errorf("no active TLS certificate chain")
	}
	leaf, err := wrapperX509.NewImmutableX509Cert(chain.GetChain()[0])
	if err != nil {
		return time.Time{}, fmt.Errorf("parsing active TLS leaf: %w", err)
	}
	return leaf.X509Certificate().NotAfter, nil
}

func tlsCertRenewalDelay(expiry time.Time) time.Duration {
	if expiry.IsZero() {
		return tlsCertRenewalFallbackInterval
	}
	delay := time.Until(expiry.Add(-tlsCertRenewalLeadTime))
	if delay < 0 {
		return 0
	}
	return delay
}

func tlsRenewalRetryWait(ctx context.Context, backoff *time.Duration) bool {
	jitter := time.Duration(mrand.Int63n(int64(*backoff)/4 + 1))
	select {
	case <-time.After(*backoff + jitter):
	case <-ctx.Done():
		return false
	}
	if *backoff < tlsCertRenewalRetryMaxBackoff {
		*backoff *= 2
		if *backoff > tlsCertRenewalRetryMaxBackoff {
			*backoff = tlsCertRenewalRetryMaxBackoff
		}
	}
	return ctx.Err() == nil
}

// tlsRenewalLoop re-obtains the TLS certificate before expiry and retries
// transient renewal failures with capped backoff.
func (bc *ServiceManager) tlsRenewalLoop() {
	for {
		expiry, expErr := bc.tlsCertExpiry()
		wait := tlsCertRenewalFallbackInterval
		if expErr == nil {
			wait = tlsCertRenewalDelay(expiry)
		} else {
			zap.L().Warn("Could not determine TLS cert expiry; using fallback renewal interval",
				zap.Error(expErr),
				zap.Duration("retry_in", wait))
		}

		select {
		case <-bc.ctx.Done():
			return
		case <-time.After(wait):
		}

		backoff := tlsCertRenewalRetryInitialBackoff
		for {
			if err := bc.obtainTLSCert(); err != nil {
				expiry, expErr := bc.tlsCertExpiry()
				if expErr == nil && time.Until(expiry) <= tlsCertRenewalEscalationWindow {
					zap.L().Error("TLS certificate renewal failed inside escalation window; shutting down ServiceManager",
						zap.Error(err),
						zap.Time("expires_at", expiry),
						zap.Duration("remaining", time.Until(expiry)))
					bc.cancel()
					return
				}
				zap.L().Warn("Failed to renew TLS cert; retrying",
					zap.Error(err),
					zap.Duration("retry_in", backoff))
				if !tlsRenewalRetryWait(bc.ctx, &backoff) {
					return
				}
				continue
			}
			zap.L().Info("TLS certificate renewed via X509Mint")
			break
		}
	}
}

// ActiveConn returns the active (lowest-latency healthy) gRPC connection.
func (bc *ServiceManager) ActiveConn() *grpc.ClientConn {
	bc.mu.RLock()
	defer bc.mu.RUnlock()
	if bc.active != nil {
		if conn := bc.active.getConn(); conn != nil {
			return conn
		}
	}
	// Fallback: return first connected endpoint
	for _, ec := range bc.endpoints {
		if conn := ec.getConn(); conn != nil {
			return conn
		}
	}
	return nil
}

// Conn returns the active gRPC connection (alias for ActiveConn for compatibility).
func (bc *ServiceManager) Conn() *grpc.ClientConn { return bc.ActiveConn() }

// CreateChannel creates a new TLS-enabled gRPC connection to the specified target (host:port).
// Uses the same TLS and auth configuration as the bootstrap connection.
func (bc *ServiceManager) CreateChannel(target string) (*grpc.ClientConn, error) {
	return grpc.NewClient(target, bc.dialOpts...)
}

// InstanceID returns the unique identifier for this node/replica.
func (bc *ServiceManager) InstanceID() string { return bc.config.GetInstanceId() }

// Close stops all background goroutines and closes all connections.
func (bc *ServiceManager) Close() error {
	if bc == nil {
		return nil
	}
	if bc.cancel != nil {
	bc.cancel()
	}
	if bc.logCancel != nil {
		bc.logCancel()
	}
	if bc.subCancel != nil {
		bc.subCancel()
	}
	if bc.jwkCancel != nil {
		bc.jwkCancel()
	}
	return bc.closeAll()
}

// ---------------------------------------------------------------------------
// Connection pool internals
// ---------------------------------------------------------------------------

// selectActive picks the lowest-latency healthy endpoint as active.
func (bc *ServiceManager) selectActive() {
	bc.mu.Lock()
	defer bc.mu.Unlock()

	var best *endpointConn
	var bestLatency time.Duration = math.MaxInt64
	for _, ec := range bc.endpoints {
		if ec.isHealthy() && ec.getLatency() < bestLatency {
			best = ec
			bestLatency = ec.getLatency()
		}
	}

	if best == nil {
		if bc.active != nil {
			zap.L().Warn("No healthy endpoints available")
		}
		return
	}

	// Hysteresis only applies when the current active is still a live member
	// of the pool: healthy, still connected, and still in bc.endpoints
	// (ReconcileEndpoints may have removed and closed it). A closed or removed
	// active must always be replaced — otherwise ActiveConn would keep
	// returning a closed ClientConn forever.
	activeAlive := false
	if bc.active != nil && bc.active.isHealthy() && bc.active.getConn() != nil {
		for _, ec := range bc.endpoints {
			if ec == bc.active {
				activeAlive = true
				break
			}
		}
	}

	// If current active is still alive, only switch if the new endpoint
	// is significantly faster (hysteresis to prevent flip-flopping).
	if activeAlive && best != bc.active {
		currentLatency := bc.active.getLatency()
		improvement := float64(currentLatency-bestLatency) / float64(currentLatency)
		if improvement < rebalanceThreshold {
			return // not enough improvement to justify switching
		}
	}

	if best != bc.active {
		prev := "<none>"
		if bc.active != nil {
			prev = bc.active.target
		}
		bc.active = best
		zap.L().Info("Active connection changed",
			zap.String("from", prev),
			zap.String("to", best.target),
			zap.Duration("latency", bestLatency))
	}
}

// activeTarget returns the target string of the active endpoint.
func (bc *ServiceManager) activeTarget() string {
	bc.mu.RLock()
	defer bc.mu.RUnlock()
	if bc.active != nil {
		return bc.active.target
	}
	return "<none>"
}

// pingLoop periodically pings all endpoints to measure latency.
func (bc *ServiceManager) pingLoop(interval time.Duration) {
	ticker := time.NewTicker(interval)
	defer ticker.Stop()
	for {
		select {
		case <-bc.ctx.Done():
			return
		case <-ticker.C:
			bc.mu.RLock()
			eps := make([]*endpointConn, len(bc.endpoints))
			copy(eps, bc.endpoints)
			bc.mu.RUnlock()
			for _, ec := range eps {
				if ec.getConn() == nil {
					continue
				}
				pingCtx, cancel := context.WithTimeout(bc.ctx, 5*time.Second)
				if err := ec.ping(pingCtx); err != nil {
					zap.L().Warn("Ping failed",
						zap.String("endpoint", ec.target),
						zap.Error(err))
				}
				cancel()
			}
		}
	}
}

// rebalanceLoop periodically re-evaluates which endpoint should be active.
func (bc *ServiceManager) rebalanceLoop(interval time.Duration) {
	ticker := time.NewTicker(interval)
	defer ticker.Stop()
	for {
		select {
		case <-bc.ctx.Done():
			return
		case <-ticker.C:
			bc.selectActive()
		}
	}
}

// startLogStream maintains the ClusterService.Log stream, reconnecting with
// capped backoff + jitter on any failure. The connection is re-acquired from
// the pool on every attempt so the stream survives endpoint failover and
// runtime-config reconciliation. Exits only on shutdown.
func (bc *ServiceManager) startLogStream() {
	logCtx, logCancel := context.WithCancel(bc.ctx)
	bc.logCancel = logCancel

	go func() {
		l := zap.L().With(zap.String("source", "cluster"))
		backoff := streamInitialBackoff
		for logCtx.Err() == nil {
			conn := bc.ActiveConn()
			if conn == nil {
				zap.L().Warn("No active connection for Log stream, retrying",
					zap.Duration("retry_in", backoff))
				if !streamRetryWait(logCtx, &backoff) {
					return
				}
				continue
			}
			client := grpcconfig_pb.NewClusterServiceClient(conn)
			stream, err := client.Log(logCtx, &trace_pb.TraceRequest{})
			if err != nil {
				zap.L().Warn("Failed to start Log stream, retrying",
					zap.Error(err), zap.Duration("retry_in", backoff))
				if !streamRetryWait(logCtx, &backoff) {
					return
				}
				continue
			}
			// Reset on the first delivered frame, not on the open -- opening a
			// server-streaming RPC does not contact the server, so a stream that
			// fails immediately would otherwise retry at streamInitialBackoff
			// forever. See the WatchJwks loop below for the case where that
			// actually happened.
			delivered := false
			for {
				msg, err := stream.Recv()
				if err != nil {
					if logCtx.Err() != nil {
						return
					}
					if err != io.EOF {
						l.Warn("Log stream ended, reconnecting", zap.Error(err))
					}
					break
				}
				if !delivered {
					delivered = true
					backoff = streamInitialBackoff
				}
				text := msg.GetMessage()
				switch msg.GetLevel() {
				case logger_pb.Level_LEVEL_TRACE, logger_pb.Level_LEVEL_DEBUG:
					l.Debug(text)
				case logger_pb.Level_LEVEL_INFO:
					l.Info(text)
				case logger_pb.Level_LEVEL_WARN:
					l.Warn(text)
				case logger_pb.Level_LEVEL_ERROR:
					l.Error(text)
				default:
					l.Info(text)
				}
			}
			if !streamRetryWait(logCtx, &backoff) {
				return
			}
		}
	}()
}

// startSubscribe maintains the ClusterService.Subscribe stream, reconnecting
// with capped backoff + jitter on any failure. The connection is re-acquired
// from the pool on every attempt. Exits only on shutdown.
func (bc *ServiceManager) startSubscribe() {
	subCtx, subCancel := context.WithCancel(bc.ctx)
	bc.subCancel = subCancel

	go func() {
		backoff := streamInitialBackoff
		for subCtx.Err() == nil {
			conn := bc.ActiveConn()
			if conn == nil {
				zap.L().Warn("No active connection for Subscribe stream, retrying",
					zap.Duration("retry_in", backoff))
				if !streamRetryWait(subCtx, &backoff) {
					return
				}
				continue
			}
			client := grpcconfig_pb.NewClusterServiceClient(conn)
			stream, err := client.Subscribe(subCtx, &trace_pb.TraceRequest{})
			if err != nil {
				zap.L().Warn("Failed to start Subscribe stream, retrying",
					zap.Error(err), zap.Duration("retry_in", backoff))
				if !streamRetryWait(subCtx, &backoff) {
					return
				}
				continue
			}
			// Reset on the first delivered frame, not on the open. Same reason as
			// the Log stream above.
			delivered := false
			for {
				state, err := stream.Recv()
				if err != nil {
					if subCtx.Err() != nil {
						return
					}
					if err != io.EOF {
						zap.L().Warn("Subscribe stream ended, reconnecting", zap.Error(err))
					}
					break
				}
				if !delivered {
					delivered = true
					backoff = streamInitialBackoff
				}
				zap.L().Info("Received cluster state update",
					zap.Int("clusters", len(state.GetClusters())))
				// Re-evaluate active connection based on new topology
				bc.selectActive()
			}
			if !streamRetryWait(subCtx, &backoff) {
				return
			}
		}
	}()
}

// startWatchJwks maintains the ClusterService.WatchJwks stream and keeps the
// local JWK cache up to date. It reconnects with capped backoff + jitter on
// any failure, re-acquiring the connection from the pool on every attempt —
// a single stream blip must not leave the JWK cache permanently stale (key
// rotation would then break all token verification). Exits only on shutdown.
func (bc *ServiceManager) startWatchJwks() {
	jwkCtx, jwkCancel := context.WithCancel(bc.ctx)
	bc.jwkCancel = jwkCancel

	go func() {
		backoff := streamInitialBackoff
		for jwkCtx.Err() == nil {
			conn := bc.ActiveConn()
			if conn == nil {
				zap.L().Warn("No active connection for WatchJwks stream, retrying",
					zap.Duration("retry_in", backoff))
				if !streamRetryWait(jwkCtx, &backoff) {
					return
				}
				continue
			}
			client := grpcconfig_pb.NewClusterServiceClient(conn)
			stream, err := client.WatchJwks(jwkCtx, &trace_pb.TraceRequest{})
			if err != nil {
				zap.L().Warn("Failed to start WatchJwks stream — token verification may fail, retrying",
					zap.Error(err), zap.Duration("retry_in", backoff))
				if !streamRetryWait(jwkCtx, &backoff) {
					return
				}
				continue
			}
			// Backoff is reset on the first DELIVERED frame, not here.
			//
			// Opening a server-streaming RPC does not contact the server, so
			// client.WatchJwks above returns a stream handle with a nil error even
			// when the method does not exist. The failure only appears on Recv.
			// Resetting the backoff on the open therefore reset it on every single
			// attempt, and the delay never grew past streamInitialBackoff: a server
			// that answers UNIMPLEMENTED produced a steady ~1 reconnect per second,
			// forever. That is exactly what kernel does -- it serves ClusterService
			// but never implemented WatchJwks -- and graphdb and opa each logged
			// ~213 warnings every four minutes for it.
			delivered := false
			for {
				jwks, err := stream.Recv()
				if err != nil {
					if jwkCtx.Err() != nil {
						return
					}
					if err != io.EOF {
						// Separate the "server does not have this method" case. It
						// cannot be fixed by reconnecting, and saying so once is worth
						// more than the same generic line at the backoff cap.
						if status.Code(err) == codes.Unimplemented {
							zap.L().Warn("WatchJwks is not implemented by the cluster service — "+
								"the JWKS cache will not be refreshed by this stream",
								zap.Error(err), zap.Duration("retry_in", backoff))
						} else {
							zap.L().Warn("WatchJwks stream ended — reconnecting to keep JWKS cache fresh", zap.Error(err))
						}
					}
					break
				}
				if !delivered {
					delivered = true
					backoff = streamInitialBackoff
				}
				bc.jwkMu.Lock()
				bc.jwkCache = jwks.GetKeys()
				bc.jwkMu.Unlock()
				zap.L().Info("JWKS cache updated", zap.Int("keys", len(jwks.GetKeys())))
			}
			if !streamRetryWait(jwkCtx, &backoff) {
				return
			}
		}
	}()
}

// ---------------------------------------------------------------------------
// Context helpers
// ---------------------------------------------------------------------------

// GrpcRequestIDHeader is the gRPC metadata key for request tracing.
const GrpcRequestIDHeader = "x-request-id"

// Caller represents the authenticated caller of a gRPC method.
// It wraps the verified token and is designed to be extended with future
// capabilities (delegation chains, audit context) without changing
// handler method signatures.
//
// Caller is nil when a method has disable_auth = true and no token is present.
type Caller struct {
	token     *wrapperToken.TokenWrapper
	requestID string
}

// NewCaller creates a Caller from a verified token.
// The signature is cleared so handler code cannot access the raw signature
// via Token().Proto().Signature.
func NewCaller(token *wrapperToken.TokenWrapper, requestID string) *Caller {
	token.Proto().Signature = ""
	return &Caller{token: token, requestID: requestID}
}

// Token returns the verified JWT token.
func (c *Caller) Token() *wrapperToken.TokenWrapper {
	return c.token
}

// RequestID returns the x-request-id forwarded from the gateway.
func (c *Caller) RequestID() string {
	return c.requestID
}

// RequestIDFromContext extracts the x-request-id from incoming gRPC metadata.
func RequestIDFromContext(ctx context.Context) string {
	md, ok := metadata.FromIncomingContext(ctx)
	if !ok {
		return ""
	}
	vals := md.Get(GrpcRequestIDHeader)
	if len(vals) == 0 {
		return ""
	}
	return vals[0]
}

// closeAll closes all endpoint connections.
func (bc *ServiceManager) closeAll() error {
	var firstErr error
	for _, ec := range bc.endpoints {
		if err := ec.close(); err != nil && firstErr == nil {
			firstErr = err
		}
	}
	return firstErr
}

// ReconcileEndpoints reconciles the connection pool against the given runtime
// endpoint list. New endpoints are connected; removed endpoints are closed.
func (bc *ServiceManager) ReconcileEndpoints(newHosts []*host_pb.Host) {
	if len(newHosts) == 0 {
		return
	}

	// Build target set from new config
	newTargets := make(map[string]struct{}, len(newHosts))
	for _, h := range newHosts {
		newTargets[fmt.Sprintf("%s:%d", h.Host, h.Port)] = struct{}{}
	}

	bc.mu.Lock()

	// Build current target set
	currentTargets := make(map[string]*endpointConn, len(bc.endpoints))
	for _, ec := range bc.endpoints {
		currentTargets[ec.target] = ec
	}

	// Identify new endpoints to add
	var toAdd []string
	for target := range newTargets {
		if _, exists := currentTargets[target]; !exists {
			toAdd = append(toAdd, target)
		}
	}

	// Partition existing: keep vs close
	var kept []*endpointConn
	var toClose []*endpointConn
	for _, ec := range bc.endpoints {
		if _, exists := newTargets[ec.target]; exists {
			kept = append(kept, ec)
		} else {
			toClose = append(toClose, ec)
		}
	}

	// Dial new endpoints
	for _, target := range toAdd {
		ec := newEndpointConn(target)
		if err := ec.dial(bc.dialOpts); err != nil {
			zap.L().Warn("Failed to connect to new endpoint",
				zap.String("target", target),
				zap.Error(err))
		} else {
			kept = append(kept, ec)
			zap.L().Info("Connected to new endpoint", zap.String("target", target))
		}
	}

	bc.endpoints = kept

	// If the active endpoint was removed from the runtime config, clear it so
	// selectActive immediately promotes a live endpoint instead of leaving a
	// soon-to-be-closed connection as active forever.
	for _, ec := range toClose {
		if bc.active == ec {
			bc.active = nil
			zap.L().Info("Active endpoint removed by runtime config",
				zap.String("target", ec.target))
			break
		}
	}
	bc.mu.Unlock()

	// Close removed endpoints outside lock
	for _, ec := range toClose {
		zap.L().Info("Closing removed endpoint", zap.String("target", ec.target))
		ec.close()
	}

	// Re-evaluate active connection
	bc.selectActive()
}
