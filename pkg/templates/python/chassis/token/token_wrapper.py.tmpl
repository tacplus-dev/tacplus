        """
        # Import here to avoid circular imports
        from ..key.key import ImmutableKey

        if self.get_expiration() <= 0:
            raise invalid_argument("token is missing expiration")

        # Mint-time namespace requirement: every token carries the tenant it
        # belongs to. The namespace claim is what the generated
        # (spec.namespace)/(spec.store_namespace) isolation seams compare
        # against, so a token minted without one is a token no record read can
        # be held to.
        if not self.get_namespace():
            raise invalid_argument("token is missing namespace")

        self.set_kid(key.proto().id)
        self.set_alg(key.alg())
        self.set_typ("JWT")

        raw_header = _json_base64url_encode(self._header)
        # Build typed payload: numeric claims as clean integers, rest as strings.
        # Conservative output: always decimal integers.
        # Liberal input: accept scientific notation. Reject fractional values.
        _NUMERIC_CLAIMS = {"exp", "iat", "nbf"}
        typed_payload = {}
        for k, v in self._payload.items():
            if k in _NUMERIC_CLAIMS:
                try:
                    typed_payload[k] = int(v)
                except (ValueError, TypeError):
                    f = float(v)
                    if f != int(f):
                        raise ValueError(f"fractional value not allowed for {k}: {v}")
                    typed_payload[k] = int(f)
            elif isinstance(v, (dict, list)):
                typed_payload[k] = v
            elif isinstance(v, str) and v and v[0] in ('{', '['):
                try:
                    typed_payload[k] = json.loads(v)
                except (json.JSONDecodeError, ValueError):
                    typed_payload[k] = v
            else:
                typed_payload[k] = v
        raw_payload = _json_base64url_encode(typed_payload)
        signing_input = f"{raw_header}.{raw_payload}"
        signing_input_bytes = signing_input.encode("ascii")

        private_key = key.private_key()
        alg = key.alg()

        try:
            if isinstance(private_key, RSAPrivateKey):
                hash_alg = _get_rsa_hash(alg)
                sig_bytes = private_key.sign(
                    signing_input_bytes,
                    padding.PKCS1v15(),
                    hash_alg,
                )
            elif isinstance(private_key, EllipticCurvePrivateKey):
                hash_alg = _get_ec_hash(alg)
                der_sig = private_key.sign(signing_input_bytes, ECDSA(hash_alg))
                # Convert DER signature to raw r||s format for JWT
                key_size_bits = private_key.curve.key_size
                key_size_bytes = (key_size_bits + 7) // 8
                r, s = asym_utils.decode_dss_signature(der_sig)
                sig_bytes = (
                    r.to_bytes(key_size_bytes, byteorder="big")
                    + s.to_bytes(key_size_bytes, byteorder="big")
                )
            elif isinstance(private_key, Ed25519PrivateKey):
                sig_bytes = private_key.sign(signing_input_bytes)
            else:
                raise internal(f"unsupported private key type: {type(private_key).__name__}")
        except ProtoError:
            raise
        except Exception as e:
            raise internal(f"failed to sign token: {e}")

        signature = _base64url_encode(sig_bytes)
        self._signature = signature
        self._base64 = f"{signing_input}.{signature}"
        self.mark_immutable()
        self._sync_proto()

        logger.debug("Token signed, kid=%s, alg=%s", self.get_kid(), alg)

    # ========================================
    # Verify
    # ========================================

    def verify(self, jwk: "ImmutableJwk") -> None:
        """
        Verify the token's signature and claims using the provided JWK.

        Validates:
        1. Required claims are present (iss, kid, alg, exp, signature)
        2. The header alg is one the JWK accepts (jwk.accepted_algs())
        3. Token has not expired
        4. Signature is valid against the JWK's public key, using that alg

        Args:
            jwk: An ImmutableJwk containing the public key for verification.

        Raises:
            ProtoError: If verification fails for any reason.
        """
        # Import here to avoid circular imports
        from ..jwk.jwk import ImmutableJwk

        if not self._base64:
            raise invalid_argument("token missing base64 encoding")

        parsed = self.parse(self._base64)
        self._token = parsed._token
        self._header = parsed._header
        self._payload = parsed._payload
        self._signature = parsed._signature
        self._base64 = parsed._base64
        self._immutable = True

        issuer = self.get_issuer()
        if not issuer:
            raise invalid_argument("token missing issuer (iss) claim")

        kid = self.get_kid()
        if not kid:
            raise invalid_argument("token missing key ID (kid) in header")

        # The key decides which algs it accepts; the token's alg only picks one
        # of them, and that alg (never the key's) fixes the hash below.
        alg = self.get_alg()
        if not isinstance(alg, str) or not alg:
            raise invalid_argument("token missing signing algorithm (alg) in header")
        accepted = jwk.accepted_algs()
        if alg not in accepted:
            raise unauthenticated(
                f"token alg {alg!r} is not accepted by JWK {jwk.kid()} "
                f"(accepts {', '.join(accepted)})"
            )

        if not self._signature:
            raise invalid_argument("token missing signature")

        exp = self.get_expiration()
        if exp <= 0:
            raise invalid_argument("token missing or invalid expiration (exp) claim")

        CLOCK_SKEW_SECONDS = 60

        now = int(time.time())
        if now >= exp + CLOCK_SKEW_SECONDS:
            raise unauthenticated("token has expired")

        # Check not-before claim
        nbf_val = self._payload.get("nbf")
        if nbf_val is not None:
            try:
                nbf = int(nbf_val)
                if now < nbf - CLOCK_SKEW_SECONDS:
                    raise unauthenticated("token not yet valid")
            except (ValueError, TypeError):
                pass

        # Extract the signing input (header.payload) from the JWT
        last_dot = self._base64.rfind(".")
        if last_dot == -1:
            raise invalid_argument("invalid JWT format: missing dot separator")

        signing_input = self._base64[:last_dot].encode("ascii")

        # Decode signature
        try:
            sig_bytes = _base64url_decode(self._signature)
        except Exception as e:
            raise invalid_argument(f"invalid signature base64 encoding: {e}")

        public_key = jwk.public_key()

        try:
            if alg in _RSA_VERIFY_ALGS and isinstance(public_key, RSAPublicKey):
                hash_alg = _get_rsa_hash(alg)
                public_key.verify(
                    sig_bytes,
                    signing_input,
                    padding.PKCS1v15(),
                    hash_alg,
                )
            elif alg in _EC_VERIFY_ALGS and isinstance(public_key, EllipticCurvePublicKey):
                hash_alg = _get_ec_hash(alg)
                # Convert raw r||s signature back to DER format
                key_size_bits = public_key.curve.key_size
                key_size_bytes = (key_size_bits + 7) // 8
                if len(sig_bytes) != 2 * key_size_bytes:
                    raise invalid_argument(
                        f"invalid EC signature length: got {len(sig_bytes)}, "
                        f"expected {2 * key_size_bytes}"
                    )
                r = int.from_bytes(sig_bytes[:key_size_bytes], byteorder="big")
                s = int.from_bytes(sig_bytes[key_size_bytes:], byteorder="big")
                der_sig = asym_utils.encode_dss_signature(r, s)
                public_key.verify(der_sig, signing_input, ECDSA(hash_alg))
            elif alg == "EdDSA" and isinstance(public_key, Ed25519PublicKey):
                public_key.verify(sig_bytes, signing_input)
            else:
                raise unauthenticated(
                    f"alg {alg!r} cannot verify with a {type(public_key).__name__}"
                )
        except ProtoError:
            raise
        except Exception as e:
            raise unauthenticated(f"token signature verification failed: {e}")

        self._sync_proto()
        logger.debug("Token verified, kid=%s", kid)


# ========================================
# Private Utility Functions
# ========================================


# Algs verify() dispatches on, per key family; anything else is refused.
_RSA_VERIFY_ALGS = ("RS256", "RS384", "RS512")
_EC_VERIFY_ALGS = ("ES256", "ES384", "ES512")


def _get_rsa_hash(alg: str) -> hashes.HashAlgorithm:
    """Return the hash algorithm for an RSA (PKCS#1 v1.5) signing algorithm."""
    if alg == "RS256":
        return hashes.SHA256()
    elif alg == "RS384":
        return hashes.SHA384()
    elif alg == "RS512":
        return hashes.SHA512()
    else:
        raise internal(f"unsupported RSA algorithm: {alg}")


def _get_ec_hash(alg: str) -> hashes.HashAlgorithm:
    """Return the hash algorithm for an EC signing algorithm."""
    if alg == "ES256":
        return hashes.SHA256()
    elif alg == "ES384":
        return hashes.SHA384()
    elif alg == "ES512":
        return hashes.SHA512()
    else:
        raise internal(f"unsupported EC algorithm: {alg}")
