// imInitialExchangeWithRetry retries the given exchange function with exponential backoff
// until it succeeds, the context is cancelled, or the 5-minute total timeout expires.
// Initial delay: 2s, max delay: 30s, doubling each attempt.
func imInitialExchangeWithRetry(ctx context.Context, exchange func() (string, error)) error {
	const (
		initialDelay = 2 * time.Second
		maxDelay     = 30 * time.Second
		totalTimeout = 5 * time.Minute
	)
	start := time.Now()
	deadline := start.Add(totalTimeout)
	delay := initialDelay
	attempt := 0
	for {
		attempt++
		_, err := exchange()
		if err == nil {
			return nil
		}
		elapsed := time.Since(start)
		if time.Now().After(deadline) {
			zap.L().Error("IdentityManager: initial token exchange timed out",
				zap.Int("attempts", attempt),
				zap.Duration("elapsed", elapsed),
				zap.Duration("timeout", totalTimeout),
				zap.Error(err))
			return fmt.Errorf("timed out waiting for initial token exchange after %d attempts (%s): %w", attempt, elapsed.Round(time.Second), err)
		}
		zap.L().Warn("IdentityManager: initial token exchange failed, retrying",
			zap.Int("attempt", attempt),
			zap.Duration("elapsed", elapsed),
			zap.Duration("next_retry_in", delay),
			zap.Error(err))
		select {
		case <-ctx.Done():
			zap.L().Error("IdentityManager: initial token exchange aborted",
				zap.Int("attempts", attempt),
				zap.Duration("elapsed", elapsed),
				zap.NamedError("last_error", err))
			return fmt.Errorf("context cancelled during initial token exchange after %d attempts (%s): %w", attempt, elapsed.Round(time.Second), err)
		case <-time.After(delay):
		}
		delay *= 2
		if delay > maxDelay {
			delay = maxDelay
		}
	}
}

