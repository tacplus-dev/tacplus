[package]
name = "x509"
version = "0.1.0"
edition = "2021"
description = "X.509 certificate management"

[dependencies]
key = { path = "../key" }
# spiffe provides the canonical SPIFFE ID parser used by verify_service_name to
# match a service SAN by its parsed SubjectKind/SubjectPath (never ad-hoc string
# splitting). spiffe has no deps back into x509, so this is not a cycle.
spiffe = { path = "../spiffe" }
base64 = "0.22"
# "builder" pulls in the CertificateBuilder; "hazmat" enables Profile::Manual,
# which is required to control the exact cert shape (subject/issuer/KeyUsage/
# extensions) for parity with the Go/Java signers. Without hazmat, x509-cert
# injects its own opinionated extension set and derives KeyUsage from the
# Profile rather than from the request.
x509-cert = { version = "0.2", features = ["builder", "hazmat"] }
# der/spki/const-oid are re-exported by x509-cert but named directly here for
# the signer (SubjectPublicKeyInfoOwned, BitString, SerialNumber, custom OID).
der = "0.7"
spki = "0.7"
const-oid = "0.9"
# ecdsa "der" feature provides the DER-encoded ECDSA signature form that X.509
# certificates require (vs the fixed-size form).
ecdsa = { version = "0.16", features = ["der"] }
# rsa "sha2" feature provides the PKCS#1 v1.5 SigningKey<Sha384/Sha512>.
rsa = { version = "0.9", features = ["sha2"] }
p256 = "0.13"
p384 = "0.13"
ed25519-dalek = { version = "2", features = ["pkcs8"] }
sha2 = "0.10"
signature = "2"
rand = "0.8"
pem = "3"
serde = { version = "1", features = ["derive"] }
rustls = { version = "0.23", default-features = false, features = ["ring", "std"] }
