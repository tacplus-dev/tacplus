impl {{.StateRootName}}ClientInner {
    fn close(&self) {
        if !self.closed.swap(true, Ordering::SeqCst) {
            self.close_notify.notify_waiters();
        }
    }

    #[allow(dead_code)]
    fn is_closed(&self) -> bool {
        self.closed.load(Ordering::SeqCst)
    }

{{- if $hasWatches}}
    fn record_watch_healthy(&self, watch_name: &str, received: bool) {
        self.set_watch_status(WatchStatus {
            watch_name: watch_name.to_string(),
            received,
            retrying: false,
            next_attempt: 0,
            reason: String::new(),
            error: None,
            updated_at_millis: Self::now_millis(),
        });
    }

    fn record_watch_retrying(
        &self,
        watch_name: &str,
        received: bool,
        next_attempt: u32,
        reason: impl Into<String>,
        error: Option<String>,
    ) {
        self.set_watch_status(WatchStatus {
            watch_name: watch_name.to_string(),
            received,
            retrying: true,
            next_attempt,
            reason: reason.into(),
            error,
            updated_at_millis: Self::now_millis(),
        });
    }

    fn set_watch_status(&self, status: WatchStatus) {
        self.watch_statuses
            .write()
            .unwrap()
            .insert(status.watch_name.clone(), status.clone());
        if let Some(listener) = self.watch_status_listener.read().unwrap().clone() {
            let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| listener(status)));
        }
    }

    fn now_millis() -> u128 {
        std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .map(|d| d.as_millis())
            .unwrap_or(0)
    }
{{- end}}
}

// ==================== Watch Stream Receivers & RPC Helpers ====================
{{if or .Singletons .Collections .StateImports}}
impl {{.StateRootName}}ClientInner {
    /// Creates a tonic::Request with an authorization header if a token provider is set.
    async fn authorized_request<T>(&self, msg: T) -> Result<tonic::Request<T>, tonic::Status> {
        let mut req = tonic::Request::new(msg);
        if let Some(ref tp) = self.token_provider {
            let token = tp()
                .await
                .map_err(|e| tonic::Status::unauthenticated(format!("token provider failed: {e}")))?;
            let val = format!("Bearer {}", token)
                .parse()
                .map_err(|e| tonic::Status::unauthenticated(format!("invalid authorization metadata: {e}")))?;
            req.metadata_mut().insert("authorization", val);
        }
        Ok(req)
    }

    fn watch_retry_delay(attempt: u32) -> std::time::Duration {
        let capped = attempt.min(5);
        let secs = (1u64 << capped).min(30);
        let jitter_span_ms = (secs * 200).max(1);
        let jitter_ms = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .map(|d| (d.subsec_nanos() as u64) % jitter_span_ms)
            .unwrap_or(0);
        std::time::Duration::from_secs(secs) + std::time::Duration::from_millis(jitter_ms)
    }

    async fn sleep_before_watch_retry(&self, attempt: u32) -> bool {
        if self.is_closed() {
            return false;
        }
        tokio::select! {
            _ = self.close_notify.notified() => false,
            _ = tokio::time::sleep(Self::watch_retry_delay(attempt)) => !self.is_closed(),
        }
    }
{{if .Singletons}}
    /// Bounds a singleton fetch's validate-retry loop.
    fn config_fetch_timeout(&self) -> std::time::Duration {
        let secs = self.config_fetch_timeout_secs.load(Ordering::SeqCst);
        std::time::Duration::from_secs(if secs == 0 { 30 } else { secs })
    }

    /// Waits the watch-restart backoff for `attempt`, clamped to what is left of
    /// the fetch budget. Returns false when the budget is spent or the client closed.
    async fn sleep_before_fetch_retry(&self, attempt: u32, deadline: tokio::time::Instant) -> bool {
        if self.is_closed() {
            return false;
        }
        let remaining = deadline.saturating_duration_since(tokio::time::Instant::now());
        if remaining.is_zero() {
            return false;
        }
        let delay = Self::watch_retry_delay(attempt).min(remaining);
        tokio::select! {
            _ = self.close_notify.notified() => false,
            _ = tokio::time::sleep(delay) => !self.is_closed(),
        }
    }
{{end}}
{{- range .Singletons}}
    /// Watch loop for {{.TypeName}} — reconnects on stream errors.
    async fn watch_{{.FieldName}}_loop(&self) {
        let mut attempt = 0u32;
        loop {
            if self.is_closed() {
                return;
            }
            let made_progress = match self.start_{{.FieldName}}_watch().await {
                Ok(made_progress) => {
                    if self.is_closed() {
                        return;
                    }
                    let next_attempt = if made_progress { 0 } else { attempt.saturating_add(1) };
                    self.record_watch_retrying("Watch{{.FieldPascal}}", made_progress, next_attempt, "stream ended", None);
                    tracing::warn!("{{$.StateRootName}}.{{.FieldName}} watch stream ended, reconnecting");
                    made_progress
                }
                Err(e) => {
                    if self.is_closed() {
                        return;
                    }
                    let reason = e.to_string();
                    // A rejected credential must invalidate the token cache, or
                    // this loop presents the same dead token forever. The cache
                    // is keyed on expiry, and an authority restart invalidates a
                    // token that has NOT expired.
                    service_im::note_if_credential_rejection(&reason).await;
                    self.record_watch_retrying("Watch{{.FieldPascal}}", false, attempt.saturating_add(1), reason.clone(), Some(reason));
                    tracing::error!(error = %e, "{{$.StateRootName}}.{{.FieldName}} watch failed, retrying");
                    false
                }
            };
            if made_progress {
                attempt = 0;
            } else {
                attempt = attempt.saturating_add(1);
            }
            if !self.sleep_before_watch_retry(attempt).await {
                return;
            }
        }
    }

    async fn start_{{.FieldName}}_watch(&self) -> Result<bool, Box<dyn std::error::Error + Send + Sync>> {
        let close = self.close_notify.notified();
        tokio::pin!(close);
        if self.is_closed() {
            return Ok(false);
        }
        let req = tokio::select! {
            _ = &mut close => return Ok(false),
            req = self.authorized_request(Default::default()) => req?,
        };
        if self.is_closed() {
            return Ok(false);
        }
        // Clone the stub and RELEASE the mutex before opening the stream.
        //
        // Holding the guard across the stream is a deadlock: the guard stays in
        // scope for the entire life of the watch loop below, so the first
        // boundary to win the lock keeps it forever and every other watch loop
        // on this client blocks in lock() -- silently, with no error and no log.
        // Observed live: sentinel started only Cluster.grpc_stats; cluster_info,
        // cluster_health, node_metrics and four more never began, so their caches
        // stayed empty and the dashboard failed validation with
        // "field clusterInfo is required".
        //
        // A tonic client is Clone and shares the underlying multiplexed channel,
        // so cloning per watch is cheap and lets every boundary stream at once.
        let mut stub = {
            let guard = tokio::select! {
                _ = &mut close => return Ok(false),
                stub = self.stub.lock() => stub,
            };
            guard.clone()
        };
        if self.is_closed() {
            return Ok(false);
        }
        let response = tokio::select! {
            _ = &mut close => return Ok(false),
            response = stub.watch_{{.FieldName}}(req) => response?,
        };
        let mut stream = response.into_inner();
        let mut received = false;
        self.record_watch_healthy("Watch{{.FieldPascal}}", false);
        // An accepted stream proves the credential is good again; clears the
        // degraded health floor set after repeated rejections.
        service_im::note_credential_accepted();
        tracing::info!("{{$.StateRootName}}.{{.FieldName}} watch stream started");

        loop {
            if self.is_closed() {
                return Ok(received);
            }
            let Some(msg) = (tokio::select! {
                _ = self.close_notify.notified() => return Ok(received),
                msg = stream.next() => msg,
            }) else {
                return Ok(received);
            };
            match msg {
                Ok(value) => {
                    received = true;
                    self.record_watch_healthy("Watch{{.FieldPascal}}", true);
                    let (callbacks, subscribers) = {
                        let mut state = self.state.write().unwrap();
                        state.{{.FieldName}}_cache = Some(value.clone());
                        (
                            state.{{.FieldName}}_callbacks.iter().cloned().collect::<Vec<_>>(),
                            state.{{.FieldName}}_subscribers.iter().cloned().collect::<Vec<_>>(),
                        )
                    };
                    for cb in callbacks {
                        cb(&value);
                    }
                    for sub in subscribers {
                        sub.on_{{.FieldName}}_change(&value);
                    }
                }
                Err(e) => {
                    tracing::warn!(error = %e, "{{$.StateRootName}}.{{.FieldName}} watch stream error");
                    return Err(e.into());
                }
            }
        }
    }
{{- end}}

