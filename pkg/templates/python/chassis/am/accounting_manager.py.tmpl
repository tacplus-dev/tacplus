def _rpc_short_name(enum_value_name: str) -> str:
    """Converts a generated RPC enum's proto value name (e.g.
    "TASKS_RPCS_UPDATE_TASK") into the RPC's own declared name (e.g.
    "UpdateTask"): every such enum's variant is "<SERVICE>_RPCS_<RPC>" in
    SCREAMING_SNAKE_CASE, so drop the "_RPCS_" prefix and re-case the
    remainder to UpperCamelCase."""
    marker = "_RPCS_"
    idx = enum_value_name.find(marker)
    suffix = enum_value_name[idx + len(marker):] if idx >= 0 else enum_value_name
    return "".join(word.capitalize() for word in suffix.split("_") if word)


