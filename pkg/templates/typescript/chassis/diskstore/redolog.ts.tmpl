/**
 * UC2 — append-only redo log (WAL) with periodic compaction.
 *
 * One redo log per `(namespace, store)`, laid out by `path.ts` as
 * `<base>/<ns-dirs>/<store>.log`. Because each log is homogeneous (one ns, one
 * store), records carry only the row `key`, an optional `deleted` tombstone,
 * optional caller-set `metadata`, and the `payload` (the type as JSON). The
 * namespace and store are implied by the file path.
 *
 * Records are NDJSON (one JSON envelope per line — safe to newline-frame since
 * JSON escapes embedded newlines). Compaction ("roll") rewrites the log as the
 * current deduped state plus writes that arrived during the snapshot, then
 * atomically swaps it in (the final rename is the commit point).
 *
 * Note: Node executes synchronous fs calls on a single thread, so a roll and an
 * append cannot interleave; the Rust write-block window is implicit here.
 */
import fs from 'fs';
import nodePath from 'path';
import { Codec, compress, decompressAuto } from './compress.js';
import { DiskStoreError } from './error.js';
import { promote, rotateArchives, sibling, writeTemp } from './fsutil.js';
import { storePath } from './path.js';

/** One redo-log record (the JSON envelope), NDJSON-framed. */
export interface Record {
  /** The `collection_index` value identifying the row within the store. */
  key: string;
  /** True if this records a deletion of `key` (payload omitted). */
  deleted?: boolean;
  /** Optional, caller-set metadata. Never required or auto-populated. */
  metadata?: string;
  /**
   * The type serialized as JSON (absent for deletions). Embedded as a nested
   * JSON value: the generated JSON output is stored in; the deserializer
   * consumes it on restore.
   */
  payload?: unknown;
}

/**
 * Consumer hook for restore. Receives each deduped record; the implementation
 * decides whether the row is actually applied or is a duplicate — idempotency
 * is owned by the consumer (the underlying store).
 */
export interface Inserter {
  insert(rec: Record): void;
}

/** Serialize a record to a single NDJSON line (without trailing newline). */
function encodeRecord(rec: Record): string {
  // Mirror Rust serde: omit `metadata`/`payload` when undefined, and only emit
  // `deleted` when true is harmless — but keep it explicit for round-trip.
  const out: Record = { key: rec.key, deleted: rec.deleted ?? false };
  if (rec.metadata !== undefined) {
    out.metadata = rec.metadata;
  }
  if (rec.payload !== undefined) {
    out.payload = rec.payload;
  }
  return JSON.stringify(out);
}

/** An append-only redo log for one `(namespace, store)`, with compaction. */
export class RedoLog {
  private readonly active: string;
  private readonly archiveCount: number;
  private readonly archiveCodec: Codec;
  /** Current append target fd (the active log, or the temp log during a roll). */
  private writer: number;

  private constructor(active: string, archiveCount: number, archiveCodec: Codec) {
    this.active = active;
    this.archiveCount = archiveCount;
    this.archiveCodec = archiveCodec;
    this.writer = openAppend(active);
  }

  /**
   * Open (creating if absent) the redo log for `(ns, store)` under `base`.
   *
   * Concurrency: single-writer, single-process, local filesystem only.
   * Concurrent writers, multiple owning processes, or network/shared filesystems
   * are unsupported and can corrupt the archive chain.
   */
  static open(
    base: string,
    ns: string,
    store: string,
    archiveCount: number,
    archiveCodec: Codec,
  ): RedoLog {
    const active = storePath(base, ns, store, '.log');
    const dir = nodePath.dirname(active);
    fs.mkdirSync(dir, { recursive: true });
    return new RedoLog(active, archiveCount, archiveCodec);
  }

  /** The active log file path. */
  activePath(): string {
    return this.active;
  }

  /** Append one record, NDJSON-framed and fsync'd (durability is the point). */
  append(rec: Record): void {
    const line = Buffer.from(`${encodeRecord(rec)}\n`, 'utf8');
    try {
      fs.writeSync(this.writer, line);
      fs.fsyncSync(this.writer);
    } catch (e) {
      throw DiskStoreError.fromUnknown(e);
    }
  }

  /**
   * Compact: redirect appends to a temp log, build a fresh baseline from the
   * caller-supplied current state (`snapshot`), fold in the temp log, then
   * atomically swap the new file in and archive the old one (compressed at
   * rest). The final rename is the commit point.
   */
  roll(snapshot: Record[]): void {
    const tempPath = sibling(this.active, '.temp');
    const building = sibling(this.active, '.building');

    // 1. Redirect appends to the temp log.
    this.swapWriter(tempPath);

    // 2. Build the new baseline from the snapshot (build-then-rename: the
    //    presence of `building` means it is complete + durable).
    const parts: string[] = [];
    for (const rec of snapshot) {
      parts.push(`${encodeRecord(rec)}\n`);
    }
    const buf = Buffer.from(parts.join(''), 'utf8');
    const staged = writeTemp(building, buf, 0);
    promote(staged, building);

    // 3. Fold the temp log into the new baseline; swap.
    try {
      fs.fsyncSync(this.writer);
    } catch (e) {
      throw DiskStoreError.fromUnknown(e);
    }
    let tempBytes: Buffer;
    try {
      tempBytes = fs.readFileSync(tempPath);
    } catch (e) {
      const err = e as NodeJS.ErrnoException;
      if (err && err.code === 'ENOENT') {
        tempBytes = Buffer.alloc(0);
      } else {
        throw DiskStoreError.fromUnknown(e);
      }
    }
    {
      let fd: number | undefined;
      try {
        fd = fs.openSync(building, 'a');
        fs.writeSync(fd, tempBytes);
        fs.fsyncSync(fd);
      } catch (e) {
        throw DiskStoreError.fromUnknown(e);
      } finally {
        if (fd !== undefined) {
          try {
            fs.closeSync(fd);
          } catch {
            // ignore
          }
        }
      }
    }

    // Archive the old active (compressed at rest), then promote.
    rotateArchives(this.active, this.archiveCount);
    if (this.archiveCount > 0 && this.archiveCodec !== Codec.None) {
      compressInPlace(sibling(this.active, '.bak.1'), this.archiveCodec);
    }
    promote(building, this.active);

    // Resume appends on the (new) active log; drop the temp log.
    this.swapWriter(this.active);
    try {
      fs.rmSync(tempPath, { force: true });
    } catch {
      // ignore
    }
  }

  /**
   * Read + dedup the active log and replay each record through `inserter`.
   * Returns the number of records applied. Recovers a leftover temp log
   * (crash mid-roll) by folding it after the active log (latest wins).
   */
  restore(inserter: Inserter): number {
    const building = sibling(this.active, '.building');
    if (fs.existsSync(building)) {
      try {
        fs.closeSync(this.writer);
      } catch {
        // ignore
      }
      promote(building, this.active);
      this.writer = openAppend(this.active);
    }

    let recs = dedupFile(this.active);
    const tempPath = sibling(this.active, '.temp');
    if (fs.existsSync(tempPath)) {
      const extra = dedupFile(tempPath);
      const byKey = new Map<string, Record>();
      for (const r of recs) {
        byKey.set(r.key, r);
      }
      for (const r of extra) {
        byKey.set(r.key, r);
      }
      recs = Array.from(byKey.values());
    }
    let n = 0;
    for (const r of recs) {
      inserter.insert(r);
      n += 1;
    }
    return n;
  }

  /** Close the underlying writer fd. */
  close(): void {
    try {
      fs.closeSync(this.writer);
    } catch {
      // ignore
    }
  }

  private swapWriter(target: string): void {
    try {
      fs.closeSync(this.writer);
    } catch {
      // ignore
    }
    this.writer = openAppend(target);
  }
}

/**
 * Read a (possibly compressed) NDJSON log file and dedup to latest-per-key.
 * Returns an empty array if the file is absent.
 */
export function dedupFile(filePath: string): Record[] {
  let bytes: Buffer;
  try {
    bytes = fs.readFileSync(filePath);
  } catch (e) {
    const err = e as NodeJS.ErrnoException;
    if (err && err.code === 'ENOENT') {
      return [];
    }
    throw DiskStoreError.fromUnknown(e);
  }
  return dedupBytes(decompressAuto(bytes));
}

/** Dedup NDJSON bytes to latest-per-key. Later lines win. */
export function dedupBytes(bytes: Buffer): Record[] {
  const byKey = new Map<string, Record>();
  const text = bytes.toString('utf8');
  const lines = text.split('\n');
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    if (line.length === 0) {
      continue;
    }
    let rec: Record;
    try {
      rec = JSON.parse(line) as Record;
    } catch (e) {
      throw DiskStoreError.codec(`redo log line ${i + 1}: ${String(e)}`);
    }
    if (typeof rec.key !== 'string' || rec.key.length === 0) {
      throw DiskStoreError.invalidData(`redo log line ${i + 1}: missing key`);
    }
    byKey.set(rec.key, rec);
  }
  return Array.from(byKey.values());
}

function compressInPlace(filePath: string, codec: Codec): void {
  let raw: Buffer;
  try {
    raw = fs.readFileSync(filePath);
  } catch (e) {
    const err = e as NodeJS.ErrnoException;
    if (err && err.code === 'ENOENT') {
      return;
    }
    throw DiskStoreError.fromUnknown(e);
  }
  const packed = compress(raw, codec);
  const tmp = writeTemp(filePath, packed, 0);
  promote(tmp, filePath);
}

function openAppend(filePath: string): number {
  try {
    return fs.openSync(filePath, 'a');
  } catch (e) {
    throw DiskStoreError.fromUnknown(e);
  }
}
