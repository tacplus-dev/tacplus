// Handle{{.SourceType}} dispatches a {{.SourceType}} to all projection handlers.
// It calls tsInsert for timeseries projections.
// The callback may be nil — projections for a nil callback are skipped.
func Handle{{.SourceType}}(ctx context.Context, event *{{.SourceQualifier}}{{.SourceType}}, tsInsert TimeseriesInsertFunc) error {
	if event == nil {
		return nil
	}

{{- if .HasNoop}}
	// Trace round — skip persist, pipeline continues but data is not written
	if event.Noop {
		return nil
	}
{{- end}}

{{- range .TimeseriesProjections}}

	// {{.TypeName}} — timeseries projection (table: {{.TableName}}).
	if tsInsert != nil {
		if row := Extract{{.TypeName}}From{{$.SourceType}}(event); row != nil {
			cols := {{.TypeName}}TimeseriesColumns()
			vals := {{.TypeName}}ToTimeseriesRow(row)
			if err := tsInsert(ctx, "{{.TableName}}", cols, vals); err != nil {
				return fmt.Errorf("insert {{.TypeName}}: %w", err)
			}
		}
	}
{{- end}}

	return nil
}
