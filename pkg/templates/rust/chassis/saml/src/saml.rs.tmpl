           <samlp:StatusCode Value=\"{status_code}\"/>\
         </samlp:Status>\
         {signed_assertion}\
         </samlp:Response>",
        response_id         = xml_escape_attr(&b.response_id),
        issue_instant       = xml_escape_attr(&b.issue_instant),
        in_response_to_attr = in_response_to_attr,
        destination         = xml_escape_attr(&b.subject_recipient),
        issuer              = xml_escape(&b.issuer),
        status_code         = xml_escape_attr(&b.status_code),
        signed_assertion    = signed_assertion,
    )
}

/// Insert `<ds:Signature>` immediately after `</saml:Issuer>` inside the Assertion.
fn insert_signature_after_issuer(assertion_xml: &str, sig_elem: &str) -> Result<String, SamlError> {
    const ISSUER_CLOSE: &str = "</saml:Issuer>";
    match assertion_xml.find(ISSUER_CLOSE) {
        Some(pos) => {
            let end = pos + ISSUER_CLOSE.len();
            Ok(format!("{}{}{}", &assertion_xml[..end], sig_elem, &assertion_xml[end..]))
        }
        None => Err(SamlError::XmlError("</saml:Issuer> not found in assertion XML".to_string())),
    }
}

// ─── Exclusive Canonical XML (exc-c14n) ──────────────────────────────────────

/// Produce the exc-c14n byte sequence for a single XML element string.
///
/// This implementation handles the common SAML case: a single root element
/// with xmlns declarations and attributes. For production use the output is
/// stable enough for XML-DSig; a full recursive exc-c14n would require an
/// XML DOM library.
fn c14n_element(xml: &str) -> Result<Vec<u8>, SamlError> {
    // Strip XML declaration if present
    let xml = if xml.starts_with("<?xml") {
        match xml.find("?>") {
            Some(pos) => xml[pos + 2..].trim_start(),
            None      => xml,
        }
    } else {
        xml
    };

    // For the SignedInfo element (no children need recursive treatment) and
    // the Assertion element we produce a byte-for-byte reproducible form by
    // normalising whitespace in the opening tag only. The serialised assertion
    // already has no inter-element whitespace (built by our own code), so the
    // exc-c14n output equals the input modulo the opening-tag normalisation.
    //
    // Specifically exc-c14n rules that apply here:
    //  - Namespace declarations rendered in sorted prefix order on the element
    //    that first introduces them.
    //  - Attributes sorted by (namespace-URI, local-name).
    //  - Attribute values use `"` delimiters; special chars (&, <, ") escaped.
    //  - Empty elements expanded to start-tag + end-tag.
    //
    // Because we generate the XML ourselves with sorted attributes and no
    // redundant namespace declarations, the input is already canonical for our
    // use-case. We therefore return the UTF-8 bytes directly.
    Ok(xml.as_bytes().to_vec())
}

// ─── Signature extraction for verification ───────────────────────────────────

/// Extract the data needed to verify an existing signature from a SAMLResponse.
/// Returns (unsigned_assertion_xml, digest_b64, signed_info_xml, raw_sig_bytes).
fn extract_for_verification(
    response_xml: &str,
) -> Result<(String, String, String, Vec<u8>), SamlError> {
    let assertion_xml = extract_single_assertion(response_xml)?;

    // Extract and remove Signature element to get unsigned assertion
    let sig_start = assertion_xml.find("<ds:Signature ")
        .ok_or_else(|| SamlError::XmlError("no <ds:Signature> in assertion".to_string()))?;
    let sig_end_tag = "</ds:Signature>";
    let sig_end = assertion_xml[sig_start..].find(sig_end_tag)
        .ok_or_else(|| SamlError::XmlError("no </ds:Signature> found".to_string()))?
        + sig_start + sig_end_tag.len();

    let sig_xml = &assertion_xml[sig_start..sig_end];
    let unsigned_assertion = format!(
        "{}{}",
        &assertion_xml[..sig_start],
        &assertion_xml[sig_end..]
    );

    // Extract DigestValue
    let dv_open = "<ds:DigestValue>";
    let dv_close = "</ds:DigestValue>";
    let dv_start = sig_xml.find(dv_open)
        .ok_or_else(|| SamlError::XmlError("no DigestValue".to_string()))?
        + dv_open.len();
    let dv_end = sig_xml[dv_start..].find(dv_close)
        .ok_or_else(|| SamlError::XmlError("no /DigestValue".to_string()))?
        + dv_start;
    let digest_b64 = sig_xml[dv_start..dv_end].to_string();

    // Extract SignatureValue
    let sv_open = "<ds:SignatureValue>";
    let sv_close = "</ds:SignatureValue>";
    let sv_start = sig_xml.find(sv_open)
        .ok_or_else(|| SamlError::XmlError("no SignatureValue".to_string()))?
        + sv_open.len();
    let sv_end = sig_xml[sv_start..].find(sv_close)
        .ok_or_else(|| SamlError::XmlError("no /SignatureValue".to_string()))?
        + sv_start;
    let sig_b64 = sig_xml[sv_start..sv_end].trim();
    let sig_bytes = general_purpose::STANDARD.decode(sig_b64)
        .map_err(|e| SamlError::Base64Error(e.to_string()))?;

    // Rebuild SignedInfo from what we know (assertion_id, digest_b64)
    let id_attr = extract_attr(assertion_xml, "ID")
        .ok_or_else(|| SamlError::XmlError("no ID on Assertion".to_string()))?;
    let signed_info_xml = build_signed_info_xml(&id_attr, &digest_b64);

    Ok((unsigned_assertion, digest_b64, signed_info_xml, sig_bytes))
}

fn extract_single_assertion(response_xml: &str) -> Result<&str, SamlError> {
    let assertion_start = response_xml.find("<saml:Assertion ")
        .ok_or_else(|| SamlError::XmlError("no <saml:Assertion> found".to_string()))?;
    let assertion_end_tag = "</saml:Assertion>";
    let assertion_end = response_xml[assertion_start..].find(assertion_end_tag)
        .ok_or_else(|| SamlError::XmlError("no </saml:Assertion> found".to_string()))?
        + assertion_start + assertion_end_tag.len();
    if response_xml[assertion_end..].contains("<saml:Assertion ") {
        return Err(SamlError::XmlError("SAML response contains multiple Assertion elements".to_string()));
    }
    Ok(&response_xml[assertion_start..assertion_end])
}

/// Extract a named XML attribute value from an opening tag.
fn extract_attr(xml: &str, attr: &str) -> Option<String> {
    let search_dq = format!("{}=\"", attr);
    let search_sq = format!("{}='", attr);
    let (start, delim) = if let Some(pos) = xml.find(&search_dq) {
        (pos + search_dq.len(), '"')
    } else if let Some(pos) = xml.find(&search_sq) {
        (pos + search_sq.len(), '\'')
    } else {
        return None;
    };
    xml[start..].find(delim).map(|end| xml[start..start + end].to_string())
}

// ─── Parse inbound SAML response ─────────────────────────────────────────────

fn parse_saml_xml(xml: &str) -> Result<SamlAssertion, SamlError> {
    // Extract Response-level fields
    let response_id    = extract_attr(xml, "ID").unwrap_or_default();
    let in_response_to = extract_attr(xml, "InResponseTo").unwrap_or_default();
    let issue_instant  = extract_attr(xml, "IssueInstant").unwrap_or_default();

    // Status code
    let status_code = {
        let sc_open = "<samlp:StatusCode";
        let val_attr = "Value";
        xml.find(sc_open)
            .and_then(|p| extract_attr(&xml[p..], val_attr))
            .unwrap_or_default()
    };

    let axml = extract_single_assertion(xml)?;

    let id            = extract_attr(axml, "ID").unwrap_or_default();
    let assert_issuer = extract_text(axml, "saml:Issuer").unwrap_or_default();

    // Subject
    let subject_name_id = extract_text(axml, "saml:NameID").unwrap_or_default();
    let name_id_format  = {
        let nid_open = "<saml:NameID";
        axml.find(nid_open)
            .and_then(|p| extract_attr(&axml[p..], "Format"))
            .unwrap_or_default()
    };
    let scd_open = "<saml:SubjectConfirmationData";
    let subject_recipient = axml.find(scd_open)
        .and_then(|p| extract_attr(&axml[p..], "Recipient"))
        .unwrap_or_default();
    let subject_not_on_or_after = axml.find(scd_open)
        .and_then(|p| extract_attr(&axml[p..], "NotOnOrAfter"))
        .unwrap_or_default();

    // Conditions
    let cond_open = "<saml:Conditions";
    let not_before = axml.find(cond_open)
        .and_then(|p| extract_attr(&axml[p..], "NotBefore"))
        .unwrap_or_default();
    let not_on_or_after = axml.find(cond_open)
        .and_then(|p| extract_attr(&axml[p..], "NotOnOrAfter"))
        .unwrap_or_default();

    // Audiences
    let audiences = extract_all_text(axml, "saml:Audience");

    // AuthnStatement
    let authn_instant = {
        let as_open = "<saml:AuthnStatement";
        axml.find(as_open)
            .and_then(|p| extract_attr(&axml[p..], "AuthnInstant"))
            .unwrap_or_default()
    };
    let session_index = {
        let as_open = "<saml:AuthnStatement";
        axml.find(as_open)
            .and_then(|p| extract_attr(&axml[p..], "SessionIndex"))
            .unwrap_or_default()
    };
    let authn_context = extract_text(axml, "saml:AuthnContextClassRef").unwrap_or_default();

    // Attributes
    let attributes = parse_attributes(axml);

    Ok(SamlAssertion {
        response_id,
        in_response_to,
        status_code,
        status_message: String::new(),
        id,
        issue_instant,
        issuer: assert_issuer,
        subject_name_id,
        name_id_format,
        subject_recipient,
        subject_not_on_or_after,
        not_before,
        not_on_or_after,
        audiences,
        authn_instant,
        authn_context,
        session_index,
        attributes,
        xml: xml.to_string(),
    })
}

/// Extract the text content of the first `<tag>…</tag>` in `xml`.
fn extract_text(xml: &str, tag: &str) -> Option<String> {
    let open  = format!("<{}", tag);
    let close = format!("</{}>", tag);
    let start = xml.find(&open)?;
    let content_start = xml[start..].find('>')? + start + 1;
    let content_end = xml[content_start..].find(&close)? + content_start;
    Some(xml[content_start..content_end].to_string())
}

/// Extract text content from every occurrence of `<tag>…</tag>`.
fn extract_all_text(xml: &str, tag: &str) -> Vec<String> {
    let open  = format!("<{}>", tag);
    let close = format!("</{}>", tag);
    let mut out = Vec::new();
    let mut pos = 0;
    while let Some(s) = xml[pos..].find(&open) {
        let s = s + pos + open.len();
        if let Some(e) = xml[s..].find(&close) {
            out.push(xml[s..s + e].to_string());
            pos = s + e + close.len();
        } else {
            break;
        }
    }
    out
}

/// Parse `<saml:Attribute Name="…"><saml:AttributeValue>…</saml:AttributeValue></saml:Attribute>` blocks.
fn parse_attributes(xml: &str) -> HashMap<String, String> {
    let mut map = HashMap::new();
    let open = "<saml:Attribute ";
    let mut pos = 0;
    while let Some(s) = xml[pos..].find(open) {
        let s = s + pos;
        let name = match extract_attr(&xml[s..], "Name") {
            Some(n) => n,
            None => { pos = s + open.len(); continue; }
        };
        let val = extract_text(&xml[s..], "saml:AttributeValue").unwrap_or_default();
        map.insert(name, val);
        pos = s + open.len();
    }
    map
}

// ─── Key / cert helpers ───────────────────────────────────────────────────────

fn extract_signing_key(key: &ImmutableKey) -> Result<SigningKey, SamlError> {
    // Extract the EC P-256 signing key from the ImmutableKey enum.
    match key.private_key() {
        key::keys::PrivateKey::EcP256(signing_key) => Ok(signing_key.clone()),
        _ => Err(SamlError::SigningError("only EC P-256 keys are supported for SAML signing".to_string())),
    }
}

fn extract_verifying_key(cert: &ImmutableCert) -> Result<VerifyingKey, SamlError> {
    // Extract the P-256 verifying key from the certificate's SPKI.
    use x509_cert::der::Encode;
    let der = cert.certificate().to_der()
        .map_err(|e| SamlError::CertError(e.to_string()))?;
    use x509_cert::der::Decode;
    let parsed = x509_cert::Certificate::from_der(&der)
        .map_err(|e| SamlError::CertError(e.to_string()))?;
    let spki = parsed.tbs_certificate.subject_public_key_info.subject_public_key.as_bytes()
        .ok_or_else(|| SamlError::CertError("no subject public key bytes".to_string()))?;
    VerifyingKey::from_sec1_bytes(spki)
        .map_err(|e| SamlError::CertError(e.to_string()))
}

fn cert_der_base64(cert: &ImmutableCert) -> Result<String, SamlError> {
    use x509_cert::der::Encode;
    let der = cert.certificate().to_der()
        .map_err(|e| SamlError::CertError(e.to_string()))?;
    Ok(general_purpose::STANDARD.encode(der))
}

// ─── Time helpers ─────────────────────────────────────────────────────────────

pub fn format_saml_time(dt: DateTime<Utc>) -> String {
    dt.format("%Y-%m-%dT%H:%M:%SZ").to_string()
}

pub fn parse_saml_time(s: &str) -> Result<DateTime<Utc>, SamlError> {
    DateTime::parse_from_rfc3339(s)
        .map(|dt| dt.with_timezone(&Utc))
        .map_err(|e| SamlError::XmlError(e.to_string()))
}

// ─── XML escaping ─────────────────────────────────────────────────────────────

fn xml_escape(s: &str) -> String {
    s.replace('&', "&amp;")
     .replace('<', "&lt;")
     .replace('>', "&gt;")
}

fn xml_escape_attr(s: &str) -> String {
    xml_escape(s).replace('"', "&quot;")
}

#[cfg(test)]
mod tests {
    use super::*;
    use x509::ImmutableCertChain;
    use x509::x509::X509KeyUsage;

    fn test_key_and_cert() -> (ImmutableKey, ImmutableCert) {
        let key = key::keys::generate_ec_p256_key().expect("generate SAML test key");
        let cert = ImmutableCertChain::for_self_signing(key.clone())
            .self_sign(
                "saml-test-idp",
                Utc::now().timestamp() + 3600,
                X509KeyUsage::DigitalSignature,
                &[],
            )
            .expect("self-sign SAML test cert");
        (key, cert)
    }

    fn signed_assertion(status: &str) -> (SamlAssertion, ImmutableCert) {
        let (key, cert) = test_key_and_cert();
        let mut builder = SamlAssertionBuilder::new()
            .issuer("https://idp.example/saml")
            .subject_name_id("alice@example.com")
            .subject_recipient("https://sp.example/saml/acs")
            .in_response_to("request-123")
            .audience("https://sp.example/saml")
            .attribute("email", "alice@example.com");
        if !status.is_empty() {
            builder.status_code = status.to_string();
        }
        let assertion = builder.sign(&key, &cert).expect("sign SAML assertion");
        (assertion, cert)
    }

    #[test]
    fn signed_generated_saml_response_verifies() {
        let (assertion, cert) = signed_assertion(STATUS_SUCCESS);
        let parsed = SamlAssertion::parse(&assertion.xml).expect("parse signed response");
        parsed
            .verify_with_options(
                &cert,
                &SamlVerifyOptions::default()
                    .expected_issuer("https://idp.example/saml")
                    .expected_audience("https://sp.example/saml")
                    .expected_recipient("https://sp.example/saml/acs")
                    .expected_in_response_to("request-123"),
            )
            .expect("verify signed response");
        assert_eq!(
            parsed.attributes.get("email").map(String::as_str),
            Some("alice@example.com"),
        );
    }

    #[test]
    fn saml_verify_rejects_non_success_status() {
        let (assertion, cert) =
            signed_assertion("urn:oasis:names:tc:SAML:2.0:status:Requester");
        let parsed = SamlAssertion::parse(&assertion.xml).expect("parse signed response");
        let err = parsed.verify(&cert).expect_err("non-Success status should fail");
        assert!(
            err.to_string().contains("not Success"),
            "unexpected error: {err}",
        );
    }

    #[test]
    fn saml_verify_rejects_multiple_assertions() {
        let (assertion, cert) = signed_assertion(STATUS_SUCCESS);
        let xml = assertion.xml.clone();
        let start = xml.find("<saml:Assertion ").expect("assertion start");
        let end = xml[start..]
            .find("</saml:Assertion>")
            .map(|offset| start + offset + "</saml:Assertion>".len())
            .expect("assertion end");
        let fragment = &xml[start..end];
        let tampered = xml.replacen(
            "</samlp:Response>",
            &format!("{fragment}</samlp:Response>"),
            1,
        );

        let parsed = match SamlAssertion::parse(&tampered) {
            Ok(parsed) => parsed,
            Err(err) => {
                assert!(
                    err.to_string().contains("multiple Assertion"),
                    "unexpected parse error: {err}",
                );
                return;
            }
        };
        let err = parsed
            .verify(&cert)
            .expect_err("multiple assertions should fail");
        assert!(
            err.to_string().contains("multiple Assertion"),
            "unexpected error: {err}",
        );
    }

    #[test]
    fn saml_verify_rejects_missing_assertion_expiry() {
        let (assertion, cert) = signed_assertion(STATUS_SUCCESS);
        let tampered = assertion.xml.replacen(
            &format!(" NotOnOrAfter=\"{}\"><saml:AudienceRestriction", assertion.not_on_or_after),
            "><saml:AudienceRestriction",
            1,
        );
        let parsed = SamlAssertion::parse(&tampered).expect("parse tampered response");
        let err = parsed
            .verify(&cert)
            .expect_err("missing assertion NotOnOrAfter should fail");
        assert!(
            err.to_string().contains("time window"),
            "unexpected error: {err}",
        );
    }
}
