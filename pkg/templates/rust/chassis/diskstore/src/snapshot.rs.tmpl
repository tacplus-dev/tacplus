//! UC1 — atomic typed snapshot (whole object).
//!
//! These functions operate on raw bytes. The per-type generated code produces
//! the bytes via the generated `ToJSON` helper on write, and parses them via
//! `FromJSON` + `Validate` on read — keeping serialization consistent with the
//! rest of tacplus and validation always-on.

use crate::compress::{compress, decompress_auto, Codec};
use crate::error::Result;
use crate::fsutil::{archive_active, promote, write_temp};
use std::path::Path;

/// Options for a snapshot write.
#[derive(Debug, Clone, Copy)]
pub struct SnapshotOpts {
    /// At-rest compression for the snapshot file.
    pub codec: Codec,
    /// Unix file mode for the data file (e.g. `0o600`). `0` leaves the default.
    pub mode: u32,
    /// Number of rotated archives to retain.
    pub archive_count: u32,
}

impl Default for SnapshotOpts {
    fn default() -> Self {
        Self { codec: Codec::None, mode: 0o600, archive_count: 3 }
    }
}

/// Write a whole-object snapshot atomically.
///
/// Order is chosen so the active file is NEVER absent (PC-L-5):
/// 1. compress the payload,
/// 2. write it to a fresh fsync'd temp (active still intact),
/// 3. LINK the previous active to `<path>.bak.1` (keep `archive_count`; the
///    active path stays in place),
/// 4. atomically rename the temp over `path` (the only mutation of the active
///    file — a crash at any point leaves either the old or the new snapshot).
pub fn write_snapshot(path: &Path, data: &[u8], opts: &SnapshotOpts) -> Result<()> {
    let payload = compress(data, opts.codec)?;
    let tmp = write_temp(path, &payload, opts.mode)?;
    archive_active(path, opts.archive_count)?;
    promote(&tmp, path)
}

/// Read a snapshot, auto-decompressing. Returns `None` if the file is absent.
/// The caller deserializes + validates the returned bytes (`FromJSON` +
/// `Validate`).
pub fn read_snapshot(path: &Path) -> Result<Option<Vec<u8>>> {
    match std::fs::read(path) {
        Ok(bytes) => Ok(Some(decompress_auto(&bytes)?)),
        Err(e) if e.kind() == std::io::ErrorKind::NotFound => {
            // The active file should never be absent (write_snapshot only ever
            // replaces it atomically), but if it is — disk incident, manual
            // deletion, legacy crash window — recover the previous state from
            // .bak.1 rather than silently starting fresh (PC-L-5 read leg).
            let bak = crate::fsutil::archive_name(path, 1);
            match std::fs::read(&bak) {
                // A present-but-corrupt archive on the recovery path errors
                // LOUDLY — silently dropping the last committed baseline would
                // mask corruption on the exact path this recovery exists for
                // (NEW-37).
                Ok(bytes) => Ok(Some(decompress_auto(&bytes)?)),
                // Only a MISSING archive degrades to fresh-start; any other
                // read failure on a present archive errors loudly (NEW-38).
                Err(e) if e.kind() == std::io::ErrorKind::NotFound => Ok(None),
                Err(e) => Err(e.into()),
            }
        }
        Err(e) => Err(e.into()),
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use tempfile::tempdir;

    #[test]
    fn snapshot_roundtrip_and_archive() {
        let dir = tempdir().unwrap();
        let path = dir.path().join("state.json");
        let opts = SnapshotOpts { codec: Codec::Gz, mode: 0o600, archive_count: 2 };

        write_snapshot(&path, b"v1", &opts).unwrap();
        assert_eq!(read_snapshot(&path).unwrap().unwrap(), b"v1");

        write_snapshot(&path, b"v2", &opts).unwrap();
        assert_eq!(read_snapshot(&path).unwrap().unwrap(), b"v2");
        // previous active archived
        let bak1 = dir.path().join("state.json.bak.1");
        assert!(bak1.exists());
    }

    #[test]
    fn read_absent_is_none() {
        let dir = tempdir().unwrap();
        let path = dir.path().join("missing.json");
        assert!(read_snapshot(&path).unwrap().is_none());
    }

    /// PC-L-5 read leg / NEW-37: an absent active file recovers the previous
    /// state from .bak.1 instead of silently starting fresh; a
    /// present-but-corrupt archive on that recovery path errors LOUDLY.
    #[test]
    fn read_recovers_from_bak_when_active_absent() {
        let dir = tempdir().unwrap();
        let path = dir.path().join("state.json");
        let opts = SnapshotOpts { codec: Codec::Gz, mode: 0o600, archive_count: 2 };

        write_snapshot(&path, b"v1", &opts).unwrap();
        write_snapshot(&path, b"v2", &opts).unwrap();
        std::fs::remove_file(&path).unwrap();

        assert_eq!(read_snapshot(&path).unwrap().unwrap(), b"v1");

        // Corrupt archive on the recovery path errors loudly, never fresh-start.
        std::fs::write(dir.path().join("state.json.bak.1"), b"\x1f\x8btrunc").unwrap();
        assert!(read_snapshot(&path).is_err());
    }
}
