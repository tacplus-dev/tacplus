            if self.issuer.is_empty() {
                return Err(SamlError::VerificationError(
                    format!("assertion missing Issuer but expected {}", expected),
                ));
            }
            if &self.issuer != expected {
                return Err(SamlError::VerificationError(
                    format!("assertion Issuer {} does not match expected {}", self.issuer, expected),
                ));
            }
        }
        if let Some(expected) = &options.expected_audience {
            if !self.audiences.iter().any(|aud| aud == expected) {
                return Err(SamlError::VerificationError(
                    format!("assertion audiences {:?} do not include expected {}", self.audiences, expected),
                ));
            }
        }
        if let Some(expected) = &options.expected_recipient {
            if self.subject_recipient.is_empty() {
                return Err(SamlError::VerificationError(
                    format!("assertion missing SubjectRecipient but expected {}", expected),
                ));
            }
            if &self.subject_recipient != expected {
                return Err(SamlError::VerificationError(
                    format!("assertion SubjectRecipient {} does not match expected {}", self.subject_recipient, expected),
                ));
            }
        }
        if let Some(expected) = &options.expected_in_response_to {
            if self.in_response_to.is_empty() {
                return Err(SamlError::VerificationError(
                    format!("assertion missing InResponseTo but expected {}", expected),
                ));
            }
            if &self.in_response_to != expected {
                return Err(SamlError::VerificationError(
                    format!("assertion InResponseTo {} does not match expected {}", self.in_response_to, expected),
                ));
            }
        }
        Ok(())
    }

    fn check_and_mark_replay(&self) -> Result<(), SamlError> {
