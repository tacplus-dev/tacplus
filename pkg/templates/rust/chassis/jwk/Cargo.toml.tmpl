[package]
name = "jwk"
version = "0.1.0"
edition = "2021"
{{- if .License}}
license = "{{.License}}"
{{- end}}
publish = false
description = "JWK (JSON Web Key) operations"

[dependencies]
key = { path = "../key" }
base64 = { workspace = true }
ed25519-dalek = "3"
serde = { workspace = true, features = ["derive"] }
serde_json = { workspace = true }
