{
  "name": "{{.TsPackagePrefix}}chassis-im",
  "version": "1.0.0",
  "description": "Service identity manager: token exchange, caching, and renewal",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
{{- if .Author}}
  "author": {{printf "%q" .Author}},
{{- end}}
  "license": "PROPRIETARY",
  "dependencies": {
    "@grpc/grpc-js": "^1.9.0"{{if .HasTokenExchanger}},
    "@bufbuild/protobuf": "{{.BufbuildProtobuf}}",
    "{{.TokenRequestPackage}}": "*"
{{- end}}
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
