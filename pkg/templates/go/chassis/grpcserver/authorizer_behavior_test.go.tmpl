// pigeonSubject is the SPIFFE id MintWorkload gives an ephemeral pigeon minted
// under the beagle service; its service path is beagle/workloads/pigeon-<run_id>.
const pigeonSubject = "spiffe://example.com/system/aws/az1/cluster1/services/beagle/workloads/pigeon-01arz3ndektsv4rrffq69g5fav"

func workloadToken(sub string) func(*tokenlib.TokenWrapper) {
	return func(tok *tokenlib.TokenWrapper) {
		tok.SetSubType("workload").SetSubject(sub)
	}
}

// "*" admits service callers only. A pigeon workload minted under an
// otherwise-admitted service must be denied by "*", while the service itself
// stays admitted.
func TestAuthorizerStarDoesNotAdmitWorkload(t *testing.T) {
	key := newTestKey(t)
	a := authorizerWithKeys(t, jwkForKey(t, key))
	a.SetMethodAuth(testMethodKey, []string{"*"})

	pigeon := signedToken(t, key, workloadToken(pigeonSubject))
	if _, err := a.Authorize(bearerCtx(pigeon), testMethod, nil); err == nil {
		t.Fatal(`"*" must not admit a workload subject`)
	}

	svc := signedToken(t, key, serviceToken("beagle"))
	if _, err := a.Authorize(bearerCtx(svc), testMethod, nil); err != nil {
		t.Fatalf(`"*" must still admit a service subject, got: %v`, err)
	}
}

