// ReconcileFromHealth updates the pool's endpoints from a set of health reports.
// New endpoints are connected; removed endpoints are closed; existing
// endpoints have their health updated.
func (sc *ServiceConnection) ReconcileFromHealth(instances []*healthreport_pb.ServiceInstanceHealth) {
	sc.mu.Lock()

	// Build target->health map from incoming instances
	incoming := make(map[string]*healthreport_pb.ServiceInstanceHealth, len(instances))
	for _, inst := range instances {
		ep := inst.GrpcEndpoint
		if ep == nil {
			continue
		}
		target := fmt.Sprintf("%s:%d", ep.Host, ep.Port)
		incoming[target] = inst
	}

	// Build current target->endpointConn map
	current := make(map[string]*endpointConn, len(sc.endpoints))
	for _, ec := range sc.endpoints {
		current[ec.target] = ec
	}

	// Update existing, identify new and removed
	var kept []*endpointConn
	var toClose []*endpointConn

	for _, ec := range sc.endpoints {
		if h, ok := incoming[ec.target]; ok {
			// Still present -- update health
			ec.absentPolls = 0
			ec.updateHealth(h)
			kept = append(kept, ec)
		} else {
			// Absent. Kept, with its last health, until absentPollsBeforeClose
			// snapshots in a row omit it.
			ec.absentPolls++
			if ec.absentPolls >= absentPollsBeforeClose {
				toClose = append(toClose, ec)
			} else {
				kept = append(kept, ec)
			}
		}
	}

	// Dial new endpoints
	var toAdd []*endpointConn
	for target, h := range incoming {
		if _, exists := current[target]; exists {
			continue
		}
		// Only dial routable instances
		if h.Status == StatusUnhealthy {
			continue
		}
		ec := newEndpointConn(target)
		ec.updateHealth(h)
		if err := ec.dial(sc.dialOpts); err != nil {
			zap.L().Warn("ServiceConnection: failed to connect to new endpoint",
				zap.String("service", sc.serviceID),
				zap.String("target", target),
				zap.Error(err))
			continue
		}
		toAdd = append(toAdd, ec)
		zap.L().Info("ServiceConnection: connected to new endpoint",
			zap.String("service", sc.serviceID),
			zap.String("target", target))
	}

	sc.endpoints = append(kept, toAdd...)
	sc.mu.Unlock()

	// Close removed endpoints outside lock
	for _, ec := range toClose {
		zap.L().Info("ServiceConnection: closing removed endpoint",
			zap.String("service", sc.serviceID),
			zap.String("target", ec.target))
		ec.close()
	}

	sc.selectActive()
}

// selectActive picks the best routable endpoint as active.
// Prefers HEALTHY over DEGRADED. Among same-status endpoints, picks lowest latency.
// Uses hysteresis to prevent flip-flopping.
func (sc *ServiceConnection) selectActive() {
	sc.mu.Lock()
	defer sc.mu.Unlock()

	var best *endpointConn
	var bestLatency int64 = math.MaxInt64
	bestDegraded := true

	for _, ec := range sc.endpoints {
		if !ec.isRoutable() || !ec.isConnected() {
			continue
		}
		degraded := ec.isDegraded()
		lat := ec.getLatencyUs()

		// Prefer HEALTHY over DEGRADED, then lowest latency
		if best == nil ||
			(bestDegraded && !degraded) ||
			(!bestDegraded == !degraded && lat < bestLatency) {
			best = ec
			bestLatency = lat
			bestDegraded = degraded
		}
	}

	if best == nil {
		if sc.active != nil {
			zap.L().Warn("ServiceConnection: no routable endpoints",
				zap.String("service", sc.serviceID))
		}
		return
	}

	// Hysteresis: only switch if improvement is significant
	if sc.active != nil && sc.active.isRoutable() && sc.active.isConnected() && best != sc.active {
		currentDegraded := sc.active.isDegraded()
		// Always switch away from degraded to healthy
		if currentDegraded && !bestDegraded {
			// Switch
		} else if !currentDegraded == !bestDegraded {
			currentLatency := sc.active.getLatencyUs()
			if currentLatency > 0 {
				improvement := float64(currentLatency-bestLatency) / float64(currentLatency)
				if improvement < rebalanceThreshold {
					return // not enough improvement
				}
			}
		} else {
			return // current is healthy, best is degraded -- keep current
		}
	}

	if best != sc.active {
		prev := "<none>"
		if sc.active != nil {
			prev = sc.active.target
		}
		sc.active = best
		zap.L().Info("ServiceConnection: active endpoint changed",
			zap.String("service", sc.serviceID),
			zap.String("from", prev),
			zap.String("to", best.target),
			zap.Int64("latency_us", bestLatency))
	}
}

// Close shuts down all connections in the pool.
func (sc *ServiceConnection) Close() {
	sc.mu.Lock()
	endpoints := sc.endpoints
	sc.endpoints = nil
	sc.active = nil
	sc.mu.Unlock()
	for _, ec := range endpoints {
		ec.close()
	}
}

// ---------------------------------------------------------------------------
// TenantConnection -- per-tenant connection pools for a tenant-routed target
// ---------------------------------------------------------------------------

// TenantConnection manages the connections to a TENANT-ROUTED target service
// (a tenant-owned service, whose rpcs declare (spec.rpc).route_field): one
// ServiceConnection per tenant, fed from the same health updates as a platform
// pool and grouped by the tenant of each instance's spiffe_id (see
// InstanceTenant). A call reaches only the instances of the tenant it names;
// it never falls back to another tenant's instance or to a shared one, and an
// instance outside /tenants/<tid> is never routable here.
type TenantConnection struct {
	serviceID string
	dialOpts  []grpc.DialOption
	mu        sync.RWMutex
	tenants   map[string]*ServiceConnection
}

// NewTenantDynamic creates a TenantConnection that starts with no tenants.
// Tenants and their endpoints arrive via ReconcileFromHealth.
func NewTenantDynamic(serviceID string, dialOpts []grpc.DialOption) *TenantConnection {
	return &TenantConnection{
		serviceID: serviceID,
		dialOpts:  dialOpts,
		tenants:   make(map[string]*ServiceConnection),
	}
}

// ServiceID returns the service ID for this connection.
func (tc *TenantConnection) ServiceID() string {
	return tc.serviceID
}

// ReconcileFromHealth groups the target's health reports by instance tenant
// and reconciles each tenant's pool with its own instances. A tenant no
// longer reported is reconciled with none, so its endpoints close on the same
// absent-snapshot schedule as a platform pool's, and the tenant is dropped
// once it has no endpoint left.
func (tc *TenantConnection) ReconcileFromHealth(instances []*healthreport_pb.ServiceInstanceHealth) {
	byTenant := make(map[string][]*healthreport_pb.ServiceInstanceHealth)
	for _, inst := range instances {
		tid, ok := InstanceTenant(inst.GetSpiffeId())
		if !ok {
			continue
		}
		byTenant[tid] = append(byTenant[tid], inst)
	}

	tc.mu.Lock()
	for tid := range byTenant {
		if _, ok := tc.tenants[tid]; !ok {
			tc.tenants[tid] = NewDynamic(tc.serviceID, tc.dialOpts)
		}
	}
	pools := make(map[string]*ServiceConnection, len(tc.tenants))
	for tid, sc := range tc.tenants {
		pools[tid] = sc
	}
	tc.mu.Unlock()

	var emptied []string
	for tid, sc := range pools {
		sc.ReconcileFromHealth(byTenant[tid])
		if sc.endpointCount() == 0 {
			emptied = append(emptied, tid)
		}
	}
	if len(emptied) == 0 {
		return
	}
	tc.mu.Lock()
	var closing []*ServiceConnection
	for _, tid := range emptied {
		if sc, ok := tc.tenants[tid]; ok && sc.endpointCount() == 0 {
			delete(tc.tenants, tid)
			closing = append(closing, sc)
		}
	}
	tc.mu.Unlock()
	for _, sc := range closing {
		sc.Close()
	}
}

// Conn returns the active connection of tenant tid's pool, or nil when that
// tenant has no healthy endpoint.
func (tc *TenantConnection) Conn(tid string) grpc.ClientConnInterface {
	tc.mu.RLock()
	sc := tc.tenants[tid]
	tc.mu.RUnlock()
	if sc == nil {
		return nil
	}
	return sc.Conn()
}

// Tenants returns the tenants that currently have a pool, sorted.
func (tc *TenantConnection) Tenants() []string {
	tc.mu.RLock()
	defer tc.mu.RUnlock()
	tids := make([]string, 0, len(tc.tenants))
	for tid := range tc.tenants {
		tids = append(tids, tid)
	}
	sort.Strings(tids)
	return tids
}

// IsAvailable reports whether any tenant's pool has an endpoint up for
// readiness. Whether one PARTICULAR tenant can be reached is a per-call
// question (UNAVAILABLE), not a readiness one.
func (tc *TenantConnection) IsAvailable() bool {
	tc.mu.RLock()
	defer tc.mu.RUnlock()
	for _, sc := range tc.tenants {
		if sc.IsAvailable() {
			return true
		}
	}
	return false
}

// Close shuts down every tenant's pool.
func (tc *TenantConnection) Close() {
	tc.mu.Lock()
	tenants := tc.tenants
	tc.tenants = make(map[string]*ServiceConnection)
	tc.mu.Unlock()
	for _, sc := range tenants {
		sc.Close()
	}
}

// endpointCount returns how many endpoints the pool currently holds.
func (sc *ServiceConnection) endpointCount() int {
	sc.mu.RLock()
	defer sc.mu.RUnlock()
	return len(sc.endpoints)
}

