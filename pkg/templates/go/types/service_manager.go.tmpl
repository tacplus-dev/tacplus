// The ManageCert stream is a background renewal/handler-delivery path; it must
// not gate initial Listen because the gRPC server already uses the X509Mint
// certificate passed to grpcserver.New above.
if sm.sc.TLSCertChain() == nil || sm.sc.TLSPrivateKey() == nil {
