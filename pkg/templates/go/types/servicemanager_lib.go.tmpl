// spiffeTLSDialOpt builds a TLS transport-credentials dial option whose
// VerifyConnection validates the peer chain against the trusted CA pool and then
// pins the peer's SPIFFE identity via peerVerify. InsecureSkipVerify disables
// Go's built-in DNS-SAN hostname check (service certs carry URI SANs).
func (bc *ServiceManager) spiffeTLSDialOpt(peerVerify func(*x509.Certificate) error) grpc.DialOption {
	tlsCfg := &tls.Config{
		InsecureSkipVerify: true,
		VerifyConnection: func(cs tls.ConnectionState) error {
			if len(cs.PeerCertificates) == 0 {
				return fmt.Errorf("peer certificate is required for SPIFFE TLS verification")
			}
			// 1. Validate the peer cert chain against the trusted CA pool.
			opts := x509.VerifyOptions{Roots: bc.certPool, Intermediates: x509.NewCertPool()}
			for _, cert := range cs.PeerCertificates[1:] {
				opts.Intermediates.AddCert(cert)
			}
			if _, err := cs.PeerCertificates[0].Verify(opts); err != nil {
				return err
			}
			// 2. Pin the peer's SPIFFE identity. Chain validity alone is CA-only
			// trust (fail-open): it would accept any CA-issued cert as any peer.
			return peerVerify(cs.PeerCertificates[0])
		},
	}
	return grpc.WithTransportCredentials(credentials.NewTLS(tlsCfg))
}

// dialOptsWithVerify returns the base dial options plus a TLS credential using
