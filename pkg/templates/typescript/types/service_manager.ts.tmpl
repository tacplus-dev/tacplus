  /** Adapter that bridges HealthPublisher to ServiceHealthStateService via raw gRPC. */
class HealthPublisherAdapter implements HealthPublisher {
  private readonly client: grpc.Client;
  private readonly tokenProvider: () => Promise<string>;

  constructor(client: grpc.Client, tokenProvider: () => Promise<string>) {
    this.client = client;
    this.tokenProvider = tokenProvider;
  }

  async setInstances(health: ServiceInstanceHealth): Promise<void> {
    const token = await this.tokenProvider();
    const metadata = new grpc.Metadata();
    metadata.set('authorization', `Bearer ${token}`);
    return new Promise<void>((resolve, reject) => {
      this.client.makeUnaryRequest(
        '/{{.HealthStatePackage}}.ServiceHealthStateService/SetInstances',
        (msg: ServiceInstanceHealth) => Buffer.from(toBinary(ServiceInstanceHealthSchema, msg)),
        () => ({}),
        health,
        metadata,
        (err: grpc.ServiceError | null) => err ? reject(err) : resolve(),
      );
    });
  }
}

/** Provides static metrics (listen address) for health reports. */
class StaticMetrics implements MetricsProvider {
  private readonly endpoint: Host | null;
  constructor(endpoint: Host | null) { this.endpoint = endpoint; }
  grpcEndpoint(): Host | null { return this.endpoint; }
  httpEndpoint(): Host | null { return null; }
  activeRequests(): number { return 0; }
  maxConcurrent(): number { return 0; }
  requestRate(): number { return 0; }
  p50LatencyUs(): number { return 0; }
  p99LatencyUs(): number { return 0; }
  errorRate(): number { return 0; }
  version(): string { return ''; }
  labels(): Record<string, string> { return {}; }
}

function buildMetricsProvider(listenAddr: Host | undefined): StaticMetrics {
  let host = listenAddr?.host || '';
  const port = listenAddr?.port || 8443;
  if (!host || host === '0.0.0.0' || host === '::') {
    host = os.hostname();
  }
  return new StaticMetrics(create(HostSchema, { host, port }));
}
