// ServicePath returns the location-agnostic service identity used for S2S
// auth_services matching: the bare service label, plus any
// "/workloads/<child>" suffix (e.g. "mcp" or "mcp/workloads/agent-42").
// Only service and workload tokens have a service path. A full SPIFFE URI in
// the claim (durable-key form) is parsed and reduced to the same shape.
func (token *TokenWrapper) ServicePath() (string, error) {
	subType := token.GetSubType()
	if subType != "service" && subType != "workload" {
		return "", protoerrors.NewErrUnauthorized(nil, "token sub_type %q has no service path", subType)
	}
	sub := token.GetSubject()
	if sub == "" && subType == "service" {
		sub = token.GetServiceName()
	}
	if sub == "" {
		return "", protoerrors.NewErrUnauthorized(nil, "service token has no sub or service_name claim")
	}
	path, err := wrapperSpiffe.ServicePathFromSpiffe(sub)
	if err == nil {
		return path, nil
	}
	if strings.Contains(sub, "://") {
		return "", protoerrors.NewErrUnauthorized(err, "token subject is not a valid service identity")
	}
	return sub, nil
}

// SubjectSpiffeId computes the acting principal's SPIFFE ID from the structured
// claims (sub_type, sub, namespace, service_name). The SPIFFE ID is a
// computation, not a wire claim. For service/workload tokens the result is the
// LOCATION-AGNOSTIC identity (no /system location tiers): the full
// location-bearing SVID is built by the service's own manager from runtime
// config, never reconstructed from a peer token.
