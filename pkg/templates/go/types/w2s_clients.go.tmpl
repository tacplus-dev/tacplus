{{- range .Services}}
	{{.FieldName}} *{{.ImportAlias}}.{{.ClientName}}
{{- end}}
}

// New{{.StructName}} constructs typed W2S clients for the "{{.Target}}" service.
func New{{.StructName}}(client *http.Client, baseURL string, tokenProvider TokenProvider) *{{.StructName}} {
	return &{{.StructName}}{
{{- range .Services}}
		{{.FieldName}}: {{.ImportAlias}}.New{{.ClientName}}(client, baseURL, tokenProvider),
{{- end}}
	}
}

{{- range .Services}}

// {{.AccessorName}} returns the {{.ClientName}} wrapper.
