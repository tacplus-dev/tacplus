class _W2SBidiHandle:
    def __init__(self, client: {{.ClientName}}, auth_required: bool) -> None:
        self._client = client
        self._auth_required = auth_required
        self._queue: asyncio.Queue = asyncio.Queue(maxsize=32)
        self._task: Optional[asyncio.Task] = None
        self._closed = False

    def start(self, path: str, on_connect, on_message, response_class, validate_response=None) -> None:
        self._task = asyncio.create_task(
            self._run(path, on_connect, on_message, response_class, validate_response)
        )

    async def close(self) -> None:
        self._closed = True
        if self._task is not None:
            self._task.cancel()
            with contextlib.suppress(asyncio.CancelledError):
                await self._task

    async def finish(self) -> None:
        await self._queue.put(None)
        if self._task is not None:
            await self._task

    async def _send_body(self, body: Dict[str, Any]) -> None:
        if self._closed:
            raise RuntimeError("W2S bidirectional stream is closed")
        authorization = await self._client._auth_header(self._auth_required)
        loop = asyncio.get_running_loop()
        ack = loop.create_future()
        await asyncio.wait_for(
            self._queue.put((body, authorization, ack)),
            timeout=self._client._request_timeout,
        )
        await asyncio.wait_for(ack, timeout=self._client._request_timeout)

    async def _call_callback(self, callback, *args) -> None:
        result = callback(*args)
        if inspect.isawaitable(result):
            await result

    async def _run(self, path: str, on_connect, on_message, response_class, validate_response) -> None:
        while not self._closed:
            try:
                async with self._client._connect_websocket(path) as ws:
                    await self._client._send_start_frame(ws, self._auth_required)
                    connect_task = asyncio.create_task(self._call_callback(on_connect, self))

                    try:
                        while not self._closed:
                            send_task = asyncio.create_task(self._queue.get())
                            recv_task = asyncio.create_task(ws.recv())
                            wait_tasks = {send_task, recv_task}
                            if connect_task is not None:
                                wait_tasks.add(connect_task)
                            done, pending = await asyncio.wait(
                                wait_tasks,
                                return_when=asyncio.FIRST_COMPLETED,
                            )
                            for task in pending:
                                if task is not connect_task:
                                    task.cancel()
                            for task in pending:
                                if task is not connect_task:
                                    with contextlib.suppress(asyncio.CancelledError):
                                        await task

                            if connect_task is not None and connect_task in done:
                                connect_task.result()
                                connect_task = None

                            if send_task in done:
                                item = send_task.result()
                                if item is None:
                                    await self._client._send_complete_frame(ws)
                                    return
                                body, authorization, ack = item
                                try:
                                    await self._client._send_message_frame_with_auth(
                                        ws, body, authorization
                                    )
                                    ack.set_result(None)
                                except Exception as exc:
                                    ack.set_exception(exc)
                                    break

                            if recv_task in done:
                                data = recv_task.result()
                                if isinstance(data, bytes):
                                    raise RuntimeError(
                                        "binary W2S WebSocket responses are not supported"
                                    )
                                value = self._client._decode_ws_value(data)
                                if isinstance(value, dict) and value.get("type") in {
                                    "ping",
                                    "pong",
                                    "keepalive",
                                }:
                                    continue
                                msg = self._client._parse_message(value, response_class, validate_response)
                                await self._call_callback(on_message, msg)
                    finally:
                        if connect_task is not None and not connect_task.done():
                            connect_task.cancel()
                            with contextlib.suppress(asyncio.CancelledError):
                                await connect_task
            except asyncio.CancelledError:
                raise
            except Exception:
                if self._closed:
                    return
                await asyncio.sleep(5)

