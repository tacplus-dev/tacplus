        if (segs.size() != 4 || !segs.get(2).equals(USERS_SEGMENT) || !segs.get(1).equals(segs.get(3))) {
            throw new IllegalArgumentException(
                    "spiffe: malformed person identity: /" + String.join("/", segs));
        }
        p.subjectKind = SubjectKind.USER;
        p.namespace = "/" + PEOPLE_SEGMENT + "/" + segs.get(1);
        p.subjectPath = segs.get(3);
    }

    private static void classifyNamespaced(ParsedSpiffeId p, List<String> segs, int tagIdx, SubjectKind kind) {
        if (tagIdx + 1 >= segs.size() || tagIdx == 0) {
            throw new IllegalArgumentException(
                    "spiffe: malformed " + kind + " identity: /" + String.join("/", segs));
        }
        p.subjectKind = kind;
        p.namespace = "/" + String.join("/", segs.subList(0, tagIdx));
        p.subjectPath = String.join("/", segs.subList(tagIdx + 1, segs.size()));
    }

    private static void classifyPair(ParsedSpiffeId p, List<String> segs, int tagIdx, SubjectKind kind) {
        if (tagIdx == 0 || tagIdx + 2 >= segs.size()) {
            throw new IllegalArgumentException(
                    "spiffe: malformed kind/id identity: /" + String.join("/", segs));
