// Pins NEW-18 / NEW-21: service-mesh channels are fail-CLOSED and fail-FAST.
// channelFactory refuses an empty/absent trust domain at CONSTRUCTION time (not
// inside the per-connect lambda, where it would be caught as a transient endpoint
// error and retried with backoff for minutes). A real trust domain builds a
// factory. There is no CA-only fallback.
public class ServiceConnectionTest {
    private static int failures = 0;

    private static void mustThrow(String name, Runnable r) {
        try {
            r.run();
            System.err.println("FAIL: " + name + " did not throw (fail-open)");
            failures++;
        } catch (ServiceConnection.MissingTrustDomainException e) {
            // Expected: a TYPED exception. The generated ServiceManager classifies an
            // empty trust domain as a permanent (non-retryable) init error by TYPE
            // (instanceof), so fail-fast SM startup depends on this exact type — not a
            // message substring (NEW-21). A bare IllegalArgumentException would not be
            // caught here and would fail the test, pinning the type contract.
        }
    }

    public static void main(String[] args) throws Exception {
        List<X509.X509Cert> cas = new ArrayList<>();

        mustThrow("empty trust domain", () -> ServiceConnection.channelFactory(cas, ""));
        mustThrow("null trust domain", () -> ServiceConnection.channelFactory(cas, null));

        // A real trust domain builds a factory without throwing at construction.
        ServiceConnection.ChannelFactory f = ServiceConnection.channelFactory(cas, "example.com");
        if (f == null) {
            System.err.println("FAIL: channelFactory returned null for a valid trust domain");
            failures++;
        }

        checkBackoff();
        checkReadiness();
        checkStaticConnWhileReconnecting();
        checkReconcileGrace();
        checkRouteTenant();
        checkRouteTenantFromWire();
        checkTenantRouting();
        checkPlatformProviderUnaffected();

        if (failures > 0) {
            System.err.println(failures + " ServiceConnection check(s) FAILED");
            System.exit(1);
        }
        System.out.println("ServiceConnectionTest: all checks passed");
    }

    private static void expect(boolean ok, String what) {
        if (!ok) {
            System.err.println("FAIL: " + what);
            failures++;
        }
    }

    /** Reconnect backoff doubles from 500ms to a 30s cap and never exceeds it. */
    private static void checkBackoff() {
        long[] want = {500, 1_000, 2_000, 4_000, 8_000, 16_000, 30_000, 30_000, 30_000};
        long d = ReconnectBackoff.INITIAL_MS;
        for (int i = 0; i < want.length; i++) {
            expect(d == want[i], "backoff step " + i + " = " + d + "ms, want " + want[i] + "ms");
            d = ReconnectBackoff.next(d);
        }
        expect(ReconnectBackoff.next(Long.MAX_VALUE) == ReconnectBackoff.MAX_MS, "backoff(max) must cap");
        expect(ReconnectBackoff.next(ReconnectBackoff.MAX_MS) == ReconnectBackoff.MAX_MS, "backoff(cap) must stay at cap");
    }

    /** Readiness requires every pool to have a routable endpoint and every stream flag to be up. */
    private static void checkReadiness() {
        expect(new RequiredChannels(List.of(), List.of()).firstDown().isEmpty(), "nothing required must be ready");

        ServiceConnection empty = new ServiceConnection("eventbus", (id, target) -> null);
        expect(new RequiredChannels(List.of(empty), List.of()).firstDown().orElse("").equals("eventbus"),
                "a pool with no endpoints must be down");

        ManagedChannel channel = ManagedChannelBuilder.forAddress("127.0.0.1", 1).usePlaintext().build();
        try {
            ServiceConnection sc = ServiceConnection.fromChannel("identity", channel);
            RequiredChannels required = new RequiredChannels(List.of(sc), List.of());
            sc.setEndpointHealthForTest(InstanceStatus.INSTANCE_STATUS_STARTING);
            expect(required.firstDown().orElse("").equals("identity"), "STARTING peer must be down");
            sc.setEndpointHealthForTest(InstanceStatus.INSTANCE_STATUS_HEALTHY);
            expect(required.firstDown().isEmpty(), "HEALTHY peer must be up");
            sc.setEndpointHealthForTest(InstanceStatus.INSTANCE_STATUS_DEGRADED);
            expect(required.firstDown().isEmpty(), "DEGRADED peer still serves");
            sc.setEndpointHealthForTest(InstanceStatus.INSTANCE_STATUS_UNHEALTHY);
            expect(required.firstDown().isEmpty(), "one UNHEALTHY report must not take the peer down");
            expect(sc.isAvailableAt(Instant.now().plusSeconds(10)), "UNHEALTHY inside the 30s window must stay up");
            expect(!sc.isAvailableAt(Instant.now().plusSeconds(31)), "UNHEALTHY past the 30s window must be down");

            sc.setEndpointHealthForTest(InstanceStatus.INSTANCE_STATUS_HEALTHY);
            AtomicBoolean up = new AtomicBoolean(false);
            RequiredChannels withStream = new RequiredChannels(List.of(sc),
                    List.of(new RequiredChannels.RequiredStream("events subscription", up)));
            expect(withStream.firstDown().orElse("").equals("events subscription"), "stream flag false must be down");
            up.set(true);
            expect(withStream.firstDown().isEmpty(), "stream flag true must be up");
            up.set(false);
            expect(withStream.firstDown().isPresent(), "stream flag false again must be down");
        } finally {
            channel.shutdownNow();
        }
    }

    /**
     * A static pool whose peer is down (the kernel rolling) still hands out its
     * channel from conn(): callers snapshot it (new Authorizer(remoteSource(conn())))
     * and a null there killed startup. A closed pool returns null.
     */
    private static void checkStaticConnWhileReconnecting() throws Exception {
        Server server = NettyServerBuilder.forPort(0).build().start();
        HostOuterClass.Host host = HostOuterClass.Host.newBuilder()
                .setHost("127.0.0.1").setPort(server.getPort()).build();
        ServiceConnection sc = ServiceConnection.newStatic("statestore", List.of(host),
                (id, target) -> ManagedChannelBuilder.forTarget(target).usePlaintext().build());
        try {
            ManagedChannel channel = sc.conn();
            expect(channel != null, "static pool conn() must be non-null while READY");
            if (channel == null) {
                return;
            }

            server.shutdownNow().awaitTermination(5, TimeUnit.SECONDS);
            ConnectivityState state = channel.getState(true);
            long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(10);
            while (state != ConnectivityState.CONNECTING && state != ConnectivityState.TRANSIENT_FAILURE
                    && System.nanoTime() < deadline) {
                Thread.sleep(20);
                state = channel.getState(true);
            }
            expect(state == ConnectivityState.CONNECTING || state == ConnectivityState.TRANSIENT_FAILURE,
                    "static pool channel never left READY/IDLE after its peer went down (state " + state + ")");
            expect(sc.conn() == channel,
                    "static pool conn() must return its channel while " + state + ", got " + sc.conn());
        } finally {
            sc.close();
            server.shutdownNow();
        }
        expect(sc.conn() == null, "closed static pool conn() must be null");
    }

    /**
     * A snapshot that omits a dialed endpoint keeps it pooled and ready. Only
     * ABSENT_POLLS_BEFORE_CLOSE snapshots in a row close it, and a return resets the count.
     */
    private static void checkReconcileGrace() throws Exception {
        Server server = NettyServerBuilder.forPort(0).build().start();
        try {
            HostOuterClass.Host host = HostOuterClass.Host.newBuilder()
                    .setHost("127.0.0.1").setPort(server.getPort()).build();
            ServiceInstanceHealth report = ServiceInstanceHealth.newBuilder()
                    .setServiceId("identity").setGrpcEndpoint(host)
                    .setStatus(InstanceStatus.INSTANCE_STATUS_HEALTHY).build();
            ServiceConnection sc = new ServiceConnection("identity",
                    (id, target) -> ManagedChannelBuilder.forTarget(target).usePlaintext().build());
            sc.reconcileFromHealth(List.of(report));
            expect(sc.isAvailable(), "dialed endpoint must be ready");

            for (int i = 1; i < ServiceConnection.ABSENT_POLLS_BEFORE_CLOSE; i++) {
                sc.reconcileFromHealth(List.of());
            }
            expect(sc.isAvailable(), "endpoint absent for fewer than the grace snapshots must stay ready");

            sc.reconcileFromHealth(List.of(report));
            expect(sc.isAvailable(), "endpoint that returns must stay ready");

            for (int i = 0; i < ServiceConnection.ABSENT_POLLS_BEFORE_CLOSE; i++) {
                sc.reconcileFromHealth(List.of());
            }
            expect(!sc.isAvailable(), "endpoint absent for the grace snapshots in a row must be closed");
        } finally {
            server.shutdownNow();
        }
    }

    // ---- (spec.rpc).route_field: tenant routing (issue #170) ----

    private interface Call {
        void run() throws Exception;
    }

    /** Expects a ProtoException with code (the generated clients' and gateway's refusal type). */
    private static void expectProto(int code, String what, Call c) {
        try {
            c.run();
            System.err.println("FAIL: " + what + " was accepted");
            failures++;
        } catch (ProtoException e) {
            expect(e.getCode() == code, what + ": code " + e.getCode() + ", want " + code + " (" + e.getMessage() + ")");
            expect(e.getMessage() != null && e.getMessage().contains("tenant"),
                    what + ": the refusal must name the route field, got " + e.getMessage());
        } catch (Exception e) {
            System.err.println("FAIL: " + what + " threw an untyped error: " + e);
            failures++;
        }
    }

    /** Expects a StatusRuntimeException with code (what a ChannelProvider refuses a call with). */
    private static void expectStatus(Status.Code code, String what, Call c) {
        try {
            c.run();
            System.err.println("FAIL: " + what + " was routed");
            failures++;
        } catch (StatusRuntimeException e) {
            expect(e.getStatus().getCode() == code, what + ": status " + e.getStatus() + ", want " + code);
        } catch (Exception e) {
            System.err.println("FAIL: " + what + " threw an untyped error: " + e);
            failures++;
        }
    }

    /** A tid is exactly 8 characters of [0-9a-z]; nothing else is one, and nothing is trimmed or folded. */
    private static void checkRouteTenant() throws Exception {
        for (String ok : List.of("aaaaaaaa", "00000001", "a1b2c3d4", "zzzzzzzz")) {
            expect(RouteTenant.validTenantId(ok), ok + " must be a tid");
            expect(RouteTenant.require("tenant", ok).equals(ok), "require(" + ok + ") must return it unchanged");
        }
        for (String bad : new String[] {null, "", "aaaaaaa", "aaaaaaaaa", "AAAAAAAA", "aaaaaaaA", " aaaaaaaa",
                "aaaaaaaa ", "aaaa-aaa", "aaaa/aaa", "ääääääää", "aaaa\u0000aaa"}) {
            expect(!RouteTenant.validTenantId(bad), "\"" + bad + "\" must not be a tid");
            expectProto(ProtoException.INVALID_ARGUMENT, "route field value \"" + bad + "\"",
                    () -> RouteTenant.require("tenant", bad));
        }
        expect(RouteTenant.tenantOfNamespace("/tenants/aaaaaaaa").equals("aaaaaaaa"), "/tenants/<tid> names its tenant");
        for (String ns : new String[] {null, "", "/", "/system", "/tenants", "/tenants/", "/tenants/acme",
                "/tenants/aaaaaaaa/workspaces/dev", "/tenants/AAAAAAAA", "/system/tenants/aaaaaaaa"}) {
            expect(RouteTenant.tenantOfNamespace(ns).isEmpty(), "namespace \"" + ns + "\" names no routable tenant");
        }
        // A caller's tenant: its namespace claim's /tenants/<tid>, at or below it.
        for (String ns : List.of("/tenants/aaaaaaaa", "/tenants/aaaaaaaa/workspaces/dev")) {
            expect(RouteTenant.tenantOfCaller(ns).equals("aaaaaaaa"), "a caller in " + ns + " belongs to tenant aaaaaaaa");
        }
        for (String ns : new String[] {null, "", "/", "/system", "/tenants", "/tenants/", "/tenants/acme",
                "/tenants/acme/workspaces/dev", "/tenants/aaaaaaaa/", "/tenants/AAAAAAAA", "/system/tenants/aaaaaaaa"}) {
            expect(RouteTenant.tenantOfCaller(ns).isEmpty(), "a caller in \"" + ns + "\" belongs to no tenant");
        }
        expect(RouteTenant.tenantOfInstance("spiffe://example.com/tenants/aaaaaaaa/services/crew").equals("aaaaaaaa"),
                "a tenant service instance belongs to its tenant");
        for (String id : new String[] {null, "", "not a uri", "spiffe://example.com/system/aws/services/crew",
                "spiffe://example.com/tenants/acme/services/crew",
                "spiffe://example.com/tenants/aaaaaaaa/workspaces/dev/services/crew"}) {
            expect(RouteTenant.tenantOfInstance(id).isEmpty(), "instance \"" + id + "\" is not routable by tenant");
        }
    }

    private static void varint(ByteArrayOutputStream out, long v) {
        while ((v & ~0x7FL) != 0) {
            out.write((int) ((v & 0x7F) | 0x80));
            v >>>= 7;
        }
        out.write((int) v);
    }

    private static void lenField(ByteArrayOutputStream out, int number, byte[] value) {
        varint(out, ((long) number << 3) | 2);
        varint(out, value.length);
        out.write(value, 0, value.length);
    }

    private static byte[] utf8(String s) {
        return s.getBytes(StandardCharsets.UTF_8);
    }

    /**
     * The gateway's gRPC proxy holds only the raw request frame: the route field
     * is read off the protobuf wire encoding, last occurrence wins, and anything
     * malformed is refused rather than skipped.
     */
    private static void checkRouteTenantFromWire() throws Exception {
        // Field 1 (a string), field 2 (a varint), field 3 (i64), field 4 (i32),
        // a group (field 5) with a nested LEN field 3 inside it, then the route
        // field 3 = "aaaaaaaa".
        ByteArrayOutputStream ok = new ByteArrayOutputStream();
        lenField(ok, 1, utf8("hello"));
        varint(ok, (2 << 3) | 0);
        varint(ok, 300);
        varint(ok, (3L << 3) | 1);
        ok.write(new byte[8], 0, 8);
        varint(ok, (4 << 3) | 5);
        ok.write(new byte[4], 0, 4);
        varint(ok, (5 << 3) | 3);
        lenField(ok, 3, utf8("zzzzzzzz"));
        varint(ok, (5 << 3) | 4);
        lenField(ok, 3, utf8("aaaaaaaa"));
        expect(RouteTenant.fromWire(ok.toByteArray(), 3, "tenant").equals("aaaaaaaa"),
                "the route field is read off the wire, skipping every other wire type");

        // proto3 last-one-wins.
        ByteArrayOutputStream twice = new ByteArrayOutputStream();
        lenField(twice, 3, utf8("aaaaaaaa"));
        lenField(twice, 3, utf8("bbbbbbbb"));
        expect(RouteTenant.fromWire(twice.toByteArray(), 3, "tenant").equals("bbbbbbbb"),
                "the last occurrence of the route field wins");

        // Missing field: empty, refused.
        ByteArrayOutputStream missing = new ByteArrayOutputStream();
        lenField(missing, 1, utf8("aaaaaaaa"));
        expectProto(ProtoException.INVALID_ARGUMENT, "frame without the route field",
                () -> RouteTenant.fromWire(missing.toByteArray(), 3, "tenant"));
        expectProto(ProtoException.INVALID_ARGUMENT, "empty frame",
                () -> RouteTenant.fromWire(new byte[0], 3, "tenant"));
        expectProto(ProtoException.INVALID_ARGUMENT, "null frame",
                () -> RouteTenant.fromWire(null, 3, "tenant"));

        // Malformed tid on the wire.
        ByteArrayOutputStream upper = new ByteArrayOutputStream();
        lenField(upper, 3, utf8("AAAAAAAA"));
        expectProto(ProtoException.INVALID_ARGUMENT, "malformed tid on the wire",
                () -> RouteTenant.fromWire(upper.toByteArray(), 3, "tenant"));

        // Malformed encodings.
        java.util.Map<String, byte[]> malformed = new java.util.LinkedHashMap<>();
        malformed.put("truncated varint", new byte[] {(byte) 0x80});
        malformed.put("overlong varint", new byte[] {8, (byte) 0xff, (byte) 0xff, (byte) 0xff, (byte) 0xff,
                (byte) 0xff, (byte) 0xff, (byte) 0xff, (byte) 0xff, (byte) 0xff, (byte) 0xff, 1});
        malformed.put("field number 0", new byte[] {2, 0});
        malformed.put("length past the end", new byte[] {0x1a, 9, 'a', 'a'});
        malformed.put("truncated i64", new byte[] {0x19, 1, 2, 3});
        malformed.put("truncated i32", new byte[] {0x25, 1});
        malformed.put("wire type 6", new byte[] {0x1e});
        malformed.put("wire type 7", new byte[] {0x1f});
        malformed.put("end group without start", new byte[] {0x2c});
        malformed.put("unterminated group", new byte[] {0x2b, 0x08, 1});
        malformed.put("mismatched end group", new byte[] {0x2b, 0x34});
        malformed.put("invalid UTF-8", new byte[] {0x1a, 8, (byte) 0xc3, 'a', 'a', 'a', 'a', 'a', 'a', 'a'});
        for (java.util.Map.Entry<String, byte[]> e : malformed.entrySet()) {
            expectProto(ProtoException.INVALID_ARGUMENT, e.getKey(), () -> RouteTenant.fromWire(e.getValue(), 3, "tenant"));
        }
    }

    private static ServiceInstanceHealth tenantInstance(Server server, String spiffeId) {
        HostOuterClass.Host host = HostOuterClass.Host.newBuilder()
                .setHost("127.0.0.1").setPort(server.getPort()).build();
        return ServiceInstanceHealth.newBuilder()
                .setServiceId("crew").setGrpcEndpoint(host).setSpiffeId(spiffeId)
                .setStatus(InstanceStatus.INSTANCE_STATUS_HEALTHY).build();
    }

    private static CallOptions routed(String tid) {
        return CallOptions.DEFAULT.withOption(RouteTenant.CALL_OPTION, tid);
    }

    /**
     * A tenant-routed target's pool is per tenant, fed from the same health
     * reports and grouped by each instance's spiffe_id tenant: a call naming
     * aaaaaaaa reaches aaaaaaaa's instance and one naming bbbbbbbb reaches
     * bbbbbbbb's, never the other's and never a shared one.
     */
    private static void checkTenantRouting() throws Exception {
        Server a = NettyServerBuilder.forPort(0).build().start();
        Server b = NettyServerBuilder.forPort(0).build().start();
        Server shared = NettyServerBuilder.forPort(0).build().start();
        TenantConnections tenants = new TenantConnections("crew",
                (id, target) -> ManagedChannelBuilder.forTarget(target).usePlaintext().build());
        try {
            tenants.reconcileFromHealth(List.of(
                    tenantInstance(a, "spiffe://example.com/tenants/aaaaaaaa/services/crew"),
                    tenantInstance(b, "spiffe://example.com/tenants/bbbbbbbb/services/crew"),
                    tenantInstance(shared, "spiffe://example.com/system/aws/services/crew")));
            ServiceConnection.ChannelProvider provider = new ServiceConnection.ChannelProvider(tenants);
            String wantA = "127.0.0.1:" + a.getPort();
            String wantB = "127.0.0.1:" + b.getPort();
            expect(wantA.equals(provider.resolve(routed("aaaaaaaa")).authority()),
                    "tenant aaaaaaaa must reach its own instance " + wantA);
            expect(wantB.equals(provider.resolve(routed("bbbbbbbb")).authority()),
                    "tenant bbbbbbbb must reach its own instance " + wantB);
            expect(tenants.tenants().equals(java.util.Set.of("aaaaaaaa", "bbbbbbbb")),
                    "only /tenants/<tid> instances are routable, got " + tenants.tenants());

            // A tenant with no instance: UNAVAILABLE, never another tenant's instance.
            expectStatus(Status.Code.UNAVAILABLE, "tenant with no instance", () -> provider.resolve(routed("cccccccc")));
            // No tenant on the call, or a malformed one: fail closed before dialling.
            expectStatus(Status.Code.INVALID_ARGUMENT, "routed call without a tenant", () -> provider.resolve(CallOptions.DEFAULT));
            expectStatus(Status.Code.INVALID_ARGUMENT, "routed call with an empty tenant", () -> provider.resolve(routed("")));
            expectStatus(Status.Code.INVALID_ARGUMENT, "routed call with a malformed tenant", () -> provider.resolve(routed("AAAAAAAA")));

            // Once a tenant's instance has been absent for the grace snapshots, its pool closes.
            for (int i = 0; i < ServiceConnection.ABSENT_POLLS_BEFORE_CLOSE; i++) {
                tenants.reconcileFromHealth(List.of(tenantInstance(b, "spiffe://example.com/tenants/bbbbbbbb/services/crew")));
            }
            expectStatus(Status.Code.UNAVAILABLE, "tenant whose instance left", () -> provider.resolve(routed("aaaaaaaa")));
            expect(wantB.equals(provider.resolve(routed("bbbbbbbb")).authority()), "the remaining tenant still routes");
        } finally {
            tenants.close();
            a.shutdownNow();
            b.shutdownNow();
            shared.shutdownNow();
        }
    }

    /** A platform target keeps its single pool: a call reaches it exactly as before. */
    private static void checkPlatformProviderUnaffected() throws Exception {
        ManagedChannel channel = ManagedChannelBuilder.forAddress("127.0.0.1", 1).usePlaintext().build();
        try {
            ServiceConnection sc = ServiceConnection.fromChannel("identity", channel);
            ServiceConnection.ChannelProvider provider = new ServiceConnection.ChannelProvider(sc);
            expect(provider.resolve(CallOptions.DEFAULT) == channel, "a platform call must reach the pool's channel");
            // A single pool (e.g. a client manager's one channel to the gateway,
            // which routes by the request's route field) carries a routed call as-is.
            expect(provider.resolve(routed("aaaaaaaa")) == channel, "a single pool carries a routed call to its channel");
        } finally {
            channel.shutdownNow();
        }
    }
}
