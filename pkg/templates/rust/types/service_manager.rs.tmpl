            spiffe_verifier_base.clone();
        let state_store_conn = Arc::new(ServiceConnection::new_static(
            "{{.StateStoreServiceID}}",
            &cfg.endpoints,
            state_store_verifier,
        ).await?);

        // Create IdentityManager using the state-store channel.
        let (identity, state_store_conn) = {
            let mut attempt = 0u32;
            let init_start = std::time::Instant::now();
            loop {
                attempt += 1;
                let ch = state_store_conn.conn().await;
                match ch {
                    Some(channel) => {
                        match IdentityManager::new(channel, &cfg).await {
                            Ok(id) => break (Arc::new(id), state_store_conn),
                            Err(e) => {
                                let elapsed_s = init_start.elapsed().as_secs();
                                if is_permanent_identity_init_error(e.as_ref()) {
                                    tracing::error!(service = "{{.ServiceLabel}}", elapsed_s, error = %e,
                                        "ServiceManager startup failed: permanent identity error");
                                    return Err(format!("permanent identity startup failure: {}", e).into());
                                }
                                if attempt >= MAX_INIT_RETRIES {
                                    tracing::error!(service = "{{.ServiceLabel}}", attempts = attempt, elapsed_s, error = %e,
                                        "ServiceManager startup failed: identity init exhausted retries");
                                    return Err(format!("ServiceManager init failed after {} attempts ({}s): {}", attempt, elapsed_s, e).into());
                                }
