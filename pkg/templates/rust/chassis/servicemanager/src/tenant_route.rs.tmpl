/// tid (see [`route_tenant`]). A field that never occurs is empty, and refused.
/// `field_number` 0 is a platform route: no tenant, `Ok("")`.
pub fn route_tenant_from_wire(frame: &[u8], field_number: u32, field: &str) -> Result<String, tonic::Status> {
