impl<S, T> tokio_stream::Stream for AccountedStream<S>
where
    S: tokio_stream::Stream<Item = Result<T, tonic::Status>> + Unpin,
{
    type Item = Result<T, tonic::Status>;

    fn poll_next(
        mut self: std::pin::Pin<&mut Self>,
        cx: &mut std::task::Context<'_>,
    ) -> std::task::Poll<Option<Self::Item>> {
        let this = &mut *self;
        let polled = METRICS.sync_scope(this.metrics.clone(), || {
            std::pin::Pin::new(&mut this.inner).poll_next(cx)
        });
        if let std::task::Poll::Ready(item) = &polled {
            match item {
                Some(Err(status)) => {
                    if let Some(call) = this.call.take() {
                        call.finish_detached(Some(status.clone()));
                    }
                }
                None => {
                    if let Some(call) = this.call.take() {
                        call.finish_detached(None);
                    }
                }
                Some(Ok(_)) => {}
            }
        }
        polled
