    /// Creates a connection pool with static endpoints.
    ///
    /// Eagerly connects to all endpoints with exponential backoff retry.
    /// Starts a ping loop (latency measurement) and rebalance loop.
    /// This is the proven static bootstrap connection pattern.
    pub async fn new_static(
        service_id: &str,
        hosts: &[Host],
        verifier: Arc<dyn rustls::client::danger::ServerCertVerifier>,
    ) -> Result<Self, Box<dyn std::error::Error>> {
        if hosts.is_empty() {
            return Err(format!("ServiceConnection({}): no endpoints", service_id).into());
        }

        // Connect to all endpoints with exponential backoff retry (up to 5 min).
        const CONNECT_TIMEOUT_SECS: u64 = 5 * 60;
        const CONNECT_INITIAL_BACKOFF_SECS: u64 = 2;
        const CONNECT_MAX_BACKOFF_SECS: u64 = 30;

        let connect_deadline = tokio::time::Instant::now() + Duration::from_secs(CONNECT_TIMEOUT_SECS);
        let mut connect_backoff = Duration::from_secs(CONNECT_INITIAL_BACKOFF_SECS);
        let connect_max_backoff = Duration::from_secs(CONNECT_MAX_BACKOFF_SECS);

        let ep_list = loop {
            let mut ep_list = Vec::new();
            let mut handles = Vec::new();
            for ep in hosts {
                let target = format!("{}:{}", ep.host, ep.port);
                let ec = Arc::new(RwLock::new(EndpointConn::new(target)));
                ep_list.push(ec.clone());
                let v = verifier.clone();
                handles.push(tokio::spawn(async move {
                    let mut conn = ec.write().await;
                    if let Err(e) = conn.dial(v).await {
                        warn!(target = %conn.target, error = %e, "failed to connect");
                    }
                }));
            }
            for h in handles {
                let _ = h.await;
            }

            let any_connected = ep_list.iter().any(|ec| {
                // Can't await in closure, use try_read
                ec.try_read().map(|c| c.channel.is_some()).unwrap_or(false)
            });
            if any_connected {
                break ep_list;
            }

            if tokio::time::Instant::now() >= connect_deadline {
                return Err(format!(
                    "ServiceConnection({}): failed to connect after {}s",
                    service_id, CONNECT_TIMEOUT_SECS
                ).into());
            }

            warn!(
                service = %service_id,
                retry_in_secs = connect_backoff.as_secs(),
                "no endpoints reachable, retrying"
            );
            tokio::time::sleep(connect_backoff).await;
            connect_backoff = std::cmp::min(connect_backoff * 2, connect_max_backoff);
        };

        // Initial ping to measure latency
        for ec in &ep_list {
            let conn = ec.read().await;
            if conn.channel.is_some() {
                let _ = conn.ping().await;
            }
        }

        let endpoints = Arc::new(RwLock::new(ep_list));
        let active_idx = Arc::new(RwLock::new(0usize));

        // Select initial active
        {
            let eps = endpoints.read().await;
            Self::do_select_active(&eps, &active_idx).await;
        }

        // Start background tasks: ping + rebalance
        let mut tasks = Vec::new();

        // Ping loop
        {
            let eps = endpoints.clone();
            tasks.push(tokio::spawn(async move {
                let mut interval = tokio::time::interval(Duration::from_secs(PING_INTERVAL_SECS));
                loop {
                    interval.tick().await;
                    let ep_list = eps.read().await;
                    for ec in ep_list.iter() {
                        let conn = ec.read().await;
                        if conn.channel.is_some() {
                            if let Err(e) = conn.ping().await {
                                debug!(endpoint = %conn.target, error = %e, "ping failed");
                            }
                        }
                    }
                }
            }));
        }

        // Rebalance loop
        {
            let eps = endpoints.clone();
            let idx = active_idx.clone();
            tasks.push(tokio::spawn(async move {
                let mut interval = tokio::time::interval(Duration::from_secs(REBALANCE_INTERVAL_SECS));
                loop {
                    interval.tick().await;
                    let ep_list = eps.read().await;
                    Self::do_select_active(&ep_list, &idx).await;
                }
            }));
        }

        let active_target = {
            let eps = endpoints.read().await;
            let idx = *active_idx.read().await;
            if idx < eps.len() {
                eps[idx].read().await.target.clone()
            } else {
                "<none>".to_string()
            }
        };
        info!(
            service = %service_id,
            endpoints = hosts.len(),
            active = %active_target,
            "ServiceConnection: static pool ready"
        );

        Ok(Self {
            service_id: service_id.to_string(),
            endpoints,
            active_idx,
            verifier,
            _tasks: tasks,
        })
    }

