/// Configuration for GrpcServer
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct GrpcServerConfig {
    /// Network binding address - used as base if protocol ports not specified
    #[serde(default = "default_listen_address")]
    pub listen_address: String,

    /// TLS configuration
    #[serde(skip_serializing_if = "Option::is_none")]
    pub tls: Option<TLSConfig>,

    /// gRPC protocol configuration
    #[serde(default)]
    pub grpc: ProtocolConfig,

    /// REST API configuration
    #[serde(default)]
    pub rest: ProtocolConfig,

    /// API prefix for all API endpoints
    #[serde(default)]
    pub api_prefix: String,

    /// Enable CORS for REST endpoints
    #[serde(default)]
    pub enable_cors: bool,

    /// CORS allowed origins
    #[serde(default)]
    pub cors_origins: Vec<String>,

    /// Maximum request size in bytes
    #[serde(default = "default_max_request_size")]
    pub max_request_size: i64,

    /// Request timeout in seconds
    #[serde(default = "default_request_timeout_seconds")]
    pub request_timeout_seconds: i64,

    /// Enable metrics endpoint
    #[serde(default)]
    pub enable_metrics: bool,

    /// Enable OpenTelemetry tracing
    #[serde(default)]
    pub enable_tracing: bool,

    /// Logger configuration
    #[serde(skip_serializing_if = "Option::is_none")]
    pub logger: Option<LoggerConfig>,

    /// Authorization rules
    #[serde(default)]
    pub auth_rules: Vec<serde_json::Value>,

    /// Static file serving configuration
    #[serde(default)]
    pub static_file_paths: HashMap<String, String>,

    /// Graceful shutdown timeout in seconds
    #[serde(default = "default_shutdown_timeout")]
    pub shutdown_timeout_secs: u64,
}

/// TLS/SSL configuration
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct TLSConfig {
    pub enabled: bool,
    #[serde(skip_serializing_if = "Option::is_none")]
    pub tls_cert: Option<X509CertPair>,
    #[serde(default)]
    pub alpn_protocols: Vec<ALPNProtocol>,
}

impl Default for TLSConfig {
    fn default() -> Self {
        Self {
            enabled: true,
            tls_cert: None,
            alpn_protocols: vec![ALPNProtocol::H2, ALPNProtocol::Http11],
        }
    }
}

/// X.509 certificate pair
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct X509CertPair {
    pub cert_pem: String,
    pub key_pem: String,
}

/// ALPN protocol identifiers
#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
#[serde(rename_all = "SCREAMING_SNAKE_CASE")]
pub enum ALPNProtocol {
    #[serde(rename = "ALPN_PROTOCOL_H2")]
    H2,
    #[serde(rename = "ALPN_PROTOCOL_HTTP_1_1")]
    Http11,
}

impl ALPNProtocol {
    pub fn as_str(&self) -> &'static str {
        match self {
            ALPNProtocol::H2 => "h2",
            ALPNProtocol::Http11 => "http/1.1",
        }
    }
}

/// Protocol configuration (gRPC, REST)
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ProtocolConfig {
    #[serde(default = "default_true")]
    pub enabled: bool,
    #[serde(default)]
    pub port: u16,
}

impl Default for ProtocolConfig {
    fn default() -> Self {
        Self {
            enabled: true,
            port: 0,
        }
    }
}

