def _build_metrics_provider(config) -> _StaticMetrics:
    """Builds a metrics provider from the configured listen address."""
    import socket as _socket
    from {{.PythonPackageBase}}.types.sys.host import host_pb2

    listen_addr = getattr(config, "listen_address", None)
    host = getattr(listen_addr, "host", "") or ""
    port = getattr(listen_addr, "port", 8443) or 8443
    if not host or host in ("0.0.0.0", "::"):
        host = _socket.gethostname()
    return _StaticMetrics(host_pb2.Host(host=host, port=port))
