    /// Creates a new client connected to the state service via the given channel.
    /// Spawns background Watch streams for all cached boundaries.
    pub async fn new(channel: Channel, token_provider: Option<TokenProvider>) -> Result<Self, Box<dyn std::error::Error>> {
        let stub = {{.StateServiceClientType}}::new(channel.clone());
        let inner = Arc::new({{.StateRootName}}ClientInner {
            state: RwLock::new({{.StateRootName}}ClientState {
{{- range .InlineFields}}
                {{.FieldName}}_cache: None,
{{- end}}
{{- range .Singletons}}
                {{.FieldName}}_cache: None,
                {{.FieldName}}_callbacks: Vec::new(),
