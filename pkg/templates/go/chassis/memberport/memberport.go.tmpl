}

// ---- Byte sessions ----

// session is one loopback connection's bytes over a sequence of streams. The
// pump sends local bytes on the send leg; the reader takes the read leg's
// chunks in order and moves to the next leg only past the read leg's last.
type session struct {
	p     *MemberPort
	plain *net.TCPConn
	// sendMu serialises the sends of the session and the moves of sendLeg.
	sendMu  sync.Mutex
	sendLeg atomic.Pointer[leg]
	readLeg atomic.Pointer[leg]
	// nextLeg is the leg after the read leg: set when a rotation attaches,
	// before either side's last.
	nextLeg     atomic.Pointer[leg]
	finSent     atomic.Bool
	finReceived atomic.Bool
	done        atomic.Bool
	id          atomic.Pointer[string]

	// The server side: the subject its streams must name, and whether a
	// rotation is attached and not yet cut over (guarded by attachMu).
	inbound  bool
	subject  string
	attachMu sync.Mutex
	rotating bool

	// The client side: the channel to the remote member port.
	conn        *grpc.ClientConn
	remote      string
	rotatingNow atomic.Bool
	timerMu     sync.Mutex
	rotation    *time.Timer
}

func (s *session) sessionID() string {
	if id := s.id.Load(); id != nil {
		return *id
	}
	return ""
}

// start moves bytes on first, both ways.
func (s *session) start(first *leg) {
	s.sendLeg.Store(first)
	s.readLeg.Store(first)
	if err := s.plain.SetNoDelay(true); err != nil {
		s.fault("socket options: "+err.Error(), codes.Canceled)
		return
	}
	s.p.mu.Lock()
	if s.p.closed {
		s.p.mu.Unlock()
		s.fault("member port closed", codes.Unavailable)
		return
	}
	s.p.sessions[s] = struct{}{}
	s.p.mu.Unlock()
	go s.pump()
	go s.read()
}

// send sends c on the current send leg; a stream that cannot take it drops the session.
func (s *session) send(c *memberport_pb.MemberChunk) bool {
	s.sendMu.Lock()
	err := s.sendLeg.Load().send(c)
	s.sendMu.Unlock()
	if err != nil {
		s.fault("stream send: "+err.Error(), codes.Canceled)
		return false
	}
	return true
}

// pump moves local bytes to the send leg; SendMsg blocks while the stream's
// window is spent (backpressure), and the local reads stop with it.
func (s *session) pump() {
	buf := make([]byte, MaxChunkBytes)
	for !s.done.Load() {
		n, err := s.plain.Read(buf)
		if n > 0 {
			payload := make([]byte, n)
			copy(payload, buf[:n])
			if !s.send(&memberport_pb.MemberChunk{Payload: payload}) {
				return
			}
		}
		if err == io.EOF {
			s.sendMu.Lock()
			// Set first: the peer may answer the fin before send returns.
			s.finSent.Store(true)
			ferr := s.sendLeg.Load().send(&memberport_pb.MemberChunk{Fin: true})
			s.sendMu.Unlock()
			if ferr != nil {
				s.fault("stream send: "+ferr.Error(), codes.Canceled)
				return
			}
			s.finished()
			return
		}
		if err != nil {
			s.fault("local connection: "+err.Error(), codes.Canceled)
			return
		}
	}
}

// read moves the read leg's chunks to the local connection, leg by leg.
func (s *session) read() {
	for !s.done.Load() {
		l := s.readLeg.Load()
		chunk := &memberport_pb.MemberChunk{}
		if err := l.recv(chunk); err != nil {
			if s.finSent.Load() && s.finReceived.Load() {
				s.ended(l)
			} else {
				s.fault(fmt.Sprintf("stream ended without last (%s)", status.Code(err)), codes.Canceled)
			}
			return
		}
		if len(chunk.Payload) > MaxChunkBytes || (s.finReceived.Load() && len(chunk.Payload) > 0) || chunk.SessionId != "" {
			s.fault("malformed chunk", codes.Canceled)
			return
		}
		if len(chunk.Payload) > 0 {
			if _, err := s.plain.Write(chunk.Payload); err != nil {
				s.fault("local connection: "+err.Error(), codes.Canceled)
				return
			}
		}
		if chunk.Fin && !s.finReceived.Load() {
			s.finReceived.Store(true)
			_ = s.plain.CloseWrite()
			s.finished()
		}
		if chunk.Last {
			next := s.nextLeg.Load()
			if next == nil {
				s.fault("last with no stream to cut over to", codes.Canceled)
				return
			}
			s.readLeg.Store(next)
			s.nextLeg.CompareAndSwap(next, nil)
			s.lastReceived(l, next)
		}
	}
}

// cutOver moves the sends to next: last on the old leg, which then ends.
func (s *session) cutOver(next *leg) {
	s.sendMu.Lock()
	defer s.sendMu.Unlock()
	old := s.sendLeg.Load()
	_ = old.send(&memberport_pb.MemberChunk{Last: true})
	old.finish()
	old.stopExpiry()
	s.sendLeg.Store(next)
}

// lastReceived: the read leg's last arrived, the reader moves to next.
func (s *session) lastReceived(old, next *leg) {
	if s.inbound {
		// The client cut over: its last is the server's cue to cut over too.
		s.cutOver(next)
		s.attachMu.Lock()
		s.rotating = false
		s.attachMu.Unlock()
		return
	}
	// The server's last follows the client's: its sends are already on next.
	// The old stream ends OK after it; read that end so the stream is freed.
	go func() {
		var c memberport_pb.MemberChunk
		for old.recv(&c) == nil {
		}
		old.release()
	}()
}

// finished: one direction or both sent their fin. The client ends the stream
// once both have; the server ends its side when it sees that.
func (s *session) finished() {
	if s.inbound || !s.finSent.Load() || !s.finReceived.Load() {
		return
	}
	s.sendMu.Lock()
	s.sendLeg.Load().finish()
	s.sendMu.Unlock()
}

// ended: the read leg ended after both directions' fin, a clean end.
func (s *session) ended(l *leg) {
	if !s.done.CompareAndSwap(false, true) {
		return
	}
	s.forget()
	l.stopExpiry()
	l.finish()
	l.release()
	if pending := s.nextLeg.Load(); pending != nil {
		pending.stopExpiry()
		pending.abort(codes.Canceled)
	}
	_ = s.plain.Close()
}

// fault drops the session: every stream ends, the local connection is reset.
func (s *session) fault(reason string, code codes.Code) {
	if !s.done.CompareAndSwap(false, true) {
		return
	}
	s.forget()
	zap.L().Info("member port: session dropped", zap.String("session", s.sessionID()), zap.String("reason", reason))
	for _, l := range []*leg{s.sendLeg.Load(), s.readLeg.Load(), s.nextLeg.Load()} {
		if l != nil {
			l.stopExpiry()
			l.abort(code)
		}
	}
	reset(s.plain)
}

// forget removes the session from what can still find it.
func (s *session) forget() {
	s.p.mu.Lock()
	delete(s.p.sessions, s)
	if s.inbound {
		if id := s.sessionID(); s.p.inbound[id] == s {
			delete(s.p.inbound, id)
		}
	}
	s.p.mu.Unlock()
	s.timerMu.Lock()
	if s.rotation != nil {
		s.rotation.Stop()
	}
	s.timerMu.Unlock()
}

// ---- The server side ----

// attach attaches a rotation's leg, when the session is live and has none pending.
func (s *session) attach(l *leg) bool {
	s.attachMu.Lock()
	defer s.attachMu.Unlock()
	if s.done.Load() || s.rotating || s.finSent.Load() && s.finReceived.Load() {
		return false
	}
	s.rotating = true
	s.nextLeg.Store(l)
	// fault sets done before it reads nextLeg: one of the two sees the other.
	if s.done.Load() {
		s.nextLeg.CompareAndSwap(l, nil)
		s.rotating = false
		return false
	}
	return true
}

// detach: a pending rotation's leg ended before its cutover, the session may take another.
func (s *session) detach(l *leg) {
	s.attachMu.Lock()
	defer s.attachMu.Unlock()
	if s.nextLeg.CompareAndSwap(l, nil) {
		s.rotating = false
	}
}

// tunnel is the server end of the member tunnel: it admits the stream, then
// opens or joins its session, and holds the stream until it ends.
func (p *MemberPort) tunnel(ss grpc.ServerStream, target *net.TCPAddr) error {
	ctx := ss.Context()
	from := "unknown"
	if pr, ok := peer.FromContext(ctx); ok && pr.Addr != nil {
		from = pr.Addr.String()
	}
	var token string
	if md, ok := metadata.FromIncomingContext(ctx); ok {
		if v := md.Get("authorization"); len(v) > 0 {
			token = bearer(v[0])
		}
	}
	adm, err := p.verifyPeer(token)
	if err != nil {
		var r *refusal
		code := codes.Unauthenticated
		if errors.As(err, &r) {
			code = r.code
		}
		zap.L().Warn("member port: stream refused", zap.String("peer", from), zap.String("reason", err.Error()))
		return endStatus(code)
	}
	if p.pending.Add(1) > maxPendingAdmissions {
		p.pending.Add(-1)
		zap.L().Warn("member port: too many streams awaiting admission; refusing", zap.String("peer", from))
		return endStatus(codes.ResourceExhausted)
	}
	var admitting atomic.Bool
	admitting.Store(true)
	admittedOrGone := func() {
		if admitting.CompareAndSwap(true, false) {
			p.pending.Add(-1)
		}
	}
	defer admittedOrGone()
	l := &leg{exp: adm.exp, ss: ss, end: make(chan error, 1), subject: adm.subject}
	// The stream closes at its token's exp, whatever it is doing then.
	l.setExpiry(time.AfterFunc(time.Until(adm.exp), func() {
		if l.closed.Load() {
			return
		}
		zap.L().Info("member port: stream reached its token's exp", zap.String("peer", from))
		if s := l.owner.Load(); s != nil {
			if s.nextLeg.Load() == l {
				// A rotation that never cut over: the session goes on, on its current stream.
				s.detach(l)
			} else {
				s.fault("a stream's token expired without a rotation", codes.Unauthenticated)
			}
		}
		l.abort(codes.Unauthenticated)
	}))
	defer l.stopExpiry()

	type received struct {
		chunk *memberport_pb.MemberChunk
		err   error
	}
	firstCh := make(chan received, 1)
	go func() {
		c := &memberport_pb.MemberChunk{}
		err := ss.RecvMsg(c)
		firstCh <- received{c, err}
	}()
	deadline := time.NewTimer(admissionTimeout)
	defer deadline.Stop()
	select {
	case r := <-firstCh:
		if r.err != nil {
			l.abort(codes.Canceled)
		} else if s, code := p.first(l, r.chunk, from, target); s == nil {
			l.abort(code)
		} else {
			l.owner.Store(s)
		}
	case <-deadline.C:
		zap.L().Warn("member port: stream sent no first chunk in time", zap.String("peer", from), zap.Duration("deadline", admissionTimeout))
		l.abort(codes.DeadlineExceeded)
	case <-l.end:
		// Expired before its first chunk.
		return endStatus(codes.Unauthenticated)
	case <-ctx.Done():
		l.closed.Store(true)
		return status.FromContextError(ctx.Err()).Err()
	}
	admittedOrGone()
	select {
	case err := <-l.end:
		return err
	case <-ctx.Done():
		// The client cancelled: the reader on this leg sees its end and drops
		// the session; a pending rotation's leg just goes away.
		l.closed.Store(true)
		l.stopExpiry()
		if s := l.owner.Load(); s != nil {
			s.detach(l)
		}
		return status.FromContextError(ctx.Err()).Err()
	}
}

// first handles a stream's first chunk: no session id opens a session (only
// now is the target dialled), a session id joins that session as a rotation
// when the token names the same subject. It returns nil and the status to end
// the stream with when it refuses.
func (p *MemberPort) first(l *leg, chunk *memberport_pb.MemberChunk, from string, target *net.TCPAddr) (*session, codes.Code) {
	if len(chunk.Payload) > 0 || chunk.Last || chunk.Fin {
		zap.L().Warn("member port: stream opened with a data chunk", zap.String("peer", from))
		return nil, codes.PermissionDenied
	}
	own, err := p.tokens()
	if err != nil {
		zap.L().Warn("member port: no member token to answer with", zap.String("peer", from), zap.Error(err))
		return nil, codes.Unavailable
	}
	if joining := chunk.SessionId; joining != "" {
		p.mu.Lock()
		s := p.inbound[joining]
		p.mu.Unlock()
		var reason string
		switch {
		case s == nil:
			reason = "no such live session"
		case s.subject != l.subject:
			reason = "its token names another subject"
		case !s.attach(l):
			reason = "the session cannot take a rotation now"
		}
		if reason != "" {
			zap.L().Warn("member port: rotation refused", zap.String("peer", from), zap.String("reason", reason))
			return nil, codes.PermissionDenied
		}
		l.owner.Store(s)
		l.accept(own, &memberport_pb.MemberChunk{SessionId: joining})
		if l.closed.Load() {
			s.detach(l)
		}
		return s, codes.OK
	}
	if l.closed.Load() {
		// Expired or cancelled while waiting: never dial for it.
		return nil, codes.Canceled
	}
	d := net.Dialer{Timeout: admissionTimeout}
	c, err := d.DialContext(p.ctx, "tcp", target.String())
	if err != nil {
		zap.L().Warn("member port: the member target is unreachable", zap.String("target", target.String()), zap.Error(err))
		return nil, codes.Unavailable
	}
	s := &session{p: p, plain: c.(*net.TCPConn), inbound: true, subject: l.subject}
	id := newSessionID()
	s.id.Store(&id)
	p.mu.Lock()
	p.inbound[id] = s
	p.mu.Unlock()
	l.owner.Store(s)
	l.accept(own, &memberport_pb.MemberChunk{SessionId: id})
	s.start(l)
	return s, codes.OK
}

// ---- The client side ----

// refusedStream is a stream the receiver refused or never attached.
type refusedStream struct {
	code   codes.Code
	reason string
}

func (r *refusedStream) Error() string { return fmt.Sprintf("%s (%s)", r.reason, r.code) }

// open opens the first stream; on any refusal, it resets the local connection.
func (s *session) open() {
	l, err := s.openLeg("")
	if err != nil {
		zap.L().Warn("member port: tunnel refused", zap.String("remote", s.remote), zap.Error(err))
		reset(s.plain)
		return
	}
	s.start(l)
	if !s.done.Load() {
		s.schedule(l)
	}
}

// openLeg opens a stream with the current token; an UNAUTHENTICATED refusal
// is retried once with a fresh one, PERMISSION_DENIED never.
func (s *session) openLeg(joining string) (*leg, error) {
	token, err := s.p.tokens()
	if err != nil {
		return nil, fmt.Errorf("member token: %w", err)
	}
	l, err := s.openOnce(joining, token)
	var r *refusedStream
	if err == nil || !errors.As(err, &r) || r.code != codes.Unauthenticated {
		return l, err
	}
	if token, err = s.p.tokens(); err != nil {
		return nil, fmt.Errorf("member token: %w", err)
	}
	return s.openOnce(joining, token)
}

// openOnce opens one stream: its first chunk names the session it joins
// (empty for a new one), and it is attached once the server's headers carry a
// member token this side admits and its first chunk names the session.
func (s *session) openOnce(joining, token string) (*leg, error) {
	tw, err := tokenlib.ParseToken(token)
	if err != nil {
		return nil, fmt.Errorf("member token does not parse: %w", err)
	}
	exp := time.Unix(tw.GetExpiration(), 0)
	ctx, cancel := context.WithDeadline(s.p.ctx, exp)
	ctx = metadata.AppendToOutgoingContext(ctx, "authorization", "Bearer "+token)
	cs, err := s.conn.NewStream(ctx, &StreamDesc, FullMethod)
	if err != nil {
		cancel()
		return nil, &refusedStream{code: status.Code(err), reason: "the stream was refused"}
	}
	l := &leg{exp: exp, cs: cs, cancel: cancel}
	// A refused stream fails the send; its status comes from the receive below.
	_ = l.send(&memberport_pb.MemberChunk{SessionId: joining})
	attached := make(chan error, 1)
	go func() {
		attached <- func() error {
			h, herr := cs.Header()
			tokens := h.Get(TokenHeader)
			if herr != nil || len(tokens) == 0 {
				first := &memberport_pb.MemberChunk{}
				if err := cs.RecvMsg(first); err != nil {
					return &refusedStream{code: status.Code(err), reason: "the stream was refused"}
				}
				return &refusedStream{code: codes.PermissionDenied, reason: "the receiver sent no member token"}
			}
			if _, err := s.p.verifyPeer(tokens[0]); err != nil {
				return &refusedStream{code: codes.PermissionDenied, reason: "the receiver's token: " + err.Error()}
			}
			first := &memberport_pb.MemberChunk{}
			if err := cs.RecvMsg(first); err != nil {
				return &refusedStream{code: status.Code(err), reason: "the stream was refused"}
			}
			id := first.SessionId
			if id == "" || (joining != "" && joining != id) || len(first.Payload) > 0 || first.Last || first.Fin {
				return &refusedStream{code: codes.PermissionDenied, reason: "the receiver did not attach the stream"}
			}
			s.id.Store(&id)
			return nil
		}()
	}()
	timer := time.NewTimer(admissionTimeout)
	defer timer.Stop()
	select {
	case err := <-attached:
		if err != nil {
			l.abort(codes.Canceled)
			return nil, err
		}
		return l, nil
	case <-timer.C:
		l.abort(codes.Canceled)
		return nil, &refusedStream{code: codes.DeadlineExceeded, reason: "the receiver did not attach the stream in time"}
	}
}

// schedule schedules l's rotation at RotateAt of its lifetime and its drop at its exp.
func (s *session) schedule(l *leg) {
	left := time.Until(l.exp)
	l.setExpiry(time.AfterFunc(left, func() {
		if s.sendLeg.Load() == l {
			s.fault("token expired without a rotation", codes.Canceled)
		}
	}))
	s.later(max(rotateMin, time.Duration(float64(left)*RotateAt)))
}

// later runs rotate after delay, unless the session is done.
func (s *session) later(delay time.Duration) {
	s.timerMu.Lock()
	defer s.timerMu.Unlock()
	if s.done.Load() {
		return
	}
	s.rotation = time.AfterFunc(delay, s.rotate)
}

// rotate is make-before-break: a new token, a new stream joining this
// session, then the cutover. A mint that fails or returns no newer token is
// retried until the current token expires, when the session drops.
func (s *session) rotate() {
	if s.done.Load() || (s.finSent.Load() && s.finReceived.Load()) || !s.rotatingNow.CompareAndSwap(false, true) {
		return
	}
	defer s.rotatingNow.Store(false)
	current := s.sendLeg.Load()
	token, err := s.p.tokens()
	if err != nil {
		zap.L().Warn("member port: token mint for a rotation failed, retrying", zap.Error(err))
		s.later(rotateRetry)
		return
	}
	if s.done.Load() {
		return
	}
	tw, err := tokenlib.ParseToken(token)
	if err != nil || !time.Unix(tw.GetExpiration(), 0).After(current.exp) {
		// No newer token yet: the identity cache renews it ahead of expiry.
		s.later(rotateRetry)
		return
	}
	next, err := s.openOnce(s.sessionID(), token)
	var r *refusedStream
	if err != nil && errors.As(err, &r) && r.code == codes.Unauthenticated {
		if token, err = s.p.tokens(); err == nil {
			next, err = s.openOnce(s.sessionID(), token)
		}
	}
	if err != nil {
		if errors.As(err, &r) && (r.code == codes.Unauthenticated || r.code == codes.PermissionDenied) {
			s.fault("rotation refused: "+err.Error(), codes.Canceled)
			return
		}
		zap.L().Warn("member port: rotation failed, retrying", zap.Error(err))
		s.later(rotateRetry)
		return
	}
	s.nextLeg.Store(next)
	if s.done.Load() {
		next.abort(codes.Canceled)
		return
	}
	s.cutOver(next)
	s.schedule(next)
}

// ---- Helpers ----

func newSessionID() string {
	id := make([]byte, 16)
	_, _ = rand.Read(id)
	return base64.RawURLEncoding.EncodeToString(id)
}

func bearer(header string) string {
	if len(header) >= 7 && strings.EqualFold(header[:7], "bearer ") {
		return header[7:]
	}
	return header
}

// reset resets a local connection: SO_LINGER 0 sends an RST, never a FIN or a hang.
func reset(c *net.TCPConn) {
	_ = c.SetLinger(0)
	_ = c.Close()
}
