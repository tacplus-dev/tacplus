impl Drop for ServiceConnection {
    fn drop(&mut self) {
        for task in &self._tasks {
            task.abort();
        }
    }
}

/// ChannelProvider resolves the active gRPC channel for a target service.
///
/// Each gRPC client holds one of these and calls `channel()` on every RPC
/// to get the current best endpoint.
#[derive(Clone)]
pub struct ChannelProvider {
    source: ChannelProviderSource,
}

#[derive(Clone)]
enum ChannelProviderSource {
    Managed(Arc<ServiceConnection>),
    Static(Channel),
}

impl ChannelProvider {
    /// Creates a new ChannelProvider backed by a ServiceConnection.
    pub fn new(conn: Arc<ServiceConnection>) -> Self {
        Self {
            source: ChannelProviderSource::Managed(conn),
        }
    }

    /// Creates a ChannelProvider backed by one static channel.
    pub fn from_channel(service_id: impl Into<String>, channel: Channel) -> Self {
        let _ = service_id.into();
        Self {
            source: ChannelProviderSource::Static(channel),
        }
    }

    /// Returns the currently active channel for the target service.
    /// Returns an error if no healthy endpoints are available.
    pub async fn channel(&self) -> Result<Channel, tonic::Status> {
        match &self.source {
            ChannelProviderSource::Managed(conn) => conn.conn().await.ok_or_else(|| {
                tonic::Status::unavailable(format!(
                    "service \"{}\": no healthy endpoints available",
                    conn.service_id()
                ))
            }),
            ChannelProviderSource::Static(channel) => Ok(channel.clone()),
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::readiness::tests::verifier;
    use {{.CrateBasePathUnderscore}}_types::sys::host::host::Host;

    /// A pool with one dialed endpoint at 127.0.0.1:1, reported HEALTHY.
    async fn pool() -> ServiceConnection {
        let channel = tonic::transport::Endpoint::from_static("http://127.0.0.1:1").connect_lazy();
        let mut ec = EndpointConn::new("127.0.0.1:1".to_string());
        ec.channel = Some(channel);
        ec.update_health_from_state(InstanceStatus::Healthy as i32, 0).await;
        let sc = ServiceConnection::new_dynamic("identity", verifier());
        sc.endpoints.write().await.push(Arc::new(RwLock::new(ec)));
        sc
    }

    fn snapshot(status: InstanceStatus) -> ServiceInstanceHealth {
        ServiceInstanceHealth {
            service_id: "identity".to_string(),
            grpc_endpoint: Some(Host { host: "127.0.0.1".to_string(), port: 1, ..Default::default() }),
            status: status as i32,
            ..Default::default()
        }
    }

    #[tokio::test]
    async fn endpoint_missed_one_snapshot_stays_pooled() {
        let sc = pool().await;
        sc.reconcile_from_health(&[]).await;
        assert_eq!(sc.endpoints.read().await.len(), 1, "one missed snapshot dropped the endpoint");
        assert_eq!(sc.unavailable_input().await, None, "one missed snapshot took the pool down");

        let back = snapshot(InstanceStatus::Healthy);
        sc.reconcile_from_health(&[&back]).await;
        assert_eq!(sc.endpoints.read().await.len(), 1, "endpoint must be kept when it reappears");
    }

    #[tokio::test]
    async fn endpoint_closed_after_absent_snapshots() {
        let sc = pool().await;
        for i in 1..ABSENT_POLLS_BEFORE_CLOSE {
            sc.reconcile_from_health(&[]).await;
            assert_eq!(sc.endpoints.read().await.len(), 1, "closed after {i} absent snapshots");
        }
        sc.reconcile_from_health(&[]).await;
        assert!(sc.endpoints.read().await.is_empty(), "still pooled after {ABSENT_POLLS_BEFORE_CLOSE} absent snapshots");
    }

    #[tokio::test]
    async fn absent_count_restarts_when_endpoint_returns() {
        let sc = pool().await;
        let back = snapshot(InstanceStatus::Healthy);
        for _ in 0..2 * ABSENT_POLLS_BEFORE_CLOSE {
            sc.reconcile_from_health(&[]).await;
            sc.reconcile_from_health(&[&back]).await;
        }
        assert_eq!(sc.endpoints.read().await.len(), 1, "alternating miss and return closed the endpoint");
    }
}
