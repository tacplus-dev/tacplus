// Close releases the bare connection and stops renewal goroutines.
func (im *IdentityManager) Close() {
	if im == nil {
		return
	}
	if im.cancel != nil {
	im.cancel()
	}
	if im.cloudMinter != nil && im.cloudMinter.cancelRenew != nil {
		im.cloudMinter.cancelRenew()
	}
	im.connMu.Lock()
	conn := im.conn
	im.conn = nil
	im.connMu.Unlock()
	if conn != nil {
		conn.Close()
	}
}

