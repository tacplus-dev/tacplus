    /**
     * Verifies the token's signature using the provided JWK.
     */
    public void verify(ImmutableJwk jwk) {
        if (token.getBase64().isEmpty()) {
            throw new IllegalArgumentException("token missing base64 encoding");
        }

        TokenWrapper parsed = TokenWrapper.parse(token.getBase64());
        this.token = parsed.token;
        this.immutable = true;

        if (getIssuer().isEmpty()) {
            throw new IllegalArgumentException("token missing issuer (iss) claim");
        }

        if (getKid().isEmpty()) {
            throw new IllegalArgumentException("token missing key ID (kid) in header");
        }

        String alg = getAlg();
        if (alg.isEmpty()) {
            throw new IllegalArgumentException("token missing signing algorithm (alg) in header");
        }
        if (!alg.equals(jwk.getAlg())) {
            throw new IllegalArgumentException("token alg " + alg + " does not match JWK alg " + jwk.getAlg());
        }

        if (token.getSignature().isEmpty()) {
            throw new IllegalArgumentException("token missing signature");
        }

        // Check expiration
        long exp = getExpiration();
        if (exp <= 0) {
            throw new IllegalArgumentException("token missing expiration (exp) claim");
        }

        final long CLOCK_SKEW_SECONDS = 60;
        long now = Instant.now().getEpochSecond();

        if (now >= exp + CLOCK_SKEW_SECONDS) {
            throw new IllegalArgumentException("token has expired");
        }

        // Check not-before claim
        long nbf = getPayloadLong("nbf");
        if (nbf > 0 && now < nbf - CLOCK_SKEW_SECONDS) {
            throw new IllegalArgumentException("token not yet valid");
        }

        try {
            // Reconstruct signing input
            String[] parts = token.getBase64().split("\\.");
            if (parts.length != 3) {
                throw new IllegalArgumentException("invalid token format");
            }

            String signingInput = parts[0] + "." + parts[1];
            byte[] signature = Utils.decodeBase64(parts[2]);

            // Verify signature based on key type
            boolean valid = verifySignature(
                    signingInput.getBytes(StandardCharsets.UTF_8),
                    signature,
                    jwk);

            if (!valid) {
                throw new IllegalArgumentException("invalid token signature");
            }

        } catch (Exception e) {
            throw new RuntimeException("failed to verify token", e);
        }
    }

    private boolean verifySignature(byte[] data, byte[] signature, ImmutableJwk jwk) throws Exception {
        String alg = getAlg();

        // Hash the data based on algorithm
        byte[] dataToVerify;
        MessageDigest digest;

        switch (alg) {
            case "RS384":
            case "ES384":
                digest = MessageDigest.getInstance("SHA-384");
                dataToVerify = digest.digest(data);
                break;
            case "RS512":
            case "ES512":
                digest = MessageDigest.getInstance("SHA-512");
                dataToVerify = digest.digest(data);
                break;
            case "ES256":
                digest = MessageDigest.getInstance("SHA-256");
                dataToVerify = digest.digest(data);
                break;
            case "EdDSA":
                dataToVerify = data;
                break;
            default:
                throw new IllegalArgumentException("unsupported algorithm: " + alg);
        }

        // Verify based on key type
        java.security.PublicKey publicKey = jwk.getPublicKey();

        if (publicKey instanceof RSAPublicKey) {
            Signature rsaSig = Signature.getInstance(rsaSignatureAlgorithm(alg));
            rsaSig.initVerify(publicKey);
            rsaSig.update(data);
            return rsaSig.verify(signature);
        } else if (publicKey instanceof ECPublicKey) {
            // Convert JWT r||s format (RFC 7518 §3.4) to DER for Java's ECDSA verify
            byte[] derSignature = jwsToDer(signature);
            Signature ecSig = Signature.getInstance("NONEwithECDSA");
            ecSig.initVerify(publicKey);
            ecSig.update(dataToVerify);
            return ecSig.verify(derSignature);
        } else if (publicKey.getAlgorithm().equals("Ed25519") || publicKey.getAlgorithm().equals("EdDSA")) {
            Signature edSig = Signature.getInstance("Ed25519", new org.bouncycastle.jce.provider.BouncyCastleProvider());
            edSig.initVerify(publicKey);
            edSig.update(dataToVerify);
            return edSig.verify(signature);
        } else {
            throw new IllegalArgumentException("unsupported key type: " + publicKey.getAlgorithm());
        }
    }

    private static String rsaSignatureAlgorithm(String alg) {
        switch (alg) {
            case "RS384":
                return "SHA384withRSA";
            case "RS512":
                return "SHA512withRSA";
            default:
                throw new IllegalArgumentException("unsupported RSA algorithm: " + alg);
        }
    }

    // ========================================
    // Utility Methods
    // ========================================

    /**
     * Converts a DER-encoded ECDSA signature to JWT/JWS r||s format (RFC 7518 §3.4).
     */
    private static byte[] derToJws(byte[] der, int keyBytes) {
        // DER: SEQUENCE { INTEGER r, INTEGER s }
        if (der[0] != 0x30) {
            throw new IllegalArgumentException("expected SEQUENCE tag");
        }
        int offset = 1;
        // Parse DER length (handles short and long form)
        int seqLenByte = der[offset] & 0xff;
        if (seqLenByte <= 127) {
            offset++; // short form: single length byte
        } else {
            int numLenBytes = seqLenByte & 0x7f;
            offset++; // skip the length-of-length byte
            offset += numLenBytes; // skip the length value bytes
        }
        // Read r
        if (der[offset] != 0x02) {
            throw new IllegalArgumentException("expected INTEGER tag for r");
        }
        offset++;
        int rLen = der[offset++] & 0xff;
        int rOff = offset;
        offset += rLen;
        // Read s
        if (der[offset] != 0x02) {
            throw new IllegalArgumentException("expected INTEGER tag for s");
        }
        offset++;
        int sLen = der[offset++] & 0xff;
        int sOff = offset;

        byte[] result = new byte[2 * keyBytes];
        // Copy r (skip leading zero if present from DER sign encoding)
        int rSrc = rOff;
        int rCopyLen = rLen;
        if (rLen > keyBytes && der[rSrc] == 0) {
            rSrc++;
            rCopyLen--;
        }
        System.arraycopy(der, rSrc, result, keyBytes - rCopyLen, rCopyLen);
        // Copy s
        int sSrc = sOff;
        int sCopyLen = sLen;
        if (sLen > keyBytes && der[sSrc] == 0) {
            sSrc++;
            sCopyLen--;
        }
        System.arraycopy(der, sSrc, result, 2 * keyBytes - sCopyLen, sCopyLen);
        return result;
    }

    /**
     * Converts a JWT/JWS r||s signature (RFC 7518 §3.4) to DER-encoded format
     * for Java's ECDSA Signature.verify().
     */
    private static byte[] jwsToDer(byte[] jws) {
        int keyBytes = jws.length / 2;
        // Extract r and s, stripping leading zeros
        int rStart = 0;
        while (rStart < keyBytes - 1 && jws[rStart] == 0) rStart++;
        int sStart = keyBytes;
        while (sStart < jws.length - 1 && jws[sStart] == 0) sStart++;

        int rLen = keyBytes - rStart;
        int sLen = jws.length - sStart;
        // Add leading zero byte if high bit set (DER integers are signed)
        boolean rPad = (jws[rStart] & 0x80) != 0;
        boolean sPad = (jws[sStart] & 0x80) != 0;
        int rDerLen = rLen + (rPad ? 1 : 0);
        int sDerLen = sLen + (sPad ? 1 : 0);
        int seqLen = 2 + rDerLen + 2 + sDerLen;

        byte[] der = new byte[2 + seqLen];
        der[0] = 0x30;
        der[1] = (byte) seqLen;
        int off = 2;
        // r INTEGER
        der[off++] = 0x02;
        der[off++] = (byte) rDerLen;
        if (rPad) {
            der[off++] = 0;
        }
        System.arraycopy(jws, rStart, der, off, rLen);
        off += rLen;
        // s INTEGER
        der[off++] = 0x02;
        der[off++] = (byte) sDerLen;
        if (sPad) {
            der[off++] = 0;
        }
        System.arraycopy(jws, sStart, der, off, sLen);
        return der;
    }

    private static final Set<String> NUMERIC_CLAIMS = Set.of("exp", "iat", "nbf");

    /**
     * Serializes the payload map to JSON, outputting numeric claims as unquoted integers.
     * Keys are sorted for deterministic output.
     */
    private static String payloadToJson(Map<String, String> payload) {
        StringBuilder sb = new StringBuilder("{");
        boolean first = true;
        List<String> keys = new ArrayList<>(payload.keySet());
        Collections.sort(keys);
        for (String key : keys) {
            if (!first) sb.append(",");
            first = false;
            sb.append("\"").append(jsonEscape(key)).append("\":");
            if (NUMERIC_CLAIMS.contains(key)) {
                // Conservative output: always emit a clean decimal integer.
                // Liberal input: accept scientific notation (e.g. "1.7424036E9").
                // Reject fractional values — a float where int expected is a bug.
                String raw = payload.get(key);
                try {
                    sb.append(Long.parseLong(raw));
                } catch (NumberFormatException e) {
                    double d = Double.parseDouble(raw);
                    if (d != Math.floor(d)) {
                        throw new IllegalArgumentException(
                            "fractional value not allowed for numeric claim " + key + ": " + raw);
                    }
                    sb.append((long) d);
                }
            } else {
                String v = payload.get(key);
                // Embed JSON objects and arrays as native JSON, not quoted strings.
                if (v != null && !v.isEmpty() && (v.charAt(0) == '{' || v.charAt(0) == '[')) {
                    sb.append(v);
                } else {
                    sb.append("\"").append(jsonEscape(v)).append("\"");
                }
            }
        }
        sb.append("}");
        return sb.toString();
    }

    /**
     * Escapes a string for safe inclusion in JSON.
     */
    private static String jsonEscape(String s) {
        if (s == null) return "";
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '"': sb.append("\\\""); break;
                case '\\': sb.append("\\\\"); break;
                case '\n': sb.append("\\n"); break;
                case '\r': sb.append("\\r"); break;
                case '\t': sb.append("\\t"); break;
                default:
                    if (c < 0x20) {
                        sb.append(String.format("\\u%04x", (int) c));
                    } else {
                        sb.append(c);
                    }
            }
        }
        return sb.toString();
    }

    /**
     * Converts a map to JSON string.
     */
    private String mapToJson(Map<String, String> map) {
        StringBuilder sb = new StringBuilder("{");
        boolean first = true;
        for (Map.Entry<String, String> entry : map.entrySet()) {
            if (!first) {
                sb.append(",");
            }
            sb.append("\"").append(jsonEscape(entry.getKey())).append("\":\"")
              .append(jsonEscape(entry.getValue())).append("\"");
            first = false;
        }
        sb.append("}");
        return sb.toString();
    }

    /**
     * Returns true if the token is immutable (has been signed).
     */
    public boolean isImmutable() {
        return immutable;
    }

    /**
     * Returns true if the token has expired.
     */
    public boolean isExpired() {
        long exp = getExpiration();
        return exp > 0 && exp < Instant.now().getEpochSecond();
    }

    /**
     * Returns the time until expiration in seconds.
     */
    public long expiresIn() {
        long exp = getExpiration();
        if (exp <= 0) {
            return 0;
        }
        return exp - Instant.now().getEpochSecond();
    }
}
