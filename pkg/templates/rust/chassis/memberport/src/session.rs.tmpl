                    // The client cut over: its last is the server's cue to cut over too.
                    if let Some(tx) = next.tx {
                        if !self.cutover(tx).await {
                            break;
                        }
                    }
                    self.pending.lock().unwrap().rotating = false;
                }
            }
        }
        if self.reset.load(Ordering::SeqCst) {
            crate::memberport::zero_linger(local.as_ref());
            local.forget();
        }
    }

    /// The read leg ended: a clean end after both directions' fin, else a fault.
    async fn stream_end(&self, code: Code) {
        if self.both_fins() {
            self.ended().await;
        } else {
            self.fault(&format!("stream ended without last ({:?})", code), Code::Cancelled);
        }
    }

    /// Moves the sends to `next`: last on the old leg, which then ends.
    async fn cutover(&self, next: LegTx) -> bool {
        let mut guard = tokio::select! {
            _ = self.cancel.cancelled() => return false,
            g = self.send.lock() => g,
        };
        self.track(&next.state);
        self.send_leg.store(next.state.id, Ordering::SeqCst);
        if let Some(mut old) = guard.replace(next) {
            let sent = tokio::select! {
                _ = self.cancel.cancelled() => return false,
                r = old.send(MemberChunk { last: true, ..Default::default() }) => r,
            };
            if sent.is_err() {
                drop(guard);
                self.fault("the old stream ended before its last", Code::Cancelled);
                return false;
            }
            old.finish();
        }
        if self.outbound && self.both_fins() {
            if let Some(leg) = guard.as_mut() {
                leg.finish();
            }
        }
        true
    }

    /// A direction sent its fin: the client ends the stream once both have.
    async fn finished(&self) {
        if !self.outbound || !self.both_fins() {
            // The server ends a session when the client half-closes after both fins.
            return;
        }
        // Both directions are done: the client ends the stream; the server,
        // seeing it, closes OK and the reader ends cleanly.
        let mut guard = tokio::select! {
            _ = self.cancel.cancelled() => return,
            g = self.send.lock() => g,
        };
        if let Some(leg) = guard.as_mut() {
            leg.finish();
        }
    }

    /// The read leg ended after both directions' fin: a clean end.
    async fn ended(&self) {
        if self.done.swap(true, Ordering::SeqCst) {
            return;
        }
        self.forget();
        if let Some(next) = self.pending.lock().unwrap().next.take() {
            next.rx.state.abort(Code::Cancelled);
        }
        if let Some(mut leg) = self.send.lock().await.take() {
            leg.finish();
        }
        // Stops the timers; the local connection closes normally.
        self.cancel.cancel();
    }

    /// Drops the session: every stream ends, the local connection is reset.
    pub(crate) fn fault(&self, reason: &str, code: Code) {
        if self.done.swap(true, Ordering::SeqCst) {
            return;
        }
        self.reset.store(true, Ordering::SeqCst);
        self.forget();
        tracing::info!(session = %self.id(), reason, "member port: session dropped");
        for leg in self.legs.lock().unwrap().drain(..) {
            leg.abort(code);
        }
        // fault() sets done before it takes the next leg: attach() sees one or the other.
        if let Some(next) = self.pending.lock().unwrap().next.take() {
            next.rx.state.abort(code);
        }
        if let Ok(mut send) = self.send.try_lock() {
            send.take();
        }
        self.cancel.cancel();
    }

    /// Removes the session from what can still find it.
    fn forget(&self) {
        let Some(port) = self.port.upgrade() else { return };
        port.sessions.lock().unwrap().remove(&self.key);
        if !self.outbound {
            let id = self.id();
            let mut inbound = port.inbound.lock().unwrap();
            if inbound.get(&id).map(|s| s.key == self.key).unwrap_or(false) {
                inbound.remove(&id);
            }
        }
    }

    // ---- Inbound rotations ----

    /// Attaches a rotation's leg, when the session is live and has none
    /// pending; hands the leg back otherwise.
    pub(crate) fn attach(&self, next: NextLeg) -> Result<(), NextLeg> {
        let mut pending = self.pending.lock().unwrap();
        if self.is_done() || pending.rotating || self.both_fins() {
            return Err(next);
        }
        if let Some(tx) = &next.tx {
            self.track(&tx.state);
        }
        pending.rotating = true;
        pending.next = Some(next);
        Ok(())
    }

    /// Detaches a pending rotation's leg that ended before its cutover: the
    /// session may take another.
    pub(crate) fn detach(&self, leg_id: u64) -> Option<NextLeg> {
        let mut pending = self.pending.lock().unwrap();
        if pending.next.as_ref().map(|n| n.rx.state.id) == Some(leg_id) {
            pending.rotating = false;
            return pending.next.take();
        }
        None
    }
}

/// Reads an old leg past its last to the stream's end, so it closes cleanly.
async fn drain(mut old: LegRx) {
    let _ = tokio::time::timeout(ADMISSION_TIMEOUT, async {
        while let Ok(Some(_)) = old.stream.message().await {}
    })
    .await;
}

pub(crate) fn sleep_until_millis(at_millis: i64) -> tokio::time::Sleep {
    tokio::time::sleep(Duration::from_millis((at_millis - now_millis()).max(0) as u64))
}

