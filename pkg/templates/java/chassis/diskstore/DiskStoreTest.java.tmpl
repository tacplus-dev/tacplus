    // ---- Codec round-trip ----

    private static void testCodecRoundtripNone() {
        byte[] data = "hello world".getBytes(StandardCharsets.UTF_8);
        byte[] compressed = Codec.compress(data, Codec.NONE);
        byte[] got = Codec.decompressAuto(compressed);
        check(java.util.Arrays.equals(got, data), "codec NONE round-trip");
    }

    private static void testCodecRoundtripGz() {
        byte[] data = "hello world, hello world, hello world".getBytes(StandardCharsets.UTF_8);
        byte[] compressed = Codec.compress(data, Codec.GZ);
        check(compressed.length >= 2 && compressed[0] == (byte) 0x1f && compressed[1] == (byte) 0x8b,
                "gz output must start with magic bytes");
        byte[] got = Codec.decompressAuto(compressed);
        check(java.util.Arrays.equals(got, data), "codec GZ round-trip");
    }

    private static void testCodecFromProtoInt() {
        check(Codec.fromProtoInt(1) == Codec.GZ, "fromProtoInt(1) == GZ");
        check(Codec.fromProtoInt(2) == Codec.BZ, "fromProtoInt(2) == BZ");
        check(Codec.fromProtoInt(0) == Codec.NONE, "fromProtoInt(0) == NONE");
        check(Codec.fromProtoInt(99) == Codec.NONE, "fromProtoInt(99) == NONE");
    }

