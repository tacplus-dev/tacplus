    public boolean watchesHealthy() {
        synchronized (watchStatusLock) {
            for (WatchStatus status : watchStatuses.values()) {
                if (status.isRetrying()) {
                    return false;
                }
            }
        }
        return true;
    }

    private void recordWatchHealthy(String watchName, boolean received) {
        setWatchStatus(new WatchStatus(watchName, received, false, 0, "", null));
    }

    private void recordWatchRetrying(String watchName, boolean received, int nextAttempt, String reason, Throwable error) {
        setWatchStatus(new WatchStatus(watchName, received, true, nextAttempt, reason, error));
    }

    private void setWatchStatus(WatchStatus status) {
        synchronized (watchStatusLock) {
            watchStatuses.put(status.watchName(), status);
        }
        WatchStatusListener listener = watchStatusListener;
        if (listener != null) {
            try {
                listener.onWatchStatus(status);
            } catch (RuntimeException e) {
                LOG.warning(status.watchName() + " watch status listener failed: " + e.getMessage());
            }
        }
    }

