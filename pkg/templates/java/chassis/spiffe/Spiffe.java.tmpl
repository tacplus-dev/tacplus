            classifySystem(p, segs);
        } else if (segs.get(0).equals(PEOPLE_SEGMENT) && idx.get(USERS_SEGMENT) >= 0) {
            classifyPerson(p, segs);
        } else if (idx.get(USERS_SEGMENT) >= 0) {
            classifyNamespaced(p, segs, idx.get(USERS_SEGMENT), SubjectKind.USER);
        } else if (idx.get(CLIENTS_SEGMENT) >= 0) {
