        }
        self.forget();
        tracing::info!(method = %self.plain, reason, code = ?code, "rotation: stream ended");
        if let Some(abort) = self.request_abort.lock().unwrap().take() {
            let _ = abort.send(Status::new(code, format!("rotation: {}", reason)));
        }
        for leg in self.legs.lock().unwrap().drain(..) {
            leg.abort(code);
        }
        // fault() sets done before it takes the next leg: attach() sees one or the other.
        if let Some(next) = self.pending.lock().unwrap().next.take() {
            next.rx.state.abort(code);
        }
        if let Ok(mut send) = self.send.try_lock() {
            send.take();
        }
        self.cancel.cancel();
    }

    fn forget(&self) {
        if let Some(sessions) = self.sessions.upgrade() {
            let mut sessions = sessions.lock().unwrap();
            if sessions.get(&self.id).map(|s| std::ptr::eq(Arc::as_ptr(s), self)).unwrap_or(false) {
                sessions.remove(&self.id);
            }
        }
    }

    /// Attaches a rotation's leg, when the session is live and has none
    /// pending; hands the leg back otherwise.
    fn attach(&self, next: NextLeg) -> Result<(), NextLeg> {
        let mut pending = self.pending.lock().unwrap();
        if self.is_done() || pending.rotating {
            return Err(next);
        }
        self.track(&next.tx.state);
        pending.rotating = true;
        pending.next = Some(next);
        Ok(())
    }

    /// Detaches a pending rotation's leg that ended before its cutover: the
    /// session goes on, on its current leg, and may take another.
    fn detach(&self, leg_id: u64) -> Option<NextLeg> {
        let mut pending = self.pending.lock().unwrap();
        if pending.next.as_ref().map(|n| n.rx.state.id) == Some(leg_id) {
            pending.rotating = false;
            return pending.next.take();
        }
        None
    }
}

/// Reads an old leg past its last to its end, so it closes cleanly.
async fn drain(mut old: LegRx) {
    let _ = tokio::time::timeout(OPEN_TIMEOUT, async {
        while let Ok(Some(_)) = old.stream.message().await {}
    })
    .await;
    drop(old.state);
}
