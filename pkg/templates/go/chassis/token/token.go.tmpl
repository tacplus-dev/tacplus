// ShortString returns a shortened version of the token's Base64 representation.
func (token *TokenWrapper) ShortString() string {
	return shortString(&token.token.Base64)
}

// ExpiresIn returns the duration until the token expires.
func (token *TokenWrapper) ExpiresIn() time.Duration {
	exp := token.GetExpiration()
	if exp <= 0 {
		return 0
	}
	return time.Until(time.Unix(exp, 0))
}

// Sign cryptographically signs the token using the provided private key.
// This method sets the token's algorithm, key ID, and type headers, then creates
// a digital signature over the header and payload. The token becomes immutable after signing.
//
// The signing algorithm is automatically determined by the key type:
//   - RS384/RS512: RSA keys with SHA-384 or SHA-512
//   - ES256/ES384/ES512: ECDSA keys with SHA-256, SHA-384, or SHA-512
//   - EdDSA: Ed25519 keys (no separate hash function)
//
// Parameters:
//   - key: The private key to use for signing (must be an ImmutableKey with private key material)
//
// Returns:
//   - error: Returns an error if the token is missing an expiration, the key type is unsupported,
//     or the signing operation fails
//
// Post-conditions:
//   - Token is marked immutable (further modifications will panic)
//   - Token.Base64 contains the complete JWT string (header.payload.signature)
//   - Token.Signature contains the base64url-encoded signature
//
// See also: TokenWrapper.Verify, ImmutableKey
func (token *TokenWrapper) Sign(key *wrapperKey.ImmutableKey) error {

	// Verify that token has a valid expiration time (must be > 0)
	if token.GetExpiration() <= 0 {
		return protoerrors.NewErrMissingInvalidData(nil, "token is missing expiration")
	}

	token.SetKid(key.Proto().Id)
	token.SetAlg(key.Alg())
	token.SetTyp("JWT")

	rawHeader, err := anyToBase64(token.token.Header)
	if err != nil {
		return err
	}

	payloadJSON, err := payloadToJSON(token.token.Payload)
	if err != nil {
		return err
	}
	rawPayload := libBase64.RawURLEncoding.EncodeToString(payloadJSON)

	base64 := strings.Join([]string{rawHeader, rawPayload}, ".")

	// Hash the payload according to the algorithm
	var hashedData []byte
	switch key.Alg() {
	case "RS384", "ES384":
		h := sha512.New384()
		h.Write([]byte(base64))
		hashedData = h.Sum(nil)
	case "RS512", "ES512":
		h := sha512.New()
		h.Write([]byte(base64))
		hashedData = h.Sum(nil)
	case "ES256":
		h := sha256.New()
		h.Write([]byte(base64))
		hashedData = h.Sum(nil)
	case "EdDSA":
		// EdDSA doesn't use a hash function, sign the raw data
		hashedData = []byte(base64)
	default:
		return protoerrors.NewErrMissingInvalidData(nil, "unsupported algorithm: %s", key.Alg())
	}

	r, err := func() ([]byte, error) {

		switch key.Kty() {

		case keyProto.KeyType_KEY_TYPE_RSA:
			privateKey, ok := key.PrivateKey().(*rsa.PrivateKey)
			if !ok {
				return nil, protoerrors.NewErrMissingInvalidData(nil, "invalid RSA private key")
			}
			var hashFunc crypto.Hash
			switch key.Alg() {
			case "RS384":
				hashFunc = crypto.SHA384
			case "RS512":
				hashFunc = crypto.SHA512
			default:
				return nil, protoerrors.NewErrMissingInvalidData(nil, "unsupported RSA algorithm: %s", key.Alg())
			}
			r, err := rsa.SignPKCS1v15(rand.Reader, privateKey, hashFunc, hashedData)
			if err != nil {
				return nil, protoerrors.NewErrGeneral(err, "failed to sign hash")
			}
			return r, nil

		case keyProto.KeyType_KEY_TYPE_EC:
			privateKey, ok := key.PrivateKey().(*ecdsa.PrivateKey)
			if !ok {
				return nil, protoerrors.NewErrMissingInvalidData(nil, "invalid ECDSA private key")
			}
			r, s, err := ecdsa.Sign(rand.Reader, privateKey, hashedData[:])
			if err != nil {
				return nil, protoerrors.NewErrGeneral(err, "failed to sign hash")
			}

			// ECDSA signatures in JWT format require r and s to be padded
			// to the curve's byte length and concatenated
			curveBits := privateKey.Curve.Params().BitSize
			keyBytes := (curveBits + 7) / 8 // Round up to nearest byte

			// Pad r and s to the correct length
			rBytes := r.Bytes()
			sBytes := s.Bytes()

			signature := make([]byte, 2*keyBytes)
			copy(signature[keyBytes-len(rBytes):], rBytes)
			copy(signature[2*keyBytes-len(sBytes):], sBytes)

			return signature, nil

		case keyProto.KeyType_KEY_TYPE_OKP:
			privateKey, ok := key.PrivateKey().(ed25519.PrivateKey)
			if !ok {
				return nil, protoerrors.NewErrMissingInvalidData(nil, "invalid EdDSA private key")
			}

			var r []byte
			func() {
				defer func() {
					if recovered := recover(); recovered != nil {
						err = protoerrors.NewErrGeneral(nil, "failed to sign hash: %v", recovered)
					}
				}()
				r = ed25519.Sign(privateKey, hashedData)
			}()

			if err != nil {
				return nil, err
			}
			return r, nil

		default:
			return nil, protoerrors.NewErrMissingInvalidData(nil, "unsupported key type: %v", key.Kty())
		}
	}()
	if err != nil {
		return err
	}

	signature, err := anyToBase64(r)
	if err != nil {
		return err
	}

	token.token.Signature = signature
	token.token.Base64 = strings.Join([]string{base64, signature}, ".")
	token.MarkImmutable()
	return nil
}

// Verify validates the token's signature and claims using the provided JWK (JSON Web Key).
// This method performs comprehensive token validation including:
//   - Signature verification using the JWK's public key
//   - Expiration time validation (ensures token hasn't expired)
//   - Required claim presence (issuer and key ID)
//
// The verification process:
//  1. Validates required claims (issuer, key ID, expiration)
//  2. Checks that the token hasn't expired (exp > current time)
//  3. Extracts and decodes the signature from the token
//  4. Verifies the signature against the payload using the JWK's public key
//
// Parameters:
//   - jwk: The JSON Web Key containing the public key for verification
//
// Returns:
//   - error: Returns an error if:
//   - Token is missing required claims (iss, kid, exp, signature)
//   - Token has expired
//   - Signature is invalid or cannot be decoded
//   - Signature verification fails
//   - Public key type is not supported
//
// The returned error is wrapped as ErrUnauthorized if signature verification fails,
// or ErrExpired if the token has expired.
//
// See also: TokenWrapper.Sign, ImmutableJwk
func (token *TokenWrapper) Verify(jwk *wrapperJwk.ImmutableJwk) error {
	if token.token.Base64 == "" {
		return protoerrors.NewErrMissingInvalidData(nil, "token missing base64 encoding")
	}
	parsed, err := ParseToken(token.token.Base64)
	if err != nil {
		return protoerrors.NewErrMissingInvalidData(err, "token base64 encoding does not parse")
	}
	token.token = parsed.Proto()
	token.MarkImmutable()

	// Get issuer and kid
	issuer := token.GetIssuer()
	if issuer == "" {
		return protoerrors.NewErrMissingInvalidData(nil, "token missing issuer (iss) claim")
	}

	kid := token.GetKid()
	if kid == "" {
		return protoerrors.NewErrMissingInvalidData(nil, "token missing key ID (kid) in header")
	}

	alg := token.GetAlg()
	if alg == "" {
		return protoerrors.NewErrMissingInvalidData(nil, "token missing signing algorithm (alg) in header")
	}
	if alg != jwk.GetAlg() {
		return protoerrors.NewErrUnauthorized(nil, "token alg %q does not match JWK alg %q", alg, jwk.GetAlg())
	}

	if token.token.Signature == "" {
		return protoerrors.NewErrMissingInvalidData(nil, "token missing signature")
	}

	// Check expiration
	exp := token.GetExpiration()
	if exp <= 0 {
		return protoerrors.NewErrMissingInvalidData(nil, "token missing or invalid expiration (exp) claim")
	}

	const clockSkewSeconds int64 = 60

	now := time.Now().Unix()
	if now >= exp+clockSkewSeconds {
		return protoerrors.NewErrExpired("")
	}

	// Check not-before claim
	if s, ok := token.token.Payload["nbf"]; ok && s != "" {
		if nbf, err := strconv.ParseInt(s, 10, 64); err == nil {
			if now < nbf-clockSkewSeconds {
				return protoerrors.NewErrMissingInvalidData(nil, "token not yet valid")
			}
		}
	}

	sig, err := utils.DecodeBase64(token.token.Signature)
	if err != nil {
		return protoerrors.NewErrMissingInvalidData(err, "invalid signature base64 encoding")
	}

	// Extract payload (header.claims) from the JWT base64 string
	// JWT format is: base64(header).base64(claims).base64(signature)
	// We need to verify against header.claims
	// Find the last dot to separate signature from the payload
	lastDot := -1
	for i := len(token.token.Base64) - 1; i >= 0; i-- {
		if token.token.Base64[i] == '.' {
			lastDot = i
			break
		}
	}

	if lastDot == -1 {
		return protoerrors.NewErrMissingInvalidData(nil, "invalid JWT format: missing dot separator")
	}

	payload := token.token.Base64[:lastDot]

	returnErr := func(err error) error {
		if err == nil {
			return nil
		}
		return protoerrors.NewErrUnauthorized(err, "")
	}

	jwtSigningMethod := jwk.JwtSigningMethod()

	publicKey := jwk.PublicKey()

	switch v := publicKey.(type) {

	case *rsa.PublicKey:
		return returnErr(jwtSigningMethod.Verify(payload, sig, v))

	case ecdsa.PublicKey:
		return returnErr(jwtSigningMethod.Verify(payload, sig, &v))

	case *ecdsa.PublicKey:
		return returnErr(jwtSigningMethod.Verify(payload, sig, v))

	case ed25519.PublicKey:
		return returnErr(jwtSigningMethod.Verify(payload, sig, v))

	}

	return protoerrors.NewErrUnauthorized(nil, "invalid public key type")
}

// ========================================
// Private Utility Functions
// ========================================

// shortString returns a shortened version of a string pointer.
// Returns first 10 and last 10 characters with "..." in between for long strings.
// Returns empty string if pointer is nil.
func shortString(s *string) string {
	if s == nil || *s == "" {
		return ""
	}
	str := *s
	if len(str) <= 30 {
		return str
	}
	return str[:10] + "..." + str[len(str)-10:]
}

// convertToInt64 converts various types to int64.
// Supports: int, int32, int64, float32, float64
func convertToInt64(value any) (int64, error) {
	switch v := value.(type) {
	case int:
		return int64(v), nil
	case int32:
		return int64(v), nil
	case int64:
		return v, nil
	case float32:
		return int64(v), nil
	case float64:
		return int64(v), nil
	case string:
		// Accept string representations — Postel's law
		if n, err := strconv.ParseInt(v, 10, 64); err == nil {
			return n, nil
		}
		if f, err := strconv.ParseFloat(v, 64); err == nil {
			return int64(f), nil
		}
		return 0, protoerrors.NewErrMissingInvalidData(nil, "cannot parse %q as int64", v)
	default:
		return 0, protoerrors.NewErrMissingInvalidData(nil, "cannot convert %T to int64", value)
	}
}

// numericClaims identifies JWT claims that must be serialized as JSON numbers.
var numericClaims = map[string]bool{"exp": true, "iat": true, "nbf": true}

// payloadToJSON serializes a map<string,string> payload to JSON bytes,
// outputting numeric claims (exp, iat, nbf) as unquoted integers.
// Conservative output: always clean decimal integers.
// Liberal input: accepts scientific notation (e.g. "1.7424036E9").
// Rejects fractional values — a float where an integer is expected is a bug.
func payloadToJSON(payload map[string]string) ([]byte, error) {
	typed := make(map[string]interface{}, len(payload))
	for k, v := range payload {
		if numericClaims[k] {
			if n, err := strconv.ParseInt(v, 10, 64); err == nil {
				typed[k] = n
			} else if f, err := strconv.ParseFloat(v, 64); err == nil {
				if f != math.Trunc(f) {
					return nil, fmt.Errorf("numeric claim %s: fractional value %q not allowed — expected integer", k, v)
				}
				typed[k] = int64(f)
			} else {
				return nil, fmt.Errorf("numeric claim %s: cannot parse %q as number", k, v)
			}
		} else if len(v) > 0 && (v[0] == '{' || v[0] == '[') {
			// Embed JSON objects and arrays as native JSON, not quoted strings.
			typed[k] = json.RawMessage(v)
		} else {
			typed[k] = v
		}
	}
	return json.Marshal(typed)
}

// anyToBase64 converts any value to base64-encoded JSON string.
func anyToBase64(v any) (string, error) {
	// Special case for byte slices - encode directly
	if b, ok := v.([]byte); ok {
		return libBase64.RawURLEncoding.EncodeToString(b), nil
	}

	// For other types, marshal to JSON first
	jsonBytes, err := json.Marshal(v)
	if err != nil {
		return "", protoerrors.NewErrGeneral(err, "failed to marshal to JSON")
	}
	return libBase64.RawURLEncoding.EncodeToString(jsonBytes), nil
}
