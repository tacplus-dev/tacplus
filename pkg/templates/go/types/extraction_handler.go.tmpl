{{- /* Store-agnostic event handler — dispatches a source event to all its projections */ -}}
{{- /* Generated from (spec.timeseries_type).source annotations */ -}}

// Handle{{.SourceType}} dispatches a {{.SourceType}} to its timeseries projections:
// each projection the event yields is passed, typed, to that projection's
// insert callback. A nil callback skips its projection.
func Handle{{.SourceType}}(ctx context.Context, event *{{.SourceQualifier}}{{.SourceType}}{{range .TimeseriesProjections}}, insert{{.TypeName}} func(ctx context.Context, row *{{.TypeName}}) error{{end}}) error {
	if event == nil {
		return nil
	}

{{- if .HasNoop}}
	// Trace round — skip persist, pipeline continues but data is not written
	if event.Noop {
		return nil
	}
{{- end}}

{{- range .TimeseriesProjections}}

	// {{.TypeName}} — timeseries projection.
	if insert{{.TypeName}} != nil {
		if row := Extract{{.TypeName}}From{{$.SourceType}}(event); row != nil {
			if err := insert{{.TypeName}}(ctx, row); err != nil {
				return fmt.Errorf("insert {{.TypeName}}: %w", err)
			}
		}
	}
{{- end}}

	return nil
}
