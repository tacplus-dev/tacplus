    /**
     * Handler failure on the first SMB member-cert delivery — fatal at startup,
     * never retried (renewal failures are log-and-continue instead).
     */
    private static final class FatalSmbHandlerException extends Exception {
        FatalSmbHandlerException(String message, Throwable cause) {
            super(message, cause);
        }
    }

    /**
     * Manages the SMB member-cert stream (SPIFFE plan D7). Retries with backoff
     * on disconnection. The first-delivery outcome is signalled on readyLatch; a
     * handler failure on the FIRST delivery is fatal and stops the loop, while
     * later renewal-delivery failures are logged and the previous credential stays.
     */
	    private static void smbCertStreamLoop(
	            ServiceManager sm,
	            ServiceConnection smbAuthorityConn,
	            IdentityManager identity,
	            CountDownLatch readyLatch,
	            AtomicReference<Exception> readyError) {
        int attempt = 0;
        while (true) {
            final int seen = {{.ChassisBase}}.service_im.IdentityManager.credentialGeneration();
	            try {
	                runSmbCertStream(sm, smbAuthorityConn, identity, readyLatch);
                return;
            } catch (Exception e) {
                if (e instanceof FatalSmbHandlerException) {
                    // Handler rejected the first member cert — fail startup loudly.
                    readyError.set(e);
                    readyLatch.countDown();
                    return;
                }
                // A rejected credential must invalidate the token cache here too.
                // Without this an UNAUTHENTICATED ManageSmbCert stream retries
                // forever presenting the SAME cached token and never re-mints, so
                // the member never rejoins its peer mesh. Mirrors
                // tlsCertStreamLoop above.
                {{.ChassisBase}}.service_im.IdentityManager.noteIfCredentialRejection(e, seen);
                attempt++;
                if (readyLatch.getCount() > 0) {
                    // First member cert never delivered — retry with backoff.
                    if (attempt >= MAX_INIT_RETRIES) {
                        readyError.set(e);
                        readyLatch.countDown();
                        return;
                    }
                    long delay = Math.min((long) Math.pow(2, Math.min(attempt, 5)), 30);
                    LOG.warning("SMB cert stream failed before first cert (attempt " + attempt + "/" + MAX_INIT_RETRIES + "), retrying in " + delay + "s: " + e.getMessage());
                    try { Thread.sleep(delay * 1000); } catch (InterruptedException ie) { return; }
                } else {
                    LOG.warning("SMB cert stream disconnected, retrying in 5s: " + e.getMessage());
                    try { Thread.sleep(5000); } catch (InterruptedException ie) { return; }
                }
            }
        }
    }

    /**
     * Runs one ManageSmbCert stream session. The instance generates its own
     * member keypair and submits a CSR (public key only); its private key never
     * leaves the process. The authority signs under the stable per-SMB CA and
     * returns the member cert chain + the per-SMB CA trust anchor, handed to the
     * handler via newSmbCert (the consumer wires it into its black-box mTLS).
     */
	    private static void runSmbCertStream(
	            ServiceManager sm,
	            ServiceConnection smbAuthorityConn,
	            IdentityManager identity,
	            CountDownLatch readyLatch) throws Exception {
        // Generate the member keypair.
{{- if eq .AutoTlsKeyType "ecdsa"}}
        KeyPairGenerator kpg = KeyPairGenerator.getInstance("EC");
        kpg.initialize(new java.security.spec.ECGenParameterSpec("secp256r1"));
{{- else}}
        KeyPairGenerator kpg = KeyPairGenerator.getInstance("Ed25519");
{{- end}}
        KeyPair kp = kpg.generateKeyPair();
        // activePrivateKeyDer holds the key paired with the most recently confirmed
        // member cert. pendingPrivateKeyDer holds the key for an in-flight renewal
        // CSR, promoted to active only when the matching cert arrives.
        AtomicReference<byte[]> activePrivateKeyDer = new AtomicReference<>(kp.getPrivate().getEncoded());
        AtomicReference<byte[]> activePublicKeyDer = new AtomicReference<>(kp.getPublic().getEncoded());
        AtomicReference<byte[]> pendingPrivateKeyDer = new AtomicReference<>();
        AtomicReference<byte[]> pendingPublicKeyDer = new AtomicReference<>();

        KeyOuterClass.PublicKey pubProto = buildPublicKeyProto(kp);

        ManagedChannel channel = smbAuthorityConn.conn();
        if (channel == null) {
            throw new IllegalStateException("no active connection for ManageSmbCert");
        }
        SmbCertServiceGrpc.SmbCertServiceStub stub = SmbCertServiceGrpc.newStub(channel)
                .withCallCredentials(identity.callCredentials());

        CountDownLatch done = new CountDownLatch(1);
        AtomicReference<Exception> streamError = new AtomicReference<>();
        AtomicReference<StreamObserver<Smbcert.SmbCertClientMsg>> outboundRef = new AtomicReference<>();
        AtomicReference<io.grpc.stub.ClientCallStreamObserver<Smbcert.SmbCertClientMsg>> callRef = new AtomicReference<>();
        // Ending the session must end the CALL, not just the loop. Without an
        // explicit cancel the ManageSmbCert call stays open on the shared channel
        // after the loop has already failed, so the authority keeps sending and
        // onNext keeps applying certs for a session that no longer exists — and
        // a message already in flight is still handled after the decision to
        // fail. go returns out of the loop and rust propagates with `?`, which
        // drops their stream; java has to say so explicitly.
        java.util.function.Consumer<Exception> endSession = err -> {
            streamError.compareAndSet(null, err);
            done.countDown();
            io.grpc.stub.ClientCallStreamObserver<Smbcert.SmbCertClientMsg> call = callRef.get();
            if (call != null) {
                try {
                    call.cancel("ManageSmbCert session ended", err);
                } catch (RuntimeException ignored) {}
            }
        };

        StreamObserver<Smbcert.SmbCertClientMsg> outbound = stub.manageSmbCert(
                new io.grpc.stub.ClientResponseObserver<Smbcert.SmbCertClientMsg, Smbcert.SmbCertServerMsg>() {
                    @Override
                    public void beforeStart(io.grpc.stub.ClientCallStreamObserver<Smbcert.SmbCertClientMsg> requestStream) {
                        callRef.set(requestStream);
                    }

                    @Override
                    public void onNext(Smbcert.SmbCertServerMsg msg) {
                        // The session already ended; a message that was in flight
                        // when it did must not be applied.
                        if (done.getCount() == 0) {
                            return;
                        }
                        if (msg.hasCert()) {
                            try {
                                X509.X509CertChain memberChain = msg.getCert().getMemberChain();
                                X509.X509Cert ca = msg.getCert().getCa();
                                // Use the pending renewal key (if any) for this
                                // delivery, but do not promote it until the
                                // handler seam accepts the matching cert.
                                byte[] pending = pendingPrivateKeyDer.get();
                                byte[] keyDer = pending != null ? pending : activePrivateKeyDer.get();
                                byte[] pendingPublic = pendingPublicKeyDer.get();
                                byte[] publicKeyDer = pendingPublic != null ? pendingPublic : activePublicKeyDer.get();
                                try {
                                    verifyLeafMatchesPublicKey(memberChain, publicKeyDer);
                                } catch (Exception verifyErr) {
                                    if (readyLatch.getCount() > 0) {
                                        endSession.accept(new Exception("SMB member cert public key mismatch", verifyErr));
                                        return;
                                    }
                                    LOG.warning("SMB member cert public key mismatch on renewal delivery, keeping previous credential: " + verifyErr.getMessage());
                                    pendingPrivateKeyDer.set(null);
                                    pendingPublicKeyDer.set(null);
                                    return;
                                }
                                Handler activeHandler = sm.smbHandlerSlot.get();
                                if (activeHandler != null) {
                                    try {
                                        activeHandler.newSmbCert(memberChain, keyDer, ca);
                                    } catch (Exception cbErr) {
                                        if (readyLatch.getCount() > 0) {
                                            // Handler failure on the FIRST delivery is fatal.
                                            endSession.accept(new FatalSmbHandlerException(
                                                    "handler newSmbCert failed on first member cert delivery", cbErr));
                                            return;
                                        }
                                        // Renewal delivery: keep the previous credential.
                                        LOG.warning("Handler newSmbCert failed on renewal delivery, keeping previous credential: " + cbErr.getMessage());
                                        pendingPrivateKeyDer.set(null);
                                        pendingPublicKeyDer.set(null);
                                        return;
                                    }
                                }
                                if (pending != null) {
                                    activePrivateKeyDer.set(pending);
                                    activePublicKeyDer.set(publicKeyDer);
                                    pendingPrivateKeyDer.set(null);
                                    pendingPublicKeyDer.set(null);
                                }
                                // A DELIVERED member cert proves the credential was
                                // accepted. Mirrors the TLS loop: without it an
                                // SMB-only service (no auto-TLS, no state watches)
                                // has no site that can ever clear the rejection
                                // counter, so it stays degraded forever after a
                                // brief authority blip.
                                {{.ChassisBase}}.service_im.IdentityManager.noteCredentialAccepted();
                                if (readyLatch.getCount() > 0) {
                                    readyLatch.countDown();
                                }
                            } catch (Exception e) {
                                LOG.warning("SMB member cert delivery handling failed: " + e.getMessage());
                                pendingPrivateKeyDer.set(null);
                                pendingPublicKeyDer.set(null);
                            }
                        } else if (msg.hasRenew()) {
                            LOG.info("SMB member cert renewal requested: " + msg.getRenew().getReason());
                            KeyOuterClass.PublicKey newPub;
                            try {
                                KeyPair newKp = kpg.generateKeyPair();
                                // Stage the new key as pending — the active key only
                                // changes once the matching cert is delivered.
                                pendingPrivateKeyDer.set(newKp.getPrivate().getEncoded());
                                pendingPublicKeyDer.set(newKp.getPublic().getEncoded());
                                newPub = buildPublicKeyProto(newKp);
                            } catch (Exception e) {
                                // The CSR never went out, so there is no in-flight
                                // request for this key to pair with. Drop it, and end
                                // the session so the loop reconnects and re-CSRs —
                                // otherwise the authority's renewal request goes
                                // unanswered and the member cert runs to expiry
                                // (go returns the session error, rust propagates `?`).
                                pendingPrivateKeyDer.set(null);
                                pendingPublicKeyDer.set(null);
                                endSession.accept(new Exception("generate SMB renewal keypair", e));
                                return;
                            }
                            try {
                                outboundRef.get().onNext(Smbcert.SmbCertClientMsg.newBuilder()
                                        .setCsr(Smbcert.SmbCertCsr.newBuilder()
                                                .setPublicKey(newPub))
                                        .build());
                            } catch (Exception e) {
                                // Same reasoning as above.
                                pendingPrivateKeyDer.set(null);
                                pendingPublicKeyDer.set(null);
                                endSession.accept(new Exception("send SMB renewal Csr", e));
                            }
                        } else if (!msg.getError().isEmpty()) {
                            endSession.accept(new Exception("server error: " + msg.getError()));
                        }
                    }

                    @Override
                    public void onError(Throwable t) {
                        streamError.compareAndSet(null, new Exception(t));
                        done.countDown();
                    }

                    @Override
                    public void onCompleted() {
                        if (streamError.get() == null) {
                            if (readyLatch.getCount() > 0) {
                                streamError.set(new Exception("ManageSmbCert stream completed before first member cert delivery"));
                            } else {
                                streamError.set(new Exception("ManageSmbCert stream completed after first member cert delivery"));
                            }
                        }
                        done.countDown();
                    }
                });

        outboundRef.set(outbound);

        // Send Init.
        String hostname = java.net.InetAddress.getLocalHost().getHostName();
        outbound.onNext(Smbcert.SmbCertClientMsg.newBuilder()
                .setInit(Smbcert.SmbCertInit.newBuilder()
                        .setSmbService("{{.ServiceLabel}}")
                        .setInstanceId(hostname))
                .build());

        // Send initial Csr.
        outbound.onNext(Smbcert.SmbCertClientMsg.newBuilder()
                .setCsr(Smbcert.SmbCertCsr.newBuilder()
                        .setPublicKey(pubProto))
                .build());

        // Wait for stream to end.
        try {
            done.await();
        } finally {
            try { outbound.onCompleted(); } catch (Exception ignored) {}
        }
        if (streamError.get() != null) {
            throw streamError.get();
        }
    }
{{- end}}
{{- if or .HasAutoTls .HasSmb}}

    private static KeyOuterClass.PublicKey buildPublicKeyProto(KeyPair kp) {
        byte[] pubDer = kp.getPublic().getEncoded();
        String pubPem = "-----BEGIN PUBLIC KEY-----\n"
                + java.util.Base64.getMimeEncoder(64, "\n".getBytes()).encodeToString(pubDer)
                + "\n-----END PUBLIC KEY-----\n";
        String pubBase64 = java.util.Base64.getUrlEncoder().withoutPadding()
                .encodeToString(pubPem.getBytes(java.nio.charset.StandardCharsets.UTF_8));
        return KeyOuterClass.PublicKey.newBuilder()
                .setId("auto-tls-" + System.currentTimeMillis())
                .setBase64(pubBase64)
                .setCreated(System.currentTimeMillis() / 1000)
                .build();
    }

    private static void verifyLeafMatchesPublicKey(X509.X509CertChain chain, byte[] expectedPublicKeyDer)
            throws Exception {
        if (chain == null || chain.getChainCount() == 0) {
            throw new IllegalArgumentException("certificate chain is empty");
        }
        if (expectedPublicKeyDer == null || expectedPublicKeyDer.length == 0) {
            throw new IllegalArgumentException("expected public key is empty");
        }
        byte[] leafBytes = decodeCertBytes(chain.getChain(0).getBase64());
        CertificateFactory cf = CertificateFactory.getInstance("X.509");
        X509Certificate leaf = (X509Certificate) cf.generateCertificate(new ByteArrayInputStream(leafBytes));
        if (!Arrays.equals(leaf.getPublicKey().getEncoded(), expectedPublicKeyDer)) {
            throw new IllegalArgumentException("leaf certificate public key does not match CSR public key");
        }
    }

    private static byte[] decodeCertBytes(String base64) {
        if (base64 == null || base64.isEmpty()) {
            throw new IllegalArgumentException("certificate base64 is empty");
        }
        byte[] raw;
        try {
            raw = java.util.Base64.getUrlDecoder().decode(base64);
        } catch (IllegalArgumentException urlErr) {
            raw = java.util.Base64.getDecoder().decode(base64);
        }
        String text = new String(raw, java.nio.charset.StandardCharsets.UTF_8);
        if (text.contains("-----BEGIN")) {
            StringBuilder body = new StringBuilder();
            for (String line : text.split("\\R")) {
                if (!line.startsWith("-----")) {
                    body.append(line.trim());
                }
            }
            return java.util.Base64.getDecoder().decode(body.toString());
        }
        return raw;
    }
{{- end}}
