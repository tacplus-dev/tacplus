        let mut pem_bundle = String::new();
        if !cfg.trusted_cas.is_empty() {
            for ca in &cfg.trusted_cas {
                if !ca.base64.is_empty() {
                    if let Ok(pem_bytes) = base64::engine::general_purpose::STANDARD_NO_PAD.decode(&ca.base64)
                        .or_else(|_| base64::engine::general_purpose::STANDARD.decode(&ca.base64)) {
                        if let Ok(pem_str) = String::from_utf8(pem_bytes) {
                            pem_bundle.push_str(&pem_str);
                            pem_bundle.push('\n');
                        }
                    }
