/// What the server reads from one leg.
struct LegRx {
    state: Arc<LegState>,
    stream: tonic::Streaming<Envelope>,
}

fn server_leg(
    stream: tonic::Streaming<Envelope>,
    exp_millis: Option<i64>,
) -> (LegTx, LegRx, Abortable<Envelope>) {
    let (tx, rx) = mpsc::channel(LEG_BUFFER);
    let (abort_tx, abort_rx) = oneshot::channel();
    let state = Arc::new(LegState {
        id: NEXT_LEG_ID.fetch_add(1, Ordering::Relaxed),
        exp_millis,
        ended: AtomicBool::new(false),
        abort: Mutex::new(Some(abort_tx)),
        gone: Notify::new(),
    });
    let gone = state.clone();
    (
        LegTx { state: state.clone(), tx: Some(tx) },
        LegRx { state, stream },
        Abortable::new(rx, abort_rx).on_drop(move || gone.gone.notify_one()),
    )
}

