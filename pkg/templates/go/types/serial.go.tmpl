{{- /* Go serialization template - generates JSON/YAML/TOML helpers for messages */ -}}
{{- range .Messages}}
// {{.TypeName}}JSON represents {{.TypeName}} in external JSON format (with string enums)
// MARKER: JSON helper struct generated from serial.go
type {{.HelperName}}JSON struct {
{{- range .Fields}}
{{.GoFieldName}} {{.JSONType}} `json:"{{.JSONTag}},omitempty"`
{{- end}}
}

// {{.TypeName}}ToJSON converts {{.TypeName}} to JSON bytes.
// Uses custom JSON helper for friendly enum strings and proper int64 handling.
func {{.TypeName}}ToJSON(v *{{.TypeName}}) ([]byte, error) {
if v == nil {
return nil, protoerrors.NewErrMissingInvalidData(nil, "{{.LowerTypeName}} is nil")
}
// Convert to JSON helper struct with string enums
helper := {{.HelperName}}JSON{
{{- range .ToJSONFields}}
{{.Assignment}}
{{- end}}
}
return json.Marshal(helper)
}

// {{.TypeName}}ToJSONPretty converts {{.TypeName}} to indented JSON bytes.
// Uses custom JSON helper for friendly enum strings and proper int64 handling.
func {{.TypeName}}ToJSONPretty(v *{{.TypeName}}) ([]byte, error) {
if v == nil {
return nil, protoerrors.NewErrMissingInvalidData(nil, "{{.LowerTypeName}} is nil")
}
// Convert to JSON helper struct with string enums
helper := {{.HelperName}}JSON{
{{- range .ToJSONFields}}
{{.Assignment}}
{{- end}}
}
return json.MarshalIndent(helper, "", "  ")
}

// {{.TypeName}}FromBytes creates {{.TypeName}} from bytes, auto-detecting the format.
// Supports JSON, YAML, TOML, and binary protobuf formats.
func {{.TypeName}}FromBytes(data []byte) (*{{.TypeName}}, error) {
// Trim leading whitespace to check format
trimmed := bytes.TrimSpace(data)
if len(trimmed) == 0 {
return nil, protoerrors.NewErrMissingInvalidData(nil, "empty data")
}
// Try JSON first (most common, starts with { or [)
if trimmed[0] == '{' || trimmed[0] == '[' {
if result, err := {{.TypeName}}FromJSON(data); err == nil {
return result, nil
}
}
// Try TOML (try before YAML since YAML is more permissive)
var tomlObj any
if err := toml.Unmarshal(data, &tomlObj); err == nil {
// Convert TOML to JSON, then parse
jsonData, err := json.Marshal(tomlObj)
if err == nil {
if result, err := {{.TypeName}}FromJSON(jsonData); err == nil {
return result, nil
}
}
}
// Try YAML
var yamlObj any
if err := yaml.Unmarshal(data, &yamlObj); err == nil {
// Convert YAML to JSON, then parse
jsonData, err := json.Marshal(yamlObj)
if err == nil {
if result, err := {{.TypeName}}FromJSON(jsonData); err == nil {
return result, nil
}
}
}
// Try binary protobuf
v := &{{.TypeName}}{}
if err := proto.Unmarshal(data, v); err == nil {
return v, nil
}
return nil, protoerrors.NewErrMissingInvalidData(nil, "failed to parse {{.TypeName}}: unsupported format or invalid data")
}

// {{.TypeName}}FromJSON creates {{.TypeName}} from JSON bytes.
// Uses standard encoding/json and custom enum parsers for external JSON compatibility.
func {{.TypeName}}FromJSON(data []byte) (*{{.TypeName}}, error) {
{{- if .JSONAliases}}
// Normalize alias keys to canonical keys before unmarshaling
var obj map[string]json.RawMessage
if err := json.Unmarshal(data, &obj); err == nil {
aliasMap := map[string]string{
{{- range .JSONAliases}}
"{{.Alias}}": "{{.Canonical}}",
{{- end}}
}
for alias, canonical := range aliasMap {
if v, ok := obj[alias]; ok {
if _, exists := obj[canonical]; !exists {
obj[canonical] = v
}
delete(obj, alias)
}
}
data, _ = json.Marshal(obj)
}
{{- end}}
// Unmarshal into helper struct with string enums
var raw {{.HelperName}}JSON
if err := json.Unmarshal(data, &raw); err != nil {
// Fall back to protojson which handles proto3 JSON conventions
// (string-encoded int64/uint64, standard enum names, etc.)
v := &{{.TypeName}}{}
if pErr := protojson.Unmarshal(data, v); pErr != nil {
return nil, err
}
return v, nil
}
// Build result with parsed enums
result := &{{.TypeName}}{}
{{- range .FromJSONFields}}
{{.Assignment}}
{{- end}}
return result, nil
}

// {{.TypeName}}ToYAML converts {{.TypeName}} to YAML bytes.
// Converts to JSON first, then to YAML for proper protobuf handling.
func {{.TypeName}}ToYAML(v *{{.TypeName}}) ([]byte, error) {
if v == nil {
return nil, protoerrors.NewErrMissingInvalidData(nil, "{{.LowerTypeName}} is nil")
}
// Convert to JSON first
jsonData, err := {{.TypeName}}ToJSON(v)
if err != nil {
return nil, err
}
// Convert JSON to YAML, preserving integer precision
dec := json.NewDecoder(bytes.NewReader(jsonData))
dec.UseNumber()
var obj any
if err := dec.Decode(&obj); err != nil {
return nil, err
}
return yaml.Marshal(convertJSONNumbers(obj))
}

// {{.TypeName}}ToTOML converts {{.TypeName}} to TOML bytes.
// Converts to JSON first, then to TOML for proper protobuf handling.
func {{.TypeName}}ToTOML(v *{{.TypeName}}) ([]byte, error) {
if v == nil {
return nil, protoerrors.NewErrMissingInvalidData(nil, "{{.LowerTypeName}} is nil")
}
// Convert to JSON first
jsonData, err := {{.TypeName}}ToJSON(v)
if err != nil {
return nil, err
}
// Convert JSON to TOML
var obj any
if err := json.Unmarshal(jsonData, &obj); err != nil {
return nil, err
}
return toml.Marshal(obj)
}
{{end}}