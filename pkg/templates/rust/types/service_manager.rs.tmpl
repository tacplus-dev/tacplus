/// Manages the bidi TLS certificate stream, retrying on disconnection.
/// The OUTCOME of the first cert delivery is signalled on `ready_tx`: `Ok(())`
/// once a cert is installed, `Err(reason)` when the handler rejects that first
/// cert or the loop gives up before any delivery. Both `Err` cases are fatal —
/// the loop stops and the service fails to start, naming the cause. If
/// `ready_tx` is dropped without sending, the service will fail to start.
/// `max_init_retries` is the first-delivery retry budget; it falls back to
/// `MAX_INIT_RETRIES` when 0. It is a parameter rather than the bare const so
/// an exhaustion test can spend the budget in seconds (PC-L-3); production
/// passes `MAX_INIT_RETRIES`. The general-init, state-store and health-reporter
/// loops still read the const directly and are unchanged.
async fn tls_cert_stream_loop(
    conn: Arc<ServiceConnection>,
    service_label: String,
    instance_id: String,
    handler_slot: Arc<tokio::sync::RwLock<Option<Arc<dyn Handler>>>>,
    token_provider: TokenProvider,
    mut ready_tx: Option<tokio::sync::oneshot::Sender<Result<(), String>>>,
    cert_der_store: Arc<tokio::sync::RwLock<Option<Vec<Vec<u8>>>>>,
    key_der_store: Arc<tokio::sync::RwLock<Option<Vec<u8>>>>,
    cert_proto_store: Arc<tokio::sync::RwLock<Option<x509_pb::X509CertChain>>>,
    cert_pem_store: Arc<tokio::sync::RwLock<Option<String>>>,
    key_pem_store: Arc<tokio::sync::RwLock<Option<String>>>,
    server_certified_key_store: Arc<std::sync::RwLock<Option<Arc<CertifiedKey>>>>,
    tls_degrade: Arc<std::sync::Mutex<TlsDegradeSeam>>,
    max_init_retries: u32,
) {
    let max_init_retries = if max_init_retries == 0 { MAX_INIT_RETRIES } else { max_init_retries };
    let mut init_attempts: u32 = 0;
    loop {
        let waiting_for_first = ready_tx.is_some();
        let retry = match run_tls_cert_stream(
            conn.clone(), &service_label, &instance_id, &handler_slot,
            token_provider.clone(), &mut ready_tx,
            &cert_der_store, &key_der_store, &cert_proto_store, &cert_pem_store, &key_pem_store,
            server_certified_key_store.clone(), &tls_degrade,
        ).await {
            Ok(delivered) => {
                if waiting_for_first && !delivered && ready_tx.is_none() {
                    // run_tls_cert_stream took ready_tx to report a handler that
                    // REJECTED the first certificate. Startup has already been
                    // failed with that error; retrying cannot help, so stop the
                    // loop. Parity with go's errTlsFirstCertFatal and with
                    // smb_cert_stream_loop below.
                    return;
                }
                if delivered {
                    init_attempts = 0;
                    // A DELIVERED certificate proves the credential was accepted.
                    // Without this the TLS loop could only ever increment the
                    // rejection counter, so a service with no state watches — the
                    // only other clear site — would stay UNHEALTHY forever after a
                    // brief authority blip, even once it reconnected happily.
                    service_im::note_credential_accepted();
                }
                tracing::warn!("TLS cert stream ended cleanly, reconnecting");
                None
            }
            Err(e) => {
                tracing::warn!("TLS cert stream disconnected, retrying in 5s: {}", e);
                // Only the TEXT escapes the arm: `e` is non-Send, so holding it
                // across the await below makes the whole task non-Send.
                Some(e.to_string())
            }
        };
        // retry sleep is outside the match arm so `e` (non-Send) is dropped before the await.
        // A rejected credential must invalidate the token cache here too: this
        // stream renews the serving certificate, so a stuck credential costs the
        // service its TLS as well as its authentication.
        if let Some(reason) = retry.as_deref() {
            service_im::note_if_credential_rejection(reason).await;
        }
        if waiting_for_first && ready_tx.is_some() {
            init_attempts += 1;
            if init_attempts >= max_init_retries {
                tracing::error!(attempts = init_attempts, "TLS cert stream failed before first delivery");
                let cause = retry.as_deref().unwrap_or("no cert delivered").to_string();
                let give_up = format!(
                    "TLS cert stream failed before first delivery after {} attempts: {}",
                    init_attempts, cause);
                // The DEGRADE reason keeps the go/java wording verbatim
                // (service_manager.go.tmpl:1154, ServiceManager.java.tmpl:1194)
                // — it is operator-facing health-plane text and must read the
                // same in every language. The attempt-count variant above is
                // for startup's ready channel, which go/java do not have.
                report_tls_degraded(&tls_degrade, &format!("TLS renewal stream gave up before first delivery: {}", cause));
                // Startup is blocked on this channel — hand it the CAUSE, not a
                // generic timeout, so a misconfiguration is named once.
                if let Some(tx) = ready_tx.take() {
                    let _ = tx.send(Err(give_up));
                }
                return;
            }
            let delay = std::time::Duration::from_secs(std::cmp::min(1u64 << std::cmp::min(init_attempts, 5), 30));
            tokio::time::sleep(delay).await;
        } else {
            tokio::time::sleep(std::time::Duration::from_secs(5)).await;
        }
    }
}

async fn run_tls_cert_stream(
    conn_provider: Arc<ServiceConnection>,
    service_label: &str,
    instance_id: &str,
    handler_slot: &Arc<tokio::sync::RwLock<Option<Arc<dyn Handler>>>>,
    token_provider: TokenProvider,
    ready_tx: &mut Option<tokio::sync::oneshot::Sender<Result<(), String>>>,
    cert_der_store: &Arc<tokio::sync::RwLock<Option<Vec<Vec<u8>>>>>,
    key_der_store: &Arc<tokio::sync::RwLock<Option<Vec<u8>>>>,
    cert_proto_store: &Arc<tokio::sync::RwLock<Option<x509_pb::X509CertChain>>>,
    cert_pem_store: &Arc<tokio::sync::RwLock<Option<String>>>,
    key_pem_store: &Arc<tokio::sync::RwLock<Option<String>>>,
    server_certified_key_store: Arc<std::sync::RwLock<Option<Arc<CertifiedKey>>>>,
    tls_degrade: &std::sync::Mutex<TlsDegradeSeam>,
) -> Result<bool, Box<dyn std::error::Error>> {
    let (tx, rx) = tokio::sync::mpsc::channel::<tlscert_pb::TlsCertClientMsg>(4);

    let (private_key_der, public_key_der, pub_proto) = generate_key_and_proto()?;
    let mut active_private_key_der = private_key_der;
    let mut active_public_key_der = public_key_der;
    let mut pending_private_key_der: Option<Vec<u8>> = None;
    let mut pending_public_key_der: Option<Vec<u8>> = None;

    // Send Init message.
    tx.send(tlscert_pb::TlsCertClientMsg {
        msg: Some(tlscert_pb::tls_cert_client_msg::Msg::Init(tlscert_pb::TlsCertInit {
            service_name: service_label.to_string(),
            instance_id: instance_id.to_string(),
        })),
    }).await.map_err(|e| format!("send Init: {}", e))?;

    // Send initial Csr.
    tx.send(tlscert_pb::TlsCertClientMsg {
        msg: Some(tlscert_pb::tls_cert_client_msg::Msg::Csr(tlscert_pb::TlsCertCsr {
            public_key: Some(pub_proto),
        })),
    }).await.map_err(|e| format!("send Csr: {}", e))?;

    let conn = conn_provider.conn().await
        .ok_or("no active connection for ManageCert")?;
    let mut client = TlsCertServiceClient::new(conn);
    let mut request = tonic::Request::new(tokio_stream::wrappers::ReceiverStream::new(rx));
    let token = (token_provider)().await
        .map_err(|e| format!("token provider failed for ManageCert: {}", e))?;
    request.metadata_mut().insert(
        "authorization",
        format!("Bearer {}", token).parse()
            .map_err(|e| format!("invalid token for ManageCert header: {}", e))?,
    );
    let response = client.manage_cert(request).await?;
    let mut inbound = response.into_inner();

    let mut delivered_first = ready_tx.is_none();

    while let Some(server_msg) = inbound.message().await? {
        match server_msg.msg {
            Some(tlscert_pb::tls_cert_server_msg::Msg::Cert(delivery)) => {
                if let Some(chain) = delivery.chain {
                    let candidate_private_key_der = pending_private_key_der
                        .clone()
                        .unwrap_or_else(|| active_private_key_der.clone());
                    let candidate_public_key_der = pending_public_key_der
                        .clone()
                        .unwrap_or_else(|| active_public_key_der.clone());
                    if let Err(e) = cert_leaf_matches_public_key(&chain, &candidate_public_key_der) {
                        if ready_tx.is_some() {
                            return Err(format!("TLS cert public key mismatch: {}", e).into());
                        }
                        tracing::error!("TLS cert public key mismatch on renewal delivery, keeping previous cert: {}", e);
                        report_tls_degraded(tls_degrade, &format!("renewed TLS certificate does not match the requested key, keeping the previous certificate: {}", e));
                        pending_private_key_der = None;
                        pending_public_key_der = None;
                        continue;
                    }
                    // Each chain entry's `base64` field decodes to either raw DER
                    // bytes or a PEM string. Normalise into (der_bytes, pem_string)
                    // pairs and store both forms on the SM.
                    let mut chain_der: Vec<Vec<u8>> = Vec::with_capacity(chain.chain.len());
                    let mut chain_pem = String::new();
                    for c in &chain.chain {
                        if c.base64.is_empty() { continue; }
                        let raw = match base64::engine::general_purpose::URL_SAFE_NO_PAD.decode(&c.base64)
                            .or_else(|_| base64::engine::general_purpose::URL_SAFE.decode(&c.base64))
                            .or_else(|_| base64::engine::general_purpose::STANDARD_NO_PAD.decode(&c.base64))
                            .or_else(|_| base64::engine::general_purpose::STANDARD.decode(&c.base64))
                        {
                            Ok(r) => r,
                            Err(_) => continue,
                        };
                        if raw.starts_with(b"-----BEGIN") {
                            // PEM in base64 → extract DER body for the DER store
                            // and keep the original PEM string for the PEM store.
                            let pem_text = match std::str::from_utf8(&raw) {
                                Ok(s) => s.to_string(),
                                Err(_) => continue,
                            };
                            let body: String = pem_text.lines()
                                .filter(|l| !l.starts_with("-----"))
                                .collect();
                            if let Ok(der) = base64::engine::general_purpose::STANDARD.decode(body.as_bytes()) {
                                chain_der.push(der);
                                chain_pem.push_str(&pem_text);
                                if !chain_pem.ends_with('\n') {
                                    chain_pem.push('\n');
                                }
                            }
                        } else {
                            // Raw DER → encode to PEM for the PEM store.
                            let b64 = base64::engine::general_purpose::STANDARD.encode(&raw);
                            chain_pem.push_str("-----BEGIN CERTIFICATE-----\n");
                            for line in b64.as_bytes().chunks(64) {
                                chain_pem.push_str(std::str::from_utf8(line).unwrap_or(""));
                                chain_pem.push('\n');
                            }
                            chain_pem.push_str("-----END CERTIFICATE-----\n");
                            chain_der.push(raw);
                        }
                    }

                    let key_b64 = base64::engine::general_purpose::STANDARD
                        .encode(&candidate_private_key_der);
                    let mut key_pem = String::from("-----BEGIN PRIVATE KEY-----\n");
                    for line in key_b64.as_bytes().chunks(64) {
                        key_pem.push_str(std::str::from_utf8(line).unwrap_or(""));
                        key_pem.push('\n');
                    }
                    key_pem.push_str("-----END PRIVATE KEY-----\n");

                    let server_certified_key = match certified_key_from_pem(&chain_pem, &key_pem) {
                        Ok(certified_key) => certified_key,
                        Err(e) => {
                            tracing::error!("Failed to build TLS server identity from delivered cert: {}", e);
                            report_tls_degraded(tls_degrade, &format!("renewed TLS private key unparseable: {}", e));
                            pending_private_key_der = None;
                            pending_public_key_der = None;
                            continue;
                        }
                    };

                    // Fire the user handler if registered (run() sets the slot). On
                    // the initial cert (before run() is called) the slot is empty —
                    // that's fine, the cert is still stored for the polling accessors.
                    let handler_opt = handler_slot.read().await.clone();
                    let handler_err: Option<String> = if let Some(handler) = handler_opt {
                        match handler.new_tls_cert(&chain, &candidate_private_key_der).await {
                            Ok(()) => None,
                            Err(e) => {
                                tracing::error!("Handler new_tls_cert failed: {}", e);
                                if ready_tx.is_none() {
                                    // Renewal delivery: the previous certificate stays
                                    // in service and will expire. First delivery is
                                    // reported through ready_tx instead.
                                    report_tls_degraded(tls_degrade, &format!("TLS handler rejected a renewed certificate, keeping the previous certificate: {}", e));
                                }
                                Some(e.to_string())
                            }
                        }
                    } else {
                        None
                    };
                    if handler_err.is_none() {
                        active_private_key_der = candidate_private_key_der.clone();
                        active_public_key_der = candidate_public_key_der.clone();
                        pending_private_key_der = None;
                        pending_public_key_der = None;
                        *cert_proto_store.write().await = Some(chain.clone());
                        *cert_der_store.write().await = Some(chain_der);
                        *key_der_store.write().await = Some(candidate_private_key_der);
                        *cert_pem_store.write().await = Some(chain_pem);
                        *key_pem_store.write().await = Some(key_pem);
                        match server_certified_key_store.write() {
                            Ok(mut guard) => {
                                *guard = Some(server_certified_key);
                            }
                            Err(e) => {
                                // The resolver's store is poisoned, so this renewal —
                                // and every later one — never reaches the handshake
                                // path: the servers keep resolving the PREVIOUS
                                // certificate until it expires. Logging alone leaves
                                // the instance reporting Ready right up to the outage,
                                // so route it into the health plane like go does for a
                                // failed serving-cert rebuild (PC-L-1).
                                tracing::error!("Failed to install TLS server identity: {}", e);
                                report_tls_degraded(tls_degrade, &format!("renewed TLS serving certificate could not be installed: {}", e));
                            }
                        }
                        if let Some(tx) = ready_tx.take() {
                            // Signal that the first cert was delivered — service can start.
                            let _ = tx.send(Ok(()));
                            delivered_first = true;
                        }
                    } else {
                        pending_private_key_der = None;
                        pending_public_key_der = None;
                        if let Some(tx) = ready_tx.take() {
                            // FIRST delivery: the handler rejected the only cert the
                            // service can serve with, so startup must abort with that
                            // error rather than retry (go: errTlsFirstCertFatal).
                            // delivered_first stays false — the loop reads
                            // "ready_tx taken without a delivery" as fatal.
                            let _ = tx.send(Err(format!(
                                "handler new_tls_cert failed on first delivery: {}",
                                handler_err.unwrap_or_default())));
                            return Ok(delivered_first);
                        }
                    }
                }
            }
            Some(tlscert_pb::tls_cert_server_msg::Msg::Renew(renew)) => {
                tracing::info!("TLS cert renewal requested: {}", renew.reason);
                let (new_private_key_der, new_public_key_der, new_pub_proto) = generate_key_and_proto()?;
                pending_private_key_der = Some(new_private_key_der);
                pending_public_key_der = Some(new_public_key_der);
                tx.send(tlscert_pb::TlsCertClientMsg {
                    msg: Some(tlscert_pb::tls_cert_client_msg::Msg::Csr(tlscert_pb::TlsCertCsr {
                        public_key: Some(new_pub_proto),
                    })),
                }).await.map_err(|e| format!("send renewal Csr: {}", e))?;
            }
            Some(tlscert_pb::tls_cert_server_msg::Msg::Error(e)) => {
                return Err(format!("server error: {}", e).into());
            }
            None => {}
        }
    }
    Ok(delivered_first)
}
{{- end}}

{{- if .HasSmb}}

/// Manages the SMB member-cert stream (SPIFFE plan D7), retrying with a 5s
/// backoff on disconnection. The instance generates its own member keypair and
/// submits a CSR (public key only); the member private key never leaves the
/// process. The authority signs under the stable per-SMB CA and returns the
/// member cert chain + the per-SMB CA trust anchor, which are handed to the
/// handler via `new_smb_cert`.
///
/// The outcome of the FIRST delivery is signalled on `ready_tx`; a handler
/// failure on the first delivery is fatal and stops the loop (the instance must
/// not start without its SMB member credential), while later renewal-delivery
/// failures are logged and the previous credential stays in use.
async fn smb_cert_stream_loop(
    conn: Arc<ServiceConnection>,
    service_label: String,
    instance_id: String,
    handler: Arc<dyn Handler>,
    token_provider: TokenProvider,
    mut ready_tx: Option<tokio::sync::oneshot::Sender<Result<(), String>>>,
) {
    let mut init_attempts: u32 = 0;
    loop {
        let waiting_for_first = ready_tx.is_some();
        let retry = match run_smb_cert_stream(
            conn.clone(), &service_label, &instance_id, &handler,
            token_provider.clone(), &mut ready_tx,
        ).await {
            Ok(fatal) => {
                if fatal {
                    // Handler rejected the first delivery — abort the loop.
                    return;
                }
                if waiting_for_first && ready_tx.is_none() {
                    // A DELIVERED member cert proves the credential was accepted.
                    // Mirrors tls_cert_stream_loop: without it an SMB-only service
                    // (no auto-TLS, no state watches) has no site that can ever
                    // clear the rejection counter, so it stays degraded forever
                    // after a brief authority blip.
                    service_im::note_credential_accepted();
                }
                tracing::warn!("SMB cert stream ended cleanly, reconnecting");
                None
            }
            Err(e) => {
                tracing::warn!("SMB cert stream disconnected, retrying in 5s: {}", e);
                // Only the TEXT escapes the arm: `e` is non-Send, so holding it
                // across the await below makes the whole task non-Send.
                Some(e.to_string())
            }
        };
        // A rejected credential must invalidate the token cache here too. Without
        // this an UNAUTHENTICATED ManageSmbCert stream retries forever presenting
        // the SAME cached token and never re-mints, so the member never rejoins
        // its peer mesh. Mirrors tls_cert_stream_loop above.
        if let Some(reason) = retry.as_deref() {
            service_im::note_if_credential_rejection(reason).await;
        }
        if waiting_for_first && ready_tx.is_some() {
            init_attempts += 1;
            if init_attempts >= MAX_INIT_RETRIES {
                if let Some(tx) = ready_tx.take() {
                    let _ = tx.send(Err(format!("SMB cert stream failed before first delivery after {} attempts", init_attempts)));
                }
                return;
            }
            let delay = std::time::Duration::from_secs(std::cmp::min(1u64 << std::cmp::min(init_attempts, 5), 30));
            tokio::time::sleep(delay).await;
        } else {
            tokio::time::sleep(std::time::Duration::from_secs(5)).await;
        }
    }
}

/// Runs one ManageSmbCert stream session. Returns `Ok(true)` when the handler
/// rejected the FIRST delivery (fatal — the loop must stop); `Ok(false)` on a
/// clean stream end; `Err` on a transport/protocol error (the loop retries).
async fn run_smb_cert_stream(
    conn_provider: Arc<ServiceConnection>,
    service_label: &str,
    instance_id: &str,
    handler: &Arc<dyn Handler>,
    token_provider: TokenProvider,
    ready_tx: &mut Option<tokio::sync::oneshot::Sender<Result<(), String>>>,
) -> Result<bool, Box<dyn std::error::Error>> {
    let (tx, rx) = tokio::sync::mpsc::channel::<smbcert_pb::SmbCertClientMsg>(4);

    let (private_key_der, public_key_der, pub_proto) = generate_key_and_proto()?;
    let mut active_private_key_der = private_key_der;
    let mut active_public_key_der = public_key_der;
    let mut pending_private_key_der: Option<Vec<u8>> = None;
    let mut pending_public_key_der: Option<Vec<u8>> = None;

    // Send Init message (identifies the SMB service + instance).
    tx.send(smbcert_pb::SmbCertClientMsg {
        msg: Some(smbcert_pb::smb_cert_client_msg::Msg::Init(smbcert_pb::SmbCertInit {
            smb_service: service_label.to_string(),
            instance_id: instance_id.to_string(),
        })),
    }).await.map_err(|e| format!("send Init: {}", e))?;

    // Send initial Csr (public key only — private key never leaves the process).
    tx.send(smbcert_pb::SmbCertClientMsg {
        msg: Some(smbcert_pb::smb_cert_client_msg::Msg::Csr(smbcert_pb::SmbCertCsr {
            public_key: Some(pub_proto),
        })),
    }).await.map_err(|e| format!("send Csr: {}", e))?;

    let conn = conn_provider.conn().await
        .ok_or("no active connection for ManageSmbCert")?;
    let mut client = SmbCertServiceClient::new(conn);
    let mut request = tonic::Request::new(tokio_stream::wrappers::ReceiverStream::new(rx));
    let token = (token_provider)().await
        .map_err(|e| format!("token provider failed for ManageSmbCert: {}", e))?;
    request.metadata_mut().insert(
        "authorization",
        format!("Bearer {}", token).parse()
            .map_err(|e| format!("invalid token for ManageSmbCert header: {}", e))?,
    );
    let response = client.manage_smb_cert(request).await?;
    let mut inbound = response.into_inner();

    while let Some(server_msg) = inbound.message().await? {
        match server_msg.msg {
            Some(smbcert_pb::smb_cert_server_msg::Msg::Cert(delivery)) => {
                let member_chain = match delivery.member_chain {
                    Some(c) => c,
                    None => continue,
                };
                let ca = match delivery.ca {
                    Some(c) => c,
                    None => continue,
                };
                let candidate_private_key_der = pending_private_key_der
                    .clone()
                    .unwrap_or_else(|| active_private_key_der.clone());
                let candidate_public_key_der = pending_public_key_der
                    .clone()
                    .unwrap_or_else(|| active_public_key_der.clone());
                if let Err(e) = cert_leaf_matches_public_key(&member_chain, &candidate_public_key_der) {
                    if ready_tx.is_some() {
                        return Err(format!("SMB member cert public key mismatch: {}", e).into());
                    }
                    tracing::error!("SMB member cert public key mismatch on renewal delivery, keeping previous credential: {}", e);
                    pending_private_key_der = None;
                    pending_public_key_der = None;
                    continue;
                }
                let result = handler
                    .new_smb_cert(&member_chain, &candidate_private_key_der, &ca)
                    .await;
                if let Some(tx) = ready_tx.take() {
                    // First delivery: report the outcome to run(). A handler
                    // failure here is fatal — the instance must not start without
                    // its SMB member credential.
                    match result {
                        Ok(()) => {
                            active_private_key_der = candidate_private_key_der;
                            active_public_key_der = candidate_public_key_der;
                            pending_private_key_der = None;
                            pending_public_key_der = None;
                            let _ = tx.send(Ok(()));
                        }
                        Err(e) => {
                            let _ = tx.send(Err(e.to_string()));
                            return Ok(true);
                        }
                    }
                } else if let Err(e) = result {
                    // Renewal delivery: keep using the previous credential.
                    tracing::error!("Handler new_smb_cert failed on renewal delivery, keeping previous credential: {}", e);
                    pending_private_key_der = None;
                    pending_public_key_der = None;
                } else {
                    active_private_key_der = candidate_private_key_der;
                    active_public_key_der = candidate_public_key_der;
                    pending_private_key_der = None;
                    pending_public_key_der = None;
                }
            }
            Some(smbcert_pb::smb_cert_server_msg::Msg::Renew(renew)) => {
                tracing::info!("SMB member cert renewal requested: {}", renew.reason);
                let (new_private_key_der, new_public_key_der, new_pub_proto) = generate_key_and_proto()?;
                pending_private_key_der = Some(new_private_key_der);
                pending_public_key_der = Some(new_public_key_der);
                tx.send(smbcert_pb::SmbCertClientMsg {
                    msg: Some(smbcert_pb::smb_cert_client_msg::Msg::Csr(smbcert_pb::SmbCertCsr {
                        public_key: Some(new_pub_proto),
                    })),
                }).await.map_err(|e| format!("send renewal Csr: {}", e))?;
            }
            Some(smbcert_pb::smb_cert_server_msg::Msg::Error(e)) => {
                return Err(format!("server error: {}", e).into());
            }
            None => {}
        }
    }
    Ok(false)
}
{{- end}}

{{- if or .HasAutoTls .HasSmb}}

fn generate_key_and_proto() -> Result<(Vec<u8>, Vec<u8>, key_pb::PublicKey), Box<dyn std::error::Error>> {
{{- if eq .AutoTlsKeyType "ecdsa"}}
    let signing_key = SigningKey::random(&mut OsRng);
    let private_key_der = signing_key.to_pkcs8_der()?.as_bytes().to_vec();
    let pub_spki_der = signing_key.verifying_key().to_public_key_der()?;
{{- else}}
    let signing_key = SigningKey::generate(&mut OsRng);
    let private_key_der = signing_key.to_pkcs8_der()?.as_bytes().to_vec();
    let verifying_key = signing_key.verifying_key();
    let pub_spki_der = verifying_key.to_public_key_der()?;
{{- end}}

    // PEM-encode the public key.
    let pub_pem = format!(
        "-----BEGIN PUBLIC KEY-----\n{}\n-----END PUBLIC KEY-----\n",
        base64::engine::general_purpose::STANDARD.encode(pub_spki_der.as_bytes())
    );
    let pub_base64 = base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(pub_pem.as_bytes());

    let now = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)?
        .as_secs() as i64;

    Ok((private_key_der, pub_spki_der.as_bytes().to_vec(), key_pb::PublicKey {
        id: format!("auto-tls-{}", now),
        base64: pub_base64,
        created: now,
    }))
}

fn cert_leaf_matches_public_key(
    chain: &x509_pb::X509CertChain,
    expected_der: &[u8],
) -> Result<(), Box<dyn std::error::Error>> {
    let leaf = chain.chain.first().ok_or("certificate chain is empty")?;
    if expected_der.is_empty() {
        return Err("expected public key is empty".into());
    }
    let leaf_der = cert_leaf_der(leaf)?;
    let cert = x509_cert::Certificate::from_der(&leaf_der)?;
    let cert_public_key_der = cert.tbs_certificate.subject_public_key_info.to_der()?;
    if cert_public_key_der.as_slice() != expected_der {
        return Err("leaf certificate public key does not match CSR public key".into());
    }
    Ok(())
}

fn cert_leaf_der(cert: &x509_pb::X509Cert) -> Result<Vec<u8>, Box<dyn std::error::Error>> {
    let raw = decode_cert_base64(&cert.base64)?;
    if raw.starts_with(b"-----BEGIN") {
        let pem_text = std::str::from_utf8(&raw)?;
        let body: String = pem_text
            .lines()
            .filter(|line| !line.starts_with("-----"))
            .collect();
        return Ok(base64::engine::general_purpose::STANDARD.decode(body.as_bytes())?);
    }
    Ok(raw)
}

fn decode_cert_base64(encoded: &str) -> Result<Vec<u8>, Box<dyn std::error::Error>> {
    if encoded.is_empty() {
        return Err("certificate base64 is empty".into());
    }
    base64::engine::general_purpose::URL_SAFE_NO_PAD.decode(encoded)
        .or_else(|_| base64::engine::general_purpose::URL_SAFE.decode(encoded))
        .or_else(|_| base64::engine::general_purpose::STANDARD_NO_PAD.decode(encoded))
        .or_else(|_| base64::engine::general_purpose::STANDARD.decode(encoded))
        .map_err(|_| "certificate base64 is invalid".into())
}
