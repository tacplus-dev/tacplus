                .setLevel({{.TypesBase}}.sys.logger.Logger.Level.LEVEL_DEBUG)
                .build();
            LogbackConfigurator.install(config);

            // Log through a real SLF4J logger — goes through Logback encoder.
            org.slf4j.Logger appLogger = LoggerFactory.getLogger("test.security");
            appLogger.debug("HEADERS: authorization: Bearer " + fakeToken);
            appLogger.debug("Cookie: session=" + fakeToken);
            appLogger.debug("x-auth-token: " + fakeToken);
            appLogger.debug("normal message — this should appear");

            System.err.flush();
            String output = captured.toString(StandardCharsets.UTF_8);

            mustPass("real log path: token not in output", !output.contains(fakeToken));
            mustPass("real log path: [REDACTED] in output", output.contains("[REDACTED]"));
            mustPass("real log path: non-sensitive preserved",
                output.contains("normal message"));
            mustPass("real log path: header key preserved",
                output.contains("authorization"));

        } finally {
            System.setErr(originalErr);
        }

        // ── Test 3: Defense-in-depth — framework loggers pinned ──

        LoggerContext loggerContext = (LoggerContext) LoggerFactory.getILoggerFactory();
        String[] frameworkLoggers = {
            "io.grpc.netty",
            "io.grpc.netty.shaded.io.grpc.netty",
