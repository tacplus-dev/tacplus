// the FIRST delivery is fatal; later renewal-delivery failures are log-and-continue.
	smbReadyCh := make(chan error, 1)
	sm.tasks.Go(func(taskCtx context.Context) {
	smbCertStreamLoop(taskCtx, func() grpc.ClientConnInterface { return sm.smbAuthorityConn.Conn() }, "{{.ServiceLabel}}", h, sm.TokenProviderFunc(), smbReadyCh)
	})
