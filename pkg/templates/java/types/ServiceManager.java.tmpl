        // already threw MissingTrustDomainException for an empty
        // spiffe_trust_domain before this ServiceManager was constructed, and
        // Spiffe.serviceSpiffeId rejects one too. Publishing an empty health
        // identity instead of failing would be the fail-open shape (NEW-21).
        String spiffeId = Spiffe.serviceSpiffeId(
                config.getSpiffeTrustDomain(), config.getLocationPath(), "{{.ServiceLabel}}");
