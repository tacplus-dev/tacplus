{{- if .HasServiceHealthState}}
    /// Resolves a service endpoint by querying ServiceHealthState for healthy instances.
    /// Retries with exponential backoff until a healthy instance is reachable.
    /// Never returns an error — retries indefinitely so callers never need to handle failure.
    pub async fn resolve_service(&self, service_name: &str) -> Channel {
        let mut backoff = std::time::Duration::from_secs(2);
        let max_backoff = std::time::Duration::from_secs(30);
        loop {
            let conn = match self.state_store_conn.conn().await {
                Some(c) => c,
                None => {
                    tracing::warn!(service = service_name, retry_in = ?backoff, "No state-store connection for service resolution, retrying");
                    tokio::time::sleep(backoff).await;
                    if backoff < max_backoff { backoff = std::cmp::min(backoff * 2, max_backoff); }
                    continue;
                }
            };
            let token = match self.identity.get_token().await.map_err(|e| e.to_string()) {
                Ok(t) => t,
                Err(e) => {
                    tracing::warn!(service = service_name, error = %e, retry_in = ?backoff, "Failed to get token for service resolution, retrying");
                    tokio::time::sleep(backoff).await;
                    if backoff < max_backoff { backoff = std::cmp::min(backoff * 2, max_backoff); }
                    continue;
                }
            };
            let mut client = ServiceHealthStateServiceClient::new(conn);
            let mut req = tonic::Request::new(
                crate::types::{{.HealthStateModPath}}::InstancesGetAllRequest { ..Default::default() }
            );
            let token_str = format!("Bearer {}", token);
            let token_meta = match token_str.parse() {
                Ok(m) => m,
                Err(_) => {
                    tracing::warn!(service = service_name, retry_in = ?backoff, "Invalid token metadata for service resolution, retrying");
                    tokio::time::sleep(backoff).await;
                    if backoff < max_backoff { backoff = std::cmp::min(backoff * 2, max_backoff); }
                    continue;
                }
            };
            req.metadata_mut().insert("authorization", token_meta);
            match client.get_all_instances(req).await {
                Ok(response) => {
                    let entries = response.into_inner().entries;
                    let mut channel_result: Option<Channel> = None;
                    for (_, health) in &entries {
                        if health.service_id == service_name
                            && health.status == InstanceStatus::Healthy as i32
                        {
                            if let Some(ep) = &health.grpc_endpoint {
                                if !ep.host.is_empty() && ep.port > 0 {
                                    let target = format!("{}:{}", ep.host, ep.port);
                                    tracing::info!(
                                        service = service_name,
                                        endpoint = %target,
                                        "Resolved service endpoint via health entries"
                                    );
                                    match self.create_channel(&target).await {
                                        Ok(ch) => { channel_result = Some(ch); break; }
                                        Err(e) => {
                                            tracing::warn!(
                                                service = service_name,
                                                endpoint = %target,
                                                error = %e,
                                                retry_in = ?backoff,
                                                "Failed to create channel to service, retrying"
                                            );
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if let Some(ch) = channel_result {
                        return ch;
                    }
                    tracing::warn!(
                        service = service_name,
                        retry_in = ?backoff,
                        "No healthy instance found for service, retrying"
                    );
                }
                Err(e) => {
                    tracing::warn!(
                        service = service_name,
                        error = %e,
                        retry_in = ?backoff,
                        "Failed to query ServiceHealthState, retrying"
                    );
                }
            }
            tokio::time::sleep(backoff).await;
            if backoff < max_backoff {
                backoff = std::cmp::min(backoff * 2, max_backoff);
            }
        }
    }
{{- end}}

    /// Releases all resources. Use when not calling run().
    pub fn close(&self) {
        if let Ok(mut tasks) = self.tasks.lock() {
            for task in tasks.drain(..) {
                task.abort();
            }
        };
{{- if .HasStates}}
        self.state_clients.close();
{{- end}}
        // state-store ServiceConnection drops naturally;
    }

{{- if .HasStates}}
    /// Returns the state client instances.
    pub fn state_clients(&self) -> &StateClients {
        &self.state_clients
    }
{{- end}}

{{- if .HasS2SClients}}
    /// Returns the S2S client hierarchy: sm.s2s().{target}().{client}()
    pub fn s2s(&self) -> &GrpcClients {
        &self.s2s
    }
{{- end}}

    /// Starts the service lifecycle with the given handler.
    ///
    /// Creates a TLS-enabled gRPC server using the auto-TLS cert already
    /// delivered by the certificate stream (started
    /// in `new()`), wraps handler implementations with validation/authorization,
    /// registers all services, and serves until shutdown signal.
	    pub async fn run(self: Arc<Self>, handler: Arc<dyn Handler>) -> Result<(), Box<dyn std::error::Error>> {
	        info!("ServiceManager starting");

{{- if .HasDiskStores}}
        self.start_disk_store_roll_schedulers(handler.clone())?;
{{- end}}

	        // Wrap handler implementations with validation and register services.
{{- range .GrpcServices}}
{{- if .IsGeneratedRecordC2S}}
        // The client-facing record read plane's handler is GENERATED, not
        // supplied: `Weak` rather than `Arc` because the manager owns the wrapper
        // that owns this handler, and an owning back-reference would close a
        // cycle that never drops.
        let {{.WrapperVar}} = {{.WrapperModPath}}::ValidationWrapper::new(
            std::sync::Arc::new(record_c2s::{{.GeneratedImplStruct}}::new(
                std::sync::Arc::downgrade(&self),
            )),
        );
{{- else}}
        let {{.WrapperVar}} = {{.WrapperModPath}}::ValidationWrapper::new(
            handler.{{.GetterName}}(),
        );
{{- end}}
        {{.WrapperVar}}.set_instance_id(self.instance_id().to_string()).await;
        {{.WrapperVar}}.set_anonymize_hmac_key(self.cfg.anonymize_hmac_key.clone()).await;
{{- end}}

{{- if .HasTlsGrpc}}
        // Create gRPC server with config-driven resource limits. TLS is applied
        // by `reloading_tls_incoming` below so the live listener uses renewed
        // auto-TLS certs without rebuilding the tonic server.
        let server = tonic::transport::Server::builder()
            .concurrency_limit_per_connection(
                if self.cfg.max_concurrent_streams > 0 { self.cfg.max_concurrent_streams as usize } else { 100 }
            );
        let max_recv_msg_size = if self.cfg.max_request_size > 0 {
            self.cfg.max_request_size as usize
        } else {
            10 * 1024 * 1024
        };
        let max_send_msg_size = if self.cfg.max_send_msg_size > 0 {
            self.cfg.max_send_msg_size as usize
        } else {
            16 * 1024 * 1024
        };

        // Register per-method auth_services patterns from proto annotations.
{{- range .GrpcServices}}
{{- if and .HasMethodAuth (not .IsC2D)}}
        {{.WrapperModPath}}::register_method_auth(&self.authorizer);
{{- end}}
{{- end}}

{{- if or .HasC2SGrpc .HasS2SGrpc}}
        // Wire the authorizer to every mandatory-auth wrapper — both C2S
        // (user-facing) and S2S (service-to-service). One authorizer handles
        // both: authorize_grpc checks C2S user tokens via service_entitlements
        // and S2S service tokens via the auth_services RE2 patterns registered
        // above. c2d services are excluded (local-socket IPC, no token auth).
        let auth_adapter = Arc::new(AuthorizerAdapter { authorizer: self.authorizer.clone() });
{{- range .GrpcServices}}
{{- if and (or .IsC2S .IsS2S) (not .AuthDisabled)}}
{{- if .AuthAnyUser}}
        {{.WrapperVar}}.set_authenticate_func(Some(auth_adapter.clone())).await;
{{- else}}
        {{.WrapperVar}}.set_authorize_func(Some(auth_adapter.clone())).await;
{{- end}}
{{- end}}
{{- end}}

        // Startup invariant (fail-fast): a None authorizer on a mandatory-auth
        // wrapper is a codegen/wiring bug, not a runtime condition. Assert every
        // such wrapper is wired before we serve; panic (crashloop) instead of
        // silently returning a per-request 500 (gray failure) on every call.
{{- range .GrpcServices}}
{{- if and (or .IsC2S .IsS2S) (not .AuthDisabled)}}
        if !{{.WrapperVar}}.has_authorizer().await {
            panic!("authorizer not wired for {{.TraitName}} (build/SM bug) — mandatory-auth service cannot serve without an authorizer");
        }
{{- end}}
{{- end}}
{{- end}}

        // Wire a model-declared trace publisher to all wrappers. Services that
        // publish TraceEvent must declare the corresponding event_publish topic.
{{- if .HasServiceHealthState}}
{{- if .TracePublisherFn}}
        {
            let publisher = self.{{.TracePublisherFn}}().await;
            let trace_publisher = Arc::new(move |event| {
                if publisher(event).is_err() {
                    tracing::warn!("trace publisher queue full, dropping trace event");
                }
            });
{{- range .GrpcServices}}
            {{.WrapperVar}}.set_trace_publisher(trace_publisher.clone()).await;
{{- end}}
        }
{{- end}}
{{- end}}

{{- if and .HasServiceHealthState .AccountingPublisher}}
        // Wire the durable accounting emitter to every wrapper. The wrapper emit
        // sites already exist on both the success and the error path of every
        // accounted RPC; without this the slot is None and accounting produces
        // neither a record nor a log line.
        //
        // The sink's send is BLOCKING, not try-send-and-drop, unlike the trace
        // publisher above — see EventBusSink's send contract in chassis/am.
        {
            let accounting_tx = self.create_accounting_publisher_sender().await;
            let source_id = format!("{}-{}", "{{.ServiceLabel}}", self.instance_id());
            let emitter = Arc::new(am::Emitter::new(
                source_id.clone(),
                Box::new(am::EventBusSink::new(accounting_tx, source_id)),
            ));
{{- range .GrpcServices}}
            {{.WrapperVar}}.set_emitter(Some(emitter.clone())).await;
{{- end}}
        }
{{- end}}

{{- if .HasStates}}
        // Deliver initial per-service typed config from state and register hot-reload.
        // One fetch per ConfigState, shared by every handler that reads it: the read
        // is identical, and one fetch per handler bursts past the state store's
        // per-(peer, method) polling rate limit at startup.
	{{- range .ConfigFetches}}
	        {
	            let accessor = self.state_clients.{{.ConfigStateGroupAccessor}}().{{.ConfigStateAccessor}}();
	            let mut initial_cfg = accessor.config().fetch().await
	                .map_err(|e| -> Box<dyn std::error::Error> {
	                    format!("fetch initial {{.ConfigStateAccessor}} config: {}", e).into()
	                })?;
	            // Apply the proto-declared field defaults. Kernel seeds config state
	            // from the deploy bundle, which carries only what the operator was
	            // given -- a field the bundle omits arrives ZERO, not defaulted. The
	            // generated config_defaults exists for exactly this and was never
	            // called on the delivery path, so `[(spec.default_string) = "..."]`
	            // silently had no effect at runtime.
	            {{.ConfigHelpersModPath}}::config_defaults(&mut initial_cfg);
	{{- range .Handlers}}
	            handler.{{.HandleConfigName}}(&initial_cfg).await
	                .map_err(|e| -> Box<dyn std::error::Error> {
	                    format!("initial {{.TraitName}} config: {}", e).into()
	                })?;
	{{- end}}
	            let handler_for_cfg = handler.clone();
                let tasks_for_cfg = self.tasks.clone();
	            accessor.config().on_change(Arc::new(move |cfg: &{{.ConfigAliasType}}| {
	                let h = handler_for_cfg.clone();
                let task_registry = tasks_for_cfg.clone();
                let mut c = cfg.clone();
                // Same on hot-reload: a pushed config is defaulted before delivery.
                {{.ConfigHelpersModPath}}::config_defaults(&mut c);
	{{- range .Handlers}}
                {
                    let h = h.clone();
                    let c = c.clone();
                    let handle = tokio::spawn(async move {
                        if let Err(e) = h.{{.HandleConfigName}}(&c).await {
                            tracing::error!(error = %e, "{{.HandleConfigName}} failed on config change");
                        }
                    });
                    if let Ok(mut tasks) = task_registry.lock() {
                        tasks.push(handle);
                    };
                }
	{{- end}}
            }));
        }
{{- end}}
{{- end}}

        // Use the health reporter created in new() — already bound to the
        // plaintext probe listener. Create a new HealthService from the same
        // reporter for the TLS router; they share internal Arc state so status
        // changes are visible on both listeners simultaneously.
        let grpc_health = self.grpc_health.clone();
        let grpc_health_svc = tonic_health::pb::health_server::HealthServer::new(
            tonic_health::server::HealthService::from_health_reporter(self.grpc_health.clone()),
        );

        // Enforce token authentication (signature + audience) on all server
        // routes via a tower layer. Generated services already have per-method
        // auth wrappers so this is defence-in-depth for them, but it is the
        // PRIMARY auth gate for handler-provided additional_services routes
        // that lack generated wrappers. Fail-closed: missing, invalid, or
        // wrong-audience tokens are rejected before the handler runs. Health
        // check paths (/grpc.health.v1.Health/) are exempt (unauthenticated
        // by design). Parity with go AuthEnforcingRegistrar / java
        // ServerInterceptors.intercept(svc, authorizer.enforcingInterceptor()).
        // Methods declared auth_disabled must bypass this layer. It runs before
        // the per-method wrappers and rejects anything without an authorization
        // header, so without this list the annotation is honoured by the gateway
        // and silently ignored by the service -- which makes the login bootstrap
        // (ListProviders/Authorize/MintCallbackTokens) impossible.
        let auth_exempt_paths: Vec<String> = vec![
{{- range .GrpcServices}}
{{- range .AuthExemptPaths}}
            "{{.}}".to_string(),
{{- end}}
{{- end}}
        ];
        let mut server = server.layer(AuthEnforcingLayer::with_exempt_paths(
            self.authorizer.clone(),
            auth_exempt_paths,
        ));

        // Build router: if handler provides additional services, start from those routes
        // (Server::add_routes), then chain our services (Router::add_service).
        // Router doesn't have add_routes, so additional routes must go first.
        // c2d services are excluded — they run on a separate unix socket server.
        let router = if let Some(additional_routes) = handler.additional_services() {
            server.add_routes(additional_routes)
                .add_service(grpc_health_svc)
{{- range .GrpcServices}}
{{- if not .IsC2D}}
                .add_service(
                    {{.TypesBasePath}}::{{.ServerModName}}::{{.ServerType}}::new(
                        {{.WrapperVar}}.clone(),
                    )
                    .max_decoding_message_size(max_recv_msg_size)
                    .max_encoding_message_size(max_send_msg_size),
                )
{{- end}}
{{- end}}
        } else {
            server
                .add_service(grpc_health_svc)
{{- range .GrpcServices}}
{{- if not .IsC2D}}
                .add_service(
                    {{.TypesBasePath}}::{{.ServerModName}}::{{.ServerType}}::new(
                        {{.WrapperVar}}.clone(),
                    )
                    .max_decoding_message_size(max_recv_msg_size)
                    .max_encoding_message_size(max_send_msg_size),
                )
{{- end}}
{{- end}}
        };

        // Determine listen address from config (default [::]:8443).
        let listen_addr = match self.cfg.listen_address.as_ref() {
            Some(h) => {
                let host = if h.host.is_empty() { "::" } else { &h.host };
                let port = if h.port == 0 { 8443 } else { h.port };
                if host.contains(':') {
                    format!("[{}]:{}", host, port)
                } else {
                    format!("{}:{}", host, port)
                }
            }
            None => "[::]:8443".to_string(),
        };
        let addr: std::net::SocketAddr = listen_addr.parse()?;
        let incoming = reloading_tls_incoming(addr, self.tls_server_certified_key.clone()).await?;
        info!(addr = %addr, "gRPC server listening (TLS)");
{{- end}}

{{- if .HasServiceHealthState}}
        // Start health reporter — publishes instance health to ServiceHealthState.
        let health_conn = {
            let mut attempt = 0u32;
            loop {
                if let Some(conn) = self.state_store_conn.conn().await {
                    break conn;
                }
                attempt += 1;
                if attempt >= MAX_INIT_RETRIES {
                    return Err("no active state-store connection for health reporter after max retries".into());
                }
                tracing::warn!(attempt, max = MAX_INIT_RETRIES, "no active state-store connection for health reporter, retrying in 2s");
                tokio::time::sleep(std::time::Duration::from_secs(2)).await;
            }
        };
        let health_client = ServiceHealthStateServiceClient::new(health_conn);
        let publisher = HealthPublisherAdapter {
            client: Arc::new(tokio::sync::Mutex::new(health_client)),
            token_provider: self.token_provider(),
        };
        let metrics = build_metrics_provider(&self.cfg.listen_address);
        // Health identity is the full location-bearing service SPIFFE ID, built
        // by this service's own manager from runtime config via the canonical helper.
        // No empty-trust-domain tolerance: new() already failed loudly on an empty
        // spiffe_trust_domain when it built the SPIFFE verifier, so run() cannot be
        // reached with one, and service_spiffe_id rejects it too. Publishing an empty
        // health identity instead of failing would be the fail-open shape (NEW-21).
        let spiffe_id = spiffe::service_spiffe_id(&self.cfg.spiffe_trust_domain, &self.cfg.location_path, "{{.ServiceLabel}}")
            .map_err(|e| -> Box<dyn std::error::Error> { format!("building service SPIFFE identity: {}", e).into() })?;
        let (first_health_tx, first_health_rx) = tokio::sync::oneshot::channel();
        let health_reporter = Arc::new(HealthReporter::new_with_ready_and_status(
            publisher,
            metrics,
            spiffe_id,
            Some(first_health_tx),
            InstanceStatus::Healthy,
        ));
        health_reporter.set_health_checker(Arc::new(HandlerHealthChecker(handler.clone())));
{{- if .HasTypedHealth}}
        health_reporter.set_typed_health_collector(Arc::new(HandlerTypedHealthCollector(handler.clone())));
{{- end}}
        // PC-L-1: TLS renewal give-up / parse failures degrade this instance in the
        // fleet health plane instead of being Error-log-only.
        {
            let hr = health_reporter.clone();
            on_tls_degraded(&self.tls_degrade, move |reason| {
                tracing::warn!(reason = reason, "marking instance DEGRADED: TLS renewal failure");
                hr.set_status(InstanceStatus::Degraded);
            });
        }
        match first_health_rx.await {
            Ok(Ok(())) => {}
            Ok(Err(e)) => return Err(format!("first health publish: {}", e).into()),
            Err(_) => return Err("health reporter stopped before first successful publish".into()),
        }
	{{- if and .HasServiceHealthState (or .HasS2SClients .HasSmb)}}

	        // Start health poller — polls ServiceHealthState every 5s to reconcile
	        // dynamic ServiceConnection endpoints for S2S and SMB-authority communication.
	        // State-store connections use static endpoints (from config) and don't need this.
	        {
            let health_identity = self.identity.clone();
            let health_conn = self.state_store_conn.conn().await;
            let state_store_endpoints = self.cfg.endpoints.clone();
            // Collect all ServiceConnection refs for the health poller.
            let service_conns: Vec<Arc<ServiceConnection>> = vec![
	                self.state_store_conn.clone(),
	{{- range .TargetServices}}
	{{- if ne .ServiceID $.StateStoreServiceID}}
	                self.{{.AccessorName}}_conn.clone(),
	{{- end}}
	{{- end}}
	{{- if .HasSmb}}
	                self.smb_authority_conn.clone(),
	{{- end}}
	            ];
            if !service_conns.is_empty() {
                self.spawn_owned(async move {
                    let interval = std::time::Duration::from_secs(5);
                    let Some(conn) = health_conn else {
                        tracing::warn!("health poller: no state-store connection");
                        return;
                    };
                    loop {
                        if let Some(token) = health_identity.get_token().await.ok() {
                            let mut client = ServiceHealthStateServiceClient::new(conn.clone());
                            let mut req = tonic::Request::new(
                                crate::types::{{.HealthStateModPath}}::InstancesGetAllRequest { ..Default::default() }
                            );
                            if let Ok(val) = format!("Bearer {}", token).parse() {
                                req.metadata_mut().insert("authorization", val);
                            }
                            match client.get_all_instances(req).await {
                                Ok(response) => {
                                    let entries = response.into_inner().entries;
                                    let mut instances: Vec<ServiceInstanceHealth> =
                                        entries.into_values().collect();
                                    // The state-store service may not self-register via SetInstances,
                                    // so inject its static endpoints from config.
                                    for ep in &state_store_endpoints {
                                        instances.push(ServiceInstanceHealth {
                                            service_id: "{{.StateStoreServiceID}}".to_string(),
                                            grpc_endpoint: Some(ep.clone()),
                                            status: InstanceStatus::Healthy as i32,
                                            ..Default::default()
                                        });
                                    }
                                    // Fan out to each ServiceConnection.
                                    for sc in &service_conns {
                                        let relevant: Vec<&ServiceInstanceHealth> = instances.iter()
                                            .filter(|i| i.service_id == sc.service_id())
                                            .collect();
                                        if !relevant.is_empty() {
                                            sc.reconcile_from_health(&relevant).await;
                                        }
                                    }
                                }
                                Err(e) => {
                                    tracing::warn!(error = %e, "health poll failed");
                                }
                            }
                        }
                        tokio::time::sleep(interval).await;
                    }
                });
            }
        }
{{- end}}
{{- end}}

{{- if .HasAutoTls}}
        // Register the user handler with the auto-TLS stream that was started in new().
        // The first cert was delivered before run() had a handler. Replay that
        // accepted cert/key now so first-delivery handler failure is still fatal
        // before the service starts serving. Setting the slot then enables
        // `new_tls_cert` callbacks on renewals.
        let initial_tls_chain = self.tls_cert_chain_proto.read().await.clone()
            .ok_or("ServiceManager TLS cert chain not available — auto-TLS stream did not deliver")?;
        let initial_tls_key = self.tls_private_key_der.read().await.clone()
            .ok_or("ServiceManager TLS private key not available — auto-TLS stream did not deliver")?;
        handler.new_tls_cert(&initial_tls_chain, &initial_tls_key).await
            .map_err(|e| format!("handler new_tls_cert failed on initial delivery: {}", e))?;
        *self.tls_handler_slot.write().await = Some(handler.clone());
{{- end}}

{{- if .HasSmb}}
        // Start the SMB member-cert stream (SPIFFE plan D7). Blocks until the
        // first member credential is delivered to the handler — an SMB member
        // cannot join its black-box peer mesh without its per-SMB CA + member
        // cert. A handler failure on the FIRST delivery is fatal (run returns an
        // error); later renewal-delivery failures are log-and-continue.
        {
            let (smb_ready_tx, smb_ready_rx) = tokio::sync::oneshot::channel::<Result<(), String>>();
	            let smb_conn = self.smb_authority_conn.clone();
            let smb_tp: TokenProvider = {
                let im = self.identity.clone();
                Arc::new(move || {
                    let im = im.clone();
                    Box::pin(async move {
                        im.get_token().await.map_err(|e| -> Box<dyn std::error::Error + Send + Sync> { e.to_string().into() })
                    })
                })
            };
            let smb_service_label = "{{.ServiceLabel}}".to_string();
            let smb_instance_id = self.identity.instance_id().to_string();
            let smb_handler = handler.clone();
            let smb_handle = tokio::spawn(async move {
                smb_cert_stream_loop(
                    smb_conn, smb_service_label, smb_instance_id, smb_handler,
                    smb_tp, Some(smb_ready_tx),
                ).await;
            });
            match smb_ready_rx.await {
                Ok(Ok(())) => {}
                Ok(Err(e)) => return Err(format!("first SMB member cert delivery: {}", e).into()),
                Err(_) => return Err("SMB member-cert stream failed to deliver initial credential".into()),
            }
            self.tasks.lock().unwrap().push(smb_handle);
        }
{{- end}}

{{- if .HasSubscriptions}}
        // Start event-bus subscriptions — resolve target service via ServiceHealthState.
        // Subscriptions run in background tasks and retry independently; they never block run().
        let (sub_cancel_tx, _sub_cancel_rx) = tokio::sync::watch::channel(false);
        let mut sub_handles: Vec<tokio::task::JoinHandle<()>> = Vec::new();
{{- range .Subscriptions}}
        {
            let sub_sm = self.clone();
            let sub_handler = handler.clone();
            let mut cancel_rx = sub_cancel_tx.subscribe();
            sub_handles.push(tokio::spawn(async move {
                let handler_fn: subscribe::{{.SubscriberMod}}::Handler = {
                    let h = sub_handler;
                    std::sync::Arc::new(move |event, meta| {
                        let h = h.clone();
                        Box::pin(async move { h.{{.HandlerMethodName}}(event, meta).await })
                            as std::pin::Pin<Box<dyn std::future::Future<Output = Result<(), Box<dyn std::error::Error + Send + Sync>>> + Send>>
                    })
                };
                // Audience-scoped bearer token for the Subscribe stream, minted
                // fresh by the subscriber on every (re)connect attempt.
                let sub_im = sub_sm.identity.clone();
                let sub_token_source: subscribe::{{.SubscriberMod}}::TokenSource = std::sync::Arc::new(move || {
                    let im = sub_im.clone();
                    Box::pin(async move {
                        im.get_token_for("{{.TargetService}}").await.map_err(|e| -> Box<dyn std::error::Error + Send + Sync> {
                            e.to_string().into()
                        })
                    })
                });
                // Capped backoff for the outer resolve→subscribe loop:
                // subscribe() returns only on non-retryable errors, so
                // re-resolving immediately would hot-spin at RPC rate.
                const SUB_MIN_BACKOFF: std::time::Duration = std::time::Duration::from_secs(1);
                const SUB_MAX_BACKOFF: std::time::Duration = std::time::Duration::from_secs(30);
                let mut outer_backoff = SUB_MIN_BACKOFF;
                loop {
                    // resolve_service retries internally until a healthy instance is reachable.
                    // It never returns an error — it returns Channel directly.
                    let sub_conn = tokio::select! {
                        biased;
                        _ = cancel_rx.changed() => {
                            tracing::info!("{{.SourcePackage}}.{{.FieldSnake}} subscription cancelled");
                            return;
                        }
                        conn = sub_sm.resolve_service("{{.TargetService}}") => conn,
                    };
                    let subscriber = subscribe::{{.SubscriberMod}}::Subscriber::new(
                        sub_conn,
                        "{{$.ServiceLabel}}",
                        sub_token_source.clone(),
                    );
                    let sub_started = std::time::Instant::now();
                    tokio::select! {
                        biased;
                        _ = cancel_rx.changed() => {
                            tracing::info!("{{.SourcePackage}}.{{.FieldSnake}} subscription cancelled");
                            return;
                        }
                        _ = subscriber.subscribe(handler_fn.clone()) => {
                            tracing::warn!("{{.SourcePackage}}.{{.FieldSnake}} subscription ended, reconnecting");
                        }
                    }
                    // A subscription that ran for a while was healthy — reset the backoff.
                    if sub_started.elapsed() >= std::time::Duration::from_secs(60) {
                        outer_backoff = SUB_MIN_BACKOFF;
                    }
                    tokio::select! {
                        biased;
                        _ = cancel_rx.changed() => {
                            tracing::info!("{{.SourcePackage}}.{{.FieldSnake}} subscription cancelled");
                            return;
                        }
                        _ = tokio::time::sleep(outer_backoff) => {}
                    }
                    outer_backoff = std::cmp::min(outer_backoff * 2, SUB_MAX_BACKOFF);
                }
            }));
        }
{{- end}}
{{- end}}

{{- if .HasC2DGrpc}}
        // Start c2d unix socket server for local daemon IPC services.
        // No TLS, no auth — filesystem permissions guard access.
        #[cfg(unix)]
        {
            // Socket path is declared per-service via spec.service_c2d.socket_path
            // (required — no default, which would collide between daemons).
            let socket_path = std::path::PathBuf::from("{{.C2DSocketPath}}");
            // Build tonic Routes from c2d service implementations.
            let c2d_routes = tonic::service::Routes::new(tonic_health::server::health_reporter().1)
{{- range .GrpcServices}}
{{- if .IsC2D}}
                .add_service(
                    {{.TypesBasePath}}::{{.ServerModName}}::{{.ServerType}}::new(
                        {{.WrapperVar}}.clone(),
                    ),
                )
{{- end}}
{{- end}}
            ;
            let c2d_router = tonic::transport::Server::builder()
                .add_routes(c2d_routes);
            let c2d_server = C2dServer::new(socket_path).router(c2d_router);
            self.spawn_owned(async move {
                if let Err(e) = c2d_server.serve().await {
                    tracing::error!(error = %e, "c2d server failed");
                }
            });
        }
{{- end}}

{{- if .HasTlsGrpc}}
        // Bootstrap complete (first health publish{{if .HasAutoTls}} + TLS cert{{end}}{{if .HasSmb}} + SMB member cert{{end}}):
        // advertise SERVING on the gRPC health endpoint so k8s readiness probes pass.
        grpc_health.set_service_status("", tonic_health::ServingStatus::Serving).await;

{{- if .HasServiceHealthState}}
        // Bridge ongoing health evaluation to the gRPC health endpoint: a handler
        // reporting UNHEALTHY flips the endpoint to NOT_SERVING so k8s removes the
        // pod from load-balancer rotation. Recovery flips it back to SERVING.
        //
        // Credential health is a chassis FLOOR, not a service concern: a service
        // must not be able to report itself healthy while its credentials are
        // being rejected and re-minting is not helping. Readiness previously
        // stayed 1/1 Ready through a total auth outage because the probe only
        // asked whether the process was listening.
        health_reporter.set_degraded_probe(std::sync::Arc::new(|| {
            service_im::credentials_degraded()
        }));

        {
            let grpc_health_sink = grpc_health.clone();
            health_reporter.set_status_sink(std::sync::Arc::new(move |status: InstanceStatus| {
                let gh = grpc_health_sink.clone();
                let serving = if status == InstanceStatus::Unhealthy {
                    tonic_health::ServingStatus::NotServing
                } else {
                    tonic_health::ServingStatus::Serving
                };
                tokio::spawn(async move {
                    gh.set_service_status("", serving).await;
                });
            }));
        }
{{- end}}

        // Serve until shutdown signal (SIGINT or SIGTERM).
        router
            .serve_with_incoming_shutdown(incoming, async {
                shutdown_signal().await;
                info!("Shutdown signal received");
            })
            .await?;
{{- else if .HasC2DGrpc}}
        // c2d-only service — no TLS server. Wait for shutdown signal (SIGINT or SIGTERM).
        shutdown_signal().await;
        info!("Shutdown signal received");
{{- else}}
        // No tacplus-generated business gRPC services. Start a TLS server that
        // still serves the standard health check, plus any routes the handler
        // supplies via additional_services() (e.g. a hand-written tonic service
        // or a generated EventBus publisher endpoint). Dropping those routes
        // here would silently strip a service whose only gRPC surface is
        // handler-provided — matches the full-server branch above.
        // Bootstrap (first health publish{{if .HasSmb}} + SMB member cert{{end}}) already
        // completed above, so this health-only listener comes up SERVING — readiness
        // reflects actual readiness because the endpoint isn't reachable until serve().
        // Use the health reporter created in new() — already bound to the probe listener.
        let grpc_health = self.grpc_health.clone();
        let grpc_health_svc = tonic_health::pb::health_server::HealthServer::new(
            tonic_health::server::HealthService::from_health_reporter(self.grpc_health.clone()),
        );
        // Health-only path: bootstrap already completed, flip to SERVING immediately.
        grpc_health.set_service_status("", tonic_health::ServingStatus::Serving).await;

{{- if .HasServiceHealthState}}
        // Bridge ongoing health evaluation to the gRPC health endpoint (health-only server).
        {
            let grpc_health_sink = grpc_health.clone();
            health_reporter.set_status_sink(std::sync::Arc::new(move |status: InstanceStatus| {
                let gh = grpc_health_sink.clone();
                let serving = if status == InstanceStatus::Unhealthy {
                    tonic_health::ServingStatus::NotServing
                } else {
                    tonic_health::ServingStatus::Serving
                };
                tokio::spawn(async move {
                    gh.set_service_status("", serving).await;
                });
            }));
        }
{{- end}}

        let listen_addr = match self.cfg.listen_address.as_ref() {
            Some(h) => {
                let host = if h.host.is_empty() { "::" } else { &h.host };
                let port = if h.port == 0 { 8443 } else { h.port };
                if host.contains(':') {
                    format!("[{}]:{}", host, port)
                } else {
                    format!("{}:{}", host, port)
                }
            }
            None => "[::]:8443".to_string(),
        };
        let addr: std::net::SocketAddr = listen_addr.parse()?;
        let incoming = reloading_tls_incoming(addr, self.tls_server_certified_key.clone()).await?;

        let mut server = tonic::transport::Server::builder();
        // This build declares no tacplus gRPC services, so no authorizer was
        // constructed (it needs the state-store connection and token provider
        // that only the service plane sets up). There is therefore nothing to
        // enforce with, and serving handler-provided routes here would expose
        // them unauthenticated on the TLS port. Fail closed instead of serving
        // them: the full-server branch layers AuthEnforcingLayer over exactly
        // these routes, and a health-only build must not be the quiet way to
        // opt out of that.
        if handler.additional_services().is_some() {
            return Err(
                "handler supplied additional_services() but this build has no tacplus gRPC \
                 services, so no authorizer exists to enforce auth on them; declare the service \
                 in the proto spec (spec.vservice) so tacplus generates the auth plane"
                    .into(),
            );
        }
        info!(addr = %addr, "health-only gRPC server listening (TLS)");
        let router = server.add_service(grpc_health_svc);
        router
            .serve_with_incoming_shutdown(incoming, async {
                shutdown_signal().await;
                info!("Shutdown signal received");
            })
            .await?;
{{- end}}

        info!("Starting graceful shutdown");
{{- if .HasStates}}
        self.state_clients.close();
{{- end}}
{{- if .HasServiceHealthState}}
        health_reporter.close();
{{- end}}
{{- if .HasSubscriptions}}
        let _ = sub_cancel_tx.send(true);
        for handle in sub_handles {
            let _ = handle.await;
        }
{{- end}}

        // Configurable shutdown timeout from config (default already applied by config_defaults).
        let timeout_secs = if self.cfg.shutdown_timeout_seconds > 0 {
            self.cfg.shutdown_timeout_seconds as u64
        } else {
            30
        };

        tokio::select! {
            _ = handler.shutdown() => {
                info!("Graceful shutdown complete");
            }
            _ = tokio::time::sleep(std::time::Duration::from_secs(timeout_secs)) => {
                tracing::warn!(timeout_secs, "Shutdown timeout expired, exiting");
            }
            _ = shutdown_signal() => {
                info!("Second signal received, forcing exit");
            }
        }

        self.shutdown_owned_tasks().await;
        // state-store ServiceConnection drops naturally;
        Ok(())
    }
}
