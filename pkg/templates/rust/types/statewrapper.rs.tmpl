                {{.FieldName}}_subscribers: Vec::new(),
{{- end}}
{{- range .StateImports}}
                {{.FieldName}}_cache: None,
{{- end}}
            }),
            channel,
            stub: tokio::sync::Mutex::new(stub),
            token_provider,
            closed: AtomicBool::new(false),
            close_notify: tokio::sync::Notify::new(),
{{- if .Singletons}}
            config_fetch_timeout_secs: AtomicU64::new(30),
{{- end}}
{{- if $hasWatches}}
            watch_statuses: RwLock::new(HashMap::new()),
            watch_status_listener: RwLock::new(None),
{{- end}}
        });

        // Spawn per-boundary Watch stream receivers.
{{- range .Singletons}}
        {
            let inner = inner.clone();
            tokio::spawn(async move {
                inner.watch_{{.FieldName}}_loop().await;
            });
        }
{{- end}}
{{- range .Collections}}
        {
            let inner = inner.clone();
            tokio::spawn(async move {
                inner.watch_{{.FieldName}}_loop().await;
            });
        }
{{- end}}
{{- range .StateImports}}
        {
            let inner = inner.clone();
            tokio::spawn(async move {
                inner.watch_{{.FieldName}}_loop().await;
            });
        }
{{- end}}

        Ok(Self { inner })
    }

