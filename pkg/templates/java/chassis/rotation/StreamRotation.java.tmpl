                    Object item = leg.inbox.take();
                    if (item instanceof End end) {
                        Status.Code c = end.status.getCode();
                        if (c == Status.Code.OK || c == Status.Code.UNKNOWN) {
                            c = Status.Code.CANCELLED;
                        }
                        fault("leg ended without last (" + end.status.getCode() + ")", c);
                        return;
                    }
                    Envelope e = (Envelope) item;
                    if (malformed(e) || (finRecv && isMessage(e))) {
                        fault("malformed envelope", Status.Code.INVALID_ARGUMENT);
                        return;
                    }
                    if (isMessage(e)) {
                        ReqT msg;
                        try {
                            msg = def.getMethodDescriptor().parseRequest(e.getPayload().newInput());
                        } catch (RuntimeException ex) {
                            fault("unmarshal: " + ex.getMessage(), Status.Code.INTERNAL);
                            return;
                        }
                        credits.take();
                        if (done.get()) {
                            return;
                        }
                        if (first == null) {
                            first = msg;
                        }
                        deliver(deliverCtx, l -> l.onMessage(msg));
                    }
                    if (e.getFin() && !finRecv) {
                        finRecv = true;
                        deliver(deliverCtx, ServerCall.Listener::onHalfClose);
                    }
                    if (e.getLast()) {
                        SLeg next = nextLeg;
                        if (next == null) {
                            fault("last with no leg to cut over to", Status.Code.INVALID_ARGUMENT);
                            return;
                        }
                        readLeg = next;
                        cutOver(next);
                        next.request();
                    } else {
                        leg.request();
                    }
                }
            } catch (InterruptedException e) {
                // fault() or end() interrupts the reader; nothing more to do.
            }
        }

        /** Moves the sends to {@code next}: last on the old leg, which then ends OK. */
        private void cutOver(SLeg next) {
            synchronized (sendLock) {
                SLeg old = sendLeg;
                old.send(LAST);
                old.finish(Status.OK, new Metadata());
                sendLeg = next;
                deliverCtx = logical.withValue(Authorizer.AUTH_HEADER_CTX_KEY, next.authHeader);
            }
            synchronized (this) {
                if (nextLeg == next) {
                    nextLeg = null;
                }
                rotating = false;
            }
            onReady(next);
        }

        /** Attaches a rotation's leg, when the session is live and has none pending. */
        synchronized boolean attach(SLeg leg) {
            if (done.get() || rotating) {
                return false;
            }
            rotating = true;
            nextLeg = leg;
            // fault() sets done before it reads nextLeg: one of the two sees the other.
            if (done.get()) {
                nextLeg = null;
                rotating = false;
                return false;
            }
            return true;
        }

        /** A pending rotation's leg ended before its cutover: the session goes on, and may take another. */
        synchronized void detach(SLeg leg) {
            if (nextLeg == leg) {
                nextLeg = null;
                rotating = false;
            }
        }

        /**
         * A leg's Context ended. A pending rotation just goes away, a leg
         * already cut over is done; any other leg ending without its last is a
         * fault.
         */
        void legGone(SLeg leg, Throwable cause) {
            if (nextLeg == leg) {
                leg.markGone();
                detach(leg);
                return;
            }
            if (leg.markGone()) {
                return;
            }
            Status.Code code = Status.Code.CANCELLED;
            if (cause instanceof TimeoutException) {
                code = Status.Code.DEADLINE_EXCEEDED;
            } else if (cause != null) {
                Status.Code c = Status.fromThrowable(cause).getCode();
                if (c != Status.Code.OK && c != Status.Code.UNKNOWN) {
                    code = c;
                }
            }
            fault("a leg ended without last", code);
        }

        void onReady(SLeg leg) {
            boolean current;
            synchronized (sendLock) {
                current = sendLeg == leg;
            }
            if (current) {
                deliver(deliverCtx, ServerCall.Listener::onReady);
            }
        }

        /** The handler closed the call: its status ends the send leg; every other leg ends. */
        void end(Status status, Metadata trailers) {
            if (!done.compareAndSet(false, true)) {
                return;
            }
            registry.forget(this);
            deadStatus = Status.CANCELLED.withDescription("the stream has ended");
            SLeg send;
            synchronized (sendLock) {
                send = sendLeg;
            }
            if (status.getCode() == Status.Code.UNAUTHENTICATED || status.getCode() == Status.Code.PERMISSION_DENIED) {
                // The status goes out with no description; the reason stays here.
                LOG.info("rotation: stream of {} refused: {}", method, status);
            }
            send.finish(wireStatus(status), trailers);
            for (SLeg l : new SLeg[] {readLeg, nextLeg}) {
                if (l != null && l != send) {
                    l.finish(Status.CANCELLED, new Metadata());
                }
            }
            interruptReader();
            serial.execute(() -> {
                ServerCall.Listener<ReqT> l = listener;
                try {
                    if (l != null) {
                        logical.run(l::onComplete);
                    }
                } finally {
                    logical.cancel(null);
                }
            });
        }

        /** Ends the logical stream: the handler's Context is cancelled with the cause, every leg ends. */
        void fault(String reason, Status.Code code) {
            if (!done.compareAndSet(false, true)) {
                return;
            }
            registry.forget(this);
            LOG.info("rotation: stream of {} ended ({}): {}", method, code, reason);
            Status cause = Status.fromCode(code).withDescription("rotation: " + reason);
            deadStatus = cause;
            cancelled = true;
            SLeg send;
            synchronized (sendLock) {
                send = sendLeg;
            }
            for (SLeg l : new SLeg[] {send, readLeg, nextLeg}) {
                if (l != null) {
                    l.finish(Status.fromCode(code), new Metadata());
                }
            }
            interruptReader();
            logical.cancel(cause.asRuntimeException());
            serial.execute(() -> {
                ServerCall.Listener<ReqT> l = listener;
                if (l != null) {
                    logical.run(l::onCancel);
                }
            });
        }

        private void interruptReader() {
            Thread r = reader;
            if (r != null && r != Thread.currentThread()) {
                r.interrupt();
            }
        }

        private Status endedStatus() {
            Status s = deadStatus;
            return s == null ? Status.CANCELLED.withDescription("the stream has ended") : s;
        }

        /** The ServerCall the handler sees, for its whole life. */
        final class LogicalServerCall extends ServerCall<ReqT, RespT> {
            @Override
            public void request(int numMessages) {
                credits.grant(numMessages);
            }

            @Override
            public void sendHeaders(Metadata headers) {
                // Headers went out when the opening leg was attached.
            }

            @Override
            public void sendMessage(RespT message) {
                ByteString b = serialize(message, def.getMethodDescriptor().getResponseMarshaller());
                Envelope e = Envelope.newBuilder().setPayload(b).build();
                synchronized (sendLock) {
                    if (done.get()) {
                        throw endedStatus().asRuntimeException();
                    }
                    if (!sendLeg.send(e)) {
                        if (done.get()) {
                            throw endedStatus().asRuntimeException();
                        }
                        throw Status.CANCELLED.withDescription("rotation: the leg has ended").asRuntimeException();
                    }
                }
            }

            @Override
            public boolean isReady() {
                synchronized (sendLock) {
                    return !done.get() && sendLeg.isReady();
                }
            }

            @Override
            public void close(Status status, Metadata trailers) {
                end(status, trailers);
            }

            @Override
            public boolean isCancelled() {
                return cancelled;
            }

            @Override
            public void setMessageCompression(boolean enabled) {}

            @Override
            public void setCompression(String compressor) {}

            @Override
            public SecurityLevel getSecurityLevel() {
                return opening.call.getSecurityLevel();
            }

            @Override
            public Attributes getAttributes() {
                return opening.call.getAttributes();
            }

            @Override
            public String getAuthority() {
                return opening.call.getAuthority();
            }

            @Override
            public MethodDescriptor<ReqT, RespT> getMethodDescriptor() {
                return def.getMethodDescriptor();
            }
        }
    }

    // ======================================================================
    // The client
    // ======================================================================

    /**
     * A channel that can name the one channel a call with these options would
     * use now (serviceconnection.ServiceConnection.ChannelProvider). Every leg
     * of a logical stream goes on that channel, so a rebalance cannot move a
     * rotation to another instance; a refusal or failure there ends the stream
     * at its token's exp, fail-closed.
     */
    public interface Pinner {
        Channel pin(CallOptions options);
    }

    /**
     * Wraps {@code channel} so that a streaming call opened on it with a bearer
     * token goes to the method's rotating sibling and lives across token
     * lifetimes. Unary calls, and streams opened with no bearer token, pass
     * through unchanged. {@code tokens} is the caller's token source, the one
     * the generated client attaches at open, asked again for every rotation.
     */
    public static Channel channel(Channel channel, Supplier<String> tokens) {
        return new RotatingChannel(channel, tokens);
    }

    private static final class RotatingChannel extends Channel {
        private final Channel delegate;
        private final Supplier<String> tokens;

        RotatingChannel(Channel delegate, Supplier<String> tokens) {
            this.delegate = delegate;
            this.tokens = tokens;
        }

        @Override
        public <ReqT, RespT> ClientCall<ReqT, RespT> newCall(MethodDescriptor<ReqT, RespT> method, CallOptions options) {
            String rotating = rotatingMethod(method.getFullMethodName());
            if (tokens == null || rotating == null
                    || method.getType() == MethodDescriptor.MethodType.UNARY
                    || method.getType() == MethodDescriptor.MethodType.UNKNOWN) {
                return delegate.newCall(method, options);
            }
            return new LogicalClientCall<>(delegate, tokens, method, rotating, options);
        }

        @Override
        public String authority() {
            return delegate.authority();
        }
    }

    /** A call that does nothing: the stand-in once a call has failed to open. */
    private static final class NoopCall<ReqT, RespT> extends ClientCall<ReqT, RespT> {
        @Override public void start(Listener<RespT> l, Metadata h) {}
        @Override public void request(int n) {}
        @Override public void cancel(String m, Throwable c) {}
        @Override public void halfClose() {}
        @Override public void sendMessage(ReqT m) {}
    }

    /**
     * The caller's call. It opens the first leg off the caller's thread, and
     * holds the caller's operations until it knows where they go: the logical
     * stream, or the plain method on a server without the sibling.
     */
    private static final class LogicalClientCall<ReqT, RespT> extends ClientCall<ReqT, RespT> {
        private final Channel delegate;
        private final Supplier<String> tokens;
        private final MethodDescriptor<ReqT, RespT> method;
        private final String rotating;
        private final CallOptions options;
        private final Object lock = new Object();
        /** Guarded by lock: the operations made before the call was resolved. */
        private final List<java.util.function.Consumer<ClientCall<ReqT, RespT>>> pending = new ArrayList<>();
        /** Guarded by lock; once set, operations go straight to it. */
        private ClientCall<ReqT, RespT> real;

        LogicalClientCall(Channel delegate, Supplier<String> tokens, MethodDescriptor<ReqT, RespT> method,
                String rotating, CallOptions options) {
            this.delegate = delegate;
            this.tokens = tokens;
            this.method = method;
            this.rotating = rotating;
            this.options = options;
        }

        private void op(java.util.function.Consumer<ClientCall<ReqT, RespT>> f) {
            ClientCall<ReqT, RespT> c;
            synchronized (lock) {
                if (real == null) {
                    pending.add(f);
                    return;
                }
                c = real;
            }
            f.accept(c);
        }

        /** Resolves the call: the held operations first, in order, then the rest straight through. */
        private void resolve(ClientCall<ReqT, RespT> c) {
            while (true) {
                List<java.util.function.Consumer<ClientCall<ReqT, RespT>>> batch;
                synchronized (lock) {
                    if (pending.isEmpty()) {
                        real = c;
                        return;
                    }
                    // Operations arriving meanwhile queue behind this batch.
                    batch = new ArrayList<>(pending);
                    pending.clear();
                }
                for (java.util.function.Consumer<ClientCall<ReqT, RespT>> f : batch) {
                    try {
                        f.accept(c);
                    } catch (RuntimeException e) {
                        LOG.debug("rotation: a held call operation failed: {}", e.toString());
                    }
                }
            }
        }

        @Override
        public void start(Listener<RespT> listener, Metadata headers) {
            String token = bearer(headers.get(AUTHORIZATION));
            if (token.isEmpty()) {
                ClientCall<ReqT, RespT> plain = delegate.newCall(method, options);
                plain.start(listener, headers);
                resolve(plain);
                return;
            }
            Channel pinned = delegate;
            if (delegate instanceof Pinner p) {
                try {
                    pinned = p.pin(options);
                } catch (RuntimeException e) {
                    fail(listener, statusOf(e));
                    return;
                }
            }
            Context caller = Context.current();
            Executor callbacks = options.getExecutor() != null ? options.getExecutor() : WORKERS;
            ClientSession<ReqT, RespT> s = new ClientSession<>(pinned, tokens, method, rotating, options, headers,
                    listener, callbacks, caller);
            Channel on = pinned;
            try {
                WORKERS.execute(() -> open(s, on, token, listener, headers));
            } catch (RejectedExecutionException e) {
                fail(listener, Status.UNAVAILABLE.withDescription("rotation: no worker to open the stream"));
            }
        }

        private void fail(Listener<RespT> listener, Status status) {
            Executor callbacks = options.getExecutor() != null ? options.getExecutor() : WORKERS;
            callbacks.execute(() -> listener.onClose(status, new Metadata()));
            resolve(new NoopCall<>());
        }

        /** Opens the first leg; an UNAUTHENTICATED refusal is retried once with a fresh token. */
        private void open(ClientSession<ReqT, RespT> s, Channel pinned, String token, Listener<RespT> listener, Metadata headers) {
            CLeg first;
            try {
                try {
                    first = s.openLeg(token, "");
                } catch (Refused e) {
                    if (e.status.getCode() != Status.Code.UNAUTHENTICATED) {
                        throw e;
                    }
                    String fresh;
                    try {
                        fresh = tokens.get();
                    } catch (RuntimeException te) {
                        throw e;
                    }
                    if (fresh == null || fresh.isEmpty()) {
                        throw e;
                    }
                    first = s.openLeg(fresh, "");
                }
            } catch (Refused e) {
                if (e.status.getCode() == Status.Code.UNIMPLEMENTED) {
                    // A server without the sibling: the plain method, on the
                    // same channel, where #260's close at exp applies.
                    ClientCall<ReqT, RespT> plain;
                    Context prev = s.caller.attach();
                    try {
                        plain = pinned.newCall(method, options);
                        plain.start(listener, headers);
                    } finally {
                        s.caller.detach(prev);
                    }
                    resolve(plain);
                    return;
                }
                fail(listener, e.status);
                return;
            } catch (Exception e) {
                fail(listener, statusOf(e));
                return;
            }
            s.start(first);
            resolve(s);
            // A caller waiting to send hears that it may.
            s.onReady(first);
        }

        @Override
        public void request(int numMessages) {
            op(c -> c.request(numMessages));
        }

        @Override
        public void cancel(String message, Throwable cause) {
            op(c -> c.cancel(message, cause));
        }

        @Override
        public void halfClose() {
            op(ClientCall::halfClose);
        }

        @Override
        public void sendMessage(ReqT message) {
            op(c -> c.sendMessage(message));
        }

        @Override
        public boolean isReady() {
            ClientCall<ReqT, RespT> c;
            synchronized (lock) {
                if (real == null) {
                    return false;
                }
                c = real;
            }
            return c.isReady();
        }

        @Override
        public void setMessageCompression(boolean enabled) {
            op(c -> c.setMessageCompression(enabled));
        }

        @Override
        public Attributes getAttributes() {
            ClientCall<ReqT, RespT> c;
            synchronized (lock) {
                c = real;
            }
            return c == null ? Attributes.EMPTY : c.getAttributes();
        }
    }

    /** A leg the server refused or never attached. */
    static final class Refused extends Exception {
        private static final long serialVersionUID = 1L;
        final transient Status status;

        Refused(Status status, String message) {
            super(message + " (" + status.getCode() + ")");
            this.status = status;
        }
    }

    /** One leg of a logical stream, the client end. */
    private static final class CLeg {
        final ClientCall<Envelope, Envelope> call;
        final long expMillis;
        final LinkedBlockingQueue<Object> inbox = new LinkedBlockingQueue<>();
        volatile Metadata serverHeaders;
        /** Guarded by this: this side sends nothing more. */
        boolean ended;
        /** Guarded by this: the call is over. */
        boolean closed;

        CLeg(ClientCall<Envelope, Envelope> call, long expMillis) {
            this.call = call;
            this.expMillis = expMillis;
        }

        synchronized boolean send(Envelope e) {
            if (ended) {
                return false;
            }
            try {
                call.sendMessage(e);
                return true;
            } catch (RuntimeException ex) {
                return false;
            }
        }

        synchronized boolean isReady() {
            return ended || call.isReady();
        }

        synchronized void request() {
            // A half-closed leg still delivers the server's envelopes to its last.
            if (!closed) {
                call.request(1);
            }
        }

        /** Half-closes the leg: this side is done with it. */
        synchronized void finish() {
            if (!ended) {
                ended = true;
                try {
                    call.halfClose();
                } catch (RuntimeException ignored) {
                    // The call already ended; its end arrives on its own.
                }
            }
        }

        synchronized void abort() {
            if (!closed) {
                ended = true;
                closed = true;
                call.cancel("rotation: the stream has ended", null);
            }
        }

        synchronized void closed() {
            ended = true;
            closed = true;
        }
    }

    /** The logical stream, the client end: the ClientCall the caller's stub drives once it is attached. */
    private static final class ClientSession<ReqT, RespT> extends ClientCall<ReqT, RespT> {
        final Channel cc;
        final Supplier<String> tokens;
        final MethodDescriptor<ReqT, RespT> method;
        final MethodDescriptor<Envelope, Envelope> legMethod;
        final CallOptions legOptions;
        final Deadline callerDeadline;
        final Metadata baseHeaders = new Metadata();
        final Listener<RespT> listener;
        final SerialExecutor serial;
        final Context caller;
        final Credits credits = new Credits();

        final Object sendLock = new Object();
        /** Guarded by sendLock. */
        CLeg sendLeg;
        volatile CLeg readLeg;
        /** The leg after the read leg, set before the cutover. */
        volatile CLeg nextLeg;
        volatile CLeg firstLeg;
        volatile boolean finSent;
        volatile String sessionId = "";

        final AtomicBoolean done = new AtomicBoolean();
        final AtomicBoolean rotatingNow = new AtomicBoolean();
        volatile ScheduledFuture<?> rotation;
        volatile Thread reader;

        ClientSession(Channel cc, Supplier<String> tokens, MethodDescriptor<ReqT, RespT> method, String rotating,
                CallOptions options, Metadata headers, Listener<RespT> listener, Executor callbacks, Context caller) {
            this.cc = cc;
            this.tokens = tokens;
            this.method = method;
            this.legMethod = legMethod(rotating);
            // Leg callbacks are internal: never on the caller's executor.
            this.legOptions = options.withExecutor(WORKERS);
            this.callerDeadline = options.getDeadline();
            this.baseHeaders.merge(headers);
            this.baseHeaders.removeAll(AUTHORIZATION);
            this.listener = listener;
            this.serial = new SerialExecutor(callbacks);
            this.caller = caller;
        }

        /**
         * Opens one leg with {@code token}: its first envelope names the
         * session it joins (empty for a new one), and it is attached once the
         * server's first envelope names the session.
         */
        CLeg openLeg(String token, String joining) throws Refused {
            long expMillis;
            try {
                expMillis = TokenWrapper.parse(token).getExpiration() * 1000L;
            } catch (RuntimeException e) {
                throw new Refused(Status.UNAUTHENTICATED, "the token does not parse");
            }
            Deadline legDeadline = Deadline.after(
                    Math.max(1, expMillis + EXPIRY_GRACE_MS - System.currentTimeMillis()), TimeUnit.MILLISECONDS);
            if (callerDeadline != null && callerDeadline.isBefore(legDeadline)) {
                legDeadline = callerDeadline;
            }
            CallOptions opts = legOptions.withDeadline(legDeadline);
            // Created and started in the caller's Context, so the caller's
            // cancellation ends every leg.
            Context prev = caller.attach();
            ClientCall<Envelope, Envelope> call;
            try {
                call = cc.newCall(legMethod, opts);
            } catch (RuntimeException e) {
                caller.detach(prev);
                throw new Refused(statusOf(e), "the leg could not open");
            }
            CLeg leg = new CLeg(call, expMillis);
            CompletableFuture<String> attached = new CompletableFuture<>();
            Metadata headers = new Metadata();
            headers.merge(baseHeaders);
            headers.put(AUTHORIZATION, "Bearer " + token);
            try {
                synchronized (leg) {
                    call.start(new ClientCall.Listener<Envelope>() {
                        @Override
                        public void onHeaders(Metadata h) {
                            leg.serverHeaders = h;
                        }

                        @Override
                        public void onMessage(Envelope e) {
                            if (attached.isDone()) {
                                leg.inbox.add(e);
                                return;
                            }
                            String id = e.getSessionId();
                            if (id.isEmpty() || !(joining.isEmpty() || joining.equals(id))
                                    || !e.getPayload().isEmpty() || e.getLast() || e.getFin()) {
                                attached.completeExceptionally(new Refused(Status.PERMISSION_DENIED,
                                        "the server did not attach the leg"));
                                leg.abort();
                                return;
                            }
                            attached.complete(id);
                        }

                        @Override
                        public void onClose(Status status, Metadata trailers) {
                            leg.closed();
                            if (!attached.isDone()) {
                                attached.completeExceptionally(new Refused(status, "the leg was refused"));
                            }
                            leg.inbox.add(new End(status, trailers));
                        }

                        @Override
                        public void onReady() {
                            ClientSession.this.onReady(leg);
                        }
                    }, headers);
                    call.request(1);
                    call.sendMessage(Envelope.newBuilder().setSessionId(joining).build());
                }
            } finally {
                caller.detach(prev);
            }
            try {
                sessionId = attached.get(OPEN_TIMEOUT_MS, TimeUnit.MILLISECONDS);
            } catch (ExecutionException e) {
                leg.abort();
                if (e.getCause() instanceof Refused r) {
                    throw r;
                }
                throw new Refused(statusOf(e.getCause()), "the leg failed");
            } catch (TimeoutException e) {
                leg.abort();
                throw new Refused(Status.DEADLINE_EXCEEDED, "the server did not attach the leg in time");
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                leg.abort();
                throw new Refused(Status.CANCELLED, "interrupted");
            }
            return leg;
        }

        void start(CLeg first) {
            firstLeg = first;
            synchronized (sendLock) {
                sendLeg = first;
            }
            readLeg = first;
            Metadata h = first.serverHeaders;
            serial.execute(() -> listener.onHeaders(h == null ? new Metadata() : h));
            first.request();
            try {
                WORKERS.execute(this::read);
            } catch (RejectedExecutionException e) {
                fault(Status.Code.UNAVAILABLE, "rotation: no reader");
                return;
            }
            schedule(first);
        }

        /** The read leg's envelopes to the caller, leg by leg. */
        private void read() {
            reader = Thread.currentThread();
            try {
                while (!done.get()) {
                    CLeg leg = readLeg;
                    Object item = leg.inbox.take();
                    if (item instanceof End end) {
                        // A leg that ends without last ends the logical stream
                        // with its status: the handler's own end, or a fault.
                        // Never spliced.
                        finish(end.status, end.trailers);
                        return;
                    }
                    Envelope e = (Envelope) item;
                    if (malformed(e)) {
                        fault(Status.Code.INTERNAL, "rotation: malformed envelope");
                        return;
                    }
                    if (isMessage(e)) {
                        RespT msg;
                        try {
                            msg = method.parseResponse(e.getPayload().newInput());
                        } catch (RuntimeException ex) {
                            fault(Status.Code.INTERNAL, "rotation: unmarshal: " + ex.getMessage());
                            return;
                        }
                        credits.take();
                        if (done.get()) {
                            return;
                        }
                        // Delivered even if the stream's end overtakes it here: the
                        // end is queued behind it, as gRPC delivers messages before onClose.
                        serial.execute(() -> listener.onMessage(msg));
                    }
                    if (e.getLast()) {
                        CLeg next = nextLeg;
                        if (next == null) {
                            fault(Status.Code.INTERNAL, "rotation: last with no leg to cut over to");
                            return;
                        }
                        readLeg = next;
                        nextLeg = null;
                        // The old leg ends OK after its last; let its end arrive so it is freed.
                        leg.request();
                        next.request();
                    } else {
                        leg.request();
                    }
                }
            } catch (InterruptedException e) {
                // finish() interrupts the reader; nothing more to do.
            }
        }

        /** Ends the logical stream with {@code status}. */
        void finish(Status status, Metadata trailers) {
            if (!done.compareAndSet(false, true)) {
                return;
            }
            ScheduledFuture<?> r = rotation;
            if (r != null) {
                r.cancel(false);
            }
            CLeg send;
            synchronized (sendLock) {
                send = sendLeg;
            }
            for (CLeg l : new CLeg[] {send, readLeg, nextLeg}) {
                if (l != null) {
                    l.abort();
                }
            }
            Thread rd = reader;
            if (rd != null && rd != Thread.currentThread()) {
                rd.interrupt();
            }
            Metadata t = trailers == null ? new Metadata() : trailers;
            serial.execute(() -> listener.onClose(status, t));
        }

        void fault(Status.Code code, String reason) {
            LOG.info("rotation: stream of {} ended ({}): {}", method.getFullMethodName(), code, reason);
            Status s = Status.fromCode(code);
            if (reason != null && !reason.isEmpty()) {
                s = s.withDescription(reason);
            }
            finish(s, new Metadata());
        }

        /** Schedules the rotation of {@code leg} at ROTATE_AT of its token's lifetime. */
        private void schedule(CLeg leg) {
            long left = leg.expMillis - System.currentTimeMillis();
            later(Math.max(ROTATE_MIN_MS, (long) (left * ROTATE_AT)));
        }

        private void later(long delayMillis) {
            if (done.get()) {
                return;
            }
            try {
                rotation = TIMERS.schedule(() -> {
                    try {
                        WORKERS.execute(this::rotate);
                    } catch (RejectedExecutionException e) {
                        fault(Status.Code.UNAVAILABLE, "rotation: no worker");
                    }
                }, delayMillis, TimeUnit.MILLISECONDS);
            } catch (RejectedExecutionException e) {
                fault(Status.Code.UNAVAILABLE, "rotation: no timer");
            }
        }

        /**
         * Make-before-break: a new token, a new leg joining this session, then
         * the cutover. A mint that fails or returns no newer token is retried
         * every second; the current leg ends at its token's exp regardless
         * (fail closed). A refused rotation ends the logical stream.
         */
        private void rotate() {
            if (done.get() || !rotatingNow.compareAndSet(false, true)) {
                return;
            }
            try {
                CLeg current;
                synchronized (sendLock) {
                    current = sendLeg;
                }
                String token;
                try {
                    token = tokens.get();
                } catch (RuntimeException e) {
                    LOG.warn("rotation: token mint for a rotation of {} failed, retrying: {}",
                            method.getFullMethodName(), e.getMessage());
                    later(ROTATE_RETRY_MS);
                    return;
                }
                long exp;
                try {
                    exp = token == null || token.isEmpty() ? 0 : TokenWrapper.parse(token).getExpiration() * 1000L;
                } catch (RuntimeException e) {
                    exp = 0;
                }
                if (exp <= current.expMillis) {
                    // No newer token yet: the identity cache renews it ahead of expiry.
                    later(ROTATE_RETRY_MS);
                    return;
                }
                CLeg next;
                try {
                    try {
                        next = openLeg(token, sessionId);
                    } catch (Refused e) {
                        if (e.status.getCode() != Status.Code.UNAUTHENTICATED) {
                            throw e;
                        }
                        String fresh;
                        try {
                            fresh = tokens.get();
                        } catch (RuntimeException te) {
                            throw e;
                        }
                        if (fresh == null || fresh.isEmpty()) {
                            throw e;
                        }
                        next = openLeg(fresh, sessionId);
                    }
                } catch (Refused e) {
                    if (done.get()) {
                        return;
                    }
                    Status.Code c = e.status.getCode();
                    if (c == Status.Code.UNAUTHENTICATED || c == Status.Code.PERMISSION_DENIED) {
                        fault(c, "");
                        return;
                    }
                    LOG.warn("rotation: rotation of {} failed, retrying: {}", method.getFullMethodName(), e.getMessage());
                    later(ROTATE_RETRY_MS);
                    return;
                }
                nextLeg = next;
                if (done.get()) {
                    next.abort();
                    return;
                }
                cutOver(next);
                schedule(next);
            } finally {
                rotatingNow.set(false);
            }
        }

        /** Moves the sends to {@code next}: last on the old leg, then its half-close. */
        private void cutOver(CLeg next) {
            synchronized (sendLock) {
                CLeg old = sendLeg;
                old.send(LAST);
                old.finish();
                sendLeg = next;
            }
            onReady(next);
        }

        void onReady(CLeg leg) {
            boolean current;
            synchronized (sendLock) {
                current = sendLeg == leg;
            }
            if (current && !done.get()) {
                serial.execute(() -> {
                    if (!done.get()) {
                        listener.onReady();
                    }
                });
            }
        }

        // ---- the logical ClientCall ----

        @Override
        public void start(Listener<RespT> l, Metadata headers) {
            throw new IllegalStateException("rotation: the logical stream is already started");
        }

        @Override
        public void request(int numMessages) {
            credits.grant(numMessages);
        }

        @Override
        public void cancel(String message, Throwable cause) {
            Status s = Status.CANCELLED;
            if (message != null) {
                s = s.withDescription(message);
            }
            if (cause != null) {
                s = s.withCause(cause);
            }
            finish(s, new Metadata());
        }

        @Override
        public void halfClose() {
            synchronized (sendLock) {
                if (done.get() || finSent) {
                    return;
                }
                finSent = true;
                // A failure surfaces as the stream's status, as gRPC's own halfClose.
                sendLeg.send(FIN);
            }
        }

        @Override
        public void sendMessage(ReqT message) {
            ByteString b = serialize(message, method.getRequestMarshaller());
            Envelope e = Envelope.newBuilder().setPayload(b).build();
            synchronized (sendLock) {
                if (finSent) {
                    throw new IllegalStateException("call was half-closed");
                }
                if (done.get()) {
                    // As gRPC's own: the stream has ended, its status says how.
                    return;
                }
                sendLeg.send(e);
            }
        }

        @Override
        public boolean isReady() {
            synchronized (sendLock) {
                return !done.get() && sendLeg != null && sendLeg.isReady();
            }
        }

        @Override
        public void setMessageCompression(boolean enabled) {}

        @Override
        public Attributes getAttributes() {
            CLeg f = firstLeg;
            return f == null ? Attributes.EMPTY : f.call.getAttributes();
        }
    }
}
