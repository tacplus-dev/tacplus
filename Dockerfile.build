# tacplus build image
# Everything a service build needs (tacplus plus the per-language toolchains),
# so a CI host only has to run the job. The docker daemon is NOT in the image:
# jobs that build containers use the runner's mounted /var/run/docker.sock.
#
# Published by a build-image job as
#   ghcr.io/tacplus-dev/tacplus/build:<git sha> and :latest
#
# Separate from Dockerfile.base on purpose: the base image is the cross-test
# image and pins JDK 25 / Go 1.25 / protoc 28.3 / Node 24, which the fleet build
# does not use. Every tool here comes from an upstream release or official
# image at the exact version below — change versions ONLY in this block.

ARG GO_VERSION=1.26.9
ARG RUST_VERSION=1.99.0
ARG JDK_VERSION=21.0.12.1_1
ARG MAVEN_VERSION=3.9.16
ARG NODE_VERSION=22.23.3
ARG DOCKER_VERSION=29.9.0
ARG GCLOUD_VERSION=589.0.0
ARG JUST_VERSION=1.59.0
ARG PROTOC_VERSION=36.2
ARG PROTOC_GEN_GO_VERSION=1.36.11
ARG PROTOC_GEN_GO_GRPC_VERSION=1.6.0
ARG GRPC_JAVA_VERSION=1.85.0
ARG PROTOC_GEN_ES_VERSION=2.11.0
ARG PROTOC_GEN_PROST_VERSION=0.5.0
ARG PROTOC_GEN_TONIC_VERSION=0.5.0
ARG PROTOC_GEN_PROST_SERDE_VERSION=0.4.0
ARG PROTOC_GEN_PROST_CRATE_VERSION=0.5.0

# =============================================================================
# Release downloads: protoc, protoc-gen-grpc-java, just, gcloud
# =============================================================================
FROM debian:trixie-slim AS fetch
ARG TARGETARCH
ARG PROTOC_VERSION
ARG GRPC_JAVA_VERSION
ARG JUST_VERSION
ARG GCLOUD_VERSION
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Each upstream names the two architectures differently.
RUN case "$TARGETARCH" in \
      arm64) PROTOC_ARCH=aarch_64; JUST_ARCH=aarch64; GCLOUD_ARCH=arm ;; \
      amd64) PROTOC_ARCH=x86_64; JUST_ARCH=x86_64; GCLOUD_ARCH=x86_64 ;; \
      *) echo "unsupported TARGETARCH '$TARGETARCH'" >&2; exit 1 ;; \
    esac \
    && curl -fsSL --retry 30 --retry-delay 5 -o /tmp/protoc.zip \
       "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip" \
    && unzip -q /tmp/protoc.zip -d /opt/protoc \
    && curl -fsSL --retry 30 --retry-delay 5 -o /opt/protoc/bin/protoc-gen-grpc-java \
       "https://repo1.maven.org/maven2/io/grpc/protoc-gen-grpc-java/${GRPC_JAVA_VERSION}/protoc-gen-grpc-java-${GRPC_JAVA_VERSION}-linux-${PROTOC_ARCH}.exe" \
    && chmod +x /opt/protoc/bin/protoc /opt/protoc/bin/protoc-gen-grpc-java \
    && mkdir -p /opt/just \
    && curl -fsSL --retry 30 --retry-delay 5 \
       "https://github.com/casey/just/releases/download/${JUST_VERSION}/just-${JUST_VERSION}-${JUST_ARCH}-unknown-linux-musl.tar.gz" \
       | tar -xz -C /opt/just just \
    && curl -fsSL --retry 30 --retry-delay 5 \
       "https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-${GCLOUD_VERSION}-linux-${GCLOUD_ARCH}.tar.gz" \
       | tar -xz -C /opt \
    && rm /tmp/protoc.zip

# =============================================================================
# Go toolchain + Go protoc plugins
# =============================================================================
FROM golang:${GO_VERSION}-trixie AS go-tools
ARG PROTOC_GEN_GO_VERSION
ARG PROTOC_GEN_GO_GRPC_VERSION

RUN go install "google.golang.org/protobuf/cmd/protoc-gen-go@v${PROTOC_GEN_GO_VERSION}" \
    && go install "google.golang.org/grpc/cmd/protoc-gen-go-grpc@v${PROTOC_GEN_GO_GRPC_VERSION}"

# =============================================================================
# tacplus, built from the commit in the build context
# =============================================================================
FROM go-tools AS tacplus
ARG VCS_REF=local

COPY --from=fetch /opt/protoc/bin/protoc /usr/local/bin/protoc
COPY --from=fetch /opt/protoc/include /usr/local/include

WORKDIR /src
COPY . .
# Same generate + ldflags as the release build (Version stays the
# 0.0.0 dev default on main).
RUN go generate ./pkg/internal/proto/spec/... \
    && CGO_ENABLED=0 go build -trimpath \
       -ldflags="-w -s -X github.com/tacplus-dev/tacplus/pkg/buildinfo.GitSha=${VCS_REF} -X github.com/tacplus-dev/tacplus/pkg/buildinfo.BuildID=${VCS_REF}" \
       -o /out/tacplus main.go

# =============================================================================
# Rust protoc plugins (compiled from source)
# =============================================================================
FROM rust:${RUST_VERSION}-trixie AS rust-tools
ARG PROTOC_GEN_PROST_VERSION
ARG PROTOC_GEN_TONIC_VERSION
ARG PROTOC_GEN_PROST_SERDE_VERSION
ARG PROTOC_GEN_PROST_CRATE_VERSION

RUN cargo install --locked --root /out \
    "protoc-gen-prost@${PROTOC_GEN_PROST_VERSION}" \
    "protoc-gen-tonic@${PROTOC_GEN_TONIC_VERSION}" \
    "protoc-gen-prost-serde@${PROTOC_GEN_PROST_SERDE_VERSION}" \
    "protoc-gen-prost-crate@${PROTOC_GEN_PROST_CRATE_VERSION}"

# =============================================================================
# Node + protoc-gen-es (npm's global prefix in the node image is /usr/local)
# =============================================================================
FROM node:${NODE_VERSION}-trixie-slim AS node
ARG PROTOC_GEN_ES_VERSION

RUN npm install -g \
    "@bufbuild/protoc-gen-es@${PROTOC_GEN_ES_VERSION}" \
    "@bufbuild/protobuf@${PROTOC_GEN_ES_VERSION}"

# =============================================================================
# Upstream images whose files are copied as-is
# =============================================================================
FROM eclipse-temurin:${JDK_VERSION}-jdk-noble AS jdk
FROM maven:${MAVEN_VERSION}-eclipse-temurin-21 AS maven
FROM docker:${DOCKER_VERSION}-cli AS docker-cli

# =============================================================================
# Build image. The rust image is Debian trixie + a C toolchain + rustup/cargo
# (CARGO_HOME=/usr/local/cargo, RUSTUP_HOME=/usr/local/rustup).
# =============================================================================
FROM rust:${RUST_VERSION}-trixie

LABEL org.opencontainers.image.title="TACPlus Build Image" \
      org.opencontainers.image.description="Fleet build toolchain: tacplus, protoc + plugins, Go, Rust, JDK, Maven, Node, docker CLI, gcloud"

# python3 is gcloud's interpreter; file is build-fleet.sh's artifact arch check.
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    file \
    git \
    jq \
    libssl-dev \
    pkg-config \
    python3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=go-tools /usr/local/go /usr/local/go
COPY --from=go-tools /go/bin/protoc-gen-go /go/bin/protoc-gen-go-grpc /usr/local/bin/

COPY --from=jdk /opt/java/openjdk /opt/java/openjdk
COPY --from=maven /usr/share/maven /usr/share/maven

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/include/node /usr/local/include/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx

COPY --from=fetch /opt/protoc/bin/protoc /opt/protoc/bin/protoc-gen-grpc-java /usr/local/bin/
COPY --from=fetch /opt/protoc/include /usr/local/include
COPY --from=fetch /opt/just/just /usr/local/bin/just
COPY --from=fetch /opt/google-cloud-sdk /opt/google-cloud-sdk

COPY --from=rust-tools /out/bin/ /usr/local/bin/

RUN ln -s /usr/share/maven/bin/mvn /usr/local/bin/mvn \
    && ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -s ../lib/node_modules/@bufbuild/protoc-gen-es/bin/protoc-gen-es /usr/local/bin/protoc-gen-es

ENV JAVA_HOME=/opt/java/openjdk \
    MAVEN_HOME=/usr/share/maven \
    PATH="/usr/local/go/bin:/opt/java/openjdk/bin:/opt/google-cloud-sdk/bin:${PATH}"

# Last, so a tacplus change does not invalidate the toolchain layers above.
COPY --from=tacplus /out/tacplus /usr/local/bin/tacplus

WORKDIR /workspace
