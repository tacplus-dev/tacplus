[package]
name = "jwk"
version = "0.1.0"
edition = "2021"
description = "JWK (JSON Web Key) operations"

[dependencies]
key = { path = "../key" }
base64 = "0.22"
rsa = { version = "0.9", features = ["sha2"] }
p256 = "0.13"
p384 = "0.13"
ed25519-dalek = { version = "2", features = ["rand_core"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
