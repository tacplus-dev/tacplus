    private static HealthReporter.MetricsProvider buildMetricsProvider(Config config) {
        String host = "";
        int port = 8443;
        if (config.hasListenAddress()) {
            host = config.getListenAddress().getHost();
            port = config.getListenAddress().getPort();
            if (port == 0) port = 8443;
        }
        if (host.isEmpty() || "0.0.0.0".equals(host) || "::".equals(host)) {
            try {
                host = java.net.InetAddress.getLocalHost().getHostName();
            } catch (Exception e) {
                LOG.warning("Failed to get hostname for health reporter: " + e.getMessage());
            }
        }
        final Host endpoint = Host.newBuilder().setHost(host).setPort(port).build();
        return new HealthReporter.MetricsProvider() {
            @Override public Host grpcEndpoint() { return endpoint; }
            @Override public Host httpEndpoint() { return null; }
            @Override public int activeRequests() { return 0; }
            @Override public int maxConcurrent() { return 0; }
            @Override public double requestRate() { return 0; }
            @Override public long p50LatencyUs() { return 0; }
            @Override public long p99LatencyUs() { return 0; }
            @Override public double errorRate() { return 0; }
            @Override public String version() { return ""; }
            @Override public java.util.Map<String, String> labels() { return Collections.emptyMap(); }
        };
    }
