	token.initToken()
	return token.token.Payload[tokenProto.JwtPayloadTypeToString(tokenProto.JwtPayloadType_JWT_PAYLOAD_TYPE_ACT)]
}

// SetAct sets the act (actor) claim in the JWT payload.
func (token *TokenWrapper) SetAct(act string) *TokenWrapper {
	token.checkMutable()
	token.initToken()
	token.token.Payload[tokenProto.JwtPayloadTypeToString(tokenProto.JwtPayloadType_JWT_PAYLOAD_TYPE_ACT)] = act
	return token
}

// GetServiceName returns the service_name claim from the JWT payload.
func (token *TokenWrapper) GetServiceName() string {
	token.initToken()
	return token.token.Payload[tokenProto.JwtPayloadTypeToString(tokenProto.JwtPayloadType_JWT_PAYLOAD_TYPE_SERVICE_NAME)]
}

// SetServiceName sets the service_name claim in the JWT payload.
func (token *TokenWrapper) SetServiceName(serviceName string) *TokenWrapper {
	token.checkMutable()
	token.initToken()
	token.token.Payload[tokenProto.JwtPayloadTypeToString(tokenProto.JwtPayloadType_JWT_PAYLOAD_TYPE_SERVICE_NAME)] = serviceName
	return token
}

// GetProfiles returns the profiles claim as a string slice (comma-delimited in payload).
func (token *TokenWrapper) GetProfiles() []string {
	return token.GetListField(tokenProto.JwtPayloadTypeToString(tokenProto.JwtPayloadType_JWT_PAYLOAD_TYPE_PROFILES))
}

// SetProfiles sets the profiles claim as a comma-delimited string.
func (token *TokenWrapper) SetProfiles(profiles []string) *TokenWrapper {
	return token.SetListField(tokenProto.JwtPayloadTypeToString(tokenProto.JwtPayloadType_JWT_PAYLOAD_TYPE_PROFILES), profiles)
}

// GetEntitlements returns the entitlements claim as a string slice (comma-delimited in payload).
func (token *TokenWrapper) GetEntitlements() []string {
	return token.GetListField(tokenProto.JwtPayloadTypeToString(tokenProto.JwtPayloadType_JWT_PAYLOAD_TYPE_ENTITLEMENTS))
}

// SetEntitlements sets the entitlements claim as a comma-delimited string.
func (token *TokenWrapper) SetEntitlements(entitlements []string) *TokenWrapper {
	return token.SetListField(tokenProto.JwtPayloadTypeToString(tokenProto.JwtPayloadType_JWT_PAYLOAD_TYPE_ENTITLEMENTS), entitlements)
}

// GetServiceEntitlements returns the service_entitlements claim as a typed TokenEntitlements proto.
// Returns nil if the claim is absent or cannot be parsed.
func (token *TokenWrapper) GetServiceEntitlements() *entitlementspb.TokenEntitlements {
	raw := token.token.Payload[tokenProto.JwtPayloadTypeToString(tokenProto.JwtPayloadType_JWT_PAYLOAD_TYPE_SERVICE_ENTITLEMENTS)]
	if raw == "" {
		return nil
	}
	te := &entitlementspb.TokenEntitlements{}
	if err := protojson.Unmarshal([]byte(raw), te); err != nil {
		return nil
	}
	return te
}

// SetServiceEntitlements sets the service_entitlements claim from a typed TokenEntitlements proto.
// The value is stored as protojson and embedded as a JSON object (not a string) when the JWT is signed.
func (token *TokenWrapper) SetServiceEntitlements(te *entitlementspb.TokenEntitlements) *TokenWrapper {
	token.checkMutable()
	token.initToken()
	if te == nil {
		return token
	}
	b, err := protojson.Marshal(te)
	if err != nil {
		return token
	}
	token.token.Payload[tokenProto.JwtPayloadTypeToString(tokenProto.JwtPayloadType_JWT_PAYLOAD_TYPE_SERVICE_ENTITLEMENTS)] = string(b)
	return token
}

// SetListField sets a payload field as a comma-delimited string from a string slice.
func (token *TokenWrapper) SetListField(key string, values []string) *TokenWrapper {
	token.checkMutable()
	token.initToken()
	token.token.Payload[key] = strings.Join(values, ",")
	return token
}

// GetListField reads a payload field and splits it into a string slice.
// Handles comma-delimited strings. Returns nil if the field is empty or missing.
func (token *TokenWrapper) GetListField(key string) []string {
	token.initToken()
	raw := token.token.Payload[key]
	if raw == "" {
		return nil
	}
	var result []string
	for _, s := range strings.Split(raw, ",") {
		s = strings.TrimSpace(s)
		if s != "" {
			result = append(result, s)
		}
	}
	return result
}

