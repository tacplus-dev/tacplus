            return Ok(());
        }
        let now = Utc::now();
        let cache = ASSERTION_REPLAY_CACHE.get_or_init(|| Mutex::new(HashMap::new()));
        let mut guard = cache.lock().map_err(|_| {
            SamlError::VerificationError("assertion replay cache lock poisoned".to_string())
        })?;
        guard.retain(|_, expiry| *expiry > now);
        if let Some(existing) = guard.get(&self.id) {
            if *existing > now {
                return Err(SamlError::VerificationError(
                    format!("assertion {} has already been verified", self.id),
                ));
            }
        }
        let mut expires_at = now + chrono::Duration::minutes(10);
        if let Ok(t) = parse_saml_time(&self.not_on_or_after) {
            expires_at = t + chrono::Duration::seconds(60);
        }
        guard.insert(self.id.clone(), expires_at);
        Ok(())
    }

    /// Return the XML as base64 for inclusion in a SAMLResponse form field.
    pub fn to_base64(&self) -> String {
        general_purpose::STANDARD.encode(self.xml.as_bytes())
    }

    /// Check whether the assertion's Conditions and SubjectConfirmation time windows are currently valid.
    pub fn is_time_valid(&self) -> bool {
        let now = Utc::now();
        if !self.not_before.is_empty() {
            let Ok(nb) = parse_saml_time(&self.not_before) else {
                return false;
            };
            if now < nb - chrono::Duration::seconds(SAML_CLOCK_SKEW_SECONDS) {
                return false;
            }
        }
        let Ok(na) = parse_saml_time(&self.not_on_or_after) else {
            return false;
        };
        if now >= na {
            return false;
        }
        if !self.subject_not_on_or_after.is_empty() {
            let Ok(sna) = parse_saml_time(&self.subject_not_on_or_after) else {
                return false;
            };
            if now >= sna {
                return false;
            }
        }
        true
    }
}

fn verify_cert_currently_valid(cert: &ImmutableCert) -> Result<(), SamlError> {
    let validity = cert.certificate().tbs_certificate.validity;
    let now = std::time::SystemTime::now();
    let not_before = validity.not_before.to_system_time();
    let not_after = validity.not_after.to_system_time();
    if now < not_before {
        return Err(SamlError::CertError("SAML IdP certificate is not yet valid".to_string()));
    }
    if now > not_after {
        return Err(SamlError::CertError("SAML IdP certificate is expired".to_string()));
    }
    Ok(())
}

