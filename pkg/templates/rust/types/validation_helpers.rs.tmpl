{{- if .NeedsListenAddr}}
/// Validates listen address (host:port format)
fn validate_listen_addr(addr: &str) -> Result<(), String> {
if !addr.contains(':') {
return Err(format!("listen address must be in host:port format, got: {}", addr));
}
let parts: Vec<&str> = addr.rsplitn(2, ':').collect();
if parts.len() != 2 {
return Err(format!("invalid listen address format: {}", addr));
}
// Validate port (u16 is always valid 0-65535, no need to check upper bound)
if parts[0].parse::<u16>().is_err() {
return Err(format!("invalid port in listen address: {}", addr));
}
Ok(())
}

/// Parses a "host:port" string into its host and port components.
/// Handles IPv6 addresses in bracket notation (e.g. "[::1]:8080").
pub fn parse_listen_addr(addr: &str) -> Result<(&str, u16), String> {
if let Some(rest) = addr.strip_prefix('[') {
// IPv6: [::1]:8080
let bracket_end = rest.find(']')
.ok_or_else(|| format!("invalid IPv6 host:port format: {}", addr))?;
let host = &rest[..bracket_end];
let after = &rest[bracket_end + 1..];
if !after.starts_with(':') {
return Err(format!("invalid host:port format: {}", addr));
}
let port = after[1..].parse::<u16>()
.map_err(|_| format!("invalid port in address: {}", addr))?;
Ok((host, port))
} else {
let last_colon = addr.rfind(':')
.ok_or_else(|| format!("invalid host:port format: {}", addr))?;
let host = &addr[..last_colon];
let port = addr[last_colon + 1..].parse::<u16>()
.map_err(|_| format!("invalid port in address: {}", addr))?;
Ok((host, port))
}
}
{{- end}}
{{- if .NeedsCidr}}
/// Validates CIDR notation
fn validate_cidr(cidr: &str, ip_type: &str) -> Result<(), String> {
let parts: Vec<&str> = cidr.split('/').collect();
if parts.len() != 2 {
return Err(format!("invalid CIDR notation: {}", cidr));
}

let ip = parts[0].parse::<IpAddr>()
.map_err(|_| format!("invalid IP address in CIDR: {}", cidr))?;

let prefix_len = parts[1].parse::<u8>()
.map_err(|_| format!("invalid prefix length in CIDR: {}", cidr))?;

match (ip, ip_type) {
(IpAddr::V4(_), "IP_ADDR_TYPE_NET_V4") => {
if prefix_len > 32 {
return Err(format!("IPv4 prefix length must be 0-32, got: {}", prefix_len));
}
}
(IpAddr::V6(_), "IP_ADDR_TYPE_NET_V6") => {
if prefix_len > 128 {
return Err(format!("IPv6 prefix length must be 0-128, got: {}", prefix_len));
}
}
(IpAddr::V4(_), _) if ip_type == "IP_ADDR_TYPE_NET_ANY" => {
if prefix_len > 32 {
return Err(format!("IPv4 prefix length must be 0-32, got: {}", prefix_len));
}
}
(IpAddr::V6(_), _) if ip_type == "IP_ADDR_TYPE_NET_ANY" => {
if prefix_len > 128 {
return Err(format!("IPv6 prefix length must be 0-128, got: {}", prefix_len));
}
}
_ => return Err(format!("IP type mismatch in CIDR: {}", cidr)),
}

Ok(())
}
{{- end}}
{{- if .NeedsSemver}}
/// Validates semantic version format
fn validate_semver(version: &str) -> Result<(), String> {
let semver_regex = Regex::new(r"^v?(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-((?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\.(?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\+([0-9a-zA-Z-]+(?:\.[0-9a-zA-Z-]+)*))?$").unwrap();
if !semver_regex.is_match(version) {
return Err(format!("invalid semantic version: {}", version));
}
Ok(())
}
{{- end}}
{{- if .NeedsSql}}
/// Syntactic SQL sanity check and statement-type gate. NOT an injection defense: it
/// rejects a few obvious tokens and checks the leading keyword only. Callers must still
/// use parameterized queries; never interpolate a validated string as if it were safe.
fn validate_sql(sql: &str, permit: &str) -> Result<(), String> {
if sql.contains(';') {
return Err("SQL contains disallowed token: semicolon".to_string());
}
if sql.contains("--") {
return Err("SQL contains disallowed token: line comment (--)".to_string());
}
if sql.contains("/*") {
return Err("SQL contains disallowed token: block comment (/*)".to_string());
}
if sql.contains('\\') {
return Err("SQL contains disallowed token: backslash escape".to_string());
}
let normalized = sql.trim().to_uppercase();
match permit {
"SQL_PERMIT_SELECT" => {
if !normalized.starts_with("SELECT") && !normalized.starts_with("WITH") {
return Err("only SELECT statements permitted".to_string());
}
}
"SQL_PERMIT_DML" => {
if !["SELECT", "INSERT", "UPDATE", "DELETE", "WITH"].iter().any(|k| normalized.starts_with(k)) {
return Err("only DML statements permitted".to_string());
}
}
"SQL_PERMIT_DDL" => {
if !["CREATE", "ALTER", "DROP", "TRUNCATE"].iter().any(|k| normalized.starts_with(k)) {
return Err("only DDL statements permitted".to_string());
}
}
"SQL_PERMIT_ANY" => {}
_ => {}
}
Ok(())
}
{{- end}}
