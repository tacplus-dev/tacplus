//
// JSON Web Key (JWK) management and operations.
//
// This module provides parsing, validation, and usage of JWK format keys
// as defined in RFC 7517. Supports RSA, ECDSA, and EdDSA key types.
//
// # Features
//
//! - JWK parsing and validation
//! - Conversion to native cryptographic types
//! - JWT signing method integration
//! - Support for RSA, EC (P-256, P-384, P-521), and Ed25519 keys

use key::error::{AuthError, Result};
use key::keys::{KeyType, PublicKey};
use key::base64_utils;
use ed25519_dalek::VerifyingKey;
use p256::ecdsa::VerifyingKey as P256VerifyingKey;
use p384::ecdsa::VerifyingKey as P384VerifyingKey;
use rsa::RsaPublicKey;
use serde::{Deserialize, Serialize};

/// JSON Web Key (JWK) representation
///
/// This structure follows RFC 7517 and includes fields for
/// different key types (RSA, EC, OKP).
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Jwk {
    /// Key type: "RSA", "EC", or "OKP"
    pub kty: String,

    /// Algorithm the key declares: "RS256", "RS384", "RS512", "ES256",
    /// "ES384", "EdDSA". `None` when the key does not declare one (Microsoft's
    /// JWKS publishes none); it is never filled in with a guess.
    #[serde(skip_serializing_if = "Option::is_none")]
    pub alg: Option<String>,

    /// Key ID
    pub kid: String,

    /// Public key use: "sig" (signature) or "enc" (encryption)
    #[serde(skip_serializing_if = "Option::is_none", rename = "use")]
    pub key_use: Option<String>,

    // RSA-specific fields
    /// RSA modulus (base64url-encoded)
    #[serde(skip_serializing_if = "Option::is_none")]
    pub n: Option<String>,

    /// RSA public exponent (base64url-encoded)
    #[serde(skip_serializing_if = "Option::is_none")]
    pub e: Option<String>,

    // EC-specific fields
    /// Elliptic curve: "P-256", "P-384", "P-521"
    #[serde(skip_serializing_if = "Option::is_none")]
    pub crv: Option<String>,

    /// EC/OKP X coordinate or public key (base64url-encoded)
    #[serde(skip_serializing_if = "Option::is_none")]
    pub x: Option<String>,

    /// EC Y coordinate (base64url-encoded)
    #[serde(skip_serializing_if = "Option::is_none")]
    pub y: Option<String>,

    // Timestamps
    #[serde(skip_serializing_if = "Option::is_none")]
    pub exp: Option<i64>,

    #[serde(skip_serializing_if = "Option::is_none")]
    pub created: Option<i64>,
}

/// Immutable JWK wrapper with pre-parsed cryptographic primitives
///
/// This type is thread-safe and designed for efficient reuse.
/// It validates the JWK data during construction and provides
/// access to the parsed public key.
pub struct ImmutableJwk {
    jwk: Jwk,
    kty: KeyType,
    public_key: PublicKey,
    accepted_algs: &'static [&'static str],
}

/// Algorithms an RSA key verifies (PKCS#1 v1.5). Never PS*, HMAC or none.
const RSA_ALGS: &[&str] = &["RS256", "RS384", "RS512"];
/// Algorithm a P-256 key verifies.
const P256_ALGS: &[&str] = &["ES256"];
/// Algorithm a P-384 key verifies.
const P384_ALGS: &[&str] = &["ES384"];
/// Algorithm an Ed25519 key verifies.
const ED25519_ALGS: &[&str] = &["EdDSA"];

/// Builds the accepted set from the KEY's family, narrowed to the alg the JWK
/// declares (issue #179). An empty alg declares nothing, as in every port.
///
/// A key without `alg` verifies any alg of its family: an IdP picks its own
/// (Keycloak and Microsoft sign RS256 on 2048-bit keys, Microsoft publishing
/// no alg at all), so guessing one from the key size refused every such
/// token. A declared alg must be exactly (case-sensitive) one of the family;
/// anything else — an RSA key declaring ES256, PS256, HS256 or none, a P-256
/// key declaring ES384 — is refused here rather than at verification, so a
/// key can never widen what it verifies.
fn accepted_for(
    family: &'static [&'static str],
    declared: Option<&str>,
    kind: &str,
) -> Result<&'static [&'static str]> {
    match declared.filter(|alg| !alg.is_empty()) {
        None => Ok(family),
        Some(alg) => family
            .iter()
            .position(|f| *f == alg)
            .map(|i| &family[i..=i])
            .ok_or_else(|| {
                AuthError::unsupported_algorithm(format!("{} JWK alg {}", kind, alg))
            }),
    }
}

impl ImmutableJwk {
    /// Creates a new ImmutableJwk from a JWK structure
    ///
    /// Validates all required fields and parses the key material
    /// into native cryptographic types.
    pub fn new(jwk: Jwk) -> Result<Self> {
        if jwk.kid.is_empty() {
            return Err(AuthError::missing_invalid_data("missing jwk.kid"));
        }

        // Parse based on key type
        match jwk.kty.as_str() {
            "RSA" => Self::parse_rsa(jwk),
            "EC" => Self::parse_ec(jwk),
            "OKP" => Self::parse_okp(jwk),
            _ => Err(AuthError::unsupported_key_type(jwk.kty.clone())),
        }
    }

    /// Parses an RSA JWK
    fn parse_rsa(jwk: Jwk) -> Result<Self> {
        let n = jwk
            .n
            .as_ref()
            .ok_or_else(|| AuthError::missing_invalid_data("missing RSA modulus (n)"))?;
        let e = jwk
            .e
            .as_ref()
            .ok_or_else(|| AuthError::missing_invalid_data("missing RSA exponent (e)"))?;

        let n_bytes = base64_utils::decode_base64(n)?;
        let e_bytes = base64_utils::decode_base64(e)?;

        let n_big = rsa::BigUint::from_bytes_be(&n_bytes);
        let e_u32 = rsa::BigUint::from_bytes_be(&e_bytes)
            .try_into()
            .map_err(|_| AuthError::missing_invalid_data("RSA exponent too large"))?;

        let public_key = RsaPublicKey::new(n_big, e_u32)
            .map_err(|e| AuthError::rsa(e.to_string()))?;

        use rsa::traits::PublicKeyParts;
        let key_bytes = (public_key.n().bits() + 7) / 8;
        if key_bytes < 256 {
            return Err(AuthError::missing_invalid_data(format!(
                "unsupported RSA key size: {} bytes",
                key_bytes
            )));
        }
        // The key size no longer picks an alg: the accepted set is the RSA
        // family (or the alg the JWK declares), and jwk.alg stays as declared.
        let accepted_algs = accepted_for(RSA_ALGS, jwk.alg.as_deref(), "RSA")?;

        Ok(Self {
            jwk,
            kty: KeyType::Rsa,
            public_key: PublicKey::Rsa(public_key),
            accepted_algs,
        })
    }

    /// Parses an EC JWK
    fn parse_ec(jwk: Jwk) -> Result<Self> {
        let crv = jwk
            .crv
            .as_ref()
            .ok_or_else(|| AuthError::missing_invalid_data("missing EC curve (crv)"))?;
        let x = jwk
            .x
            .as_ref()
            .ok_or_else(|| AuthError::missing_invalid_data("missing EC x coordinate"))?;
        let y = jwk
            .y
            .as_ref()
            .ok_or_else(|| AuthError::missing_invalid_data("missing EC y coordinate"))?;

        let x_bytes = base64_utils::decode_base64(x)?;
        let y_bytes = base64_utils::decode_base64(y)?;

        match Self::normalize_curve_name(crv).as_str() {
            "ES256" | "P-256" => {
                use p256::EncodedPoint;

                // Construct uncompressed point (0x04 || x || y)
                let mut point_bytes = Vec::with_capacity(1 + x_bytes.len() + y_bytes.len());
                point_bytes.push(0x04); // Uncompressed point tag
                point_bytes.extend_from_slice(&x_bytes);
                point_bytes.extend_from_slice(&y_bytes);

                let point = EncodedPoint::from_bytes(&point_bytes)
                    .map_err(|_| AuthError::ecdsa("invalid P-256 point".to_string()))?;

                let verifying_key = P256VerifyingKey::from_encoded_point(&point)
                    .map_err(|e| AuthError::ecdsa(format!("invalid P-256 key: {}", e)))?;
                let accepted_algs = accepted_for(P256_ALGS, jwk.alg.as_deref(), "P-256")?;

                Ok(Self {
                    jwk,
                    kty: KeyType::Ec,
                    public_key: PublicKey::EcP256(verifying_key),
                    accepted_algs,
                })
            }
            "ES384" | "P-384" => {
                use p384::EncodedPoint;

                let mut point_bytes = Vec::with_capacity(1 + x_bytes.len() + y_bytes.len());
                point_bytes.push(0x04);
                point_bytes.extend_from_slice(&x_bytes);
                point_bytes.extend_from_slice(&y_bytes);

                let point = EncodedPoint::from_bytes(&point_bytes)
                    .map_err(|_| AuthError::ecdsa("invalid P-384 point".to_string()))?;

                let verifying_key = P384VerifyingKey::from_encoded_point(&point)
                    .map_err(|e| AuthError::ecdsa(format!("invalid P-384 key: {}", e)))?;
                let accepted_algs = accepted_for(P384_ALGS, jwk.alg.as_deref(), "P-384")?;

                Ok(Self {
                    jwk,
                    kty: KeyType::Ec,
                    public_key: PublicKey::EcP384(verifying_key),
                    accepted_algs,
                })
            }
            "ES512" | "P-521" => {
                // P-521 not currently supported by our dependencies
                Err(AuthError::unsupported_algorithm(
                    "ES512/P-521 not yet supported".to_string(),
                ))
            }
            _ => Err(AuthError::unsupported_algorithm(format!(
                "unsupported curve: {}",
                crv
            ))),
        }
    }

    /// Parses an OKP (Ed25519) JWK
    fn parse_okp(jwk: Jwk) -> Result<Self> {
        let crv = jwk
            .crv
            .as_ref()
            .ok_or_else(|| AuthError::missing_invalid_data("missing OKP curve (crv)"))?;

        if crv != "Ed25519" {
            return Err(AuthError::unsupported_algorithm(format!(
                "unsupported OKP curve: {} (only Ed25519 supported)",
                crv
            )));
        }

        let x = jwk
            .x
            .as_ref()
            .ok_or_else(|| AuthError::missing_invalid_data("missing OKP x coordinate"))?;

        let x_bytes = base64_utils::decode_base64(x)?;

        if x_bytes.len() != 32 {
            return Err(AuthError::missing_invalid_data(format!(
                "invalid Ed25519 key size: {} (expected 32 bytes)",
                x_bytes.len()
            )));
        }

        let key_bytes: [u8; 32] = x_bytes
            .try_into()
            .map_err(|_| AuthError::ed25519("invalid key length".to_string()))?;

        let verifying_key = VerifyingKey::from_bytes(&key_bytes)
            .map_err(|e| AuthError::ed25519(e.to_string()))?;
        let accepted_algs = accepted_for(ED25519_ALGS, jwk.alg.as_deref(), "Ed25519")?;

        Ok(Self {
            jwk,
            kty: KeyType::Okp,
            public_key: PublicKey::Ed25519(verifying_key),
            accepted_algs,
        })
    }

    /// Normalizes curve names (e.g., "P-256" to "ES256")
    fn normalize_curve_name(curve: &str) -> String {
        match curve {
            "P-256" => "ES256".to_string(),
            "P-384" => "ES384".to_string(),
            "P-521" => "ES512".to_string(),
            other => other.to_string(),
        }
    }

    /// Returns the key type
    pub fn kty(&self) -> KeyType {
        self.kty
    }

    /// Returns the algorithm the JWK declares, "" when it declares none
    pub fn alg(&self) -> &str {
        self.jwk.alg.as_deref().unwrap_or("")
    }

    /// Returns the algorithms a token verified by this key may use: the key
    /// family's (RSA: RS256, RS384, RS512; P-256: ES256; P-384: ES384;
    /// Ed25519: EdDSA), or only the declared alg when the JWK declares one.
    pub fn accepted_algs(&self) -> &[&'static str] {
        self.accepted_algs
    }

    /// Returns the key ID
    pub fn kid(&self) -> &str {
        &self.jwk.kid
    }

    /// Returns a reference to the parsed public key
    pub fn public_key(&self) -> &PublicKey {
        &self.public_key
    }

    /// Returns a reference to the underlying JWK
    pub fn jwk(&self) -> &Jwk {
        &self.jwk
    }
}

/// Converts a native key to JWK format
pub fn key_to_jwk(key: &key::keys::ImmutablePublicKey) -> Result<Jwk> {
    public_key_to_jwk(key.id().to_string(), key.alg().to_string(), key.public_key())
}

/// Builds the JWK of a public key under the given kid, declaring alg
fn public_key_to_jwk(kid: String, alg: String, public_key: &PublicKey) -> Result<Jwk> {
    match public_key {
        PublicKey::Rsa(rsa_key) => {
            use rsa::traits::PublicKeyParts;

            let n = base64_utils::encode_base64_url(&rsa_key.n().to_bytes_be());
            let e = base64_utils::encode_base64_url(&rsa_key.e().to_bytes_be());

            Ok(Jwk {
                kty: "RSA".to_string(),
                alg: Some(alg),
                kid,
                key_use: Some("sig".to_string()),
                n: Some(n),
                e: Some(e),
                crv: None,
                x: None,
                y: None,
                exp: None,
                created: None,
            })
        }
        PublicKey::EcP256(ec_key) => {
            let point = ec_key.to_encoded_point(false);
            let x = base64_utils::encode_base64_url(point.x().ok_or_else(|| {
                AuthError::ecdsa("missing x coordinate".to_string())
            })?);
            let y = base64_utils::encode_base64_url(point.y().ok_or_else(|| {
                AuthError::ecdsa("missing y coordinate".to_string())
            })?);

            Ok(Jwk {
                kty: "EC".to_string(),
                alg: Some(alg),
                kid,
                key_use: Some("sig".to_string()),
                n: None,
                e: None,
                crv: Some("P-256".to_string()),
                x: Some(x),
                y: Some(y),
                exp: None,
                created: None,
            })
        }
        PublicKey::EcP384(ec_key) => {
            let point = ec_key.to_encoded_point(false);
            let x = base64_utils::encode_base64_url(point.x().ok_or_else(|| {
                AuthError::ecdsa("missing x coordinate".to_string())
            })?);
            let y = base64_utils::encode_base64_url(point.y().ok_or_else(|| {
                AuthError::ecdsa("missing y coordinate".to_string())
            })?);

            Ok(Jwk {
                kty: "EC".to_string(),
                alg: Some(alg),
                kid,
                key_use: Some("sig".to_string()),
                n: None,
                e: None,
                crv: Some("P-384".to_string()),
                x: Some(x),
                y: Some(y),
                exp: None,
                created: None,
            })
        }
        PublicKey::Ed25519(ed_key) => {
            let x = base64_utils::encode_base64_url(ed_key.as_bytes());

            Ok(Jwk {
                kty: "OKP".to_string(),
                alg: Some(alg),
                kid,
                key_use: Some("sig".to_string()),
                n: None,
                e: None,
                crv: Some("Ed25519".to_string()),
                x: Some(x),
                y: None,
                exp: None,
                created: None,
            })
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use key::keys;

    #[test]
    fn test_ed25519_jwk_parsing() {
        let key = keys::generate_ed25519_key().unwrap();

        // Convert the private key's public key to JWK
        match key.public_key() {
            keys::PublicKey::Ed25519(ed_key) => {
                let x = base64_utils::encode_base64_url(ed_key.as_bytes());

                let jwk = Jwk {
                    kty: "OKP".to_string(),
                    alg: Some("EdDSA".to_string()),
                    kid: key.id().to_string(),
                    key_use: Some("sig".to_string()),
                    n: None,
                    e: None,
                    crv: Some("Ed25519".to_string()),
                    x: Some(x),
                    y: None,
                    exp: None,
                    created: None,
                };

                let immutable_jwk = ImmutableJwk::new(jwk).unwrap();
                assert_eq!(immutable_jwk.alg(), "EdDSA");
                assert_eq!(immutable_jwk.kty(), KeyType::Okp);
            }
            _ => panic!("Expected Ed25519 key"),
        }
    }

    // A 2048-bit RSA JWK: the modulus only has to be a valid key size for
    // ImmutableJwk::new, nothing here verifies with it.
    fn rsa_jwk(alg: Option<&str>) -> Jwk {
        Jwk {
            kty: "RSA".to_string(),
            alg: alg.map(str::to_string),
            kid: "rsa".to_string(),
            key_use: None,
            n: Some(base64_utils::encode_base64_url(&[0xff; 256])),
            e: Some(base64_utils::encode_base64_url(&[0x01, 0x00, 0x01])),
            crv: None,
            x: None,
            y: None,
            exp: None,
            created: None,
        }
    }

    fn jwk_of(key: &keys::ImmutableKey, alg: Option<&str>) -> Jwk {
        Jwk {
            alg: alg.map(str::to_string),
            ..public_key_to_jwk(key.id().to_string(), String::new(), key.public_key()).unwrap()
        }
    }

    // Issue #179: a key without alg accepts its whole family and reports no
    // alg; the RSA key size no longer guesses one.
    #[test]
    fn test_no_alg_jwk_accepts_its_family() {
        let rsa = ImmutableJwk::new(rsa_jwk(None)).unwrap();
        assert_eq!(rsa.accepted_algs(), ["RS256", "RS384", "RS512"]);
        assert_eq!(rsa.alg(), "");
        assert!(rsa.jwk().alg.is_none());

        let p256 = ImmutableJwk::new(jwk_of(&keys::generate_ec_p256_key().unwrap(), None)).unwrap();
        assert_eq!(p256.accepted_algs(), ["ES256"]);
        assert_eq!(p256.alg(), "");
        let p384 = ImmutableJwk::new(jwk_of(&keys::generate_ec_p384_key().unwrap(), None)).unwrap();
        assert_eq!(p384.accepted_algs(), ["ES384"]);
        let okp = ImmutableJwk::new(jwk_of(&keys::generate_ed25519_key().unwrap(), None)).unwrap();
        assert_eq!(okp.accepted_algs(), ["EdDSA"]);
        assert!(okp.jwk().alg.is_none());
    }

    // A declared alg narrows the set to itself, and must be exactly one of the
    // key's family: anything else refuses the JWK instead of being overwritten.
    #[test]
    fn test_declared_alg_must_be_in_family() {
        let rs256 = ImmutableJwk::new(rsa_jwk(Some("RS256"))).unwrap();
        assert_eq!(rs256.accepted_algs(), ["RS256"]);
        assert_eq!(rs256.alg(), "RS256");

        let empty = ImmutableJwk::new(rsa_jwk(Some(""))).unwrap();
        assert_eq!(empty.accepted_algs(), ["RS256", "RS384", "RS512"]);

        for alg in ["ES256", "PS256", "none", "HS256", "rs256"] {
            assert!(ImmutableJwk::new(rsa_jwk(Some(alg))).is_err(), "RSA key declaring {:?}", alg);
        }
        let p256 = keys::generate_ec_p256_key().unwrap();
        for alg in ["ES384", "RS256", "EdDSA"] {
            assert!(ImmutableJwk::new(jwk_of(&p256, Some(alg))).is_err(), "P-256 key declaring {}", alg);
        }
        let okp = keys::generate_ed25519_key().unwrap();
        assert!(ImmutableJwk::new(jwk_of(&okp, Some("ES256"))).is_err());
    }
}
