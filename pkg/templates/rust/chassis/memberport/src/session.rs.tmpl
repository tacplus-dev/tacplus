        Self { code, reason: reason.into() }
    }
}

impl std::fmt::Display for RefusedStream {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} ({:?})", self.reason, self.code)
    }
}

enum Rotation {
    Rotated(i64),
    Retry,
    Dropped,
}

/// Opens the first stream of a local connection; on any refusal, resets it.
pub(crate) async fn open_outbound(
    inner: Arc<Inner>,
    channel: tonic::transport::Channel,
    remote: SocketAddr,
    plain: TcpStream,
) {
    let (tx, rx, id) = match open_leg(&inner, &channel, "").await {
        Ok(opened) => opened,
        Err(e) => {
            tracing::warn!(remote = %remote, reason = %e, "member port: tunnel refused");
            reset(plain);
            return;
        }
    };
    let (leg_id, exp_millis) = (tx.state.id, tx.state.exp_millis);
    let s = Session::new(&inner, true, String::new(), id);
    s.start(tx, rx, plain);
    if !s.is_done() {
        s.watch_client_leg(leg_id, exp_millis);
        tokio::spawn(s.clone().rotations(inner, channel, exp_millis));
    }
}

/// Opens a stream with the current token; an UNAUTHENTICATED refusal is
/// retried once with a fresh one, PERMISSION_DENIED never.
async fn open_leg(
    inner: &Arc<Inner>,
    channel: &tonic::transport::Channel,
    joining: &str,
) -> Result<(LegTx, LegRx, String), RefusedStream> {
    let token = own_token(inner).await?;
    match open_once(inner, channel, joining, &token).await {
        Err(e) if e.code == Code::Unauthenticated => {
            let token = own_token(inner).await?;
            open_once(inner, channel, joining, &token).await
        }
        opened => opened,
    }
}

async fn own_token(inner: &Arc<Inner>) -> Result<String, RefusedStream> {
    (inner.token_source)()
        .await
        .map_err(|e| RefusedStream::new(Code::Unavailable, format!("no member token: {}", e)))
}

/// Opens one stream: its first chunk names the session it joins (empty for a
/// new one), and it is attached once the server's headers carry a member token
/// this side admits and its first chunk names the session.
async fn open_once(
    inner: &Arc<Inner>,
    channel: &tonic::transport::Channel,
    joining: &str,
    token: &str,
) -> Result<(LegTx, LegRx, String), RefusedStream> {
    let exp_millis = exp_millis_of(token).map_err(|e| RefusedStream::new(Code::Unknown, e))?;
    // The receiver's certificate is checked against this member's namespace.
    inner
        .own_namespace()
        .await
        .map_err(|r| RefusedStream::new(Code::Unavailable, r.reason))?;
    let authorization: tonic::metadata::MetadataValue<tonic::metadata::Ascii> = format!("Bearer {}", token)
        .parse()
        .map_err(|_| RefusedStream::new(Code::Unknown, "the member token is not a header value"))?;
    let (tx, rx) = mpsc::channel(LEG_BUFFER);
    let _ = tx.try_send(MemberChunk { session_id: joining.to_string(), ..Default::default() });
    let mut request = tonic::Request::new(tokio_stream::wrappers::ReceiverStream::new(rx));
    request.metadata_mut().insert("authorization", authorization);
    let attach = async {
        let mut grpc = tonic::client::Grpc::new(channel.clone())
            .max_decoding_message_size(MAX_MESSAGE_BYTES)
            .max_encoding_message_size(MAX_MESSAGE_BYTES);
        grpc.ready()
            .await
            .map_err(|e| RefusedStream::new(Code::Unavailable, format!("the receiver is unreachable: {}", e)))?;
        let path = tonic::codegen::http::uri::PathAndQuery::from_static(OPEN_PATH);
        let response = grpc
            .streaming(request, path, ChunkCodec)
            .await
            .map_err(|s| RefusedStream::new(s.code(), "the stream was refused"))?;
        let header = response.metadata().get(TOKEN_HEADER).and_then(|v| v.to_str().ok());
        inner
            .verify_peer(header)
            .await
            .map_err(|r| RefusedStream::new(Code::PermissionDenied, format!("the receiver's token: {}", r.reason)))?;
        let mut stream = response.into_inner();
        let first = match stream.message().await {
            Ok(Some(first)) => first,
            Ok(None) => return Err(RefusedStream::new(Code::Ok, "the stream ended before it was attached")),
            Err(s) => return Err(RefusedStream::new(s.code(), "the stream was refused")),
        };
        if first.session_id.is_empty()
            || !(joining.is_empty() || joining == first.session_id)
            || !first.payload.is_empty()
            || first.last
            || first.fin
        {
            return Err(RefusedStream::new(Code::PermissionDenied, "the receiver did not attach the stream"));
        }
        Ok((stream, first.session_id))
    };
    let (stream, id) = tokio::time::timeout(ADMISSION_TIMEOUT, attach)
        .await
        .map_err(|_| RefusedStream::new(Code::DeadlineExceeded, "the receiver did not attach the stream in time"))??;
    let state = LegState::new(exp_millis, None);
    Ok((LegTx { state: state.clone(), tx: Some(tx) }, LegRx { state, stream }, id))
}

impl Session {
    /// Drops the session when `leg` reaches its exp still carrying the sends.
    fn watch_client_leg(self: &Arc<Self>, leg_id: u64, exp_millis: i64) {
        let s = self.clone();
        tokio::spawn(async move {
            tokio::select! {
                _ = s.cancel.cancelled() => {}
                _ = sleep_until_millis(exp_millis) => {
                    if s.send_leg.load(Ordering::SeqCst) == leg_id {
                        s.fault("token expired without a rotation", Code::Cancelled);
                    }
                }
            }
        });
    }

    /// Rotates at ROTATE_AT of each token's lifetime until the session ends.
    async fn rotations(self: Arc<Self>, inner: Arc<Inner>, channel: tonic::transport::Channel, mut exp_millis: i64) {
        let mut delay = rotate_delay(exp_millis);
        loop {
            tokio::select! {
                _ = self.cancel.cancelled() => return,
                _ = tokio::time::sleep(delay) => {}
            }
            if self.is_done() || self.both_fins() {
                return;
            }
            match self.rotate(&inner, &channel, exp_millis).await {
                Rotation::Rotated(next_exp) => {
                    exp_millis = next_exp;
                    delay = rotate_delay(next_exp);
                }
                Rotation::Retry => delay = ROTATE_RETRY,
                Rotation::Dropped => return,
            }
        }
    }

    /// Make-before-break: a new token, a new stream joining this session,
    /// then the cutover. A mint that fails or returns no newer token is
    /// retried until the current token expires, when the session drops.
    async fn rotate(self: &Arc<Self>, inner: &Arc<Inner>, channel: &tonic::transport::Channel, current_exp: i64) -> Rotation {
        let token = match (inner.token_source)().await {
            Ok(token) => token,
            Err(e) => {
                tracing::warn!(error = %e, "member port: token mint for a rotation failed, retrying");
                return Rotation::Retry;
            }
        };
        match exp_millis_of(&token) {
            Ok(exp) if exp > current_exp => {}
            // No newer token yet: the identity cache renews it ahead of expiry.
            Ok(_) => return Rotation::Retry,
            Err(e) => {
                tracing::warn!(error = %e, "member port: rotation failed, retrying");
                return Rotation::Retry;
            }
        }
        let id = self.id();
        let opened = match open_once(inner, channel, &id, &token).await {
            Err(e) if e.code == Code::Unauthenticated => match own_token(inner).await {
                Ok(fresh) => open_once(inner, channel, &id, &fresh).await,
                Err(e) => Err(e),
            },
            opened => opened,
        };
        let (tx, rx, _) = match opened {
            Ok(opened) => opened,
            Err(e) if e.code == Code::Unauthenticated || e.code == Code::PermissionDenied => {
                self.fault(&format!("rotation refused: {}", e), Code::Cancelled);
                return Rotation::Dropped;
            }
            Err(e) => {
                tracing::warn!(reason = %e, "member port: rotation failed, retrying");
                return Rotation::Retry;
            }
        };
        let (leg_id, exp) = (tx.state.id, tx.state.exp_millis);
        self.pending.lock().unwrap().next = Some(NextLeg { rx, tx: None });
        if self.is_done() {
            self.pending.lock().unwrap().next.take();
            return Rotation::Dropped;
        }
        if !self.cutover(tx).await {
            return Rotation::Dropped;
        }
        self.watch_client_leg(leg_id, exp);
        Rotation::Rotated(exp)
    }
}

fn rotate_delay(exp_millis: i64) -> Duration {
    let left = (exp_millis - now_millis()).max(0) as f64;
    Duration::from_millis((left * ROTATE_AT) as u64).max(ROTATE_MIN)
}
