.map_err(|e| format!("Failed to parse YAML: {}", e))?;
normalize_yaml_numbers(&mut v);
{{- if .NeedsNormalization}}
normalize_{{.SnakeName}}_enums(&mut v);
{{- end}}
serde_json::from_value(v)
.map_err(|e| format!("Failed to deserialize: {}", e))
}
/// Creates {{.TypeName}} from binary protobuf bytes.
pub fn {{.SnakeName}}_from_binary(data: &[u8]) -> Result<{{.TypeName}}, String> {
{{.TypeName}}::decode(data)
.map_err(|e| format!("Failed to decode protobuf: {}", e))
}
