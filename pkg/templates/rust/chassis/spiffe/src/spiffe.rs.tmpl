/// Parses and validates a full SPIFFE ID, failing closed on malformed input.
pub fn parse_spiffe_id(value: &str) -> Result<ParsedSpiffeId> {
    let mut p = ParsedSpiffeId::default();
    let v = value.trim();
    let prefix = format!("{}://", SCHEME);
    if !v.starts_with(&prefix) {
        return err(format!("spiffe: missing {:?} scheme: {:?}", prefix, value));
    }
    let rest = &v[prefix.len()..];
    reject_dangerous(rest)?;
    if rest.contains(['?', '#', '\\']) {
        return err(format!("spiffe: query, fragment, or backslash not allowed: {:?}", value));
    }
    let (td, path_str) = match rest.find('/') {
        Some(i) => (&rest[..i], &rest[i + 1..]),
        None => (rest, ""),
    };
    if td.is_empty() {
        return err(format!("spiffe: empty trust domain: {:?}", value));
    }
    if td.contains(['/', '\\', '?', '#']) {
        return err(format!("spiffe: malformed trust domain: {:?}", value));
    }
    p.scheme = SCHEME.to_string();
    p.trust_domain = td.to_string();

    if path_str.is_empty() {
        p.namespace = "/".to_string();
        return Ok(p);
    }
    let segs: Vec<&str> = path_str.split('/').collect();
    for s in &segs {
        if s.is_empty() {
            return err(format!("spiffe: empty path segment in {:?}", value));
        }
        if *s == "." || *s == ".." {
            return err(format!("spiffe: dot segment not allowed in {:?}", value));
        }
        if !segment_re().is_match(s) {
            return err(format!("spiffe: path segment {:?} violates grammar in {:?}", s, value));
        }
    }
    p.path_segments = segs.iter().map(|s| s.to_string()).collect();

    classify(&mut p, &segs)?;
    Ok(p)
}

fn classify(p: &mut ParsedSpiffeId, segs: &[&str]) -> Result<()> {
    let idx = tag_indexes(segs);
    if segs[0] == USERS_SEGMENT {
        classify_user_root(p, segs)
    } else if segs[0] == PEOPLE_SEGMENT {
        err(format!(
            "spiffe: the /{} root is retired; user principals are /{}/<xid>: /{}",
            PEOPLE_SEGMENT,
            USERS_SEGMENT,
            segs.join("/")
        ))
    } else if idx_of(&idx, WORKLOADS_SEGMENT) >= 0 {
        p.subject_kind = SubjectKind::Workload;
        classify_system(p, segs)
    } else if (segs[0] == SYSTEM_SEGMENT || segs[0] == TENANTS_SEGMENT) && idx_of(&idx, SERVICES_SEGMENT) >= 0 {
        p.subject_kind = SubjectKind::Service;
        classify_system(p, segs)
    } else if idx_of(&idx, USERS_SEGMENT) >= 0 {
        classify_namespaced(p, segs, idx_of(&idx, USERS_SEGMENT) as usize, SubjectKind::User)
    } else if idx_of(&idx, CLIENTS_SEGMENT) >= 0 {
        classify_namespaced(p, segs, idx_of(&idx, CLIENTS_SEGMENT) as usize, SubjectKind::Client)
    } else if idx_of(&idx, CREDENTIALS_SEGMENT) >= 0 {
        classify_pair(p, segs, idx_of(&idx, CREDENTIALS_SEGMENT) as usize, SubjectKind::Unknown)
    } else if idx_of(&idx, DATA_SEGMENT) >= 0 {
        classify_pair(p, segs, idx_of(&idx, DATA_SEGMENT) as usize, SubjectKind::Resource)
    } else {
        // Namespace-only identity (tenant/workspace/system subtree).
        validate_namespace_segments(segs)?;
        p.subject_kind = SubjectKind::Unknown;
        p.namespace = format!("/{}", segs.join("/"));
        Ok(())
    }
}

// Handles both service-root shapes: /system/<location...>/services/<svc> (shared
// services, location-agnostic) and /tenants/<tenant>/services/<svc> (tenant-owned
// services, one operator-managed instance per tenant). Namespace is everything
// before "services"; for the tenant root that's exactly "/tenants/<tenant>".
fn classify_system(p: &mut ParsedSpiffeId, segs: &[&str]) -> Result<()> {
    let si = index_of(segs, SERVICES_SEGMENT);
    if (segs[0] != SYSTEM_SEGMENT && segs[0] != TENANTS_SEGMENT) || si < 0 || (si as usize) + 1 >= segs.len() {
        return err(format!("spiffe: malformed system/service identity: /{}", segs.join("/")));
    }
    let si = si as usize;
    validate_namespace_segments(&segs[..si])?;
    if is_reserved_tag(segs[si + 1]) {
        return err(format!("spiffe: reserved tag {:?} cannot be a service name", segs[si + 1]));
    }
    let rest = &segs[si + 2..];
    if rest.len() % 2 != 0
        || rest.chunks(2).any(|c| c[0] != WORKLOADS_SEGMENT || is_reserved_tag(c[1]))
    {
        return err(format!("spiffe: malformed system/service identity: /{}", segs.join("/")));
    }
    p.location_path = segs[1..si].join("/");
    p.namespace = format!("/{}", segs[..si].join("/")); // /system[/location...]
    p.subject_path = segs[si + 1..].join("/"); // <service>[/workloads/<child>...]
    Ok(())
}

// The user root: /users/<xid>, a user principal that exists outside every tenant.
// It is exactly two segments; the xid is both the subject and the namespace leaf,
// and nothing may follow it. Its namespace, /users/<xid>, is its own subtree: it
// is not at-or-below any /tenants/... namespace and no /tenants/... namespace is
// at-or-below it.
