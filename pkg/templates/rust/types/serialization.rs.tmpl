}
/// Converts {{.TypeName}} to binary protobuf bytes.
pub fn {{.SnakeName}}_to_binary(msg: &{{.TypeName}}) -> Result<Vec<u8>, String> {
let mut buf = Vec::new();
msg.encode(&mut buf)
.map_err(|e| format!("Failed to encode protobuf: {}", e))?;
Ok(buf)
}
/// Converts {{.TypeName}} to YAML bytes.
/// Converts to JSON first, then to YAML for proper protobuf handling.
pub fn {{.SnakeName}}_to_yaml(msg: &{{.TypeName}}) -> Result<Vec<u8>, String> {
let json_data = {{.SnakeName}}_to_json(msg)?;
let v: serde_json::Value = serde_json::from_slice(&json_data)
.map_err(|e| format!("Failed to convert to YAML: {}", e))?;
serde_yaml::to_string(&v)
.map(|s| s.into_bytes())
.map_err(|e| format!("Failed to serialize to YAML: {}", e))
}
/// Converts {{.TypeName}} to TOML bytes.
/// Converts to JSON first, then to TOML for proper protobuf handling.
pub fn {{.SnakeName}}_to_toml(msg: &{{.TypeName}}) -> Result<Vec<u8>, String> {
let json_data = {{.SnakeName}}_to_json(msg)?;
let obj: toml::Value = serde_json::from_slice(&json_data)
.map_err(|e| format!("Failed to convert to TOML: {}", e))?;
toml::to_string(&obj)
.map(|s| s.into_bytes())
.map_err(|e| format!("Failed to serialize to TOML: {}", e))
}
/// Creates {{.TypeName}} from TOML bytes.
pub fn {{.SnakeName}}_from_toml(data: &[u8]) -> Result<{{.TypeName}}, String> {
let s = std::str::from_utf8(data)
.map_err(|e| format!("Invalid UTF-8 in TOML: {}", e))?;
let toml_val: toml::Value = toml::from_str(s)
.map_err(|e| format!("Failed to parse TOML: {}", e))?;
let json_data = serde_json::to_vec(&toml_val)
.map_err(|e| format!("Failed to convert TOML to JSON: {}", e))?;
{{.SnakeName}}_from_json(&json_data)
}
/// Creates {{.TypeName}} from bytes, auto-detecting the format.
/// Supports JSON, YAML, TOML, and binary protobuf formats.
/// Tries JSON first (if starts with '{'), then TOML, then YAML, then binary.
/// Empty bytes are treated as binary protobuf (default message).
pub fn {{.SnakeName}}_from_bytes(data: &[u8]) -> Result<{{.TypeName}}, String> {
// Empty data is valid for protobuf (represents default message)
if data.is_empty() {
return Ok({{.TypeName}}::default());
}
// Trim leading whitespace to check format
let trimmed = data.iter().skip_while(|&&b| b.is_ascii_whitespace()).copied().collect::<Vec<_>>();
if trimmed.is_empty() {
// Only whitespace - treat as default message
return Ok({{.TypeName}}::default());
}
// Try JSON first (starts with '{' or '[')
if trimmed[0] == b'{' || trimmed[0] == b'[' {
if let Ok(msg) = {{.SnakeName}}_from_json(data) {
return Ok(msg);
}
}
// Try TOML (before YAML since YAML is more permissive)
if let Ok(msg) = {{.SnakeName}}_from_toml(data) {
return Ok(msg);
}
// Try YAML
if let Ok(msg) = {{.SnakeName}}_from_yaml(data) {
return Ok(msg);
}
// Try binary protobuf
{{.TypeName}}::decode(data)
.map_err(|e| format!("Failed to parse: unsupported format or invalid data: {}", e))
}
/// Creates {{.TypeName}} from JSON bytes.
pub fn {{.SnakeName}}_from_json(data: &[u8]) -> Result<{{.TypeName}}, String> {
{{- if .NeedsNormalization}}
let mut v: serde_json::Value = serde_json::from_slice(data)
.map_err(|e| format!("Failed to parse JSON: {}", e))?;
normalize_{{.SnakeName}}_enums(&mut v);
serde_json::from_value(v)
.map_err(|e| format!("Failed to deserialize: {}", e))
{{- else}}
serde_json::from_slice(data)
.map_err(|e| format!("Failed to parse JSON: {}", e))
{{- end}}
}
/// Creates {{.TypeName}} from YAML bytes.
pub fn {{.SnakeName}}_from_yaml(data: &[u8]) -> Result<{{.TypeName}}, String> {
