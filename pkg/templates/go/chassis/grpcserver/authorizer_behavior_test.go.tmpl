// PigeonServicePath admits every pigeon and nothing else: not the parent
// service, not another workload kind, not a pigeon run id with uppercase.
func TestPigeonServicePathMatchesPigeonsOnly(t *testing.T) {
	re := regexp.MustCompile("^(?:" + PigeonServicePath + ")$")
	for _, p := range []string{"beagle/workloads/pigeon-01arz3ndektsv4rrffq69g5fav", "llmproxy/workloads/pigeon-0000"} {
		if !re.MatchString(p) {
			t.Errorf("PigeonServicePath must match %q", p)
		}
	}
	for _, p := range []string{"beagle", "beagle/workloads/agent-42", "beagle/workloads/pigeon-01ARZ3", "beagle/extra/workloads/pigeon-01arz3"} {
		if re.MatchString(p) {
			t.Errorf("PigeonServicePath must not match %q", p)
		}
	}
}

// PigeonServicePathFor scopes the pattern to one parent service, and quotes the
// parent so a dot in the name is literal.
func TestPigeonServicePathForScopesToParent(t *testing.T) {
	re := regexp.MustCompile("^(?:" + PigeonServicePathFor("beagle") + ")$")
	if !re.MatchString("beagle/workloads/pigeon-01arz3ndektsv4rrffq69g5fav") {
		t.Error("PigeonServicePathFor(beagle) must match a beagle pigeon")
	}
	if re.MatchString("llmproxy/workloads/pigeon-01arz3ndektsv4rrffq69g5fav") {
		t.Error("PigeonServicePathFor(beagle) must not match another parent's pigeon")
	}
	dotted := regexp.MustCompile("^(?:" + PigeonServicePathFor("a.b") + ")$")
	if dotted.MatchString("axb/workloads/pigeon-01arz3") {
		t.Error("PigeonServicePathFor must quote the parent: a.b must not match axb")
	}
}

// PigeonServicePath used as an auth_services pattern admits a pigeon workload
