// FormBodyToJSON turns a FormBody route's application/x-www-form-urlencoded
// request body into the JSON object the JSON request path takes: each pair
// becomes one string, keyed by proto field name, and a field left out is left
// unset. Any other route or content type returns the body unchanged, so a JSON
// request to a form route is served exactly as before. A key sent more than
// once is refused instead of letting one copy win. Pairs are split on "&"
// only, as the Rust and Java planes do; a ";" is value content.
func FormBodyToJSON(route *RouteInfo, contentType string, body []byte) ([]byte, *HTTPError) {
	mediaType, _, _ := mime.ParseMediaType(contentType)
	if !route.FormBody || !strings.EqualFold(mediaType, "application/x-www-form-urlencoded") {
		return body, nil
	}
	fields := make(map[string]string)
	for _, pair := range strings.Split(string(body), "&") {
		if pair == "" {
			continue
		}
		rawKey, rawValue, _ := strings.Cut(pair, "=")
		key, err := url.QueryUnescape(rawKey)
		if err != nil {
			return nil, httpError(http.StatusBadRequest, fmt.Sprintf("invalid form body: %v", err))
		}
		value, err := url.QueryUnescape(rawValue)
		if err != nil {
			return nil, httpError(http.StatusBadRequest, fmt.Sprintf("invalid form body: %v", err))
		}
		if _, dup := fields[key]; dup {
			return nil, httpError(http.StatusBadRequest, fmt.Sprintf("invalid form body: field %s sent more than once", key))
		}
		fields[key] = value
	}
	encoded, err := json.Marshal(fields)
	if err != nil {
		return nil, httpError(http.StatusInternalServerError, fmt.Sprintf("failed to encode form body: %v", err))
	}
	return encoded, nil
}

// RedirectResponse answers a RedirectField route with 303 See Other to the URL
// its JSON response carries in that field, with Cache-Control: no-store, in
// place of the JSON body, and reports true. It reports false without writing
// for any other route, so the caller answers JSON as before. A response
// without a usable URL in the field, or with one that is not a valid header
// value, is a backend fault.
func RedirectResponse(route *RouteInfo, responseJSON string, w http.ResponseWriter) bool {
	if route.RedirectField == "" {
		return false
	}
	var fields map[string]json.RawMessage
	var location string
	if err := json.Unmarshal([]byte(responseJSON), &fields); err == nil {
		raw, ok := fields[route.RedirectField]
		if !ok {
			raw = fields[route.RedirectFieldProto]
		}
		_ = json.Unmarshal(raw, &location)
	}
	if location == "" || !validHeaderValue(location) {
		httpError(http.StatusBadGateway, fmt.Sprintf("response carries no redirect URL in %s", route.RedirectField)).Write(w)
		return true
	}
	w.Header().Set("Location", location)
	w.Header().Set("Cache-Control", "no-store")
	w.WriteHeader(http.StatusSeeOther)
	return true
}

// validHeaderValue reports whether s may be sent as an HTTP header value: no
// control characters and no bytes outside visible ASCII, the same test the
// Rust plane applies before answering a redirect.
func validHeaderValue(s string) bool {
	for i := 0; i < len(s); i++ {
		if c := s[i]; c < 0x20 || c > 0x7e {
			return false
		}
	}
	return true
}

