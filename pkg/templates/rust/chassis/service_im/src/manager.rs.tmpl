        attempt += 1;
        match exchange().await {
            Ok(tok) => return Ok(tok),
            Err(e) if e.is::<WorkloadRevoked>() => return Err(e),
            Err(e) => {
                let elapsed_s = start.elapsed().as_secs();
                if Instant::now() >= deadline {
                    error!("IM: initial token exchange timed out after {} attempts ({}s): {}", attempt, elapsed_s, e);
