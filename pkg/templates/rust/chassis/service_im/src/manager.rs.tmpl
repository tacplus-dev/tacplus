    const MAX_DELAY: Duration = Duration::from_secs(30);
    const TOTAL_TIMEOUT: Duration = Duration::from_secs(300);

    let start = Instant::now();
    let deadline = start + TOTAL_TIMEOUT;
    let mut delay = INITIAL_DELAY;
    let mut attempt: u32 = 0;
