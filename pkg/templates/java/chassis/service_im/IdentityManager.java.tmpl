        if (LAST_COUNTED_GENERATION.getAndSet(gen) != gen) {
            CONSECUTIVE_REJECTIONS.incrementAndGet();
        }
        REJECTION_GENERATION.incrementAndGet();

        Runnable r;
        synchronized (AUTH_RECOVERY_LOCK) {
            r = credentialInvalidator;
        }
        if (r != null) {
            LOG.warning("credential was rejected — dropping the cached token so the next attempt re-mints");
            r.run();
        }
    }

