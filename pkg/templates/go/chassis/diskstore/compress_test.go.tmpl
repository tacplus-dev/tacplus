func TestCodecFromProtoI32(t *testing.T) {
	if CodecFromProtoI32(1) != CodecGz {
		t.Fatalf("1 should map to Gz")
	}
	if CodecFromProtoI32(2) != CodecBz {
		t.Fatalf("2 should map to Bz")
	}
	if CodecFromProtoI32(0) != CodecNone {
		t.Fatalf("0 should map to None")
	}
}
