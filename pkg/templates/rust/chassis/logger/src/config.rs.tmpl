#[derive(Clone)]
enum LogTarget {
    Stdout,
    Stderr,
    File {
        path: String,
        file: Arc<Mutex<File>>,
    },
}

impl LogTarget {
    fn key(&self) -> String {
        match self {
            Self::Stdout => "stdout".to_string(),
            Self::Stderr => "stderr".to_string(),
            Self::File { path, .. } => format!("file:{path}"),
        }
    }

    fn write_all(&self, data: &[u8]) -> io::Result<()> {
        match self {
            Self::Stdout => {
                let mut out = io::stdout().lock();
                out.write_all(data)?;
                out.flush()
            }
            Self::Stderr => {
                let mut err = io::stderr().lock();
                err.write_all(data)?;
                err.flush()
            }
            Self::File { file, .. } => {
                let mut guard = file
                    .lock()
                    .map_err(|_| io::Error::new(io::ErrorKind::Other, "log file mutex poisoned"))?;
                guard.write_all(data)?;
                guard.flush()
            }
        }
    }
}

#[derive(Clone)]
struct LoggerMakeWriter {
    output_targets: Arc<Vec<LogTarget>>,
    error_targets: Arc<Vec<LogTarget>>,
    initial_fields: Arc<Vec<(String, String)>>,
    json: bool,
    pretty_print: bool,
}

impl LoggerMakeWriter {
    fn new(
        output_targets: Vec<LogTarget>,
        error_targets: Vec<LogTarget>,
        initial_fields: Vec<(String, String)>,
        json: bool,
        pretty_print: bool,
    ) -> Self {
        Self {
            output_targets: Arc::new(output_targets),
            error_targets: Arc::new(error_targets),
            initial_fields: Arc::new(initial_fields),
            json,
            pretty_print,
        }
    }

    fn writer_for(&self, metadata: Option<&Metadata<'_>>) -> LoggerWriter {
        let mut targets = Vec::new();
        let mut seen = HashSet::new();

        for target in self.output_targets.iter() {
            if seen.insert(target.key()) {
                targets.push(target.clone());
            }
        }

        if metadata.map(|m| *m.level() == Level::ERROR).unwrap_or(false) {
            for target in self.error_targets.iter() {
                if seen.insert(target.key()) {
                    targets.push(target.clone());
                }
            }
        }

        LoggerWriter {
            targets,
            initial_fields: self.initial_fields.clone(),
            json: self.json,
            pretty_print: self.pretty_print,
            buffer: Vec::new(),
        }
    }
}

impl<'a> MakeWriter<'a> for LoggerMakeWriter {
    type Writer = LoggerWriter;

    fn make_writer(&'a self) -> Self::Writer {
        self.writer_for(None)
    }

    fn make_writer_for(&'a self, meta: &Metadata<'_>) -> Self::Writer {
        self.writer_for(Some(meta))
    }
}

struct LoggerWriter {
    targets: Vec<LogTarget>,
    initial_fields: Arc<Vec<(String, String)>>,
    json: bool,
    pretty_print: bool,
    buffer: Vec<u8>,
}

impl LoggerWriter {
    fn flush_buffer(&mut self) -> io::Result<()> {
        if self.buffer.is_empty() {
            return Ok(());
        }

        let payload = format_payload(
            std::mem::take(&mut self.buffer),
            &self.initial_fields,
            self.json,
            self.pretty_print,
        );

        // Structural credential redaction at the output boundary.
        let redacted = crate::redact::redact_credentials(&String::from_utf8_lossy(&payload));

        for target in &self.targets {
            target.write_all(redacted.as_bytes())?;
        }

        Ok(())
    }
}

impl Write for LoggerWriter {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        self.buffer.extend_from_slice(buf);
        Ok(buf.len())
    }

    fn flush(&mut self) -> io::Result<()> {
        self.flush_buffer()
    }
}

impl Drop for LoggerWriter {
    fn drop(&mut self) {
        let _ = self.flush_buffer();
    }
}

fn format_payload(
    mut payload: Vec<u8>,
    initial_fields: &[(String, String)],
    json: bool,
    pretty_print: bool,
) -> Vec<u8> {
    if initial_fields.is_empty() && !(json && pretty_print) {
        return payload;
    }

    if json {
        let had_newline = payload.ends_with(b"\n");
        while matches!(payload.last(), Some(b'\n' | b'\r')) {
            payload.pop();
        }

        let parsed = serde_json::from_slice::<serde_json::Value>(&payload);
        if let Ok(mut value) = parsed {
            if let serde_json::Value::Object(ref mut fields) = value {
                for (key, field_value) in initial_fields {
                    fields
                        .entry(key.clone())
                        .or_insert_with(|| serde_json::Value::String(field_value.clone()));
                }
            }

            let serialized = if pretty_print {
                serde_json::to_vec_pretty(&value)
            } else {
                serde_json::to_vec(&value)
            };

            if let Ok(mut data) = serialized {
                if had_newline {
                    data.push(b'\n');
                }
                return data;
            }
        }

        if had_newline {
            payload.push(b'\n');
        }
        return payload;
    }

    let mut prefix = String::new();
    for (idx, (key, field_value)) in initial_fields.iter().enumerate() {
        if idx > 0 {
            prefix.push(' ');
        }
        let encoded = serde_json::to_string(field_value).unwrap_or_else(|_| field_value.clone());
        prefix.push_str(key);
        prefix.push('=');
        prefix.push_str(&encoded);
    }

    let mut data = Vec::with_capacity(prefix.len() + 3 + payload.len());
    data.extend_from_slice(b"[");
    data.extend_from_slice(prefix.as_bytes());
    data.extend_from_slice(b"] ");
    data.extend_from_slice(&payload);
    data
}

fn open_targets(paths: &[String], default_paths: &[&str]) -> Result<Vec<LogTarget>> {
    let selected: Vec<String> = if paths.is_empty() {
        default_paths.iter().map(|p| (*p).to_string()).collect()
    } else {
        paths.to_vec()
    };

    let mut targets = Vec::with_capacity(selected.len());
    for raw_path in selected {
        let path = raw_path.trim();
        if path.is_empty() {
            return Err(LoggerError::initialization_error(
                "log output path must not be empty",
            ));
        }

        match path.to_ascii_lowercase().as_str() {
            "stdout" => targets.push(LogTarget::Stdout),
            "stderr" => targets.push(LogTarget::Stderr),
            _ => {
                let file = OpenOptions::new()
                    .create(true)
                    .append(true)
                    .open(path)
                    .map_err(|e| {
                        LoggerError::initialization_error(format!(
                            "failed to open log output path {path}: {e}"
                        ))
                    })?;
                targets.push(LogTarget::File {
                    path: path.to_string(),
                    file: Arc::new(Mutex::new(file)),
                });
            }
        }
    }

    Ok(targets)
}

/// Load logger configuration from environment variables into the provided LoggerConfig proto message.
///
/// It reads values from environment variables named LogLevel/LogFormat and
/// populates the provided LoggerConfig proto message.
///
/// # Environment variables
///
/// * `LogLevel` - Log level (trace, debug, info, warn, error)
/// * `LogFormat` - Log format (json, console)
///
/// # Example
///
/// ```no_run
/// use logger::load_from_env;
/// use types::sys::logger::types::LoggerConfig;
///
/// let mut config = LoggerConfig::default();
/// load_from_env(&mut config).expect("Failed to load config");
/// ```
pub fn load_from_env(config: &mut proto::LoggerConfig) -> Result<()> {
    let mut errors = Vec::new();

    // Load Level (enum)
    if let Ok(v) = env::var(LOG_LEVEL_ENV_VAR) {
        if !v.is_empty() {
            // Convert user-friendly format (e.g., "debug") to proto format (e.g., "LEVEL_DEBUG")
            let proto_value = format!("LEVEL_{}", v.to_uppercase());
            match proto::Level::from_str_name(&proto_value) {
                Some(level) => {
                    config.level = level as i32;
                    tracing::debug!("config.level={} (env var {})", v, LOG_LEVEL_ENV_VAR);
                }
                None => {
                    errors.push(LoggerError::invalid_env_var(
                        LOG_LEVEL_ENV_VAR.to_string(),
                        v.clone(),
                        format!("unknown log level: {}", v),
                    ));
                }
            }
        }
    }

    // Load Format (enum)
    if let Ok(v) = env::var(LOG_FORMAT_ENV_VAR) {
        if !v.is_empty() {
            // Convert user-friendly format (e.g., "json") to proto format (e.g., "FORMAT_JSON")
            let proto_value = format!("FORMAT_{}", v.to_uppercase());
            match proto::Format::from_str_name(&proto_value) {
                Some(format) => {
                    config.format = format as i32;
                    tracing::debug!("config.format={} (env var {})", v, LOG_FORMAT_ENV_VAR);
                }
                None => {
                    errors.push(LoggerError::invalid_env_var(
                        LOG_FORMAT_ENV_VAR.to_string(),
                        v.clone(),
                        format!("unknown log format: {}", v),
                    ));
                }
            }
        }
    }

    if !errors.is_empty() {
        return Err(errors.into_iter().next().unwrap());
    }

    Ok(())
}

/// Convert a proto Level to a tracing::Level.
///
/// This is used internally to configure the tracing subscriber with the correct level.
///
/// # Mapping
///
/// * `LEVEL_TRACE` → `tracing::Level::TRACE`
/// * `LEVEL_DEBUG` → `tracing::Level::DEBUG`
/// * `LEVEL_INFO` → `tracing::Level::INFO`
/// * `LEVEL_WARN` → `tracing::Level::WARN`
/// * `LEVEL_ERROR` → `tracing::Level::ERROR`
/// * `LEVEL_UNDEFINED` → `tracing::Level::INFO` (default)
pub fn level_to_tracing_level(level: proto::Level) -> tracing::Level {
    match level {
        proto::Level::Trace => {
            set_log_level_trace(true);
            tracing::Level::TRACE
        }
        proto::Level::Debug => tracing::Level::DEBUG,
        proto::Level::Info => tracing::Level::INFO,
        proto::Level::Warn => tracing::Level::WARN,
        proto::Level::Error => tracing::Level::ERROR,
        proto::Level::Undefined => tracing::Level::INFO,
    }
}

/// Convert a proto Format to an encoding string.
///
/// This is used internally to configure the tracing subscriber with the correct encoding.
///
/// # Mapping
///
/// * `FORMAT_JSON` → "json"
/// * `FORMAT_CONSOLE` → "console"
/// * `FORMAT_UNDEFINED` → "json" (default)
pub fn format_to_encoding(format: proto::Format) -> &'static str {
    match format {
        proto::Format::Json => "json",
        proto::Format::Console => "console",
        proto::Format::Undefined => "json",
    }
}

/// Install a global tracing subscriber based on the provided LoggerConfig proto message.
///
/// It configures the logger with all settings from the config and installs the global tracing subscriber.
///
/// # Configuration applied
///
/// * Format (JSON or console)
/// * Level (trace, debug, info, warn, error)
/// * Development mode settings
/// * Pretty printing for JSON
/// * Output paths (stdout, stderr, file paths)
/// * Caller information inclusion
/// * Initial fields added to every log entry
///
/// # Example
///
/// ```no_run
/// use logger::install_from_config;
/// use types::sys::logger::types::{LoggerConfig, Format, Level};
///
/// let config = LoggerConfig {
///     format: Format::Json.into(),
///     level: Level::Debug.into(),
///     development: true,
///     output_paths: vec!["stdout".to_string()],
///     ..Default::default()
/// };
/// install_from_config(&config).expect("Failed to install logger");
/// ```
pub fn install_from_config(config: &proto::LoggerConfig) -> Result<()> {
    // A bootstrap install is not a reason to stop: it exists precisely so this
    // typed config can be applied afterwards, by swapping the reload layer.
    // Only a non-reloadable subscriber (someone else's) means there is nothing
    // to do here.
    //
    // `mark_installed()` used to run HERE, before the install was attempted, so
    // a failed install still marked the logger as installed.
    if is_installed() && !crate::state::has_reload_handle() {
        return Ok(());
    }

    let level = level_to_tracing_level(config.level());
    let encoding = if config.format() == proto::Format::Undefined && config.development {
        "console"
    } else {
        format_to_encoding(config.format())
    };
    let output_targets = open_targets(&config.output_paths, &["stderr"])?;
    let error_targets = open_targets(&config.error_output_paths, &[])?;
    let initial_fields = config
        .initial_fields
        .iter()
        .map(|(k, v)| (k.clone(), v.clone()))
        .collect::<Vec<_>>();

    // Create env filter. Transport-layer loggers (h2, hyper, tonic) are pinned to
    // WARN because at DEBUG/TRACE they emit raw HTTP/2 frame data including
    // authorization headers with live service JWTs. The pins are added AFTER the
    // default env filter so they override any RUST_LOG=trace setting. These MUST
    // stay in step with `Logger::install` in logger.rs — this is the config-driven
    // entry point and reaches production through grpcconfig's load_config, so a pin
    // present in only one of the two installs is a live credential leak on whichever
    // path runs. New crates added to the transport stack should be added to both.
    let env_filter = EnvFilter::from_default_env()
        .add_directive(level.into())
        .add_directive("h2=warn".parse().unwrap())
        .add_directive("hyper=warn".parse().unwrap())
        .add_directive("tonic::transport=warn".parse().unwrap());

    use tracing_subscriber::Layer as _;

    // Configure based on format. Each arm EVALUATES to the layer rather than
    // assigning it, so there is no half-initialised state to reason about.
    let layer: crate::state::BoxedLayer = match encoding {
        "console" => {
            let writer = LoggerMakeWriter::new(
                output_targets,
                error_targets,
                initial_fields,
                false,
                config.pretty_print,
            );

            if config.pretty_print {
                let fmt_layer = tracing_subscriber::fmt::layer()
                    .pretty()
                    .with_writer(writer)
                    .with_target(true)
                    .with_thread_ids(false)
                    .with_thread_names(false)
                    .with_file(!config.disable_caller)
                    .with_line_number(!config.disable_caller)
                    .with_span_events(FmtSpan::NONE);

                Box::new(fmt_layer.with_filter(env_filter)) as crate::state::BoxedLayer
            } else {
                let fmt_layer = tracing_subscriber::fmt::layer()
                    .with_writer(writer)
                    .with_target(true)
                    .with_thread_ids(false)
                    .with_thread_names(false)
                    .with_file(!config.disable_caller)
                    .with_line_number(!config.disable_caller)
                    .with_span_events(FmtSpan::NONE);

                Box::new(fmt_layer.with_filter(env_filter)) as crate::state::BoxedLayer
            }
        }
        "json" => {
            let writer = LoggerMakeWriter::new(
                output_targets,
                error_targets,
                initial_fields,
                true,
                config.pretty_print,
            );
            let fmt_layer = tracing_subscriber::fmt::layer()
                .json()
                .with_writer(writer)
                .with_target(true)
                .with_current_span(false)
                .with_span_list(false)
                .with_file(!config.disable_caller)
                .with_line_number(!config.disable_caller);

            Box::new(fmt_layer.with_filter(env_filter)) as crate::state::BoxedLayer
        }
        _ => {
            return Err(LoggerError::initialization_error(format!(
                "Unknown encoding: {}",
                encoding
            )));
        }
    };

    // Swap the bootstrap layer when one is installed; otherwise this call is the
    // first install in the process and takes the subscriber itself. The SAME
    // configured layer is used either way — rebuilding a default one on the
    // fallback path would silently drop the configured format, writer and
    // output paths.
    if crate::state::has_reload_handle() {
        if !crate::state::reload_layer(layer) {
            return Err(LoggerError::initialization_error(
                "reloading the configured logger layer failed",
            ));
        }
        mark_installed();
        return Ok(());
    }

    tracing_subscriber::registry()
        .with(layer)
        .try_init()
        .map_err(|e| LoggerError::initialization_error(e.to_string()))?;
    mark_installed();
    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_level_to_tracing_level() {
        // Reset trace flag
        set_log_level_trace(false);

        assert_eq!(
            level_to_tracing_level(proto::Level::Trace),
            tracing::Level::TRACE
        );
        assert!(crate::state::is_log_level_trace());

        set_log_level_trace(false);
        assert_eq!(
            level_to_tracing_level(proto::Level::Debug),
            tracing::Level::DEBUG
        );
        assert!(!crate::state::is_log_level_trace());

        assert_eq!(
            level_to_tracing_level(proto::Level::Info),
            tracing::Level::INFO
        );
        assert_eq!(
            level_to_tracing_level(proto::Level::Warn),
            tracing::Level::WARN
        );
        assert_eq!(
            level_to_tracing_level(proto::Level::Error),
            tracing::Level::ERROR
        );
        assert_eq!(
            level_to_tracing_level(proto::Level::Undefined),
            tracing::Level::INFO
        );
    }

    #[test]
    fn test_format_to_encoding() {
        assert_eq!(format_to_encoding(proto::Format::Json), "json");
        assert_eq!(format_to_encoding(proto::Format::Console), "console");
        assert_eq!(format_to_encoding(proto::Format::Undefined), "json");
    }

}
// -----------------------------------------------------------------------------
// Bootstrap install
// -----------------------------------------------------------------------------

/// Env filter with the transport-layer pins applied.
///
/// h2, hyper and tonic are pinned to WARN because at DEBUG/TRACE they emit raw
/// HTTP/2 frame data including authorization headers with live service JWTs.
/// The pins go on AFTER the default env filter so they override RUST_LOG=trace.
/// Every install path must use this — a pin present on only one path is a live
/// credential leak on whichever path runs.
fn pinned_filter(level: Level) -> EnvFilter {
    EnvFilter::from_default_env()
        .add_directive(level.into())
        .add_directive("h2=warn".parse().unwrap())
        .add_directive("hyper=warn".parse().unwrap())
        .add_directive("tonic::transport=warn".parse().unwrap())
}

/// Install a redacting logger IMMEDIATELY, before any config is available, and
/// keep it swappable.
///
/// Services must call this instead of building their own `tracing_subscriber`.
/// `tracing` permits exactly one global subscriber per process, so a service
/// that installs its own wins permanently and the chassis's config-driven
/// install can only fail — which is precisely what happened: every rust service
/// called `tracing_subscriber::fmt().init()` in main, the chassis's later
/// `install_from_config` hit `try_init()` and errored, the error was discarded
/// by its caller, and the redacting layer never received a single line. The
/// `[REDACTED]` machinery was linked into six service binaries and was dead.
///
/// Installing through the reload layer here means redaction is active from the
/// first line AND `install_from_config` can still apply the typed config later.
pub fn install_bootstrap() -> Result<()> {
    use tracing_subscriber::Layer as _;

    if is_installed() {
        return Ok(());
    }

    let level = env::var(LOG_LEVEL_ENV_VAR)
        .ok()
        .and_then(|v| v.parse::<Level>().ok())
        .unwrap_or(Level::INFO);

    let layer: crate::state::BoxedLayer = Box::new(
        tracing_subscriber::fmt::layer()
            .with_writer(crate::redact::RedactingStderrMakeWriter)
            .with_target(true)
            .with_file(true)
            .with_line_number(true)
            .with_span_events(FmtSpan::NONE)
            .with_filter(pinned_filter(level)),
    );

    let (reloadable, handle) = tracing_subscriber::reload::Layer::new(layer);
    tracing_subscriber::registry()
        .with(reloadable)
        .try_init()
        .map_err(|e| LoggerError::initialization_error(e.to_string()))?;

    crate::state::set_reload_handle(handle);
    mark_installed();
    Ok(())
}

#[cfg(test)]
mod bootstrap_install_tests {
    use super::*;

    /// The bootstrap install must leave the layer swappable, and the typed
    /// config must then actually be applied.
    ///
    /// Before this existed, every rust service installed a plain subscriber in
    /// main() and `install_from_config` could only fail — `tracing` allows one
    /// global subscriber per process. Its Result was discarded by the caller in
    /// grpcconfig's loader, so the redacting layer was linked into six service
    /// binaries and never received a line. Runtime proof at the time: those
    /// services emitted the default console format with ANSI escapes, while the
    /// java services emitted chassis JSON.
    ///
    /// One test, not several: the global subscriber is process-wide, so tests
    /// that install cannot run independently.
    #[test]
    fn bootstrap_installs_and_config_reloads_over_it() {
        install_bootstrap().expect("bootstrap install");
        assert!(
            crate::state::has_reload_handle(),
            "bootstrap must leave the layer swappable, or the typed config can never apply"
        );
        assert!(crate::state::is_installed());

        // A second bootstrap is a no-op, not an error.
        install_bootstrap().expect("bootstrap is idempotent");

        // The typed config must not be turned away just because something is
        // already installed — that early return is exactly what made the
        // config-driven logger unreachable.
        let cfg = proto::LoggerConfig {
            level: proto::Level::Debug as i32,
            format: proto::Format::Json as i32,
            output_paths: vec!["stderr".to_string()],
            ..Default::default()
        };
        install_from_config(&cfg).expect("typed config must apply over the bootstrap layer");
    }
}
