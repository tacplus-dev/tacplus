        CONSECUTIVE_REJECTIONS.set(0);
    }

    /** True when repeated re-mints have failed to produce an accepted credential. */
    public static boolean credentialsDegraded() {
        return CONSECUTIVE_REJECTIONS.get() >= DEGRADED_AFTER;
