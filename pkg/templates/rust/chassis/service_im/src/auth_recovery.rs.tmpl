//! Recovery from a rejected credential.
//!
//! The token cache hands out a token until its `exp`. That is correct when a
//! token dies of old age and WRONG when it is invalidated early — which is what
//! a restart of the token authority does. The cached token is then not expired
//! but no longer accepted, so every call fails UNAUTHENTICATED and the service
//! keeps presenting the same dead credential until the natural expiry.
//!
//! Observed: restarting the token authority (kernel, in the observed deployment)
//! put four services into a permanent
//! "token validation failed" storm across every path they had — TLS cert
//! renewal, node registration, health publish, state watches — and none of them
//! recovered until the pod was deleted by hand. `TokenMinter::invalidate()`
//! existed the whole time, documented as "clears all cached tokens, forcing
//! re-exchange", and was called from nowhere.
//!
//! The hook is process-global because the identity is: one service, one
//! identity, one token cache. Any component that notices a rejection therefore
//! heals every other component's next call, which matters because the retry
//! loops live in crates that cannot see each other.

use std::future::Future;
use std::pin::Pin;
use std::sync::{Arc, OnceLock};

use tokio::sync::Mutex;

/// Spelled out rather than pulled from `futures` — this crate does not depend
/// on it, and one type alias is cheaper than a new dependency in the chassis.
type Invalidator =
    Arc<dyn Fn() -> Pin<Box<dyn Future<Output = ()> + Send>> + Send + Sync>;

static INVALIDATOR: OnceLock<Mutex<Option<Invalidator>>> = OnceLock::new();

fn slot() -> &'static Mutex<Option<Invalidator>> {
    INVALIDATOR.get_or_init(|| Mutex::new(None))
}

/// Registers the process's token-cache invalidator. Called by IdentityManager.
pub async fn register_invalidator(f: Invalidator) {
    *slot().lock().await = Some(f);
}

/// True when an error means our credential was REJECTED, as opposed to the peer
/// being unreachable or the call being refused on authorization grounds.
///
/// Matched on text because the retry sites hold boxed errors rather than a
/// `tonic::Status`. Both the gRPC status name and the canonical message are
/// accepted since which one surfaces depends on the layer that formats it.
///
/// Deliberately does NOT match PERMISSION_DENIED: that means the credential was
/// understood and refused, and re-minting the same identity would just loop.
pub fn is_credential_rejection(err: &str) -> bool {
    let e = err.to_ascii_lowercase();
    e.contains("unauthenticated")
        || e.contains("does not have valid authentication credentials")
        || e.contains("token validation failed")
        || e.contains("invalid authentication credentials")
}

/// Consecutive REJECTED GENERATIONS since the last accepted call.
static CONSECUTIVE: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);

/// Bumped every time the cache is dropped, so concurrent reporters that all saw
/// the same stale token are counted once between re-mints.
static GENERATION: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(1);

/// Rejections in a row before the service reports itself unhealthy.
///
/// Not 1: a single rejection is the NORMAL and expected event when the
/// authority restarts — the very next call re-mints and succeeds, and flapping
/// the readiness endpoint for that would be worse than the problem. This
/// threshold means "re-minting is not helping", which is the state that used to
/// persist until a human deleted the pod.
const DEGRADED_AFTER: usize = 3;

/// True when repeated re-mints have failed to produce an accepted credential.
///
/// Wired to the health floor so readiness turns NOT_SERVING. Readiness reported
/// 1/1 Ready throughout a total auth outage — four services unable to make a
/// single authenticated call for fifteen minutes — because the probe only
/// asked whether the process was listening.
pub fn credentials_degraded() -> bool {
    CONSECUTIVE.load(std::sync::atomic::Ordering::Relaxed) >= DEGRADED_AFTER
}

/// Records that a credential was ACCEPTED, clearing the degraded state.
/// Called from the success paths of the same loops that report rejections.
pub fn note_credential_accepted() {
    CONSECUTIVE.store(0, std::sync::atomic::Ordering::Relaxed);
}

/// The credential generation a call must read BEFORE it is sent, and pass back
/// to `note_credential_rejection` if the call is rejected.
pub fn credential_generation() -> usize {
    GENERATION.load(std::sync::atomic::Ordering::SeqCst)
}

/// Drops the cached credentials so the next call re-mints.
///
/// `seen` is the generation the rejected call read before it was sent. Only the
/// first rejection of a generation counts and invalidates: several loops on one
/// identity that were all sent the same stale token would otherwise each count
/// as a failed re-mint. A rejection whose generation has already moved on is a
/// token that was replaced by another loop's re-mint, so it is dropped here and
/// the next call reads the new generation.
pub async fn note_credential_rejection(seen: usize) {
    if GENERATION
        .compare_exchange(seen, seen + 1, std::sync::atomic::Ordering::SeqCst, std::sync::atomic::Ordering::SeqCst)
        .is_err()
    {
        return;
    }
    CONSECUTIVE.fetch_add(1, std::sync::atomic::Ordering::Relaxed);

    let f = { slot().lock().await.clone() };
    if let Some(f) = f {
        tracing::warn!("credential was rejected — dropping the cached token so the next attempt re-mints");
        f().await;
    }
}

/// Calls `note_credential_rejection` when the error looks like a rejection.
/// Returns true when it did, so callers can log or count it.
pub async fn note_if_credential_rejection(err: &str, seen: usize) -> bool {
    if is_credential_rejection(err) {
        note_credential_rejection(seen).await;
        return true;
    }
    false
}

#[cfg(test)]
mod tests {
    use super::*;

    /// The rejection counter is process-global by design — one service, one
    /// identity — so tests that touch it must not run concurrently.
    static TEST_LOCK: tokio::sync::Mutex<()> = tokio::sync::Mutex::const_new(());

    #[test]
    fn classifies_rejections_but_not_authorization_failures() {
        assert!(is_credential_rejection(
            "code: 'The request does not have valid authentication credentials'"
        ));
        assert!(is_credential_rejection("UNAUTHENTICATED: missing authorization header"));
        assert!(is_credential_rejection("token validation failed"));

        // A refused-but-understood credential must NOT trigger a re-mint: the
        // same identity would be refused again, forever.
        assert!(!is_credential_rejection(
            "PERMISSION_DENIED: delegate spiffe://local.dev/opa not authorized for kernel"
        ));
        assert!(!is_credential_rejection("transport error: connection refused"));
        assert!(!is_credential_rejection("deadline has elapsed"));
    }

    /// A call reports the generation it read before it was sent, as the real
    /// call sites do. Each re-mint cycle bumps the generation, so a call that
    /// reads it afresh is a new attempt.
    async fn rejected_attempt() {
        note_credential_rejection(credential_generation()).await;
    }

    #[tokio::test]
    async fn degrades_only_after_repeated_rejections_and_clears_on_acceptance() {
        let _guard = TEST_LOCK.lock().await;
        note_credential_accepted();
        assert!(!credentials_degraded(), "a healthy service must not start degraded");

        // One rejection is the NORMAL authority-restart case: re-mint and carry
        // on. Flapping readiness for it would be worse than the problem.
        rejected_attempt().await;
        assert!(!credentials_degraded());
        rejected_attempt().await;
        assert!(!credentials_degraded());

        // Repeated failures mean re-minting is not helping — that is the state
        // that used to persist until a human deleted the pod.
        rejected_attempt().await;
        assert!(credentials_degraded());

        note_credential_accepted();
        assert!(!credentials_degraded(), "an accepted credential must clear the degraded state");
    }

