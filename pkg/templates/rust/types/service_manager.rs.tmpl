/// Adapter that bridges the healthreporter::HealthPublisher trait to the
/// tonic-generated ServiceHealthStateServiceClient.
struct HealthPublisherAdapter {
    client: Arc<tokio::sync::Mutex<ServiceHealthStateServiceClient<Channel>>>,
    token_provider: TokenProvider,
}

impl HealthPublisher for HealthPublisherAdapter {
    fn set_instances(
        &self,
        health: ServiceInstanceHealth,
    ) -> std::pin::Pin<Box<dyn std::future::Future<Output = Result<(), Box<dyn std::error::Error>>> + Send>> {
        let client = self.client.clone();
        let tp = self.token_provider.clone();
        Box::pin(async move {
            let token = tp().await.map_err(|e| -> Box<dyn std::error::Error> {
                format!("health reporter token error: {}", e).into()
            })?;
            let mut req = tonic::Request::new(health);
            req.metadata_mut().insert(
                "authorization",
                format!("Bearer {}", token).parse()
                    .map_err(|_| -> Box<dyn std::error::Error> { "invalid token metadata".into() })?,
            );
            let mut c = client.lock().await;
            c.set_instances(req).await
                .map_err(|e| -> Box<dyn std::error::Error> { e.into() })?;
            Ok(())
        })
    }
}

