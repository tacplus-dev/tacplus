// GetPayloadWithType returns the value of a standard JWT payload claim.
func (token *TokenWrapper) GetPayloadWithType(key tokenProto.JwtPayloadType) string {
	if token.token.Payload == nil {
		return ""
	}
	return token.token.Payload[tokenProto.JwtPayloadTypeToString(key)]
}

// SetPayloadWithType sets a standard JWT payload claim and returns the wrapper for chaining.
// Returns an error if the token is immutable (already signed).
func (token *TokenWrapper) SetPayloadWithType(key tokenProto.JwtPayloadType, value any) (*TokenWrapper, error) {
	token.checkMutable()
	token.initToken()
	token.token.Payload[tokenProto.JwtPayloadTypeToString(key)] = fmt.Sprint(value)
	return token, nil
}

