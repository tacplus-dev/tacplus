// ========================================
// ParseSamlResponse
// ========================================

// ParseSamlResponse parses a SAMLResponse from either raw XML or base64-encoded XML
// (as received in an HTTP POST form parameter).
//
// The assertion is marked immutable if a Signature element is present.
// Call Verify() to validate the signature before trusting the assertion's claims.
//
// Returns an error if the XML is malformed or missing required fields.
func ParseSamlResponse(xmlOrBase64 string) (*SamlAssertionWrapper, error) {
	xmlStr := xmlOrBase64

	// Detect base64: SAMLResponse form params are base64-encoded, raw XML starts with '<'
	trimmed := strings.TrimSpace(xmlOrBase64)
	if !strings.HasPrefix(trimmed, "<") {
		decoded, err := base64.StdEncoding.DecodeString(trimmed)
		if err != nil {
			// Try base64url (some implementations use it)
			decoded, err = base64.URLEncoding.DecodeString(trimmed)
			if err != nil {
				return nil, protoerrors.NewErrMissingInvalidData(err, "saml response is not valid XML or base64")
			}
		}
		xmlStr = string(decoded)
	}

	var resp xmlResponse
	if err := xml.Unmarshal([]byte(xmlStr), &resp); err != nil {
		return nil, protoerrors.NewErrMissingInvalidData(err, "failed to parse saml response xml")
	}

	a := resp.Assertion
	statusCode := resp.Status.StatusCode.Value
	if statusCode == "" {
		statusCode = StatusSuccess
	}

	now := formatSamlTime(time.Now().UTC())

	// Extract attributes
	attrs := make(map[string]string)
	if a.AttrStmt != nil {
		for _, attr := range a.AttrStmt.Attributes {
			if len(attr.AttributeValues) > 0 {
				vals := make([]string, 0, len(attr.AttributeValues))
				for _, av := range attr.AttributeValues {
					if av.Value != "" {
						vals = append(vals, av.Value)
					}
				}
				attrs[attr.Name] = strings.Join(vals, ",")
			}
		}
	}

	authnContext := ""
	sessionIndex := ""
	authnInstant := now
	if a.AuthnStmt != nil {
		authnContext = a.AuthnStmt.AuthnContext.ClassRef
		sessionIndex = a.AuthnStmt.SessionIndex
		authnInstant = a.AuthnStmt.AuthnInstant
	}

	p := &samlProto.SamlAssertion{
		ResponseId:          resp.ID,
		InResponseTo:        resp.InResponseTo,
		StatusCode:          statusCode,
		StatusMessage:       resp.Status.StatusMessage,
		Id:                  a.ID,
		IssueInstant:        a.IssueInstant,
		Issuer:              a.Issuer,
		SubjectNameId:       a.Subject.NameID.Value,
		NameIdFormat:        a.Subject.NameID.Format,
		SubjectRecipient:    a.Subject.SubjectConfirmation.Data.Recipient,
		SubjectNotOnOrAfter: a.Subject.SubjectConfirmation.Data.NotOnOrAfter,
		NotBefore:           a.Conditions.NotBefore,
		NotOnOrAfter:        a.Conditions.NotOnOrAfter,
		Audiences:           a.Conditions.AudienceRestriction.Audiences,
		AuthnInstant:        authnInstant,
		AuthnContext:        authnContext,
		SessionIndex:        sessionIndex,
		Attributes:          attrs,
		Xml:                 xmlStr,
	}

	hasSignature := a.Signature != nil
	return &SamlAssertionWrapper{
		proto:     p,
		immutable: hasSignature,
	}, nil
}

// ========================================
// Sign
// ========================================

// Sign signs the assertion using the provided EC P-256 private key and X.509 certificate.
//
// The signing process follows SAML 2.0 XML-DSig with enveloped signature:
//  1. Auto-populates ID (random "_"+UUID) and IssueInstant (now) if not already set
//  2. Validates required fields: Issuer, SubjectNameId, SubjectRecipient, NotOnOrAfter
//  3. Builds the canonical Assertion XML (without Signature element)
//  4. Computes SHA-256 digest over the canonical assertion bytes
//  5. Builds canonical SignedInfo XML with the digest value
//  6. Signs SHA-256(canonical SignedInfo) with ECDSA P-256
//  7. Inserts the Signature element into the assertion XML
//  8. Wraps the signed assertion in a SAMLResponse envelope
//  9. Sets proto.Xml and marks the wrapper immutable
//
// The signing certificate (cert) is embedded in ds:KeyInfo for the verifier.
// The private key (key) must be EC P-256; other key types return an error.
//
// Parameters:
//   - key: EC P-256 private key (ImmutableKey with Kty == KEY_TYPE_EC, Alg == "ES256")
//   - cert: X.509 certificate whose public key matches key (embedded in ds:KeyInfo)
//
// Returns an error if:
//   - Required fields are missing (Issuer, SubjectNameId, SubjectRecipient, NotOnOrAfter)
//   - Key is not EC P-256
//   - Signing operation fails
func (s *SamlAssertionWrapper) Sign(key *wrapperKey.ImmutableKey, cert *wrapperX509.ImmutableCert) error {
	s.checkMutable()

	if key.Alg() != "ES256" {
		return protoerrors.NewErrMissingInvalidData(nil, "saml signing requires EC P-256 key (ES256), got %s", key.Alg())
	}
	if s.proto.Issuer == "" {
		return protoerrors.NewErrMissingInvalidData(nil, "saml assertion missing Issuer")
	}
	if s.proto.SubjectNameId == "" {
		return protoerrors.NewErrMissingInvalidData(nil, "saml assertion missing SubjectNameId")
	}
	if s.proto.SubjectRecipient == "" {
		return protoerrors.NewErrMissingInvalidData(nil, "saml assertion missing SubjectRecipient (ACS URL)")
	}
	if s.proto.NotOnOrAfter == "" {
		return protoerrors.NewErrMissingInvalidData(nil, "saml assertion missing NotOnOrAfter (call SetExpiration)")
	}

	now := time.Now().UTC()

	// Auto-populate ID and timestamps if not set
	if s.proto.Id == "" {
		s.proto.Id = "_" + generateSamlID()
	}
	if s.proto.ResponseId == "" {
		s.proto.ResponseId = "_" + generateSamlID()
	}
	if s.proto.IssueInstant == "" {
		s.proto.IssueInstant = formatSamlTime(now)
	}
	if s.proto.AuthnInstant == "" {
		s.proto.AuthnInstant = s.proto.IssueInstant
	}
	if s.proto.NotBefore == "" {
		// Default: valid from 10 seconds before issue instant to guard against clock skew
		s.proto.NotBefore = formatSamlTime(now.Add(-10 * time.Second))
	}
	if s.proto.NameIdFormat == "" {
		s.proto.NameIdFormat = NameIdFormatEmail
	}
	if s.proto.AuthnContext == "" {
		s.proto.AuthnContext = AuthnContextPassword
	}
	if s.proto.StatusCode == "" {
		s.proto.StatusCode = StatusSuccess
	}

	// Step 1: Build canonical assertion XML (no Signature element yet)
	assertionXML := buildAssertionXML(s.proto)
	c14nAssertion, err := c14nElement(assertionXML)
	if err != nil {
		return protoerrors.NewErrGeneral(err, "failed to canonicalize saml assertion for signing")
	}

	// Step 2: SHA-256 digest of canonical assertion bytes
	assertionDigest := sha256.Sum256(c14nAssertion)
	digestValue := base64.StdEncoding.EncodeToString(assertionDigest[:])

	// Step 3: Build canonical SignedInfo XML
	signedInfoXML := buildSignedInfoXML(s.proto.Id, digestValue)

	// Step 4: SHA-256 of canonical SignedInfo bytes — this is the value we sign
	signedInfoDigest := sha256.Sum256([]byte(signedInfoXML))

	// Step 5: ECDSA P-256 sign
	ecKey, ok := key.PrivateKey().(*ecdsa.PrivateKey)
	if !ok {
		return protoerrors.NewErrMissingInvalidData(nil, "expected *ecdsa.PrivateKey for ES256 signing")
	}
	r, sigS, err := ecdsa.Sign(rand.Reader, ecKey, signedInfoDigest[:])
	if err != nil {
		return protoerrors.NewErrGeneral(err, "ecdsa sign failed")
	}

	// SAML XML-DSig: signature is raw r||s, each zero-padded to 32 bytes (P-256 curve size)
	signatureBytes := ecP256RawSignature(r, sigS)
	signatureValue := base64.StdEncoding.EncodeToString(signatureBytes)

	// Step 6: Embed cert DER in KeyInfo
	certDERBase64 := base64.StdEncoding.EncodeToString(cert.X509Certificate().Raw)

	// Step 7: Build Signature element and insert into assertion XML
	sigElement := buildSignatureElement(s.proto.Id, digestValue, signatureValue, certDERBase64)
	// Insert signature after </saml:Issuer> (standard SAML signature placement)
	signedAssertionXML := insertAfterIssuer(assertionXML, sigElement)

	// Step 8: Wrap in SAMLResponse
	responseXML := buildResponseXML(s.proto, signedAssertionXML)

	s.proto.Xml = responseXML
	s.MarkImmutable()
	return nil
}

// ========================================
// Verify
// ========================================

// VerifyOption configures optional SAML assertion verification checks.
type VerifyOption func(*verifyOptions)

type verifyOptions struct {
	expectedIssuer       string
	expectedAudience     string
	expectedRecipient    string
	expectedInResponseTo string
}

// WithExpectedIssuer validates the assertion Issuer matches the expected IDP entity ID.
func WithExpectedIssuer(issuer string) VerifyOption {
	return func(o *verifyOptions) { o.expectedIssuer = issuer }
}

// WithExpectedAudience validates the assertion's AudienceRestriction contains the given audience.
func WithExpectedAudience(aud string) VerifyOption {
	return func(o *verifyOptions) { o.expectedAudience = aud }
}

// WithExpectedRecipient validates the SubjectConfirmationData Recipient matches the ACS URL.
func WithExpectedRecipient(recipient string) VerifyOption {
	return func(o *verifyOptions) { o.expectedRecipient = recipient }
}

// WithExpectedInResponseTo validates the assertion's InResponseTo matches the original request ID.
func WithExpectedInResponseTo(id string) VerifyOption {
	return func(o *verifyOptions) { o.expectedInResponseTo = id }
}

// Verify validates the XML-DSig signature of a parsed SAMLResponse.
// It must be called after ParseSamlResponse on inbound (SP role) assertions.
//
// Verification steps:
//  1. Confirms the assertion was parsed with a Signature element
//  2. Extracts the Signature from the raw XML (DigestValue, SignatureValue, Reference URI)
//  3. Locates the signed Assertion element and removes the Signature child element
//  4. Applies exc-c14n to the Assertion without Signature
//  5. Verifies SHA-256 digest matches DigestValue in the Signature
//  6. Extracts and applies exc-c14n to the SignedInfo element
//  7. Verifies ECDSA P-256 signature over SHA-256(c14n(SignedInfo))
//  8. Checks Conditions NotBefore/NotOnOrAfter and SubjectConfirmation NotOnOrAfter
//  9. If expected issuer/audience/recipient options are provided, verifies they match
//  10. If WithExpectedInResponseTo is provided, verifies the assertion's InResponseTo
//     matches the expected request ID
//
// Parameters:
//   - cert: The IDP's signing certificate (from SamlEntityDescriptor.SigningCert)
//     The EC P-256 public key is extracted from this certificate for signature verification.
//   - opts: optional verification checks (issuer, audience, recipient, InResponseTo)
//
// Returns an error if:
//   - The assertion was not parsed with a Signature element
//   - Digest or signature verification fails
//   - The assertion is not yet valid (NotBefore is in the future beyond clock skew tolerance)
//   - The assertion has expired (NotOnOrAfter has passed)
//   - The expected audience is not in the assertion's audience restriction list
//   - The expected InResponseTo does not match the assertion's InResponseTo
func (s *SamlAssertionWrapper) Verify(cert *wrapperX509.ImmutableCert, opts ...VerifyOption) error {
	var vopts verifyOptions
	for _, fn := range opts {
		fn(&vopts)
	}
	if s.proto.Xml == "" {
		return protoerrors.NewErrMissingInvalidData(nil, "no xml to verify; call ParseSamlResponse first")
	}

	// Re-parse the response to extract the raw Signature fields
	var resp xmlResponse
	if err := xml.Unmarshal([]byte(s.proto.Xml), &resp); err != nil {
		return protoerrors.NewErrMissingInvalidData(err, "failed to re-parse saml response for verification")
	}

	sig := resp.Assertion.Signature
	if sig == nil {
		return protoerrors.NewErrMissingInvalidData(nil, "saml assertion has no Signature element")
	}

	digestValue := strings.TrimSpace(sig.SignedInfo.Reference.DigestValue)
	signatureValue := strings.TrimSpace(sig.SignatureValue)
	refURI := sig.SignedInfo.Reference.URI // e.g. "#_assertionID"

	if digestValue == "" {
		return protoerrors.NewErrMissingInvalidData(nil, "saml signature missing DigestValue")
	}
	if signatureValue == "" {
		return protoerrors.NewErrMissingInvalidData(nil, "saml signature missing SignatureValue")
	}

	assertionID := strings.TrimPrefix(refURI, "#")
	if assertionID == "" || assertionID != resp.Assertion.ID {
		return protoerrors.NewErrMissingInvalidData(nil, "saml signature reference URI %q does not match assertion ID %q", refURI, resp.Assertion.ID)
	}

	// Extract and c14n the Assertion element without the Signature
	assertionNoSig, err := extractAndStripSignature(s.proto.Xml, assertionID)
	if err != nil {
		return protoerrors.NewErrMissingInvalidData(err, "failed to extract assertion xml for digest verification")
	}
	c14nAssertion, err := c14nElement(assertionNoSig)
	if err != nil {
		return protoerrors.NewErrMissingInvalidData(err, "failed to canonicalize assertion xml")
	}

	// Verify digest
	computedDigest := sha256.Sum256(c14nAssertion)
	computedDigestB64 := base64.StdEncoding.EncodeToString(computedDigest[:])
	if computedDigestB64 != digestValue {
		return protoerrors.NewErrUnauthorized(nil, "saml assertion digest mismatch: signature is invalid")
	}

	// Rebuild canonical SignedInfo for signature verification
	signedInfoXML := buildSignedInfoXML(assertionID, digestValue)
	signedInfoDigest := sha256.Sum256([]byte(signedInfoXML))

	// Decode signature value: raw r||s (each 32 bytes)
	sigBytes, err := base64.StdEncoding.DecodeString(signatureValue)
	if err != nil {
		return protoerrors.NewErrMissingInvalidData(err, "invalid saml SignatureValue base64")
	}
	if len(sigBytes) != 64 {
		return protoerrors.NewErrMissingInvalidData(nil, "expected 64-byte EC P-256 signature (r||s), got %d", len(sigBytes))
	}
	r := new(big.Int).SetBytes(sigBytes[:32])
	sigS := new(big.Int).SetBytes(sigBytes[32:])

	// Check IDP certificate is not expired
	x509Cert := cert.X509Certificate()
	now := time.Now()
	if now.After(x509Cert.NotAfter) {
		return protoerrors.NewErrPermissionDenied(nil, "IDP certificate expired at %s", x509Cert.NotAfter.Format(time.RFC3339))
	}
	if now.Before(x509Cert.NotBefore) {
		return protoerrors.NewErrPermissionDenied(nil, "IDP certificate not yet valid until %s", x509Cert.NotBefore.Format(time.RFC3339))
	}

	// Extract EC P-256 public key from the IDP certificate
	ecPub, ok := x509Cert.PublicKey.(*ecdsa.PublicKey)
	if !ok {
		return protoerrors.NewErrMissingInvalidData(nil, "idp certificate does not contain an EC public key")
	}

	if !ecdsa.Verify(ecPub, signedInfoDigest[:], r, sigS) {
		return protoerrors.NewErrUnauthorized(nil, "saml assertion signature verification failed")
	}

	if s.proto.StatusCode != "" && s.proto.StatusCode != StatusSuccess {
		return protoerrors.NewErrPermissionDenied(nil, "saml response status %q is not Success", s.proto.StatusCode)
	}

	// Check NotBefore (with 60 seconds of clock skew tolerance)
	if s.proto.NotBefore != "" {
		notBefore, err := parseSamlTime(s.proto.NotBefore)
		if err != nil {
			return protoerrors.NewErrMissingInvalidData(err, "invalid NotBefore timestamp %q", s.proto.NotBefore)
		}
		if now.Before(notBefore.Add(-60 * time.Second)) {
			return protoerrors.NewErrPermissionDenied(nil, "saml assertion not yet valid until %s", s.proto.NotBefore)
		}
	}

	// Check expiry (NotOnOrAfter)
	if s.IsExpired() {
		return protoerrors.NewErrExpired("saml assertion expired at %s", s.proto.NotOnOrAfter)
	}
	if s.proto.SubjectNotOnOrAfter != "" {
		subjectNotOnOrAfter, err := parseSamlTime(s.proto.SubjectNotOnOrAfter)
		if err != nil {
			return protoerrors.NewErrMissingInvalidData(err, "invalid SubjectNotOnOrAfter timestamp %q", s.proto.SubjectNotOnOrAfter)
		}
		if !now.Before(subjectNotOnOrAfter) {
			return protoerrors.NewErrExpired("saml subject confirmation expired at %s", s.proto.SubjectNotOnOrAfter)
		}
	}

	// Check expected issuer.
	if vopts.expectedIssuer != "" {
		if s.proto.Issuer == "" {
			return protoerrors.NewErrPermissionDenied(nil, "assertion missing Issuer but expected %q", vopts.expectedIssuer)
		}
		if s.proto.Issuer != vopts.expectedIssuer {
			return protoerrors.NewErrPermissionDenied(nil, "assertion Issuer %q does not match expected %q", s.proto.Issuer, vopts.expectedIssuer)
		}
	}

	// Check audience restriction.
	if vopts.expectedAudience != "" {
		found := false
		for _, a := range s.proto.Audiences {
			if a == vopts.expectedAudience {
				found = true
				break
			}
		}
		if !found {
			return protoerrors.NewErrPermissionDenied(nil, "saml assertion audience %v does not include expected audience %q", s.proto.Audiences, vopts.expectedAudience)
		}
	}

	// Check recipient.
	if vopts.expectedRecipient != "" {
		if s.proto.SubjectRecipient == "" {
			return protoerrors.NewErrPermissionDenied(nil, "assertion missing SubjectRecipient but expected %q", vopts.expectedRecipient)
		}
		if s.proto.SubjectRecipient != vopts.expectedRecipient {
			return protoerrors.NewErrPermissionDenied(nil, "assertion SubjectRecipient %q does not match expected %q", s.proto.SubjectRecipient, vopts.expectedRecipient)
		}
	}

	// Check InResponseTo
	if vopts.expectedInResponseTo != "" {
		inResponseTo := s.GetInResponseTo()
		if inResponseTo == "" {
			return protoerrors.NewErrPermissionDenied(nil, "assertion missing InResponseTo but expected %q", vopts.expectedInResponseTo)
		}
		if inResponseTo != vopts.expectedInResponseTo {
			return protoerrors.NewErrPermissionDenied(nil, "assertion InResponseTo %q does not match expected %q", inResponseTo, vopts.expectedInResponseTo)
		}
	}

	// Replay protection: reject assertions that have already been verified.
	assertionID = s.GetAssertionId()
	if assertionID != "" {
		// Use NotOnOrAfter as expiry if available, otherwise 10 minutes from now
		expiry := time.Now().Add(10 * time.Minute)
		if notOnOrAfter := s.GetNotOnOrAfter(); notOnOrAfter != "" {
			if t, err := parseSamlTime(notOnOrAfter); err == nil {
				expiry = t.Add(60 * time.Second) // keep a bit past expiry for safety
			}
		}
		if err := assertionReplayCache.checkAndMark(assertionID, expiry); err != nil {
			return protoerrors.NewErrPermissionDenied(nil, "%s", err.Error())
		}
	}

	return nil
}

// ========================================
// XML building — private helpers
// ========================================

// buildAssertionXML builds a canonical <saml:Assertion> XML string (no Signature element).
// The output is the canonical form used as the signing input for the digest.
// Attributes within each element are sorted alphabetically per exc-c14n rules.
func buildAssertionXML(a *samlProto.SamlAssertion) string {
	var b strings.Builder

	// <saml:Assertion> — namespace decl first, then attrs alphabetically
	b.WriteString(`<saml:Assertion`)
	b.WriteString(` xmlns:saml="` + nsSAMLAssertion + `"`)
	b.WriteString(` ID="` + xmlEscapeAttr(a.Id) + `"`)
	b.WriteString(` IssueInstant="` + xmlEscapeAttr(a.IssueInstant) + `"`)
	b.WriteString(` Version="2.0"`)
	b.WriteString(`>`)

	// <saml:Issuer>
	b.WriteString(`<saml:Issuer>`)
	b.WriteString(xmlEscape(a.Issuer))
	b.WriteString(`</saml:Issuer>`)

	// <saml:Subject>
	b.WriteString(`<saml:Subject>`)
	b.WriteString(`<saml:NameID`)
	b.WriteString(` Format="` + xmlEscapeAttr(a.NameIdFormat) + `"`)
	b.WriteString(`>`)
	b.WriteString(xmlEscape(a.SubjectNameId))
	b.WriteString(`</saml:NameID>`)
	b.WriteString(`<saml:SubjectConfirmation Method="` + methodBearer + `">`)
	b.WriteString(`<saml:SubjectConfirmationData`)
	if a.InResponseTo != "" {
		b.WriteString(` InResponseTo="` + xmlEscapeAttr(a.InResponseTo) + `"`)
	}
	b.WriteString(` NotOnOrAfter="` + xmlEscapeAttr(a.SubjectNotOnOrAfter) + `"`)
	b.WriteString(` Recipient="` + xmlEscapeAttr(a.SubjectRecipient) + `"`)
	b.WriteString(`/>`)
	b.WriteString(`</saml:SubjectConfirmation>`)
	b.WriteString(`</saml:Subject>`)

	// <saml:Conditions>
	b.WriteString(`<saml:Conditions`)
	b.WriteString(` NotBefore="` + xmlEscapeAttr(a.NotBefore) + `"`)
	b.WriteString(` NotOnOrAfter="` + xmlEscapeAttr(a.NotOnOrAfter) + `"`)
	b.WriteString(`>`)
	if len(a.Audiences) > 0 {
		b.WriteString(`<saml:AudienceRestriction>`)
		for _, aud := range a.Audiences {
			b.WriteString(`<saml:Audience>`)
			b.WriteString(xmlEscape(aud))
			b.WriteString(`</saml:Audience>`)
		}
		b.WriteString(`</saml:AudienceRestriction>`)
	}
	b.WriteString(`</saml:Conditions>`)

	// <saml:AuthnStatement>
	b.WriteString(`<saml:AuthnStatement`)
	b.WriteString(` AuthnInstant="` + xmlEscapeAttr(a.AuthnInstant) + `"`)
	if a.SessionIndex != "" {
		b.WriteString(` SessionIndex="` + xmlEscapeAttr(a.SessionIndex) + `"`)
	}
	b.WriteString(`>`)
	b.WriteString(`<saml:AuthnContext>`)
	b.WriteString(`<saml:AuthnContextClassRef>`)
	b.WriteString(xmlEscape(a.AuthnContext))
	b.WriteString(`</saml:AuthnContextClassRef>`)
	b.WriteString(`</saml:AuthnContext>`)
	b.WriteString(`</saml:AuthnStatement>`)

	// <saml:AttributeStatement> — emit attributes sorted by name for determinism
	if len(a.Attributes) > 0 {
		keys := make([]string, 0, len(a.Attributes))
		for k := range a.Attributes {
			keys = append(keys, k)
		}
		sort.Strings(keys)

		b.WriteString(`<saml:AttributeStatement>`)
		for _, name := range keys {
			val := a.Attributes[name]
			b.WriteString(`<saml:Attribute`)
			b.WriteString(` Name="` + xmlEscapeAttr(name) + `"`)
			b.WriteString(` NameFormat="` + attrNameFormat + `"`)
			b.WriteString(`>`)
			// Multi-valued attributes are comma-delimited; emit each as a separate AttributeValue
			for _, v := range strings.Split(val, ",") {
				v = strings.TrimSpace(v)
				if v != "" {
					b.WriteString(`<saml:AttributeValue>`)
					b.WriteString(xmlEscape(v))
					b.WriteString(`</saml:AttributeValue>`)
				}
			}
			b.WriteString(`</saml:Attribute>`)
		}
		b.WriteString(`</saml:AttributeStatement>`)
	}

	b.WriteString(`</saml:Assertion>`)
	return b.String()
}

// buildSignedInfoXML builds the canonical <ds:SignedInfo> XML used for signature computation.
// The output is the canonical form that gets SHA-256 hashed and then ECDSA-signed.
func buildSignedInfoXML(assertionID, digestValue string) string {
	var b strings.Builder
	b.WriteString(`<ds:SignedInfo xmlns:ds="` + nsXMLDSig + `">`)
	b.WriteString(`<ds:CanonicalizationMethod Algorithm="` + algExcC14N + `"/>`)
	b.WriteString(`<ds:SignatureMethod Algorithm="` + algEcdsaSha256 + `"/>`)
	b.WriteString(`<ds:Reference URI="#` + xmlEscapeAttr(assertionID) + `">`)
	b.WriteString(`<ds:Transforms>`)
	b.WriteString(`<ds:Transform Algorithm="` + algEnvelopedSig + `"/>`)
	b.WriteString(`<ds:Transform Algorithm="` + algExcC14N + `"/>`)
	b.WriteString(`</ds:Transforms>`)
	b.WriteString(`<ds:DigestMethod Algorithm="` + algSha256 + `"/>`)
	b.WriteString(`<ds:DigestValue>`)
	b.WriteString(digestValue)
	b.WriteString(`</ds:DigestValue>`)
	b.WriteString(`</ds:Reference>`)
	b.WriteString(`</ds:SignedInfo>`)
	return b.String()
}

// buildSignatureElement builds the complete <ds:Signature> XML element for insertion.
func buildSignatureElement(assertionID, digestValue, signatureValue, certDERBase64 string) string {
	var b strings.Builder
	b.WriteString(`<ds:Signature xmlns:ds="` + nsXMLDSig + `">`)
	b.WriteString(buildSignedInfoXML(assertionID, digestValue))
	b.WriteString(`<ds:SignatureValue>`)
	b.WriteString(signatureValue)
	b.WriteString(`</ds:SignatureValue>`)
	b.WriteString(`<ds:KeyInfo>`)
	b.WriteString(`<ds:X509Data>`)
	b.WriteString(`<ds:X509Certificate>`)
	b.WriteString(certDERBase64)
	b.WriteString(`</ds:X509Certificate>`)
	b.WriteString(`</ds:X509Data>`)
	b.WriteString(`</ds:KeyInfo>`)
	b.WriteString(`</ds:Signature>`)
	return b.String()
}

// insertAfterIssuer inserts sigElement into assertionXML immediately after </saml:Issuer>.
// This is the standard SAML 2.0 signature placement location.
func insertAfterIssuer(assertionXML, sigElement string) string {
	const marker = "</saml:Issuer>"
	idx := strings.Index(assertionXML, marker)
	if idx < 0 {
		// Fallback: insert just before </saml:Assertion>
		return strings.Replace(assertionXML, "</saml:Assertion>", sigElement+"</saml:Assertion>", 1)
	}
	insertAt := idx + len(marker)
	return assertionXML[:insertAt] + sigElement + assertionXML[insertAt:]
}

// buildResponseXML wraps the signed assertion in a <samlp:Response> envelope.
func buildResponseXML(a *samlProto.SamlAssertion, signedAssertionXML string) string {
	var b strings.Builder
	b.WriteString(`<samlp:Response`)
	b.WriteString(` xmlns:saml="` + nsSAMLAssertion + `"`)
	b.WriteString(` xmlns:samlp="` + nsSAMLProtocol + `"`)
	if a.SubjectRecipient != "" {
		b.WriteString(` Destination="` + xmlEscapeAttr(a.SubjectRecipient) + `"`)
	}
	b.WriteString(` ID="` + xmlEscapeAttr(a.ResponseId) + `"`)
	if a.InResponseTo != "" {
		b.WriteString(` InResponseTo="` + xmlEscapeAttr(a.InResponseTo) + `"`)
	}
	b.WriteString(` IssueInstant="` + xmlEscapeAttr(a.IssueInstant) + `"`)
	b.WriteString(` Version="2.0"`)
	b.WriteString(`>`)
	b.WriteString(`<saml:Issuer>`)
	b.WriteString(xmlEscape(a.Issuer))
	b.WriteString(`</saml:Issuer>`)
	b.WriteString(`<samlp:Status>`)
	b.WriteString(`<samlp:StatusCode Value="` + xmlEscapeAttr(a.StatusCode) + `"/>`)
	if a.StatusMessage != "" {
		b.WriteString(`<samlp:StatusMessage>`)
		b.WriteString(xmlEscape(a.StatusMessage))
		b.WriteString(`</samlp:StatusMessage>`)
	}
	b.WriteString(`</samlp:Status>`)
	b.WriteString(signedAssertionXML)
	b.WriteString(`</samlp:Response>`)
	return b.String()
}

// ========================================
// Canonicalization (exc-c14n)
// ========================================

// c14nElement applies Exclusive Canonical XML (exc-c14n) to a well-formed XML element string.
// This implements the subset of https://www.w3.org/TR/xml-exc-c14n/ required for SAML 2.0
// assertion signature verification.
//
// Rules applied:
//   - No XML declaration
//   - Namespace declarations included only if visibly utilized and not inherited from ancestors
//   - Namespace declarations sorted lexicographically by prefix
//   - Non-namespace attributes sorted by (namespace URI, local name)
//   - Empty elements expanded: <foo/> → <foo></foo>
//   - Character data: & < > escaped; attribute values also escape " \t \n \r
func c14nElement(xmlStr string) ([]byte, error) {
	dec := xml.NewDecoder(strings.NewReader(xmlStr))

	var buf bytes.Buffer

	// Track namespace prefix→URI mappings across the element tree.
	// Using a stack so we can pop declarations when an element closes.
	type nsFrame struct {
		newPrefixes map[string]string // prefixes declared at this element level
	}
	prefixToURI := map[string]string{"xml": "http://www.w3.org/XML/1998/namespace"}
	var nsStack []nsFrame

	for {
		tok, err := dec.RawToken()
		if err == io.EOF {
			break
		}
		if err != nil {
			return nil, fmt.Errorf("c14n parse: %w", err)
		}

		switch t := tok.(type) {
		case xml.StartElement:
			frame := nsFrame{newPrefixes: map[string]string{}}

			// Separate namespace declarations from other attributes
			var regularAttrs []xml.Attr
			for _, a := range t.Attr {
				if a.Name.Space == "xmlns" {
					// xmlns:prefix="uri" — track but include only if visibly utilized
					if prefixToURI[a.Name.Local] != a.Value {
						frame.newPrefixes[a.Name.Local] = a.Value
						prefixToURI[a.Name.Local] = a.Value
					}
				} else if a.Name.Space == "" && a.Name.Local == "xmlns" {
					// xmlns="uri" — default namespace
					if prefixToURI[""] != a.Value {
						frame.newPrefixes[""] = a.Value
						prefixToURI[""] = a.Value
					}
				} else {
					regularAttrs = append(regularAttrs, a)
				}
			}
			nsStack = append(nsStack, frame)

			// Determine which namespace declarations are visibly utilized at this element.
			// For exc-c14n: include a declaration if its prefix is used in this element's
			// name or any of its attribute names.
			utilized := map[string]bool{}
			elemPrefix := t.Name.Space // in RawToken mode, Space = prefix
			if elemPrefix != "" {
				utilized[elemPrefix] = true
			}
			for _, a := range regularAttrs {
				if a.Name.Space != "" {
					utilized[a.Name.Space] = true
				}
			}

			// Collect declarations to emit: new declarations for utilized prefixes
			var nsDeclPrefixes []string
			for p := range frame.newPrefixes {
				if p == "" || utilized[p] {
					nsDeclPrefixes = append(nsDeclPrefixes, p)
				}
			}
			sort.Strings(nsDeclPrefixes)

			// Write start tag
			qname := c14nQName(t.Name)
			buf.WriteByte('<')
			buf.WriteString(qname)

			// Namespace declarations first (sorted by prefix)
			for _, p := range nsDeclPrefixes {
				uri := frame.newPrefixes[p]
				if p == "" {
					buf.WriteString(` xmlns="`)
				} else {
					buf.WriteString(` xmlns:`)
					buf.WriteString(p)
					buf.WriteString(`="`)
				}
				buf.WriteString(xmlEscapeAttr(uri))
				buf.WriteByte('"')
			}

			// Then regular attributes, sorted by (namespace URI, local name)
			sort.Slice(regularAttrs, func(i, j int) bool {
				// For exc-c14n: no-namespace attributes sort before namespaced ones;
				// within same namespace, sort by local name.
				ni := attrSortKey(regularAttrs[i], prefixToURI)
				nj := attrSortKey(regularAttrs[j], prefixToURI)
				return ni < nj
			})
			for _, a := range regularAttrs {
				buf.WriteByte(' ')
				buf.WriteString(c14nQName(a.Name))
				buf.WriteString(`="`)
				buf.WriteString(xmlEscapeAttr(a.Value))
				buf.WriteByte('"')
			}
			buf.WriteByte('>')

		case xml.EndElement:
			// Pop namespace frame and restore prefix mappings
			if len(nsStack) > 0 {
				frame := nsStack[len(nsStack)-1]
				nsStack = nsStack[:len(nsStack)-1]
				for p := range frame.newPrefixes {
					delete(prefixToURI, p)
				}
			}
			qname := c14nQName(t.Name)
			buf.WriteString("</")
			buf.WriteString(qname)
			buf.WriteByte('>')

		case xml.CharData:
			buf.WriteString(xmlEscape(string(t)))

			// Comments and processing instructions are excluded from exc-c14n content by default.
		}
	}

	return buf.Bytes(), nil
}

// c14nQName returns the qualified name for an xml.Name in RawToken mode.
// In RawToken mode, Name.Space contains the namespace prefix (not URI).
func c14nQName(name xml.Name) string {
	if name.Space == "" {
		return name.Local
	}
	return name.Space + ":" + name.Local
}

// attrSortKey returns a sort key for an attribute per exc-c14n ordering:
// attributes without a namespace URI sort before those with one (URI = "").
// Within the same namespace, sort by local name.
func attrSortKey(a xml.Attr, prefixToURI map[string]string) string {
	if a.Name.Space == "" {
		// No namespace — sorts before any namespaced attribute
		return "\x00" + a.Name.Local
	}
	uri := prefixToURI[a.Name.Space]
	return uri + "\x01" + a.Name.Local
}

// extractAndStripSignature extracts the signed Assertion element from a SAMLResponse XML string,
// removes its enveloped Signature child, and returns the assertion XML ready for c14n.
//
// The element is located by XML structure, not by literal text search: it is the single direct
// Assertion child (in the SAML assertion namespace) of the root Response element — the same
// element encoding/xml populates xmlResponse.Assertion from. That equivalence is what ties the
// bytes that get digested to the element the verified claims are read from; selecting the element
// by a prefix-sensitive text search allows a document whose parsed claims come from one element
// while the digest is computed over another (XML signature wrapping).
func extractAndStripSignature(responseXML, assertionID string) (string, error) {
	dec := xml.NewDecoder(strings.NewReader(responseXML))

	var (
		depth       int
		found       bool
		inAssertion bool
		elementID   string
		assertStart int
		assertEnd   int
		haveSig     bool
		sigClosed   bool
		sigStart    int
		sigEnd      int
	)

	for {
		off := dec.InputOffset()
		tok, err := dec.Token()
		if err == io.EOF {
			break
		}
		if err != nil {
			return "", fmt.Errorf("parse saml response xml: %w", err)
		}

		switch t := tok.(type) {
		case xml.StartElement:
			depth++
			switch {
			case depth == 1:
				if t.Name.Space != nsSAMLProtocol || t.Name.Local != "Response" {
					return "", fmt.Errorf("saml response root element is {%s}%s, not a samlp:Response", t.Name.Space, t.Name.Local)
				}
			case depth == 2 && t.Name.Space == nsSAMLAssertion && t.Name.Local == "Assertion":
				if found {
					return "", fmt.Errorf("saml response contains multiple Assertion elements")
				}
				found = true
				inAssertion = true
				assertStart = int(off)
				for _, a := range t.Attr {
					if a.Name.Space == "" && a.Name.Local == "ID" {
						elementID = a.Value
					}
				}
			case depth == 3 && inAssertion && t.Name.Space == nsXMLDSig && t.Name.Local == "Signature":
				if haveSig {
					return "", fmt.Errorf("saml assertion contains multiple Signature elements")
				}
				haveSig = true
				sigStart = int(off)
			}

		case xml.EndElement:
			if haveSig && !sigClosed && inAssertion && depth == 3 {
				sigEnd = int(dec.InputOffset())
				sigClosed = true
			}
			if inAssertion && depth == 2 {
				assertEnd = int(dec.InputOffset())
				inAssertion = false
			}
			depth--
		}
	}

	if !found {
		return "", fmt.Errorf("could not find an Assertion element in the saml response")
	}
	if assertionID != "" && elementID != assertionID {
		return "", fmt.Errorf("signed assertion ID %q does not match Assertion element ID %q", assertionID, elementID)
	}
	if !haveSig {
		// No signature to remove — return as-is (digest verification will fail if expected)
		return responseXML[assertStart:assertEnd], nil
	}
	return responseXML[assertStart:sigStart] + responseXML[sigEnd:assertEnd], nil
}

// ========================================
// Crypto helpers
// ========================================

// ecP256RawSignature encodes an ECDSA (r, s) pair as the 64-byte raw format
// used by XML-DSig (each of r and s zero-padded to 32 bytes, concatenated).
func ecP256RawSignature(r, s *big.Int) []byte {
	sig := make([]byte, 64)
	rBytes := r.Bytes()
	sBytes := s.Bytes()
	copy(sig[32-len(rBytes):32], rBytes)
	copy(sig[64-len(sBytes):64], sBytes)
	return sig
}

// ========================================
// XML character escaping
// ========================================

// xmlEscape escapes special XML characters in text content.
func xmlEscape(s string) string {
	s = strings.ReplaceAll(s, "&", "&amp;")
	s = strings.ReplaceAll(s, "<", "&lt;")
	s = strings.ReplaceAll(s, ">", "&gt;")
	return s
}

// xmlEscapeAttr escapes special XML characters in attribute values.
func xmlEscapeAttr(s string) string {
	s = xmlEscape(s)
	s = strings.ReplaceAll(s, `"`, "&quot;")
	s = strings.ReplaceAll(s, "\t", "&#9;")
	s = strings.ReplaceAll(s, "\n", "&#10;")
	s = strings.ReplaceAll(s, "\r", "&#13;")
	return s
}

// ========================================
// Time helpers
// ========================================

// formatSamlTime formats a time.Time as an ISO 8601 UTC string for SAML.
func formatSamlTime(t time.Time) string {
	return t.UTC().Format("2006-01-02T15:04:05Z")
}

// parseSamlTime parses an ISO 8601 UTC string from a SAML assertion.
func parseSamlTime(s string) (time.Time, error) {
	if s == "" {
		return time.Time{}, fmt.Errorf("empty time string")
	}
	// Try common SAML timestamp formats
	for _, layout := range []string{"2006-01-02T15:04:05Z", "2006-01-02T15:04:05.000Z", time.RFC3339} {
		if t, err := time.Parse(layout, s); err == nil {
			return t, nil
		}
	}
	return time.Time{}, fmt.Errorf("cannot parse saml time %q", s)
}

// ========================================
// ID generation
// ========================================

// generateSamlID generates a random 20-byte hex string for use as a SAML assertion/response ID.
// The caller should prefix it with "_" as required by SAML 2.0 (IDs must start with a letter or '_').
func generateSamlID() string {
	b := make([]byte, 20)
	if _, err := rand.Read(b); err != nil {
		panic(fmt.Sprintf("crypto/rand failed to generate saml id: %v", err))
	}
	return fmt.Sprintf("%x", b)
}
