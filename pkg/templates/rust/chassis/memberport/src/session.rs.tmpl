    /// The read leg's chunks to the local connection, leg by leg.
    async fn read(self: Arc<Self>, mut leg: LegRx, mut local: OwnedWriteHalf) {
        loop {
            let item = tokio::select! {
                _ = self.cancel.cancelled() => break,
                m = leg.stream.message() => m,
            };
            let chunk = match item {
                Ok(Some(chunk)) => chunk,
                Ok(None) => {
                    self.stream_end(Code::Ok).await;
                    break;
                }
                Err(status) => {
                    self.stream_end(status.code()).await;
                    break;
                }
            };
            let fin_received = self.fin_received.load(Ordering::SeqCst);
            if chunk.payload.len() > MAX_CHUNK_BYTES
                || (fin_received && !chunk.payload.is_empty())
                || !chunk.session_id.is_empty()
