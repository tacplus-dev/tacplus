#[allow(dead_code)]
type W2SWebSocket = WebSocketStream<MaybeTlsStream<tokio::net::TcpStream>>;

/// A token provider returns a bearer token string for W2S authentication.
/// W2S streaming clients call this before every outbound message so long-lived
/// channels never send with a stale token.
pub type TokenProvider = Arc<
    dyn Fn() -> Pin<Box<dyn Future<Output = Result<String, Box<dyn std::error::Error + Send + Sync>>> + Send>>
        + Send
        + Sync,
>;

#[allow(dead_code)]
enum DecodedWsMessage<T> {
    Message(T),
    Continue,
    Closed,
}

#[allow(dead_code)]
