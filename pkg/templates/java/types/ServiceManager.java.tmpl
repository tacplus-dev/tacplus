    // {{.ResolveLoopName}}/{{.StreamName}} drain the durable accounting
    // record queue into EventBus. A record stays "pending" until the broker
    // acknowledges it, so stream/re-resolution failures do not discard an
    // already-enqueued record — the EventBusSink spool (which replays into
    // this queue, in order) is what keeps a record through an outage; this
    // loop just makes sure an accepted record is retried until it is durably
    // published. onAck runs once per acknowledged record, in order, so a durable
    // spool can advance its cursor.
    private void {{.ResolveLoopName}}(BlockingQueue<{{.TypeOuterClass}}.{{.TypeName}}> queue, Runnable onAck) {
        long backoff = ReconnectBackoff.INITIAL_MS;
        {{.TypeOuterClass}}.{{.TypeName}} pending = null;

        while (!Thread.currentThread().isInterrupted()) {
            try {
                if (pending == null) {
                    pending = queue.poll(1, TimeUnit.SECONDS);
                    if (pending == null) {
                        continue;
                    }
                }
                io.grpc.Channel ebConn = resolveService("{{.TargetService}}");
                {{.StreamName}}(ebConn, pending);
                pending = null;
                onAck.run();
                backoff = ReconnectBackoff.INITIAL_MS;
            } catch (Exception e) {
                LOG.warning("accounting publisher {{.Label}} publish attempt failed for broker {{.TargetService}}, retrying in " + backoff + "ms: " + e.getMessage());
                try { Thread.sleep(ReconnectBackoff.jitterMs(backoff)); } catch (InterruptedException ie) {
                    Thread.currentThread().interrupt();
                    return;
                }
                backoff = ReconnectBackoff.next(backoff);
            }
        }
    }

