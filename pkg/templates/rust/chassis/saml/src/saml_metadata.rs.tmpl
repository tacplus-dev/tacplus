/// Fetch and parse a remote EntityDescriptor via HTTPS GET.
pub async fn fetch_entity_descriptor(url: &str) -> Result<ParsedEntityDescriptor, MetadataError> {
    let client = reqwest::Client::builder()
        .timeout(std::time::Duration::from_secs(30))
        .build()
        .map_err(|e| MetadataError::FetchError(e.to_string()))?;

    let resp = client.get(url)
        .send()
        .await
        .map_err(|e| MetadataError::FetchError(e.to_string()))?;

    let body = resp.bytes()
        .await
        .map_err(|e| MetadataError::FetchError(e.to_string()))?;

    parse_entity_descriptor(&body)
}

