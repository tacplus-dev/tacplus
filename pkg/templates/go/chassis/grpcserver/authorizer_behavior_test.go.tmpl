// AuthenticateAtOrBelow enforces the universal namespace rule: the caller's
// namespace must be at or above the target.
func TestAuthenticateAtOrBelowNamespaceRule(t *testing.T) {
	key := newTestKey(t)
	a := authorizerWithKeys(t, jwkForKey(t, key))

	// Caller in "/a" is at-or-above the target "/a/b" -> allowed.
	above := signedToken(t, key, func(tok *tokenlib.TokenWrapper) {
		tok.SetSubType("service").SetSubject("caller-svc").SetNamespace("/a")
	})
	if _, err := a.AuthenticateAtOrBelow(bearerCtx(above), "/a/b"); err != nil {
		t.Fatalf("caller at-or-above target must be allowed, got: %v", err)
	}

	// Caller in "/a/b" is BELOW the target "/a" -> denied.
	below := signedToken(t, key, func(tok *tokenlib.TokenWrapper) {
		tok.SetSubType("service").SetSubject("caller-svc").SetNamespace("/a/b")
	})
	if _, err := a.AuthenticateAtOrBelow(bearerCtx(below), "/a"); err == nil {
		t.Fatal("caller below the target namespace must be denied")
	}
}

// auth_any_user with no authored target_namespace_field admits ANY authenticated
// caller: the generated wrapper calls Authenticate, not AuthenticateAtOrBelow.
// This pins why — AuthenticateAtOrBelow(ctx, "/") is IsAtOrBelow(caller, "/"),
// true only for a caller sitting exactly at "/", so a "/" default would reject
// every real caller and invert the annotation.
func TestAuthenticateAdmitsNonRootNamespaceCaller(t *testing.T) {
	key := newTestKey(t)
	a := authorizerWithKeys(t, jwkForKey(t, key))

	tenant := signedToken(t, key, func(tok *tokenlib.TokenWrapper) {
		tok.SetSubType("service").SetSubject("caller-svc").SetNamespace("/tenants/acme")
	})

	if _, err := a.Authenticate(bearerCtx(tenant)); err != nil {
		t.Fatalf("auth_any_user must admit any authenticated caller, got: %v", err)
	}
	if _, err := a.AuthenticateAtOrBelow(bearerCtx(tenant), "/"); err == nil {
		t.Fatal("a root target rejects every non-root caller; that is why the auth_any_user default must not be \"/\"")
	}
}

