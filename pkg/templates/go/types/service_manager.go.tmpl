// multiWrapper registers all gRPC services on a single server.
type multiWrapper struct {
impls []grpcserver.ServiceImplementation
additionalRegistrar AdditionalServiceRegistrar
auth grpcserver.Authorizer
}

{{- if .HasC2DGrpc}}

// C2DSocketPath is the unix socket this build's service_c2d services declare
// (spec.service_c2d.socket_path — required, no default, which would collide
// between daemons). Run serves on it; clients dial it.
const C2DSocketPath = "{{.C2DSocketPath}}"

// newC2DServer hosts the service_c2d wrappers on socketPath. The wrappers skip
// token auth: the socket's owner-only permissions are the boundary, not a
// bearer token.
func newC2DServer(socketPath string, impls ...grpcserver.ServiceImplementation) *grpcserver.C2DServer {
return grpcserver.NewC2DServer(socketPath, &multiWrapper{impls: impls})
}
{{- end}}
{{- if .HostsC2DStandalone}}

// c2dStandaloneShutdownTimeout bounds h.Shutdown in ServeC2DStandalone, which
// has no config to read shutdown_timeout_seconds from.
const c2dStandaloneShutdownTimeout = 30 * time.Second

// ServeC2DStandalone hosts this build's service_c2d services on socketPath with
// NO cluster: no config load, no identity manager, no state store, no TLS
// server. It is the generated c2d server and the generated wrappers
// (request/response validation, the c2d token-auth skip) and nothing else, for
// a local daemon that cannot call New. It is emitted only because every
// service this build hosts is service_c2d and nothing in it needs the cluster;
// New and Run stay for running the same daemon in one.
//
// A daemon passes C2DSocketPath, the declared socket; a test passes its own
// so it never takes over the socket of a daemon already running on the host.
// It serves until ctx is cancelled, drains in-flight RPCs, removes the socket
// and then calls h.Shutdown. A socket that cannot be bound or locked down to
// owner-only is returned as an error, without calling h.Shutdown.
func ServeC2DStandalone(ctx context.Context, socketPath string, h Handler) error {
srv := newC2DServer(socketPath,
{{- range .GrpcServices}}
{{.WrapperAlias}}.{{.ConstructorName}}(h.{{.GetterName}}()),
{{- end}}
)
if err := srv.Serve(ctx); err != nil {
return fmt.Errorf("c2d server: %w", err)
}
shutdownCtx, cancel := context.WithTimeout(context.Background(), c2dStandaloneShutdownTimeout)
defer cancel()
h.Shutdown(shutdownCtx)
return nil
}
{{- end}}

func (m *multiWrapper) RegisterServices(grpcServer *grpc.Server) error {
for _, impl := range m.impls {
if err := impl.RegisterServices(grpcServer); err != nil {
return err
}
}
if m.additionalRegistrar != nil {
if m.auth != nil {
m.additionalRegistrar.RegisterAdditionalServices(grpcserver.AuthEnforcingRegistrar(grpcServer, m.auth))
} else {
m.additionalRegistrar.RegisterAdditionalServices(grpcServer)
}
}
	return nil
}

{{if .HasDiskStores}}
func (sm *ServiceManager) startDiskStoreRollSchedulers(h Handler) error {
	if sm.diskStoreLogs == nil || sm.diskStoreLogs.rollInterval <= 0 {
		return nil
	}
	interval := sm.diskStoreLogs.rollInterval
	nodeID := sm.sc.InstanceID()
	if nodeID == "" {
		nodeID = sm.cfg.GetInstanceId()
	}
	if nodeID == "" {
		nodeID = "{{.ServiceLabel}}"
	}
{{- range .DiskStores}}
	if log := sm.diskStoreLogs.{{.LogField}}; log != nil {
		storeLog := log
		sm.tasks.Go(func(ctx context.Context) {
			_ = diskstore.RunRollScheduler(ctx, storeLog, interval, nodeID+"/{{.StoreName}}", func() []*diskstore.Record {
				store := h.{{.HandlerGetter}}()
				resp, err := store.List(ctx, nil)
				if err != nil {
					zap.L().Warn("diskstore snapshot failed; roll will retry on next interval",
						zap.String("store", "{{.StoreName}}"),
						zap.Error(err))
					return nil
				}
				records, err := diskstores.Snapshot{{.TypeName}}(resp.GetItems())
				if err != nil {
					zap.L().Warn("diskstore snapshot encode failed; roll will retry on next interval",
						zap.String("store", "{{.StoreName}}"),
						zap.Error(err))
					return nil
				}
				// The baseline is LOCALITY-SCOPED when the store says it is
				// partitioned: List is the whole cluster's rows, and a node
				// whose baseline claims rows it does not own breaks the
				// partial-log invariant recovery resolves staleness with.
				return diskstore.LocalRecords(store, records)
			})
		})
	}
{{- end}}
	return nil
}
{{end}}

// Run starts the service lifecycle with the given handler: subscribes to
// runtime config, fetches typed config, {{if .HasGrpc}}creates the gRPC server, {{end}}starts
// serving, and manages graceful shutdown.
func (sm *ServiceManager) Run(h Handler) error {
{{if .HasDiskStores}}
defer func() {
if sm.diskStoreLogs != nil {
_ = sm.diskStoreLogs.Close()
}
}()
{{end}}
defer func() {
waitCtx, waitCancel := context.WithTimeout(context.Background(), sm.shutdownTimeout())
defer waitCancel()
if !sm.tasks.WaitContext(waitCtx) {
zap.L().Warn("Background task shutdown timeout expired; returning")
}
}()
defer sm.tasks.Cancel()
{{if .HasGrpcS2SClients}}
defer func() {
for _, conn := range sm.s2sConnections {
if conn == nil {
continue
}
conn.Close()
}
	}()
	{{end}}
	{{if .HasSmb}}
	defer func() {
	if sm.smbAuthorityConn != nil {
	sm.smbAuthorityConn.Close()
	}
	}()
	{{end}}
	{{if .HasStates}}
defer func() {
if sm.bc != nil {
sm.bc.Close()
}
}()
{{end}}
defer func() {
if sm.sc != nil {
_ = sm.sc.Close()
}
}()
defer func() {
if sm.identity != nil {
sm.identity.Close()
}
}()
defer func() {
if sm.stop != nil {
sm.stop()
}
}()

// Subscribe to shared runtime config (listen address, logger, timeouts).
// Runtime config from the cluster merges into the boot config.
{{if .HasSysState}}
serviceConfigState := sm.bc.Sys().ServiceConfigState()
runtimeCfg, err := serviceConfigState.Config().Fetch(sm.ctx)
if err != nil {
return fmt.Errorf("fetch runtime config: %w", err)
}
grpcconfig_pb.ConfigDefaults(runtimeCfg)

// Merge runtime fields into boot config (boot config fields take precedence for
// bootstrap fields like endpoints/private_key; runtime fields like listen_address,
// logger, timeouts come from the cluster).
grpcconfig_pb.MergeConfig(sm.cfg, runtimeCfg)

if sm.cfg.Logger != nil {
if _, err := logger.InstallFromConfig(sm.cfg.Logger); err != nil {
zap.L().Error("Failed to install logger from runtime config", zap.Error(err))
}
}

serviceConfigState.Config().OnChange(func(cfg *grpcconfig_pb.Config) {
zap.L().Info("Runtime config updated")
if len(cfg.GetEndpoints()) > 0 {
sm.sc.ReconcileEndpoints(cfg.GetEndpoints())
}
})
	{{else}}
	// No sys/ cluster — apply defaults to boot config.
	grpcconfig_pb.ConfigDefaults(sm.cfg)
