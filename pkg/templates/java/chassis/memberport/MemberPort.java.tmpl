            }
        } catch (CertificateException e) {
            throw e;
        } catch (Exception e) {
            throw new CertificateException("member port: unreadable peer certificate: " + e.getMessage(), e);
        }
        throw new CertificateException("member port: the peer certificate does not name service "
                + serviceLabel + " in " + (tenantOwned ? own : "/system") + " of trust domain " + trustDomain);
    }

