    private static void jsonEscapeString(String s, StringBuilder out) {
        out.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '"': out.append("\\\""); break;
                case '\\': out.append("\\\\"); break;
                case '\n': out.append("\\n"); break;
                case '\r': out.append("\\r"); break;
                case '\t': out.append("\\t"); break;
                default:
                    if (c < 0x20) {
                        out.append(String.format("\\u%04x", (int) c));
                    } else {
                        out.append(c);
                    }
            }
        }
        out.append('"');
    }

    // Strict parser for exactly our envelope shape {"v":<int>,"k":[<string>,...]}.
    // Returns null (or throws) on anything unexpected; the caller maps that to
    // INVALID_ARGUMENT. We only ever decode tokens our own encoder produced, so a
    // strict parser is sufficient and tamper-safe.
