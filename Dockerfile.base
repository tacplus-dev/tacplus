# TACPlus Base Image
# Contains all build tools and language runtimes needed by tacplus.
# Rebuilt by bumping BASE_VERSION in .gitlab-ci.yml: the base-image job runs on
# version tags and main, and SKIPS the build when an image for that BASE_VERSION
# already exists in the registry. Editing this file alone therefore does NOT
# trigger a rebuild — bump BASE_VERSION with it.
# The release Dockerfile layers the tacplus binary on top of this image.

# =============================================================================
# Stage 1: Builder - compile protoc plugins from source
# =============================================================================
FROM golang:1.25-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    unzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install protoc (architecture-aware)
ARG PROTOC_VERSION=28.3
RUN ARCH=$(dpkg --print-architecture) \
    && if [ "$ARCH" = "arm64" ]; then PROTOC_ARCH="linux-aarch_64"; else PROTOC_ARCH="linux-x86_64"; fi \
    && curl -fsSL --retry 30 --retry-delay 5 -o protoc.zip \
      "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-${PROTOC_ARCH}.zip" \
    && unzip protoc.zip -d /usr/local \
    && rm protoc.zip \
    && chmod +x /usr/local/bin/protoc

# Install Node.js for protoc-gen-es
RUN curl -fsSL --retry 30 --retry-delay 5 https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Go protoc plugins
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@latest \
    && go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest

# Install Java gRPC protoc plugin (for Java gRPC stub generation)
ARG GRPC_JAVA_VERSION=1.79.0
RUN ARCH=$(dpkg --print-architecture) \
    && if [ "$ARCH" = "arm64" ]; then GRPC_ARCH="linux-aarch_64"; else GRPC_ARCH="linux-x86_64"; fi \
    && curl -fsSL --retry 30 --retry-delay 5 -o /usr/local/bin/protoc-gen-grpc-java \
       "https://repo1.maven.org/maven2/io/grpc/protoc-gen-grpc-java/${GRPC_JAVA_VERSION}/protoc-gen-grpc-java-${GRPC_JAVA_VERSION}-${GRPC_ARCH}.exe" \
    && chmod +x /usr/local/bin/protoc-gen-grpc-java

# Install TypeScript protoc plugin
ARG PROTOC_GEN_ES_VERSION=2.11.0
ARG BUFBUILD_PROTOBUF_VERSION=2.11.0
RUN npm install -g \
    "@bufbuild/protoc-gen-es@${PROTOC_GEN_ES_VERSION}" \
    "@bufbuild/protobuf@${BUFBUILD_PROTOBUF_VERSION}"

# Install Rust toolchain (native target only)
RUN curl --proto '=https' --tlsv1.2 -sSf --retry 30 --retry-delay 5 https://sh.rustup.rs | sh -s -- -y

# Install Rust protoc plugins (compiled from source — cached if layer unchanged)
RUN /root/.cargo/bin/cargo install protoc-gen-prost protoc-gen-tonic protoc-gen-prost-serde


# =============================================================================
# Stage 2: Swift protoc plugins
# =============================================================================
FROM swift:6.1-jammy AS swift-plugin-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

ARG SWIFT_PROTOBUF_VERSION=1.38.0
ARG GRPC_SWIFT_PROTOBUF_VERSION=2.4.0

RUN git clone --depth 1 --branch "${SWIFT_PROTOBUF_VERSION}" https://github.com/apple/swift-protobuf /tmp/swift-protobuf \
    && swift build --package-path /tmp/swift-protobuf -c release --product protoc-gen-swift \
    && cp /tmp/swift-protobuf/.build/release/protoc-gen-swift /usr/local/bin/protoc-gen-swift

RUN git clone --depth 1 --branch "${GRPC_SWIFT_PROTOBUF_VERSION}" https://github.com/grpc/grpc-swift-protobuf /tmp/grpc-swift-protobuf \
    && swift build --package-path /tmp/grpc-swift-protobuf -c release --product protoc-gen-grpc-swift-2 \
    && cp /tmp/grpc-swift-protobuf/.build/release/protoc-gen-grpc-swift-2 /usr/local/bin/protoc-gen-grpc-swift-2

# Copy the Swift runtime needed by the plugin binaries. Keep it under /opt so
# these libraries do not overwrite Debian system libraries in the runtime image.
RUN mkdir -p /opt/swift-runtime/lib \
    && cp -a /usr/lib/swift/linux/. /opt/swift-runtime/lib/ \
    && find /usr/lib -type f -name 'libicu*.so*' -exec cp -L -t /opt/swift-runtime/lib {} +


# =============================================================================
# Stage 3: Runtime image with all tools pre-installed
# =============================================================================
FROM debian:trixie-slim

LABEL org.opencontainers.image.title="TACPlus Base Image" \
      org.opencontainers.image.description="Pre-baked build tools for the tacplus compiler system"

# Install all OS-level runtime dependencies in one layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    build-essential \
    cmake \
    pkg-config \
    libssl-dev \
    python3 \
    python3-pip \
    unzip \
    wget \
    gnupg \
    maven \
    procps \
    jq \
    iproute2 \
    dnsutils \
    ripgrep \
    libxml2-dev \
    zlib1g-dev \
    libbz2-dev \
    xz-utils \
    patch \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js (separate layer — NodeSource setup can be flaky)
RUN curl -fsSL --retry 30 --retry-delay 5 https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Eclipse Temurin JDK 25 (not available in trixie default repos)
RUN curl -fsSL --retry 30 --retry-delay 5 https://packages.adoptium.net/artifactory/api/gpg/key/public | gpg --dearmor -o /usr/share/keyrings/adoptium.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb trixie main" > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update && apt-get install -y --no-install-recommends temurin-25-jdk \
    && rm -rf /var/lib/apt/lists/*

# Set JAVA_HOME to Temurin 25
RUN ln -s /usr/lib/jvm/temurin-25-jdk-* /usr/lib/jvm/temurin-25
ENV JAVA_HOME=/usr/lib/jvm/temurin-25

# Maven's own bundled guava calls a terminally-deprecated sun.misc.Unsafe method under
# JDK 25, which --sun-misc-unsafe-memory-access=allow (needed for protobuf-java/netty,
# set per-invocation by cross-test scripts) turns from an error into a WARNING on stderr —
# cross-test gates that assert a clean compile log then fail on Maven's own warning, not
# generated code. Set once here for every mvn invocation in the image rather than in each
# of the 7+ cross-test call sites.
ENV MAVEN_OPTS=--sun-misc-unsafe-memory-access=allow

# Install Go runtime (needed for goimports during type generation)
RUN ARCH=$(dpkg --print-architecture) \
    && if [ "$ARCH" = "arm64" ]; then GO_ARCH="arm64"; else GO_ARCH="amd64"; fi \
    && curl -fsSL --retry 30 --retry-delay 5 "https://go.dev/dl/go1.25.8.linux-${GO_ARCH}.tar.gz" | tar -C /usr/local -xz

# Install Python tools (twine/build for packaging, black for formatting)
# --ignore-installed works around trixie shipping python3-packaging via apt with no
# RECORD file, which pip otherwise refuses to uninstall when a newer packaging is pulled in.
RUN pip3 install --break-system-packages --no-cache-dir --ignore-installed twine build black grpcio-tools

# Install OpenJML (Java formal verification)
# OpenJML bundles an x86-64 JDK. On ARM containers (Apple Silicon), install
# the x86-64 dynamic linker so Docker Desktop's Rosetta can run it.
RUN ARCH=$(dpkg --print-architecture) \
    && if [ "$ARCH" = "arm64" ]; then \
         dpkg --add-architecture amd64 \
         && apt-get update \
         && apt-get install -y --no-install-recommends libc6:amd64 zlib1g:amd64 \
         && rm -rf /var/lib/apt/lists/*; \
       fi

ARG OPENJML_VERSION=21-0.23
RUN mkdir -p /root/.cache/tacplus/tools/openjml \
    && curl -fsSL --retry 30 --retry-delay 5 -o /tmp/openjml.zip \
       "https://github.com/OpenJML/OpenJML/releases/download/${OPENJML_VERSION}/openjml-ubuntu-latest-${OPENJML_VERSION}.zip" \
    && unzip -q /tmp/openjml.zip -d /root/.cache/tacplus/tools/openjml \
    && rm /tmp/openjml.zip \
    && chmod -R +x /root/.cache/tacplus/tools/openjml

# JBMC (Java Bounded Model Checker) — from Debian trixie repos
RUN apt-get update && apt-get install -y --no-install-recommends jbmc \
    && rm -rf /var/lib/apt/lists/*

# Copy Rust toolchain + Kani setup from builder and make world-readable
COPY --from=builder /root/.cargo /root/.cargo
COPY --from=builder /root/.rustup /root/.rustup
RUN chmod -R a+rX /root/.cargo /root/.rustup /root

# Copy Rust protoc plugins to /usr/local/bin (like Go plugins) so they work with --user
COPY --from=builder /root/.cargo/bin/protoc-gen-prost /usr/local/bin/protoc-gen-prost
COPY --from=builder /root/.cargo/bin/protoc-gen-tonic /usr/local/bin/protoc-gen-tonic
COPY --from=builder /root/.cargo/bin/protoc-gen-prost-serde /usr/local/bin/protoc-gen-prost-serde

# Single PATH declaration - includes all tool locations
ENV PATH="/usr/local/bin:/usr/local/go/bin:/root/.cargo/bin:/root/.cache/tacplus/tools/openjml:${PATH}"

# Copy protoc and well-known types from builder
COPY --from=builder /usr/local/bin/protoc /usr/local/bin/protoc
COPY --from=builder /usr/local/include/google /usr/local/include/google

# Copy Go protoc plugins from builder
COPY --from=builder /go/bin/protoc-gen-go /usr/local/bin/protoc-gen-go
COPY --from=builder /go/bin/protoc-gen-go-grpc /usr/local/bin/protoc-gen-go-grpc

# Copy Java gRPC plugin from builder
COPY --from=builder /usr/local/bin/protoc-gen-grpc-java /usr/local/bin/protoc-gen-grpc-java

# Copy TypeScript protoc plugin from builder
COPY --from=builder /usr/lib/node_modules /usr/lib/node_modules
RUN ln -sf /usr/lib/node_modules/@bufbuild/protoc-gen-es/bin/protoc-gen-es /usr/local/bin/protoc-gen-es

# Copy Swift protoc plugins and the Swift runtime libraries they require.
COPY --from=swift-plugin-builder /usr/local/bin/protoc-gen-swift /usr/local/bin/protoc-gen-swift
COPY --from=swift-plugin-builder /usr/local/bin/protoc-gen-grpc-swift-2 /usr/local/bin/protoc-gen-grpc-swift-2
COPY --from=swift-plugin-builder /opt/swift-runtime /opt/swift-runtime
ENV LD_LIBRARY_PATH="/opt/swift-runtime/lib:${LD_LIBRARY_PATH}"

ENV TACPLUS_CONTAINER=1

WORKDIR /workspace

# Verify all tools are present (fail the build if anything is missing)
RUN set -e \
    && protoc --version \
    && protoc-gen-go --version \
    && protoc-gen-go-grpc --version \
    && protoc-gen-es --version \
    && protoc-gen-swift --version \
    && protoc-gen-grpc-swift-2 --version \
    && protoc-gen-prost --version \
    && test -x /usr/local/bin/protoc-gen-tonic \
    && test -x /usr/local/bin/protoc-gen-prost-serde \
    && test -x /usr/local/bin/protoc-gen-grpc-java \
    && black --version \
    && jbmc --version \
    && test -f /root/.cache/tacplus/tools/openjml/openjml \
    && rg --version
