{{if .HasAutoTls}}
// errTlsFirstCertFatal stops the TLS cert stream loop when the handler rejects
// the FIRST certificate delivery. Retrying is pointless: a handler that refuses
// a valid certificate will refuse its successor too.
//
// It is fatal to the STREAM, not to startup. Unlike the SMB stream, the TLS
// renewal stream does not gate Listen — the gRPC server is already serving the
// X509Mint certificate obtained before Run — so Run does NOT return this error.
// It is wrapped onto readyCh, and Run's background drain marks the instance
// DEGRADED and keeps serving the boot certificate until it expires (PC-L-1).
var errTlsFirstCertFatal = fmt.Errorf("handler rejected first TLS certificate delivery")

// drainTLSFirstDelivery is Run's background consumer of the TLS renewal
// stream's first-delivery signal: it waits for the outcome on readyCh and, on a
// failure, reports the instance DEGRADED through degrade. It is a function, not
// inline in Run, so the cert-stream gate can drive it with the signal a real
// tlsCertStreamLoop sends (PC-L-2b).
//
// Two very different faults arrive on this channel and they must not be
// reported with the same words. errTlsFirstCertFatal means the authority DID
// deliver a certificate and this service's own handler refused it — an operator
// told "the stream gave up before first delivery" would go and debug the
// authority or the network, which is the wrong half of the system. The give-up
// case is the other one.
func drainTLSFirstDelivery(ctx context.Context, readyCh <-chan error, degrade func(string)) {
select {
case err := <-readyCh:
if err == nil {
return
}
if errors.Is(err, errTlsFirstCertFatal) {
zap.L().Error("handler rejected the first renewed TLS certificate; renewal stream stopped, serving on the initial X509Mint certificate until it expires", zap.Error(err))
degrade("TLS handler rejected the first renewed certificate: " + err.Error())
} else {
zap.L().Error("TLS cert renewal stream failed before first delivery; serving on the initial X509Mint certificate until it expires", zap.Error(err))
degrade("TLS renewal stream gave up before first delivery: " + err.Error())
}
case <-ctx.Done():
}
}

// tlsCertStreamLoop manages the bidi TLS certificate stream.
// It retries with backoff on disconnection. The outcome of the first cert
// delivery is signalled on readyCh: nil on success, an errTlsFirstCertFatal-
// wrapped error when the handler rejected it, or a give-up error once the
// retry budget is spent. A handler failure on the FIRST delivery stops the
// loop, while later renewal-delivery failures are logged and the previous cert
// stays in service.
// maxInitRetries is the first-delivery retry budget; it falls back to
// certStreamMaxInitRetries when non-positive. It is a parameter rather than a
// const so an exhaustion test can spend the budget in seconds (PC-L-3);
// production passes certStreamMaxInitRetries.
// degrade reports a renewal fault into the ServiceManager health plane. Every
// path below that keeps the PREVIOUS certificate in service must call it: the
// instance goes on serving a certificate that will expire, and without a health
// signal it reports Ready right up to the outage (PC-L-1).
func tlsCertStreamLoop(ctx context.Context, connProvider func() grpc.ClientConnInterface, serviceLabel string, h Handler, tp func() (string, error), store func(*x509_pb.X509CertChain, []byte), degrade func(string), readyCh chan<- error, maxInitRetries int) {
if maxInitRetries <= 0 {
maxInitRetries = certStreamMaxInitRetries
}
initAttempts := 0
for {
seen := service_im.CredentialGeneration()
delivered, err := runTlsCertStream(ctx, connProvider, serviceLabel, h, tp, store, degrade, readyCh)
if delivered {
readyCh = nil
initAttempts = 0
// A DELIVERED certificate proves the credential was accepted. Without
// this the TLS loop could only ever increment the rejection counter, so
// a service with no state watches — the only other clear site — would
// stay degraded forever after a brief authority blip, even once it
// reconnected happily. Mirrors rust's tls_cert_stream_loop.
service_im.NoteCredentialAccepted()
}
if err != nil {
if ctx.Err() != nil || err == errTlsFirstCertFatal {
return
}
// A rejected credential must invalidate the token cache here too: this
// stream renews the serving certificate, so a stuck credential costs the
// service its TLS as well as its authentication.
service_im.NoteIfCredentialRejection(err, seen)
delay := 5 * time.Second
if readyCh != nil {
initAttempts++
if initAttempts >= maxInitRetries {
select {
case readyCh <- fmt.Errorf("TLS cert stream failed before first delivery after %d attempts: %w", initAttempts, err):
default:
}
return
}
delay = time.Duration(min(1<<min(initAttempts, 5), 30)) * time.Second
zap.L().Warn("TLS cert stream failed before first delivery, retrying",
zap.Int("attempt", initAttempts), zap.Int("max", maxInitRetries), zap.Duration("delay", delay), zap.Error(err))
} else {
zap.L().Warn("TLS cert stream disconnected, retrying", zap.Duration("delay", delay), zap.Error(err))
}
select {
case <-time.After(delay):
case <-ctx.Done():
return
}
continue
}
return
}
}

// runTlsCertStream runs one ManageCert stream session. It reports whether the
// first cert delivery was signalled on readyCh during this session, plus the
// session error (errTlsFirstCertFatal when the handler rejected the first cert).
func runTlsCertStream(ctx context.Context, connProvider func() grpc.ClientConnInterface, serviceLabel string, h Handler, tp func() (string, error), store func(*x509_pb.X509CertChain, []byte), degrade func(string), readyCh chan<- error) (bool, error) {
delivered := false
conn := connProvider()
if conn == nil {
return delivered, fmt.Errorf("no active connection for ManageCert")
}
token, err := tp()
if err != nil {
return delivered, fmt.Errorf("token provider failed for ManageCert: %w", err)
}
md := metadata.Pairs("authorization", "Bearer "+token)
authCtx := metadata.NewOutgoingContext(ctx, md)
client := tlscert_pb.NewTlsCertServiceClient(conn)
stream, err := client.ManageCert(authCtx)
if err != nil {
return delivered, fmt.Errorf("open ManageCert stream: %w", err)
}
defer func() { _ = stream.CloseSend() }()

privateKeyDER, publicKeyDER, pubProto, err := generateKeyAndProto()
if err != nil {
return delivered, fmt.Errorf("generate keypair: %w", err)
}
activePrivateKeyDER := privateKeyDER
activePublicKeyDER := publicKeyDER
var pendingPrivateKeyDER []byte
var pendingPublicKeyDER []byte

hostname, _ := os.Hostname()
if err := stream.Send(&tlscert_pb.TlsCertClientMsg{
Msg: &tlscert_pb.TlsCertClientMsg_Init{Init: &tlscert_pb.TlsCertInit{
ServiceName: serviceLabel,
InstanceId:  hostname,
}},
}); err != nil {
return delivered, fmt.Errorf("send Init: %w", err)
}

if err := stream.Send(&tlscert_pb.TlsCertClientMsg{
Msg: &tlscert_pb.TlsCertClientMsg_Csr{Csr: &tlscert_pb.TlsCertCsr{
PublicKey: pubProto,
}},
}); err != nil {
return delivered, fmt.Errorf("send Csr: %w", err)
}

for {
serverMsg, err := stream.Recv()
if err != nil {
return delivered, fmt.Errorf("recv: %w", err)
}

switch m := serverMsg.Msg.(type) {
case *tlscert_pb.TlsCertServerMsg_Cert:
certKeyDER := activePrivateKeyDER
certPublicKeyDER := activePublicKeyDER
if pendingPrivateKeyDER != nil {
certKeyDER = pendingPrivateKeyDER
certPublicKeyDER = pendingPublicKeyDER
}
if err := certLeafMatchesPublicKey(m.Cert.Chain, certPublicKeyDER); err != nil {
if readyCh != nil {
return delivered, fmt.Errorf("TLS cert public key mismatch: %w", err)
}
zap.L().Error("TLS cert public key mismatch on renewal delivery, keeping previous cert", zap.Error(err))
degrade("renewed TLS certificate does not match the requested key, keeping the previous certificate: " + err.Error())
pendingPrivateKeyDER = nil
pendingPublicKeyDER = nil
continue
}
err := h.NewTlsCert(m.Cert.Chain, certKeyDER)
if readyCh != nil {
// First delivery: report the outcome to Run(). A handler failure
// here is fatal TO THE STREAM — the loop stops retrying, because a
// handler that refuses a valid certificate will refuse the next one
// too. It does NOT abort startup: the gRPC server is already serving
// the X509Mint certificate obtained before Run (see the Listen
// comment above), so Run marks the instance DEGRADED and keeps
// serving until that boot certificate expires.
delivered = true
if err != nil {
// Wrap with the sentinel so the Run() drain can distinguish a
// rejected delivery from an authority that never delivered.
readyCh <- fmt.Errorf("%w: %w", errTlsFirstCertFatal, err)
readyCh = nil
return delivered, errTlsFirstCertFatal
}
readyCh <- nil
readyCh = nil
if store != nil {
store(m.Cert.Chain, certKeyDER)
}
activePrivateKeyDER = certKeyDER
activePublicKeyDER = certPublicKeyDER
pendingPrivateKeyDER = nil
pendingPublicKeyDER = nil
} else if err != nil {
// Renewal delivery: keep serving with the previous cert.
zap.L().Error("Handler NewTlsCert failed on renewal delivery, keeping previous cert", zap.Error(err))
degrade("TLS handler rejected a renewed certificate, keeping the previous certificate: " + err.Error())
pendingPrivateKeyDER = nil
pendingPublicKeyDER = nil
} else {
// Renewal accepted: publish to the ServiceManager so live gRPC servers
// hot-reload the serving certificate on their next handshake (PC-L-10).
if store != nil {
store(m.Cert.Chain, certKeyDER)
}
activePrivateKeyDER = certKeyDER
activePublicKeyDER = certPublicKeyDER
pendingPrivateKeyDER = nil
pendingPublicKeyDER = nil
}
case *tlscert_pb.TlsCertServerMsg_Renew:
zap.L().Info("TLS cert renewal requested", zap.String("reason", m.Renew.Reason))
privateKeyDER, publicKeyDER, pubProto, err = generateKeyAndProto()
if err != nil {
return delivered, fmt.Errorf("generate renewal keypair: %w", err)
}
pendingPrivateKeyDER = privateKeyDER
pendingPublicKeyDER = publicKeyDER
if err := stream.Send(&tlscert_pb.TlsCertClientMsg{
Msg: &tlscert_pb.TlsCertClientMsg_Csr{Csr: &tlscert_pb.TlsCertCsr{
PublicKey: pubProto,
}},
}); err != nil {
return delivered, fmt.Errorf("send renewal Csr: %w", err)
}
case *tlscert_pb.TlsCertServerMsg_Error:
return delivered, fmt.Errorf("server error: %s", m.Error)
}
}
}
{{end}}

{{if .HasSmb}}
// errSmbFirstCertFatal stops the SMB cert stream loop when the handler rejects
// the FIRST member-cert delivery — the instance cannot join its black-box peer
// mesh without a usable credential, so startup must abort.
var errSmbFirstCertFatal = fmt.Errorf("handler rejected first SMB member cert delivery")

// smbCertStreamLoop manages the SMB member-cert stream (SPIFFE plan D7). It
// retries with backoff on disconnection. The outcome of the first delivery is
// signalled on readyCh; a handler failure on the FIRST delivery is fatal and
// stops the loop, while later renewal-delivery failures are logged and the
// previous credential stays in use.
func smbCertStreamLoop(ctx context.Context, connProvider func() grpc.ClientConnInterface, serviceLabel string, h Handler, tp func() (string, error), readyCh chan<- error) {
initAttempts := 0
for {
seen := service_im.CredentialGeneration()
delivered, err := runSmbCertStream(ctx, connProvider, serviceLabel, h, tp, readyCh)
if delivered {
readyCh = nil
initAttempts = 0
// A DELIVERED member cert proves the credential was accepted. Mirrors the
// TLS loop above: without it an SMB-only service (no auto-TLS, no state
// watches) has no site that can ever clear the rejection counter, so it
// stays degraded forever after a brief authority blip.
service_im.NoteCredentialAccepted()
}
if err != nil {
if ctx.Err() != nil || err == errSmbFirstCertFatal {
return
}
// A rejected credential must invalidate the token cache here too. Without
// this an UNAUTHENTICATED ManageSmbCert stream retries forever presenting
// the SAME cached token and never re-mints, so the member never rejoins
// its peer mesh. Mirrors tlsCertStreamLoop above.
service_im.NoteIfCredentialRejection(err, seen)
delay := 5 * time.Second
if readyCh != nil {
initAttempts++
if initAttempts >= certStreamMaxInitRetries {
select {
case readyCh <- fmt.Errorf("SMB cert stream failed before first delivery after %d attempts: %w", initAttempts, err):
default:
}
return
}
delay = time.Duration(min(1<<min(initAttempts, 5), 30)) * time.Second
zap.L().Warn("SMB cert stream failed before first delivery, retrying",
zap.Int("attempt", initAttempts), zap.Int("max", certStreamMaxInitRetries), zap.Duration("delay", delay), zap.Error(err))
} else {
zap.L().Warn("SMB cert stream disconnected, retrying", zap.Duration("delay", delay), zap.Error(err))
}
select {
case <-time.After(delay):
case <-ctx.Done():
return
}
continue
}
return
}
}

// runSmbCertStream runs one ManageSmbCert stream session. The instance generates
// its own member keypair and submits a CSR (public key only); its private key
// never leaves the process. The authority signs under the stable per-SMB CA and
// returns the member cert chain + the per-SMB CA trust anchor, handed to the
// handler via NewSmbCert (the consumer wires it into its black-box mTLS).
func runSmbCertStream(ctx context.Context, connProvider func() grpc.ClientConnInterface, serviceLabel string, h Handler, tp func() (string, error), readyCh chan<- error) (bool, error) {
delivered := false
conn := connProvider()
if conn == nil {
return delivered, fmt.Errorf("no active connection for ManageSmbCert")
}
token, err := tp()
if err != nil {
return delivered, fmt.Errorf("token provider failed for ManageSmbCert: %w", err)
}
md := metadata.Pairs("authorization", "Bearer "+token)
authCtx := metadata.NewOutgoingContext(ctx, md)
client := smbcert_pb.NewSmbCertServiceClient(conn)
stream, err := client.ManageSmbCert(authCtx)
if err != nil {
return delivered, fmt.Errorf("open ManageSmbCert stream: %w", err)
}
defer func() { _ = stream.CloseSend() }()

privateKeyDER, publicKeyDER, pubProto, err := generateKeyAndProto()
if err != nil {
return delivered, fmt.Errorf("generate keypair: %w", err)
}
activePrivateKeyDER := privateKeyDER
activePublicKeyDER := publicKeyDER
var pendingPrivateKeyDER []byte
var pendingPublicKeyDER []byte

hostname, _ := os.Hostname()
if err := stream.Send(&smbcert_pb.SmbCertClientMsg{
Msg: &smbcert_pb.SmbCertClientMsg_Init{Init: &smbcert_pb.SmbCertInit{
SmbService: serviceLabel,
InstanceId: hostname,
}},
}); err != nil {
return delivered, fmt.Errorf("send Init: %w", err)
}

if err := stream.Send(&smbcert_pb.SmbCertClientMsg{
Msg: &smbcert_pb.SmbCertClientMsg_Csr{Csr: &smbcert_pb.SmbCertCsr{
PublicKey: pubProto,
}},
}); err != nil {
return delivered, fmt.Errorf("send Csr: %w", err)
}

for {
serverMsg, err := stream.Recv()
if err != nil {
return delivered, fmt.Errorf("recv: %w", err)
}

switch m := serverMsg.Msg.(type) {
case *smbcert_pb.SmbCertServerMsg_Cert:
certKeyDER := activePrivateKeyDER
certPublicKeyDER := activePublicKeyDER
if pendingPrivateKeyDER != nil {
certKeyDER = pendingPrivateKeyDER
certPublicKeyDER = pendingPublicKeyDER
}
if err := certLeafMatchesPublicKey(m.Cert.MemberChain, certPublicKeyDER); err != nil {
if readyCh != nil {
return delivered, fmt.Errorf("SMB member cert public key mismatch: %w", err)
}
zap.L().Error("SMB member cert public key mismatch on renewal delivery, keeping previous credential", zap.Error(err))
pendingPrivateKeyDER = nil
pendingPublicKeyDER = nil
continue
}
err := h.NewSmbCert(m.Cert.MemberChain, certKeyDER, m.Cert.Ca)
if readyCh != nil {
// First delivery: report the outcome to Run(). A handler failure here is
// fatal — the instance must not start without its SMB member credential.
delivered = true
readyCh <- err
readyCh = nil
if err != nil {
return delivered, errSmbFirstCertFatal
}
activePrivateKeyDER = certKeyDER
activePublicKeyDER = certPublicKeyDER
pendingPrivateKeyDER = nil
pendingPublicKeyDER = nil
} else if err != nil {
// Renewal delivery: keep using the previous credential.
zap.L().Error("Handler NewSmbCert failed on renewal delivery, keeping previous credential", zap.Error(err))
pendingPrivateKeyDER = nil
pendingPublicKeyDER = nil
} else {
activePrivateKeyDER = certKeyDER
activePublicKeyDER = certPublicKeyDER
pendingPrivateKeyDER = nil
pendingPublicKeyDER = nil
}
case *smbcert_pb.SmbCertServerMsg_Renew:
zap.L().Info("SMB member cert renewal requested", zap.String("reason", m.Renew.Reason))
privateKeyDER, publicKeyDER, pubProto, err = generateKeyAndProto()
if err != nil {
return delivered, fmt.Errorf("generate renewal keypair: %w", err)
}
pendingPrivateKeyDER = privateKeyDER
pendingPublicKeyDER = publicKeyDER
if err := stream.Send(&smbcert_pb.SmbCertClientMsg{
Msg: &smbcert_pb.SmbCertClientMsg_Csr{Csr: &smbcert_pb.SmbCertCsr{
PublicKey: pubProto,
}},
}); err != nil {
return delivered, fmt.Errorf("send renewal Csr: %w", err)
}
case *smbcert_pb.SmbCertServerMsg_Error:
return delivered, fmt.Errorf("server error: %s", m.Error)
}
}
}
{{end}}

