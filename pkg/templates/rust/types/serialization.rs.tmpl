/// Normalizes enum string values to i32 in a JSON Value tree for {{.TypeName}}.
/// Converts canonical proto enum names (e.g., "LEVEL_DEBUG") and friendly
/// names to their i32 representation before serde deserialization.
pub fn normalize_{{.SnakeName}}_enums(v: &mut serde_json::Value) {
if let Some(obj) = v.as_object_mut() {
{{- range .EnumFields}}
{{- if .IsRepeated}}
{ let key = if obj.contains_key("{{.CamelName}}") { "{{.CamelName}}" } else { "{{.FieldName}}" };
if let Some(arr) = obj.get_mut(key).and_then(|v| v.as_array_mut()) {
for item in arr.iter_mut() {
if let Some(s) = item.as_str() {
if let Ok(i) = {{.EnumTypeName}}::parse_i32(s) {
*item = serde_json::Value::Number(serde_json::Number::from(i));
}
}
}
} }
{{- else}}
{ let key = if obj.contains_key("{{.CamelName}}") { "{{.CamelName}}" } else { "{{.FieldName}}" };
if let Some(val) = obj.get_mut(key) {
if let Some(s) = val.as_str() {
if let Ok(i) = {{.EnumTypeName}}::parse_i32(s) {
*val = serde_json::Value::Number(serde_json::Number::from(i));
}
}
} }
{{- end}}
{{- end}}
{{- range .MessageFields}}
{{- if .IsRepeated}}
{ let key = if obj.contains_key("{{.CamelName}}") { "{{.CamelName}}" } else { "{{.FieldName}}" };
if let Some(arr) = obj.get_mut(key).and_then(|v| v.as_array_mut()) {
for item in arr.iter_mut() {
{{- if .CratePath}}
{{.CratePath}}::{{.NormalizeFn}}(item);
{{- else}}
{{.NormalizeFn}}(item);
{{- end}}
}
} }
{{- else}}
{ let key = if obj.contains_key("{{.CamelName}}") { "{{.CamelName}}" } else { "{{.FieldName}}" };
if let Some(val) = obj.get_mut(key) {
{{- if .CratePath}}
{{.CratePath}}::{{.NormalizeFn}}(val);
{{- else}}
{{.NormalizeFn}}(val);
