package {{.ChassisBase}}.backoff;

import io.grpc.Status;
import io.grpc.StatusRuntimeException;
import java.time.Duration;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.HashSet;
import java.util.List;
import java.util.Set;
import java.util.concurrent.atomic.AtomicInteger;

// Pins the Java reconnect backoff to the Rust chassis (backoff.rs): 500ms first
// step, doubling, 30s cap. And pins retryWhileUnavailable, which the generated
// singleton state fetch wraps its Get in (stratum defect #8): UNAVAILABLE is
// retried until the call answers, every other status is rethrown at once.
public class BackoffTest {
    private static int failures = 0;

    private static void check(String name, boolean ok) {
        if (!ok) {
            System.err.println("FAIL: " + name);
            failures++;
        }
    }

    public static void main(String[] args) {
        List<Long> schedule = new ArrayList<>();
        Duration d = Backoff.RECONNECT_INITIAL_BACKOFF;
        schedule.add(d.toMillis());
        for (int i = 0; i < 8; i++) {
            d = Backoff.nextReconnectBackoff(d);
            schedule.add(d.toMillis());
        }
        check("schedule doubles from 500ms to the 30s cap, got " + schedule,
                schedule.equals(Arrays.asList(500L, 1_000L, 2_000L, 4_000L, 8_000L, 16_000L, 30_000L, 30_000L, 30_000L)));
        check("never exceeds cap", Backoff.nextReconnectBackoff(Backoff.RECONNECT_MAX_BACKOFF)
                .equals(Backoff.RECONNECT_MAX_BACKOFF));

        // UNAVAILABLE for 8 attempts (past the cap), then the call answers.
        List<Duration> slept = new ArrayList<>();
        AtomicInteger calls = new AtomicInteger();
        String got = Backoff.retryWhileUnavailable(() -> {
            if (calls.incrementAndGet() <= 8) {
                throw Status.UNAVAILABLE.withDescription("Connection refused").asRuntimeException();
            }
            return "config";
        }, slept::add);
        check("returns the value once the call answers, got " + got, "config".equals(got));
        check("called 9 times, got " + calls.get(), calls.get() == 9);
        List<Long> sleptMillis = new ArrayList<>();
        for (Duration s : slept) {
            sleptMillis.add(s.toMillis());
        }
        List<Long> schedule8 = Arrays.asList(500L, 1_000L, 2_000L, 4_000L, 8_000L, 16_000L, 30_000L, 30_000L);
        boolean inBand = sleptMillis.size() == schedule8.size();
        for (int i = 0; inBand && i < schedule8.size(); i++) {
            long step = schedule8.get(i);
            inBand = sleptMillis.get(i) >= step && sleptMillis.get(i) <= step + step / 4;
        }
        check("slept the reconnect schedule (plus up to a quarter) between attempts, got " + sleptMillis, inBand);

        // 40 clients lose the same peer at the same instant. On the second step
        // they must not all sleep the same delay, or they dial together.
        Set<Long> secondStep = new HashSet<>();
        for (int client = 0; client < 40; client++) {
            List<Duration> clientSlept = new ArrayList<>();
            AtomicInteger clientCalls = new AtomicInteger();
            Backoff.retryWhileUnavailable(() -> {
                if (clientCalls.incrementAndGet() <= 2) {
                    throw Status.UNAVAILABLE.withDescription("Connection refused").asRuntimeException();
                }
                return "config";
            }, clientSlept::add);
            secondStep.add(clientSlept.get(1).toMillis());
        }
        check("40 clients at one step must not all sleep the same delay, got " + secondStep, secondStep.size() > 1);

        // Any other status is fatal: rethrown on the first attempt, no sleep. The
        // sleeper aborts the loop if it is ever reached, so a regression that
        // retried this status fails here instead of spinning forever.
        slept.clear();
        calls.set(0);
        try {
            Backoff.retryWhileUnavailable(() -> {
                calls.incrementAndGet();
                throw Status.PERMISSION_DENIED.asRuntimeException();
            }, delay -> {
                slept.add(delay);
                throw new InterruptedException("PERMISSION_DENIED must not be retried");
            });
            check("PERMISSION_DENIED did not throw", false);
        } catch (StatusRuntimeException e) {
            check("rethrows PERMISSION_DENIED, got " + e.getStatus().getCode(),
                    e.getStatus().getCode() == Status.Code.PERMISSION_DENIED);
        }
        check("PERMISSION_DENIED called once, got " + calls.get(), calls.get() == 1);
        check("PERMISSION_DENIED never slept, got " + slept, slept.isEmpty());
        Thread.interrupted();

        if (failures > 0) {
            System.err.println(failures + " Backoff check(s) FAILED");
            System.exit(1);
        }
        System.out.println("BackoffTest: all checks passed");
    }
}
