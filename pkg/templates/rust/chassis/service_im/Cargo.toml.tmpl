[package]
name = "service_im"
version = "0.1.0"
edition = "2021"
description = "Service identity manager: token exchange, caching, and renewal"

[dependencies]
{{.CrateBasePath}}-types = { path = "../../types" }
key = { path = "../key" }
token = { path = "../token" }
grpcconfig = { path = "../grpcconfig" }
tonic = { version = "0.14", features = ["tls-ring"] }
prost = "0.14"
tokio = { version = "1", features = ["full"] }
reqwest = { version = "0.12", features = ["rustls-tls"], default-features = false }
base64 = "0.22"
chrono = { version = "0.4", features = ["serde"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
sha2 = "0.10"
hmac = "0.12"
hex = "0.4"
rand = "0.8"
ed25519-dalek = { version = "2", features = ["rand_core"] }
async-trait = "0.1"
tracing = "0.1"
url = "2"
urlencoding = "2"
prost-wkt-types = "0.7"
