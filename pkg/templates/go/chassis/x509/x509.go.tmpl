		case protoX509.X509ExtKeyUsage_X509_EXT_KEY_USAGE_IPSEC_USER:
			extKeyUsage = append(extKeyUsage, stdx509.ExtKeyUsageIPSECUser)
		case protoX509.X509ExtKeyUsage_X509_EXT_KEY_USAGE_TIME_STAMPING:
			extKeyUsage = append(extKeyUsage, stdx509.ExtKeyUsageTimeStamping)
		case protoX509.X509ExtKeyUsage_X509_EXT_KEY_USAGE_OCSP_SIGNING:
