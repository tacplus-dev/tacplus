[package]
name = "grpcconfig"
version = "0.1.0"
edition = "2021"
description = "Bootstrap config loader from CLI flags and environment variables"

[dependencies]
{{.CrateBasePath}}-types = { path = "../../types" }
logger = { path = "../logger" }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
serde_yaml = "0.9"
