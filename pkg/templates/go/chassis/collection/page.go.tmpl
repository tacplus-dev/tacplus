	"bytes"
	"encoding/base64"
	"encoding/json"

	"google.golang.org/grpc/codes"
	"google.golang.org/grpc/status"
)

// ErrBadPageToken is the INVALID_ARGUMENT status the wrapper returns when a
// page_token does not decode (corrupt, truncated, or from an incompatible token
// version). The wrapper never silently resets to the first page on a bad token —
// that would skip rows and read as success, hiding a client bug or tamper.
var ErrBadPageToken = status.Error(codes.InvalidArgument, "page_token is malformed or from an incompatible version")

// pageTokenVersion is the on-the-wire token schema version. Bump only on a
// breaking change to the encoded shape; DecodePageToken rejects other versions
// via ErrBadPageToken so a stale token never silently mis-decodes.
const pageTokenVersion = 1

// Cursor is the keyset position of a page boundary: the order_by key components
// of the last row in a page, as strings (the handler parses them back to typed
// values — it owns the column types). A nil *Cursor means "from the beginning".
// The component order matches the method's order_by annotation.
type Cursor struct {
	Keys []string
}

// PageParams is what the wrapper hands the handler for one PAGE call: the
// effective row limit (already defaulted and clamped to the trust-tier ceiling)
// and the decoded After cursor (nil on the first page).
type PageParams struct {
	Limit int
	After *Cursor
}

// Page is what a PAGE handler returns: the window of items, the cursor to resume
// after (nil when this is the last page), and an optional Total. Total is -1
// when the handler does not compute a count — the wrapper then leaves
// total_count at 0 and callers must treat it as unknown, not "empty".
type Page[T any] struct {
	Items     []T
	NextAfter *Cursor
	Total     int64
}

// pageTokenEnvelope is the JSON shape inside the base64url token. Field names
// are kept short and fixed so the encoding is byte-identical across languages.
type pageTokenEnvelope struct {
	V int      `json:"v"`
	K []string `json:"k"`
}

// EncodePageToken serializes a cursor into the opaque next_page_token. A nil
// cursor (last page) encodes to the empty string, which the auto-pager treats
// as the stop signal.
func EncodePageToken(c *Cursor) (string, error) {
	if c == nil {
		return "", nil
	}
	keys := c.Keys
	if keys == nil {
		keys = []string{}
	}
	// SetEscapeHTML(false) so the encoding matches the TS/Python/Rust backends,
	// which do not escape <, >, & — the token must be byte-identical across
	// languages for a polyglot client fleet and the interop harness.
	var buf bytes.Buffer
	enc := json.NewEncoder(&buf)
	enc.SetEscapeHTML(false)
	if err := enc.Encode(pageTokenEnvelope{V: pageTokenVersion, K: keys}); err != nil {
		return "", err
	}
	raw := bytes.TrimRight(buf.Bytes(), "\n") // Encode appends a trailing newline
	// encoding/json unconditionally escapes U+2028/U+2029 (a legacy JavaScript
	// eval safety measure); the other four language backends emit them raw.
	// Replace the escapes with the raw characters so the token stays
	// byte-identical across languages (DecodePageToken accepts both forms).
	raw = unescapeLineSeparators(raw)
