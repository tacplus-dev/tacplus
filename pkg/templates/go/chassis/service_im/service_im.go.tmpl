// Cloud-native identity detection
// ---------------------------------------------------------------------------

// detectCloud probes cloud metadata endpoints to determine which cloud
// environment the process is running in.
func detectCloud(ctx context.Context) (cloudvendor_pb.CloudVendor, error) {
	httpClient := &http.Client{Timeout: imdsTimeout}

	// 1. GCP: metadata server with Google-specific header
	if req, err := http.NewRequestWithContext(ctx, "GET", "http://169.254.169.254/", nil); err == nil {
		req.Header.Set("Metadata-Flavor", "Google")
		if resp, err := httpClient.Do(req); err == nil {
			resp.Body.Close()
			if resp.StatusCode == http.StatusOK {
				if resp.Header.Get("Metadata-Flavor") == "Google" {
					return cloudvendor_pb.CloudVendor_CLOUD_VENDOR_GCP, nil
				}
			}
		}
	}

	// 2. Azure: instance metadata with Azure-specific header
	if req, err := http.NewRequestWithContext(ctx, "GET",
		"http://169.254.169.254/metadata/instance?api-version=2021-02-01", nil); err == nil {
		req.Header.Set("Metadata", "true")
		if resp, err := httpClient.Do(req); err == nil {
			resp.Body.Close()
			if resp.StatusCode == http.StatusOK {
				return cloudvendor_pb.CloudVendor_CLOUD_VENDOR_AZURE, nil
			}
		}
	}

	// 3. AWS: IMDSv2 session token (preferred) or IMDSv1 fallback
	if req, err := http.NewRequestWithContext(ctx, "PUT",
		"http://169.254.169.254/latest/api/token", nil); err == nil {
		req.Header.Set("X-aws-ec2-metadata-token-ttl-seconds", "21600")
		if resp, err := httpClient.Do(req); err == nil {
			resp.Body.Close()
			if resp.StatusCode == http.StatusOK {
				return cloudvendor_pb.CloudVendor_CLOUD_VENDOR_AWS, nil
			}
		}
	}
	// IMDSv1 fallback
	if req, err := http.NewRequestWithContext(ctx, "GET",
		"http://169.254.169.254/latest/meta-data/", nil); err == nil {
		if resp, err := httpClient.Do(req); err == nil {
			resp.Body.Close()
			if resp.StatusCode == http.StatusOK {
				return cloudvendor_pb.CloudVendor_CLOUD_VENDOR_AWS, nil
			}
		}
	}

	// 4. AWS EKS IRSA: projected service account token
	if os.Getenv("AWS_WEB_IDENTITY_TOKEN_FILE") != "" {
		return cloudvendor_pb.CloudVendor_CLOUD_VENDOR_AWS, nil
	}

	return cloudvendor_pb.CloudVendor_CLOUD_VENDOR_UNDEFINED,
		fmt.Errorf("no cloud metadata service detected (tried GCP, Azure, AWS)")
}

