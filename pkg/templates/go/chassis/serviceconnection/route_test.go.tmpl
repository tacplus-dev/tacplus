// A tid is exactly 8 characters of [0-9a-z]: nothing is trimmed or folded.
func TestValidTenantID(t *testing.T) {
	for _, ok := range []string{"aaaaaaaa", "00000001", "a1b2c3d4", "zzzzzzzz"} {
		if !ValidTenantID(ok) {
			t.Fatalf("%q must be a tid", ok)
		}
	}
	for _, bad := range []string{"", "aaaaaaa", "aaaaaaaaa", "AAAAAAAA", "aaaaaaaA", " aaaaaaa", "aaaaaaa ", "aaaa-aaa", "aaaa/aaa", "aaaaaaa\n", "äaaaaaa"} {
		if ValidTenantID(bad) {
			t.Fatalf("%q must not be a tid", bad)
		}
	}
}

