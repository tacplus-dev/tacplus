class _FirstTlsCertDeliveryError(RuntimeError):
    """Handler rejected the first auto-TLS certificate delivery.

    Fatal by cross-language policy: startup must fail (non-zero exit) rather
    than retry — later renewal-delivery failures stay log-and-continue.
    """
{{- end}}

{{- if .HasSmb}}


class _FirstSmbCertDeliveryError(RuntimeError):
    """Handler rejected the first SMB member-cert delivery.

    Fatal by cross-language policy: an SMB member cannot join its black-box peer
    mesh without its per-SMB CA + member cert, so startup must fail (non-zero
    exit) rather than retry — later renewal-delivery failures stay
    log-and-continue.
    """
{{- end}}


class _GrpcHealthHandler(grpc.GenericRpcHandler):
    """Implements grpc.health.v1.Health/Check (unauthenticated)."""

    def __init__(self, ready) -> None:
        self._ready = ready

    def service(self, handler_call_details):
        if handler_call_details.method == '/grpc.health.v1.Health/Check':
            return grpc.unary_unary_rpc_method_handler(
                self._check,
                request_deserializer=lambda x: x,
                response_serializer=lambda x: x,
            )
        return None

    def _check(self, request, context):
        # HealthCheckResponse { status: SERVING(1) or NOT_SERVING(2) }.
        return b'\x08\x01' if self._ready() else b'\x08\x02'
