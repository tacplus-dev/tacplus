    /// A pool holding one dialed (lazy) endpoint, reported by the fleet health
    /// plane with `status`.
    async fn pool(service_id: &str, status: InstanceStatus) -> Arc<ServiceConnection> {
        let channel = tonic::transport::Endpoint::from_static("http://127.0.0.1:1").connect_lazy();
        let sc = ServiceConnection::from_channel(service_id, channel, verifier());
        sc.set_endpoint_health_for_test(status).await;
