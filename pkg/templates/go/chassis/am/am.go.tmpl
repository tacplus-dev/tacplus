	d := &accountingDiskSpool{dir: dir, acked: cursor, saved: cursor, total: len(lines)}
	var pending []*accountingrecord_pb.AccountingRecord
	for i, line := range lines {
		d.size += int64(len(line)) + 1
		if i < cursor {
			continue
		}
		record, err := decodeAccountingRecord(line)
		if err != nil {
			return nil, nil, fmt.Errorf("accounting spool record %d in %s: %w", i, dir, err)
		}
		pending = append(pending, record)
	}
	return d, pending, nil
}

// append writes one record to the log. It fails without writing when the record
// would take the spool past accountingSpoolBytes.
func (d *accountingDiskSpool) append(record *accountingrecord_pb.AccountingRecord) error {
	line, err := encodeAccountingRecord(record)
	if err != nil {
		return err
	}
	if d.size+int64(len(line))+1 > accountingSpoolBytes {
		return errAccountingSpoolFull
	}
	if err := (diskstore.AppendLog{}).Append(d.dir, accountingSpoolLog, line, 0o600); err != nil {
		return err
	}
	d.total++
	d.size += int64(len(line)) + 1
	return nil
}

// ack advances the cursor past one acknowledged record. When every record in the
// log has been acknowledged, the log is removed. The cursor goes back to zero
// first, so a crash between the two steps republishes records the bus already has
// rather than losing one.
func (d *accountingDiskSpool) ack() error {
	d.acked++
	if d.acked == d.total {
		if err := d.saveCursor(0); err != nil {
			d.acked--
			return err
		}
		d.acked, d.total, d.size = 0, 0, 0
		if err := os.Remove(filepath.Join(d.dir, accountingSpoolLog)); err != nil && !errors.Is(err, fs.ErrNotExist) {
			return fmt.Errorf("remove accounting spool log: %w", err)
		}
		return nil
	}
	if d.acked-d.saved >= accountingCursorEvery {
		return d.saveCursor(d.acked)
	}
	return nil
}

// flush writes the cursor if it has moved since it was last written.
func (d *accountingDiskSpool) flush() error {
	if d.acked == d.saved {
		return nil
	}
	return d.saveCursor(d.acked)
}

// saveCursor writes the cursor atomically: a fsynced temp file renamed over the
// cursor, then the directory fsynced so the rename is durable.
func (d *accountingDiskSpool) saveCursor(n int) error {
	path := filepath.Join(d.dir, accountingSpoolCursor)
	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
		return err
	}
	tmp := path + ".tmp"
	f, err := os.OpenFile(tmp, os.O_CREATE|os.O_TRUNC|os.O_WRONLY, 0o600)
	if err != nil {
		return err
	}
	if _, err := f.WriteString(strconv.Itoa(n) + "\n"); err != nil {
		f.Close()
		return err
	}
	if err := f.Sync(); err != nil {
		f.Close()
		return err
	}
	if err := f.Close(); err != nil {
		return err
	}
	if err := os.Rename(tmp, path); err != nil {
		return err
	}
	if dir, err := os.Open(filepath.Dir(path)); err == nil {
		_ = dir.Sync()
		_ = dir.Close()
	}
	d.saved = n
	return nil
}

// readAccountingCursor returns the cursor under dir, zero if none was written.
func readAccountingCursor(dir string) (int, error) {
	raw, err := os.ReadFile(filepath.Join(dir, accountingSpoolCursor))
	if errors.Is(err, fs.ErrNotExist) {
		return 0, nil
	}
	if err != nil {
		return 0, fmt.Errorf("read accounting spool cursor: %w", err)
	}
	n, err := strconv.Atoi(strings.TrimSpace(string(raw)))
	if err != nil || n < 0 {
		return 0, fmt.Errorf("accounting spool cursor %q is not a count", raw)
	}
	return n, nil
}

// encodeAccountingRecord renders a record as one log line: base64 of its proto
// encoding, which never contains a newline.
func encodeAccountingRecord(record *accountingrecord_pb.AccountingRecord) ([]byte, error) {
	raw, err := proto.Marshal(record)
	if err != nil {
		return nil, fmt.Errorf("encode accounting record: %w", err)
	}
	return []byte(base64.StdEncoding.EncodeToString(raw)), nil
}

// decodeAccountingRecord is the inverse of encodeAccountingRecord.
func decodeAccountingRecord(line []byte) (*accountingrecord_pb.AccountingRecord, error) {
	raw, err := base64.StdEncoding.DecodeString(string(line))
	if err != nil {
		return nil, err
	}
	record := &accountingrecord_pb.AccountingRecord{}
	if err := proto.Unmarshal(raw, record); err != nil {
		return nil, err
	}
	return record, nil
}

// nextAccountingID mints the record key. accounting_id is assert_required, so
// it has to be non-empty and unique: process identity + emit time + a
// per-process counter is unique without pulling in a uuid dependency.
func (s *EventBusSink) nextAccountingID(timestampMs int64) string {
	seq := s.seq.Add(1)
	return fmt.Sprintf("%s-%013d-%012d", s.sourceID, timestampMs, seq)
}

// flatten converts the emit-time envelope into the stored record.
//
// spiffe_id is deliberately left unset: eventbus stamps the owner field with
// the PUBLISHER's verified SPIFFE ID on the way in, so a value set here would
// be overwritten, and setting one would be a claim about identity that
// nothing checked.
func (s *EventBusSink) flatten(event *accounting_pb.Event) *accountingrecord_pb.AccountingRecord {
	var method string
	var code int32
	var durationMs int64
	switch payload := event.Event.(type) {
	case *accounting_pb.Event_RpcCompleted:
		method = MethodLabel(payload.RpcCompleted.Method)
		durationMs = payload.RpcCompleted.DurationMs
	case *accounting_pb.Event_RpcError:
		method = MethodLabel(payload.RpcError.Method)
		code = payload.RpcError.Code
		durationMs = payload.RpcError.DurationMs
	case *accounting_pb.Event_TokenRejected:
		method = MethodLabel(payload.TokenRejected.Method)
	}
	return &accountingrecord_pb.AccountingRecord{
		AccountingId: s.nextAccountingID(event.TimestampMs),
		RequestId:    event.RequestId,
		SourceId:     event.SourceId,
		TimestampMs:  event.TimestampMs,
		Level:        event.Level,
		Method:       method,
		Code:         code,
		DurationMs:   durationMs,
		// The principal the Authorizer verified, not a caller-written header.
		PrincipalSub: event.Identity["sub"],
	}
}

// Emit flattens event and spools it without waiting on the publisher. It returns
// an error only when the record is dropped: the service is shutting down, or the
// spool is full.
func (s *EventBusSink) Emit(_ context.Context, event *accounting_pb.Event) error {
	record := s.flatten(event)
	select {
	case <-s.stop:
		// The publish loop is gone, which only happens on shutdown. Loud,
		// because this is the one lossy path.
		zap.L().Error("accounting publisher closed; record dropped",
			zap.String("accounting_id", record.AccountingId))
		return fmt.Errorf("accounting publisher closed; record dropped")
	default:
	}
	select {
	case s.spool <- record:
		return nil
	default:
		total := s.dropped.Add(1)
		zap.L().Error("accounting spool full; record dropped",
			zap.String("accounting_id", record.AccountingId), zap.Uint64("dropped_total", total))
		return fmt.Errorf("accounting spool full; record dropped")
	}
}
