            assert_eq!(tenant_of_caller_namespace(ns).as_deref(), Some("aaaaaaaa"), "{ns:?}");
        }
        for ns in ["", "/", "/system", "/tenants", "/tenants/", "/tenants//aaaaaaaa", "/tenants/acme/users/alice", "/users/aaaaaaaa", "tenants/aaaaaaaa"] {
            assert_eq!(tenant_of_caller_namespace(ns), None, "{ns:?}");
        }
        assert_eq!(
            tenant_of_spiffe_id("spiffe://example.com/tenants/bbbbbbbb/services/crew").as_deref(),
            Some("bbbbbbbb")
        );
        for id in [
            "spiffe://example.com/system/services/crew",
            "spiffe://example.com/tenants/acme/services/crew",
            "not a spiffe id",
            "",
        ] {
            assert_eq!(tenant_of_spiffe_id(id), None, "{id:?}");
        }
    }

    #[test]
    fn backstop_refuses_malformed_and_another_tenant() {
        check_routed_tenant("tenant", "aaaaaaaa", "aaaaaaaa").unwrap();
        // An instance that serves no single tenant only checks the shape.
        check_routed_tenant("tenant", "bbbbbbbb", "").unwrap();
        let err = check_routed_tenant("tenant", "", "aaaaaaaa").unwrap_err();
        assert_eq!(err.code(), tonic::Code::InvalidArgument);
        assert_eq!(host_tenant_of_namespace("/tenants/beta").as_deref(), Some("beta"));
        assert_eq!(host_tenant_of_namespace("/system"), None);
        // An instance of a tenant whose name is not a tid serves no routed call.
        let err = check_routed_tenant("tenant", "aaaaaaaa", "beta").unwrap_err();
        assert_eq!(err.code(), tonic::Code::PermissionDenied);
        let err = check_routed_tenant("tenant", "bbbbbbbb", "aaaaaaaa").unwrap_err();
        assert_eq!(err.code(), tonic::Code::PermissionDenied);
        assert!(err.message().contains("routed to tenant bbbbbbbb, this instance serves tenant aaaaaaaa"), "{}", err.message());
    }
