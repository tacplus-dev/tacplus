			zap.L().Warn("ServiceConnection: failed to connect to new endpoint",
				zap.String("service", sc.serviceID),
				zap.String("target", target),
				zap.Error(err))
			continue
		}
		toAdd = append(toAdd, ec)
		zap.L().Info("ServiceConnection: connected to new endpoint",
			zap.String("service", sc.serviceID),
			zap.String("target", target))
	}

	sc.endpoints = append(kept, toAdd...)
	sc.mu.Unlock()

	// Close removed endpoints outside lock
	for _, ec := range toClose {
		zap.L().Info("ServiceConnection: closing removed endpoint",
			zap.String("service", sc.serviceID),
			zap.String("target", ec.target))
		ec.close()
	}

	sc.selectActive()
}

// selectActive picks the best routable endpoint as active.
// Prefers HEALTHY over DEGRADED. Among same-status endpoints, picks lowest latency.
// Uses hysteresis to prevent flip-flopping.
func (sc *ServiceConnection) selectActive() {
	sc.mu.Lock()
	defer sc.mu.Unlock()

	var best *endpointConn
	var bestLatency int64 = math.MaxInt64
	bestDegraded := true

	for _, ec := range sc.endpoints {
		if !ec.isRoutable() || !ec.isConnected() {
			continue
		}
		degraded := ec.isDegraded()
		lat := ec.getLatencyUs()

		// Prefer HEALTHY over DEGRADED, then lowest latency
		if best == nil ||
			(bestDegraded && !degraded) ||
			(!bestDegraded == !degraded && lat < bestLatency) {
			best = ec
			bestLatency = lat
			bestDegraded = degraded
		}
	}

	if best == nil {
		if sc.active != nil {
			zap.L().Warn("ServiceConnection: no routable endpoints",
				zap.String("service", sc.serviceID))
		}
		return
	}

	// Hysteresis: only switch if improvement is significant
	if sc.active != nil && sc.active.isRoutable() && sc.active.isConnected() && best != sc.active {
		currentDegraded := sc.active.isDegraded()
		// Always switch away from degraded to healthy
		if currentDegraded && !bestDegraded {
			// Switch
		} else if !currentDegraded == !bestDegraded {
			currentLatency := sc.active.getLatencyUs()
			if currentLatency > 0 {
				improvement := float64(currentLatency-bestLatency) / float64(currentLatency)
				if improvement < rebalanceThreshold {
					return // not enough improvement
				}
			}
		} else {
			return // current is healthy, best is degraded -- keep current
		}
	}

	if best != sc.active {
		prev := "<none>"
		if sc.active != nil {
			prev = sc.active.target
		}
		sc.active = best
		zap.L().Info("ServiceConnection: active endpoint changed",
			zap.String("service", sc.serviceID),
			zap.String("from", prev),
			zap.String("to", best.target),
			zap.Int64("latency_us", bestLatency))
	}
}

// Close shuts down all connections in the pool.
