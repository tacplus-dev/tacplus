def {{.FuncPrefix}}_save_toml(msg: {{.QualifiedType}}, filename: str) -> None:
    """Saves {{.TypeName}} to TOML file.

    Requires: pip install tomli-w

    Args:
        msg: Message to save
        filename: Path to TOML file

    Raises:
        ValueError: If msg is None
        ImportError: If tomli-w is not installed
    """
