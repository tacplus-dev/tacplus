//! SM-managed roll scheduler: deterministic per-node staggered compaction.
//!
//! Each node derives its roll time **deterministically from its stable identity**
//! (`hash(node_id) % interval`), so replicas stagger across the interval and the
//! schedule survives restarts without persisting anything — avoiding a
//! thundering-herd of simultaneous snapshots. The interval comes from the
//! service-supplied `DiskPersistenceConfig` (config-at-init).

use crate::error::Result;
use crate::redolog::{Record, RedoLog};
use std::future::Future;
use std::time::Duration;

/// Deterministic per-node roll offset within `interval` (FNV-1a of `node_id`).
/// Stable across restarts; well-distributed so replicas don't collide.
pub fn roll_offset(node_id: &str, interval: Duration) -> Duration {
    let secs = interval.as_secs().max(1);
    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
    for b in node_id.as_bytes() {
        h ^= *b as u64;
        h = h.wrapping_mul(0x0000_0100_0000_01b3);
    }
    Duration::from_secs(h % secs)
}

/// Run the periodic roll loop for a redo log. `snapshot` returns the current
/// deduped state to write as the new baseline at each roll. The first roll is
/// delayed by the node's deterministic offset; thereafter it rolls once per
/// `interval`. Roll failures are logged and retried on the next interval.
pub async fn run_roll_scheduler<F, Fut>(
    log: &RedoLog,
    interval: Duration,
    node_id: &str,
    mut snapshot: F,
) -> Result<()>
where
    F: FnMut() -> Fut,
    Fut: Future<Output = Vec<Record>>,
{
    tokio::time::sleep(roll_offset(node_id, interval)).await;
    let mut ticker = tokio::time::interval(interval);
    ticker.tick().await; // first tick fires immediately; consume it
    loop {
        ticker.tick().await;
        // Redirect before the snapshot, so a write during the snapshot is folded in.
        let result = match log.redirect_appends() {
            Ok(()) => {
                let snap = snapshot().await;
                log.fold_and_swap(&snap)
            }
            Err(err) => Err(err),
        };
        if let Err(err) = result {
            log::warn!(
                "diskstore roll failed; retrying on next interval: node_id={} error={}",
                node_id,
                err
            );
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn offset_is_deterministic_and_in_range() {
        let interval = Duration::from_secs(86400);
        let a = roll_offset("mint-0", interval);
        let b = roll_offset("mint-0", interval);
        let c = roll_offset("mint-1", interval);
        assert_eq!(a, b); // stable for the same node
        assert!(a < interval && c < interval); // within the interval
        assert_ne!(a, c); // (very likely) staggered across nodes
    }

    fn rec(key: &str, v: i64) -> Record {
        Record {
            key: key.into(),
            deleted: false,
            metadata: None,
            payload: Some(serde_json::json!({ "v": v })),
        }
    }

    struct Collect(Vec<Record>);
    impl crate::redolog::Inserter for Collect {
        fn insert(&mut self, r: &Record) -> crate::error::Result<()> {
            self.0.push(r.clone());
            Ok(())
        }
    }

    // A write that lands while the roll scheduler is taking its snapshot must
    // survive a local restore. The write comes from the snapshot future, mid-snapshot.
    // Only a snapshot read after the redirect keeps it: before the redirect the
    // write goes to the old active log, which the new baseline leaves out.
    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
    async fn roll_scheduler_keeps_concurrent_append() {
        use std::sync::atomic::{AtomicBool, Ordering};

        let dir = tempfile::tempdir().unwrap();
        let log = RedoLog::open(dir.path(), "/drpepper", "verifying_keys", 2, crate::Codec::Gz).unwrap();
        log.append(&rec("a", 1)).unwrap();

        let injected = AtomicBool::new(false);
        let (log_ref, injected_ref) = (&log, &injected);
        let roll = run_roll_scheduler(&log, Duration::from_secs(1), "node-0", move || async move {
            let snap = crate::redolog::dedup_file(log_ref.active_path()).unwrap();
            if !injected_ref.swap(true, Ordering::SeqCst) {
                log_ref.append(&rec("b", 9)).unwrap();
            }
            snap
        });
        // The scheduler loops forever. Its first roll lands within two intervals;
        // dropping it at a tick leaves that roll complete.
        let _ = tokio::time::timeout(Duration::from_secs(4), roll).await;

        assert!(injected.load(Ordering::SeqCst), "the roll scheduler should have taken a snapshot");
        let mut c = Collect(Vec::new());
        log.restore(&mut c).unwrap();
        assert!(
            c.0.iter().any(|r| r.key == "b"),
            "a write made during the roll snapshot must survive a local restore, got {} record(s)",
            c.0.len()
        );
    }
}
