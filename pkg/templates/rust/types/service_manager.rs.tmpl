    /// and state-store connection pool, and auto-obtains TLS cert.
    pub async fn new() -> Result<Self, Box<dyn std::error::Error>> {
        // Install the ring CryptoProvider as the process-level default for rustls.
        // This must happen before any TLS channels are created.
        if rustls::crypto::ring::default_provider().install_default().is_err() {
            tracing::debug!("CryptoProvider already installed");
        }

        let mut cfg = load_config()?;
        // Defense-in-depth: load_config() already applies config_defaults, but the
        // state authority (kernel) does not traverse the typed-config call sites
        // that re-apply defaults later. Applying defaults here — immediately after
        // load, before ANY field is read — guarantees every annotated default is
        // in effect on every path, including the state authority's.
        config_defaults(&mut cfg);
        let tasks: Arc<std::sync::Mutex<Vec<JoinHandle<()>>>> = Arc::new(std::sync::Mutex::new(Vec::new()));
        let tls_degrade: Arc<std::sync::Mutex<TlsDegradeSeam>> = Arc::new(std::sync::Mutex::new(TlsDegradeSeam { fns: Vec::new(), seen: Vec::new() }));

        // Create the gRPC health service and bind the plaintext probe listener
        // BEFORE any kernel-dependent init. The health service starts NOT_SERVING;
        // it is flipped to SERVING only after bootstrap completes in run(). This
        // ensures k8s startup probes can connect to the health port even while the
        // service is still waiting for kernel, TLS certs, or state-store
        // connectivity — preventing the cold-start deadlock where kernel itself
        // is gated on its own health probe.
        let grpc_health = tonic_health::server::HealthReporter::new();
        grpc_health.set_service_status("", tonic_health::ServingStatus::NotServing).await;
        let health_probe_port = cfg.health_probe_port;
        if health_probe_port > 0 {
            let probe_svc = tonic_health::pb::health_server::HealthServer::new(
                tonic_health::server::HealthService::from_health_reporter(grpc_health.clone()),
            );
            let probe_handle = tokio::spawn(async move {
                let addr: std::net::SocketAddr = match format!("0.0.0.0:{}", health_probe_port).parse() {
                    Ok(a) => a,
                    Err(e) => {
                        tracing::error!(error = %e, "invalid health probe address");
                        return;
                    }
                };
                info!(addr = %addr, "plaintext health probe server listening");
                if let Err(e) = tonic::transport::Server::builder()
                    .add_service(probe_svc)
                    .serve(addr)
                    .await
                {
                    tracing::error!(error = %e, "health probe server error");
                }
            });
            tasks.lock().unwrap().push(probe_handle);
