    /**
     * Check authentication only — token signature/audience, no namespace check.
     * Used by auth_any_user methods that declare no fixed target namespace.
     * Fail-closed if not wired.
     */
    private java.util.Map<String, String> checkAuthenticate() throws ProtoException {
        return checkAuthenticate(null);
    }

    /** Check authentication and enforce a fixed namespace target. */
    private java.util.Map<String, String> checkAuthenticate(String targetNamespace) throws ProtoException {
        Authenticator auth = this.authenticator;
        if (auth == null) {
            throw ProtoException.newErrUnauthorized(null,
                    "authenticator not configured — auth is mandatory and cannot be disabled");
        }
        java.util.Map<String, String> identity = auth.authenticate(targetNamespace);
        return identity == null ? java.util.Collections.emptyMap() : identity;
    }

    /**
     * Converts any Throwable to a gRPC StatusRuntimeException using ProtoException codes.
     */
    private static io.grpc.StatusRuntimeException toGrpcError(Throwable t) {
        if (t instanceof io.grpc.StatusRuntimeException) {
            return (io.grpc.StatusRuntimeException) t;
        }
        if (t instanceof ProtoException) {
            ProtoException pe = (ProtoException) t;
            return io.grpc.Status.fromCodeValue(pe.getCode())
                    .withDescription(pe.getMessage())
                    .withCause(pe)
                    .asRuntimeException();
        }
        return io.grpc.Status.INTERNAL
                .withDescription(t.getMessage())
                .withCause(t)
                .asRuntimeException();
    }

    @FunctionalInterface
    private interface MessageValidator<T> {
        void validate(T value) throws ProtoException;
    }

    /**
     * Transforms one inbound request-stream message. Unlike MessageValidator it
     * RETURNS a message: the (spec.principal)/(spec.namespace) stamp rebinds the
     * request, and protobuf messages are immutable, so the stamped message has
     * to replace the one the client sent.
     */
    private interface MessageScoper<T> {
        T scope(T value) throws ProtoException;
    }

    private static ProtoException responseValidationError(Throwable t) {
        String message = t.getMessage() == null ? "response validation failed" : "response validation failed: " + t.getMessage();
        return new ProtoException(ProtoException.INTERNAL, message, t);
    }

    private static <T> StreamObserver<T> noopRequestObserver() {
        return new StreamObserver<T>() {
            @Override public void onNext(T value) {}
            @Override public void onError(Throwable t) {}
            @Override public void onCompleted() {}
        };
    }

    /**
     * Applies the per-message (spec.principal)/(spec.namespace) stamp-or-refuse
     * to a request stream and hands the STAMPED message on.
     *
     * Per message, not once at stream open: a request stream is not one
     * request, and a later message naming a principal an earlier one did not is
     * exactly the forgery the unary check refuses.
     */
    private static <T> StreamObserver<T> scopingRequestObserver(
            StreamObserver<T> delegate,
            MessageScoper<T> scoper,
            StreamObserver<?> responseObserver) {
        if (scoper == null) {
            return delegate;
        }
        java.util.concurrent.atomic.AtomicBoolean closed = new java.util.concurrent.atomic.AtomicBoolean(false);
        return new StreamObserver<T>() {
            @Override
            public void onNext(T value) {
                if (closed.get()) {
                    return;
                }
                try {
                    delegate.onNext(scoper.scope(value));
                } catch (Throwable t) {
                    if (closed.compareAndSet(false, true)) {
                        responseObserver.onError(toGrpcError(t));
                    }
                }
            }

            @Override
            public void onError(Throwable t) {
                if (closed.compareAndSet(false, true)) {
                    delegate.onError(t);
                }
            }

            @Override
            public void onCompleted() {
                if (!closed.get()) {
                    delegate.onCompleted();
                }
            }
        };
    }

    private static <T> StreamObserver<T> validatingRequestObserver(
            StreamObserver<T> delegate,
            MessageValidator<T> validator,
            StreamObserver<?> responseObserver) {
        if (validator == null) {
            return delegate;
        }
        java.util.concurrent.atomic.AtomicBoolean closed = new java.util.concurrent.atomic.AtomicBoolean(false);
        return new StreamObserver<T>() {
            @Override
            public void onNext(T value) {
                if (closed.get()) {
                    return;
                }
                try {
                    validator.validate(value);
                    delegate.onNext(value);
                } catch (Throwable t) {
                    if (closed.compareAndSet(false, true)) {
                        responseObserver.onError(toGrpcError(t));
                    }
                }
            }

            @Override
            public void onError(Throwable t) {
                if (closed.compareAndSet(false, true)) {
                    delegate.onError(t);
                }
            }

            @Override
            public void onCompleted() {
                if (!closed.get()) {
                    delegate.onCompleted();
                }
            }
        };
    }

    // guardedResponseObserver terminates a stream on a declared refusal, carrying
    // the refusal's own status code through (a (spec.min_group_size) frame is
    // PERMISSION_DENIED, not a validation INTERNAL). Unlike a filtering delegate
    // it does not withhold frames: a stream that went quiet at exactly the
    // threshold would disclose the crossing by its silence.
    private static <T> StreamObserver<T> guardedResponseObserver(
            StreamObserver<T> delegate,
            MessageValidator<T> guard) {
        if (guard == null) {
            return delegate;
        }
        java.util.concurrent.atomic.AtomicBoolean closed = new java.util.concurrent.atomic.AtomicBoolean(false);
        return new StreamObserver<T>() {
            @Override
            public void onNext(T value) {
                if (closed.get()) {
                    return;
                }
                try {
                    guard.validate(value);
                } catch (Throwable t) {
                    if (closed.compareAndSet(false, true)) {
                        delegate.onError(toGrpcError(t));
                    }
                    return;
                }
                delegate.onNext(value);
            }

            @Override
            public void onError(Throwable t) {
                if (closed.compareAndSet(false, true)) {
                    delegate.onError(t);
                }
            }

            @Override
            public void onCompleted() {
                if (!closed.get()) {
                    delegate.onCompleted();
                }
            }
        };
    }

    private static <T> StreamObserver<T> validatingResponseObserver(
            StreamObserver<T> delegate,
            MessageValidator<T> validator) {
        if (validator == null) {
            return delegate;
        }
        java.util.concurrent.atomic.AtomicBoolean closed = new java.util.concurrent.atomic.AtomicBoolean(false);
        return new StreamObserver<T>() {
            @Override
            public void onNext(T value) {
                if (closed.get()) {
                    return;
                }
                try {
                    validator.validate(value);
                    delegate.onNext(value);
                } catch (Throwable t) {
                    if (closed.compareAndSet(false, true)) {
                        delegate.onError(toGrpcError(responseValidationError(t)));
                    }
                }
            }

            @Override
            public void onError(Throwable t) {
                if (closed.compareAndSet(false, true)) {
                    delegate.onError(t);
                }
            }

            @Override
            public void onCompleted() {
                if (!closed.get()) {
                    delegate.onCompleted();
                }
            }
        };
    }

