/// Converts i32 enum values to their string representations in a JSON Value tree for {{.TypeName}}.
/// Reverse of normalize_{{.SnakeName}}_enums — converts integer enum values to API-friendly
/// string names (using json_return_value when set, e.g., 1 → "user" for Role).
pub fn stringify_{{.SnakeName}}_enums(v: &mut serde_json::Value) {
if let Some(obj) = v.as_object_mut() {
{{- range .EnumFields}}
{{- if .IsRepeated}}
{ let key = if obj.contains_key("{{.CamelName}}") { "{{.CamelName}}" } else { "{{.FieldName}}" };
if let Some(arr) = obj.get_mut(key).and_then(|v| v.as_array_mut()) {
for item in arr.iter_mut() {
if let Some(n) = item.as_i64() {
*item = serde_json::Value::String({{.EnumTypeName}}::to_string_value(n as i32));
}
}
} }
{{- else}}
{ let key = if obj.contains_key("{{.CamelName}}") { "{{.CamelName}}" } else { "{{.FieldName}}" };
if let Some(val) = obj.get_mut(key) {
if let Some(n) = val.as_i64() {
*val = serde_json::Value::String({{.EnumTypeName}}::to_string_value(n as i32));
}
} }
{{- end}}
{{- end}}
{{- range .MessageFields}}
{{- if .IsRepeated}}
{ let key = if obj.contains_key("{{.CamelName}}") { "{{.CamelName}}" } else { "{{.FieldName}}" };
if let Some(arr) = obj.get_mut(key).and_then(|v| v.as_array_mut()) {
for item in arr.iter_mut() {
{{- if .CratePath}}
{{.CratePath}}::{{.StringifyFn}}(item);
{{- else}}
{{.StringifyFn}}(item);
{{- end}}
}
} }
{{- else}}
{ let key = if obj.contains_key("{{.CamelName}}") { "{{.CamelName}}" } else { "{{.FieldName}}" };
if let Some(val) = obj.get_mut(key) {
{{- if .CratePath}}
{{.CratePath}}::{{.StringifyFn}}(val);
{{- else}}
{{.StringifyFn}}(val);
{{- end}}
} }
{{- end}}
{{- end}}
}
}
