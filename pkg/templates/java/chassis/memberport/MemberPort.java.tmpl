            var sans = chain.length == 0 ? null : chain[0].getSubjectAlternativeNames();
            if (sans != null) {
                for (var san : sans) {
                    if ((Integer) san.get(0) != 6 || san.get(1) == null) {
                        continue;
                    }
                    Spiffe.ParsedSpiffeId p;
                    try {
                        p = Spiffe.parseSpiffeId(san.get(1).toString());
                    } catch (IllegalArgumentException e) {
                        continue;
                    }
                    if (p.subjectKind != Spiffe.SubjectKind.SERVICE
                            || !trustDomain.equals(p.trustDomain)
                            || !serviceLabel.equals(p.subjectPath)) {
                        continue;
                    }
                    String ns = Spiffe.normalizeNamespace(p.namespace);
                    if (tenantOwned ? own.equals(ns) : Spiffe.isAtOrBelow("/" + Spiffe.SYSTEM_SEGMENT, ns)) {
                        return;
                    }
