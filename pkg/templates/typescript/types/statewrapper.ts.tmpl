                throw unauthenticatedError(`auth token: ${cause instanceof Error ? cause.message : String(cause)}`);
            }
            if (!token) {
                throw unauthenticatedError('auth token is empty');
            }
            metadata.add('authorization', `Bearer ${token}`);
        }
        return metadata;
    }

    private scheduleWatchRetry(
        watchName: string,
        received: boolean,
        attempt: number,
        run: (attempt: number) => Promise<void>,
        err?: unknown,
    ): void {
        if (this._closed) return;
        const baseDelay = Math.min(2 ** Math.min(attempt, 5) * 1000, 30000);
        const jitter = Math.floor(Math.random() * Math.min(baseDelay * 0.2, 1000));
        const delay = baseDelay + jitter;
        if (err) {
            console.warn(`${watchName} watch failed; reconnecting in ${delay}ms:`, err);
        } else {
            console.warn(`${watchName} watch completed; reconnecting in ${delay}ms`);
        }
        this.recordWatchRetrying(watchName, received, attempt, err ? String(err) : 'stream completed', err);
        const timer = setTimeout(() => {
            this._watchTimers.delete(timer);
            void run(attempt);
        }, delay);
        this._watchTimers.add(timer);
    }

