[package]
name = "spiffe"
version = "0.1.0"
edition = "2021"
description = "Canonical SPIFFE identity model: construction, parsing, normalization, and comparison of SPIFFE IDs"

[dependencies]
sha2 = "0.11"
data-encoding = "2"
unicode-normalization = "0.1"
regex = "1"

[dev-dependencies]
serde_json = "1"
