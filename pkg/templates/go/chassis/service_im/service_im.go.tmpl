// AWS SigV4 signing (no SDK)
// ---------------------------------------------------------------------------

// awsIMDSCredentials fetches IAM role credentials from the EC2 Instance
// Metadata Service (IMDSv2). Returns access key, secret key, and session token.
func awsIMDSCredentials(ctx context.Context) (accessKey, secretKey, sessionToken string, err error) {
	httpClient := &http.Client{Timeout: imdsTimeout}

	// Get IMDSv2 session token
	tokenReq, err := http.NewRequestWithContext(ctx, "PUT",
		"http://169.254.169.254/latest/api/token", nil)
	if err != nil {
		return "", "", "", fmt.Errorf("creating IMDS token request: %w", err)
	}
	tokenReq.Header.Set("X-aws-ec2-metadata-token-ttl-seconds", "21600")
	tokenResp, err := httpClient.Do(tokenReq)
	if err != nil {
		return "", "", "", fmt.Errorf("fetching IMDS token: %w", err)
	}
	tokenBody, _ := io.ReadAll(tokenResp.Body)
	tokenResp.Body.Close()
	imdsToken := string(tokenBody)

	// Get IAM role name
	roleReq, err := http.NewRequestWithContext(ctx, "GET",
		"http://169.254.169.254/latest/meta-data/iam/security-credentials/", nil)
	if err != nil {
		return "", "", "", fmt.Errorf("creating role request: %w", err)
	}
	roleReq.Header.Set("X-aws-ec2-metadata-token", imdsToken)
	roleResp, err := httpClient.Do(roleReq)
	if err != nil {
		return "", "", "", fmt.Errorf("fetching IAM role: %w", err)
	}
	roleBody, _ := io.ReadAll(roleResp.Body)
	roleResp.Body.Close()
	roleName := strings.TrimSpace(string(roleBody))
	if roleName == "" {
		return "", "", "", fmt.Errorf("no IAM role attached to instance")
	}

	// Get credentials for the role
	credReq, err := http.NewRequestWithContext(ctx, "GET",
		"http://169.254.169.254/latest/meta-data/iam/security-credentials/"+roleName, nil)
	if err != nil {
		return "", "", "", fmt.Errorf("creating credentials request: %w", err)
	}
	credReq.Header.Set("X-aws-ec2-metadata-token", imdsToken)
	credResp, err := httpClient.Do(credReq)
	if err != nil {
		return "", "", "", fmt.Errorf("fetching credentials: %w", err)
	}
	credBody, _ := io.ReadAll(credResp.Body)
	credResp.Body.Close()

	// Parse JSON credentials
	credStr := string(credBody)
	accessKey = extractJSONString(credStr, "AccessKeyId")
	secretKey = extractJSONString(credStr, "SecretAccessKey")
	sessionToken = extractJSONString(credStr, "Token")
	if accessKey == "" || secretKey == "" {
		return "", "", "", fmt.Errorf("failed to parse IMDS credentials")
	}
	return accessKey, secretKey, sessionToken, nil
}

// awsEKSCredentials reads credentials from EKS IRSA (projected service account token)
// and fetches temporary credentials via STS AssumeRoleWithWebIdentity.
func awsEKSCredentials(ctx context.Context) (accessKey, secretKey, sessionToken string, err error) {
	tokenFile := os.Getenv("AWS_WEB_IDENTITY_TOKEN_FILE")
	roleArn := os.Getenv("AWS_ROLE_ARN")
	if tokenFile == "" || roleArn == "" {
		return "", "", "", fmt.Errorf("AWS_WEB_IDENTITY_TOKEN_FILE or AWS_ROLE_ARN not set")
	}
	tokenBytes, err := os.ReadFile(tokenFile)
	if err != nil {
		return "", "", "", fmt.Errorf("reading web identity token: %w", err)
	}
	webToken := strings.TrimSpace(string(tokenBytes))

	region := os.Getenv("AWS_REGION")
	if region == "" {
		region = os.Getenv("AWS_DEFAULT_REGION")
	}
	if region == "" {
		region = "us-east-1"
	}

	// Call STS AssumeRoleWithWebIdentity
	stsURL := fmt.Sprintf("https://sts.%s.amazonaws.com/", region)
	body := url.Values{
		"Action":           {"AssumeRoleWithWebIdentity"},
		"Version":          {"2011-06-15"},
		"RoleArn":          {roleArn},
		"RoleSessionName":  {"servicemanager"},
		"WebIdentityToken": {webToken},
	}.Encode()

	httpClient := &http.Client{Timeout: 10 * time.Second}
	req, err := http.NewRequestWithContext(ctx, "POST", stsURL, strings.NewReader(body))
	if err != nil {
		return "", "", "", fmt.Errorf("creating STS request: %w", err)
	}
	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	resp, err := httpClient.Do(req)
	if err != nil {
		return "", "", "", fmt.Errorf("STS AssumeRoleWithWebIdentity: %w", err)
	}
	respBody, _ := io.ReadAll(resp.Body)
	resp.Body.Close()
	respStr := string(respBody)

	accessKey = extractXMLValue(respStr, "AccessKeyId")
	secretKey = extractXMLValue(respStr, "SecretAccessKey")
	sessionToken = extractXMLValue(respStr, "SessionToken")
	if accessKey == "" || secretKey == "" {
		return "", "", "", fmt.Errorf("failed to parse STS AssumeRoleWithWebIdentity response")
	}
	return accessKey, secretKey, sessionToken, nil
}

// awsSignV4 signs an HTTP request using AWS Signature Version 4.
func awsSignV4(method, urlStr, body, accessKey, secretKey, sessionToken, region, service string, now time.Time) (map[string]string, error) {
	u, err := url.Parse(urlStr)
	if err != nil {
		return nil, fmt.Errorf("parsing URL: %w", err)
	}

	datestamp := now.UTC().Format("20060102")
	amzDate := now.UTC().Format("20060102T150405Z")
	payloadHash := sha256Hex(body)

	headers := map[string]string{
		"host":                 u.Host,
		"x-amz-date":          amzDate,
		"x-amz-content-sha256": payloadHash,
		"content-type":        "application/x-www-form-urlencoded; charset=utf-8",
	}
	if sessionToken != "" {
		headers["x-amz-security-token"] = sessionToken
	}

	var signedHeaderNames []string
	for k := range headers {
		signedHeaderNames = append(signedHeaderNames, k)
	}
	sort.Strings(signedHeaderNames)
	signedHeaders := strings.Join(signedHeaderNames, ";")

	var canonicalHeaders strings.Builder
	for _, k := range signedHeaderNames {
		canonicalHeaders.WriteString(k)
		canonicalHeaders.WriteString(":")
		canonicalHeaders.WriteString(strings.TrimSpace(headers[k]))
		canonicalHeaders.WriteString("\n")
	}

	canonicalRequest := strings.Join([]string{
		method,
		u.Path,
		u.RawQuery,
		canonicalHeaders.String(),
		signedHeaders,
		payloadHash,
	}, "\n")

	credentialScope := strings.Join([]string{datestamp, region, service, "aws4_request"}, "/")

	stringToSign := strings.Join([]string{
		"AWS4-HMAC-SHA256",
		amzDate,
		credentialScope,
		sha256Hex(canonicalRequest),
	}, "\n")

	signingKey := hmacSHA256(
		hmacSHA256(
			hmacSHA256(
				hmacSHA256([]byte("AWS4"+secretKey), []byte(datestamp)),
				[]byte(region),
			),
			[]byte(service),
		),
		[]byte("aws4_request"),
	)

	signature := hex.EncodeToString(hmacSHA256(signingKey, []byte(stringToSign)))

	authHeader := fmt.Sprintf("AWS4-HMAC-SHA256 Credential=%s/%s, SignedHeaders=%s, Signature=%s",
		accessKey, credentialScope, signedHeaders, signature)

	result := make(map[string]string)
	for k, v := range headers {
		result[k] = v
	}
	result["authorization"] = authHeader

	return result, nil
}

// sha256Hex returns the lowercase hex SHA256 digest of s.
// parseUnixSeconds parses a string as a Unix timestamp in seconds.
// Accepts integer strings and scientific notation (e.g. "1.7424036E9").
// Rejects actual fractional values (e.g. "1742403600.5") — a float where an
// integer is expected indicates a bug in the producer.
// Returns an error if the string is not a valid whole number.
func parseUnixSeconds(s string) (int64, error) {
	if n, err := strconv.ParseInt(s, 10, 64); err == nil {
		return n, nil
	}
	// Scientific notation or ".0" suffix — accept only if it represents a whole number.
	if f, err := strconv.ParseFloat(s, 64); err == nil {
		if math.IsNaN(f) || math.IsInf(f, 0) {
			return 0, fmt.Errorf("cannot use %s as unix timestamp", s)
		}
		if f != math.Trunc(f) {
			return 0, fmt.Errorf("fractional timestamp %q not allowed — expected integer", s)
		}
		return int64(f), nil
	}
	return 0, fmt.Errorf("cannot parse %q as unix timestamp", s)
}

func sha256Hex(s string) string {
	h := sha256.Sum256([]byte(s))
	return hex.EncodeToString(h[:])
}

// hmacSHA256 returns the HMAC-SHA256 of data using key.
func hmacSHA256(key, data []byte) []byte {
	h := hmac.New(sha256.New, key)
	h.Write(data)
	return h.Sum(nil)
}

// extractJSONString extracts a string value from a simple JSON object by key.
func extractJSONString(json, key string) string {
	needle := `"` + key + `"`
	idx := strings.Index(json, needle)
	if idx < 0 {
		return ""
	}
	rest := json[idx+len(needle):]
	rest = strings.TrimLeft(rest, " \t\n\r:")
	if len(rest) == 0 || rest[0] != '"' {
		return ""
	}
	rest = rest[1:]
	end := strings.IndexByte(rest, '"')
	if end < 0 {
		return ""
	}
	return rest[:end]
}

// extractXMLValue extracts a value between XML tags <key>value</key>.
func extractXMLValue(xml, key string) string {
	start := "<" + key + ">"
	end := "</" + key + ">"
	idx := strings.Index(xml, start)
	if idx < 0 {
		return ""
	}
	rest := xml[idx+len(start):]
	endIdx := strings.Index(rest, end)
	if endIdx < 0 {
		return ""
	}
	return rest[:endIdx]
}

// ---------------------------------------------------------------------------
// Cloud proof builders
// ---------------------------------------------------------------------------

// buildAWSCloudProof creates a CloudIdentityProof with a presigned STS
// GetCallerIdentity request signed using AWS SigV4.
func buildAWSCloudProof(ctx context.Context) (*cloudidentity_pb.CloudIdentityProof, error) {
	var accessKey, secretKey, sessionToken string
	var err error
	if os.Getenv("AWS_WEB_IDENTITY_TOKEN_FILE") != "" {
		accessKey, secretKey, sessionToken, err = awsEKSCredentials(ctx)
	} else {
		accessKey, secretKey, sessionToken, err = awsIMDSCredentials(ctx)
	}
	if err != nil {
		return nil, fmt.Errorf("obtaining AWS credentials: %w", err)
	}

	region := os.Getenv("AWS_REGION")
	if region == "" {
		region = os.Getenv("AWS_DEFAULT_REGION")
	}
	if region == "" {
		region = "us-east-1"
	}

	stsURL := fmt.Sprintf("https://sts.%s.amazonaws.com/", region)
	body := "Action=GetCallerIdentity&Version=2011-06-15"
	now := time.Now()

	signedHeaders, err := awsSignV4("POST", stsURL, body, accessKey, secretKey, sessionToken, region, "sts", now)
	if err != nil {
		return nil, fmt.Errorf("signing STS request: %w", err)
	}

	return &cloudidentity_pb.CloudIdentityProof{
		Vendor: cloudvendor_pb.CloudVendor_CLOUD_VENDOR_AWS,
		PresignedRequest: &cloudidentity_pb.PresignedHttpRequest{
			Method:  "POST",
			Url:     stsURL,
			Headers: signedHeaders,
			Body:    body,
		},
	}, nil
}

// buildGCPCloudProof fetches an identity token from the GCP metadata server.
func buildGCPCloudProof(ctx context.Context, audience string) (*cloudidentity_pb.CloudIdentityProof, error) {
	metadataURL := fmt.Sprintf(
		"http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/identity?audience=%s&format=full",
		url.QueryEscape(audience))

	req, err := http.NewRequestWithContext(ctx, "GET", metadataURL, nil)
	if err != nil {
		return nil, fmt.Errorf("creating GCP metadata request: %w", err)
	}
	req.Header.Set("Metadata-Flavor", "Google")

	httpClient := &http.Client{Timeout: 5 * time.Second}
	resp, err := httpClient.Do(req)
	if err != nil {
		return nil, fmt.Errorf("fetching GCP identity token: %w", err)
	}
	defer resp.Body.Close()
	body, _ := io.ReadAll(resp.Body)
	if resp.StatusCode != http.StatusOK {
		return nil, fmt.Errorf("GCP metadata returned %d: %s", resp.StatusCode, string(body))
	}

	return &cloudidentity_pb.CloudIdentityProof{
		Vendor:        cloudvendor_pb.CloudVendor_CLOUD_VENDOR_GCP,
		IdentityToken: strings.TrimSpace(string(body)),
	}, nil
}

// buildAzureCloudProof fetches a managed identity token from the Azure IMDS.
func buildAzureCloudProof(ctx context.Context, resource string) (*cloudidentity_pb.CloudIdentityProof, error) {
	metadataURL := fmt.Sprintf(
		"http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=%s",
		url.QueryEscape(resource))

	req, err := http.NewRequestWithContext(ctx, "GET", metadataURL, nil)
	if err != nil {
		return nil, fmt.Errorf("creating Azure IMDS request: %w", err)
	}
	req.Header.Set("Metadata", "true")

	httpClient := &http.Client{Timeout: 5 * time.Second}
	resp, err := httpClient.Do(req)
	if err != nil {
		return nil, fmt.Errorf("fetching Azure managed identity token: %w", err)
	}
	defer resp.Body.Close()
	body, _ := io.ReadAll(resp.Body)
	if resp.StatusCode != http.StatusOK {
		return nil, fmt.Errorf("Azure IMDS returned %d: %s", resp.StatusCode, string(body))
	}

	token := extractJSONString(string(body), "access_token")
	if token == "" {
		return nil, fmt.Errorf("Azure IMDS response missing access_token")
	}

	return &cloudidentity_pb.CloudIdentityProof{
		Vendor:        cloudvendor_pb.CloudVendor_CLOUD_VENDOR_AZURE,
		IdentityToken: token,
	}, nil
}

// ---------------------------------------------------------------------------
// cloudTokenMinter — cloud-native token exchange
// ---------------------------------------------------------------------------

// cloudTokenMinter handles cloud-native token exchange:
//  1. Builds a CloudIdentityProof (AWS presigned STS / GCP identity token / Azure managed identity)
//  2. Sends it to {{.MintServiceName}}.MintServiceToken to get a refresh token
//  3. Exchanges the refresh token for an access token with the correct audience
//  4. Caches and refreshes using half-life randomized renewal
type cloudTokenMinter struct {
	vendor         cloudvendor_pb.CloudVendor
	serviceId      string // from config's instance_id
	mu             sync.Mutex
	refreshMu      sync.Mutex
	tokens         map[string]*tokenEntry // per-audience service token cache
	refreshLocks   map[string]*sync.Mutex // per-audience service-token refresh locks
	genericAccess  string                 // cached generic access token for the default audience
	genericExp     time.Time              // expiry of generic access token
	refreshTok     string                 // cached refresh token base64
	refreshExp     time.Time              // expiry of refresh token
	refreshIat     time.Time              // issued-at of refresh token
	instanceId     string                 // server-assigned instance_id
	exchClient     cluster_svc_pb.{{.MintServiceName}}Client
	cancelRenew    context.CancelFunc
}

// newCloudTokenMinter creates a cloudTokenMinter for the detected vendor.
func newCloudTokenMinter(vendor cloudvendor_pb.CloudVendor, serviceId string) *cloudTokenMinter {
	return &cloudTokenMinter{
		vendor:       vendor,
		serviceId:    serviceId,
		tokens:       make(map[string]*tokenEntry),
		refreshLocks: make(map[string]*sync.Mutex),
	}
}

// setConn sets the gRPC connection for token exchange.
func (cm *cloudTokenMinter) setConn(conn *grpc.ClientConn) {
	cm.mu.Lock()
	defer cm.mu.Unlock()
	cm.exchClient = cluster_svc_pb.New{{.MintServiceName}}Client(conn)
}

func (cm *cloudTokenMinter) exchangeClient() cluster_svc_pb.{{.MintServiceName}}Client {
	cm.mu.Lock()
	defer cm.mu.Unlock()
	return cm.exchClient
}

// getToken returns a valid bearer token for the default audience.
func (cm *cloudTokenMinter) getToken() (string, error) {
	return cm.getTokenFor(defaultAudience)
}

// getTokenFor returns a valid bearer token for the given audience.
func (cm *cloudTokenMinter) getTokenFor(audience string) (string, error) {
	if token, ok := cm.cachedToken(audience); ok {
		return token, nil
	}

	lock := cm.refreshLockFor(audience)
	lock.Lock()
	defer lock.Unlock()

	// Another goroutine may have refreshed this audience while we waited.
	if token, ok := cm.cachedToken(audience); ok {
		return token, nil
	}

	if accessToken, ok := cm.freshGenericAccess(); ok {
		tok, err := cm.doServiceExchange(audience, accessToken)
		if err == nil {
			return tok, nil
		}
		zap.L().Warn("Cloud auth: access→service exchange failed", zap.Error(err))
	}

	cm.refreshMu.Lock()
	defer cm.refreshMu.Unlock()

	if token, ok := cm.cachedToken(audience); ok {
		return token, nil
	}

	if accessToken, ok := cm.freshGenericAccess(); ok {
		tok, err := cm.doServiceExchange(audience, accessToken)
		if err == nil {
			return tok, nil
		}
		zap.L().Warn("Cloud auth: access→service exchange failed", zap.Error(err))
	}

	if refreshToken, ok := cm.validRefreshToken(); ok {
		if err := cm.doGenericExchange(refreshToken); err == nil {
			if accessToken, ok := cm.freshGenericAccess(); ok {
				tok, err := cm.doServiceExchange(audience, accessToken)
				if err == nil {
					return tok, nil
				}
			}
		}
		zap.L().Warn("Cloud auth: refresh→access→service exchange failed, re-proving")
	}

	if err := cm.doCloudExchange(); err != nil {
		return "", fmt.Errorf("cloud token exchange: %w", err)
	}
	accessToken, ok := cm.freshGenericAccess()
	if !ok {
		return "", fmt.Errorf("cloud token exchange did not return a usable access token")
	}
	return cm.doServiceExchange(audience, accessToken)
}

func (cm *cloudTokenMinter) cachedToken(audience string) (string, bool) {
	cm.mu.Lock()
	defer cm.mu.Unlock()
	if entry, ok := cm.tokens[audience]; ok {
		if entry.token != "" && time.Now().Add(tokenRefreshBuffer).Before(entry.exp) {
			return entry.token, true
		}
	}
	return "", false
}

func (cm *cloudTokenMinter) refreshLockFor(audience string) *sync.Mutex {
	cm.mu.Lock()
	defer cm.mu.Unlock()
	lock := cm.refreshLocks[audience]
	if lock == nil {
		lock = &sync.Mutex{}
		cm.refreshLocks[audience] = lock
	}
	return lock
}

func (cm *cloudTokenMinter) freshGenericAccess() (string, bool) {
	cm.mu.Lock()
	defer cm.mu.Unlock()
	if cm.genericAccess != "" && time.Now().Add(tokenRefreshBuffer).Before(cm.genericExp) {
		return cm.genericAccess, true
	}
	return "", false
}

func (cm *cloudTokenMinter) validRefreshToken() (string, bool) {
	cm.mu.Lock()
	defer cm.mu.Unlock()
	if cm.refreshTok != "" && time.Now().Before(cm.refreshExp) {
		return cm.refreshTok, true
	}
	return "", false
}

// invalidate clears all cached tokens, forcing re-exchange.
func (cm *cloudTokenMinter) invalidate() {
	cm.mu.Lock()
	defer cm.mu.Unlock()
	cm.tokens = make(map[string]*tokenEntry)
	cm.genericAccess = ""
	cm.genericExp = time.Time{}
	cm.refreshTok = ""
	cm.refreshExp = time.Time{}
}

// doCloudExchange builds a cloud proof and exchanges it for refresh + access tokens.
func (cm *cloudTokenMinter) doCloudExchange() error {
	proof, err := cm.buildProof()
	if err != nil {
		return fmt.Errorf("building cloud proof: %w", err)
	}

	exchClient := cm.exchangeClient()
	if exchClient == nil {
		return fmt.Errorf("token exchange client not initialized")
	}

	req := &common_pb.MintServiceTokenRequest{
		CloudProof:    proof,
		TokenPurpose: token_pb.TokenPurpose_TOKEN_PURPOSE_REFRESH,
	}
	if refreshToken, ok := cm.validRefreshToken(); ok {
		req.ContinuityToken = refreshToken
	}

	exchCtx, cancel := context.WithTimeout(context.Background(), exchangeTimeout)
	defer cancel()
	resp, err := exchClient.MintServiceToken(exchCtx, req)
	if err != nil {
		return fmt.Errorf("cloud proof exchange: %w", err)
	}

	var (
		nextRefreshTok     string
		nextRefreshExp     time.Time
		nextRefreshIat     time.Time
		nextInstanceId     string
		nextGenericAccess  string
		nextGenericExp     time.Time
	)

	// Extract refresh token.
	if rt := resp.GetRefreshToken(); rt != nil {
		nextRefreshTok = rt.GetBase64()
		nextRefreshIat = time.Now()
		if payload := rt.GetPayload(); payload != nil {
			if expStr, ok := payload["exp"]; ok {
				if exp, err := parseUnixSeconds(expStr); err == nil && exp > 0 {
					nextRefreshExp = time.Unix(exp, 0)
				}
			}
			if idStr, ok := payload["instance_id"]; ok {
				nextInstanceId = idStr
			}
		}
		if nextRefreshExp.IsZero() || nextRefreshExp.Before(time.Now()) {
			nextRefreshExp = time.Now().Add(24 * time.Hour) // fallback
		}
	}

	// Extract generic access token.
	if at := resp.GetAccessToken(); at != nil {
		nextGenericAccess = at.GetBase64()
		if payload := at.GetPayload(); payload != nil {
			if expStr, ok := payload["exp"]; ok {
				if exp, err := parseUnixSeconds(expStr); err == nil && exp > 0 {
					nextGenericExp = time.Unix(exp, 0)
				}
			}
		}
		if nextGenericExp.IsZero() || nextGenericExp.Before(time.Now()) {
			nextGenericExp = time.Now().Add(time.Hour) // fallback
		}
	}

	cm.mu.Lock()
	if nextRefreshTok != "" {
		cm.refreshTok = nextRefreshTok
		cm.refreshExp = nextRefreshExp
		cm.refreshIat = nextRefreshIat
	}
	if nextInstanceId != "" {
		cm.instanceId = nextInstanceId
	}
	if nextGenericAccess != "" {
		cm.genericAccess = nextGenericAccess
		cm.genericExp = nextGenericExp
	}
	cm.mu.Unlock()

	if !nextRefreshIat.IsZero() {
		cm.scheduleRenewal(nextRefreshIat, nextRefreshExp)
	}

	return nil
}

// doGenericExchange exchanges the cached refresh token for a generic access token (no aud).
func (cm *cloudTokenMinter) doGenericExchange(refreshToken string) error {
	exchClient := cm.exchangeClient()
	if exchClient == nil {
		return fmt.Errorf("token exchange client not initialized")
	}

	exchCtx, cancel := context.WithTimeout(context.Background(), exchangeTimeout)
	defer cancel()
	resp, err := exchClient.MintServiceToken(exchCtx, &common_pb.MintServiceTokenRequest{
		InputToken:    refreshToken,
		TokenPurpose: token_pb.TokenPurpose_TOKEN_PURPOSE_ACCESS,
	})
	if err != nil {
		return fmt.Errorf("refresh→access exchange: %w", err)
	}

	var nextGenericAccess string
	var nextGenericExp time.Time
	if at := resp.GetAccessToken(); at != nil {
		nextGenericAccess = at.GetBase64()
		if payload := at.GetPayload(); payload != nil {
			if expStr, ok := payload["exp"]; ok {
				if exp, err := parseUnixSeconds(expStr); err == nil && exp > 0 {
					nextGenericExp = time.Unix(exp, 0)
				}
			}
		}
		if nextGenericExp.IsZero() || nextGenericExp.Before(time.Now()) {
			nextGenericExp = time.Now().Add(time.Hour) // fallback
		}
	}
	if nextGenericAccess != "" {
		cm.mu.Lock()
		cm.genericAccess = nextGenericAccess
		cm.genericExp = nextGenericExp
		cm.mu.Unlock()
	}

	return nil
}

// doServiceExchange exchanges the cached generic access token for an audience-specific token.
func (cm *cloudTokenMinter) doServiceExchange(audience, accessToken string) (string, error) {
	exchClient := cm.exchangeClient()
	if exchClient == nil {
		return "", fmt.Errorf("token exchange client not initialized")
	}

	exchCtx, cancel := context.WithTimeout(context.Background(), exchangeTimeout)
	defer cancel()
	resp, err := exchClient.MintServiceToken(exchCtx, &common_pb.MintServiceTokenRequest{
		InputToken:    accessToken,
		Aud:           audience,
		TokenPurpose: token_pb.TokenPurpose_TOKEN_PURPOSE_SERVICE,
	})
	if err != nil {
		return "", fmt.Errorf("access→%s exchange: %w", audience, err)
	}

	entry := &tokenEntry{}
	if svcToken := resp.GetAccessToken(); svcToken != nil {
		entry.token = svcToken.GetBase64()
		if payload := svcToken.GetPayload(); payload != nil {
			if expStr, ok := payload["exp"]; ok {
				if exp, err := parseUnixSeconds(expStr); err == nil && exp > 0 {
					entry.exp = time.Unix(exp, 0)
				}
			}
		}
	}
	if entry.exp.IsZero() || entry.exp.Before(time.Now()) {
		entry.exp = time.Now().Add(time.Hour) // fallback
	}
	cm.mu.Lock()
	defer cm.mu.Unlock()
	evictTokenCache(cm.tokens)
	cm.tokens[audience] = entry

	return entry.token, nil
}

// buildProof constructs a CloudIdentityProof appropriate for the vendor.
func (cm *cloudTokenMinter) buildProof() (*cloudidentity_pb.CloudIdentityProof, error) {
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	switch cm.vendor {
	case cloudvendor_pb.CloudVendor_CLOUD_VENDOR_AWS:
		return buildAWSCloudProof(ctx)
	case cloudvendor_pb.CloudVendor_CLOUD_VENDOR_GCP:
		return buildGCPCloudProof(ctx, defaultAudience)
	case cloudvendor_pb.CloudVendor_CLOUD_VENDOR_AZURE:
		return buildAzureCloudProof(ctx, defaultAudience)
	default:
		return nil, fmt.Errorf("unsupported cloud vendor: %s", cm.vendor.String())
	}
}

// scheduleRenewal starts a background goroutine that renews the refresh token
// at a randomized time after its half-life.
func (cm *cloudTokenMinter) scheduleRenewal(refreshIat, refreshExp time.Time) {
	cm.mu.Lock()
	if cm.cancelRenew != nil {
		cm.cancelRenew()
	}

	ctx, cancel := context.WithCancel(context.Background())
	cm.cancelRenew = cancel
	cm.mu.Unlock()

	halfLife := refreshExp.Sub(refreshIat) / 2
	if halfLife <= 0 {
		halfLife = 12 * time.Hour
	}
	jitter := randomDuration(halfLife)
	renewAt := refreshIat.Add(halfLife + jitter)

	go func() {
		timer := time.NewTimer(time.Until(renewAt))
		defer timer.Stop()
		select {
		case <-ctx.Done():
			return
		case <-timer.C:
			cm.refreshMu.Lock()
			defer cm.refreshMu.Unlock()
			if err := cm.doCloudExchange(); err != nil {
				zap.L().Warn("Cloud auth: half-life renewal failed", zap.Error(err))
			} else {
				zap.L().Info("Cloud auth: refresh token renewed at half-life")
			}
		}
	}()
}

// randomDuration returns a random duration in [0, max).
func randomDuration(max time.Duration) time.Duration {
	if max <= 0 {
		return 0
	}
	n, err := rand.Int(rand.Reader, big.NewInt(int64(max)))
	if err != nil {
		return max / 2
	}
	return time.Duration(n.Int64())
}

// -----------------------------------------------------------------------------
// Credential rejection recovery
// -----------------------------------------------------------------------------
//
// The token cache hands out a token until its expiry. That is correct when a
// token dies of old age and WRONG when it is invalidated early — which is what
// a restart of the token authority does. The cached token is then not expired
// but no longer accepted, so every call fails Unauthenticated and the service
// keeps presenting the same dead credential.
//
// RefreshToken() has always existed and cleared the cache; nothing called it.
// The rust chassis had the identical gap, and there it cost four services a
// fifteen-minute outage that only ended when each pod was deleted by hand.

var (
	authRecoveryMu   sync.Mutex
	authInvalidator  func()
	consecutiveRejects atomic.Int64
)

// degradedAfter is the number of rejections in a row before the service reports
// itself unhealthy.
//
// Not 1: a single rejection is the NORMAL event when the authority restarts —
// the next call re-mints and succeeds — and flapping readiness for that is
// worse than the problem. This threshold means "re-minting is not helping".
const degradedAfter = 3

// RegisterCredentialInvalidator wires the process's token-cache invalidator.
// Called by the IdentityManager that owns the cache.
func RegisterCredentialInvalidator(f func()) {
	authRecoveryMu.Lock()
	defer authRecoveryMu.Unlock()
	authInvalidator = f
}

// IsCredentialRejection reports whether an error means our credential was
// REJECTED, as opposed to the peer being unreachable or the call being refused
// on authorization grounds.
//
// Deliberately excludes PermissionDenied: that means the credential was
// understood and refused, so re-minting the same identity would loop forever.
func IsCredentialRejection(err error) bool {
	if err == nil {
		return false
	}
	if status.Code(err) == codes.Unauthenticated {
		return true
	}
	msg := strings.ToLower(err.Error())
	return strings.Contains(msg, "unauthenticated") ||
		strings.Contains(msg, "does not have valid authentication credentials") ||
		strings.Contains(msg, "token validation failed")
}

// NoteCredentialRejection drops the cached credentials so the next call
// re-mints. Idempotent, and safe to call on every failed attempt.
func NoteCredentialRejection() {
	consecutiveRejects.Add(1)
	authRecoveryMu.Lock()
	f := authInvalidator
	authRecoveryMu.Unlock()
	if f != nil {
		zap.L().Warn("credential was rejected — dropping the cached token so the next attempt re-mints")
		f()
	}
}

// NoteCredentialAccepted clears the degraded state after an accepted call.
func NoteCredentialAccepted() {
	consecutiveRejects.Store(0)
}

// NoteIfCredentialRejection invalidates when the error looks like a rejection.
// Returns true when it did.
func NoteIfCredentialRejection(err error) bool {
	if IsCredentialRejection(err) {
		NoteCredentialRejection()
		return true
	}
	return false
}

// CredentialsDegraded reports whether repeated re-mints have failed to produce
// an accepted credential. Wired to the health floor so readiness stops
// reporting Ready for a service that cannot authenticate at all.
func CredentialsDegraded() bool {
	return consecutiveRejects.Load() >= degradedAfter
}
