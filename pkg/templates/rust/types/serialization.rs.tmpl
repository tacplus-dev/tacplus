/// Converts {{.TypeName}} to JSON bytes.
/// Uses serde_json for serialization.
pub fn {{.SnakeName}}_to_json(msg: &{{.TypeName}}) -> Result<Vec<u8>, String> {
serde_json::to_vec(msg)
.map_err(|e| format!("Failed to serialize to JSON: {}", e))
}
/// Converts {{.TypeName}} to pretty-printed JSON bytes.
pub fn {{.SnakeName}}_to_json_pretty(msg: &{{.TypeName}}) -> Result<Vec<u8>, String> {
serde_json::to_vec_pretty(msg)
.map_err(|e| format!("Failed to serialize to JSON: {}", e))
}
/// Converts {{.TypeName}} to JSON bytes with string enum values (for REST APIs).
/// Uses stringify_*_enums to convert i32 enum fields to their API-friendly string representations.
pub fn {{.SnakeName}}_to_api_json(msg: &{{.TypeName}}) -> Result<Vec<u8>, String> {
{{- if .NeedsNormalization}}
let json_bytes = {{.SnakeName}}_to_json(msg)?;
let mut v: serde_json::Value = serde_json::from_slice(&json_bytes)
.map_err(|e| format!("Failed to parse JSON for stringify: {}", e))?;
stringify_{{.SnakeName}}_enums(&mut v);
serde_json::to_vec(&v)
.map_err(|e| format!("Failed to serialize API JSON: {}", e))
{{- else}}
{{.SnakeName}}_to_json(msg)
{{- end}}
}
/// Converts {{.TypeName}} to pretty-printed JSON bytes with string enum values (for REST APIs).
pub fn {{.SnakeName}}_to_api_json_pretty(msg: &{{.TypeName}}) -> Result<Vec<u8>, String> {
