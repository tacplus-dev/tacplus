}

// NewConn wraps cc; tokens is the caller's token source, the one the
// generated client attaches at open, asked again for every rotation.
func NewConn(cc grpc.ClientConnInterface, tokens func() (string, error)) *Conn {
	return &Conn{cc: cc, tokens: tokens}
}

// Invoke implements grpc.ClientConnInterface.
func (c *Conn) Invoke(ctx context.Context, method string, args, reply any, opts ...grpc.CallOption) error {
	return c.cc.Invoke(ctx, method, args, reply, opts...)
}

// NewStream implements grpc.ClientConnInterface: it opens a logical stream on
// method's rotating sibling, or the plain method when the server has no
// sibling (UNIMPLEMENTED).
func (c *Conn) NewStream(ctx context.Context, desc *grpc.StreamDesc, method string, opts ...grpc.CallOption) (grpc.ClientStream, error) {
	rotating, ok := RotatingMethod(method)
	token := ""
	if md, has := metadata.FromOutgoingContext(ctx); has {
		if v := md.Get("authorization"); len(v) > 0 {
			token = bearer(v[0])
		}
	}
	if !ok || token == "" || c.tokens == nil {
		return c.cc.NewStream(ctx, desc, method, opts...)
	}
	pinned := c.cc
	if p, isPinner := c.cc.(Pinner); isPinner {
		var err error
		if pinned, err = p.Pin(ctx); err != nil {
			return nil, err
		}
	}
	s := newClientSession(ctx, pinned, desc, rotating, opts, c.tokens)
	first, err := s.openLeg(token, "")
	if status.Code(err) == codes.Unauthenticated {
		if fresh, terr := c.tokens(); terr == nil && fresh != "" {
			first, err = s.openLeg(fresh, "")
		}
	}
	if err != nil {
		s.cancel()
		if status.Code(err) == codes.Unimplemented {
			// A server without the sibling: the plain method, on the same
			// connection, where #260's close at exp applies.
			return pinned.NewStream(ctx, desc, method, opts...)
		}
		return nil, err
	}
	s.start(first)
	return s, nil
}

// cleg is one leg of a logical stream, the client end.
type cleg struct {
	cs     grpc.ClientStream
	cancel context.CancelFunc
	exp    time.Time
}

type clientSession struct {
	cc     grpc.ClientConnInterface
	desc   *grpc.StreamDesc
	method string
	opts   []grpc.CallOption
	tokens func() (string, error)
	ctx    context.Context
	cancel context.CancelFunc
	id     atomic.Pointer[string]

	// sendMu serialises the sends and the moves of sendLeg.
	sendMu  sync.Mutex
	sendLeg atomic.Pointer[cleg]
	readLeg atomic.Pointer[cleg]
	// nextLeg is the leg after the read leg, set before the cutover.
	nextLeg  atomic.Pointer[cleg]
	firstLeg *cleg
	finSent  atomic.Bool

	items   chan []byte
	dead    chan struct{}
	done    atomic.Bool
	endErr  error
	trailer metadata.MD

	rotatingNow atomic.Bool
	timerMu     sync.Mutex
	rotation    *time.Timer
}

func newClientSession(ctx context.Context, cc grpc.ClientConnInterface, desc *grpc.StreamDesc, method string, opts []grpc.CallOption, tokens func() (string, error)) *clientSession {
	logical, cancel := context.WithCancel(ctx)
	return &clientSession{
		cc:     cc,
		desc:   desc,
		method: method,
		opts:   opts,
		tokens: tokens,
		ctx:    logical,
		cancel: cancel,
		items:  make(chan []byte),
		dead:   make(chan struct{}),
	}
}

func (s *clientSession) sessionID() string {
	if id := s.id.Load(); id != nil {
		return *id
	}
	return ""
}

// openLeg opens one leg with token: its first envelope names the session it
// joins (empty for a new one), and it is attached once the server's first
// envelope names the session.
func (s *clientSession) openLeg(token, joining string) (*cleg, error) {
	tw, err := tokenlib.ParseToken(token)
	if err != nil {
		return nil, status.Error(codes.Unauthenticated, "rotation: the token does not parse")
	}
	exp := time.Unix(tw.GetExpiration(), 0)
	md, _ := metadata.FromOutgoingContext(s.ctx)
	md = md.Copy()
	md.Set("authorization", "Bearer "+token)
	legCtx, cancel := context.WithDeadline(metadata.NewOutgoingContext(s.ctx, md), exp.Add(expiryGrace))
	cs, err := s.cc.NewStream(legCtx, &legDesc, s.method, s.opts...)
	if err != nil {
		cancel()
		return nil, err
	}
	l := &cleg{cs: cs, cancel: cancel, exp: exp}
	// A refused leg fails the send; its status comes from the receive below.
	_ = cs.SendMsg(&rotation_pb.Envelope{SessionId: joining})
	attached := make(chan error, 1)
	go func() {
		e := &rotation_pb.Envelope{}
		if err := cs.RecvMsg(e); err != nil {
			attached <- err
			return
		}
		if e.SessionId == "" || (joining != "" && e.SessionId != joining) || len(e.Payload) > 0 || e.Last || e.Fin {
			attached <- status.Error(codes.PermissionDenied, "rotation: the server did not attach the leg")
			return
		}
		id := e.SessionId
		s.id.Store(&id)
		attached <- nil
	}()
	timer := time.NewTimer(openTimeout)
	defer timer.Stop()
	select {
	case err := <-attached:
		if err != nil {
			cancel()
			return nil, err
		}
		return l, nil
	case <-timer.C:
		cancel()
		return nil, status.Error(codes.DeadlineExceeded, "rotation: the server did not attach the leg in time")
	case <-s.ctx.Done():
		cancel()
		return nil, status.FromContextError(s.ctx.Err()).Err()
	}
}

func (s *clientSession) start(first *cleg) {
	s.firstLeg = first
	s.sendLeg.Store(first)
	s.readLeg.Store(first)
	go s.read()
	s.schedule(first)
}

// read moves the read leg's envelopes to RecvMsg, leg by leg.
func (s *clientSession) read() {
	for !s.done.Load() {
		l := s.readLeg.Load()
		e := &rotation_pb.Envelope{}
		if err := l.cs.RecvMsg(e); err != nil {
			// A leg that ends without last ends the logical stream with its
			// status: the handler's own end, or a fault. Never spliced.
			s.finish(err, l)
			return
		}
		if malformed(e) {
			s.fault(codes.Internal, "rotation: malformed envelope")
			return
		}
		if isMessage(e) {
			select {
			case s.items <- e.Payload:
			case <-s.dead:
				return
			}
		}
		if e.Last {
			next := s.nextLeg.Load()
			if next == nil {
				s.fault(codes.Internal, "rotation: last with no leg to cut over to")
				return
			}
			s.readLeg.Store(next)
			s.nextLeg.CompareAndSwap(next, nil)
			// The old leg ends OK after its last; read that end so it is freed.
			go func(old *cleg) {
				var drain rotation_pb.Envelope
				for old.cs.RecvMsg(&drain) == nil {
				}
				old.cancel()
			}(l)
		}
	}
}

// finish ends the logical stream with err (io.EOF: OK).
func (s *clientSession) finish(err error, l *cleg) {
	if !s.done.CompareAndSwap(false, true) {
		return
	}
	if l != nil {
		s.trailer = l.cs.Trailer()
	}
	s.endErr = err
	close(s.dead)
	s.timerMu.Lock()
	if s.rotation != nil {
		s.rotation.Stop()
	}
	s.timerMu.Unlock()
	s.cancel()
}

func (s *clientSession) fault(code codes.Code, reason string) {
	zap.L().Info("rotation: stream ended", zap.String("method", s.method), zap.String("reason", reason), zap.String("code", code.String()))
	s.finish(status.Error(code, reason), nil)
}

// schedule schedules the rotation of l at RotateAt of its token's lifetime.
func (s *clientSession) schedule(l *cleg) {
	left := time.Until(l.exp)
	s.later(max(rotateMin, time.Duration(float64(left)*RotateAt)))
}

func (s *clientSession) later(delay time.Duration) {
	s.timerMu.Lock()
	defer s.timerMu.Unlock()
	if s.done.Load() {
		return
	}
	s.rotation = time.AfterFunc(delay, s.rotate)
}

// rotate is make-before-break: a new token, a new leg joining this session,
// then the cutover. A mint that fails or returns no newer token is retried
// every second; the current leg ends at its token's exp regardless (fail
// closed). A refused rotation ends the logical stream.
func (s *clientSession) rotate() {
	if s.done.Load() || !s.rotatingNow.CompareAndSwap(false, true) {
		return
	}
	defer s.rotatingNow.Store(false)
	current := s.sendLeg.Load()
	token, err := s.tokens()
	if err != nil || token == "" {
		zap.L().Warn("rotation: token mint for a rotation failed, retrying", zap.String("method", s.method), zap.Error(err))
		s.later(rotateRetry)
		return
	}
	tw, err := tokenlib.ParseToken(token)
	if err != nil || !time.Unix(tw.GetExpiration(), 0).After(current.exp) {
		// No newer token yet: the identity cache renews it ahead of expiry.
		s.later(rotateRetry)
		return
	}
	next, err := s.openLeg(token, s.sessionID())
	if status.Code(err) == codes.Unauthenticated {
		if fresh, terr := s.tokens(); terr == nil && fresh != "" {
			next, err = s.openLeg(fresh, s.sessionID())
		}
	}
	if err != nil {
		if s.done.Load() {
			return
		}
		if c := status.Code(err); c == codes.Unauthenticated || c == codes.PermissionDenied {
			s.fault(c, "")
			return
		}
		zap.L().Warn("rotation: rotation failed, retrying", zap.String("method", s.method), zap.Error(err))
		s.later(rotateRetry)
		return
	}
	s.nextLeg.Store(next)
	if s.done.Load() {
		next.cancel()
		return
	}
	s.cutOver(next)
	s.schedule(next)
}

// cutOver moves the sends to next: last on the old leg, then its half-close.
func (s *clientSession) cutOver(next *cleg) {
	s.sendMu.Lock()
	defer s.sendMu.Unlock()
	old := s.sendLeg.Load()
	_ = old.cs.SendMsg(&rotation_pb.Envelope{Last: true})
	_ = old.cs.CloseSend()
	s.sendLeg.Store(next)
}

// The logical grpc.ClientStream.

func (s *clientSession) Header() (metadata.MD, error) { return s.firstLeg.cs.Header() }
func (s *clientSession) Trailer() metadata.MD {
	select {
	case <-s.dead:
		return s.trailer
	default:
		return nil
	}
}
func (s *clientSession) Context() context.Context { return s.ctx }

func (s *clientSession) CloseSend() error {
	s.sendMu.Lock()
	defer s.sendMu.Unlock()
	if s.done.Load() || !s.finSent.CompareAndSwap(false, true) {
		return nil
	}
	// A failure surfaces from RecvMsg, as gRPC's own CloseSend.
	_ = s.sendLeg.Load().cs.SendMsg(&rotation_pb.Envelope{Fin: true})
	return nil
}

func (s *clientSession) SendMsg(m any) error {
	pm, ok := m.(proto.Message)
	if !ok {
		return status.Errorf(codes.Internal, "rotation: %T is not a proto message", m)
	}
	b, err := proto.Marshal(pm)
	if err != nil {
		return status.Errorf(codes.Internal, "rotation: marshal: %v", err)
	}
	s.sendMu.Lock()
	defer s.sendMu.Unlock()
	if s.finSent.Load() {
		return status.Error(codes.Internal, "rotation: SendMsg called after CloseSend")
	}
	if s.done.Load() {
		return io.EOF
	}
	if err := s.sendLeg.Load().cs.SendMsg(&rotation_pb.Envelope{Payload: b}); err != nil {
		// As gRPC's own: the stream has ended, RecvMsg says how.
		return io.EOF
	}
	return nil
}

func (s *clientSession) RecvMsg(m any) error {
	select {
	case b := <-s.items:
		pm, ok := m.(proto.Message)
		if !ok {
			return status.Errorf(codes.Internal, "rotation: %T is not a proto message", m)
		}
		if err := proto.Unmarshal(b, pm); err != nil {
			return status.Errorf(codes.Internal, "rotation: unmarshal: %v", err)
		}
		if !s.desc.ServerStreams {
			// One response: the stream's status follows it.
			<-s.dead
			if s.endErr != io.EOF {
				return s.endErr
			}
		}
		return nil
	case <-s.dead:
		if s.endErr == io.EOF && !s.desc.ServerStreams {
			return status.Error(codes.Internal, "rotation: the stream ended without a response")
		}
		return s.endErr
	}
}
