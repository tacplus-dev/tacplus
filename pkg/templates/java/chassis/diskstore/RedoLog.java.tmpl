        try {
            byte[] raw = Files.readAllBytes(path);
            byte[] packed = Codec.compress(raw, codec);
            Path tmp = FsUtil.writeTemp(path, packed, 0);
            FsUtil.promote(tmp, path);
        } catch (IOException e) {
            throw DiskStoreException.io(e.getMessage(), e);
        }
    }

    // ---- minimal NDJSON envelope codec ----
    //
    // The envelope has exactly four well-known keys. payload is raw JSON
    // (an object/value), embedded verbatim. metadata/payload are omitted when
    // null; deleted is always written.

    static String encode(Record rec) {
        StringBuilder sb = new StringBuilder();
        sb.append('{');
        sb.append("\"key\":").append(jsonString(rec.key));
        sb.append(",\"deleted\":").append(rec.deleted ? "true" : "false");
        if (rec.metadata != null) {
            sb.append(",\"metadata\":").append(jsonString(rec.metadata));
        }
        if (rec.payload != null) {
            sb.append(",\"payload\":").append(rec.payload);
        }
        sb.append('}');
        return sb.toString();
    }

    static Record decode(String line) {
        EnvelopeParser p = new EnvelopeParser(line);
        return p.parse();
    }

    static String jsonString(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '"':
                    sb.append("\\\"");
                    break;
                case '\\':
                    sb.append("\\\\");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                case '\b':
                    sb.append("\\b");
                    break;
                case '\f':
                    sb.append("\\f");
                    break;
                default:
                    if (c < 0x20) {
                        sb.append(String.format("\\u%04x", (int) c));
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }

    /**
     * A tiny recursive-descent parser for the envelope. It reads the top-level
     * object's known keys, returning string values for {@code key}/{@code
     * metadata}, a boolean for {@code deleted}, and the <b>raw JSON text</b> for
     * {@code payload} (so the embedded type JSON is handed back to the generated
     * {@code FromJson} unchanged). Unknown keys are skipped.
     */
    private static final class EnvelopeParser {
        private final String s;
        private int i;

        EnvelopeParser(String s) {
            this.s = s;
        }

        Record parse() {
            ws();
            expect('{');
            String key = null;
            boolean deleted = false;
            String metadata = null;
            String payload = null;
            ws();
            if (peek() == '}') {
                i++;
            } else {
                while (true) {
                    ws();
                    String field = readString();
                    ws();
                    expect(':');
                    ws();
                    switch (field) {
                        case "key":
                            key = readString();
                            break;
                        case "deleted":
                            deleted = readBoolean();
                            break;
                        case "metadata":
                            if (peek() == 'n') {
                                readNull();
                                metadata = null;
                            } else {
                                metadata = readString();
                            }
                            break;
                        case "payload":
                            if (peek() == 'n') {
                                readNull();
                                payload = null;
                            } else {
                                payload = readRawValue();
                            }
                            break;
                        default:
                            skipValue();
                    }
                    ws();
                    char c = peek();
                    if (c == ',') {
                        i++;
                        continue;
                    }
                    expect('}');
                    break;
                }
            }
            if (key == null) {
                throw new IllegalArgumentException("record missing key");
            }
            return new Record(key, deleted, metadata, payload);
        }

        private char peek() {
            if (i >= s.length()) {
                throw new IllegalArgumentException("unexpected end of input");
            }
            return s.charAt(i);
        }

        private void expect(char c) {
            if (peek() != c) {
                throw new IllegalArgumentException("expected '" + c + "' at " + i);
            }
            i++;
        }

        private void ws() {
            while (i < s.length()) {
                char c = s.charAt(i);
                if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
                    i++;
                } else {
                    break;
                }
            }
        }

        private String readString() {
            expect('"');
            StringBuilder sb = new StringBuilder();
            while (true) {
                char c = s.charAt(i++);
                if (c == '"') {
                    break;
                }
                if (c == '\\') {
                    char e = s.charAt(i++);
                    switch (e) {
                        case '"':
                            sb.append('"');
                            break;
                        case '\\':
                            sb.append('\\');
                            break;
                        case '/':
                            sb.append('/');
                            break;
                        case 'n':
                            sb.append('\n');
                            break;
                        case 'r':
                            sb.append('\r');
                            break;
                        case 't':
                            sb.append('\t');
                            break;
                        case 'b':
                            sb.append('\b');
                            break;
                        case 'f':
                            sb.append('\f');
                            break;
                        case 'u':
                            sb.append((char) Integer.parseInt(s.substring(i, i + 4), 16));
                            i += 4;
                            break;
                        default:
                            throw new IllegalArgumentException("bad escape: \\" + e);
                    }
                } else {
                    sb.append(c);
                }
            }
            return sb.toString();
        }

        private boolean readBoolean() {
            if (s.startsWith("true", i)) {
                i += 4;
                return true;
            }
            if (s.startsWith("false", i)) {
                i += 5;
                return false;
            }
            throw new IllegalArgumentException("expected boolean at " + i);
        }

        private void readNull() {
            if (s.startsWith("null", i)) {
                i += 4;
                return;
            }
            throw new IllegalArgumentException("expected null at " + i);
        }

        /** Read a JSON value and return its raw source text (balanced). */
        private String readRawValue() {
            int start = i;
            skipValue();
            return s.substring(start, i);
        }

        /** Advance past one JSON value without interpreting it. */
        private void skipValue() {
            ws();
            char c = peek();
            switch (c) {
                case '"':
                    readString();
                    return;
                case '{':
                    skipContainer('{', '}');
                    return;
                case '[':
                    skipContainer('[', ']');
                    return;
                case 't':
                    readBoolean();
                    return;
                case 'f':
                    readBoolean();
                    return;
                case 'n':
                    readNull();
                    return;
                default:
                    skipNumber();
            }
        }

        private void skipContainer(char open, char close) {
            expect(open);
            int depth = 1;
            while (depth > 0) {
                char c = s.charAt(i++);
                if (c == '"') {
                    i--;
                    readString();
                } else if (c == open) {
                    depth++;
                } else if (c == close) {
                    depth--;
                }
            }
        }

        private void skipNumber() {
            int start = i;
            while (i < s.length()) {
                char c = s.charAt(i);
                if ((c >= '0' && c <= '9') || c == '-' || c == '+' || c == '.'
                        || c == 'e' || c == 'E') {
                    i++;
                } else {
                    break;
                }
            }
            if (i == start) {
                throw new IllegalArgumentException("expected value at " + i);
            }
        }
    }
}
