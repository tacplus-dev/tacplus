{
  "_comment": "Canonical SPIFFE identity test corpus (plan: the archived SPIFFE_IDENTITY_NORMALIZATION_PLAN, Validation And Test Vectors). Single source of truth: every generated language's sys/spiffe test asserts THIS corpus, so identity construction/parse/comparison is byte-identical across Go, Rust, Python, TypeScript, and Java. The Go reference test (pkg/templates/go/sys/spiffe/spiffe_test.go.tmpl) is the executable mirror of this file.",
  "scheme_version": "v1",
  "construction": {
    "service": {
      "trust_domain": "example.com",
      "location": "aws/us-east-1a/cluster-7/team-a",
      "service": "mcp",
      "expect": "spiffe://example.com/system/aws/us-east-1a/cluster-7/team-a/services/mcp"
    },
    "workload": {
      "parent": "spiffe://example.com/system/aws/us-east-1a/cluster-7/team-a/services/mcp",
      "child": "agent-42",
      "expect": "spiffe://example.com/system/aws/us-east-1a/cluster-7/team-a/services/mcp/workloads/agent-42"
    },
    "tenant": {
      "trust_domain": "example.com",
      "tenant": "acme",
      "expect": "spiffe://example.com/tenants/acme"
    },
    "workspace": {
      "trust_domain": "example.com",
      "tenant": "acme",
      "workspace": ["dev"],
      "expect": "spiffe://example.com/tenants/acme/workspaces/dev"
    },
    "namespace": {
      "trust_domain": "example.com",
      "namespace": "/tenants/acme/workspaces/dev",
      "expect": "spiffe://example.com/tenants/acme/workspaces/dev"
    },
    "user": {
      "trust_domain": "example.com",
      "namespace": "/tenants/acme/workspaces/dev",
      "stable_user": "jody",
      "expect": "spiffe://example.com/tenants/acme/workspaces/dev/users/jody"
    },
    "resource": {
      "trust_domain": "example.com",
      "namespace": "/tenants/acme/workspaces/dev",
      "kind": "gitlab-event",
      "id": "evt-1",
      "expect": "spiffe://example.com/tenants/acme/workspaces/dev/data/gitlab-event/evt-1"
    }
  },
  "parse": [
    {
      "input": "spiffe://example.com/system/aws/us-east-1a/cluster-7/team-a/services/mcp",
      "trust_domain": "example.com",
      "subject_kind": "service",
      "location_path": "aws/us-east-1a/cluster-7/team-a",
      "subject_path": "mcp"
    },
    {
      "input": "spiffe://example.com/system/aws/us-east-1a/cluster-7/team-a/services/mcp/workloads/agent-42",
      "subject_kind": "workload",
      "subject_path": "mcp/workloads/agent-42"
    },
    {
      "input": "spiffe://example.com/tenants/acme/services/docmanageragent",
      "subject_kind": "service",
      "namespace": "/tenants/acme",
      "subject_path": "docmanageragent"
    },
    {
      "input": "spiffe://example.com/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b",
      "subject_kind": "user",
      "namespace": "/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b",
      "subject_path": "0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b"
    },
    {
      "input": "spiffe://example.com/tenants/acme/workspaces/dev/users/jody",
      "subject_kind": "user",
      "namespace": "/tenants/acme/workspaces/dev",
      "subject_path": "jody"
    },
    {
      "input": "spiffe://example.com/tenants/acme/workspaces/dev/data/gitlab-event/evt-1",
      "subject_kind": "resource",
      "resource_kind": "gitlab-event",
      "resource_id": "evt-1"
    }
  ],
  "round_trip": [
    "spiffe://example.com/system/aws/us-east-1a/cluster-7/team-a/services/mcp",
    "spiffe://example.com/system/aws/us-east-1a/cluster-7/team-a/services/mcp/workloads/agent-42",
    "spiffe://example.com/tenants/acme/services/docmanageragent",
    "spiffe://example.com/tenants/acme/workspaces/dev",
    "spiffe://example.com/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b",
    "spiffe://example.com/tenants/acme/workspaces/dev/users/jody",
    "spiffe://example.com/tenants/acme/workspaces/dev/data/gitlab-event/evt-1"
  ],
  "comparison": {
    "is_at_or_below": [
      { "caller": "/tenants/acme", "target": "/tenants/acme/workspaces/dev", "expect": true },
      { "caller": "/tenants/acme", "target": "/tenants/acme2/workspaces/dev", "expect": false },
      { "_comment": "/users/<xid> is its own subtree: a tenant never reaches a user root, and a user root never reaches a tenant, in either direction",
        "caller": "/tenants/acme", "target": "/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b", "expect": false },
      { "caller": "/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b", "target": "/tenants/acme", "expect": false },
      { "caller": "/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b", "target": "/tenants/acme/workspaces/dev", "expect": false },
      { "caller": "/tenants/acme/workspaces/dev", "target": "/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b", "expect": false },
      { "caller": "/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b", "target": "/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b", "expect": true },
      { "caller": "/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b", "target": "/users/7d3e9f20-1c4b-4a6e-8f5d-2b1a0c9e8d7f", "expect": false }
    ],
    "same_trust_domain": [
      { "a": "spiffe://example.com/tenants/a", "b": "spiffe://example.com/tenants/b", "expect": true },
      { "a": "spiffe://example.com/tenants/a", "b": "spiffe://other.io/tenants/b", "expect": false }
    ],
    "service_path_location_agnostic": [
      { "input": "spiffe://example.com/system/aws/acct1/az1/cluster1/services/mcp", "expect": "mcp" },
      { "input": "spiffe://example.com/system/gcp/acct2/az9/cluster9/services/mcp", "expect": "mcp" }
    ]
  },
  "normalization": {
    "trust_domain": [
      { "input": " example.com ", "expect": "example.com" }
    ],
    "namespace": [
      { "input": " tenants/acme/ ", "expect": "/tenants/acme" },
      { "input": " users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b/ ", "expect": "/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b" }
    ]
  },
  "invalid_parse": [
    "",
    "spiffe://",
    "spiffe://example.com//system",
    "spiffe://example.com/../system",
    "spiffe://example.com/system?x=1",
    "spiffe://example.com/system#frag",
    "spiffe://example.com\\system",
    "spiffe://example.com/people/alice/users/alice",
    "spiffe://example.com/people/alice/users/bob",
    "spiffe://example.com/people/alice/services/mcp/users/alice",
    "spiffe://example.com/users",
    "spiffe://example.com/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b",
    "spiffe://example.com/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b/services/s",
    "spiffe://example.com/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b/data/gitlab-event/evt-1",
    "spiffe://example.com/users/users",
    "spiffe://example.com/foo/users/bar",
    "spiffe://example.com/tenants/x/users/users",
    "spiffe://example.com/tenants/x/clients/clients",
    "spiffe://example.com/tenants/x/clients/users",
    "spiffe://example.com/tenants/x/credentials/users/id",
    "spiffe://example.com/tenants/x/credentials/k/data",
    "spiffe://example.com/tenants/x/data/data/id",
    "spiffe://example.com/tenants/x/data/k/workloads",
    "spiffe://example.com/foo/clients/c",
    "spiffe://example.com/foo/credentials/k/i",
    "spiffe://example.com/foo/data/k/i",
    "spiffe://example.com/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b/users/jody",
    "spiffe://example.com/tenants/x/users/a/b",
    "spiffe://example.com/tenants/x/services/users",
    "spiffe://example.com/system/aws/services/workloads",
    "spiffe://example.com/tenants/x/services/s/workloads/users",
    "spiffe://example.com/foo/services/s",
    "spiffe://example.com/tenants/x/data/k/i/j"
  ],
  "invalid_construct": [
    { "fn": "normalize_trust_domain", "args": ["example.com/x"] },
    { "fn": "resource_spiffe_id", "args": ["example.com", "/tenants/acme", "gitlab-event", "../evt-1"] },
    { "fn": "resource_spiffe_id", "args": ["example.com", "/tenants/acme", "gitlab-event", "evt%2F1"] },
    { "fn": "resource_spiffe_id", "args": ["example.com", "/tenants/acme", "gitlab/event", "evt-1"] },
    { "fn": "credential_spiffe_id", "args": ["example.com", "/tenants/acme", "cred-pair", "cred:pair"] },
    { "fn": "credential_spiffe_id", "args": ["example.com", "/tenants/acme", "cred-pair", "cred/pair"] },
    { "fn": "user_spiffe_id", "args": ["example.com", "/tenants/acme", "issuer/user"] },
    { "fn": "namespace_spiffe_id", "args": ["example.com", "/tenants/acme/data"] },
    { "fn": "namespace_spiffe_id", "args": ["example.com", "/tenants/system"] },
    { "fn": "tenant_spiffe_id", "args": ["example.com", "system"] },
    { "fn": "tenant_spiffe_id", "args": ["example.com", "data"] },
    { "fn": "tenant_spiffe_id", "args": ["example.com", "tenants"] },
    { "fn": "user_root_spiffe_id", "args": ["example.com", "users"] },
    { "fn": "user_root_spiffe_id", "args": ["example.com", "a/b"] },
    { "fn": "user_root_spiffe_id", "args": ["example.com/x", "0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b"] },
    { "fn": "namespace_spiffe_id", "args": ["example.com", "/users"] },
    { "fn": "namespace_spiffe_id", "args": ["example.com", "/users/users"] },
    { "fn": "namespace_spiffe_id", "args": ["example.com", "/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b/workspaces/dev"] },
    { "fn": "namespace_spiffe_id", "args": ["example.com", "/people/alice"] },
    { "fn": "user_spiffe_id", "args": ["example.com", "/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b", "0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b"] },
    { "fn": "user_spiffe_id", "args": ["example.com", "/tenants/acme", "users"] },
    { "fn": "resource_spiffe_id", "args": ["example.com", "/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b", "gitlab-event", "evt-1"] },
    { "fn": "credential_spiffe_id", "args": ["example.com", "/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b", "cred-pair", "cred-1"] }
  ],
  "valid_construct": [
    { "fn": "namespace_spiffe_id", "args": ["example.com", "/system/aws/acct1"], "expect": "spiffe://example.com/system/aws/acct1" },
    { "_comment": "\"people\" is the platform identity tenant - the one reserved tag that is legal as a tenant name. Every other reserved tag stays rejected (see invalid_construct /tenants/system).",
      "fn": "tenant_spiffe_id", "args": ["example.com", "people"], "expect": "spiffe://example.com/tenants/people" },
    { "fn": "namespace_spiffe_id", "args": ["example.com", "/tenants/people"], "expect": "spiffe://example.com/tenants/people" },
    { "fn": "user_spiffe_id", "args": ["example.com", "/tenants/people", "jody"], "expect": "spiffe://example.com/tenants/people/users/jody" },
    { "fn": "user_root_spiffe_id", "args": ["example.com", "0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b"], "expect": "spiffe://example.com/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b" },
    { "fn": "namespace_spiffe_id", "args": ["example.com", "/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b"], "expect": "spiffe://example.com/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b" },
    { "fn": "user_spiffe_id", "args": ["example.com", "/tenants/acme", "0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b"], "expect": "spiffe://example.com/tenants/acme/users/0b6f2c1e-4a5d-4e8f-9a7b-3c2d1e0f9a8b" }
  ],
  "opaque_segment": {
    "spec": "base32_lower_nopad(SHA256(utf8(kind) || 0x1F || utf8(NFC(value)))[:20]); 32 chars [a-z2-7]; kind domain-separates",
    "length": 32,
    "vectors": [
      { "kind": "user", "value": "issuer/user", "expect": "ewh3mwz66l7d3yilnuiqygw43gdjtg6i" },
      { "kind": "tenant", "value": "acme", "expect": "2cw26xgiswhtrtrdsgkrfrgqrf6vjffe" },
      { "_comment": "same value as tenant/acme - kind domain-separation must yield a different segment",
        "kind": "resource", "value": "acme", "expect": "ngrhnkrudusp3j3okosy2a4wigdklnjv" },
      { "_comment": "NFD input (e + COMBINING ACUTE, expressed as an escape so the file stays ASCII) - implementations must NFC-normalize before hashing",
        "kind": "user", "value": "iss/rene\u0301", "expect": "qs4rzt5hfv7lvnb6ytkb2hpbltlfp33h" }
    ]
  }
}
