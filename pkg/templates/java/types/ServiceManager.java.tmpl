{{- end}}
{{- if .HostsC2DStandalone}}

    /**
     * Hosts this build's service_c2d services on socketPath with NO cluster: no
     * config load, no identity manager, no state store, no TLS server. It is the
     * generated c2d server and the generated wrappers (request/response
     * validation, the c2d token-auth skip) and nothing else, for a local daemon
     * that cannot call {@link #create}. It is emitted only because every service
     * this build hosts is service_c2d and nothing in it needs the cluster;
     * create and run stay for running the same daemon in one.
     *
     * <p>A daemon passes {@link #C2D_SOCKET_PATH}, the declared socket; a test
     * passes its own so it never takes over the socket of a daemon already
     * running on the host. Serves until {@code stop} completes, drains
     * in-flight RPCs, removes the socket and then calls
     * {@code handler.shutdown()}. A socket that cannot be bound or locked down
     * to owner-only throws, without calling {@code handler.shutdown()}.
     */
    public static void serveC2DStandalone(String socketPath, Handler handler, java.util.concurrent.Future<?> stop) throws Exception {
        C2DServer c2dSrv = newC2DServer(socketPath, new io.grpc.BindableService[] {
{{- range .GrpcServices}}
                new {{.ServerClassName}}(handler.{{.GetterName}}()),
{{- end}}
            });
        c2dSrv.start();
        try {
            stop.get();
        } finally {
            c2dSrv.shutdown();
        }
        handler.shutdown();
    }
{{- end}}
    /**
     * Starts the service lifecycle with the given handler.
     *
     * <p>Creates a TLS-enabled gRPC server using auto-obtained X509Mint certs,
     * wraps handler implementations with validation/authorization, registers
     * all services, and serves until shutdown signal.
     */
    public void run(Handler handler) throws Exception {
        LOG.info("ServiceManager starting");

	{{- if .HasSysState}}
        // Fetch shared runtime config (spiffe_trust_domain, location_path, listen address, logger, timeouts).
        // Runtime fields merge into boot config — boot config takes precedence for bootstrap fields.
        {
            var runtimeStub = ServiceConfigStateServiceGrpc.newBlockingStub(stateStoreConn.conn())
                    .withCallCredentials(identity.callCredentials());
            Config runtimeCfg = runtimeStub.getConfig(
                    Trace.TraceRequest.getDefaultInstance());
            runtimeCfg = {{.TypesBase}}.sys.grpcconfig.Helpers.configDefaults(runtimeCfg).build();
            config = {{.TypesBase}}.sys.grpcconfig.Helpers.mergeConfig(config, runtimeCfg).build();
            LOG.info("Merged runtime config from ServiceConfigState");
        }

        // Re-install the logger with runtime config so cluster-level logger
        // settings (level, format, output paths) take effect. The baseline
        // install happened in GrpcConfigLoader.loadConfig(); this upgrades it
        // with the runtime-config Logger field, matching Go's SM.Run() pattern.
        if (config.hasLogger()) {
            LogbackConfigurator.install(config.getLogger());
        }
	{{- end}}

{{- if .HasDiskStores}}
        java.util.List<ScheduledExecutorService> diskStoreSchedulers = startDiskStoreRollSchedulers(handler);
{{- end}}

	{{- if .HasStates}}
        // Fetch initial typed config from state and deliver to handler.
        // One fetch per ConfigState, shared by every handler that reads it: the
        // request is identical, and one unary call per handler bursts past the
        // state store's per-(peer, method) polling rate limit at startup.
{{- range .ConfigFetches}}
        {
            var configAccessor = stateClients.{{.ConfigStateGroupAccessor}}().{{.ConfigStateAccessor}}().config();
            // The generated fetch retries while the value fails its own validation:
            // a singleton Get can race the state authority's own convergence and
            // hand back a config that has not been fully seeded yet.
            {{.ConfigType}} typedConfig = configAccessor.fetch();
            typedConfig = {{$.TypesBase}}.services.{{.ConfigPackageName}}.Helpers.configDefaults(typedConfig).build();
            {{.ConfigType}} envCfg = {{$.TypesBase}}.services.{{.ConfigPackageName}}.Helpers.configFromEnvVar(
                    System.getenv()).build();
            typedConfig = {{$.TypesBase}}.services.{{.ConfigPackageName}}.Helpers.mergeConfig(envCfg, typedConfig).build();
{{- range .HandleConfigNames}}
            handler.{{.}}(typedConfig);
{{- end}}
            configAccessor.onChange(nextConfig -> {
                {{.ConfigType}} nextTypedConfig;
                try {
                    nextTypedConfig = {{$.TypesBase}}.services.{{.ConfigPackageName}}.Helpers.configDefaults(nextConfig).build();
                    {{.ConfigType}} nextEnvCfg = {{$.TypesBase}}.services.{{.ConfigPackageName}}.Helpers.configFromEnvVar(
                            System.getenv()).build();
                    nextTypedConfig = {{$.TypesBase}}.services.{{.ConfigPackageName}}.Helpers.mergeConfig(nextEnvCfg, nextTypedConfig).build();
                } catch (Exception e) {
                    LOG.warning("config update failed to merge: " + e.getMessage());
                    return;
                }
{{- range .HandleConfigNames}}
                try {
                    handler.{{.}}(nextTypedConfig);
                } catch (Exception e) {
                    LOG.warning("{{.}} failed on config update: " + e.getMessage());
                }
{{- end}}
            });
        }
{{- end}}
{{- end}}

{{- if .HasGrpc}}
        // Build the mandatory Authorizer once. REMOTE key source: watch the
        // JwkVerifyingKeysViewService over the state-store channel. Security is generated
        // and fail-closed — there is no way to construct a token-auth wrapper without it.
        Authorizer authorizer = new Authorizer(Authorizer.remoteSource(stateStoreConn.conn()));
        this.authorizer = authorizer;
        // A tenant-owned instance's own token namespace is /tenants/<t>; the
        // authorizer refuses callers outside that tenant at the door. An identity
        // that cannot be read leaves the door unpinned, so it fails startup.
        if (identity.hasAuth()) {
            authorizer.setHostNamespaceFromToken(identity.getToken());
