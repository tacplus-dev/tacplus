"""
Programmatic configurator for Python logging.

This module provides methods to configure Python's logging system
based on a protobuf LoggerConfig message.
"""

import json
import logging
import logging.handlers
import re
import sys
from typing import Optional

from .constants import Constants
from .log_level import LogLevel


class JsonFormatter(logging.Formatter):
    """
    JSON formatter for structured logging.
    """

    def __init__(self, pretty_print: bool = False):
        super().__init__()
        self.pretty_print = pretty_print

    def format(self, record: logging.LogRecord) -> str:
        """Format log record as JSON."""
        log_data = {
            "timestamp": self.formatTime(record, "%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z",
            "level": record.levelname,
            "logger": record.name,
            "message": record.getMessage(),
        }

        # Add extra fields from record
        if hasattr(record, 'extra_fields'):
            log_data.update(record.extra_fields)

        # Add exception info if present
        if record.exc_info:
            log_data["exception"] = self.formatException(record.exc_info)

        if self.pretty_print:
            return _redact_credentials(json.dumps(log_data, indent=2))
        else:
            return _redact_credentials(json.dumps(log_data))


class ConsoleFormatter(logging.Formatter):
    """
    Console formatter for human-readable logging.
    """

    def __init__(self, pretty_print: bool = False, disable_caller: bool = False):
        if pretty_print:
            fmt = "%(asctime)s.%(msecs)03d [%(threadName)s] %(levelname)-5s %(name)s - %(message)s"
            datefmt = "%Y-%m-%d %H:%M:%S"
        else:
            fmt = "%(asctime)s %(levelname)-5s %(name)s - %(message)s"
            datefmt = "%Y-%m-%d %H:%M:%S"

        super().__init__(fmt=fmt, datefmt=datefmt)
        self.disable_caller = disable_caller

    def format(self, record: logging.LogRecord) -> str:
        """Format and redact credentials from log output."""
        return _redact_credentials(super().format(record))


class LoggerConfigurator:
    """
    Programmatic configurator for Python logging.

    This class provides methods to configure Python's logging system
    based on a protobuf LoggerConfig message.
    """

    @staticmethod
    def install(config=None) -> None:
        """
        Installs a logger configuration based on the provided LoggerConfig.

        This method configures Python logging with:
        - Log level from config
        - Output format (JSON or console pattern)
        - Output paths (stdout, stderr, or file paths)
        - Initial fields as extra context

        Args:
            config: The LoggerConfig protobuf message (uses defaults if None)
        """
        # Use default config if None
        if config is None:
            from {{.PythonPackageBase}}.types.sys.logger import logger_pb2
            config = logger_pb2.LoggerConfig()

        # Get root logger
        root_logger = logging.getLogger()
        root_logger.handlers.clear()  # Clear any existing handlers

        # Set log level
        level = LogLevel.to_python_level(config.level)
        root_logger.setLevel(level)

        # Pin gRPC transport loggers to WARNING. grpc-python's Cython channel
        # code can emit HTTP/2 frame data (including authorization headers) at
        # DEBUG. The pin is unconditional so credentials never reach a log sink.
        for _name in _CREDENTIAL_LEAKING_LOGGERS:
            logging.getLogger(_name).setLevel(logging.WARNING)

        # Configure handlers based on output paths
        LoggerConfigurator._configure_handlers(root_logger, config)

        # Store initial fields (could use logging.Filter or contextvars for this)
        if config.initial_fields:
            # Create a custom filter to add initial fields to all records
            class InitialFieldsFilter(logging.Filter):
                def __init__(self, initial_fields):
                    super().__init__()
                    self.initial_fields = initial_fields

                def filter(self, record):
                    if not hasattr(record, 'extra_fields'):
                        record.extra_fields = {}
                    record.extra_fields.update(self.initial_fields)
                    return True

            initial_fields_filter = InitialFieldsFilter(dict(config.initial_fields))
            root_logger.addFilter(initial_fields_filter)

    @staticmethod
    def _configure_handlers(logger: logging.Logger, config) -> None:
        """
        Configures handlers based on the LoggerConfig output paths.

        Args:
            logger: The logger to configure
            config: The LoggerConfig protobuf message
        """
        from {{.PythonPackageBase}}.types.sys.logger import logger_pb2

        # Create formatter based on format
        if config.format == logger_pb2.FORMAT_CONSOLE:
            formatter = ConsoleFormatter(
                pretty_print=config.pretty_print,
                disable_caller=config.disable_caller
            )
        else:
            formatter = JsonFormatter(pretty_print=config.pretty_print)

        # If no output paths specified, default to stderr
        if not config.output_paths:
            handler = logging.StreamHandler(sys.stderr)
            handler.setFormatter(formatter)
            logger.addHandler(handler)
            return

        # Configure handlers for each output path
        for output_path in config.output_paths:
            if output_path.lower() == "stdout":
                handler = logging.StreamHandler(sys.stdout)
                handler.setFormatter(formatter)
                logger.addHandler(handler)
            elif output_path.lower() == "stderr":
                handler = logging.StreamHandler(sys.stderr)
                handler.setFormatter(formatter)
                logger.addHandler(handler)
            else:
                # File handler
                handler = logging.FileHandler(output_path, mode='a')
                handler.setFormatter(formatter)
                logger.addHandler(handler)


# Compiled patterns for credential redaction at the log output boundary.
# Covered keys (case-insensitive):
#   - authorization (Bearer, Basic, or any scheme)
#   - cookie / set-cookie
#   - any key ending in -token, _token, -secret, or _secret
#   - standalone Bearer <token> (catches tokens regardless of context)
_CREDENTIAL_PATTERNS = [
    re.compile(r'(?i)(authorization\s*[:=]\s*)(\S+(?:\s+\S+)?)'),
    re.compile(r'(?i)((?:set-)?cookie\s*[:=]\s*)(\S+)'),
    re.compile(r'(?i)([\w][\w-]*[-_](?:token|secret)\s*[:=]\s*)(\S+)'),
    re.compile(r'(?i)(Bearer\s+)(\S{20,})'),
]

_REDACTED = '[REDACTED]'


def _redact_credentials(s: str) -> str:
    """Redact credential values from a string at the log output boundary."""
    for pattern in _CREDENTIAL_PATTERNS:
        s = pattern.sub(r'\1' + _REDACTED, s)
    return s


# gRPC transport loggers that can emit HTTP/2 frame data with authorization
# headers at DEBUG. Pinned to WARNING in install() so credentials never leak.
_CREDENTIAL_LEAKING_LOGGERS = [
    "grpc",
    "grpc._cython",
    "grpc._channel",
    "grpc.aio",
]


# Add TRACE level to Python logging (DEBUG is 10, so TRACE is 5)
TRACE = 5
logging.addLevelName(TRACE, "TRACE")


def trace(self, message, *args, **kwargs):
    """Log a message with severity 'TRACE'."""
    if self.isEnabledFor(TRACE):
        self._log(TRACE, message, args, **kwargs)


# Add trace method to Logger class
logging.Logger.trace = trace
