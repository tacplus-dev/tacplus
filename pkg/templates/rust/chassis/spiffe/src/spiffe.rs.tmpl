    if segs.len() != 2 || is_reserved_tag(segs[1]) {
        return err(format!("spiffe: malformed user root identity: /{}", segs.join("/")));
    }
    p.subject_kind = SubjectKind::User;
    p.namespace = format!("/{}/{}", USERS_SEGMENT, segs[1]);
    p.subject_path = segs[1].to_string();
    Ok(())
}

