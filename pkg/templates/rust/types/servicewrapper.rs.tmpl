    /// Tells the wrapper the namespace its own instance runs in (the
    /// authorizer's host namespace, from the instance's own identity). A
    /// tenant-owned instance runs in `/tenants/<t>` and serves only calls
    /// routed to `<t>`; any other namespace serves no single tenant, and the
    /// backstop then only checks that the route field is a tid.
    pub fn set_host_namespace(&self, namespace: &str) {
        let tenant = servicemanager::tenant_route::host_tenant_of_namespace(namespace).unwrap_or_default();
        *self.host_tenant.write().unwrap() = tenant;
    }

    /// The (spec.rpc).route_field backstop, after request validation and before
    /// the handler: INVALID_ARGUMENT when the route field is not a tid,
    /// PERMISSION_DENIED when it names a tenant this instance does not serve.
    fn check_route_tenant(&self, field: &str, value: &str) -> Result<(), tonic::Status> {
        let host = self.host_tenant.read().unwrap().clone();
        servicemanager::tenant_route::check_routed_tenant(field, value, &host)
    }
{{- end}}

{{- if .HasRequiresDevice}}

    /// Wires the (spec.rpc).requires_device broker call. Called by the
    /// ServiceManager for every wrapper hosting a guarded rpc.
    pub async fn set_approval_check_func(&self, check: Option<approval::Check>) {
        *self.approval_check.write().await = check;
    }

    /// Brokers one device-only approval, or refuses the rpc. Fail-closed twice:
    /// an unwired check refuses, and a caller the authorizer did not verify
    /// refuses — the broker is told WHICH user the approval must belong to, and
    /// a call with no verified identity cannot name one.
    async fn broker_approval(
        &self,
        rpc_method: &str,
        presented: &approval::Presented,
        request_hash: Vec<u8>,
        caller: Option<&servicemanager::auth::Caller>,
    ) -> Result<(), tonic::Status> {
        let caller = caller.ok_or_else(|| {
            tonic::Status::unauthenticated(
                "this rpc requires a device approval, but the call carries no verified caller",
            )
        })?;
        let check = self.approval_check.read().await.clone().ok_or_else(|| {
            tonic::Status::internal(
                "approval check not wired (build/SM bug) — a requires_device rpc cannot be served without it",
            )
        })?;
        check(approval::CheckRequest {
            rpc_method: rpc_method.to_string(),
            approval_id: presented.approval_id.clone(),
            request_hash,
            // The RAW claims out of the token the authorizer already verified,
            // exactly as Go reports them: the broker, not the wrapper, decides
            // whether they name the person the approval belongs to.
            caller_namespace: caller.namespace().unwrap_or("").to_string(),
            caller_subject: caller.token().subject().unwrap_or("").to_string(),
            device_assertion: presented.device_assertion.clone(),
        })
        .await
    }
{{- end}}

    /// Sets the authorization function.
    pub async fn set_authorize_func(&self, auth: Option<Arc<dyn Authorizer>>) {
        let mut guard = self.authorizer.write().await;
        *guard = auth;
    }

    /// Sets the authentication function for services that use auth_any_user.
