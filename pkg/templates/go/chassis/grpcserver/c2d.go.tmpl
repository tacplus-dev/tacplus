// Local IPC gRPC server for c2d services: a Unix domain socket on macOS and
// Linux, a named pipe on Windows (docs/API.md, C2D transport).
//
// The ServiceManager creates a C2DServer for the service_c2d services it hosts
// and calls Serve to listen on the declared socket_path (on Windows, the pipe
// serviceconnection.C2DPipeName derives from it). No TLS and no token auth:
// the endpoint is current-user only (the socket file's 0600, the pipe's DACL),
// and that is the access boundary (docs/API.md, C2D server auth-skip scope).

package grpcserver

import (
	"context"
	"fmt"
	"time"

	"go.uber.org/zap"
	"google.golang.org/grpc"
	"google.golang.org/grpc/health"
	healthpb "google.golang.org/grpc/health/grpc_health_v1"
)

// c2dShutdownTimeout bounds the graceful drain of in-flight c2d RPCs.
const c2dShutdownTimeout = 30 * time.Second

// C2DServer is a gRPC server on the c2d local IPC endpoint.
type C2DServer struct {
	socketPath string
	impl       ServiceImplementation
}

// NewC2DServer creates a server that will host impl's services on socketPath.
func NewC2DServer(socketPath string, impl ServiceImplementation) *C2DServer {
	return &C2DServer{socketPath: socketPath, impl: impl}
}

// SocketPath returns the socket path.
func (s *C2DServer) SocketPath() string {
	return s.socketPath
}

// Serve listens on the c2d endpoint and blocks until ctx is cancelled.
//
// On macOS and Linux it removes any stale socket file before binding, then
// restricts the socket file itself to owner-only (0600); the socket file is
// removed when Serve returns. On Windows it creates the named pipe
// serviceconnection.C2DPipeName(socketPath) with a DACL granting only the
// current user and rejecting remote clients; a pipe of that name that already
// exists is refused rather than shared. c2d has no token auth, so this access
// restriction is the boundary: if it cannot be applied the server refuses to
// serve rather than expose an unauthenticated endpoint.
func (s *C2DServer) Serve(ctx context.Context) error {
	lis, endpoint, err := listenC2D(s.socketPath)
	if err != nil {
		return err
	}
	// Closing a unix listener unlinks its socket file; closing the pipe
	// listener closes every pipe instance.
	defer lis.Close()

	grpcServer := grpc.NewServer()
	if err := s.impl.RegisterServices(grpcServer); err != nil {
		return fmt.Errorf("c2d: failed to register services: %w", err)
	}
	healthpb.RegisterHealthServer(grpcServer, health.NewServer())

	zap.L().Info("c2d server listening", zap.String("path", endpoint))

	go func() {
		<-ctx.Done()
		gracefulStopWithTimeout(grpcServer, c2dShutdownTimeout)
	}()

	return grpcServer.Serve(lis)
}
