func newTestKey(t *testing.T) *keylib.ImmutableKey {
	t.Helper()
	protoKey, err := keylib.NewEd25519Key()
	if err != nil {
		t.Fatalf("NewEd25519Key: %v", err)
	}
	key, err := keylib.NewImmutableKey(protoKey)
	if err != nil {
		t.Fatalf("NewImmutableKey: %v", err)
	}
	return key
}

// jwkForKey builds the verifying JWK (OKP/Ed25519) for a signing key, keyed by
// the key's id (the kid Sign stamps into the token header).
func jwkForKey(t *testing.T, key *keylib.ImmutableKey) *wrapperJwk.ImmutableJwk {
	t.Helper()
	pub, ok := key.PublicKey().(ed25519.PublicKey)
	if !ok {
		t.Fatalf("expected ed25519 public key, got %T", key.PublicKey())
	}
	jwk, err := wrapperJwk.NewImmutableJwk(&jwkpb.Jwk{
		Kid: key.Proto().Id,
		Kty: keypb.KeyType_KEY_TYPE_OKP,
		Crv: "Ed25519",
		X:   libBase64.RawURLEncoding.EncodeToString(pub),
	})
	if err != nil {
		t.Fatalf("NewImmutableJwk: %v", err)
	}
	return jwk
}

// signedToken mints a token with the shared valid claims (issuer, audience,
// future expiry), applies the caller's customizations, and signs it with key.
func signedToken(t *testing.T, key *keylib.ImmutableKey, customize func(*tokenlib.TokenWrapper)) string {
	t.Helper()
	tok := tokenlib.NewImmutableToken(nil).
		SetIssuer("test-issuer").
		SetAudience(serviceName).
		SetExpiration(time.Now().Add(time.Hour).Unix()).
		SetNamespace("/tenants/acme")
	customize(tok)
	if err := tok.Sign(key); err != nil {
		t.Fatalf("Sign: %v", err)
	}
	return tok.GetBase64()
}

func bearerCtx(token string) context.Context {
	md := metadata.Pairs("authorization", "Bearer "+token)
	return metadata.NewIncomingContext(context.Background(), md)
}

// authorizerWithKeys builds an Authorizer (no live JWK-view conn) seeded with the
// given verifying keys.
func authorizerWithKeys(t *testing.T, jwks ...*wrapperJwk.ImmutableJwk) *authorizer {
	t.Helper()
	a, err := NewAuthorizer(context.Background(), nil)
	if err != nil {
		t.Fatalf("NewAuthorizer: %v", err)
	}
	a.JwkCache().Load(jwks)
	return a
}

const testMethod = "/demo.DemoService/DoThing"

// testMethodKey is the service-qualified key the Authorizer derives from
// testMethod, and the key a generated wrapper registers policy under.
const testMethodKey = "demo.DemoService/DoThing"

func serviceToken(caller string) func(*tokenlib.TokenWrapper) {
	return func(tok *tokenlib.TokenWrapper) {
		tok.SetSubType("service").SetSubject(caller)
	}
}

// A valid, correctly-signed service token whose caller matches the method's
// auth_services pattern is authorized.
func TestAuthorizerAcceptsValidServiceToken(t *testing.T) {
	key := newTestKey(t)
	a := authorizerWithKeys(t, jwkForKey(t, key))
	a.SetMethodAuth(testMethodKey, []string{"caller-svc"})

	tok := signedToken(t, key, serviceToken("caller-svc"))
	if err := a.Authorize(bearerCtx(tok), testMethod, nil); err != nil {
		t.Fatalf("valid service token must be authorized, got: %v", err)
	}
}

// A service caller that does not match the method's auth_services pattern is
// denied.
func TestAuthorizerRejectsServiceNotInAuthServices(t *testing.T) {
	key := newTestKey(t)
	a := authorizerWithKeys(t, jwkForKey(t, key))
	a.SetMethodAuth(testMethodKey, []string{"allowed-svc"})

	tok := signedToken(t, key, serviceToken("other-svc"))
	if err := a.Authorize(bearerCtx(tok), testMethod, nil); err == nil {
		t.Fatal("service not in auth_services must be denied")
	}
}

// An auth_services pattern containing alternation must still match the WHOLE
// caller identity. Anchoring as "^"+p+"$" is wrong: `|` binds looser than the
// anchors, so "billing|payments" would compile to "^billing|payments$" —
// "starts with billing, OR ends with payments" — and admit callers like
// "evil-payments" or "billing-but-not-really". The pattern is wrapped in a
// non-capturing group so the anchors apply to the whole alternation.
func TestAuthorizerAlternationPatternIsFullyAnchored(t *testing.T) {
	key := newTestKey(t)

	for _, caller := range []string{"billing", "payments"} {
		a := authorizerWithKeys(t, jwkForKey(t, key))
		a.SetMethodAuth(testMethodKey, []string{"billing|payments"})
		tok := signedToken(t, key, serviceToken(caller))
		if err := a.Authorize(bearerCtx(tok), testMethod, nil); err != nil {
			t.Fatalf("caller %q exactly matches an alternation branch and must be authorized, got: %v", caller, err)
		}
	}

	for _, caller := range []string{"evil-payments", "billing-but-not-really"} {
		a := authorizerWithKeys(t, jwkForKey(t, key))
		a.SetMethodAuth(testMethodKey, []string{"billing|payments"})
		tok := signedToken(t, key, serviceToken(caller))
		if err := a.Authorize(bearerCtx(tok), testMethod, nil); err == nil {
			t.Fatalf("caller %q only partially matches an alternation branch and must be denied", caller)
		}
	}
}

