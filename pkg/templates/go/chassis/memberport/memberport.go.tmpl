// verifyPeer verifies a peer's token. It refuses anything but a kernel-signed,
// unexpired service token with this port's audience (UNAUTHENTICATED
// otherwise) for this same service in this same namespace (PERMISSION_DENIED
// otherwise).
func (p *MemberPort) verifyPeer(token string) (admitted, error) {
	if token == "" {
		return admitted{}, refused("no token")
	}
	tw, err := tokenlib.ParseToken(token)
	if err != nil {
		return admitted{}, refused("malformed token")
	}
	var jwk *wrapperJwk.ImmutableJwk
	if kid := tw.GetKid(); kid != "" {
		jwk = p.jwks(kid)
	}
	if jwk == nil {
		return admitted{}, refused("token signed by an unknown key")
	}
	if err := tw.Verify(jwk); err != nil {
		return admitted{}, refused("token verification failed: %v", err)
	}
	use := tw.GetTokenUse()
	if !(use == "" || use == "service" || use == "access") || (use == "" && tw.GetCustomField("typ") == "refresh") {
		return admitted{}, refused("%s tokens cannot open a member stream", use)
	}
	// No clock-skew allowance past exp: Verify allows some, a member stream none.
	exp := time.Unix(tw.GetExpiration(), 0)
	if !time.Now().Before(exp) {
		return admitted{}, refused("token has expired")
	}
	if tw.GetAudience() != p.audience {
		return admitted{}, refused("token audience %q is not %q", tw.GetAudience(), p.audience)
	}
	if tw.GetSubType() != "service" {
		return admitted{}, refused("token is not a service token")
	}
	peerService, err := tw.ServicePath()
	if err != nil {
		return admitted{}, refused("token identity: %v", err)
	}
	peerNamespace, err := tw.NamespacePath()
	if err != nil {
		return admitted{}, refused("token identity: %v", err)
	}
	if peerService != p.serviceLabel {
		return admitted{}, denied("token is for service %q, not %q", peerService, p.serviceLabel)
	}
	own, err := p.namespace()
	if err != nil {
		return admitted{}, err
	}
	if own != peerNamespace {
		return admitted{}, denied("token is for namespace %q, this member is in %q", peerNamespace, own)
	}
	return admitted{subject: peerService + "@" + peerNamespace, exp: exp}, nil
}

// namespace is this instance's namespace, read once from its own member
// token: it never changes.
func (p *MemberPort) namespace() (string, error) {
	if ns := p.ownNamespace.Load(); ns != nil {
		return *ns, nil
	}
	token, err := p.tokens()
	if err != nil {
		return "", denied("this member has no token to compare a peer with: %v", err)
	}
	tw, err := tokenlib.ParseToken(token)
	if err != nil {
		return "", denied("this member's own token does not parse: %v", err)
	}
	ns, err := tw.NamespacePath()
	if err != nil {
		return "", denied("this member's own token: %v", err)
	}
	p.ownNamespace.Store(&ns)
	return ns, nil
}

// verifyPeerCertificate checks the receiver's certificate SAN: a service
// SPIFFE ID of this trust domain for this service, in this instance's own
// tenant when it is tenant-owned, and in the platform (/system) tree
// otherwise, compared with the location-agnostic service-path relation.
func (p *MemberPort) verifyPeerCertificate(leaf *x509.Certificate) error {
	own, err := p.namespace()
	if err != nil {
		return fmt.Errorf("member port: %w", err)
	}
	tenantOwned := strings.HasPrefix(own, "/"+wrapperSpiffe.TenantsSegment+"/")
	for _, uri := range leaf.URIs {
		if uri == nil || uri.Scheme != wrapperSpiffe.Scheme {
			continue
		}
		parsed, err := wrapperSpiffe.ParseSpiffeID(uri.String())
		if err != nil {
			continue
		}
		if parsed.SubjectKind != wrapperSpiffe.KindService || parsed.TrustDomain != p.trustDomain || parsed.SubjectPath != p.serviceLabel {
			continue
		}
		ns, err := wrapperSpiffe.NormalizeNamespace(parsed.Namespace)
		if err != nil {
			continue
		}
		if tenantOwned && own == ns || !tenantOwned && wrapperSpiffe.IsAtOrBelow("/"+wrapperSpiffe.SystemSegment, ns) {
			return nil
		}
	}
	where := "/" + wrapperSpiffe.SystemSegment
	if tenantOwned {
		where = own
	}
	return fmt.Errorf("member port: the peer certificate does not name service %s in %s of trust domain %s", p.serviceLabel, where, p.trustDomain)
}

