class EventBusSink:
    """EventBusSink is the durable accounting backend. It flattens the
    Emitter's typed event dict into the stored AccountingRecord and hands it
    to the generated per-topic publisher's queue. The record carries the
    call's typed outcome, reason, code and metrics, never an error text
    (tacplus#273).

    SEND CONTRACT — NEVER HOLDS THE RPC (issue #34). Emit hands the record to
    the bounded queue, which is the spool: the publish stream drains it, in
    order, once the event bus is reachable, so an outage costs the RPC nothing
    and the records written during it replay. A record is dropped only when the
    spool is full, and each drop is counted and logged at ERROR with the
    running total.
    """

    def __init__(self, queue: Any, source_id: str) -> None:
        self._queue = queue
        self._source_id = source_id
        self._seq = itertools.count(1)
        self._ingested = 0
        self._dropped = 0

    def _next_accounting_id(self, timestamp_ms: int) -> str:
        return f"{self._source_id}-{timestamp_ms:013d}-{next(self._seq):012d}"

    def _flatten(self, event: Dict[str, Any]):
        method = None
        code = 0
        duration_ms = 0
        outcome: Any = 0
        reason: Any = 0
        records_returned = 0
        bytes_moved = 0
        if "rpc_completed" in event:
            p = event["rpc_completed"]
            m = p.get("metrics") or {}
            method = p.get("method")
            code = p.get("code", 0)
            duration_ms = p.get("duration_ms", 0)
            # Enum names: the proto constructor takes them as values.
            outcome = p.get("outcome", 0)
            reason = p.get("reason", 0)
            records_returned = m.get("records_returned", 0)
            bytes_moved = m.get("bytes", 0)

        timestamp_ms = event.get("timestamp_ms", 0)
        identity = event.get("identity") or {}
        return accountingrecord_pb.AccountingRecord(
            accounting_id=self._next_accounting_id(timestamp_ms),
            request_id=event.get("request_id", ""),
            source_id=event.get("source_id", "") or self._source_id,
            timestamp_ms=timestamp_ms,
            level=event.get("level", 0),
            method=method_label(method),
            code=code,
            duration_ms=duration_ms,
            # The principal a verified token/mTLS identity resolved to, not a
            # caller-supplied header. See item 9's identity ruling.
            principal_sub=identity.get("sub", ""),
            spiffe_id=identity.get("spiffe_id", ""),
            outcome=outcome,
            reason=reason,
            records_returned=records_returned,
            bytes=bytes_moved,
        )

    def emit(self, event: Dict[str, Any]) -> None:
        record = self._flatten(event)
        try:
            self._queue.put_nowait(record)
            self._ingested += 1
        except asyncio.QueueFull:
            self._dropped += 1
            logger.error(
                "accounting spool full; record dropped: %s dropped_total=%d",
                record.accounting_id,
                self._dropped,
            )

    def stats(self) -> SinkStats:
        """Returns the pipeline's health as counters, never as records: how
        many records the spool accepted and dropped, and how many it holds."""
        return SinkStats(ingested=self._ingested, dropped=self._dropped, depth=self._queue.qsize())
