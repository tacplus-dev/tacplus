fn parse_endpoints(xml: &str, element: &str) -> Vec<SamlEndpoint> {
    let open = format!("<md:{} ", element);
    let mut out = Vec::new();
    let mut pos = 0;
    while let Some(s) = xml[pos..].find(&open) {
        let s = s + pos;
        let binding  = extract_attr(&xml[s..], "Binding").unwrap_or_default();
        let location = extract_attr(&xml[s..], "Location").unwrap_or_default();
        out.push(SamlEndpoint { binding, location, index: 0 });
        pos = s + open.len();
    }
    out
}

fn parse_indexed_endpoints(xml: &str, element: &str) -> Vec<SamlEndpoint> {
    let open = format!("<md:{} ", element);
    let mut out = Vec::new();
    let mut pos = 0;
    while let Some(s) = xml[pos..].find(&open) {
        let s = s + pos;
        let binding  = extract_attr(&xml[s..], "Binding").unwrap_or_default();
        let location = extract_attr(&xml[s..], "Location").unwrap_or_default();
        let index    = extract_attr(&xml[s..], "index")
            .or_else(|| extract_attr(&xml[s..], "Index"))
            .and_then(|v| v.parse::<u32>().ok())
            .unwrap_or(0);
        out.push(SamlEndpoint { binding, location, index });
        pos = s + open.len();
    }
    out
}

fn parse_signing_cert(xml: &str) -> Option<Vec<u8>> {
    // Prefer KeyDescriptor use="signing", fall back to any KeyDescriptor
    let signing_pos = xml.find("use=\"signing\"")
        .or_else(|| xml.find("KeyDescriptor"));
    let pos = signing_pos?;

    // Find <ds:X509Certificate> after this position
    let x509_open  = "<ds:X509Certificate>";
    let x509_close = "</ds:X509Certificate>";
    let cert_start = xml[pos..].find(x509_open)? + pos + x509_open.len();
    let cert_end   = xml[cert_start..].find(x509_close)? + cert_start;

    let b64 = xml[cert_start..cert_end].replace([' ', '\n', '\r', '\t'], "");
    general_purpose::STANDARD.decode(&b64).ok()
}

/// Produce a `<md:KeyDescriptor>` block embedding the cert DER as base64.
fn write_key_descriptor(der: &[u8], use_attr: &str) -> String {
    let b64 = general_purpose::STANDARD.encode(der);
    format!(
        "<md:KeyDescriptor use=\"{use}\">\
         <ds:KeyInfo xmlns:ds=\"http://www.w3.org/2000/09/xmldsig#\">\
           <ds:X509Data>\
             <ds:X509Certificate>{b64}</ds:X509Certificate>\
           </ds:X509Data>\
         </ds:KeyInfo>\
         </md:KeyDescriptor>",
        use = use_attr,
        b64 = b64,
    )
}

fn extract_attr(xml: &str, attr: &str) -> Option<String> {
    let search_dq = format!("{}=\"", attr);
    let search_sq = format!("{}='", attr);
    let (start, delim) = if let Some(pos) = xml.find(&search_dq) {
        (pos + search_dq.len(), '"')
    } else if let Some(pos) = xml.find(&search_sq) {
        (pos + search_sq.len(), '\'')
    } else {
        return None;
    };
    xml[start..].find(delim).map(|end| xml[start..start + end].to_string())
}

fn xml_escape(s: &str) -> String {
    s.replace('&', "&amp;")
     .replace('<', "&lt;")
     .replace('>', "&gt;")
}

fn xml_escape_attr(s: &str) -> String {
    xml_escape(s).replace('"', "&quot;")
}
