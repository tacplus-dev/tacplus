    // accounting record is never silently discarded.
    const queue: {{.AccountingEventTypeName}}[] = [];
    const signal = this.abortController.signal;
    let waiter: { resolve: () => void; reject: (err: Error) => void } | null = null;

    signal.addEventListener('abort', () => {
      const w = waiter;
      waiter = null;
      if (w) w.reject(new Error('accounting publisher aborted'));
    }, { once: true });

    const take = async (): Promise<{{.AccountingEventTypeName}}> => {
      while (queue.length === 0) {
        if (signal.aborted) throw new Error('accounting publisher aborted');
        await new Promise<void>((resolve, reject) => {
          waiter = { resolve, reject };
        });
      }
      return queue.shift()!;
    };

    this.trackTask('accounting publisher', this.accountingPublishResolveLoop(take, signal));

    const wake = () => {
      const w = waiter;
      waiter = null;
      if (w) w.resolve();
    };
    const sink = new EventBusSink(queue, this.instanceId, wake);
    return new Emitter(this.instanceId, sink);
  }

  private async accountingPublishResolveLoop(take: () => Promise<{{.AccountingEventTypeName}}>, signal: AbortSignal): Promise<void> {
    let backoff = 3000;
    const maxBackoff = 30000;
    while (!signal.aborted) {
      try {
        const ebConn = await this.resolveService('{{.AccountingPublisherTarget}}', signal);
        await this.accountingPublishLoop(ebConn, take, signal);
        return;
      } catch (err) {
        if (signal.aborted) return;
        console.warn(`accounting publisher: failed to resolve eventbus, retrying in ${backoff}ms: ${err}`);
        await this.sleep(backoff, signal);
        backoff = Math.min(backoff * 2, maxBackoff);
      }
    }
  }

  private async accountingPublishLoop(
    ebConn: grpc.Client,
    take: () => Promise<{{.AccountingEventTypeName}}>,
    signal: AbortSignal,
  ): Promise<void> {
    let backoff = 3000;
    const maxBackoff = 30000;
    while (!signal.aborted) {
      try {
        await this.accountingPublishStream(ebConn, take, signal);
        return;
      } catch (err) {
        if (signal.aborted) return;
        console.warn(`accounting publish stream failed, reconnecting in ${backoff}ms: ${err}`);
        await this.sleep(backoff, signal);
        backoff = Math.min(backoff * 2, maxBackoff);
      }
    }
  }

  private async accountingPublishStream(
    ebConn: grpc.Client,
    take: () => Promise<{{.AccountingEventTypeName}}>,
    signal: AbortSignal,
  ): Promise<void> {
    const token = await this.identity.getTokenFor('{{.AccountingPublisherTarget}}');
    const metadata = new grpc.Metadata();
    metadata.set('authorization', `Bearer ${token}`);
    const stream = ebConn.makeBidiStreamRequest<{{.AccountingEventTypeName}}, unknown>(
      '{{.AccountingPublishGrpcPath}}',
      (msg: {{.AccountingEventTypeName}}) => Buffer.from(toBinary({{.AccountingEventTypeName}}Schema, msg)),
      (buf: Buffer) => fromBinary(AccountingEmptySchema, new Uint8Array(buf)),
      metadata,
    );
    stream.on('data', () => { /* ack ignored */ });
    const onAbortCancel = () => {
      try { stream.cancel(); } catch { /* no-op */ }
    };
    signal.addEventListener('abort', onAbortCancel, { once: true });

    const closed = new Promise<never>((_resolve, reject) => {
      stream.on('error', (err) => reject(err));
      stream.on('end', () => reject(new Error('accounting publish stream ended')));
      stream.on('close', () => reject(new Error('accounting publish stream closed')));
    });
    closed.catch(() => { /* observed via Promise.race */ });

    try {
      while (!signal.aborted) {
        const record = await Promise.race([take(), closed]);
        if (!stream.write(record)) {
          let cleanup = () => { /* no-op */ };
          try {
            await Promise.race([
              new Promise<void>((resolve, reject) => {
                const onDrain = () => resolve();
                const onAbort = () => reject(new Error('accounting publisher aborted'));
                cleanup = () => {
                  stream.removeListener('drain', onDrain);
                  signal.removeEventListener('abort', onAbort);
                };
                stream.once('drain', onDrain);
                signal.addEventListener('abort', onAbort, { once: true });
              }),
              closed,
            ]);
          } finally {
            cleanup();
          }
        }
      }
    } finally {
      signal.removeEventListener('abort', onAbortCancel);
      try { stream.cancel(); } catch { /* no-op */ }
    }
  }
{{- end}}
{{- end}}

  /** Releases all resources. Use when not calling run(). */
  close(): void {
    this._ready = false;
    this.abortController.abort();
{{- if .HasStates}}
    this._stateClients.close();
{{- end}}
{{- if .HasGrpcS2SClients}}
{{- range .TargetServices}}
{{- if ne .ServiceID $.StateStoreServiceID}}
    this._sc_{{.AccessorName}}.close();
{{- end}}
{{- end}}
{{- end}}
      this.stateStoreConn.close();
    this.identity.close();
  }

  /**
   * Starts the service lifecycle with the given handler.
   *
   * Creates a TLS-enabled gRPC server using auto-obtained X509Mint certs,
   * wraps handler implementations with validation/authorization, registers
   * all services, and serves until shutdown signal.
   */
  async run(handler: Handler): Promise<void> {
    console.log('ServiceManager starting');

{{- if .HasGrpc}}
    // Build TLS credentials from auto-obtained X509Mint certs.
    let serverCreds: grpc.ServerCredentials;
    const certChain = this._tlsCertChain;
    const privateKey = this._tlsPrivateKey;

      if (certChain && privateKey) {
      const certPem = certChainToPem(certChain);

      // Convert private key DER to PEM
      const keyPem = Buffer.from(
        '-----BEGIN PRIVATE KEY-----\n' +
        privateKey.toString('base64').replace(/(.{64})/g, '$1\n') +
        '\n-----END PRIVATE KEY-----\n',
      );

      serverCreds = grpc.ServerCredentials.createSsl(null, [{
        cert_chain: certPem,
        private_key: keyPem,
      }], false);
      console.log('gRPC server configured with TLS');
    } else {
      throw new Error('gRPC server requires TLS certificate chain and private key');
    }

  {{- if .HasStates}}
      // Deliver initial per-service typed config from state and register hot-reload.
  {{- range .GrpcServices}}
  {{- if .HasConfigState}}
      {
        const configAccessor = this._stateClients.{{.ConfigStateGroupAccessor}}().{{.ConfigStateAccessor}}().config();
        const initialConfig = await configAccessor.fetch();
        await handler.{{.HandleConfigName}}(initialConfig);
        configAccessor.onChange((nextConfig) => {
          this.trackTask('{{.HandleConfigName}} config update', handler.{{.HandleConfigName}}(nextConfig));
        });
      }
  {{- end}}
  {{- end}}
  {{- end}}

      // Create gRPC server.
      const server = new grpc.Server(serverOptionsFromConfig(this.cfg));
  {{- if .HasGrpc}}
      const authorizer = new Authorizer(this.stateStoreConn.conn());
{{- end}}

    // Wrap handler implementations with validation and register services.
{{- if .HasTracePublisher}}
    const tracePublisher = this.createTracePublisher();
{{- end}}
{{- if .HasAccountingPublisher}}
    const accountingEmitter = this.createAccountingEmitter();
{{- end}}
{{- range .GrpcServices}}
    const {{.WrapperVarName}} = new {{.WrapperVarName}}Class(handler.{{.GetterName}}());
    {{.WrapperVarName}}.setInstanceId(this.instanceId);
{{- if $.HasTracePublisher}}
    {{.WrapperVarName}}.setTracePublisher(tracePublisher);
{{- end}}
{{- if and $.HasAccountingPublisher .HasAccounting}}
    {{.WrapperVarName}}.setEmitter(accountingEmitter);
{{- end}}
    {{.WrapperVarName}}.registerMethodAuth(authorizer);
    {{.WrapperVarName}}.setAuthorizeFunc((fullMethod, metadata, req) => authorizer.authorize(metadata, fullMethod, req));
    {{.WrapperVarName}}.setAuthenticateFunc((metadata, targetNamespace) => authorizer.authenticate(metadata, targetNamespace));
{{- if not .AuthDisabled}}
    if (!{{.WrapperVarName}}.hasAuthorizer()) {
      throw new Error('authorizer not wired for {{.ServiceName}} (build/SM bug) - mandatory-auth service cannot serve without an authorizer');
    }
{{- end}}
    {{.WrapperVarName}}.registerServices(server);
{{- end}}

    // Register additional services if the handler provides them.
    if (handler.registerAdditionalServices) {
      handler.registerAdditionalServices(server);
    }

    // Register gRPC health check service (grpc.health.v1.Health, unauthenticated).
    server.addService(
      {
        Check: {
          path: '/grpc.health.v1.Health/Check',
          requestStream: false, responseStream: false,
          requestSerialize: (v: Buffer) => v, requestDeserialize: (buf: Buffer) => buf,
          responseSerialize: (v: Buffer) => v, responseDeserialize: (buf: Buffer) => buf,
        },
      } as any,
      { Check: (_call: any, cb: grpc.sendUnaryData<Buffer>) => { cb(null, Buffer.from([0x08, this._ready ? 0x01 : 0x02])); } },
    );

    // Determine listen address from config (default [::]:8443).
    const listenAddr = this.cfg.listenAddress;
    const host = listenAddr?.host || '::';
    const port = listenAddr?.port || 8443;
    const addr = `${host}:${port}`;

    // Bind and start serving.
    await new Promise<void>((resolve, reject) => {
      server.bindAsync(addr, serverCreds, (err) => {
        if (err) {
          reject(err);
          return;
        }
        console.log(`gRPC server listening on ${addr}`);
        resolve();
      });
    });
{{- end}}

{{- if not .HasGrpc}}
    // No business gRPC services — start a TLS server for health checking only.
    let healthCreds: grpc.ServerCredentials;
    const healthCertChain = this._tlsCertChain;
    const healthPrivateKey = this._tlsPrivateKey;
    if (healthCertChain && healthPrivateKey) {
      const certPem = certChainToPem(healthCertChain);
      const keyPem = Buffer.from(
        '-----BEGIN PRIVATE KEY-----\n' +
        healthPrivateKey.toString('base64').replace(/(.{64})/g, '$1\n') +
        '\n-----END PRIVATE KEY-----\n',
      );
      healthCreds = grpc.ServerCredentials.createSsl(null, [{
        cert_chain: certPem,
        private_key: keyPem,
      }], false);
    } else {
      throw new Error('gRPC server requires TLS certificate chain and private key');
    }
    const healthServer = new grpc.Server(serverOptionsFromConfig(this.cfg));
    healthServer.addService(
      {
        Check: {
          path: '/grpc.health.v1.Health/Check',
          requestStream: false, responseStream: false,
          requestSerialize: (v: Buffer) => v, requestDeserialize: (buf: Buffer) => buf,
          responseSerialize: (v: Buffer) => v, responseDeserialize: (buf: Buffer) => buf,
        },
      } as any,
      { Check: (_call: any, cb: grpc.sendUnaryData<Buffer>) => { cb(null, Buffer.from([0x08, this._ready ? 0x01 : 0x02])); } },
    );
    const healthHost = this.cfg.listenAddress?.host || '::';
    const healthPort = this.cfg.listenAddress?.port || 8443;
    const healthAddr = `${healthHost}:${healthPort}`;
    await new Promise<void>((resolve, reject) => {
      healthServer.bindAsync(healthAddr, healthCreds, (err) => {
        if (err) { reject(err); return; }
        console.log(`Health-only gRPC server listening on ${healthAddr} (TLS)`);
        resolve();
      });
    });
{{- end}}

{{- if .HasServiceHealthState}}
      // Start health reporter — publishes instance health to the state store's ServiceHealthState.
      const healthConn = this.stateStoreConn.conn();
      let healthReporter: HealthReporter | null = null;
    if (healthConn) {
      const healthPublisher = new HealthPublisherAdapter(healthConn, () => this.getToken());
      const healthMetrics = buildMetricsProvider(this.cfg.listenAddress);
      healthReporter = new HealthReporter(healthPublisher, healthMetrics);
      healthReporter.setStatus(1); // INSTANCE_STATUS_HEALTHY
      if (handler.checkHealth) {
        healthReporter.setHealthChecker({ checkHealth: () => handler.checkHealth!() });
      }
      await healthReporter.startUntilFirstPublish(this.abortController.signal);
      this._ready = true;
    } else {
      throw new Error('no active state-store connection for health reporter');
    }
{{- else}}
    this._ready = true;
{{- end}}

{{- if .HasAutoTls}}
      // Start auto-TLS certificate stream.
    // Blocks until the first certificate is delivered — the service cannot serve
    // without a valid TLS cert.
    await this.startTlsCertStream(handler);
{{- end}}

{{- if .HasSmb}}
      // Start the SMB member-cert stream (SPIFFE plan D7).
    // Blocks until the first member credential is delivered — an SMB member
    // cannot join its black-box peer mesh without its per-SMB CA + member cert.
    await this.startSmbCertStream(handler);
{{- end}}

{{- if .HasSubscriptions}}
    // Start event-bus subscriptions — re-resolve the target service via
    // ServiceHealthState on every (re)connect attempt so a rescheduled instance
    // is picked up instead of retrying a dead address forever. The subscriber
    // owns and closes each resolved channel.
    const subAbort = new AbortController();
    const subPromises: Promise<void>[] = [];
    const serviceLabel = '{{.ServiceLabel}}';
{{- range .Subscriptions}}
    {
      const subscriber = new {{.SubscriberAlias}}Subscriber(
        () => this.resolveService('{{.TargetService}}', subAbort.signal),
        serviceLabel,
      );
      const p = subscriber.subscribe(
        async (event, meta) => {
          await handler.{{.HandlerMethodName}}(event, { offset: meta.offset, timestamp: meta.timestamp, key: meta.key });
        },
        subAbort.signal,
        { earliest: true },
      ).catch((err) => {
        if (!subAbort.signal.aborted) {
          console.error('{{.SourcePackage}}.{{.SourceField}} subscription fatal error:', err);
        }
      });
      subPromises.push(p);
      console.log('Started {{.SourcePackage}}.{{.SourceField}} subscription');
    }
{{- end}}
{{- end}}

    // Wait for shutdown signal.
    await new Promise<void>((resolve) => {
      process.on('SIGTERM', resolve);
      process.on('SIGINT', resolve);
    });

    console.log('Shutdown signal received, starting graceful shutdown');
    this._ready = false;

{{- if .HasSubscriptions}}
    // Cancel event-bus subscriptions.
    subAbort.abort();
    await Promise.allSettled(subPromises);
{{- end}}

{{- if .HasServiceHealthState}}
    if (healthReporter) {
      await healthReporter.close();
    }
{{- end}}

{{- if .HasGrpc}}
    // Graceful shutdown of gRPC server.
    await shutdownGrpcServer(server, shutdownTimeoutMs(this.cfg));
{{- else}}
    // Graceful shutdown of health-only gRPC server.
    await shutdownGrpcServer(healthServer, shutdownTimeoutMs(this.cfg));
{{- end}}

    await handler.shutdown();
{{- if .HasStates}}
    this._stateClients.close();
{{- end}}
{{- if .HasGrpcS2SClients}}
{{- range .TargetServices}}
{{- if ne .ServiceID $.StateStoreServiceID}}
    this._sc_{{.AccessorName}}.close();
{{- end}}
{{- end}}
{{- end}}
      this.stateStoreConn.close();
    this.identity.close();
    await this.shutdownTasks();
    console.log('Graceful shutdown complete');
  }
{{- if .HasAutoTls}}

  /**
     * Manages the bidi TLS certificate stream.
   * Generates keypairs locally, sends public keys for signing,
   * and delivers signed certs + local private keys to the handler.
   */
  private async startTlsCertStream(handler: Handler): Promise<void> {
    let firstCertResolve: (() => void) | null = null;
    let firstCertReject: ((err: Error) => void) | null = null;
    const firstCertPromise = new Promise<void>((resolve, reject) => {
      firstCertResolve = resolve;
      firstCertReject = reject;
    });

    const loop = async () => {
      let attempt = 0;
      while (!this.abortController.signal.aborted) {
        try {
          await this.runTlsCertStream(handler, (delivered: boolean) => {
            if (firstCertResolve) {
              if (delivered) {
                firstCertResolve();
              } else {
                firstCertReject!(new Error('TLS cert stream ended without delivering a certificate'));
              }
              firstCertResolve = null;
              firstCertReject = null;
            }
          });
          return;
        } catch (err) {
          if (firstCertResolve) {
            // First cert never delivered — retry with backoff instead of failing.
            attempt++;
            if (attempt >= ServiceManager.MAX_INIT_RETRIES) {
              firstCertReject!(err instanceof Error ? err : new Error(String(err)));
              firstCertResolve = null;
              firstCertReject = null;
              return;
            }
            const delay = Math.min(2 ** Math.min(attempt, 5), 30);
            console.warn(`TLS cert stream failed before first cert (attempt ${attempt}/${ServiceManager.MAX_INIT_RETRIES}), retrying in ${delay}s:`, err);
            await this.sleep(delay * 1000);
          } else {
            console.warn('TLS cert stream disconnected, retrying in 5s:', err);
            await this.sleep(5000);
          }
        }
      }
    };

    // Start the loop in the background — it runs for the lifetime of the service.
    const loopPromise = this.trackTask('TLS cert stream', loop());
    // Block until the first certificate is delivered.
    await firstCertPromise;
    // Continue the loop in the background for renewals.
    loopPromise.catch((err) => console.error('TLS cert stream loop failed:', err));
  }

  private async runTlsCertStream(handler: Handler, onFirstCert: (delivered: boolean) => void): Promise<void> {
    // Generate keypair.
{{- if eq .AutoTlsKeyType "ecdsa"}}
    const { publicKey, privateKey } = crypto.generateKeyPairSync('ec', {
      namedCurve: 'P-256',
      publicKeyEncoding: { type: 'spki', format: 'der' },
      privateKeyEncoding: { type: 'pkcs8', format: 'der' },
    });
{{- else}}
    const { publicKey, privateKey } = crypto.generateKeyPairSync('ed25519', {
      publicKeyEncoding: { type: 'spki', format: 'der' },
      privateKeyEncoding: { type: 'pkcs8', format: 'der' },
    });
{{- end}}

    const publicKeyDer = publicKey as unknown as Buffer;
    let privateKeyDer = privateKey as unknown as Buffer;

    // PEM-encode public key for proto.
    const pubPem = `-----BEGIN PUBLIC KEY-----\n${publicKeyDer.toString('base64').replace(/(.{64})/g, '$1\n')}\n-----END PUBLIC KEY-----\n`;
    const pubBase64 = Buffer.from(pubPem).toString('base64url');

    const now = Math.floor(Date.now() / 1000);
    const pubProto = {
      id: `auto-tls-${now}`,
      base64: pubBase64,
      created: now,
    };

    const hostname = (await import('os')).hostname();

    // Open bidi stream via raw gRPC call.
      const conn = this.stateStoreConn.conn();
    if (!conn) throw new Error('no connection for auto-TLS cert stream');

    // Get auth token.
    const token = await this.getToken();
    const metadata = new grpc.Metadata();
    metadata.set('authorization', `Bearer ${token}`);

    let firstCertSignalled = false;

    return new Promise<void>((resolve, reject) => {
      const stream = conn.makeBidiStreamRequest(
        '/tlscert.TlsCertService/ManageCert',
        (msg: Partial<TlsCertClientMsg>) =>
          Buffer.from(toBinary(TlsCertClientMsgSchema, create(TlsCertClientMsgSchema, msg))),
        (buf: Buffer) => fromBinary(TlsCertServerMsgSchema, new Uint8Array(buf)),
        metadata,
      );
      this.abortController.signal.addEventListener('abort', () => {
        try { stream.cancel(); } catch { /* no-op */ }
      }, { once: true });

      stream.on('data', async (serverMsg: any) => {
        if (serverMsg.msg?.case === 'cert') {
          try {
            const chain = serverMsg.msg.value.chain;
            if (!chain) {
              throw new Error('TLS cert delivery missing certificate chain');
            }
            await handler.newTlsCert(chain, new Uint8Array(privateKeyDer));
            if (!firstCertSignalled) {
              firstCertSignalled = true;
              onFirstCert(true);
            }
          } catch (e) {
            console.error('Handler newTlsCert failed:', e);
          }
        } else if (serverMsg.msg?.case === 'renew') {
          console.log('TLS cert renewal requested:', serverMsg.msg.value.reason);
{{- if eq .AutoTlsKeyType "ecdsa"}}
          const newKp = crypto.generateKeyPairSync('ec', {
            namedCurve: 'P-256',
            publicKeyEncoding: { type: 'spki', format: 'der' },
            privateKeyEncoding: { type: 'pkcs8', format: 'der' },
          });
{{- else}}
          const newKp = crypto.generateKeyPairSync('ed25519', {
            publicKeyEncoding: { type: 'spki', format: 'der' },
            privateKeyEncoding: { type: 'pkcs8', format: 'der' },
          });
{{- end}}
          privateKeyDer = newKp.privateKey as unknown as Buffer;
          const newPubDer = newKp.publicKey as unknown as Buffer;
          const newPubPem = `-----BEGIN PUBLIC KEY-----\n${newPubDer.toString('base64').replace(/(.{64})/g, '$1\n')}\n-----END PUBLIC KEY-----\n`;
          const newNow = Math.floor(Date.now() / 1000);
          stream.write({
            msg: {
              case: 'csr',
              value: {
                publicKey: {
                  id: `auto-tls-${newNow}`,
                  base64: Buffer.from(newPubPem).toString('base64url'),
                  created: newNow,
                },
              },
            },
          });
        } else if (serverMsg.msg?.case === 'error') {
          reject(new Error(`server error: ${serverMsg.msg.value}`));
        }
      });

      stream.on('error', (err: Error) => reject(err));
      stream.on('end', () => {
        if (!firstCertSignalled) {
          firstCertSignalled = true;
          onFirstCert(false);
        }
        resolve();
      });

      // Send Init.
      stream.write({
        msg: {
          case: 'init',
          value: { serviceName: '{{.ServiceLabel}}', instanceId: hostname },
        },
      });

      // Send initial Csr.
      stream.write({
        msg: {
          case: 'csr',
          value: { publicKey: pubProto },
        },
      });
    });
  }
{{- end}}
{{- if .HasSmb}}

  /**
   * Manages the bidi SMB member-cert stream (SPIFFE plan D7).
   * Generates a member keypair locally, sends the public key (CSR), and
   * delivers the signed member chain + per-SMB CA + local private key to the
   * handler. The member private key never leaves the process.
   */
  private async startSmbCertStream(handler: Handler): Promise<void> {
    let firstCertResolve: (() => void) | null = null;
    let firstCertReject: ((err: Error) => void) | null = null;
    const firstCertPromise = new Promise<void>((resolve, reject) => {
      firstCertResolve = resolve;
      firstCertReject = reject;
    });

    const loop = async () => {
      let attempt = 0;
      while (!this.abortController.signal.aborted) {
        try {
          await this.runSmbCertStream(handler, (delivered: boolean) => {
            if (firstCertResolve) {
              if (delivered) {
                firstCertResolve();
              } else {
                firstCertReject!(new Error('SMB cert stream ended without delivering a member cert'));
              }
              firstCertResolve = null;
              firstCertReject = null;
            }
          });
          return;
        } catch (err) {
          if (firstCertResolve) {
            // First member cert never delivered — retry with backoff instead of failing.
            attempt++;
            if (attempt >= ServiceManager.MAX_INIT_RETRIES) {
              firstCertReject!(err instanceof Error ? err : new Error(String(err)));
              firstCertResolve = null;
              firstCertReject = null;
              return;
            }
            const delay = Math.min(2 ** Math.min(attempt, 5), 30);
            console.warn(`SMB cert stream failed before first cert (attempt ${attempt}/${ServiceManager.MAX_INIT_RETRIES}), retrying in ${delay}s:`, err);
            await this.sleep(delay * 1000);
          } else {
            console.warn('SMB cert stream disconnected, retrying in 5s:', err);
            await this.sleep(5000);
          }
        }
      }
    };

    // Start the loop in the background — it runs for the lifetime of the service.
    const loopPromise = this.trackTask('SMB cert stream', loop());
    // Block until the first member credential is delivered.
    await firstCertPromise;
    // Continue the loop in the background for renewals.
    loopPromise.catch((err) => console.error('SMB cert stream loop failed:', err));
  }

  private async runSmbCertStream(handler: Handler, onFirstCert: (delivered: boolean) => void): Promise<void> {
    // Generate the member keypair locally; the private key never leaves the process.
{{- if eq .AutoTlsKeyType "ecdsa"}}
    const { publicKey, privateKey } = crypto.generateKeyPairSync('ec', {
      namedCurve: 'P-256',
      publicKeyEncoding: { type: 'spki', format: 'der' },
      privateKeyEncoding: { type: 'pkcs8', format: 'der' },
    });
{{- else}}
    const { publicKey, privateKey } = crypto.generateKeyPairSync('ed25519', {
      publicKeyEncoding: { type: 'spki', format: 'der' },
      privateKeyEncoding: { type: 'pkcs8', format: 'der' },
    });
{{- end}}

    const publicKeyDer = publicKey as unknown as Buffer;
    let privateKeyDer = privateKey as unknown as Buffer;

    // PEM-encode public key for proto.
    const pubPem = `-----BEGIN PUBLIC KEY-----\n${publicKeyDer.toString('base64').replace(/(.{64})/g, '$1\n')}\n-----END PUBLIC KEY-----\n`;
    const pubBase64 = Buffer.from(pubPem).toString('base64url');

    const now = Math.floor(Date.now() / 1000);
    const pubProto = {
      id: `smb-cert-${now}`,
      base64: pubBase64,
      created: BigInt(now),
    };

    const hostname = (await import('os')).hostname();

    // Open bidi stream via raw gRPC call.
    const conn = this.stateStoreConn.conn();
    if (!conn) throw new Error('no connection for SMB cert stream');

    // Get auth token.
    const token = await this.getToken();
    const metadata = new grpc.Metadata();
    metadata.set('authorization', `Bearer ${token}`);

    let firstCertSignalled = false;

    return new Promise<void>((resolve, reject) => {
      const stream = conn.makeBidiStreamRequest(
        '/smbcert.SmbCertService/ManageSmbCert',
        (msg: MessageInitShape<typeof SmbCertClientMsgSchema>) =>
          Buffer.from(toBinary(SmbCertClientMsgSchema, create(SmbCertClientMsgSchema, msg))),
        (buf: Buffer) => fromBinary(SmbCertServerMsgSchema, new Uint8Array(buf)),
        metadata,
      );
      this.abortController.signal.addEventListener('abort', () => {
        try { stream.cancel(); } catch { /* no-op */ }
      }, { once: true });

      stream.on('data', async (serverMsg: any) => {
        if (serverMsg.msg?.case === 'cert') {
          try {
            const memberChain = serverMsg.msg.value.memberChain;
            const ca = serverMsg.msg.value.ca;
            if (!memberChain) {
              throw new Error('SMB cert delivery missing member chain');
            }
            if (!ca) {
              throw new Error('SMB cert delivery missing per-SMB CA');
            }
            await handler.newSmbCert(memberChain, new Uint8Array(privateKeyDer), ca);
            if (!firstCertSignalled) {
              firstCertSignalled = true;
              onFirstCert(true);
            }
          } catch (e) {
            console.error('Handler newSmbCert failed:', e);
          }
        } else if (serverMsg.msg?.case === 'renew') {
          console.log('SMB member cert renewal requested:', serverMsg.msg.value.reason);
{{- if eq .AutoTlsKeyType "ecdsa"}}
          const newKp = crypto.generateKeyPairSync('ec', {
            namedCurve: 'P-256',
            publicKeyEncoding: { type: 'spki', format: 'der' },
            privateKeyEncoding: { type: 'pkcs8', format: 'der' },
          });
{{- else}}
          const newKp = crypto.generateKeyPairSync('ed25519', {
            publicKeyEncoding: { type: 'spki', format: 'der' },
            privateKeyEncoding: { type: 'pkcs8', format: 'der' },
          });
{{- end}}
          privateKeyDer = newKp.privateKey as unknown as Buffer;
          const newPubDer = newKp.publicKey as unknown as Buffer;
          const newPubPem = `-----BEGIN PUBLIC KEY-----\n${newPubDer.toString('base64').replace(/(.{64})/g, '$1\n')}\n-----END PUBLIC KEY-----\n`;
          const newNow = Math.floor(Date.now() / 1000);
          stream.write({
            msg: {
              case: 'csr',
              value: {
                publicKey: {
                  id: `smb-cert-${newNow}`,
                  base64: Buffer.from(newPubPem).toString('base64url'),
                  created: BigInt(newNow),
                },
              },
            },
          });
        } else if (serverMsg.msg?.case === 'error') {
          reject(new Error(`server error: ${serverMsg.msg.value}`));
        }
      });

      stream.on('error', (err: Error) => reject(err));
      stream.on('end', () => {
        if (!firstCertSignalled) {
          firstCertSignalled = true;
          onFirstCert(false);
        }
        resolve();
      });

      // Send Init.
      stream.write({
        msg: {
          case: 'init',
          value: { smbService: '{{.ServiceLabel}}', instanceId: hostname },
        },
      });

      // Send initial Csr.
      stream.write({
        msg: {
          case: 'csr',
          value: { publicKey: pubProto },
        },
      });
    });
  }
{{- end}}
}
