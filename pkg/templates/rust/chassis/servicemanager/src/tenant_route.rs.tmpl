    #[test]
    fn backstop_refuses_malformed_and_another_tenant() {
        // Tenant beta's instance since kernel#23: tid in the subject, name in
        // the namespace.
        let beta = HostIdentity::new("/tenants/beta", "spiffe://example.com/tenants/bbbbbbbb/services/crew");
        assert_eq!(beta.tenant_namespace, "/tenants/beta");
        assert_eq!(beta.tid, "bbbbbbbb");
        check_routed_tenant("tenant", "bbbbbbbb", &beta).unwrap();
        let err = check_routed_tenant("tenant", "", &beta).unwrap_err();
        assert_eq!(err.code(), tonic::Code::InvalidArgument);
        let err = check_routed_tenant("tenant", "aaaaaaaa", &beta).unwrap_err();
        assert_eq!(err.code(), tonic::Code::PermissionDenied);
        assert!(err.message().contains("routed to tenant aaaaaaaa, this instance serves tenant bbbbbbbb"), "{}", err.message());

        // An instance that serves no single tenant only checks the shape.
        for host in [
            HostIdentity::default(),
            HostIdentity::new("/system", "spiffe://example.com/system/services/crew"),
            HostIdentity::new("/system/us-east", ""),
        ] {
            assert!(host.is_shared(), "{host:?}");
            check_routed_tenant("tenant", "bbbbbbbb", &host).unwrap();
            let err = check_routed_tenant("tenant", "BBBBBBBB", &host).unwrap_err();
            assert_eq!(err.code(), tonic::Code::InvalidArgument);
        }
        assert_eq!(host_tenant_of_namespace("/tenants/beta").as_deref(), Some("beta"));
        assert_eq!(host_tenant_of_namespace("/system"), None);

        // A tenant-owned instance whose subject names no tid serves no routed
        // call: a name-form subject from before kernel#23, or a namespace that
        // merely looks like a tid, is never read as one.
        for host in [
            HostIdentity::new("/tenants/beta", "spiffe://example.com/tenants/beta/services/crew"),
            HostIdentity::new("/tenants/bbbbbbbb", "spiffe://example.com/system/services/crew"),
        ] {
            assert!(!host.is_shared(), "{host:?}");
            for tid in ["bbbbbbbb", "aaaaaaaa"] {
                let err = check_routed_tenant("tenant", tid, &host).unwrap_err();
                assert_eq!(err.code(), tonic::Code::PermissionDenied, "{host:?} routed to {tid}");
                let err = route_namespace(tid, &host).unwrap_err();
                assert_eq!(err.code(), tonic::Code::PermissionDenied, "{host:?} route namespace of {tid}");
            }
        }
        let err = check_routed_tenant(
            "tenant",
            "bbbbbbbb",
            &HostIdentity::new("/tenants/beta", "spiffe://example.com/tenants/beta/services/crew"),
        )
        .unwrap_err();
        assert!(err.message().contains("this instance's subject names no tenant id"), "{}", err.message());
    }

    // The record plane's route pin: tenant bbbbbbbb's entries live in the
    // instance's own namespace, the name its subject's tid does not spell.
    #[test]
    fn route_namespace_is_the_instance_namespace_claim() {
        let beta = HostIdentity::new("/tenants/beta", "spiffe://example.com/tenants/bbbbbbbb/services/crew");
        assert_eq!(route_namespace("bbbbbbbb", &beta).unwrap(), "/tenants/beta");
        let err = route_namespace("aaaaaaaa", &beta).unwrap_err();
        assert_eq!(err.code(), tonic::Code::PermissionDenied);
        assert!(err.message().contains("this instance does not serve tenant aaaaaaaa"), "{}", err.message());
        // A tid subject with no namespace claim names no namespace to hold to.
        let nameless = HostIdentity::new("", "spiffe://example.com/tenants/bbbbbbbb/services/crew");
        assert_eq!(route_namespace("bbbbbbbb", &nameless).unwrap_err().code(), tonic::Code::PermissionDenied);
        // A shared instance knows no tenant's name.
        let shared = HostIdentity::new("/system", "spiffe://example.com/system/services/crew");
        assert_eq!(route_namespace("aaaaaaaa", &shared).unwrap(), "/tenants/aaaaaaaa");
        assert_eq!(route_namespace("aaaaaaaa", &HostIdentity::default()).unwrap(), "/tenants/aaaaaaaa");
    }
