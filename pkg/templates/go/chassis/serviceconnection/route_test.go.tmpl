	}
}

func targetOf(t *testing.T, cp *ChannelProvider, ctx context.Context) (string, error) {
	t.Helper()
	c, err := cp.currentConn(ctx)
	if err != nil {
		return "", err
	}
	cc, ok := c.(*grpc.ClientConn)
	if !ok {
		t.Fatalf("currentConn returned %T, want *grpc.ClientConn", c)
	}
	return cc.Target(), nil
}

