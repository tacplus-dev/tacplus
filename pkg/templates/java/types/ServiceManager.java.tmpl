        long backoff = 3000;
        final long maxBackoff = 30000;
        Trace.TraceEvent pending = null;

        while (!Thread.currentThread().isInterrupted()) {
            try {
                if (pending == null) {
                    pending = queue.poll(1, TimeUnit.SECONDS);
                    if (pending == null) {
                        continue;
