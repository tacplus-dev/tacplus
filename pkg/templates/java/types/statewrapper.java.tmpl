    public static final class WatchStatus {
        private final String watchName;
        private final boolean received;
        private final boolean retrying;
        private final int nextAttempt;
        private final String reason;
        private final Throwable error;
        private final long updatedAtMillis;

        private WatchStatus(
                String watchName,
                boolean received,
                boolean retrying,
                int nextAttempt,
                String reason,
                Throwable error) {
            this.watchName = watchName;
            this.received = received;
            this.retrying = retrying;
            this.nextAttempt = nextAttempt;
            this.reason = reason;
            this.error = error;
            this.updatedAtMillis = System.currentTimeMillis();
        }

        public String watchName() { return watchName; }
        public boolean hasReceived() { return received; }
        public boolean isRetrying() { return retrying; }
        public boolean isHealthy() { return !retrying; }
        public int nextAttempt() { return nextAttempt; }
        public String reason() { return reason; }
        public Throwable error() { return error; }
        public long updatedAtMillis() { return updatedAtMillis; }
    }

    public void setWatchStatusListener(WatchStatusListener listener) {
        this.watchStatusListener = listener;
    }

    public Map<String, WatchStatus> watchStatuses() {
        synchronized (watchStatusLock) {
            return new LinkedHashMap<>(watchStatuses);
        }
