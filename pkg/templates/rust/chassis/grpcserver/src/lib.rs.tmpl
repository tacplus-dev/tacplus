impl Default for GrpcServerConfig {
    fn default() -> Self {
        Self {
            listen_address: default_listen_address(),
            tls: Some(TLSConfig::default()),
            grpc: ProtocolConfig::default(),
            rest: ProtocolConfig::default(),
            api_prefix: String::new(),
            enable_cors: false,
            cors_origins: Vec::new(),
            max_request_size: default_max_request_size(),
            request_timeout_seconds: default_request_timeout_seconds(),
            enable_metrics: false,
            enable_tracing: false,
            logger: None,
            auth_rules: Vec::new(),
            static_file_paths: HashMap::new(),
            shutdown_timeout_secs: default_shutdown_timeout(),
        }
    }
}

impl GrpcServerConfig {
    /// Load configuration from a YAML file
    pub fn from_yaml_file(path: impl Into<PathBuf>) -> Result<Self> {
        let contents = std::fs::read_to_string(path.into())?;
        Self::from_yaml_str(&contents)
    }

    /// Load configuration from a YAML string
    pub fn from_yaml_str(yaml: &str) -> Result<Self> {
        Ok(serde_yaml::from_str(yaml)?)
    }

    /// Load configuration from a JSON string
    pub fn from_json_str(json: &str) -> Result<Self> {
        Ok(serde_json::from_str(json)?)
    }

    /// Parse listen address into host and port
    pub fn parse_listen_addr(&self) -> Result<SocketAddr> {
        let addr = if self.listen_address.starts_with(':') {
            format!("0.0.0.0{}", self.listen_address)
        } else {
            self.listen_address.clone()
        };
        addr.parse()
            .map_err(|e| format!("invalid listen address '{}': {}", self.listen_address, e).into())
    }

    /// Get gRPC port with defaults
    pub fn get_grpc_port(&self) -> Result<u16> {
        if self.grpc.port != 0 {
            return Ok(self.grpc.port);
        }
        Ok(self.parse_listen_addr()?.port())
    }

    /// Get REST/HTTP port with defaults
    pub fn get_rest_port(&self) -> Result<u16> {
        if self.rest.port != 0 {
            return Ok(self.rest.port);
        }
        Ok(self.parse_listen_addr()?.port())
    }

    /// Validate configuration
    pub fn validate(&self) -> Result<()> {
        let tls_config = self.tls.as_ref()
            .ok_or("TLS configuration is required")?;
        if !tls_config.enabled {
            return Err("TLS cannot be disabled for generated gRPC/REST servers".into());
        }
        if tls_config.tls_cert.is_none() {
            return Err("TLS certificate pair is required".into());
        }

        let grpc_port = self.get_grpc_port()?;
        let rest_port = self.get_rest_port()?;

        if self.grpc.enabled && self.rest.enabled && grpc_port != rest_port {
            return Err(format!(
                "gRPC and REST must use the same TLS port for ALPN multiplexing (got gRPC={}, REST={})",
                grpc_port, rest_port
            ).into());
        }

        Ok(())
    }
}

// ============================================================================
// CORS
// ============================================================================

/// Create CORS middleware layer from configuration
pub fn create_cors_layer(config: &GrpcServerConfig) -> tower_http::cors::CorsLayer {
    use hyper::http::{header, Method, HeaderValue};
    use tower_http::cors::{Any, CorsLayer};

    let mut cors = CorsLayer::new()
        .allow_methods([
            Method::GET,
            Method::POST,
            Method::PUT,
            Method::DELETE,
            Method::OPTIONS,
            Method::PATCH,
        ])
        .allow_headers([
            header::ORIGIN,
            header::CONTENT_TYPE,
            header::AUTHORIZATION,
        ]);

    if !config.cors_origins.is_empty() {
        let origins: Vec<_> = config.cors_origins
            .iter()
            .filter_map(|origin| origin.parse::<HeaderValue>().ok())
            .collect();

        if !origins.is_empty() {
            cors = cors.allow_origin(origins);
        } else {
            tracing::warn!(
                "Failed to parse CORS origins, falling back to allow any: {:?}",
                config.cors_origins
            );
            cors = cors.allow_origin(Any);
        }
    } else {
        cors = cors.allow_origin(Any);
    }

    cors
}

