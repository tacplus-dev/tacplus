    // before "services"; for the tenant root that's exactly "/tenants/<tenant>".
    private static void classifySystem(ParsedSpiffeId p, List<String> segs) {
        int si = segs.indexOf(SERVICES_SEGMENT);
        if ((!segs.get(0).equals(SYSTEM_SEGMENT) && !segs.get(0).equals(TENANTS_SEGMENT))
                || si < 0 || si + 1 >= segs.size()) {
            throw new IllegalArgumentException(
                    "spiffe: malformed system/service identity: /" + String.join("/", segs));
        }
        p.locationPath = String.join("/", segs.subList(1, si));
        p.namespace = "/" + String.join("/", segs.subList(0, si)); // /system[/location...]
        p.subjectPath = String.join("/", segs.subList(si + 1, segs.size())); // <service>[/workloads/<child>...]
