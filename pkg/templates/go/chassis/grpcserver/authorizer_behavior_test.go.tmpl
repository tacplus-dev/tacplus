// Two DIFFERENT services hosted behind ONE Authorizer that each declare an RPC
// with the SAME bare name must keep their own auth_services. Keyed by the bare
// name ("Get"), the second registration silently overwrote the first, so
// whichever service registered last decided authorization for BOTH — a caller
// entitled to alpha.AlphaService/Get also passed for beta.BetaService/Get.
// Policy is keyed by the service-qualified identifier instead.
func TestAuthorizerKeepsPerServicePolicyForSameNamedRpc(t *testing.T) {
	const (
		alphaMethod = "/alpha.AlphaService/Get"
		betaMethod  = "/beta.BetaService/Get"
	)

	key := newTestKey(t)
	a := authorizerWithKeys(t, jwkForKey(t, key))
	// Exactly what two generated RegisterXMethodAuth functions do against the
	// one Authorizer the ServiceManager builds.
	a.SetMethodAuth(qualifiedMethodKey(alphaMethod), []string{"alpha-caller"})
	a.SetMethodAuth(qualifiedMethodKey(betaMethod), []string{"beta-caller"})

	alphaTok := signedToken(t, key, serviceToken("alpha-caller"))
	betaTok := signedToken(t, key, serviceToken("beta-caller"))

	// Each caller is authorized for its OWN service's Get.
	if err := a.Authorize(bearerCtx(alphaTok), alphaMethod, nil); err != nil {
		t.Fatalf("alpha-caller must be authorized for %s, got: %v", alphaMethod, err)
	}
	if err := a.Authorize(bearerCtx(betaTok), betaMethod, nil); err != nil {
		t.Fatalf("beta-caller must be authorized for %s, got: %v", betaMethod, err)
	}

	// And is denied on the OTHER service's identically named Get.
	if err := a.Authorize(bearerCtx(alphaTok), betaMethod, nil); err == nil {
		t.Fatalf("alpha-caller must be denied for %s: auth_services do not cross services", betaMethod)
	}
	if err := a.Authorize(bearerCtx(betaTok), alphaMethod, nil); err == nil {
		t.Fatalf("beta-caller must be denied for %s: auth_services do not cross services", alphaMethod)
	}
}

// The same collision reaches target_namespace_field: two co-hosted services
// declaring the same RPC name must not inherit each other's namespace-field
// registration. Only alpha's Get names a target field; beta's must stay
// unguarded rather than picking up alpha's field name (or vice versa).
func TestAuthorizerKeepsPerServiceTargetNamespaceFieldForSameNamedRpc(t *testing.T) {
	const (
		alphaMethod = "/alpha.AlphaService/Get"
		betaMethod  = "/beta.BetaService/Get"
	)

	key := newTestKey(t)
	a := authorizerWithKeys(t, jwkForKey(t, key))
	a.SetMethodAuth(qualifiedMethodKey(alphaMethod), []string{"caller-svc"})
	a.SetMethodAuth(qualifiedMethodKey(betaMethod), []string{"caller-svc"})
	a.SetMethodTargetNamespaceField(qualifiedMethodKey(alphaMethod), "tenant_namespace")

	if got := a.methodTargetNamespaceField[qualifiedMethodKey(betaMethod)]; got != "" {
		t.Fatalf("beta.BetaService/Get must have no target_namespace_field, got %q from alpha's registration", got)
	}
	if got := a.methodTargetNamespaceField[qualifiedMethodKey(alphaMethod)]; got != "tenant_namespace" {
		t.Fatalf("alpha.AlphaService/Get must keep its own target_namespace_field, got %q", got)
	}

	// A nil request would fail alpha's field lookup; beta's Get, carrying no
	// registration of its own, must authorize on auth_services alone.
	tok := signedToken(t, key, serviceToken("caller-svc"))
	if err := a.Authorize(bearerCtx(tok), betaMethod, nil); err != nil {
		t.Fatalf("beta.BetaService/Get must not inherit alpha's target_namespace_field, got: %v", err)
	}
}

// qualifiedMethodKey reduces both full-method shapes the generated wrappers
// produce — with and without the routing parent segment — to the same
// service-qualified key, so a wrapper's registration matches at lookup time.
func TestQualifiedMethodKeyShapes(t *testing.T) {
	for _, tc := range []struct {
		full string
		want string
	}{
		{"/demo.DemoService/DoThing", "demo.DemoService/DoThing"},
		{"/services/demo.DemoService/DoThing", "demo.DemoService/DoThing"},
		{"/vservices/demo.DemoService/DoThing", "demo.DemoService/DoThing"},
		{"/DemoService/DoThing", "DemoService/DoThing"},
		{"DoThing", "DoThing"},
	} {
		if got := qualifiedMethodKey(tc.full); got != tc.want {
			t.Errorf("qualifiedMethodKey(%q) = %q, want %q", tc.full, got, tc.want)
		}
	}
}
