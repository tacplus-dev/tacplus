/// Parses comma-separated string into Vec of enum values
pub fn parse_multiple(s: &str) -> Result<Vec<Self>, String> {
s.split(',')
.map(|part| part.trim())
.filter(|part| !part.is_empty())
.map(|part| Self::from_str(part))
.collect()
}
/// Parses a string liberally, accepting:
/// - Integer values (as string)
/// - Enum names in any case (with _ or - separators)
/// - Canonical proto names (e.g., "LEVEL_DEBUG")
/// Returns default variant for empty or unrecognized input.
pub fn parse_liberal(s: &str) -> Self {
if s.is_empty() {
return Self::default();
}
if let Ok(num) = s.parse::<i32>() {
return Self::try_from(num).unwrap_or_default();
}
if let Some(v) = Self::from_str_name(s) {
return v;
}
Self::from_str(s).unwrap_or_default()
}
/// Parses a string to the i32 representation used by prost.
/// Accepts enum names, proto names, and integer values.
pub fn parse_i32(s: &str) -> Result<i32, String> {
if s.is_empty() {
return Ok(0);
}
if let Ok(num) = s.parse::<i32>() {
return Ok(num);
}
if let Some(v) = Self::from_str_name(s) {
return Ok(v as i32);
}
Self::from_str(s).map(|v| v as i32)
}
/// Converts an i32 prost enum value to its string representation.
pub fn to_string_value(v: i32) -> String {
match Self::try_from(v) {
Ok(e) => format!("{}", e),
Err(_) => format!("{}", v),
}
}
