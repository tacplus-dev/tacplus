def {{.FuncPrefix}}_save_yaml(msg: {{.QualifiedType}}, filename: str) -> None:
    """Saves {{.TypeName}} to YAML file.

    Requires: pip install PyYAML

    Args:
        msg: Message to save
        filename: Path to YAML file

    Raises:
