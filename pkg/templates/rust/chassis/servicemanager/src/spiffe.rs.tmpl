/// Parses a PEM bundle (concatenated CA certs) into a `RootCertStore`. Returns
/// the count of certs that were successfully added.
pub fn build_root_store(pem_bundle: &str) -> (rustls::RootCertStore, usize) {
    let mut roots = rustls::RootCertStore::empty();
    let mut reader = pem_bundle.as_bytes();
    let mut added = 0usize;
    for cert in rustls_pemfile::certs(&mut reader) {
        if let Ok(c) = cert {
            if roots.add(c).is_ok() {
                added += 1;
            }
        }
    }
    (roots, added)
}

