{{range .GrpcServices}}
{{if .HasConfigState}}
// Fetch initial typed config for {{.ConfigTypeAlias}}.
{{if .IsFirstConfigUse -}}
{{.ConfigHolderVar}} := sm.bc.{{.ConfigStateGroupAccessor}}().{{.ConfigStateAccessor}}()
{{.TypedConfigVar}}, err := {{.ConfigHolderVar}}.Config().Fetch(sm.ctx)
{{- else -}}
{{.ConfigHolderVar}} = sm.bc.{{.ConfigStateGroupAccessor}}().{{.ConfigStateAccessor}}()
{{.TypedConfigVar}}, err = {{.ConfigHolderVar}}.Config().Fetch(sm.ctx)
{{- end}}
if err != nil {
return fmt.Errorf("fetch {{.ConfigTypeAlias}} config: %w", err)
}
{{.ConfigTypeAlias}}.ConfigDefaults({{.TypedConfigVar}})
if err := h.{{.HandleConfigName}}({{.TypedConfigVar}}); err != nil {
return fmt.Errorf("initial {{.ConfigTypeAlias}} config: %w", err)
}
{{.ConfigHolderVar}}.Config().OnChange(func(newCfg *{{.ConfigTypeAlias}}.Config) {
{{.ConfigTypeAlias}}.ConfigDefaults(newCfg)
if err := h.{{.HandleConfigName}}(newCfg); err != nil {
zap.L().Error("{{.HandleConfigName}} failed on update", zap.Error(err))
}
})
