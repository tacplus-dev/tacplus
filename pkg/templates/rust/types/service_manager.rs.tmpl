    /// Every other publisher hands out `Fn(T) -> Result<(), TrySendError<T>>`,
    /// which drops on a full queue and reports it. Accounting must not drop: an
    /// audit trail with silent holes is worse than a slow RPC, so the sink owns
    /// the Sender and awaits `send`, applying backpressure to the emitting RPC
    /// instead. The queue is deeper than the trace queue for the same reason —
    /// a brief publisher stall should absorb, not stall callers.
    async fn create_accounting_publisher_sender(&self) -> tokio::sync::mpsc::Sender<{{.EventTypeName}}> {
        const ACCOUNTING_QUEUE_DEPTH: usize = 1024;
        let ({{.VarPrefix}}_tx, {{.VarPrefix}}_rx) =
            tokio::sync::mpsc::channel::<{{.EventTypeName}}>(ACCOUNTING_QUEUE_DEPTH);
        let {{.VarPrefix}}_im = self.identity.clone();
        let {{.VarPrefix}}_tp: TokenProvider = Arc::new(move || {
            let im = {{.VarPrefix}}_im.clone();
            Box::pin(async move {
                im.get_token_for("{{.TargetService}}").await.map_err(|e| -> Box<dyn std::error::Error + Send + Sync> {
                    e.to_string().into()
                })
            })
        });
        let {{.VarPrefix}}_identity = self.identity.clone();
        let {{.VarPrefix}}_tls_config = self.tls_config.clone();
        let {{.VarPrefix}}_state_store_conn = self.state_store_conn.conn().await;
        self.spawn_owned(async move {
            {{.LoopFn}}(
                "{{.Label}}",
                "{{.TargetService}}",
                {{.VarPrefix}}_state_store_conn,
                {{.VarPrefix}}_identity.clone(),
                {{.VarPrefix}}_tls_config,
                {{.VarPrefix}}_tp,
                {{.VarPrefix}}_rx,
            ).await;
        });
