{{- /* Python undefaults template */ -}}
# ---- Undefaults ----
{{- range .Defaults}}

def {{.FuncName}}_undefaults(msg: {{.QualifiedType}}) -> None:
    """Resets {{.TypeName}} fields that match defaults back to zero for minimal persistence."""
    if msg is None:
        return
{{- range .Fields}}
{{- if eq .AnnKey "default_string"}}
    if {{pyGet "msg" .PyFieldName}} == {{.ConstantName}}:
        {{pySet "msg" .PyFieldName "\"\""}}
{{- else if eq .AnnKey "default_int"}}
    if {{pyGet "msg" .PyFieldName}} == {{.ConstantName}}:
        {{pySet "msg" .PyFieldName "0"}}
{{- else if eq .AnnKey "default_float"}}
    if {{pyGet "msg" .PyFieldName}} == {{.ConstantName}}:
        {{pySet "msg" .PyFieldName "0.0"}}
{{- else if eq .AnnKey "default_bool"}}
    if {{pyGet "msg" .PyFieldName}} == {{.ConstantName}}:
        {{pySet "msg" .PyFieldName "False"}}
{{- else if eq .AnnKey "default_host"}}
    if msg.HasField("{{.ProtoFieldName}}") and {{pyGet "msg" .PyFieldName}}.host == "{{.HostHost}}" and {{pyGet "msg" .PyFieldName}}.port == {{.HostPort}}:
        msg.ClearField("{{.ProtoFieldName}}")
{{- end}}
{{- end}}
{{- range .SubMsgCalls}}
{{- if .HasDefaults}}
    if msg.HasField("{{.HasFieldName}}"):
        {{.FuncName}}_undefaults({{pyGet "msg" .PyFieldName}})
{{- end}}
{{- end}}
{{- if and (eq (len .Fields) 0) (eq (len .SubMsgCalls) 0)}}
    pass
{{- end}}
{{- end}}
