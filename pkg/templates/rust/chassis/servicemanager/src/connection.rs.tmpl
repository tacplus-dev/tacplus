    }

    /// Platform (single-pool) reconcile.
    async fn reconcile_endpoints(&self, instances: &[&ServiceInstanceHealth]) {
        // Build incoming target→health map
        let mut incoming: HashMap<String, &ServiceInstanceHealth> = HashMap::new();
        for inst in instances {
            if let Some(ep) = &inst.grpc_endpoint {
                if !ep.host.is_empty() && ep.port > 0 {
                    let target = format!("{}:{}", ep.host, ep.port);
                    incoming.insert(target, inst);
                }
            }
        }

        let mut ep_list = self.endpoints.write().await;

        // Build current target set
        let mut current: HashSet<String> = HashSet::new();
        for ec in ep_list.iter() {
            current.insert(ec.read().await.target.clone());
        }

        // Partition: keep (update health) vs close
        let mut kept = Vec::new();
        for ec in ep_list.drain(..) {
            let target = ec.read().await.target.clone();
            if let Some(h) = incoming.get(&target) {
                // Update health from state
                let mut conn = ec.write().await;
                conn.absent_polls = 0;
                conn.update_health_from_state(h.status, h.p50_latency_us).await;
                drop(conn);
                kept.push(ec);
            } else {
                // Absent. Kept, with its last health, until ABSENT_POLLS_BEFORE_CLOSE
                // snapshots in a row omit it.
                let mut conn = ec.write().await;
                conn.absent_polls += 1;
                if conn.absent_polls < ABSENT_POLLS_BEFORE_CLOSE {
                    drop(conn);
                    kept.push(ec);
                } else {
                    drop(conn);
                    info!(service = %self.service_id, target = %target, "closing removed endpoint");
                }
            }
        }

        // Connect to new endpoints
        for (target, h) in &incoming {
            if current.contains(target) {
                continue;
            }
            if h.status == InstanceStatus::Unhealthy as i32 {
                continue;
            }
            let ec = Arc::new(RwLock::new(EndpointConn::new(target.clone())));
            {
                let mut conn = ec.write().await;
                match conn.dial(self.verifier.clone()).await {
                    Ok(()) => {
                        conn.update_health_from_state(h.status, h.p50_latency_us).await;
                        drop(conn);
                        info!(service = %self.service_id, target = %target, "connected to new endpoint");
                        kept.push(ec);
                    }
                    Err(e) => {
                        warn!(service = %self.service_id, target = %target, error = %e, "failed to connect");
                    }
                }
            }
        }

        *ep_list = kept;

        // Reselect active
        Self::do_select_active(&ep_list, &self.active_idx).await;
    }

    /// Selects the lowest-latency healthy endpoint as active.
    /// Uses hysteresis (30% improvement threshold) to avoid thrashing.
    async fn do_select_active(
        endpoints: &[Arc<RwLock<EndpointConn>>],
        active_idx: &Arc<RwLock<usize>>,
    ) {
        let mut best_idx = None;
        let mut best_latency = Duration::MAX;
        for (i, ec) in endpoints.iter().enumerate() {
            let conn = ec.read().await;
            if conn.is_healthy().await && conn.channel.is_some() {
                let lat = conn.get_latency().await;
                if lat < best_latency {
                    best_idx = Some(i);
                    best_latency = lat;
                }
            }
        }
        if let Some(new_idx) = best_idx {
            let mut idx = active_idx.write().await;
            if *idx != new_idx && *idx < endpoints.len() {
                let current_latency = endpoints[*idx].read().await.get_latency().await;
                if current_latency == Duration::MAX || best_latency == Duration::MAX {
                    *idx = new_idx;
                } else {
                    let improvement = (current_latency.as_nanos() as f64 - best_latency.as_nanos() as f64)
                        / current_latency.as_nanos() as f64;
                    if improvement >= REBALANCE_THRESHOLD {
                        *idx = new_idx;
                    }
                }
            } else if *idx >= endpoints.len() {
                *idx = new_idx;
            }
        }
    }
}

/// Groups a tenant-routed target's instances by the tenant each one serves:
/// the tid of its spiffe_id's namespace, which must be exactly
/// `/tenants/<tid>`. An instance in any other namespace, or whose spiffe_id
/// does not parse, belongs to no tenant and is not routable.
pub(crate) fn group_by_tenant<'a>(
    service_id: &str,
    instances: &[&'a ServiceInstanceHealth],
) -> BTreeMap<String, Vec<&'a ServiceInstanceHealth>> {
    let mut grouped: BTreeMap<String, Vec<&'a ServiceInstanceHealth>> = BTreeMap::new();
    for inst in instances {
        match crate::tenant_route::tenant_of_spiffe_id(&inst.spiffe_id) {
            Some(tenant) => grouped.entry(tenant).or_default().push(*inst),
            None => debug!(
                service = %service_id,
                spiffe_id = %inst.spiffe_id,
                "instance of a tenant-routed service is not in a /tenants/<tid> namespace; not routable"
            ),
        }
    }
    grouped
}

impl Drop for ServiceConnection {
    fn drop(&mut self) {
        for task in &self._tasks {
            task.abort();
        }
    }
}

/// ChannelProvider resolves the active gRPC channel for a target service.
///
/// Each gRPC client holds one of these and calls `channel()` on every RPC
/// to get the current best endpoint.
#[derive(Clone)]
pub struct ChannelProvider {
    source: ChannelProviderSource,
}

#[derive(Clone)]
enum ChannelProviderSource {
    Managed(Arc<ServiceConnection>),
    Static(Channel),
}

impl ChannelProvider {
    /// Creates a new ChannelProvider backed by a ServiceConnection.
    pub fn new(conn: Arc<ServiceConnection>) -> Self {
        Self {
            source: ChannelProviderSource::Managed(conn),
        }
    }

    /// Creates a ChannelProvider backed by one static channel.
    pub fn from_channel(service_id: impl Into<String>, channel: Channel) -> Self {
        let _ = service_id.into();
        Self {
            source: ChannelProviderSource::Static(channel),
        }
    }

    /// Returns the currently active channel for the target service.
    /// Returns an error if no healthy endpoints are available.
    ///
    /// A tenant-routed target has no channel without a tenant: this fails
    /// closed (FAILED_PRECONDITION) rather than pick any tenant's instance.
    pub async fn channel(&self) -> Result<Channel, tonic::Status> {
        match &self.source {
            ChannelProviderSource::Managed(conn) if conn.is_tenant_routed() => {
                Err(tonic::Status::failed_precondition(format!(
                    "service \"{}\" is routed by tenant: a call must name its target tenant",
                    conn.service_id()
                )))
            }
            ChannelProviderSource::Managed(conn) => conn.conn().await.ok_or_else(|| {
                tonic::Status::unavailable(format!(
                    "service \"{}\": no healthy endpoints available",
                    conn.service_id()
                ))
            }),
            ChannelProviderSource::Static(channel) => Ok(channel.clone()),
        }
    }

    /// Returns the channel for a call routed to `tenant`, the tid the call's
    /// route field names. `tenant` must be a tid (INVALID_ARGUMENT otherwise).
    ///
    /// For a tenant-routed target this is that tenant's own pool and nothing
    /// else: UNAVAILABLE when the tenant has no routable instance, never
    /// another tenant's or a shared instance. Any other target (a gateway, a
    /// fixed channel) routes the call by its route field itself, and answers
    /// `channel()`.
    pub async fn channel_for_tenant(&self, tenant: &str) -> Result<Channel, tonic::Status> {
        if !crate::tenant_route::valid_tenant_id(tenant) {
            return Err(tonic::Status::invalid_argument(format!(
                "target tenant {:?} is not a tenant id",
                tenant
            )));
        }
        match &self.source {
            ChannelProviderSource::Managed(conn) if conn.is_tenant_routed() => {
                conn.conn_for_tenant(tenant).await.ok_or_else(|| {
                    tonic::Status::unavailable(format!(
                        "service \"{}\": no healthy endpoints available for tenant {}",
                        conn.service_id(),
                        tenant
                    ))
                })
            }
            _ => self.channel().await,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::readiness::tests::verifier;
    use {{.CrateBasePathUnderscore}}_types::sys::host::host::Host;

    /// A pool with one dialed endpoint at 127.0.0.1:1, reported HEALTHY.
    async fn pool() -> ServiceConnection {
        let channel = tonic::transport::Endpoint::from_static("http://127.0.0.1:1").connect_lazy();
        let mut ec = EndpointConn::new("127.0.0.1:1".to_string());
        ec.channel = Some(channel);
        ec.update_health_from_state(InstanceStatus::Healthy as i32, 0).await;
        let sc = ServiceConnection::new_dynamic("identity", verifier());
        sc.endpoints.write().await.push(Arc::new(RwLock::new(ec)));
        sc
    }

    fn snapshot(status: InstanceStatus) -> ServiceInstanceHealth {
        ServiceInstanceHealth {
            service_id: "identity".to_string(),
            grpc_endpoint: Some(Host { host: "127.0.0.1".to_string(), port: 1, ..Default::default() }),
            status: status as i32,
            ..Default::default()
        }
    }

    #[tokio::test]
    async fn endpoint_missed_one_snapshot_stays_pooled() {
        let sc = pool().await;
        sc.reconcile_from_health(&[]).await;
        assert_eq!(sc.endpoints.read().await.len(), 1, "one missed snapshot dropped the endpoint");
        assert_eq!(sc.unavailable_input().await, None, "one missed snapshot took the pool down");

        let back = snapshot(InstanceStatus::Healthy);
        sc.reconcile_from_health(&[&back]).await;
        assert_eq!(sc.endpoints.read().await.len(), 1, "endpoint must be kept when it reappears");
    }

    #[tokio::test]
    async fn endpoint_closed_after_absent_snapshots() {
        let sc = pool().await;
        for i in 1..ABSENT_POLLS_BEFORE_CLOSE {
            sc.reconcile_from_health(&[]).await;
            assert_eq!(sc.endpoints.read().await.len(), 1, "closed after {i} absent snapshots");
        }
        sc.reconcile_from_health(&[]).await;
        assert!(sc.endpoints.read().await.is_empty(), "still pooled after {ABSENT_POLLS_BEFORE_CLOSE} absent snapshots");
    }

    fn tenant_instance(spiffe_id: &str, port: i32) -> ServiceInstanceHealth {
        ServiceInstanceHealth {
            service_id: "crew".to_string(),
            spiffe_id: spiffe_id.to_string(),
            grpc_endpoint: Some(Host { host: "127.0.0.1".to_string(), port, ..Default::default() }),
            status: InstanceStatus::Healthy as i32,
            ..Default::default()
        }
    }

    /// A tenant-routed pool holding one healthy (lazy) endpoint per tenant,
    /// each at its own target.
    async fn tenant_pool(tenants: &[(&str, &str)]) -> Arc<ServiceConnection> {
        let sc = ServiceConnection::new_tenant_routed("crew", verifier());
        for (tenant, target) in tenants {
            let channel = tonic::transport::Endpoint::from_shared(format!("http://{target}")).unwrap().connect_lazy();
            let mut ec = EndpointConn::new(target.to_string());
            ec.channel = Some(channel);
            ec.update_health_from_state(InstanceStatus::Healthy as i32, 0).await;
            let pool = ServiceConnection::new_dynamic("crew", verifier());
            pool.endpoints.write().await.push(Arc::new(RwLock::new(ec)));
            sc.tenants.as_ref().unwrap().write().await.insert(tenant.to_string(), Arc::new(pool));
        }
        Arc::new(sc)
    }

    async fn active_target(sc: &ServiceConnection, tenant: &str) -> Option<String> {
        let pool = sc.tenant_pool(tenant).await?;
        let idx = *pool.active_idx.read().await;
        let ec = pool.endpoints.read().await.get(idx)?.clone();
        let target = ec.read().await.target.clone();
        Some(target)
    }

    #[test]
    fn instances_group_by_their_spiffe_tenant() {
        let a = tenant_instance("spiffe://example.com/tenants/aaaaaaaa/services/crew", 1);
        let a2 = tenant_instance("spiffe://example.com/tenants/aaaaaaaa/services/crew", 2);
        let b = tenant_instance("spiffe://example.com/tenants/bbbbbbbb/services/crew", 3);
        let shared = tenant_instance("spiffe://example.com/system/services/crew", 4);
        let named = tenant_instance("spiffe://example.com/tenants/acme/services/crew", 5);
        let none = tenant_instance("", 6);
        let grouped = group_by_tenant("crew", &[&a, &shared, &b, &a2, &named, &none]);
        assert_eq!(grouped.keys().cloned().collect::<Vec<_>>(), vec!["aaaaaaaa", "bbbbbbbb"]);
        assert_eq!(grouped["aaaaaaaa"].len(), 2);
        assert_eq!(grouped["bbbbbbbb"].len(), 1);
        assert_eq!(grouped["bbbbbbbb"][0].grpc_endpoint.as_ref().unwrap().port, 3);
    }

    #[tokio::test]
    async fn tenant_routed_call_reaches_the_named_tenant_only() {
        let sc = tenant_pool(&[("aaaaaaaa", "127.0.0.1:11"), ("bbbbbbbb", "127.0.0.1:12")]).await;
        assert_eq!(active_target(&sc, "aaaaaaaa").await.as_deref(), Some("127.0.0.1:11"));
        assert_eq!(active_target(&sc, "bbbbbbbb").await.as_deref(), Some("127.0.0.1:12"));
        let cp = ChannelProvider::new(sc.clone());
        cp.channel_for_tenant("aaaaaaaa").await.expect("tenant aaaaaaaa has an instance");
        cp.channel_for_tenant("bbbbbbbb").await.expect("tenant bbbbbbbb has an instance");
        // A tenant with no instance is unavailable: never another tenant's.
        let err = cp.channel_for_tenant("cccccccc").await.unwrap_err();
        assert_eq!(err.code(), tonic::Code::Unavailable);
        // No tenant, or a malformed one, never picks any instance.
        let err = cp.channel().await.unwrap_err();
        assert_eq!(err.code(), tonic::Code::FailedPrecondition);
        for bad in ["", "AAAAAAAA", "aaaaaaa"] {
            let err = cp.channel_for_tenant(bad).await.unwrap_err();
            assert_eq!(err.code(), tonic::Code::InvalidArgument, "{bad:?}");
        }
        assert!(sc.conn().await.is_none(), "a tenant-routed pool has no tenant-less channel");
        assert_eq!(sc.unavailable_input().await, None);
    }

    #[tokio::test]
    async fn tenant_routed_pool_with_no_tenant_is_down() {
        let sc = ServiceConnection::new_tenant_routed("crew", verifier());
        assert_eq!(sc.unavailable_input().await, Some("no endpoints"));
        // Instances outside /tenants/<tid> are never pooled (nor dialled).
        let shared = tenant_instance("spiffe://example.com/system/services/crew", 1);
        sc.reconcile_from_health(&[&shared]).await;
        assert!(sc.tenants.as_ref().unwrap().read().await.is_empty());
        assert_eq!(sc.unavailable_input().await, Some("no endpoints"));
    }

    #[tokio::test]
    async fn tenant_pool_ages_out_like_a_platform_pool() {
        let sc = tenant_pool(&[("aaaaaaaa", "127.0.0.1:1")]).await;
        for _ in 1..ABSENT_POLLS_BEFORE_CLOSE {
            sc.reconcile_from_health(&[]).await;
            assert!(active_target(&sc, "aaaaaaaa").await.is_some(), "tenant pool closed early");
        }
        sc.reconcile_from_health(&[]).await;
        assert!(sc.tenant_pool("aaaaaaaa").await.is_none(), "empty tenant pool kept");
    }

    #[tokio::test]
    async fn platform_provider_ignores_the_tenant() {
        let sc = Arc::new(pool().await);
        let cp = ChannelProvider::new(sc);
        cp.channel().await.expect("platform channel");
        cp.channel_for_tenant("aaaaaaaa").await.expect("a platform target routes by its own pool");
    }

    #[tokio::test]
    async fn absent_count_restarts_when_endpoint_returns() {
        let sc = pool().await;
        let back = snapshot(InstanceStatus::Healthy);
        for _ in 0..2 * ABSENT_POLLS_BEFORE_CLOSE {
            sc.reconcile_from_health(&[]).await;
            sc.reconcile_from_health(&[&back]).await;
        }
        assert_eq!(sc.endpoints.read().await.len(), 1, "alternating miss and return closed the endpoint");
    }
}
