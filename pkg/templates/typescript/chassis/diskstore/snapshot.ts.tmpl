/**
 * UC1 — atomic typed snapshot (whole object).
 *
 * These functions operate on raw bytes. The per-type generated code produces
 * the bytes via the generated JSON serializer on write, and parses them via
 * the JSON deserializer + validate on read — keeping serialization consistent
 * with the rest of tacplus and validation always-on.
 */
import fs from 'fs';
import { Codec, compress, decompressAuto } from './compress.js';
import { DiskStoreError } from './error.js';
import { archiveActive, archiveName, promote, writeTemp } from './fsutil.js';

/** Options for a snapshot write. */
export interface SnapshotOpts {
  /** At-rest compression for the snapshot file. */
  codec: Codec;
  /** Unix file mode for the data file (e.g. 0o600). `0` leaves the default. */
  mode: number;
  /** Number of rotated archives to retain. */
  archiveCount: number;
}

/** Default snapshot options: no compression, mode 0600, keep 3 archives. */
export function defaultSnapshotOpts(): SnapshotOpts {
  return { codec: Codec.None, mode: 0o600, archiveCount: 3 };
}

/**
 * Write a whole-object snapshot atomically.
 *
 * Order is chosen so the active file is NEVER absent (PC-L-5):
 * 1. compress the payload,
 * 2. write it to a fresh fsync'd temp (active still intact),
 * 3. LINK the previous active to `<path>.bak.1` (keep `archiveCount`; the
 *    active path stays in place),
 * 4. atomically rename the temp over `path` (the only mutation of the active
 *    file — a crash leaves either the old or the new snapshot).
 */
export function writeSnapshot(filePath: string, data: Buffer, opts: SnapshotOpts): void {
  const payload = compress(data, opts.codec);
  const tmp = writeTemp(filePath, payload, opts.mode);
  archiveActive(filePath, opts.archiveCount);
  promote(tmp, filePath);
}

/**
 * Read a snapshot, auto-decompressing. Returns `null` if the file is absent.
 * The caller deserializes + validates the returned bytes.
 */
export function readSnapshot(filePath: string): Buffer | null {
  let bytes: Buffer;
  try {
    bytes = fs.readFileSync(filePath);
  } catch (e) {
    const err = e as NodeJS.ErrnoException;
    if (err && err.code === 'ENOENT') {
      // The active file should never be absent (writeSnapshot only ever
      // replaces it atomically), but if it is — disk incident, manual
      // deletion, legacy crash window — recover the previous state from
      // .bak.1 rather than silently starting fresh (PC-L-5 read leg).
      let bakBytes: Buffer;
      try {
        bakBytes = fs.readFileSync(archiveName(filePath, 1));
      } catch (bakErr) {
        // Only a MISSING archive degrades to fresh-start; any other read
        // failure on a present archive errors loudly (NEW-38).
        const be = bakErr as NodeJS.ErrnoException;
        if (be && be.code === 'ENOENT') {
          return null;
        }
        throw DiskStoreError.fromUnknown(bakErr);
      }
      // A present-but-corrupt archive on the recovery path errors LOUDLY —
      // silently dropping the last committed baseline would mask corruption
      // on the exact path this recovery exists for (NEW-37).
      return decompressAuto(bakBytes);
    }
    throw DiskStoreError.fromUnknown(e);
  }
  return decompressAuto(bytes);
}
