            private final java.nio.file.Path dir;
            private final java.util.List<byte[]> unacked;
            private int acked;   // records the publisher has acknowledged: the cursor
            private int saved;   // the cursor as last written
            private int total;   // records in the log
            private long size;   // bytes in the log

            DiskSpool(java.nio.file.Path dir) {
                this.dir = dir;
                this.acked = readCursor(dir);
                this.saved = acked;
                java.util.List<byte[]> lines = AppendLog.readLines(dir, SPOOL_LOG);
                if (acked > lines.size()) {
                    throw DiskStoreException.invalidData("accounting spool cursor " + acked + " is past its "
                            + lines.size() + " records in " + dir);
                }
                this.total = lines.size();
                this.unacked = new java.util.ArrayList<>(lines.subList(acked, lines.size()));
                for (byte[] line : lines) {
                    size += line.length + 1L;
                }
            }

            // pendingLines returns the lines the publisher had not acknowledged, in order.
            java.util.List<byte[]> pendingLines() {
                return unacked;
            }

            // append writes one record line to the log. It fails without writing
            // when the record would take the spool past SPOOL_BYTES.
            void append(byte[] line) {
                if (size + line.length + 1L > SPOOL_BYTES) {
                    throw DiskStoreException.invalidData("accounting spool full");
                }
                AppendLog.append(dir, SPOOL_LOG, line, 0600);
                total++;
                size += line.length + 1L;
            }

            // ack advances the cursor past one acknowledged record. When every
            // record in the log has been acknowledged, the log is removed. The
            // cursor goes back to zero first, so a crash between the two steps
            // republishes records the bus already has rather than losing one.
            void ack() {
                acked++;
                if (acked == total) {
                    try {
                        writeCursor(dir, 0);
                    } catch (DiskStoreException e) {
                        acked--;
                        throw e;
                    }
                    saved = 0;
                    acked = 0;
                    total = 0;
                    size = 0;
                    try {
                        java.nio.file.Files.deleteIfExists(dir.resolve(SPOOL_LOG));
                    } catch (java.io.IOException e) {
                        throw DiskStoreException.io("remove accounting spool log: " + e.getMessage(), e);
                    }
                    return;
                }
                if (acked - saved >= CURSOR_EVERY) {
                    writeCursor(dir, acked);
                    saved = acked;
                }
            }

            // flush writes the cursor if it has moved since it was last written.
            void flush() {
                if (acked != saved) {
                    writeCursor(dir, acked);
                    saved = acked;
                }
            }

            private static int readCursor(java.nio.file.Path dir) {
                if (!PlainFile.exists(dir, SPOOL_CURSOR)) {
                    return 0;
                }
                String raw = new String(PlainFile.readAll(dir, SPOOL_CURSOR), java.nio.charset.StandardCharsets.UTF_8).trim();
                try {
                    int n = Integer.parseInt(raw);
                    if (n < 0) {
                        throw new NumberFormatException(raw);
                    }
                    return n;
                } catch (NumberFormatException e) {
                    throw DiskStoreException.invalidData("accounting spool cursor \"" + raw + "\" is not a count");
                }
            }

            // writeCursor writes the cursor atomically (see FsUtil.atomicWrite).
            private static void writeCursor(java.nio.file.Path dir, int n) {
                try {
                    java.nio.file.Files.createDirectories(dir.resolve("accounting-spool"));
                } catch (java.io.IOException e) {
                    throw DiskStoreException.io("create accounting spool dir: " + e.getMessage(), e);
                }
                FsUtil.atomicWrite(dir.resolve(SPOOL_CURSOR), (n + "\n").getBytes(java.nio.charset.StandardCharsets.UTF_8), 0600);
            }
        }
    }
