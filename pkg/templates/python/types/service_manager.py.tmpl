    async def _tls_cert_stream_loop(self, handler: Handler, ready: asyncio.Event) -> None:
        """Manages the bidi TLS certificate stream, retrying on disconnection."""
        attempt = 0
        while True:
            try:
                await self._run_tls_cert_stream(handler, ready)
                return
            except asyncio.CancelledError:
                raise
            except _FirstTlsCertDeliveryError:
                # Cross-language policy: a handler failure on the FIRST cert
                # delivery is fatal — startup must fail, not retry.
                raise
            except Exception as e:
                if not ready.is_set():
                    # First cert never delivered — retry with backoff.
                    attempt += 1
                    if attempt >= self._MAX_INIT_RETRIES:
                        raise
                    delay = min(2 ** min(attempt, 5), 30)
                    logger.warning("TLS cert stream failed before first cert (attempt %d/%d), retrying in %ds: %s",
                                   attempt, self._MAX_INIT_RETRIES, delay, e)
                    await asyncio.sleep(delay)
                else:
                    logger.warning("TLS cert stream disconnected, retrying in 5s: %s", e)
                    await asyncio.sleep(5)

    async def _run_tls_cert_stream(self, handler: Handler, ready: asyncio.Event) -> None:
{{- if eq .AutoTlsKeyType "ecdsa"}}
        from cryptography.hazmat.primitives.asymmetric import ec
{{- else}}
        from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
{{- end}}
        from cryptography.hazmat.primitives.serialization import (
            Encoding, PublicFormat, PrivateFormat, NoEncryption,
        )
        import base64
        import time

        from {{.PythonPackageBase}}.types.sys.tlscert import tlscert_pb2
        from {{.PythonPackageBase}}.types.sys.tlscert import tlscert_pb2_grpc
        from {{.PythonPackageBase}}.types.sys.key import key_pb2

        # Generate keypair.
{{- if eq .AutoTlsKeyType "ecdsa"}}
        key = ec.generate_private_key(ec.SECP256R1())
{{- else}}
        key = Ed25519PrivateKey.generate()
{{- end}}
        private_key_der = key.private_bytes(Encoding.DER, PrivateFormat.PKCS8, NoEncryption())
        pub_proto = self._build_public_key_proto(key, key_pb2)

        conn = self.conn()
        if conn is None:
            raise RuntimeError("no connection for auto-TLS cert stream")

        stub = tlscert_pb2_grpc.TlsCertServiceStub(conn)

        # Build outbound message queue.
        outbound: asyncio.Queue[tlscert_pb2.TlsCertClientMsg] = asyncio.Queue()

        # Send Init.
        hostname = socket.gethostname()
        await outbound.put(tlscert_pb2.TlsCertClientMsg(
            init=tlscert_pb2.TlsCertInit(
                service_name="{{.ServiceLabel}}",
                instance_id=hostname,
            ),
        ))

        # Send initial Csr.
        await outbound.put(tlscert_pb2.TlsCertClientMsg(
            csr=tlscert_pb2.TlsCertCsr(public_key=pub_proto),
        ))

        async def request_iterator():
            while True:
                msg = await outbound.get()
                yield msg

        token = await self.get_token()
        metadata = [("authorization", f"Bearer {token}")]
        response_stream = stub.ManageCert(request_iterator(), metadata=metadata)

        async for server_msg in response_stream:
            if server_msg.HasField("cert"):
                try:
                    await handler.new_tls_cert(server_msg.cert.chain, private_key_der)
                except Exception as e:
                    if not ready.is_set():
                        # First delivery: the service cannot serve without a
                        # usable TLS cert — fail startup (fatal, no retry).
                        raise _FirstTlsCertDeliveryError(
                            f"handler new_tls_cert failed on first certificate delivery: {e}"
                        ) from e
                    # Renewal delivery: keep serving on the previous cert.
                    logger.error("Handler new_tls_cert failed on renewal: %s", e)
                else:
                    if not ready.is_set():
                        ready.set()
            elif server_msg.HasField("renew"):
                logger.info("TLS cert renewal requested: %s", server_msg.renew.reason)
{{- if eq .AutoTlsKeyType "ecdsa"}}
                key = ec.generate_private_key(ec.SECP256R1())
{{- else}}
                key = Ed25519PrivateKey.generate()
{{- end}}
                private_key_der = key.private_bytes(
                    Encoding.DER, PrivateFormat.PKCS8, NoEncryption())
                pub_proto = self._build_public_key_proto(key, key_pb2)
                await outbound.put(tlscert_pb2.TlsCertClientMsg(
                    csr=tlscert_pb2.TlsCertCsr(public_key=pub_proto),
                ))
            elif server_msg.HasField("error"):
                raise RuntimeError(f"server error: {server_msg.error}")
{{- end}}

