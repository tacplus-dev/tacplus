//
// JWT (JSON Web Token) functionality for creating and managing tokens.
//
// This module provides JWT token creation, signing, and verification with:
// - Method-chaining API for building tokens
// - Immutability enforcement after signing
// - Support for RSA, ECDSA, and EdDSA signing algorithms
// - Standard JWT claims (iss, sub, aud, exp, iat, jti)
// - Custom payload fields
//
//! # Token Lifecycle
//!
//! 1. Create a new Token
//! 2. Set claims and header fields (mutable)
//! 3. Sign the token with a private key (becomes immutable)
//! 4. Verify the token with a JWK

use key::base64_utils;
use key::error::{AuthError, Result};
use key::keys;
use jwk::jwk;
use {{.CrateBasePathUnderscore}}_types::sys::token::JwtPayloadType;
use chrono::{DateTime, Utc};
use serde::{Deserialize, Serialize};
use serde_json::{Map, Value};


/// JWT header structure
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Header {
    /// Algorithm (e.g., "RS384", "ES256", "EdDSA")
    #[serde(skip_serializing_if = "Option::is_none")]
    pub alg: Option<String>,

    /// Key ID
    #[serde(skip_serializing_if = "Option::is_none")]
    pub kid: Option<String>,

    /// Token type (usually "JWT")
    #[serde(skip_serializing_if = "Option::is_none")]
    pub typ: Option<String>,
}

/// JWT payload structure
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Payload {
    /// Issuer
    #[serde(skip_serializing_if = "Option::is_none")]
    pub iss: Option<String>,

    /// Subject (RFC 7519 user-unique ID — email in tests, <iss>:<sub> for IDP users).
    /// NOT the SPIFFE URI; see `namespace`.
    #[serde(skip_serializing_if = "Option::is_none")]
    pub sub: Option<String>,

    /// Namespace — canonical authorization-tree position (e.g. "/io/example/team-a").
    /// Drives the level-or-below rule. SPIFFE URIs are projections of namespace + sub_type + sub.
    #[serde(skip_serializing_if = "Option::is_none")]
    pub namespace: Option<String>,

    /// Audience
    #[serde(skip_serializing_if = "Option::is_none")]
    pub aud: Option<String>,

    /// Expiration time (Unix timestamp)
    #[serde(skip_serializing_if = "Option::is_none")]
    pub exp: Option<i64>,

    /// Issued at time (Unix timestamp)
    #[serde(skip_serializing_if = "Option::is_none")]
    pub iat: Option<i64>,

    /// JWT ID
    #[serde(skip_serializing_if = "Option::is_none")]
    pub jti: Option<String>,

    /// Custom fields (flatten to include at top level)
    #[serde(flatten)]
    pub custom: Map<String, Value>,
}

/// JWT Token wrapper providing convenient methods for token manipulation
///
/// # Immutability
///
/// Once a token is signed (has a signature), it becomes immutable.
/// Any attempt to modify an immutable token will return an error.
///
/// # Example
///
/// ```ignore
/// use token::Token;
/// use key::keys;
///
/// let key = keys::generate_ed25519_key()?;
/// let mut token = Token::new();
/// token.set_issuer("my-service")?;
/// token.set_expiration(chrono::Utc::now().timestamp() + 3600)?;
/// token.sign(&key)?;
/// ```
pub struct Token {
    header: Header,
    payload: Payload,
    signature: Option<String>,
    base64: Option<String>,
    immutable: bool,
}

impl Token {
    /// Creates a new empty Token
    pub fn new() -> Self {
        Self {
            header: Header {
                alg: None,
                kid: None,
                typ: Some("JWT".to_string()),
            },
            payload: Payload {
                iss: None,
                sub: None,
                namespace: None,
                aud: None,
                exp: None,
                iat: None,
                jti: None,
                custom: Map::new(),
            },
            signature: None,
            base64: None,
            immutable: false,
        }
    }

    /// Parses a base64-encoded JWT string
    ///
    /// The JWT must be in the format: header.payload.signature
    /// Parsed tokens with signatures are marked as immutable.
    pub fn parse(base64_str: &str) -> Result<Self> {
        let parts: Vec<&str> = base64_str.split('.').collect();
        if parts.len() != 3 {
            return Err(AuthError::missing_invalid_data(
                "invalid JWT format: expected 3 parts separated by '.'",
            ));
        }

        // Decode header
        let header_bytes = base64_utils::decode_base64(parts[0])?;
        let header: Header = serde_json::from_slice(&header_bytes)?;

        // Decode payload
        let payload_bytes = base64_utils::decode_base64(parts[1])?;
        let payload: Payload = serde_json::from_slice(&payload_bytes)?;

        // Validate issuer
        if payload.iss.is_none() {
            return Err(AuthError::missing_invalid_data("missing issuer (iss) claim"));
        }

        let signature = if parts[2].is_empty() {
            None
        } else {
            Some(parts[2].to_string())
        };

        let immutable = signature.is_some();

        Ok(Self {
            header,
            payload,
            signature,
            base64: Some(base64_str.to_string()),
            immutable,
        })
    }

    /// Checks if the token is mutable, returns an error if immutable
    fn check_mutable(&self) -> Result<()> {
        if self.immutable {
            return Err(AuthError::missing_invalid_data(
                "cannot modify immutable token: token has been signed",
            ));
        }
        Ok(())
    }

    /// Marks the token as immutable (called after signing)
    fn mark_immutable(&mut self) {
        self.immutable = true;
    }

    // Header methods

    /// Sets the Key ID (kid) in the JWT header
    pub fn set_kid(&mut self, kid: impl Into<String>) -> Result<&mut Self> {
        self.check_mutable()?;
        self.header.kid = Some(kid.into());
        Ok(self)
    }

    /// Gets the Key ID (kid) from the JWT header
    pub fn kid(&self) -> Option<&str> {
        self.header.kid.as_deref()
    }

    /// Sets the signing algorithm (alg) in the JWT header
    pub fn set_alg(&mut self, alg: impl Into<String>) -> Result<&mut Self> {
        self.check_mutable()?;
        self.header.alg = Some(alg.into());
        Ok(self)
    }

    /// Gets the signing algorithm (alg) from the JWT header
    pub fn alg(&self) -> Option<&str> {
        self.header.alg.as_deref()
    }

    /// Sets the token type (typ) in the JWT header
    pub fn set_typ(&mut self, typ: impl Into<String>) -> Result<&mut Self> {
        self.check_mutable()?;
        self.header.typ = Some(typ.into());
        Ok(self)
    }

    /// Gets the token type (typ) from the JWT header
    pub fn typ(&self) -> Option<&str> {
        self.header.typ.as_deref()
    }

    // Payload methods

    /// Sets the issuer (iss) claim
    pub fn set_issuer(&mut self, issuer: impl Into<String>) -> Result<&mut Self> {
        self.check_mutable()?;
        self.payload.iss = Some(issuer.into());
        Ok(self)
    }

    /// Gets the issuer (iss) claim
    pub fn issuer(&self) -> Option<&str> {
        self.payload.iss.as_deref()
    }

    /// Sets the subject (sub) claim
    pub fn set_subject(&mut self, subject: impl Into<String>) -> Result<&mut Self> {
        self.check_mutable()?;
        self.payload.sub = Some(subject.into());
        Ok(self)
    }

    /// Gets the subject (sub) claim
    pub fn subject(&self) -> Option<&str> {
        self.payload.sub.as_deref()
    }

    /// Sets the namespace claim (canonical authorization-tree position, e.g. "/io/example/team-a")
    pub fn set_namespace(&mut self, namespace: impl Into<String>) -> Result<&mut Self> {
        self.check_mutable()?;
        self.payload.namespace = Some(namespace.into());
        Ok(self)
    }

    /// Gets the namespace claim
    pub fn namespace(&self) -> Option<&str> {
        self.payload.namespace.as_deref()
    }

    /// Returns the normalized namespace claim — the authorization-tree path
    /// used for level-or-below checks. It fails closed: a missing or malformed
    /// namespace is an error, never silently mapped to root or empty.
    pub fn namespace_path(&self) -> Result<String> {
        let ns = self.namespace().unwrap_or("");
        if ns.is_empty() {
            return Err(AuthError::unauthorized("token has no namespace claim"));
        }
        spiffe::normalize_namespace(ns)
            .map_err(|e| AuthError::unauthorized(format!("token namespace claim is malformed: {}", e)))
    }

    /// Materializes the token's namespace authorization scope as a SPIFFE ID.
    /// This is the SCOPE, not the subject — use `subject_spiffe_id` for the
    /// acting principal.
    pub fn namespace_spiffe_id(&self, trust_domain: &str) -> Result<String> {
        let ns = self.namespace_path()?;
        spiffe::namespace_spiffe_id(trust_domain, &ns)
            .map_err(|e| AuthError::unauthorized(e.to_string()))
    }

    /// Returns the location-agnostic service identity used for S2S
    /// auth_services matching: the bare service label, plus any
    /// `/workloads/<child>` suffix (e.g. `mcp` or `mcp/workloads/agent-42`).
    /// Only service and workload tokens have a service path. A full SPIFFE URI
    /// in the claim (durable-key form) is parsed and reduced to the same shape.
    pub fn service_path(&self) -> Result<String> {
        let sub_type = self.sub_type().unwrap_or("");
        if sub_type != "service" && sub_type != "workload" {
            return Err(AuthError::unauthorized(format!(
                "token sub_type \"{}\" has no service path",
                sub_type
            )));
        }
        let mut sub = self.subject().unwrap_or("");
        if sub.is_empty() && sub_type == "service" {
            sub = self.service_name().unwrap_or("");
        }
        if sub.is_empty() {
            return Err(AuthError::unauthorized(
                "service token has no sub or service_name claim",
            ));
        }
        match spiffe::service_path_from_spiffe(sub) {
            Ok(path) => return Ok(path),
            Err(e) if sub.contains("://") => {
                return Err(AuthError::unauthorized(format!(
                    "token subject is not a valid service identity: {}",
                    e
                )));
            }
            Err(_) => {}
        }
        Ok(sub.to_string())
    }

    /// Computes the acting principal's SPIFFE ID from the structured claims
    /// (sub_type, sub, namespace, service_name). The SPIFFE ID is a
    /// computation, not a wire claim. For service/workload tokens the result
    /// is the LOCATION-AGNOSTIC identity (no /system location tiers): the full
    /// location-bearing SVID is built by the service's own manager from
    /// runtime config, never reconstructed from a peer token.
    pub fn subject_spiffe_id(&self, trust_domain: &str) -> Result<String> {
        match self.sub_type().unwrap_or("") {
            "service" | "workload" => {
                let service_path = self.service_path()?;
                let sep = format!("/{}/", spiffe::WORKLOADS_SEGMENT);
                let parts: Vec<&str> = service_path.split(sep.as_str()).collect();
                let mut id = spiffe::service_spiffe_id(trust_domain, "", parts[0])
                    .map_err(|e| AuthError::unauthorized(e.to_string()))?;
                for child in &parts[1..] {
                    id = spiffe::workload_spiffe_id(&id, child)
                        .map_err(|e| AuthError::unauthorized(e.to_string()))?;
                }
                Ok(id)
            }
            "user" => {
                let ns = self.namespace_path()?;
                spiffe::user_spiffe_id(trust_domain, &ns, self.subject().unwrap_or(""))
                    .map_err(|e| AuthError::unauthorized(e.to_string()))
            }
            "client" => {
                let ns = self.namespace_path()?;
                spiffe::client_spiffe_id(trust_domain, &ns, self.subject().unwrap_or(""))
                    .map_err(|e| AuthError::unauthorized(e.to_string()))
            }
            other => Err(AuthError::unauthorized(format!(
                "cannot derive subject identity for sub_type \"{}\"",
                other
            ))),
        }
    }

    /// Builds a durable resource identity owned inside the token's namespace:
    /// `spiffe://<td><namespace>/data/<kind>/<id>`.
    pub fn resource_owner_spiffe_id(&self, trust_domain: &str, kind: &str, id: &str) -> Result<String> {
        let ns = self.namespace_path()?;
        spiffe::resource_spiffe_id(trust_domain, &ns, kind, id)
            .map_err(|e| AuthError::unauthorized(e.to_string()))
    }

    /// Sets the audience (aud) claim
    pub fn set_audience(&mut self, audience: impl Into<String>) -> Result<&mut Self> {
        self.check_mutable()?;
        self.payload.aud = Some(audience.into());
        Ok(self)
    }

    /// Gets the audience (aud) claim
    pub fn audience(&self) -> Option<&str> {
        self.payload.aud.as_deref()
    }

    /// Sets the expiration time (exp) claim (Unix timestamp)
    pub fn set_expiration(&mut self, exp: i64) -> Result<&mut Self> {
        self.check_mutable()?;
        self.payload.exp = Some(exp);
        Ok(self)
    }

    /// Gets the expiration time (exp) claim
    pub fn expiration(&self) -> Option<i64> {
        self.payload.exp
    }

    /// Sets the issued at (iat) claim (Unix timestamp)
    pub fn set_issued_at(&mut self, iat: i64) -> Result<&mut Self> {
        self.check_mutable()?;
        self.payload.iat = Some(iat);
        Ok(self)
    }

    /// Gets the issued at (iat) claim
    pub fn issued_at(&self) -> Option<i64> {
        self.payload.iat
    }

    /// Sets the JWT ID (jti) claim
    pub fn set_jti(&mut self, jti: impl Into<String>) -> Result<&mut Self> {
        self.check_mutable()?;
        self.payload.jti = Some(jti.into());
        Ok(self)
    }

    /// Gets the JWT ID (jti) claim
    pub fn jti(&self) -> Option<&str> {
