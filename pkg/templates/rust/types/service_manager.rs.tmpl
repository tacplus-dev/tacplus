#[tonic::async_trait]
impl {{.WrapperModPath}}::Authorizer for AuthorizerAdapter {
    async fn authorize(&self, full_method: &str, authorization: Option<&str>) -> Result<std::collections::HashMap<String, String>, tonic::Status> {
        // Extract method name from full gRPC path, e.g. "/pkg.Service/Method" → "Method".
        let method = full_method.rsplit('/').next().unwrap_or(full_method);
        // The verified token is the ONLY source of a caller identity an
        // accounting record may name — see GrpcAuthorizer::identity_claims.
        self.authorizer
            .authorize_grpc(full_method, method, authorization, &std::collections::HashMap::new())
            .await
            .map(|tw| GrpcAuthorizer::identity_claims(&tw))
            .map_err(|e| match e.code {
                16 => tonic::Status::unauthenticated(e.message),
                _ => tonic::Status::permission_denied(e.message),
            })
    }

    async fn check_at_or_below(&self, authorization: Option<&str>, target_namespace: &str) -> Result<std::collections::HashMap<String, String>, tonic::Status> {
        self.authorizer
            .check_caller_at_or_below(authorization, target_namespace)
            .map(|tw| GrpcAuthorizer::identity_claims(&tw))
            .map_err(|e| match e.code {
                16 => tonic::Status::unauthenticated(e.message),
                _ => tonic::Status::permission_denied(e.message),
            })
    }
}
