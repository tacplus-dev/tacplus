"""
SM-managed roll scheduler: deterministic per-node staggered compaction.

Each node derives its roll time **deterministically from its stable identity**
(``hash(node_id) % interval``), so replicas stagger across the interval and the
schedule survives restarts without persisting anything — avoiding a
thundering-herd of simultaneous snapshots. The interval comes from the
service-supplied ``DiskPersistenceConfig`` (config-at-init).
"""

import asyncio
import logging
from typing import Callable, List

from .redolog import Record, RedoLog

logger = logging.getLogger(__name__)

# FNV-1a 64-bit constants (mirrors the Rust scheduler).
_FNV_OFFSET = 0xCBF29CE484222325
_FNV_PRIME = 0x00000100000001B3
_U64_MASK = 0xFFFFFFFFFFFFFFFF


def roll_offset(node_id: str, interval_secs: int) -> int:
    """Deterministic per-node roll offset (in seconds) within ``interval_secs``
    (FNV-1a of ``node_id``). Stable across restarts; well-distributed so replicas
    don't collide."""
    secs = max(interval_secs, 1)
    h = _FNV_OFFSET
    for b in node_id.encode("utf-8"):
        h ^= b
        h = (h * _FNV_PRIME) & _U64_MASK
    return h % secs


async def run_roll_scheduler(
    log: RedoLog,
    interval_secs: int,
    node_id: str,
    snapshot: Callable[[], List[Record]],
) -> None:
    """Run the periodic roll loop for a redo log. ``snapshot`` returns the
    current deduped state to write as the new baseline at each roll. The first
    roll is delayed by the node's deterministic offset; thereafter it rolls once
    per ``interval_secs``. Roll failures are logged and retried on the next
    interval."""
    await asyncio.sleep(roll_offset(node_id, interval_secs))
    while True:
        await asyncio.sleep(interval_secs)
        snap = snapshot()
        try:
            log.roll(snap)
        except Exception:
            logger.exception("diskstore roll failed for %s; retrying on next interval", node_id)
