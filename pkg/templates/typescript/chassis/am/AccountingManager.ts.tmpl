    return (err as any).code;
  }
  return 2; // UNKNOWN
}

/** Builds ErrorContext from an error, capturing stack if appropriate. */
export function errorContextFromError(err: unknown, shouldStack: boolean): ErrorContext {
  const ec: ErrorContext = {
