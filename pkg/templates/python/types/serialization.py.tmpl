def {{.FuncPrefix}}_load_toml(filename: str) -> {{.QualifiedType}}:
    """Loads {{.TypeName}} from TOML file.

    Requires: pip install tomli (or use Python 3.11+ tomllib)

    Args:
        filename: Path to TOML file

    Returns:
        Parsed message

