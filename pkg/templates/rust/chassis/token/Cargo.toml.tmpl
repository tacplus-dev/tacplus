[package]
name = "token"
version = "0.1.0"
edition = "2021"
description = "JWT token creation, signing, and verification"

[dependencies]
key = { path = "../key" }
jwk = { path = "../jwk" }
spiffe = { path = "../spiffe" }
{{.CrateBasePath}}-types = { path = "../../types" }
base64 = "0.22"
ed25519-dalek = { version = "3", features = ["pkcs8", "pem"] }
signature = "3"
chrono = { version = "0.4", features = ["serde"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
