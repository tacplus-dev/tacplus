                        persist(record);
                    }
                    while (acks.poll() != null) {
                        ackOne();
                    }
                    {{.AccountingRecordJavaType}} next = pending.peekFirst();
                    if (next != null) {
                        if (queue.offer(next, 50, java.util.concurrent.TimeUnit.MILLISECONDS)) {
                            pending.pollFirst();
                            pendingDepth.set(pending.size());
                        }
                    } else {
                        {{.AccountingRecordJavaType}} record = spool.poll(50, java.util.concurrent.TimeUnit.MILLISECONDS);
                        if (record != null) {
                            persist(record);
                        }
                    }
                }
                shutdownDurable();
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                shutdownDurable();
            }
        }

        // Appends one record to the log and queues it for the publisher. A record
        // the log cannot keep is dropped and counted.
        private void persist({{.AccountingRecordJavaType}} record) {
            try {
                disk.append(encode(record));
                pending.addLast(record);
                pendingDepth.set(pending.size());
            } catch (DiskStoreException e) {
                long total = dropped.incrementAndGet();
                logger.error("accounting record dropped; spool write failed accounting_id={} reason={} dropped_total={}",
                        record.getAccountingId(), e.getMessage(), total);
            }
        }

        private void ackOne() {
            try {
                disk.ack();
            } catch (DiskStoreException e) {
                logger.error("accounting spool cursor not written; records may be republished: {}", e.getMessage());
            }
        }

        // Persists the cursor and counts the records that never reached the log.
        // Records already in the log are kept for replay on the next start.
        private void shutdownDurable() {
            while (acks.poll() != null) {
                ackOne();
            }
            try {
                disk.flush();
            } catch (DiskStoreException e) {
                logger.error("accounting spool cursor not written at shutdown; records may be republished: {}", e.getMessage());
            }
            long n = spool.size();
            if (n > 0) {
                long total = dropped.addAndGet(n);
                logger.error("accounting publisher closed; records dropped dropped={} dropped_total={}", n, total);
            }
            logger.info("accounting spool closed; unpublished records kept on disk for replay records={}", pending.size());
        }

        // Counts and logs every record the drain thread still owns: the one in
        // hand, if any, and everything left in the spool.
        private void dropOnShutdown({{.AccountingRecordJavaType}} inHand) {
            long n = spool.size() + (inHand != null ? 1 : 0);
            if (n == 0) {
                return;
            }
            long total = dropped.addAndGet(n);
            logger.error("accounting publisher closed; records dropped dropped={} dropped_total={}", n, total);
        }

        private static byte[] encode({{.AccountingRecordJavaType}} record) {
            return java.util.Base64.getEncoder().encode(record.toByteArray());
        }

        private static {{.AccountingRecordJavaType}} decode(byte[] line) throws java.io.IOException {
            byte[] raw;
            try {
                raw = java.util.Base64.getDecoder().decode(line);
            } catch (IllegalArgumentException e) {
                throw new java.io.IOException("not base64: " + e.getMessage(), e);
            }
            return {{.AccountingRecordJavaType}}.parseFrom(raw);
        }

        // droppedCount is the running total of dropped records. Package-private
        // so the self-test can check that every record is delivered or counted.
        long droppedCount() {
            return dropped.get();
        }

        // Mints the record key. accounting_id is assert_required, so it has
        // to be non-empty and unique: process identity + emit time + a
        // per-process counter is unique without pulling in a uuid dependency.
        private String nextAccountingId(long timestampMs) {
            long next = seq.incrementAndGet();
            return String.format("%s-%013d-%012d", sourceId, timestampMs, next);
        }

        // Converts the emit-time envelope into the stored record.
        //
        // spiffe_id is deliberately left unset: eventbus stamps the owner
        // field with the PUBLISHER's verified SPIFFE ID on the way in, so a
        // value set here would be overwritten, and setting one would be a
        // claim about identity that nothing checked.
        private {{.AccountingRecordJavaType}} flatten(Accounting.Event event) {
            String method = "";
            int code = 0;
            long durationMs = 0;
            Accounting.RpcOutcome outcome = Accounting.RpcOutcome.RPC_OUTCOME_UNDEFINED;
            Accounting.RpcReason reason = Accounting.RpcReason.RPC_REASON_UNDEFINED;
            long recordsReturned = 0;
            long bytes = 0;
            if (event.getEventCase() == Accounting.Event.EventCase.RPC_COMPLETED) {
                Accounting.RpcCompleted rc = event.getRpcCompleted();
                method = methodLabel(rc.getMethod());
                code = rc.getCode();
                durationMs = rc.getDurationMs();
                outcome = rc.getOutcome();
                reason = rc.getReason();
                recordsReturned = rc.getMetrics().getRecordsReturned();
                bytes = rc.getMetrics().getBytes();
            }
            return {{.AccountingRecordJavaType}}.newBuilder()
                    .setAccountingId(nextAccountingId(event.getTimestampMs()))
                    .setRequestId(event.getRequestId())
                    .setSourceId(event.getSourceId())
                    .setTimestampMs(event.getTimestampMs())
                    .setLevel(event.getLevel())
                    .setMethod(method)
                    .setCode(code)
                    .setDurationMs(durationMs)
                    .setOutcome(outcome)
                    .setReason(reason)
                    .setRecordsReturned(recordsReturned)
                    .setBytes(bytes)
                    // The principal the Authorizer verified, not a
                    // caller-written header.
                    .setPrincipalSub(event.getIdentityOrDefault("sub", ""))
                    .build();
        }

        /**
         * Flattens event and spools it without waiting on the publisher. A
         * record is dropped only when the service is shutting down or the spool
         * is full, and either drop is logged at ERROR.
         */
        @Override
        public void emit(Accounting.Event event) {
            {{.AccountingRecordJavaType}} record = flatten(event);
            if (stopped.getAsBoolean()) {
                // The publish loop is gone, which only happens on shutdown.
                // Loud, because this is the one lossy path.
                logger.error("accounting publisher closed; record dropped accounting_id={}", record.getAccountingId());
                return;
            }
            if (!spool.offer(record)) {
                long total = dropped.incrementAndGet();
                logger.error("accounting spool full; record dropped accounting_id={} dropped_total={}", record.getAccountingId(), total);
                return;
            }
            ingested.incrementAndGet();
        }

        /**
         * Stats is the sink's pipeline health, kept as counters rather than as
         * accounting records: records accepted into the spool, records dropped,
         * and records spooled and not yet handed to the publisher.
         */
        public static final class Stats {
            public final long ingested;
            public final long dropped;
            public final long depth;

            Stats(long ingested, long dropped, long depth) {
                this.ingested = ingested;
                this.dropped = dropped;
                this.depth = depth;
            }

            @Override
            public String toString() {
                return "ingested=" + ingested + " dropped=" + dropped + " depth=" + depth;
            }
        }

        /** Returns the sink's pipeline health counters. */
        public Stats stats() {
            return new Stats(ingested.get(), dropped.get(), spool.size() + pendingDepth.get());
        }

        // DiskSpool is the durable spool: an append-only log of the records since
        // its last compaction, one base64-encoded record per line, and a cursor
        // counting how many of them the publisher has acknowledged. Only the
        // drain thread touches it after construction.
        private static final class DiskSpool {
            private final java.nio.file.Path dir;
            private final java.util.List<byte[]> unacked;
            private int acked;   // records the publisher has acknowledged: the cursor
            private int saved;   // the cursor as last written
            private int total;   // records in the log
            private long size;   // bytes in the log

            DiskSpool(java.nio.file.Path dir) {
                this.dir = dir;
                this.acked = readCursor(dir);
                this.saved = acked;
                java.util.List<byte[]> lines = AppendLog.readLines(dir, SPOOL_LOG);
                if (acked > lines.size()) {
                    throw DiskStoreException.invalidData("accounting spool cursor " + acked + " is past its "
                            + lines.size() + " records in " + dir);
                }
                this.total = lines.size();
                this.unacked = new java.util.ArrayList<>(lines.subList(acked, lines.size()));
                for (byte[] line : lines) {
                    size += line.length + 1L;
                }
            }

            // pendingLines returns the lines the publisher had not acknowledged, in order.
            java.util.List<byte[]> pendingLines() {
                return unacked;
            }

            // append writes one record line to the log. It fails without writing
            // when the record would take the spool past SPOOL_BYTES.
            void append(byte[] line) {
                if (size + line.length + 1L > SPOOL_BYTES) {
                    throw DiskStoreException.invalidData("accounting spool full");
                }
                AppendLog.append(dir, SPOOL_LOG, line, 0600);
                total++;
                size += line.length + 1L;
            }

            // ack advances the cursor past one acknowledged record. When every
            // record in the log has been acknowledged, the log is removed. The
            // cursor goes back to zero first, so a crash between the two steps
            // republishes records the bus already has rather than losing one.
            void ack() {
                acked++;
                if (acked == total) {
                    try {
                        writeCursor(dir, 0);
                    } catch (DiskStoreException e) {
                        acked--;
                        throw e;
                    }
                    saved = 0;
                    acked = 0;
                    total = 0;
                    size = 0;
                    try {
                        java.nio.file.Files.deleteIfExists(dir.resolve(SPOOL_LOG));
                    } catch (java.io.IOException e) {
                        throw DiskStoreException.io("remove accounting spool log: " + e.getMessage(), e);
                    }
                    return;
                }
                if (acked - saved >= CURSOR_EVERY) {
                    writeCursor(dir, acked);
                    saved = acked;
                }
            }

            // flush writes the cursor if it has moved since it was last written.
            void flush() {
                if (acked != saved) {
                    writeCursor(dir, acked);
                    saved = acked;
                }
            }

            private static int readCursor(java.nio.file.Path dir) {
                if (!PlainFile.exists(dir, SPOOL_CURSOR)) {
                    return 0;
                }
                String raw = new String(PlainFile.readAll(dir, SPOOL_CURSOR), java.nio.charset.StandardCharsets.UTF_8).trim();
                try {
                    int n = Integer.parseInt(raw);
                    if (n < 0) {
                        throw new NumberFormatException(raw);
                    }
                    return n;
                } catch (NumberFormatException e) {
                    throw DiskStoreException.invalidData("accounting spool cursor \"" + raw + "\" is not a count");
                }
            }

            // writeCursor writes the cursor atomically (see FsUtil.atomicWrite).
            private static void writeCursor(java.nio.file.Path dir, int n) {
                try {
                    java.nio.file.Files.createDirectories(dir.resolve("accounting-spool"));
                } catch (java.io.IOException e) {
                    throw DiskStoreException.io("create accounting spool dir: " + e.getMessage(), e);
                }
                FsUtil.atomicWrite(dir.resolve(SPOOL_CURSOR), (n + "\n").getBytes(java.nio.charset.StandardCharsets.UTF_8), 0600);
            }
        }
    }
