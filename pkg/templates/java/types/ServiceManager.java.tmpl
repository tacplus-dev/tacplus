    /**
     * Resolves EventBus for trace publishing. Initial resolution can fail while
     * EventBus or ServiceHealthState is still starting, so keep retrying instead
     * of leaving wrappers with a publisher queue that nobody drains.
     */
    private void tracePublishResolveLoop(BlockingQueue<Trace.TraceEvent> queue) {
        long backoff = ReconnectBackoff.INITIAL_MS;
        Trace.TraceEvent pending = null;

        while (!Thread.currentThread().isInterrupted()) {
            try {
                if (pending == null) {
                    pending = queue.poll(1, TimeUnit.SECONDS);
                    if (pending == null) {
                        continue;
                    }
                }
                io.grpc.Channel ebConn = resolveService("{{.TracePublisherTarget}}");
                tracePublishStream(ebConn, pending);
                pending = null;
                backoff = ReconnectBackoff.INITIAL_MS;
            } catch (Exception e) {
                LOG.warning("trace publisher: publish attempt failed for broker {{.TracePublisherTarget}}, retrying in " + backoff + "ms: " + e.getMessage());
                try { Thread.sleep(ReconnectBackoff.jitterMs(backoff)); } catch (InterruptedException ie) {
                    Thread.currentThread().interrupt();
                    return;
                }
                backoff = ReconnectBackoff.next(backoff);
            }
        }
    }

