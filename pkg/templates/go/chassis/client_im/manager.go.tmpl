	var backoff time.Duration
	switch failures {
	case 1:
		backoff = 10 * time.Second
	case 2:
		backoff = 30 * time.Second
	case 3:
		backoff = 60 * time.Second
	case 4:
		backoff = 120 * time.Second
	default:
		backoff = 300 * time.Second
	}
	if last.IsZero() {
		return true
	}
	return time.Since(last) >= backoff
}
