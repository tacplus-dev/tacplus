    /// Creates a new TLS-enabled gRPC channel to the specified target (host:port).
    /// Uses the same TLS trust configuration as the state-store connection.
    pub async fn create_channel(&self, target: &str) -> Result<Channel, Box<dyn std::error::Error>> {
        let url = if target.starts_with("https://") { target.to_string() } else { format!("https://{}", target) };
        let endpoint = tonic::transport::Endpoint::from_shared(url)?
            .tls_config(self.tls_config.clone())?
            // Keepalive: detect dead-but-open connections (network partitions).
            // Values from keepaliveconst — consistent with all generated clients BY CONSTRUCTION.
            .http2_keep_alive_interval(std::time::Duration::from_secs({{.KeepaliveTimeSecs}}))
            .keep_alive_while_idle(true)
            .keep_alive_timeout(std::time::Duration::from_secs({{.KeepaliveTimeoutSecs}}));
        Ok(endpoint.connect().await?)
    }

