// Dispatcher resolves the connection and auth for outgoing gRPC calls.
//
// A gateway implements this with service resolution + forwarded C2S tokens.
// A daemon implements this with its S2S connections + minted service tokens.
type Dispatcher interface {
	// Conn resolves a gRPC connection for the given service. tenant is the
	// target tenant id of a tenant-routed call, read from the request's route
	// field and already checked to be a tid: the connection must reach that
	// tenant's instance and no other (never another tenant's, never a shared
	// one). tenant is "" for a platform service's call. An error is a gRPC
	// status; it is mapped to an HTTP status by GrpcErr.
	Conn(ctx context.Context, serviceID, tenant string) (grpc.ClientConnInterface, error)

	// AuthHeader resolves the authorization header value for outgoing requests
	// to the given service, or "" to send none.
	// Gateway: forwards the incoming C2S token.
	// Daemon: mints an S2S token scoped to the target service.
	AuthHeader(ctx context.Context, serviceID string) string
}

// HTTPError is a dispatch failure: the HTTP status to answer and a JSON body
// of the form {"error": "..."}.
type HTTPError struct {
	Status int
	Body   string
}

func (e *HTTPError) Error() string { return e.Body }

// Write answers w with the error.
func (e *HTTPError) Write(w http.ResponseWriter) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(e.Status)
	_, _ = io.WriteString(w, e.Body)
}

// WithMetadata returns ctx carrying the forwarded auth and request ID as
// outgoing gRPC metadata.
func WithMetadata(ctx context.Context, authHeader, requestID string) context.Context {
	pairs := []string{"x-request-id", requestID}
	if authHeader != "" {
		pairs = append(pairs, "authorization", authHeader)
	}
	return metadata.AppendToOutgoingContext(ctx, pairs...)
}

// errorBody builds a JSON error body, escaping the message so it cannot break
// out of the JSON string or inject additional fields.
func errorBody(message string) string {
	body, err := json.Marshal(map[string]string{"error": message})
	if err != nil {
		return `{"error":"unrepresentable error message"}`
	}
	return string(body)
}

func httpError(code int, message string) *HTTPError {
	return &HTTPError{Status: code, Body: errorBody(message)}
}

// GrpcErr converts a gRPC error to an HTTP error.
func GrpcErr(err error) *HTTPError {
	st, _ := status.FromError(err)
	var code int
	switch st.Code() {
	case codes.NotFound:
		code = http.StatusNotFound
	case codes.InvalidArgument:
		code = http.StatusBadRequest
	case codes.Unauthenticated:
		code = http.StatusUnauthorized
	case codes.PermissionDenied:
		code = http.StatusForbidden
	case codes.Unimplemented:
		code = http.StatusNotImplemented
	case codes.Unavailable:
		code = http.StatusServiceUnavailable
	case codes.DeadlineExceeded:
		code = http.StatusGatewayTimeout
	case codes.ResourceExhausted:
		code = http.StatusTooManyRequests
	default:
		code = http.StatusInternalServerError
	}
	return httpError(code, st.Message())
}

