fn build_assertion_xml(b: &SamlAssertionBuilder) -> Result<String, SamlError> {
    let mut audiences_xml = String::new();
    for aud in &b.audiences {
        audiences_xml.push_str(&format!(
            "<saml:Audience>{}</saml:Audience>",
            xml_escape(aud)
        ));
    }

    let mut attrs_xml = String::new();
    if !b.attributes.is_empty() {
        attrs_xml.push_str("<saml:AttributeStatement>");
        for (name, value) in &b.attributes {
            attrs_xml.push_str(&format!(
                "<saml:Attribute Name=\"{name}\" NameFormat=\"urn:oasis:names:tc:SAML:2.0:attrname-format:basic\">\
                 <saml:AttributeValue xsi:type=\"xs:string\">{value}</saml:AttributeValue>\
                 </saml:Attribute>",
                name  = xml_escape_attr(name),
                value = xml_escape(value),
            ));
        }
        attrs_xml.push_str("</saml:AttributeStatement>");
    }

    let in_response_to_attr = if b.in_response_to.is_empty() {
        String::new()
    } else {
        format!(" InResponseTo=\"{}\"", xml_escape_attr(&b.in_response_to))
    };

    Ok(format!(
        "<saml:Assertion \
           xmlns:saml=\"urn:oasis:names:tc:SAML:2.0:assertion\" \
           xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" \
           xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" \
           ID=\"{id}\" \
           Version=\"2.0\" \
           IssueInstant=\"{issue_instant}\">\
         <saml:Issuer>{issuer}</saml:Issuer>\
         <saml:Subject>\
           <saml:NameID Format=\"{name_id_format}\">{subject_name_id}</saml:NameID>\
           <saml:SubjectConfirmation Method=\"urn:oasis:names:tc:SAML:2.0:cm:bearer\">\
             <saml:SubjectConfirmationData{in_response_to_attr} \
               NotOnOrAfter=\"{subject_noa}\" \
               Recipient=\"{subject_recipient}\"/>\
           </saml:SubjectConfirmation>\
         </saml:Subject>\
         <saml:Conditions NotBefore=\"{not_before}\" NotOnOrAfter=\"{not_on_or_after}\">\
           <saml:AudienceRestriction>{audiences_xml}</saml:AudienceRestriction>\
         </saml:Conditions>\
         <saml:AuthnStatement AuthnInstant=\"{authn_instant}\" SessionIndex=\"{session_index}\">\
           <saml:AuthnContext>\
             <saml:AuthnContextClassRef>{authn_context}</saml:AuthnContextClassRef>\
           </saml:AuthnContext>\
         </saml:AuthnStatement>\
         {attrs_xml}\
         </saml:Assertion>",
        id                  = xml_escape_attr(&b.id),
        issue_instant       = xml_escape_attr(&b.issue_instant),
        issuer              = xml_escape(&b.issuer),
        name_id_format      = xml_escape_attr(&b.name_id_format),
        subject_name_id     = xml_escape(&b.subject_name_id),
        in_response_to_attr = in_response_to_attr,
        subject_noa         = xml_escape_attr(&b.subject_not_on_or_after),
        subject_recipient   = xml_escape_attr(&b.subject_recipient),
        not_before          = xml_escape_attr(&b.not_before),
        not_on_or_after     = xml_escape_attr(&b.not_on_or_after),
        audiences_xml       = audiences_xml,
        authn_instant       = xml_escape_attr(&b.authn_instant),
        session_index       = xml_escape_attr(&b.session_index),
        authn_context       = xml_escape(&b.authn_context),
        attrs_xml           = attrs_xml,
    ))
}

fn build_signed_info_xml(assertion_id: &str, digest_b64: &str) -> String {
    format!(
        "<ds:SignedInfo xmlns:ds=\"http://www.w3.org/2000/09/xmldsig#\">\
         <ds:CanonicalizationMethod Algorithm=\"http://www.w3.org/2001/10/xml-exc-c14n#\"/>\
         <ds:SignatureMethod Algorithm=\"http://www.w3.org/2001/04/xmldsig-more#ecdsa-sha256\"/>\
         <ds:Reference URI=\"#{ref_id}\">\
           <ds:Transforms>\
             <ds:Transform Algorithm=\"http://www.w3.org/2000/09/xmldsig#enveloped-signature\"/>\
             <ds:Transform Algorithm=\"http://www.w3.org/2001/10/xml-exc-c14n#\"/>\
           </ds:Transforms>\
           <ds:DigestMethod Algorithm=\"http://www.w3.org/2001/04/xmlenc#sha256\"/>\
           <ds:DigestValue>{digest}</ds:DigestValue>\
         </ds:Reference>\
         </ds:SignedInfo>",
        ref_id = xml_escape_attr(assertion_id),
        digest = digest_b64,
    )
}

fn build_signature_element(
