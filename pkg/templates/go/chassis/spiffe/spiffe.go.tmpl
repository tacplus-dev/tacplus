// ParsedSpiffeID is the structured form of a SPIFFE ID. Parsing is
// self-describing: no out-of-band prefix is supplied; the kind is recovered from
// typed tags.
type ParsedSpiffeID struct {
	Scheme       string
	TrustDomain  string
	PathSegments []string
	Namespace    string
	SubjectKind  SubjectKind
	SubjectPath  string // location-agnostic for service/workload; the leaf for user/client
	LocationPath string // for system/service/workload identities
	ResourceKind string
	ResourceID   string
}

// Reconstruct rebuilds the canonical SPIFFE ID string from the parsed parts.
func (p ParsedSpiffeID) Reconstruct() string {
	if len(p.PathSegments) == 0 {
		return p.Scheme + "://" + p.TrustDomain
	}
	return p.Scheme + "://" + p.TrustDomain + "/" + strings.Join(p.PathSegments, "/")
}

// ParseSpiffeID parses and validates a full SPIFFE ID, failing closed on
// malformed input.
func ParseSpiffeID(value string) (ParsedSpiffeID, error) {
	var p ParsedSpiffeID
	v := strings.TrimSpace(value)
	prefix := Scheme + "://"
	if !strings.HasPrefix(v, prefix) {
		return p, fmt.Errorf("spiffe: missing %q scheme: %q", prefix, value)
	}
	rest := v[len(prefix):]
	if err := rejectDangerous(rest); err != nil {
		return p, err
	}
	if strings.ContainsAny(rest, "?#\\") {
		return p, fmt.Errorf("spiffe: query, fragment, or backslash not allowed: %q", value)
	}
	td := rest
	pathStr := ""
	if i := strings.Index(rest, "/"); i >= 0 {
		td = rest[:i]
		pathStr = rest[i+1:]
	}
	if td == "" {
		return p, fmt.Errorf("spiffe: empty trust domain: %q", value)
	}
	if strings.ContainsAny(td, "/\\?#") {
		return p, fmt.Errorf("spiffe: malformed trust domain: %q", value)
	}
	p.Scheme = Scheme
	p.TrustDomain = td

	if pathStr == "" {
		p.Namespace = "/"
		return p, nil
	}
	segs := strings.Split(pathStr, "/")
	for _, s := range segs {
		if s == "" {
			return p, fmt.Errorf("spiffe: empty path segment in %q", value)
		}
		if s == "." || s == ".." {
			return p, fmt.Errorf("spiffe: dot segment not allowed in %q", value)
		}
		if !segmentRe.MatchString(s) {
			return p, fmt.Errorf("spiffe: path segment %q violates grammar in %q", s, value)
		}
	}
	p.PathSegments = segs

	if err := classify(&p, segs); err != nil {
		return p, err
	}
	return p, nil
}

func classify(p *ParsedSpiffeID, segs []string) error {
	idx := tagIndexes(segs)
	switch {
	case idx[WorkloadsSegment] >= 0:
		p.SubjectKind = KindWorkload
		return classifySystem(p, segs)
	case (segs[0] == SystemSegment || segs[0] == TenantsSegment) && idx[ServicesSegment] >= 0:
		p.SubjectKind = KindService
		return classifySystem(p, segs)
	case idx[UsersSegment] >= 0:
		return classifyNamespaced(p, segs, idx[UsersSegment], KindUser)
	case idx[ClientsSegment] >= 0:
		return classifyNamespaced(p, segs, idx[ClientsSegment], KindClient)
	case idx[CredentialsSegment] >= 0:
		return classifyPair(p, segs, idx[CredentialsSegment], KindUnknown)
	case idx[DataSegment] >= 0:
		return classifyPair(p, segs, idx[DataSegment], KindResource)
	default:
		// Namespace-only identity (tenant/workspace/system subtree).
		p.SubjectKind = KindUnknown
		p.Namespace = "/" + strings.Join(segs, "/")
		return nil
	}
}

// classifySystem handles both service-root shapes: /system/<location...>/services/<svc>
// (shared services, location-agnostic) and /tenants/<tenant>/services/<svc> (tenant-owned
// services, one operator-managed instance per tenant). Namespace is everything before
// "services"; for the tenant root that's exactly "/tenants/<tenant>", no location.
func classifySystem(p *ParsedSpiffeID, segs []string) error {
	si := indexOf(segs, ServicesSegment)
	if (segs[0] != SystemSegment && segs[0] != TenantsSegment) || si < 0 || si+1 >= len(segs) {
		return fmt.Errorf("spiffe: malformed system/service identity: /%s", strings.Join(segs, "/"))
	}
	p.LocationPath = strings.Join(segs[1:si], "/")
	p.Namespace = "/" + strings.Join(segs[:si], "/") // /system[/location...] or /tenants/<tenant>
	p.SubjectPath = strings.Join(segs[si+1:], "/")    // <service>[/workloads/<child>...]
	return nil
}

func classifyNamespaced(p *ParsedSpiffeID, segs []string, tagIdx int, kind SubjectKind) error {
	if tagIdx+1 >= len(segs) || tagIdx == 0 {
		return fmt.Errorf("spiffe: malformed %s identity: /%s", kind, strings.Join(segs, "/"))
	}
	p.SubjectKind = kind
	p.Namespace = "/" + strings.Join(segs[:tagIdx], "/")
	p.SubjectPath = strings.Join(segs[tagIdx+1:], "/")
	return nil
}

func classifyPair(p *ParsedSpiffeID, segs []string, tagIdx int, kind SubjectKind) error {
	if tagIdx == 0 || tagIdx+2 >= len(segs) {
		return fmt.Errorf("spiffe: malformed kind/id identity: /%s", strings.Join(segs, "/"))
	}
	p.SubjectKind = kind
	p.Namespace = "/" + strings.Join(segs[:tagIdx], "/")
	p.ResourceKind = segs[tagIdx+1]
	p.ResourceID = strings.Join(segs[tagIdx+2:], "/")
	return nil
}

// ParseNamespaceOrSpiffe accepts either a bare namespace path or a full SPIFFE
// URI and returns the normalized namespace path.
func ParseNamespaceOrSpiffe(value string) (string, error) {
	v := strings.TrimSpace(value)
	if strings.HasPrefix(v, Scheme+"://") {
		p, err := ParseSpiffeID(v)
		if err != nil {
			return "", err
		}
		return NormalizeNamespace(p.Namespace)
	}
	return NormalizeNamespace(v)
}

// ServicePathFromSpiffe returns the LOCATION-AGNOSTIC service identity: the bare
// service label plus any /workloads/<child> suffix, with /system/<location...>/
// stripped. So the same service matches identically across clouds/accounts/AZs/
// clusters in auth_services. (Location-scoped authz is deferred; see plan D2.)
func ServicePathFromSpiffe(spiffeID string) (string, error) {
	p, err := ParseSpiffeID(spiffeID)
	if err != nil {
		return "", err
	}
	if p.SubjectKind != KindService && p.SubjectKind != KindWorkload {
		return "", fmt.Errorf("spiffe: not a service/workload identity: %q", spiffeID)
	}
	return p.SubjectPath, nil
}

// NamespaceFromSpiffe returns the normalized namespace of a SPIFFE ID.
func NamespaceFromSpiffe(spiffeID string) (string, error) {
	p, err := ParseSpiffeID(spiffeID)
	if err != nil {
		return "", err
	}
	return NormalizeNamespace(p.Namespace)
}

// ResourceParts is the (kind, id) of a resource SPIFFE ID.
type ResourceParts struct {
	Namespace string
	Kind      string
	ID        string
}

// ResourcePartsFromSpiffe extracts the resource parts from a resource SPIFFE ID.
func ResourcePartsFromSpiffe(spiffeID string) (ResourceParts, error) {
	p, err := ParseSpiffeID(spiffeID)
	if err != nil {
		return ResourceParts{}, err
	}
	if p.SubjectKind != KindResource {
		return ResourceParts{}, fmt.Errorf("spiffe: not a resource identity: %q", spiffeID)
	}
	return ResourceParts{Namespace: p.Namespace, Kind: p.ResourceKind, ID: p.ResourceID}, nil
}

// ---- Comparison. ----

// IsAtOrBelow reports whether target is the same as caller or a strict
// path-segment descendant in the NAMESPACE (authorization) tree.
func IsAtOrBelow(callerNamespace, targetNamespace string) bool {
	caller := trimNamespace(callerNamespace)
	target := trimNamespace(targetNamespace)
	if caller == "" || target == "" {
		return false
	}
	if caller == target {
		return true
	}
	if caller == "/" {
		return strings.HasPrefix(target, "/")
	}
	return strings.HasPrefix(target, caller+"/")
}

// IsSpiffeAtOrBelow reports whether the target SPIFFE ID is the same as or a
// path-segment descendant of the caller SPIFFE ID. This is the IDENTITY-path
// relation and is distinct from IsAtOrBelow; the two must not be cross-applied.
func IsSpiffeAtOrBelow(callerSpiffeID, targetSpiffeID string) bool {
	c, err := ParseSpiffeID(callerSpiffeID)
	if err != nil {
		return false
	}
	t, err := ParseSpiffeID(targetSpiffeID)
	if err != nil {
		return false
	}
	if c.TrustDomain != t.TrustDomain {
		return false
	}
	if len(c.PathSegments) > len(t.PathSegments) {
		return false
	}
	for i := range c.PathSegments {
		if c.PathSegments[i] != t.PathSegments[i] {
			return false
		}
	}
	return true
}

// SameTrustDomain reports whether two SPIFFE IDs share a trust domain.
func SameTrustDomain(a, b string) bool {
	pa, err := ParseSpiffeID(a)
	if err != nil {
		return false
	}
	pb, err := ParseSpiffeID(b)
	if err != nil {
		return false
	}
	return pa.TrustDomain == pb.TrustDomain
}

// ---- internal helpers ----

func rejectDangerous(s string) error {
	lower := strings.ToLower(s)
	for _, enc := range []string{"%2f", "%5c"} {
		if strings.Contains(lower, enc) {
			return fmt.Errorf("spiffe: encoded separator %q not allowed: %q", enc, s)
		}
	}
	for _, r := range s {
		if r < 0x20 || r == 0x7f {
			return fmt.Errorf("spiffe: control character not allowed: %q", s)
		}
	}
	return nil
}

func splitPath(p string) []string {
	p = strings.Trim(strings.TrimSpace(p), "/")
	if p == "" {
		return nil
	}
	return strings.Split(p, "/")
}

func trimNamespace(ns string) string {
	ns = strings.TrimSpace(ns)
	if ns == "" {
		return ""
	}
	if !strings.HasPrefix(ns, "/") {
		ns = "/" + ns
	}
	trimmed := strings.TrimRight(ns, "/")
	if trimmed == "" {
		return "/"
	}
	return trimmed
}

func tagIndexes(segs []string) map[string]int {
	out := map[string]int{
		WorkloadsSegment: -1, ServicesSegment: -1, UsersSegment: -1,
		ClientsSegment: -1, CredentialsSegment: -1, DataSegment: -1,
	}
	for i, s := range segs {
		if _, ok := out[s]; ok && out[s] == -1 {
			out[s] = i
		}
	}
	return out
}

func indexOf(segs []string, tag string) int {
	for i, s := range segs {
		if s == tag {
			return i
		}
	}
	return -1
}
