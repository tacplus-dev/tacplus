    #[allow(dead_code)]
    fn spawn_owned<F>(&self, task: F)
    where
        F: Future<Output = ()> + Send + 'static,
    {
        let handle = tokio::spawn(task);
        self.tasks.lock().unwrap().push(handle);
    }

	    async fn shutdown_owned_tasks(&self) {
        let handles: Vec<_> = {
            let mut tasks = self.tasks.lock().unwrap();
            tasks.drain(..).collect()
        };
        for task in handles.iter() {
            task.abort();
        }
        for handle in handles {
            let _ = handle.await;
        }
	    }

{{- if .HasDiskStores}}
    fn start_disk_store_roll_schedulers(
        &self,
        handler: Arc<dyn Handler>,
    ) -> Result<(), Box<dyn std::error::Error>> {
        let Some(persistence) = self.cfg.disk_persistence.as_ref() else {
            return Ok(());
        };
        let Some(logs) = self.disk_store_logs.clone() else {
            return Ok(());
        };
        if persistence.roll_interval_seconds <= 0 {
            return Err("grpcconfig.disk_persistence.roll_interval_seconds must be positive".into());
        }
        let interval = std::time::Duration::from_secs(persistence.roll_interval_seconds as u64);
        let mut node_id = self.instance_id().to_string();
        if node_id.is_empty() {
            node_id = "{{.ServiceLabel}}".to_string();
        }
{{- range .DiskStores}}
        {
            let log = logs.{{.LogField}}.clone();
            let handler_for_roll = handler.clone();
            let scheduler_node_id = format!("{}/{{.StoreName}}", node_id);
            self.spawn_owned(async move {
                if let Err(err) = diskstore::run_roll_scheduler(
                    log.as_ref(),
                    interval,
                    &scheduler_node_id,
                    move || {
                        let h = handler_for_roll.clone();
                        async move {
                            match h.{{.HandlerGetter}}().list(None).await {
                                Ok(response) => {
                                    match diskstore_stores::snapshot_{{.StoreName}}(&response.items) {
                                        Ok(records) => records,
                                        Err(err) => {
                                            tracing::warn!(
                                                store = "{{.StoreName}}",
                                                error = %err,
                                                "diskstore snapshot encode failed; roll will retry on next interval"
                                            );
                                            Vec::new()
                                        }
                                    }
                                }
                                Err(err) => {
                                    tracing::warn!(
                                        store = "{{.StoreName}}",
                                        error = %err,
                                        "diskstore snapshot failed; roll will retry on next interval"
                                    );
                                    Vec::new()
                                }
                            }
                        }
                    },
                )
                .await
                {
                    tracing::warn!(
                        store = "{{.StoreName}}",
                        error = %err,
                        "diskstore roll scheduler stopped"
                    );
                }
            });
        }
{{- end}}
        Ok(())
    }
{{- end}}

