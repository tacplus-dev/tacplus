                    }
                    None => {
                        let elapsed_s = init_start.elapsed().as_secs();
                        if attempt >= MAX_INIT_RETRIES {
                            tracing::error!(service = "{{.ServiceLabel}}", attempts = attempt, elapsed_s,
                                "ServiceManager startup failed: no state-store connection after max retries");
                            return Err("no active state-store connection after max retries".into());
                        }
                        tracing::warn!(service = "{{.ServiceLabel}}", attempt, max = MAX_INIT_RETRIES, elapsed_s,
                            "ServiceManager init: no state-store connection, retrying in 2s");
                        tokio::time::sleep(std::time::Duration::from_secs(2)).await;
                    }
                }
