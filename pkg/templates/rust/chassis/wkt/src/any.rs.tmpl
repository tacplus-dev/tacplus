#[cfg(test)]
mod tests {
    use super::*;
    use crate::Timestamp;

    #[test]
    fn any_json_round_trips() {
        let ts = Timestamp { seconds: 1_700_000_000, nanos: 0 };
        let any = Any::from_msg(&ts).unwrap();
        let json = serde_json::to_string(&any).unwrap();
        assert_eq!(json, r#"{"@type":"type.googleapis.com/google.protobuf.Timestamp","value":[8,128,226,207,170,6]}"#);
        let back: Any = serde_json::from_str(&json).unwrap();
        assert_eq!(back, any);
        assert_eq!(back.to_msg::<Timestamp>().unwrap(), ts);
    }

    #[test]
    fn any_json_value_may_be_base64() {
        let back: Any = serde_json::from_str(r#"{"@type":"type.googleapis.com/google.protobuf.Timestamp","value":"CIDiz6oG"}"#).unwrap();
        assert_eq!(back.to_msg::<Timestamp>().unwrap(), Timestamp { seconds: 1_700_000_000, nanos: 0 });
    }

    #[test]
    fn any_json_without_its_bytes_is_refused() {
        assert!(serde_json::from_str::<Any>(r#"{"value":[]}"#).is_err());
        assert!(serde_json::from_str::<Any>(r#"{"@type":"type.googleapis.com/x.Y","name":"n"}"#).is_err());
    }

    #[test]
    fn to_msg_checks_the_type() {
