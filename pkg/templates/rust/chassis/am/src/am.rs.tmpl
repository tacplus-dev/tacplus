/// Builds an ErrorContext from the current call site.
/// Rust captures file/line via `std::panic::Location` or `file!()`.
/// Full stack traces use `std::backtrace::Backtrace` (nightly) or omitted.
#[track_caller]
pub fn capture_error_context(should_capture_stack: bool) -> ErrorContext {
    let loc = std::panic::Location::caller();
    let mut ec = ErrorContext {
        caller: format!("{}:{}", loc.file(), loc.line()),
        function: String::new(),
        stack_trace: String::new(),
    };
    if should_capture_stack {
        ec.stack_trace = format!("{:?}", std::backtrace::Backtrace::force_capture());
    }
    ec
}

/// Returns true for tonic status codes that indicate our bugs
/// (Internal, Unknown, DataLoss). Returns false for user errors.
pub fn should_capture_stack(code: tonic::Code) -> bool {
    matches!(
        code,
        tonic::Code::Internal | tonic::Code::Unknown | tonic::Code::DataLoss
    )
}

/// Extracts the tonic status code from a tonic::Status.
