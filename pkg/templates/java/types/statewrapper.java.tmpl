    /**
     * One-shot Get RPC: fetches the authoritative {{.TypeName}} from the state service.
     * Requires setChannel() to have been called.
     *
     * <p>A singleton Get can race the state authority's own convergence and return a
     * value that has not been fully seeded yet — the wire carries no "found" bit to
     * tell that apart. Retries with the watch-restart backoff for as long as the
     * fetched value fails its own generated validation, bounded by
     * config_fetch_timeout_seconds, and throws once that budget is spent rather than
     * returning a value it knows is invalid.</p>
     *
     * <p>The Get itself is retried while the state service answers UNAVAILABLE
     * (a kernel roll or restart refusing connections), on the chassis reconnect
     * backoff and with no bound: the service waits for the kernel to answer. Any
     * other status is thrown immediately.</p>
     *
     * <p>The wire carries no proto defaults, so this applies the type's generated
     * defaults to every fetched value BEFORE validating it. Without that, a field
     * the seeded state omits on purpose — because it carries a (spec.default_*) —
     * arrives zero-valued and fails its own (spec.assert_*) check, and the retry
     * loop burns its whole budget on a value that should have passed.</p>
     */
    public {{.JavaType}} fetch{{.FieldPascal}}() {
        if (stateStub == null) {
            throw new IllegalStateException("stateStub not initialized - call setChannel() first");
        }
        long timeoutSeconds = this.configFetchTimeoutSeconds;
        long deadlineNanos = System.nanoTime() + timeoutSeconds * 1_000_000_000L;
        for (int attempt = 0; ; attempt++) {
            {{.JavaType}} value = {{$.BackoffFQN}}.retryWhileUnavailable(
                    () -> stateStub.get{{.FieldPascal}}(Trace.TraceRequest.getDefaultInstance()),
                    {{$.BackoffFQN}}.THREAD_SLEEPER);
{{- if .DefaultsRef}}
            value = {{.DefaultsRef}}(value).build();
{{- end}}
            try {
                {{.ValidateRef}}(value);
            } catch (ProtoException cause) {
                if (!sleepBeforeFetchRetry(attempt, deadlineNanos)) {
                    throw Status.FAILED_PRECONDITION
                            .withDescription("Get{{.FieldPascal}}: state value still failed validation after "
                                    + timeoutSeconds + "s: " + cause.getMessage())
                            .withCause(cause)
                            .asRuntimeException();
                }
                continue;
            }
            synchronized (cacheLock) {
                this.{{.FieldName}} = value;
            }
            return value;
        }
    }

