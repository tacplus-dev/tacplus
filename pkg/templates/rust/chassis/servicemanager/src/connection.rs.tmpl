    /// Reconciles endpoints from ServiceHealthState data.
    ///
    /// Called by the health poller for dynamic connections. Eagerly connects
    /// to new endpoints, drops removed ones, and reselects the active endpoint.
    pub async fn reconcile_from_health(&self, instances: &[&ServiceInstanceHealth]) {
        // Build incoming target→health map
        let mut incoming: HashMap<String, &ServiceInstanceHealth> = HashMap::new();
        for inst in instances {
            if let Some(ep) = &inst.grpc_endpoint {
                if !ep.host.is_empty() && ep.port > 0 {
                    let target = format!("{}:{}", ep.host, ep.port);
                    incoming.insert(target, inst);
                }
            }
        }

        let mut ep_list = self.endpoints.write().await;

        // Build current target set
        let mut current: HashSet<String> = HashSet::new();
        for ec in ep_list.iter() {
            current.insert(ec.read().await.target.clone());
        }

        // Partition: keep (update health) vs close
        let mut kept = Vec::new();
        for ec in ep_list.drain(..) {
            let target = ec.read().await.target.clone();
            if let Some(h) = incoming.get(&target) {
                // Update health from state
                let mut conn = ec.write().await;
                conn.absent_polls = 0;
                conn.update_health_from_state(h.status, h.p50_latency_us).await;
                drop(conn);
                kept.push(ec);
            } else {
                // Absent. Kept, with its last health, until ABSENT_POLLS_BEFORE_CLOSE
                // snapshots in a row omit it.
                let mut conn = ec.write().await;
                conn.absent_polls += 1;
                if conn.absent_polls < ABSENT_POLLS_BEFORE_CLOSE {
                    drop(conn);
                    kept.push(ec);
                } else {
                    drop(conn);
                    info!(service = %self.service_id, target = %target, "closing removed endpoint");
                }
            }
        }

        // Connect to new endpoints
        for (target, h) in &incoming {
            if current.contains(target) {
                continue;
            }
            if h.status == InstanceStatus::Unhealthy as i32 {
                continue;
            }
            let ec = Arc::new(RwLock::new(EndpointConn::new(target.clone())));
            {
                let mut conn = ec.write().await;
                match conn.dial(self.verifier.clone()).await {
                    Ok(()) => {
                        conn.update_health_from_state(h.status, h.p50_latency_us).await;
                        drop(conn);
                        info!(service = %self.service_id, target = %target, "connected to new endpoint");
                        kept.push(ec);
                    }
                    Err(e) => {
                        warn!(service = %self.service_id, target = %target, error = %e, "failed to connect");
                    }
                }
            }
        }

        *ep_list = kept;

        // Reselect active
        Self::do_select_active(&ep_list, &self.active_idx).await;
    }

    /// Selects the lowest-latency healthy endpoint as active.
    /// Uses hysteresis (30% improvement threshold) to avoid thrashing.
    async fn do_select_active(
        endpoints: &[Arc<RwLock<EndpointConn>>],
        active_idx: &Arc<RwLock<usize>>,
    ) {
        let mut best_idx = None;
        let mut best_latency = Duration::MAX;
        for (i, ec) in endpoints.iter().enumerate() {
            let conn = ec.read().await;
            if conn.is_healthy().await && conn.channel.is_some() {
                let lat = conn.get_latency().await;
                if lat < best_latency {
                    best_idx = Some(i);
                    best_latency = lat;
                }
            }
        }
        if let Some(new_idx) = best_idx {
            let mut idx = active_idx.write().await;
            if *idx != new_idx && *idx < endpoints.len() {
                let current_latency = endpoints[*idx].read().await.get_latency().await;
                if current_latency == Duration::MAX || best_latency == Duration::MAX {
                    *idx = new_idx;
                } else {
                    let improvement = (current_latency.as_nanos() as f64 - best_latency.as_nanos() as f64)
                        / current_latency.as_nanos() as f64;
                    if improvement >= REBALANCE_THRESHOLD {
                        *idx = new_idx;
                    }
                }
            } else if *idx >= endpoints.len() {
                *idx = new_idx;
            }
        }
    }
