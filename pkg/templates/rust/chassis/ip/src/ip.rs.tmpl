#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_parse_format_ipv4() {
        let v = parse_ipv4("192.168.1.100").unwrap();
        assert_eq!(format_ipv4(&v), "192.168.1.100");
    }

    #[test]
    fn test_parse_format_ipv6() {
        let v = parse_ipv6("2001:db8::1").unwrap();
        assert_eq!(format_ipv6(&v), "2001:db8::1");
    }

    #[test]
    fn test_contains_v4() {
        let net = parse_ip_net("10.0.0.0/8").unwrap();
        let inside = parse_ip_addr("10.1.2.3").unwrap();
        let outside = parse_ip_addr("11.0.0.1").unwrap();
        assert!(contains(&net, &inside));
        assert!(!contains(&net, &outside));
    }

    #[test]
    fn test_aggregate_adjacent() {
        let nets = IPNets {
            nets: vec![
                parse_ip_net("10.0.0.0/25").unwrap(),
                parse_ip_net("10.0.0.128/25").unwrap(),
            ],
        };
        let result = aggregate(&nets);
        assert_eq!(result.nets.len(), 1);
        assert_eq!(format_ip_net(&result.nets[0]), "10.0.0.0/24");
    }

    #[test]
    fn test_match_ipv4() {
        let nets = parse_ip_nets("10.0.0.0/8,192.168.0.0/16").unwrap();
        let v4 = parse_ipv4("10.1.2.3").unwrap();
        assert!(match_ipv4(&nets, &v4));
        let v4_out = parse_ipv4("11.0.0.1").unwrap();
        assert!(!match_ipv4(&nets, &v4_out));
    }
