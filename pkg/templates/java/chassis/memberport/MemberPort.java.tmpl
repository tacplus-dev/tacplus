                            byte[] token = new byte[length];
                            in.readFully(token);
                            long exp;
                            try {
                                exp = verifyPeer(new String(token, StandardCharsets.UTF_8));
                            } catch (RefusedException e) {
                                close("refreshed token refused: " + e.getMessage());
                                return;
                            }
                            peerExpMillis = exp;
                            scheduleExpiry(exp);
                        }
                        case FRAME_DATA -> {
                            if (length <= 0 || length > MAX_DATA_BYTES || peerWriteClosed) {
                                close(peerWriteClosed ? "DATA after CLOSE_WRITE" : "DATA frame of " + length + " bytes");
                                return;
                            }
                            in.readFully(buf, 0, length);
                            if (System.currentTimeMillis() >= peerExpMillis) {
                                close("peer token expired");
                                return;
                            }
                            local.write(buf, 0, length);
                            local.flush();
                        }
                        case FRAME_CLOSE_WRITE -> {
                            if (length != 0 || peerWriteClosed) {
                                close("malformed CLOSE_WRITE");
                                return;
                            }
                            peerWriteClosed = true;
                            plain.shutdownOutput();
                            halfClosed();
                        }
                        default -> {
                            close("unknown frame type " + type);
                            return;
                        }
                    }
                }
            } catch (IOException e) {
                close("member stream: " + describe(e));
            }
        }

        private void send(int type, byte[] payload, int off, int len) throws IOException {
            synchronized (writeLock) {
                writeFrame(out, type, payload, off, len);
            }
        }

        /** Both directions have half-closed: the connection ends cleanly. */
        private void halfClosed() {
            if (halvesClosed.incrementAndGet() == 2) {
                close(null);
            }
        }

        private void scheduleExpiry(long expMillis) {
            long delay = Math.max(0, expMillis - System.currentTimeMillis());
            ScheduledFuture<?> previous = expiryTimer;
            expiryTimer = schedule(() -> {
                if (System.currentTimeMillis() >= peerExpMillis) {
                    close("peer token expired without a refresh");
                }
            }, delay);
            if (previous != null) {
                previous.cancel(false);
            }
        }

        /**
         * Sends a newer token in-band before this side's expires: checked at a
         * quarter of the remaining lifetime, so the cached token the
         * ServiceManager renews ahead of expiry goes out well before it lapses.
         */
        private void scheduleRefresh() {
            long remaining;
            try {
                remaining = TokenWrapper.parse(lastSent).getExpiration() * 1000L - System.currentTimeMillis();
            } catch (Exception e) {
                remaining = REFRESH_MIN_MS;
            }
            refreshTimer = schedule(this::refresh, Math.max(REFRESH_MIN_MS, Math.min(REFRESH_MAX_MS, remaining / 4)));
        }

        private void refresh() {
            if (done.get()) {
                return;
            }
            try {
                String token = tokenSource.token();
                if (!token.equals(lastSent)) {
                    byte[] bytes = token.getBytes(StandardCharsets.UTF_8);
                    send(FRAME_AUTH, bytes, 0, bytes.length);
                    lastSent = token;
                }
                scheduleRefresh();
            } catch (IOException e) {
                close("sending a refreshed token: " + describe(e));
            } catch (Exception e) {
                // The mint failed: retry. If it keeps failing the peer drops
                // this connection when the token it holds expires.
                LOG.warning("member port: token refresh failed, retrying: " + describe(e));
                refreshTimer = schedule(this::refresh, REFRESH_RETRY_MS);
            }
        }

        /**
         * Runs {@code task} on a worker after the delay: the single timer thread
         * only hands off, so one connection's blocking close or stalled mint
         * never holds up another's expiry or refresh.
         */
        private ScheduledFuture<?> schedule(Runnable task, long delayMillis) {
            if (done.get()) {
                return null;
            }
            try {
                return timers.schedule(() -> {
                    try {
                        workers.execute(task);
                    } catch (RejectedExecutionException e) {
                        close("member port closed");
                    }
                }, delayMillis, TimeUnit.MILLISECONDS);
            } catch (RejectedExecutionException e) {
                close("member port closed");
                return null;
            }
        }

        /** Ends the connection; reason null is a clean end. */
        void close(String reason) {
            if (!done.compareAndSet(false, true)) {
                return;
            }
            tunnels.remove(this);
            cancel(expiryTimer);
            cancel(refreshTimer);
            if (reason != null) {
                LOG.info("member port: connection with " + tls.getRemoteSocketAddress() + " dropped: " + reason);
            }
            closeQuietly(tls);
            closeQuietly(plain);
        }
    }

    // ---- Helpers ----

    private static void cancel(ScheduledFuture<?> f) {
        if (f != null) {
            f.cancel(false);
        }
    }

    private static void writeFrame(OutputStream out, int type, byte[] payload, int off, int len) throws IOException {
        out.write(type);
        out.write(len >>> 24);
        out.write(len >>> 16);
        out.write(len >>> 8);
        out.write(len);
        out.write(payload, off, len);
        out.flush();
    }

    private static void requireAlpn(SSLSocket tls) throws RefusedException {
        if (!ALPN.equals(tls.getApplicationProtocol())) {
            throw new RefusedException("the peer did not negotiate ALPN " + ALPN);
        }
    }

    private static void requireLoopback(String what, InetSocketAddress address) {
        if (address == null || address.isUnresolved() || !address.getAddress().isLoopbackAddress()) {
            throw new IllegalArgumentException("member port: the " + what + " must be a loopback address, got " + address
                    + ": nothing may reach the member protocol except through the member port");
        }
    }

    private void register(ServerSocket s) throws IOException {
        listeners.add(s);
        if (closed.get()) {
            s.close();
            throw new SocketException("member port closed");
        }
    }

    private static void startThread(String name, Runnable body) {
        Thread t = new Thread(body, name);
        t.setDaemon(true);
        t.start();
    }

    private static ThreadFactory daemonThreads(String prefix) {
        AtomicInteger n = new AtomicInteger();
        return r -> {
            Thread t = new Thread(r, prefix + "-" + n.incrementAndGet());
            t.setDaemon(true);
            return t;
        };
    }

    private static X509TrustManager trustManagerFor(List<X509Certificate> cas) throws Exception {
        KeyStore store = KeyStore.getInstance(KeyStore.getDefaultType());
        store.load(null, null);
        int i = 0;
        for (X509Certificate ca : cas) {
            store.setCertificateEntry("ca-" + i++, ca);
        }
        TrustManagerFactory tmf = TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm());
        tmf.init(store);
        for (TrustManager tm : tmf.getTrustManagers()) {
            if (tm instanceof X509TrustManager x509) {
                return x509;
            }
        }
        throw new IllegalStateException("member port: no X509TrustManager available");
    }

    private static String describe(Throwable e) {
        String m = e.getMessage();
        return e.getClass().getSimpleName() + (m == null ? "" : ": " + m);
    }

    private static void closeQuietly(java.io.Closeable c) {
        if (c == null) {
            return;
        }
        try {
            c.close();
        } catch (IOException ignored) {
            // Closing is best effort: the connection is gone either way.
        }
    }

    /** Chain to the fleet bundle, then {@link #verifyPeerCertificate}. */
    private final class MemberTrustManager implements X509TrustManager {
        private final X509TrustManager delegate;

        MemberTrustManager(X509TrustManager delegate) {
            this.delegate = delegate;
        }

        @Override
        public void checkClientTrusted(X509Certificate[] chain, String authType) throws CertificateException {
            throw new CertificateException("member port: clients present tokens, not certificates");
        }

        @Override
        public void checkServerTrusted(X509Certificate[] chain, String authType) throws CertificateException {
            delegate.checkServerTrusted(chain, authType);
            verifyPeerCertificate(chain);
        }

        @Override
        public X509Certificate[] getAcceptedIssuers() {
            return delegate.getAcceptedIssuers();
        }
    }

    /**
     * Serves the current certificate: a renewal applies from the next handshake.
     * Each alias choice takes one snapshot and names it, so the key and the chain
     * the JDK then asks for (in either order) are always one pair.
     */
    private static final class ServingKeyManager extends X509ExtendedKeyManager {
        private static final String ALIAS_PREFIX = "member-";
        private static final int SNAPSHOTS = 64;
        private final ServingCert servingCert;
        private final AtomicLong next = new AtomicLong();
        private final Map<String, Material> snapshots = java.util.Collections.synchronizedMap(
                new java.util.LinkedHashMap<>(SNAPSHOTS, 0.75f, false) {
                    @Override
                    protected boolean removeEldestEntry(Map.Entry<String, Material> eldest) {
                        return size() > SNAPSHOTS;
                    }
                });

        ServingKeyManager(ServingCert servingCert) {
            this.servingCert = servingCert;
        }

        private String snapshot() {
            Material m = servingCert.material();
            if (m == null || m.chain == null || m.chain.length == 0 || m.key == null) {
                return null;
            }
            String alias = ALIAS_PREFIX + next.incrementAndGet();
            snapshots.put(alias, m);
            return alias;
        }

        @Override
        public X509Certificate[] getCertificateChain(String alias) {
            Material m = snapshots.get(alias);
            return m == null ? null : m.chain.clone();
        }

        @Override
        public PrivateKey getPrivateKey(String alias) {
            Material m = snapshots.get(alias);
            return m == null ? null : m.key;
        }

        @Override
        public String[] getServerAliases(String keyType, Principal[] issuers) {
            String alias = snapshot();
            return alias == null ? null : new String[] {alias};
        }

        @Override
        public String chooseServerAlias(String keyType, Principal[] issuers, Socket socket) {
            return snapshot();
        }

        @Override
        public String chooseEngineServerAlias(String keyType, Principal[] issuers, SSLEngine engine) {
            return snapshot();
        }

        @Override
        public String[] getClientAliases(String keyType, Principal[] issuers) {
            return null;
        }

        @Override
        public String chooseClientAlias(String[] keyType, Principal[] issuers, Socket socket) {
            return null;
        }

        @Override
        public String chooseEngineClientAlias(String[] keyType, Principal[] issuers, SSLEngine engine) {
            return null;
        }
    }
}
