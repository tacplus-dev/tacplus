        }
        throw new CertificateException(
                "no peer certificate with canonical service SPIFFE ID for service "
                        + serviceId + " in trust domain " + expectedTrustDomain);
    }

    /**
     * Verifies the peer chain carries a canonical service SPIFFE ID in the
     * configured trust domain — ANY service in the domain (no specific-service
     * pin). Closes CA-only trust (fail-open) on connections where the specific
     * target service is not known at build time, e.g. the bootstrap connection
     * to the token authority (SEC-1 / H1). Fails closed on an absent or
     * malformed trust domain — there is NO CA-only fallback. Mirrors go's
     * wrapperX509.VerifyPeerInTrustDomain and rust's SpiffeServerCertVerifier
     * base (expected_service: None).
     */
    static void verifyPeerInTrustDomain(
            X509Certificate[] chain,
            String trustDomain) throws CertificateException {
        if (trustDomain == null || trustDomain.isEmpty()) {
            throw new CertificateException(
                    "cannot verify peer service identity: no SPIFFE trust domain configured (fail-closed)");
        }
        String expectedTrustDomain;
        try {
            expectedTrustDomain = Spiffe.normalizeTrustDomain(trustDomain);
        } catch (IllegalArgumentException e) {
            throw new CertificateException("invalid configured SPIFFE trust domain: " + trustDomain, e);
        }
        for (X509Certificate cert : chain) {
            var sans = cert.getSubjectAlternativeNames();
            if (sans == null) {
                continue;
            }
            for (var san : sans) {
                int type = (Integer) san.get(0);
                if (type != 6 || san.get(1) == null) {
                    continue;
                }
                Spiffe.ParsedSpiffeId parsed;
                try {
                    parsed = Spiffe.parseSpiffeId(san.get(1).toString());
                } catch (IllegalArgumentException e) {
                    continue;
                }
                if (parsed.subjectKind == Spiffe.SubjectKind.SERVICE
                        && expectedTrustDomain.equals(parsed.trustDomain)) {
                    return;
                }
            }
        }
        throw new CertificateException(
                "no peer certificate with a canonical service SPIFFE ID in trust domain "
                        + expectedTrustDomain);
    }

    // -----------------------------------------------------------------------
    // EndpointConn -- per-endpoint gRPC connection with health tracking
    // -----------------------------------------------------------------------

    static class EndpointConn {
        /**
         * How long the fleet health plane must keep reporting an endpoint as not
         * HEALTHY/DEGRADED before readiness counts it down. Reports go stale or
         * unhealthy for a few seconds at a time on an idle fleet.
         */
        static final long FLEET_DOWN_AFTER_NANOS = TimeUnit.SECONDS.toNanos(30);

        final String target;
        ManagedChannel channel;
        boolean callerSupplied;
        InstanceStatus status = InstanceStatus.INSTANCE_STATUS_STARTING;
        long latencyUs = Long.MAX_VALUE;
        double errorRate;
        /** When the fleet plane last reported HEALTHY or DEGRADED; null until it has. */
        private Long fleetOkAtNanos;
        private final ReentrantReadWriteLock lock = new ReentrantReadWriteLock();

        EndpointConn(String target) {
            this.target = target;
        }

        void connect(String serviceId, ChannelFactory factory) throws Exception {
            this.channel = factory.create(serviceId, target);
            if (!awaitReady(5_000L)) {
                close();
                throw new RuntimeException("channel was not ready within 5000ms");
            }
            lock.writeLock().lock();
            try {
                this.status = InstanceStatus.INSTANCE_STATUS_HEALTHY;
                this.latencyUs = 1;
            } finally {
                lock.writeLock().unlock();
            }
        }

        private boolean awaitReady(long timeoutMs) {
            long deadline = System.nanoTime() + TimeUnit.MILLISECONDS.toNanos(timeoutMs);
            while (System.nanoTime() < deadline) {
                ConnectivityState state = channel.getState(true);
                if (state == ConnectivityState.READY) {
                    return true;
                }
                if (state == ConnectivityState.SHUTDOWN) {
                    return false;
                }
                CountDownLatch latch = new CountDownLatch(1);
                channel.notifyWhenStateChanged(state, latch::countDown);
                long remainingMs = TimeUnit.NANOSECONDS.toMillis(deadline - System.nanoTime());
                if (remainingMs <= 0) {
                    break;
                }
                try {
                    latch.await(Math.min(remainingMs, 500L), TimeUnit.MILLISECONDS);
                } catch (InterruptedException e) {
                    Thread.currentThread().interrupt();
                    return false;
                }
            }
            return channel.getState(false) == ConnectivityState.READY;
        }

        void updateHealth(ServiceInstanceHealth h) {
            lock.writeLock().lock();
            try {
                this.status = h.getStatus();
                if (status == InstanceStatus.INSTANCE_STATUS_HEALTHY
                        || status == InstanceStatus.INSTANCE_STATUS_DEGRADED) {
                    fleetOkAtNanos = System.nanoTime();
                }
                this.latencyUs = h.getP50LatencyUs();
                this.errorRate = h.getErrorRate();
            } finally {
                lock.writeLock().unlock();
            }
        }

        /**
         * Records a fleet health snapshot that left this endpoint out. It is not
         * routed to while absent. Returns true once readiness counts it down,
         * when it should be closed; until then it stays in the pool so one missed
         * snapshot does not empty the pool.
         */
        boolean absent(long nowNanos) {
            lock.writeLock().lock();
            try {
                this.status = InstanceStatus.INSTANCE_STATUS_UNHEALTHY;
            } finally {
                lock.writeLock().unlock();
            }
            return !isAvailable(nowNanos);
        }

        /**
         * Reports whether readiness counts this endpoint up at {@code nowNanos}:
         * it is routable, or the fleet plane reported it HEALTHY/DEGRADED within
         * {@link #FLEET_DOWN_AFTER_NANOS}. Routing uses {@link #isRoutable()} alone.
         */
        boolean isAvailable(long nowNanos) {
            lock.readLock().lock();
            try {
                if (status == InstanceStatus.INSTANCE_STATUS_HEALTHY
                        || status == InstanceStatus.INSTANCE_STATUS_DEGRADED) {
                    return true;
                }
                return fleetOkAtNanos != null && nowNanos - fleetOkAtNanos < FLEET_DOWN_AFTER_NANOS;
            } finally {
                lock.readLock().unlock();
            }
        }

        /**
         * Static-mode ping: trigger channel state probing and refresh local
         * latency/health from observed connectivity. We do not require an
         * RPC round-trip here; the ConnectivityState gives us a cheap signal
         * that the static endpoint is reachable.
         */
        void ping() {
            if (channel == null) return;
            long start = System.nanoTime();
            try {
                ConnectivityState state = channel.getState(true);
                long rttNanos = System.nanoTime() - start;
                lock.writeLock().lock();
                try {
                    if (state == ConnectivityState.READY || state == ConnectivityState.IDLE) {
                        long rttUs = Math.max(1, rttNanos / 1_000);
                        if (latencyUs == Long.MAX_VALUE) {
                            latencyUs = rttUs;
                        } else {
                            latencyUs = (long) (latencyUs * 0.7 + rttUs * 0.3);
                        }
                        status = InstanceStatus.INSTANCE_STATUS_HEALTHY;
                    } else {
                        status = InstanceStatus.INSTANCE_STATUS_UNHEALTHY;
                        latencyUs = Long.MAX_VALUE;
                    }
                } finally {
                    lock.writeLock().unlock();
                }
            } catch (Exception e) {
                lock.writeLock().lock();
                try {
                    status = InstanceStatus.INSTANCE_STATUS_UNHEALTHY;
                    latencyUs = Long.MAX_VALUE;
                } finally {
                    lock.writeLock().unlock();
                }
            }
        }

        boolean isRoutable() {
            lock.readLock().lock();
            try {
                return status == InstanceStatus.INSTANCE_STATUS_HEALTHY
                        || status == InstanceStatus.INSTANCE_STATUS_DEGRADED;
            } finally {
                lock.readLock().unlock();
            }
        }

        boolean isDegraded() {
            lock.readLock().lock();
            try {
                return status == InstanceStatus.INSTANCE_STATUS_DEGRADED;
            } finally {
                lock.readLock().unlock();
            }
        }

        long getLatencyUs() {
            lock.readLock().lock();
            try {
                return latencyUs;
            } finally {
                lock.readLock().unlock();
            }
        }

        boolean isConnected() {
            if (channel == null) return false;
            if (callerSupplied) {
                return channel.getState(false) != ConnectivityState.SHUTDOWN;
            }
            var state = channel.getState(false);
            return state == ConnectivityState.READY
                    || state == ConnectivityState.IDLE;
        }

        void close() {
            if (channel != null) {
                channel.shutdown();
                try {
                    channel.awaitTermination(5, TimeUnit.SECONDS);
                } catch (InterruptedException e) {
                    channel.shutdownNow();
                    Thread.currentThread().interrupt();
                }
            }
        }
    }

    // -----------------------------------------------------------------------
    // ChannelProvider -- lazy channel wrapper for generated gRPC clients
    // -----------------------------------------------------------------------

    /**
     * ChannelProvider implements {@link io.grpc.Channel} by delegating to the
     * ServiceConnection's active endpoint. This allows generated clients to be
     * constructed before any endpoints are discovered -- calls will fail with
     * UNAVAILABLE until healthy instances are found.
     *
     * <p>Each generated client holds a ChannelProvider for its target service.
     */
    public static class ChannelProvider extends io.grpc.Channel {
        private final ServiceConnection conn;

        public ChannelProvider(ServiceConnection conn) {
            this.conn = conn;
        }

        @Override
        public <ReqT, RespT> ClientCall<ReqT, RespT> newCall(
                MethodDescriptor<ReqT, RespT> methodDescriptor, CallOptions callOptions) {
            ManagedChannel channel = conn.conn();
            if (channel == null) {
                throw new StatusRuntimeException(Status.UNAVAILABLE.withDescription(
                        "service \"" + conn.serviceId() + "\": no healthy endpoints available"));
            }
            return channel.newCall(methodDescriptor, callOptions);
        }

        @Override
        public String authority() {
            ManagedChannel channel = conn.conn();
            if (channel != null) {
                return channel.authority();
            }
            return conn.serviceId();
        }
    }
}
