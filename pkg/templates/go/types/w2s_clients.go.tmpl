{{- end}}
)

// W2SClients exposes W2S clients by target service ID.
type W2SClients struct {
{{- range .Targets}}
	{{.FieldName}} *{{.StructName}}
{{- end}}
}

// NewW2SClients constructs the W2S client hierarchy.
func NewW2SClients(client *http.Client, baseURL string, tokenProviderFor TokenProviderFor) *W2SClients {
	if tokenProviderFor == nil {
		tokenProviderFor = func(string) TokenProvider { return nil }
	}
	return &W2SClients{
{{- range .Targets}}
		{{.FieldName}}: New{{.StructName}}(client, baseURL, tokenProviderFor("{{.Target}}")),
{{- end}}
	}
}

{{- range .Targets}}

// {{.AccessorName}} returns W2S clients for the "{{.Target}}" service.
