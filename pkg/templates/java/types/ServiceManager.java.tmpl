    private void {{.ResolveLoopName}}(BlockingQueue<{{.TypeOuterClass}}.{{.TypeName}}> queue) {
        long backoff = ReconnectBackoff.INITIAL_MS;
        {{.TypeOuterClass}}.{{.TypeName}} pending = null;

        while (!Thread.currentThread().isInterrupted()) {
            try {
                if (pending == null) {
                    pending = queue.poll(1, TimeUnit.SECONDS);
                    if (pending == null) {
                        continue;
                    }
                }
                io.grpc.Channel ebConn = resolveService("{{.TargetService}}");
                {{.StreamName}}(ebConn, pending);
                pending = null;
                backoff = ReconnectBackoff.INITIAL_MS;
            } catch (Exception e) {
                LOG.warning("publisher {{.Label}} publish attempt failed for broker {{.TargetService}}, retrying in " + backoff + "ms: " + e.getMessage());
                try { Thread.sleep(ReconnectBackoff.jitterMs(backoff)); } catch (InterruptedException ie) {
                    Thread.currentThread().interrupt();
                    return;
                }
                backoff = ReconnectBackoff.next(backoff);
            }
        }
    }

    private void {{.StreamName}}(io.grpc.Channel ebConn, {{.TypeOuterClass}}.{{.TypeName}} event) throws Exception {
        io.grpc.MethodDescriptor<{{.TypeOuterClass}}.{{.TypeName}}, com.google.protobuf.Empty> method =
                io.grpc.MethodDescriptor.<{{.TypeOuterClass}}.{{.TypeName}}, com.google.protobuf.Empty>newBuilder()
                        .setType(io.grpc.MethodDescriptor.MethodType.BIDI_STREAMING)
                        .setFullMethodName("{{.PublishFullMethod}}")
                        .setRequestMarshaller(io.grpc.protobuf.ProtoUtils.marshaller({{.TypeOuterClass}}.{{.TypeName}}.getDefaultInstance()))
                        .setResponseMarshaller(io.grpc.protobuf.ProtoUtils.marshaller(com.google.protobuf.Empty.getDefaultInstance()))
                        .build();

        CountDownLatch streamDone = new CountDownLatch(1);
        CountDownLatch streamReady = new CountDownLatch(1);
        CountDownLatch streamAck = new CountDownLatch(1);
        java.util.concurrent.atomic.AtomicReference<Throwable> streamError = new java.util.concurrent.atomic.AtomicReference<>();
        java.util.concurrent.atomic.AtomicReference<io.grpc.stub.ClientCallStreamObserver<{{.TypeOuterClass}}.{{.TypeName}}>> requestRef =
                new java.util.concurrent.atomic.AtomicReference<>();

        io.grpc.stub.StreamObserver<{{.TypeOuterClass}}.{{.TypeName}}> outbound = io.grpc.stub.ClientCalls.asyncBidiStreamingCall(
                ebConn.newCall(method, io.grpc.CallOptions.DEFAULT
                        .withCallCredentials(identity.callCredentialsForAudience("{{.TargetService}}"))),
                new io.grpc.stub.ClientResponseObserver<{{.TypeOuterClass}}.{{.TypeName}}, com.google.protobuf.Empty>() {
                    @Override public void beforeStart(io.grpc.stub.ClientCallStreamObserver<{{.TypeOuterClass}}.{{.TypeName}}> requestStream) {
                        requestRef.set(requestStream);
                        requestStream.setOnReadyHandler(() -> {
                            if (requestStream.isReady()) {
                                streamReady.countDown();
                            }
                        });
                    }
                    @Override public void onNext(com.google.protobuf.Empty value) { streamAck.countDown(); streamDone.countDown(); }
                    @Override public void onError(Throwable t) { streamError.set(t); streamDone.countDown(); }
                    @Override public void onCompleted() { streamDone.countDown(); }
                });

        awaitPublisherReady(requestRef.get(), streamReady);
        outbound.onNext(event);
        outbound.onCompleted();
        try {
            while (streamDone.getCount() > 0) {
                if (streamDone.await(1, TimeUnit.SECONDS)) {
                    break;
                }
                if (Thread.currentThread().isInterrupted()) {
                    throw new InterruptedException("interrupted while publishing {{.Label}}");
                }
            }
        } finally {
            if (streamDone.getCount() > 0) {
                try { outbound.onError(new RuntimeException("publisher interrupted before ack")); } catch (Exception ignored) {}
            }
        }

        if (streamError.get() != null) {
            throw new Exception("publisher {{.Label}} stream error", streamError.get());
        }
        if (streamAck.getCount() > 0) {
            throw new Exception("publisher {{.Label}} stream completed before ack");
        }
    }

