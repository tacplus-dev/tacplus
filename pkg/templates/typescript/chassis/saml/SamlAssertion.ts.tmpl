  const scdFrag = (() => { const p = axml.indexOf('<saml:SubjectConfirmationData'); return p >= 0 ? axml.substring(p) : ''; })();
  const subjectRecipient    = extractAttr(scdFrag, 'Recipient') ?? '';
  const subjectNotOnOrAfter = extractAttr(scdFrag, 'NotOnOrAfter') ?? '';

  const condFrag = (() => { const p = axml.indexOf('<saml:Conditions'); return p >= 0 ? axml.substring(p) : ''; })();
  const notBefore    = extractAttr(condFrag, 'NotBefore') ?? '';
  const notOnOrAfter = extractAttr(condFrag, 'NotOnOrAfter') ?? '';

  const audiences = extractAllText(axml, 'saml:Audience');

  const asFrag = (() => { const p = axml.indexOf('<saml:AuthnStatement'); return p >= 0 ? axml.substring(p) : ''; })();
  const authnInstant = extractAttr(asFrag, 'AuthnInstant') ?? '';
  const sessionIndex = extractAttr(asFrag, 'SessionIndex') ?? '';
  const authnContext = extractText(axml, 'saml:AuthnContextClassRef') ?? '';

  const attributes = parseAttributes(axml);

  return new SamlAssertion({
    responseId, inResponseTo, statusCode, statusMessage: '',
    id, issueInstant, issuer,
    subjectNameId, nameIdFormat, subjectRecipient, subjectNotOnOrAfter,
    notBefore, notOnOrAfter, audiences,
    authnInstant, authnContext, sessionIndex,
    attributes, xml,
  });
}

function parseAttributes(xml: string): Map<string, string> {
  const map = new Map<string, string>();
  const open = '<saml:Attribute ';
  let pos = 0;
  while (true) {
    const s = xml.indexOf(open, pos);
    if (s < 0) break;
    const frag = xml.substring(s);
    const name = extractAttr(frag, 'Name');
    const val  = extractText(frag, 'saml:AttributeValue');
    if (name !== undefined) map.set(name, val ?? '');
    pos = s + open.length;
  }
  return map;
}
