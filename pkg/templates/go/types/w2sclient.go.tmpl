// {{.ClientName}} provides typed W2S clients for {{.ServiceName}}.
//
// Unary RPCs use HTTP/JSON, server-streaming RPCs use SSE, and
// client-streaming/bidirectional RPCs use WebSocket frames.
type {{.ClientName}} struct {
	client        *http.Client
	baseURL       string
	tokenProvider func(context.Context) (string, error)
	timeout       time.Duration
}

// New{{.ClientName}} creates a new typed W2S client for {{.ServiceName}}.
func New{{.ClientName}}(client *http.Client, baseURL string, tokenProvider func(context.Context) (string, error)) *{{.ClientName}} {
	if client == nil {
		client = http.DefaultClient
	}
	return &{{.ClientName}}{
		client:        client,
		baseURL:       strings.TrimRight(baseURL, "/"),
		tokenProvider: tokenProvider,
		timeout:       30 * time.Second,
	}
}

// WithTimeout returns a copy of this client with a custom request/connect timeout.
func (c *{{.ClientName}}) WithTimeout(timeout time.Duration) *{{.ClientName}} {
	next := *c
	next.timeout = timeout
	return &next
}

func (c *{{.ClientName}}) authHeader(ctx context.Context, required bool) (string, error) {
	if !required {
		return "", nil
	}
	if c.tokenProvider == nil {
		return "", status.Error(codes.Unauthenticated, "W2S auth token provider is required")
	}
	token, err := c.tokenProvider(ctx)
	if err != nil {
		return "", status.Errorf(codes.Unauthenticated, "auth token: %v", err)
	}
	if token == "" {
		return "", status.Error(codes.Unauthenticated, "auth token is empty")
	}
	return "Bearer " + token, nil
}

func (c *{{.ClientName}}) httpURL(path string) string {
	return c.baseURL + path
}

func (c *{{.ClientName}}) contextWithTimeout(ctx context.Context) (context.Context, context.CancelFunc) {
	if c.timeout <= 0 {
		return ctx, func() {}
	}
	return context.WithTimeout(ctx, c.timeout)
}

func encodeW2SProto(msg proto.Message) ([]byte, error) {
	if msg == nil {
		return nil, status.Error(codes.InvalidArgument, "W2S request is nil")
	}
	data, err := (protojson.MarshalOptions{EmitUnpopulated: true}).Marshal(msg)
	if err != nil {
		return nil, status.Errorf(codes.InvalidArgument, "serialize request: %v", err)
	}
	if len(bytes.TrimSpace(data)) == 0 {
		return []byte("{}"), nil
	}
	return data, nil
}

func decodeW2SProtoPayload(data []byte, msg proto.Message) error {
	payload, err := w2sPayloadBytes(data)
	if err != nil {
		return err
	}
	if len(bytes.TrimSpace(payload)) == 0 {
		payload = []byte("{}")
	}
	if err := (protojson.UnmarshalOptions{DiscardUnknown: true}).Unmarshal(payload, msg); err != nil {
		return status.Errorf(codes.Internal, "failed to decode W2S response body: %v", err)
	}
	return nil
}

func w2sPayloadBytes(data []byte) ([]byte, error) {
	trimmed := bytes.TrimSpace(data)
	if len(trimmed) == 0 {
		return []byte("{}"), nil
	}
	var envelope map[string]json.RawMessage
	if err := json.Unmarshal(trimmed, &envelope); err == nil {
		if raw, ok := envelope["error"]; ok {
			return nil, w2sJSONErrorToStatus(raw)
		}
		if raw, ok := envelope["result"]; ok {
			return raw, nil
		}
	}
	return trimmed, nil
}

func w2sJSONErrorToStatus(raw json.RawMessage) error {
	var message string
	if err := json.Unmarshal(raw, &message); err != nil || message == "" {
		message = string(raw)
	}
	return status.Error(codes.Unknown, message)
}

func w2sHTTPStatusToError(statusCode int, body []byte) error {
	message := fmt.Sprintf("W2S HTTP status %d", statusCode)
	var envelope map[string]json.RawMessage
	if err := json.Unmarshal(bytes.TrimSpace(body), &envelope); err == nil {
		if raw, ok := envelope["error"]; ok {
			var parsed string
			if err := json.Unmarshal(raw, &parsed); err == nil && parsed != "" {
				message = parsed
			}
		}
	}
	code := codes.Unknown
	switch statusCode {
	case http.StatusBadRequest:
		code = codes.InvalidArgument
	case http.StatusUnauthorized:
		code = codes.Unauthenticated
	case http.StatusForbidden:
		code = codes.PermissionDenied
	case http.StatusNotFound:
		code = codes.NotFound
	case http.StatusConflict:
		code = codes.AlreadyExists
	case http.StatusTooManyRequests:
		code = codes.ResourceExhausted
	case http.StatusNotImplemented:
		code = codes.Unimplemented
	case http.StatusServiceUnavailable:
		code = codes.Unavailable
	case http.StatusGatewayTimeout:
		code = codes.DeadlineExceeded
	}
	return status.Error(code, message)
}

{{- if .HasHTTP}}

func (c *{{.ClientName}}) sendJSONRequest(ctx context.Context, method, path string, body []byte, authRequired bool) (*http.Response, error) {
	var bodyReader io.Reader
	if method != http.MethodGet {
		bodyReader = bytes.NewReader(body)
	}
	req, err := http.NewRequestWithContext(ctx, method, c.httpURL(path), bodyReader)
	if err != nil {
		return nil, status.Errorf(codes.InvalidArgument, "W2S request: %v", err)
	}
	if method != http.MethodGet {
		req.Header.Set("content-type", "application/json")
	}
	if auth, err := c.authHeader(ctx, authRequired); err != nil {
		return nil, err
	} else if auth != "" {
		req.Header.Set("authorization", auth)
	}
	resp, err := c.client.Do(req)
	if err != nil {
		return nil, status.Errorf(codes.Unavailable, "W2S request failed: %v", err)
	}
	return resp, nil
}

func (c *{{.ClientName}}) doJSON(ctx context.Context, method, path string, body []byte, authRequired bool) ([]byte, error) {
	reqCtx, cancel := c.contextWithTimeout(ctx)
	defer cancel()

	resp, err := c.sendJSONRequest(reqCtx, method, path, body, authRequired)
	if err != nil {
		return nil, err
	}
	defer resp.Body.Close()

	data, err := io.ReadAll(resp.Body)
	if err != nil {
		return nil, status.Errorf(codes.Unavailable, "failed to read W2S response: %v", err)
	}
	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return nil, w2sHTTPStatusToError(resp.StatusCode, data)
	}
	if _, err := w2sPayloadBytes(data); err != nil {
		return nil, err
	}
	return data, nil
}
{{- end}}

{{- if .HasServerStreaming}}

func streamW2SSSE[T any](
	c *{{.ClientName}},
	ctx context.Context,
	method, path string,
	body []byte,
	authRequired bool,
	decode func([]byte) (T, error),
) (grpc.ServerStreamingClient[T], error) {
	reqCtx, cancel := context.WithCancel(ctx)
	var bodyReader io.Reader
	if method != http.MethodGet {
		bodyReader = bytes.NewReader(body)
	}
	req, err := http.NewRequestWithContext(reqCtx, method, c.httpURL(path), bodyReader)
	if err != nil {
		cancel()
		return nil, status.Errorf(codes.InvalidArgument, "W2S SSE request: %v", err)
	}
	req.Header.Set("accept", "text/event-stream")
	if method != http.MethodGet {
		req.Header.Set("content-type", "application/json")
	}
	if auth, err := c.authHeader(ctx, authRequired); err != nil {
		cancel()
		return nil, err
	} else if auth != "" {
		req.Header.Set("authorization", auth)
	}

	resp, err := c.client.Do(req)
	if err != nil {
		cancel()
		return nil, status.Errorf(codes.Unavailable, "W2S SSE open failed: %v", err)
	}
	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		data, _ := io.ReadAll(resp.Body)
		resp.Body.Close()
		cancel()
		return nil, w2sHTTPStatusToError(resp.StatusCode, data)
	}
	return &w2sServerStream[T]{
		ctx:    reqCtx,
		cancel: cancel,
		resp:   resp,
		scan:   newW2SScanner(resp.Body),
		decode: decode,
	}, nil
}

func newW2SScanner(r io.Reader) *bufio.Scanner {
	scanner := bufio.NewScanner(r)
	scanner.Buffer(make([]byte, 0, 64*1024), 1024*1024)
	return scanner
}

type w2sServerStream[T any] struct {
	ctx    context.Context
	cancel context.CancelFunc
	resp   *http.Response
	scan   *bufio.Scanner
	decode func([]byte) (T, error)
}

func (s *w2sServerStream[T]) Recv() (*T, error) {
	for s.scan.Scan() {
		line := strings.TrimSpace(s.scan.Text())
		if line == "" || strings.HasPrefix(line, ":") || strings.HasPrefix(line, "event:") {
			continue
		}
		if rest, ok := strings.CutPrefix(line, "data:"); ok {
			line = strings.TrimSpace(rest)
		}
		msg, err := s.decode([]byte(line))
		if err != nil {
			return nil, err
		}
		return &msg, nil
	}
	if err := s.scan.Err(); err != nil {
		return nil, status.Errorf(codes.Unavailable, "W2S SSE read failed: %v", err)
	}
	s.resp.Body.Close()
	s.cancel()
	return nil, io.EOF
}

func (s *w2sServerStream[T]) Header() (metadata.MD, error) { return metadata.MD{}, nil }
func (s *w2sServerStream[T]) Trailer() metadata.MD         { return metadata.MD{} }
func (s *w2sServerStream[T]) CloseSend() error {
	s.cancel()
	if s.resp != nil && s.resp.Body != nil {
		return s.resp.Body.Close()
	}
	return nil
}
func (s *w2sServerStream[T]) Context() context.Context { return s.ctx }
func (s *w2sServerStream[T]) SendMsg(any) error {
	return status.Error(codes.Unimplemented, "W2S SSE stream is receive-only")
}
func (s *w2sServerStream[T]) RecvMsg(m any) error {
	msg, err := s.Recv()
	if err != nil {
		return err
	}
	if dst, ok := m.(*T); ok {
		*dst = *msg
		return nil
	}
	return status.Error(codes.InvalidArgument, "W2S RecvMsg destination has unexpected type")
}
{{- end}}

{{- if .HasWebSocket}}

func (c *{{.ClientName}}) websocketURL(path string) (string, error) {
	u := c.httpURL(path)
	if rest, ok := strings.CutPrefix(u, "https://"); ok {
		return "wss://" + rest, nil
	}
	if rest, ok := strings.CutPrefix(u, "http://"); ok {
		return "ws://" + rest, nil
	}
	if strings.HasPrefix(u, "ws://") || strings.HasPrefix(u, "wss://") {
		return u, nil
	}
	return "", status.Errorf(codes.InvalidArgument, "W2S baseURL must start with http://, https://, ws://, or wss://: %s", c.baseURL)
}

func (c *{{.ClientName}}) websocketOrigin() (string, error) {
	raw := c.baseURL
	if rest, ok := strings.CutPrefix(raw, "ws://"); ok {
		raw = "http://" + rest
	} else if rest, ok := strings.CutPrefix(raw, "wss://"); ok {
		raw = "https://" + rest
	}
	u, err := url.Parse(raw)
	if err != nil || u.Scheme == "" || u.Host == "" {
		return "", status.Errorf(codes.InvalidArgument, "invalid W2S baseURL: %s", c.baseURL)
	}
	return u.Scheme + "://" + u.Host, nil
}

func (c *{{.ClientName}}) connectWebSocket(ctx context.Context, path string) (*websocket.Conn, error) {
	wsURL, err := c.websocketURL(path)
	if err != nil {
		return nil, err
	}
	origin, err := c.websocketOrigin()
	if err != nil {
		return nil, err
	}
	cfg, err := websocket.NewConfig(wsURL, origin)
	if err != nil {
		return nil, status.Errorf(codes.InvalidArgument, "W2S WebSocket config: %v", err)
	}
	if c.timeout > 0 {
		cfg.Dialer = &net.Dialer{Timeout: c.timeout}
	}
	reqCtx, cancel := c.contextWithTimeout(ctx)
	defer cancel()
	ws, err := cfg.DialContext(reqCtx)
	if err != nil {
		return nil, status.Errorf(codes.Unavailable, "W2S WebSocket connect failed: %v", err)
	}
	return ws, nil
}

func (c *{{.ClientName}}) sendWebSocketValue(ctx context.Context, ws *websocket.Conn, value map[string]any) error {
	if c.timeout > 0 {
		if err := ws.SetWriteDeadline(time.Now().Add(c.timeout)); err != nil {
			return status.Errorf(codes.Unavailable, "W2S WebSocket write deadline: %v", err)
		}
	}
	if err := websocket.JSON.Send(ws, value); err != nil {
		return status.Errorf(codes.Unavailable, "W2S WebSocket send failed: %v", err)
	}
	return nil
}

func (c *{{.ClientName}}) sendStartFrame(ctx context.Context, ws *websocket.Conn, authRequired bool) error {
	frame := map[string]any{"type": "start"}
	if auth, err := c.authHeader(ctx, authRequired); err != nil {
		return err
	} else if auth != "" {
		frame["authorization"] = auth
	}
	return c.sendWebSocketValue(ctx, ws, frame)
}

func (c *{{.ClientName}}) sendMessageFrame(ctx context.Context, ws *websocket.Conn, body []byte, authRequired bool) error {
	auth, err := c.authHeader(ctx, authRequired)
	if err != nil {
		return err
	}
	return c.sendMessageFrameWithAuth(ctx, ws, body, auth)
}

func (c *{{.ClientName}}) sendMessageFrameWithAuth(ctx context.Context, ws *websocket.Conn, body []byte, authorization string) error {
	var payload any
	if err := json.Unmarshal(body, &payload); err != nil {
		return status.Errorf(codes.InvalidArgument, "W2S WebSocket request body: %v", err)
	}
	frame := map[string]any{
		"type":    "message",
		"message": payload,
	}
	if authorization != "" {
		frame["authorization"] = authorization
	}
	return c.sendWebSocketValue(ctx, ws, frame)
}

func (c *{{.ClientName}}) sendCompleteFrame(ctx context.Context, ws *websocket.Conn) error {
	return c.sendWebSocketValue(ctx, ws, map[string]any{"type": "complete"})
}

func (c *{{.ClientName}}) recvWebSocketPayload(ws *websocket.Conn) ([]byte, error) {
	if c.timeout > 0 {
		if err := ws.SetReadDeadline(time.Now().Add(c.timeout)); err != nil {
			return nil, status.Errorf(codes.Unavailable, "W2S WebSocket read deadline: %v", err)
		}
	}
	var text string
	if err := websocket.Message.Receive(ws, &text); err != nil {
		if err == io.EOF {
			return nil, io.EOF
		}
		return nil, status.Errorf(codes.Unavailable, "W2S WebSocket receive failed: %v", err)
	}
	payload, err := w2sPayloadBytes([]byte(text))
	if err != nil {
		return nil, err
	}
	return payload, nil
}
{{- end}}

{{- if .HasClientStreaming}}

type w2sClientStream[Req, Resp any] struct {
	ctx          context.Context
	ws           *websocket.Conn
	client       *{{.ClientName}}
	authRequired bool
	validate     func(*Req) error
	encode       func(*Req) ([]byte, error)
	decode       func([]byte) (Resp, error)
	mu           sync.Mutex
	sentComplete bool
}

func (s *w2sClientStream[Req, Resp]) Send(req *Req) error {
	if s.validate != nil {
		if err := s.validate(req); err != nil {
			return err
		}
	}
	body, err := s.encode(req)
	if err != nil {
		return err
	}
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.sentComplete {
		return status.Error(codes.Unavailable, "W2S client stream already completed")
	}
	return s.client.sendMessageFrame(s.ctx, s.ws, body, s.authRequired)
}

func (s *w2sClientStream[Req, Resp]) CloseAndRecv() (*Resp, error) {
	if err := s.CloseSend(); err != nil {
		return nil, err
	}
	defer s.ws.Close()
	payload, err := s.client.recvWebSocketPayload(s.ws)
	if err != nil {
		return nil, err
	}
	resp, err := s.decode(payload)
	if err != nil {
		return nil, err
	}
	return &resp, nil
}

func (s *w2sClientStream[Req, Resp]) Header() (metadata.MD, error) { return metadata.MD{}, nil }
func (s *w2sClientStream[Req, Resp]) Trailer() metadata.MD         { return metadata.MD{} }
func (s *w2sClientStream[Req, Resp]) CloseSend() error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.sentComplete {
		return nil
	}
	s.sentComplete = true
	return s.client.sendCompleteFrame(s.ctx, s.ws)
}
func (s *w2sClientStream[Req, Resp]) Context() context.Context { return s.ctx }
func (s *w2sClientStream[Req, Resp]) SendMsg(m any) error {
	req, ok := m.(*Req)
	if !ok {
		return status.Error(codes.InvalidArgument, "W2S SendMsg source has unexpected type")
	}
	return s.Send(req)
}
func (s *w2sClientStream[Req, Resp]) RecvMsg(m any) error {
	resp, err := s.CloseAndRecv()
	if err != nil {
		return err
	}
	if dst, ok := m.(*Resp); ok {
		*dst = *resp
		return nil
	}
	return status.Error(codes.InvalidArgument, "W2S RecvMsg destination has unexpected type")
}
