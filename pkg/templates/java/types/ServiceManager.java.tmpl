{{- if .HasRecordSubscriptions}}

    /**
     * perInstanceConsumerGroup returns the consumer group for a topic that delivers
     * a (spec.record) — a stored record type.
     *
     * <p>Every other topic subscribes under the bare service label, so the broker
     * splits the topic across the service's instances — each record reaches exactly
     * one of them. That is correct when the destination is shared cluster-wide. A
     * record's destination is NODE-LOCAL, and a node-local store is only complete
     * if that node sees every record, so record topics must be fanned out rather
     * than split. Appending the instance's own identity to the label gives each
     * instance a group of its own, which is what makes the broker fan out.
     *
     * <p>The identity must be STABLE across restarts, or every restart would
     * abandon a consumer group and re-read the topic from the beginning under a new
     * one. POD_NAME is stable for a given pod and is injected by the operator; the
     * hostname is the same string in Kubernetes and covers running outside it.
     * There is deliberately no fall back to the shared label: silently re-sharding
     * a node-local store is the failure this method exists to prevent.
     */
    private static String perInstanceConsumerGroup(String serviceLabel) {
        String instance = System.getenv("POD_NAME");
        if (instance == null || instance.isEmpty()) {
            try {
                instance = java.net.InetAddress.getLocalHost().getHostName();
            } catch (java.net.UnknownHostException e) {
                throw new IllegalStateException(
                        "a record topic needs a per-instance consumer group, but neither POD_NAME nor a hostname is available", e);
            }
        }
        return serviceLabel + "-" + instance;
    }
{{- end}}

    private Thread startManagedThread(String name, boolean daemon, Runnable body) {
        Thread t = new Thread(() -> {
            try {
                body.run();
            } finally {
                managedThreads.remove(Thread.currentThread());
            }
        }, name);
        t.setDaemon(daemon);
        managedThreads.add(t);
        t.start();
        return t;
    }

    private void stopManagedThreads() {
        for (Thread t : managedThreads) {
            t.interrupt();
        }
        for (Thread t : managedThreads) {
            try {
                t.join(5000);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                return;
            }
        }
        managedThreads.clear();
    }

    /** Records a TLS-renewal degradation and notifies subscribers. */
    private void reportTLSDegraded(String reason) {
        synchronized (tlsDegradeLock) {
            tlsDegradeSeen.add(reason);
            for (Consumer<String> fn : tlsDegradeFns) {
                fn.accept(reason);
            }
        }
    }

    /**
     * Registers a subscriber for TLS-degrade events and replays already-recorded
     * reasons so registration order cannot lose a degradation.
     */
    private void onTLSDegraded(Consumer<String> fn) {
        synchronized (tlsDegradeLock) {
            tlsDegradeFns.add(fn);
            for (String r : tlsDegradeSeen) {
                fn.accept(r);
            }
        }
    }

	{{- if .HasDiskStores}}
	    private java.util.List<ScheduledExecutorService> startDiskStoreRollSchedulers(Handler handler) {
	        if (diskStoreLogs == null || diskStoreLogs.rollInterval.isZero()) {
	            return java.util.Collections.emptyList();
	        }
	        String nodeId = getInstanceId();
        if (nodeId == null || nodeId.isEmpty()) {
            nodeId = "{{.ServiceLabel}}";
        }
        java.util.List<ScheduledExecutorService> schedulers = new java.util.ArrayList<>();
{{- range .DiskStores}}
        if (diskStoreLogs.{{.LogField}} != null) {
            java.util.function.Supplier<java.util.List<RedoLog.Record>> snapshot = () -> {
                try {
                    var store = handler.{{.HandlerGetter}}();
                    var response = store.list(null);
                    var records = DiskStores.snapshot{{.MethodName}}(response.getItemsList());
                    // The baseline is LOCALITY-SCOPED when the store says it is
                    // partitioned: list(null) is the whole cluster's rows, and a
                    // node whose baseline claims rows it does not own breaks the
                    // partial-log invariant recovery resolves staleness with.
                    if (store instanceof LocalRows) {
                        LocalRows local = (LocalRows) store;
                        java.util.List<RedoLog.Record> scoped = new java.util.ArrayList<>();
                        for (RedoLog.Record rec : records) {
                            if (local.isLocalRow(rec.key)) {
                                scoped.add(rec);
                            }
                        }
                        return scoped;
                    }
                    return records;
                } catch (Exception e) {
                    // Never ship an empty snapshot in place of an unreadable one: a roll
                    // or checkpoint that wrote it would drop the whole store.
                    throw new IllegalStateException(
                            "diskstore snapshot failed for {{.StoreName}}; retried on the next interval", e);
                }
            };
            schedulers.add(RollSchedule.runRollScheduler(
                    diskStoreLogs.{{.LogField}},
                    diskStoreLogs.rollInterval,
                    nodeId + "/{{.StoreName}}",
                    snapshot));
            if (!diskStoreLogs.segmentInterval.isZero()) {
                schedulers.add(RollSchedule.runRotateScheduler(
                        diskStoreLogs.{{.LogField}},
                        diskStoreLogs.segmentInterval,
                        nodeId + "/{{.StoreName}}"));
            }
            if (!diskStoreLogs.checkpointInterval.isZero()) {
                schedulers.add(RollSchedule.runCheckpointScheduler(
                        diskStoreLogs.{{.LogField}},
                        diskStoreLogs.checkpointInterval,
                        nodeId + "/{{.StoreName}}",
                        snapshot));
            }
        }
{{- end}}
        return schedulers;
    }

{{- end}}
{{- if .HasC2DGrpc}}

    /**
     * The unix socket this build's service_c2d services declare
     * (spec.service_c2d.socket_path — required, no default, which would collide
     * between daemons). run() serves on it; clients dial it.
     */
    public static final String C2D_SOCKET_PATH = "{{.C2DSocketPath}}";

    /**
     * Hosts the service_c2d wrappers on socketPath. The wrappers skip token
     * auth: the socket's owner-only permissions are the boundary, not a bearer
     * token.
     */
    static C2DServer newC2DServer(String socketPath, io.grpc.BindableService... services) {
        return new C2DServer(socketPath, new ServiceImplementation() {
            @Override
            public void registerServices(ServerBuilder<?> grpcServerBuilder) {
                for (io.grpc.BindableService svc : services) {
                    grpcServerBuilder.addService(svc);
                }
            }

            @Override
            public void registerRESTEndpoints(Javalin app, String apiPrefix) {
            }
        });
