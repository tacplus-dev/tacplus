                haveVersion = true;
            } else if (key.equals("k")) {
                if (!consume(s, i, '[')) return null;
                java.util.List<String> arr = new java.util.ArrayList<>();
                skipWs(s, i);
                if (i[0] < s.length() && s.charAt(i[0]) == ']') {
                    i[0]++;
                } else {
                    while (true) {
                        skipWs(s, i);
                        String v = parseJsonString(s, i);
                        if (v == null) return null;
                        arr.add(v);
                        skipWs(s, i);
                        if (i[0] < s.length() && s.charAt(i[0]) == ',') { i[0]++; continue; }
                        if (!consume(s, i, ']')) return null;
                        break;
                    }
                }
                keys = arr;
            } else {
                return null;
            }
            skipWs(s, i);
            if (i[0] < s.length() && s.charAt(i[0]) == ',') { i[0]++; continue; }
            if (!consume(s, i, '}')) return null;
            break;
        }
        skipWs(s, i);
        if (i[0] != s.length() || !haveVersion) return null;
        return keys == null ? java.util.Collections.emptyList() : keys;
    }

    private static void skipWs(String s, int[] i) {
        while (i[0] < s.length()) {
            char c = s.charAt(i[0]);
            if (c == ' ' || c == '\t' || c == '\n' || c == '\r') i[0]++; else break;
        }
    }

    private static boolean consume(String s, int[] i, char c) {
        if (i[0] < s.length() && s.charAt(i[0]) == c) { i[0]++; return true; }
        return false;
    }

    private static String parseJsonString(String s, int[] i) {
        if (i[0] >= s.length() || s.charAt(i[0]) != '"') return null;
        i[0]++;
        StringBuilder out = new StringBuilder();
        while (i[0] < s.length()) {
            char c = s.charAt(i[0]++);
            if (c == '"') {
                return out.toString();
            } else if (c == '\\') {
                if (i[0] >= s.length()) return null;
                char e = s.charAt(i[0]++);
                switch (e) {
                    case '"': out.append('"'); break;
                    case '\\': out.append('\\'); break;
                    case '/': out.append('/'); break;
                    case 'n': out.append('\n'); break;
                    case 'r': out.append('\r'); break;
                    case 't': out.append('\t'); break;
                    case 'b': out.append('\b'); break;
                    case 'f': out.append('\f'); break;
                    case 'u':
                        if (i[0] + 4 > s.length()) return null;
                        out.append((char) Integer.parseInt(s.substring(i[0], i[0] + 4), 16));
                        i[0] += 4;
                        break;
                    default: return null;
                }
            } else {
                out.append(c);
            }
        }
        return null;
    }
