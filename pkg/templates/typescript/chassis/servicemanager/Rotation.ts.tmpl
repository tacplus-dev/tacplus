/**
 * clientStreamCall wires a rotating client-streaming call's one response to
 * callback, as grpc-js's makeClientStreamRequest does, and returns the stream
 * to write the requests to.
 */
export function clientStreamCall<Req, Res>(
  stream: RotatingStream<Req, Res>,
  callback: (err: grpc.ServiceError | null, response?: Res) => void,
): RotatingStream<Req, Res> {
  let response: Res | undefined;
  let has = false;
  let done = false;
  stream.on('data', (msg: Res) => {
    if (!has) {
      response = msg;
      has = true;
    }
  });
  stream.on('error', (err: grpc.ServiceError) => {
    if (done) return;
    done = true;
    callback(err);
  });
  stream.on('end', () => {
    if (done) return;
    done = true;
    if (has) {
      callback(null, response);
    } else {
      callback(statusError(grpc.status.UNIMPLEMENTED, 'No message received'));
    }
  });
  return stream;
}
