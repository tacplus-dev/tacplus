        assert_eq!(rotating_path("/pkg.Svc/Watch").as_deref(), Some("/pkg.SvcRotating/Watch"));
        assert_eq!(plain_path("/pkg.SvcRotating/Watch").as_deref(), Some("/pkg.Svc/Watch"));
