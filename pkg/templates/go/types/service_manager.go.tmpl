tlsCertStreamLoop(taskCtx, func() grpc.ClientConnInterface { return sm.sc.Conn() }, "{{.ServiceLabel}}", h, sm.TokenProviderFunc(), storeTlsCert, sm.reportTLSDegraded, tlsReadyCh, certStreamMaxInitRetries)
})
// The ManageCert renewal stream must NOT gate Listen (see above) — the server
// already serves with the X509Mint certificate. But a terminal failure to ever
// deliver the first renewed cert must not be silently dropped: drain the
// first-delivery signal in the background and log a failure. The service keeps
// serving on the initial X509Mint cert until it expires (PC-L-1).
sm.tasks.Go(func(taskCtx context.Context) {
