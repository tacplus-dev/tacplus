                        return;
                    }
                }
                Err(e) => {
                    self.fault(&format!("local connection: {}", e), Code::Cancelled);
                    return;
                }
            }
        }
    }

    /// Sends one chunk on the send leg; false when the session is over.
    async fn send_chunk(&self, chunk: MemberChunk) -> bool {
        let guard = tokio::select! {
            _ = self.cancel.cancelled() => return false,
            g = self.send.lock() => g,
        };
