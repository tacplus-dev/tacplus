#[cfg(test)]
mod tests {
    use super::*;

    const S: Duration = Duration::from_secs(1);

    /// Inputs as they stand once the fleet plane has reported HEALTHY.
    fn up(t0: Instant) -> ReadinessInputs {
        let mut r = ReadinessInputs::new(t0);
        r.record_fleet(true, t0);
        r
    }

    #[test]
    fn single_ping_failure_does_not_take_endpoint_down() {
        let t0 = Instant::now();
        let mut r = up(t0);
        r.record_ping(false, t0 + 10 * S);
        assert_eq!(r.down_input(t0 + 15 * S), None);
    }

    #[test]
    fn three_consecutive_ping_failures_take_endpoint_down() {
        let t0 = Instant::now();
        let mut r = up(t0);
        r.record_ping(true, t0 + 10 * S);
        r.record_ping(false, t0 + 11 * S);
        r.record_ping(false, t0 + 12 * S);
        assert_eq!(r.down_input(t0 + 12 * S), None, "two failures is still up");
        r.record_ping(false, t0 + 13 * S);
        assert_eq!(r.down_input(t0 + 13 * S), Some("ping"));
    }

    #[test]
    fn thirty_seconds_without_ping_success_takes_endpoint_down() {
        let t0 = Instant::now();
        let mut r = up(t0);
        r.record_ping(false, t0 + 5 * S);
        assert_eq!(r.down_input(t0 + 29 * S), None);
        assert_eq!(r.down_input(t0 + 30 * S), Some("ping"));
    }

    #[test]
    fn no_pings_at_all_is_not_down() {
        // Dynamic pools never ping; age alone must not take them down.
        let t0 = Instant::now();
        assert_eq!(up(t0).down_input(t0 + 3600 * S), None);
    }

    #[test]
    fn first_ping_success_recovers() {
        let t0 = Instant::now();
        let mut r = up(t0);
        for i in 1..=5 {
            r.record_ping(false, t0 + i * 10 * S);
        }
        assert_eq!(r.down_input(t0 + 50 * S), Some("ping"));
        r.record_ping(true, t0 + 60 * S);
        assert_eq!(r.down_input(t0 + 60 * S), None);
        r.record_ping(false, t0 + 70 * S);
        assert_eq!(r.down_input(t0 + 70 * S), None, "failure count restarts after a success");
    }

    #[test]
    fn fleet_unhealthy_must_persist_thirty_seconds() {
        let t0 = Instant::now();
        let mut r = up(t0);
        // The health poller re-reports every 5s.
        for i in 1..=5 {
            r.record_fleet(false, t0 + i * 5 * S);
            assert_eq!(r.down_input(t0 + i * 5 * S), None, "{}s after last HEALTHY", i * 5);
        }
        r.record_fleet(false, t0 + 30 * S);
        assert_eq!(r.down_input(t0 + 30 * S), Some("fleet health"));
    }

    #[test]
    fn fleet_blip_shorter_than_window_never_goes_down() {
        // The dev symptom: one UNHEALTHY/stale report between HEALTHY ones.
        let t0 = Instant::now();
        let mut r = up(t0);
        r.record_fleet(false, t0 + 5 * S);
        assert_eq!(r.down_input(t0 + 6 * S), None);
        r.record_fleet(true, t0 + 10 * S);
        assert_eq!(r.down_input(t0 + 45 * S), None);
    }

    #[test]
    fn fleet_recovers_on_first_healthy_report() {
        let t0 = Instant::now();
        let mut r = up(t0);
        r.record_fleet(false, t0 + 5 * S);
        assert_eq!(r.down_input(t0 + 40 * S), Some("fleet health"));
        r.record_fleet(true, t0 + 40 * S);
