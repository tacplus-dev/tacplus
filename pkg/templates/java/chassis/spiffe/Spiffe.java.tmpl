        p.subjectKind = kind;
        p.namespace = "/" + String.join("/", segs.subList(0, tagIdx));
        p.resourceKind = segs.get(tagIdx + 1);
        p.resourceId = String.join("/", segs.subList(tagIdx + 2, segs.size()));
    }

