"""
UC1 — atomic typed snapshot (whole object).

These functions operate on raw bytes. The per-type generated code produces the
bytes via the generated ``to_json`` helper on write, and parses them via
``from_json`` + ``validate`` on read — keeping serialization consistent with the
rest of tacplus and validation always-on.
"""

import os
from dataclasses import dataclass
from typing import Optional

from .compress import Codec, compress, decompress_auto
from .error import DiskStoreError
from .fsutil import archive_active, promote, write_temp


@dataclass
class SnapshotOpts:
    """Options for a snapshot write.

    Attributes:
        codec: At-rest compression for the snapshot file.
        mode: Unix file mode for the data file (e.g. 0o600). 0 leaves default.
        archive_count: Number of rotated archives to retain.
    """

    codec: Codec = Codec.NONE
    mode: int = 0o600
    archive_count: int = 3


def write_snapshot(path: str, data: bytes, opts: SnapshotOpts) -> None:
    """Write a whole-object snapshot atomically.

    Order is chosen so the active file is NEVER absent (PC-L-5):
      1. compress the payload,
      2. write it to a fresh fsync'd temp (active still intact),
      3. LINK the previous active to ``<path>.bak.1`` (keep archive_count; the
         active path stays in place),
      4. atomically rename the temp over ``path`` (the only mutation of the
         active file — a crash leaves either the old or the new snapshot).
    """
    payload = compress(data, opts.codec)
    tmp = write_temp(path, payload, opts.mode)
    archive_active(path, opts.archive_count)
    promote(tmp, path)


def read_snapshot(path: str) -> Optional[bytes]:
    """Read a snapshot, auto-decompressing. Returns ``None`` if the file is
    absent. The caller deserializes + validates the returned bytes (``from_json``
    + ``validate``)."""
    try:
        with open(path, "rb") as f:
            return decompress_auto(f.read())
    except FileNotFoundError:
        # The active file should never be absent (write_snapshot only ever
        # replaces it atomically), but if it is — disk incident, manual
        # deletion, legacy crash window — recover the previous state from
        # .bak.1 rather than silently starting fresh (PC-L-5 read leg).
        try:
            with open(_archive_name(path, 1), "rb") as f:
                bak_bytes = f.read()
        except FileNotFoundError:
            # Only a MISSING archive degrades to fresh-start; any other read
            # failure on a present archive errors loudly (NEW-38).
            return None
        except OSError as bak_err:
            raise DiskStoreError.from_os_error(bak_err)
        # A present-but-corrupt archive on the recovery path errors LOUDLY —
        # silently dropping the last committed baseline would mask corruption
        # on the exact path this recovery exists for (NEW-37).
        return decompress_auto(bak_bytes)
    except OSError as e:
        raise DiskStoreError.from_os_error(e)
