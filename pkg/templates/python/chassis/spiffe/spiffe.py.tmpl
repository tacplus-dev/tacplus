def opaque_segment(kind: str, external_value: str) -> str:
    """Deterministically convert a richer external identifier into a stable
    opaque segment, byte-identical across languages:

        input   = utf8(kind) || 0x1F || utf8(NFC(value))
        digest  = SHA-256(input)
        segment = base32_lower_nopad(digest[:20])   # 160-bit -> 32 chars [a-z2-7]

    The kind domain-separates so the same value under different kinds never
    collides. Callers must preserve the original external value as a separate
    claim -- the segment is never the sole record of identity.
    """
    data = (
        kind.encode("utf-8")
        + bytes([0x1F])
        + unicodedata.normalize("NFC", external_value).encode("utf-8")
    )
    digest = hashlib.sha256(data).digest()
    return base64.b32encode(digest[:20]).decode("ascii").lower().rstrip("=")


