    #[allow(dead_code)]
    pub async fn set_emitter(&self, emitter: Option<Arc<am::Emitter>>) {
        let mut guard = self.emitter.write().await;
        *guard = emitter;
    }

    /// Check authorization. No-op if authorizer is None.
    #[allow(dead_code)]
    async fn authorize_method<T>(&self, full_method: &str, req: &tonic::Request<T>) -> Result<std::collections::HashMap<String, String>, tonic::Status> {
        // Fail-closed: auth_disabled methods skip this call (by annotation), so a
        // None authorizer here means a token-auth method was left unwired. Reject.
        let auth = self.authorizer.read().await;
        match *auth {
            Some(ref a) => {
                let authorization = req.metadata()
                    .get("authorization")
                    .and_then(|v| v.to_str().ok());
                a.authorize(full_method, authorization).await
            }
            None => Err(tonic::Status::unauthenticated(format!(
                "authorizer not wired for {} (build/SM bug) — auth is mandatory and cannot be disabled", full_method))),
        }
    }

    /// Enforce level-or-below: the caller's namespace must equal or be an ancestor
    /// of `target_namespace`. Fail-closed: a None authorizer rejects. Used by methods
    /// with `target_namespace_field` annotation.
    #[allow(dead_code)]
    async fn enforce_at_or_below<T>(&self, full_method: &str, req: &tonic::Request<T>, target_namespace: &str) -> Result<std::collections::HashMap<String, String>, tonic::Status> {
        let auth = self.authorizer.read().await;
        match *auth {
            Some(ref a) => {
                let authorization = req.metadata()
                    .get("authorization")
                    .and_then(|v| v.to_str().ok());
                a.check_at_or_below(full_method, authorization, target_namespace).await
            }
            None => Err(tonic::Status::unauthenticated(
                "authorizer not wired (build/SM bug) — auth is mandatory and cannot be disabled")),
        }
    }

    /// Authenticate only: any caller holding a valid token is admitted. Fail-closed:
    /// a None authorizer rejects. Used by `auth_any_user` methods with no fixed
    /// target namespace — there is no namespace to compare against, so gating on
    /// one would deny every caller not sitting exactly at "/".
    #[allow(dead_code)]
    async fn enforce_authenticated<T>(&self, full_method: &str, req: &tonic::Request<T>) -> Result<std::collections::HashMap<String, String>, tonic::Status> {
        let auth = self.authorizer.read().await;
        match *auth {
            Some(ref a) => {
                let authorization = req.metadata()
                    .get("authorization")
                    .and_then(|v| v.to_str().ok());
                a.authenticate(full_method, authorization).await
            }
            None => Err(tonic::Status::unauthenticated(
                "authorizer not wired (build/SM bug) — auth is mandatory and cannot be disabled")),
        }
    }

    /// Enforce level-or-below using an already-extracted authorization header.
    /// Used by client-streaming/bidi request adapters where each message carries
    /// the target namespace but the stream metadata is fixed at open.
    #[allow(dead_code)]
    async fn enforce_at_or_below_authorization(&self, full_method: &str, authorization: Option<&str>, target_namespace: &str) -> Result<std::collections::HashMap<String, String>, tonic::Status> {
        let auth = self.authorizer.read().await;
        match *auth {
            Some(ref a) => a.check_at_or_below(full_method, authorization, target_namespace).await,
            None => Err(tonic::Status::unauthenticated(
                "authorizer not wired (build/SM bug) — auth is mandatory and cannot be disabled")),
        }
    }

