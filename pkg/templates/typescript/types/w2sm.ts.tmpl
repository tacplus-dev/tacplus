/**
 * RestTransport implementation using the browser Fetch API.
 * Prepends the gateway URL from bootstrap config to all requests.
 */
export class FetchTransport {
  private readonly baseUrl: string;
  private readonly tokenProvider?: TokenProvider;
  private readonly connectTimeoutMs: number;

  constructor(baseUrl: string, tokenProvider?: TokenProvider, connectTimeoutMs = 30000) {
    this.baseUrl = baseUrl.replace(/\/+$/, '');
    this.tokenProvider = tokenProvider;
    this.connectTimeoutMs = connectTimeoutMs;
  }

  async authHeader(service?: string): Promise<string | undefined> {
    if (!this.tokenProvider) return undefined;
    const token = await this.tokenProvider(service);
    if (!token) return undefined;
    return `Bearer ${token}`;
  }

  /**
   * Auth header for a route that requires one. Distinguishes "no provider
   * configured" from "provider returned an empty token" and stamps
   * UNAUTHENTICATED on both, so a caller can classify the failure. authHeader()
   * keeps its `string | undefined` shape because it is part of the RestTransport
   * interface the generated W2S clients consume.
   */
  private async requireAuthHeader(service?: string): Promise<string> {
    if (!this.tokenProvider) {
      throw new W2SError(W2S_UNAUTHENTICATED, 'w2sm: authenticated request requires a token provider');
    }
    const token = await this.tokenProvider(service);
    if (!token) {
      throw new W2SError(W2S_UNAUTHENTICATED, 'w2sm: token provider returned an empty token');
    }
    return `Bearer ${token}`;
  }

  async requestJson(method: string, url: string, body: unknown, opts?: { auth?: boolean; signal?: AbortSignal; service?: string }): Promise<unknown> {
    const headers: Record<string, string> = {};
    const upperMethod = method.toUpperCase();
    const init: RequestInit = {
      method: upperMethod,
      // Default request deadline (parity with the go/rust/java 30s clients): when
      // the caller supplies no AbortSignal, apply connectTimeoutMs so a unary
      // gRPC-over-REST call cannot hang forever. Streaming (getStream/postStream)
      // deliberately keeps no default deadline. Was previously stored-but-unused.
      signal: opts?.signal ?? AbortSignal.timeout(this.connectTimeoutMs),
      headers,
    };
    if (upperMethod !== 'GET') {
      headers['Content-Type'] = 'application/json';
      init.body = JSON.stringify(body);
    }
    if (opts?.auth !== false) {
      headers.Authorization = await this.requireAuthHeader(opts?.service);
    }
    const resp = await fetch(this.absoluteHttpUrl(url), init);
    if (!resp.ok) {
      const errorBody = await resp.text().catch(() => '');
      throw new W2SError(
        w2sResponseCode(resp, errorBody),
        `gRPC-over-REST error: ${resp.status} ${resp.statusText}`,
        resp.status,
      );
    }
    const text = await resp.text();
    return text.trim() ? JSON.parse(text) : {};
  }

  async postJson(url: string, body: unknown, opts?: { auth?: boolean; signal?: AbortSignal; service?: string }): Promise<unknown> {
    return this.requestJson('POST', url, body, opts);
  }

  async getStream(url: string, opts?: { signal?: AbortSignal; auth?: boolean; service?: string }): Promise<Response> {
    const headers: Record<string, string> = { Accept: 'text/event-stream' };
    if (opts?.auth !== false) {
      headers.Authorization = await this.requireAuthHeader(opts?.service);
    }
    return fetch(this.absoluteHttpUrl(url), { signal: opts?.signal, headers });
  }

  async postStream(url: string, body: unknown, opts?: { signal?: AbortSignal; auth?: boolean; service?: string }): Promise<Response> {
    const headers: Record<string, string> = {
      'Content-Type': 'application/json',
      Accept: 'text/event-stream',
    };
    if (opts?.auth !== false) {
      headers.Authorization = await this.requireAuthHeader(opts?.service);
    }
    return fetch(this.absoluteHttpUrl(url), {
      method: 'POST',
      headers,
      body: JSON.stringify(body),
      signal: opts?.signal,
    });
  }

  async openWebSocket(url: string, opts?: { signal?: AbortSignal }): Promise<WebSocket> {
    const ws = new WebSocket(this.absoluteWebSocketUrl(url));
    return new Promise<WebSocket>((resolve, reject) => {
      let settled = false;
      const timer = setTimeout(() => {
        if (settled) return;
        settled = true;
        cleanup();
        ws.close();
        reject(new Error('w2sm: WebSocket open timed out'));
      }, this.connectTimeoutMs);
      const cleanup = () => {
        clearTimeout(timer);
        ws.removeEventListener('open', onOpen);
        ws.removeEventListener('error', onError);
        ws.removeEventListener('close', onClose);
        opts?.signal?.removeEventListener('abort', onAbort);
      };
      const onOpen = () => {
        if (settled) return;
        settled = true;
        cleanup();
        resolve(ws);
      };
      const onError = () => {
        if (settled) return;
        settled = true;
        cleanup();
        reject(new Error('w2sm: WebSocket open failed'));
      };
      const onClose = () => {
        if (settled) return;
        settled = true;
        cleanup();
        reject(new Error('w2sm: WebSocket closed before opening'));
      };
      const onAbort = () => {
        if (settled) return;
        settled = true;
        cleanup();
        ws.close();
        reject(new Error('w2sm: WebSocket open aborted'));
      };
      ws.addEventListener('open', onOpen);
      ws.addEventListener('error', onError);
      ws.addEventListener('close', onClose);
      opts?.signal?.addEventListener('abort', onAbort, { once: true });
    });
  }

  private absoluteHttpUrl(url: string): string {
    if (/^https?:\/\//.test(url)) return url;
    if (/^wss?:\/\//.test(url)) return url.replace(/^ws/, 'http');
    return `${this.baseUrl}${url}`;
  }

  private absoluteWebSocketUrl(url: string): string {
    // An empty gatewayUrl (same origin) leaves httpUrl relative; WebSocket
    // needs an absolute URL, so resolve it against the page location.
    const httpUrl = new URL(this.absoluteHttpUrl(url), (globalThis as any).location?.href).href;
    if (httpUrl.startsWith('https://')) return `wss://${httpUrl.slice('https://'.length)}`;
    if (httpUrl.startsWith('http://')) return `ws://${httpUrl.slice('http://'.length)}`;
    if (/^wss?:\/\//.test(httpUrl)) return httpUrl;
    throw new Error(`w2sm: unsupported WebSocket URL ${httpUrl}`);
  }
}

