// Two DIFFERENT services hosted behind ONE Authorizer that each declare an RPC
// with the SAME bare name must keep their own auth_services. Keyed by the bare
// name ("Get"), the second registration silently overwrote the first, so
// whichever service registered last decided authorization for BOTH — a caller
// entitled to alpha.AlphaService/Get also passed for beta.BetaService/Get.
// Policy is keyed by the service-qualified identifier instead.
func TestAuthorizerKeepsPerServicePolicyForSameNamedRpc(t *testing.T) {
	const (
		alphaMethod = "/alpha.AlphaService/Get"
		betaMethod  = "/beta.BetaService/Get"
	)

	key := newTestKey(t)
	a := authorizerWithKeys(t, jwkForKey(t, key))
	// Exactly what two generated RegisterXMethodAuth functions do against the
	// one Authorizer the ServiceManager builds.
	a.SetMethodAuth(qualifiedMethodKey(alphaMethod), []string{"alpha-caller"})
	a.SetMethodAuth(qualifiedMethodKey(betaMethod), []string{"beta-caller"})

	alphaTok := signedToken(t, key, serviceToken("alpha-caller"))
	betaTok := signedToken(t, key, serviceToken("beta-caller"))

	// Each caller is authorized for its OWN service's Get.
	if _, err := a.Authorize(bearerCtx(alphaTok), alphaMethod, nil); err != nil {
		t.Fatalf("alpha-caller must be authorized for %s, got: %v", alphaMethod, err)
	}
	if _, err := a.Authorize(bearerCtx(betaTok), betaMethod, nil); err != nil {
		t.Fatalf("beta-caller must be authorized for %s, got: %v", betaMethod, err)
	}

	// And is denied on the OTHER service's identically named Get.
	if _, err := a.Authorize(bearerCtx(alphaTok), betaMethod, nil); err == nil {
		t.Fatalf("alpha-caller must be denied for %s: auth_services do not cross services", betaMethod)
	}
	if _, err := a.Authorize(bearerCtx(betaTok), alphaMethod, nil); err == nil {
		t.Fatalf("beta-caller must be denied for %s: auth_services do not cross services", alphaMethod)
	}
}

// The same collision reaches target_namespace_field: two co-hosted services
// declaring the same RPC name must not inherit each other's namespace-field
// registration. Only alpha's Get names a target field; beta's must stay
// unguarded rather than picking up alpha's field name (or vice versa).
func TestAuthorizerKeepsPerServiceTargetNamespaceFieldForSameNamedRpc(t *testing.T) {
	const (
		alphaMethod = "/alpha.AlphaService/Get"
		betaMethod  = "/beta.BetaService/Get"
	)

	key := newTestKey(t)
	a := authorizerWithKeys(t, jwkForKey(t, key))
	a.SetMethodAuth(qualifiedMethodKey(alphaMethod), []string{"caller-svc"})
	a.SetMethodAuth(qualifiedMethodKey(betaMethod), []string{"caller-svc"})
	a.SetMethodTargetNamespaceField(qualifiedMethodKey(alphaMethod), "tenant_namespace")

	if got := a.methodTargetNamespaceField[qualifiedMethodKey(betaMethod)]; got != "" {
		t.Fatalf("beta.BetaService/Get must have no target_namespace_field, got %q from alpha's registration", got)
	}
	if got := a.methodTargetNamespaceField[qualifiedMethodKey(alphaMethod)]; got != "tenant_namespace" {
		t.Fatalf("alpha.AlphaService/Get must keep its own target_namespace_field, got %q", got)
	}

	// A nil request would fail alpha's field lookup; beta's Get, carrying no
	// registration of its own, must authorize on auth_services alone.
	tok := signedToken(t, key, serviceToken("caller-svc"))
	if _, err := a.Authorize(bearerCtx(tok), betaMethod, nil); err != nil {
		t.Fatalf("beta.BetaService/Get must not inherit alpha's target_namespace_field, got: %v", err)
	}
}

// qualifiedMethodKey reduces both full-method shapes the generated wrappers
// produce — with and without the routing parent segment — to the same
// service-qualified key, so a wrapper's registration matches at lookup time.
func TestQualifiedMethodKeyShapes(t *testing.T) {
	for _, tc := range []struct {
		full string
		want string
	}{
		{"/demo.DemoService/DoThing", "demo.DemoService/DoThing"},
		{"/services/demo.DemoService/DoThing", "demo.DemoService/DoThing"},
		{"/vservices/demo.DemoService/DoThing", "demo.DemoService/DoThing"},
		{"/DemoService/DoThing", "DemoService/DoThing"},
		{"DoThing", "DoThing"},
	} {
		if got := qualifiedMethodKey(tc.full); got != tc.want {
			t.Errorf("qualifiedMethodKey(%q) = %q, want %q", tc.full, got, tc.want)
		}
	}
}

// A tenant-owned instance (own namespace /tenants/beta) refuses another
// tenant's caller at the door, on an RPC with no target_namespace_field: a
// token's aud is the service name, which every tenant's instance accepts. The
// instance's own tenant, /system and the root pass; shared instances are
// unchanged.
func TestAuthorizerTenantOwnedInstanceRefusesOtherTenant(t *testing.T) {
	key := newTestKey(t)
	a := authorizerWithKeys(t, jwkForKey(t, key))
	a.SetMethodAuth(testMethodKey, []string{"caller-svc"})
	a.SetHostNamespace("/tenants/beta")

	at := func(ns string) string {
		return signedToken(t, key, func(tok *tokenlib.TokenWrapper) {
			tok.SetSubType("service").SetSubject("caller-svc").SetNamespace(ns)
		})
	}
	for _, ns := range []string{"/tenants/beta", "/system", "/system/us-east", "/"} {
		if _, err := a.Authorize(bearerCtx(at(ns)), testMethod, nil); err != nil {
			t.Fatalf("caller in %q must pass beta's instance, got: %v", ns, err)
		}
	}
	for _, ns := range []string{"/tenants/acme", "/tenants/beta2", "/tenants/beta/sub", "/users/u1"} {
		_, err := a.Authorize(bearerCtx(at(ns)), testMethod, nil)
		if err == nil {
			t.Fatalf("caller in %q must be denied by beta's instance", ns)
		}
		if st, _ := status.FromError(err); st.Code() != codes.PermissionDenied {
			t.Fatalf("caller in %q: want PermissionDenied, got %v", ns, err)
		}
		if _, err := a.Authenticate(bearerCtx(at(ns))); err == nil {
			t.Fatalf("Authenticate must deny %q on beta's instance", ns)
		}
	}
}

// A shared instance (a /system namespace) and an unset host namespace admit
// every tenant, as before.
func TestAuthorizerSharedInstanceAdmitsAnyTenant(t *testing.T) {
	key := newTestKey(t)
	for _, host := range []string{"", "/system", "/system/us-east", "/tenants", "/tenants/a/b"} {
		a := authorizerWithKeys(t, jwkForKey(t, key))
		a.SetMethodAuth(testMethodKey, []string{"caller-svc"})
		a.SetHostNamespace(host)
		tok := signedToken(t, key, serviceToken("caller-svc"))
		if _, err := a.Authorize(bearerCtx(tok), testMethod, nil); err != nil {
			t.Fatalf("host %q must admit /tenants/acme, got: %v", host, err)
		}
	}
}

// methodStream is the server transport stream gRPC puts on a handler's
// context; grpc.Method reads the full method off it.
type methodStream struct{ method string }

func (s methodStream) Method() string                  { return s.method }
func (s methodStream) SetHeader(metadata.MD) error     { return nil }
func (s methodStream) SendHeader(metadata.MD) error    { return nil }
func (s methodStream) SetTrailer(metadata.MD) error    { return nil }

// inMethod returns ctx as gRPC hands it to the handler of fullMethod.
func inMethod(ctx context.Context, fullMethod string) context.Context {
	return grpc.NewContextWithServerTransportStream(ctx, methodStream{method: fullMethod})
}

// RPC_FLAG_ANY_TENANT opens a tenant-owned instance's door for that rpc only:
// a caller of any tenant passes it on every door (Authorize, Authenticate,
// AuthenticateAtOrBelow), while every other rpc keeps the default "members of
// the instance's tenant only". Nothing else is widened: auth_services still
// applies.
func TestAuthorizerAnyTenantOpensTheDoorForThatRpcOnly(t *testing.T) {
	const openMethod = "/demo.DemoService/Visit"
	const openKey = "demo.DemoService/Visit"
	key := newTestKey(t)
	a := authorizerWithKeys(t, jwkForKey(t, key))
	a.SetMethodAuth(testMethodKey, []string{"caller-svc"})
	a.SetMethodAuth(openKey, []string{"caller-svc"})
	a.SetMethodAnyTenant(openKey)
	a.SetHostNamespace("/tenants/beta")

	acme := signedToken(t, key, func(tok *tokenlib.TokenWrapper) {
		tok.SetSubType("service").SetSubject("caller-svc").SetNamespace("/tenants/acme")
	})
	if _, err := a.Authorize(bearerCtx(acme), openMethod, nil); err != nil {
		t.Fatalf("ANY_TENANT rpc must admit another tenant's caller, got: %v", err)
	}
	if _, err := a.Authenticate(inMethod(bearerCtx(acme), openMethod)); err != nil {
		t.Fatalf("ANY_TENANT rpc must admit another tenant's caller on Authenticate, got: %v", err)
	}
	if _, err := a.Authorize(bearerCtx(acme), testMethod, nil); status.Code(err) != codes.PermissionDenied {
		t.Fatalf("an rpc without ANY_TENANT must keep the door shut, got: %v", err)
	}
	if _, err := a.Authenticate(inMethod(bearerCtx(acme), testMethod)); status.Code(err) != codes.PermissionDenied {
		t.Fatalf("Authenticate on an rpc without ANY_TENANT must keep the door shut, got: %v", err)
	}
	// No method on the context: the default door applies (fail closed).
	if _, err := a.Authenticate(bearerCtx(acme)); status.Code(err) != codes.PermissionDenied {
		t.Fatalf("Authenticate with no method on the context must keep the door shut, got: %v", err)
	}

	// The token's other checks are untouched: auth_services still applies.
	stranger := signedToken(t, key, func(tok *tokenlib.TokenWrapper) {
		tok.SetSubType("service").SetSubject("other-svc").SetNamespace("/tenants/acme")
	})
	if _, err := a.Authorize(bearerCtx(stranger), openMethod, nil); status.Code(err) != codes.PermissionDenied {
		t.Fatalf("ANY_TENANT must not widen auth_services, got: %v", err)
	}
}

// The server-side routing backstop: a routed rpc's request must name a tid
// (INVALID_ARGUMENT otherwise) and, on a tenant-owned instance, the instance's
// own tenant (PERMISSION_DENIED otherwise). A shared instance checks the shape
// only. A wrapper asking about an rpc with no registered route field is a
// generation bug and fails closed.
func TestAuthorizerCheckRouteBackstop(t *testing.T) {
	const routedKey = "demo.DemoService/DoThing"
	req := func(v string) any { return &host_pb.Host{Host: v} }

	shared := authorizerWithKeys(t)
	shared.SetMethodRouteField(routedKey, "host")
	if err := shared.CheckRoute(testMethod, req("aaaaaaaa")); err != nil {
		t.Fatalf("shared instance must accept a tid, got: %v", err)
	}
	for _, bad := range []string{"", "AAAAAAAA", "aaaaaaa", "aaaaaaaa "} {
		err := shared.CheckRoute(testMethod, req(bad))
		if status.Code(err) != codes.InvalidArgument {
			t.Fatalf("route value %q: want InvalidArgument, got %v", bad, err)
		}
	}

	owned := authorizerWithKeys(t)
	owned.SetMethodRouteField(routedKey, "host")
	owned.SetHostNamespace("/tenants/bbbbbbbb")
	if err := owned.CheckRoute(testMethod, req("bbbbbbbb")); err != nil {
		t.Fatalf("instance of bbbbbbbb must accept a call routed to bbbbbbbb, got: %v", err)
	}
	err := owned.CheckRoute(testMethod, req("aaaaaaaa"))
	if status.Code(err) != codes.PermissionDenied {
		t.Fatalf("instance of bbbbbbbb must refuse a call routed to aaaaaaaa, got: %v", err)
	}
	if msg := status.Convert(err).Message(); !regexp.MustCompile(`aaaaaaaa.*bbbbbbbb`).MatchString(msg) {
		t.Fatalf("refusal must name both tenants, got %q", msg)
	}
	if err := owned.CheckRoute(testMethod, req("")); status.Code(err) != codes.InvalidArgument {
		t.Fatalf("empty route field: want InvalidArgument, got %v", err)
	}

	if err := owned.CheckRoute("/demo.DemoService/Unrouted", req("bbbbbbbb")); status.Code(err) != codes.Internal {
		t.Fatalf("an rpc with no registered route field must fail closed, got %v", err)
	}
}
