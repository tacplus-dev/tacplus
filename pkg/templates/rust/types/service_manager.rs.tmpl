        // Build the SPIFFE verifier base from the same trust anchors. The trust
        // domain MUST be configured: SpiffeServerCertVerifier::new validates it
        // and fails loudly on an empty/malformed value — the old 'local/dev'
        // fallback was itself malformed (contains '/') and silently accepted
        // trust domain 'local' (OF-12).
        let (roots, root_count) = servicemanager::spiffe::build_root_store(&pem_bundle);
        let trust_domain = cfg.spiffe_trust_domain.as_str();
        let spiffe_verifier_base = servicemanager::SpiffeServerCertVerifier::new(trust_domain, roots)
            .map_err(|e| -> Box<dyn std::error::Error> { format!("building SPIFFE verifier (trust domain {:?}): {}", trust_domain, e).into() })?;
