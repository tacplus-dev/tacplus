[package]
name = "token"
version = "0.1.0"
edition = "2021"
{{- if .License}}
license = "{{.License}}"
{{- end}}
publish = false
description = "JWT token creation, signing, and verification"

[dependencies]
key = { path = "../key" }
jwk = { path = "../jwk" }
spiffe = { path = "../spiffe" }
{{.CrateBasePath}}-types = { path = "../../types" }
base64 = { workspace = true }
ed25519-dalek = { version = "3", features = ["pkcs8", "pem"] }
signature = "3"
serde = { workspace = true, features = ["derive"] }
serde_json = { workspace = true }
