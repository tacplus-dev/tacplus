	accountingSpoolLog    = "accounting-spool/records.log"
	accountingSpoolCursor = "accounting-spool/cursor"
)

// errAccountingSpoolFull is the reason a record is dropped when the durable
// spool would exceed accountingSpoolBytes.
var errAccountingSpoolFull = errors.New("accounting spool full")

// EventBusSink is the durable accounting backend. It flattens the emit-time
// accounting_pb.Event oneof envelope into the flat, stored AccountingRecord
// and hands it to the generated per-topic publisher's queue.
//
// SEND CONTRACT — NEVER HOLDS THE RPC. Emit hands the record to a bounded
// queue and returns; it never waits on the publisher or on the disk. A spool
// goroutine moves records, in order, into the per-topic publisher queue as it
// drains. So an event-bus outage costs the RPC nothing, and the records written
// during the outage are replayed to the bus when it is reachable again.
//
// The spool is memory-only (NewEventBusSink) or durable (NewDurableEventBusSink).
// A durable spool is an append-only log on disk: the spool goroutine appends each
// record before it is queued for the publisher, and the cursor advances as the
// publisher acknowledges records (Ack). A restart replays every record not yet
// acknowledged, in order. A record that was emitted but not yet appended when the
// process dies is lost; that window is the time between Emit and the spool
// goroutine's append.
//
// Accounting is an audit trail, so a record is dropped only when the spool itself
// is full; every drop is counted and logged at ERROR with the running total. A
// record emitted after the service is shutting down is also dropped, and logged.
type EventBusSink struct {
	tx       chan<- *accountingrecord_pb.AccountingRecord
	spool    chan *accountingrecord_pb.AccountingRecord
	sourceID string
	// stop is closed when the owning ServiceManager is shutting down. The drain
	// goroutine exits on it, and Emit refuses records once it is closed.
	stop    <-chan struct{}
	seq     atomic.Uint64
	dropped atomic.Uint64
	// disk is the durable spool, nil for the memory spool. acks carries one
	// signal per record the publisher has acknowledged, in order.
	disk *accountingDiskSpool
	acks chan struct{}
}

// NewEventBusSink creates a memory-only sink that publishes through the given
// per-topic publisher queue. sourceID is the emitting process
// ("{service_id}-{instance_id}"), used to make accounting_id unique across
// instances. stop is the ServiceManager's shutdown signal.
func NewEventBusSink(tx chan<- *accountingrecord_pb.AccountingRecord, sourceID string, stop <-chan struct{}) *EventBusSink {
	s := &EventBusSink{
		tx:       tx,
		spool:    make(chan *accountingrecord_pb.AccountingRecord, accountingSpoolDepth),
		sourceID: sourceID,
		stop:     stop,
	}
	go s.drain()
	return s
}

// NewDurableEventBusSink creates a sink whose spool is the append-only log under
// dir (grpcconfig.disk_persistence.dir). Records the publisher has not
// acknowledged are replayed first, in order. An error means the spool could not be
// opened, and the sink is not created.
func NewDurableEventBusSink(tx chan<- *accountingrecord_pb.AccountingRecord, sourceID string, stop <-chan struct{}, dir string) (*EventBusSink, error) {
	disk, pending, err := openAccountingDiskSpool(dir)
	if err != nil {
		return nil, err
	}
	s := &EventBusSink{
		tx:       tx,
		spool:    make(chan *accountingrecord_pb.AccountingRecord, accountingSpoolDepth),
		sourceID: sourceID,
		stop:     stop,
		disk:     disk,
		acks:     make(chan struct{}),
	}
	go s.drainDurable(pending)
	return s, nil
}

// Ack records that the publisher has acknowledged the oldest record it was handed
// and not yet acknowledged. The generated publish loop calls it once per
// acknowledged record, in order. It does nothing for a memory-only sink.
func (s *EventBusSink) Ack() {
	if s.disk == nil {
		return
	}
	select {
	case s.acks <- struct{}{}:
	case <-s.stop:
	}
}

// drain moves spooled records into the publisher queue, one at a time, so the
// spool replays in emit order. It holds at most one record in hand, and it exits
// on shutdown, dropping whatever is still spooled and logging the count.
func (s *EventBusSink) drain() {
	for {
		select {
		case <-s.stop:
			s.dropOnShutdown(nil)
			return
		case record := <-s.spool:
			select {
			case s.tx <- record:
			case <-s.stop:
				s.dropOnShutdown(record)
				return
			}
		}
	}
}

// dropOnShutdown counts and logs every record the drain goroutine still owns:
// the one in hand, if any, and everything left in the spool.
func (s *EventBusSink) dropOnShutdown(inHand *accountingrecord_pb.AccountingRecord) {
	n := uint64(len(s.spool))
	if inHand != nil {
		n++
	}
	if n == 0 {
		return
	}
	total := s.dropped.Add(n)
	zap.L().Error("accounting publisher closed; records dropped",
		zap.Uint64("dropped", n), zap.Uint64("dropped_total", total))
}

// drainDurable is the durable spool loop. It owns the log: it appends each record
// before the record is queued for the publisher, and it advances the cursor as the
// publisher acknowledges records. queue holds the records not yet handed to the
// publisher, in order; it starts with the records the log held unacknowledged at open.
func (s *EventBusSink) drainDurable(queue []*accountingrecord_pb.AccountingRecord) {
	for {
		var out chan<- *accountingrecord_pb.AccountingRecord
		var next *accountingrecord_pb.AccountingRecord
		if len(queue) > 0 {
			out, next = s.tx, queue[0]
		}
		select {
		case <-s.stop:
			s.shutdownDurable(len(queue))
			return
		case record := <-s.spool:
			if err := s.disk.append(record); err != nil {
				s.dropRecord(record, err)
				continue
			}
			queue = append(queue, record)
		case out <- next:
			queue[0] = nil
			queue = queue[1:]
		case <-s.acks:
			if err := s.disk.ack(); err != nil {
				zap.L().Error("accounting spool cursor not written; records may be republished",
					zap.Error(err))
			}
		}
	}
}

// shutdownDurable persists the cursor and counts the records that never reached the
// log. Records already in the log are kept for replay on the next start.
func (s *EventBusSink) shutdownDurable(pending int) {
	if err := s.disk.flush(); err != nil {
		zap.L().Error("accounting spool cursor not written at shutdown; records may be republished",
			zap.Error(err))
	}
	if n := uint64(len(s.spool)); n > 0 {
		total := s.dropped.Add(n)
		zap.L().Error("accounting publisher closed; records dropped",
			zap.Uint64("dropped", n), zap.Uint64("dropped_total", total))
	}
	zap.L().Info("accounting spool closed; unpublished records kept on disk for replay",
		zap.Int("records", pending))
}

// dropRecord counts and logs a record the durable spool could not keep.
func (s *EventBusSink) dropRecord(record *accountingrecord_pb.AccountingRecord, err error) {
	total := s.dropped.Add(1)
	zap.L().Error("accounting record dropped",
		zap.String("accounting_id", record.AccountingId), zap.Error(err),
		zap.Uint64("dropped_total", total))
}

// accountingDiskSpool is the durable spool: an append-only log of the records
